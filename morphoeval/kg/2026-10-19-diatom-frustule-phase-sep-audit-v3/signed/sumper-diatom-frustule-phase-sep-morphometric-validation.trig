sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-quench-simulated-inter-tier-pitch-ratio-a-2-a-3-cribrum-cribrella> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3-stage 512x512 quench: simulated inter-tier pitch ratio a_2 / a_3 (cribrum / cribrella) = 5.1079 ratio" ;
        dcterms:description "a_1/a_2 sim = 4.111 (ref 4.868); sim pitches px = [150.3, 36.6, 7.2] vs targets [148.0, 30.4, 6.0]" ;
        schema:measurementTechnique "mean nearest-neighbour centroid pitch of tier-2 pores divided by that of tier-3 pores in the same 512^2 domain" ;
        schema:name "3-stage 512x512 quench: simulated inter-tier pitch ratio a_2 / a_3 (cribrum / cribrella)" ;
        schema:unitText "ratio" ;
        schema:value "5.1079" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-quench-simulated-inter-tier-pitch-ratio-a-2-a-3-cribrum-cribrella-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-quench-simulated-inter-tier-pitch-ratio-a-2-a-3-cribrum-cribrella-reference> a schema:PropertyValue ;
        dcterms:source "Sumper (2002) / Losic et al. (2006): a_2 = 380 nm, a_3 = 75 nm -> 5.067" ;
        schema:value "5.0667" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-quench-simulated-tertiary-cribrella-pore-diameter-d-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3-stage 512x512 quench: simulated tertiary cribrella pore diameter d_3 = 46.5 nm" ;
        dcterms:description "d_2 sim = 242 nm (ref 220); resolution floor 3.4 px at this scale" ;
        schema:measurementTechnique "mean equivalent diameter of tier-3 connected pores (>= 6 px) x 12.5 nm/px" ;
        schema:name "3-stage 512x512 quench: simulated tertiary cribrella pore diameter d_3" ;
        schema:unitText "nm" ;
        schema:value "46.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-quench-simulated-tertiary-cribrella-pore-diameter-d-3-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-quench-simulated-tertiary-cribrella-pore-diameter-d-3-reference> a schema:PropertyValue ;
        dcterms:source "Sumper (2002) Science 295:2430 / Losic et al. (2006) Table 1: d_3 = 42 nm" ;
        schema:value "42.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-single-domain-quench-tertiary-cribrella-pores-per-cribrum-pore> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3-stage 512x512 single-domain quench: tertiary cribrella pores per cribrum pore = 5.0 cribrella / cribrum pore" ;
        dcterms:description "counts foramina/cribrum/cribrella = [12, 48, 225], cribrum per foramen = 4.80 (ref 12)" ;
        schema:measurementTechnique "connected tier-3 pores (eps_3 = 0.603) inside each frozen-wall-confined tier-2 cribrum pore chamber on one 512^2 grid at 12.5 nm/px" ;
        schema:name "3-stage 512x512 single-domain quench: tertiary cribrella pores per cribrum pore" ;
        schema:unitText "cribrella / cribrum pore" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-single-domain-quench-tertiary-cribrella-pores-per-cribrum-pore-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-3-stage-512x512-single-domain-quench-tertiary-cribrella-pores-per-cribrum-pore-reference> a schema:PropertyValue ;
        dcterms:source "Sumper (2002) Science 295:2430 Fig. 3-4 centered-hexagonal H(1) = 7 cribrella per cribrum pore (reference JSON tier 3 subpores_per_parent)" ;
        schema:value "7.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-conserved-mean-order-parameter-phi-drift> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cahn-Hilliard conserved mean order parameter <phi> drift = 0.0 order parameter drift" ;
        dcterms:description "mean(phi)=-0.30000000 vs exact phi0=-0.30000000" ;
        schema:measurementTechnique "absolute mass conservation drift |<phi(x,t)> - phi0| after 650 semi-implicit spectral steps" ;
        schema:name "Cahn-Hilliard conserved mean order parameter <phi> drift" ;
        schema:unitText "order parameter drift" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-conserved-mean-order-parameter-phi-drift-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-conserved-mean-order-parameter-phi-drift-reference> a schema:PropertyValue ;
        dcterms:source "Lean 4 Theorem MathOfBiology.Loop_071.cahn_hilliard_mass_conservation_zero_mode (sigma(0) = 0)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-interfacial-thickness-sweep-wavelength-correlation-r-lambda-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cahn-Hilliard interfacial thickness sweep wavelength correlation r(lambda*, lambda_c) = 0.9865 Pearson r" ;
        dcterms:description "p=1.87e-03, RMSE=0.95 px across 5 epsilon regimes" ;
        schema:measurementTechnique "5-point interfacial parameter sweep across epsilon in {0.75, 1.00, 1.25, 1.50, 1.75} comparing sub-bin FFT wavelength lambda* against analytical spinodal lambda_c = 2*pi/k_c" ;
        schema:name "Cahn-Hilliard interfacial thickness sweep wavelength correlation r(lambda*, lambda_c)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9865" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-interfacial-thickness-sweep-wavelength-correlation-r-lambda-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-interfacial-thickness-sweep-wavelength-correlation-r-lambda-lambda-c-reference> a schema:PropertyValue ;
        dcterms:source "Lenoci & Camp (2008) Langmuir 24:217 Section 2 linear spinodal wavelength scaling lambda_c proportional to epsilon" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-front-quench-radial-minus-concentric-morphology-contrast-a-v-0-10-a-v-0-40> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Centrifugal front quench: radial-minus-concentric morphology contrast A(v=0.10) - A(v=0.40) = 1.5895 anisotropy index difference" ;
        dcterms:description "A(0.10) = +0.647, A(0.40) = -0.942" ;
        schema:measurementTechnique "same model at two front speeds; positive values mean slow fronts give radial costae and fast fronts give front-parallel (concentric) lamellae" ;
        schema:name "Centrifugal front quench: radial-minus-concentric morphology contrast A(v=0.10) - A(v=0.40)" ;
        schema:unitText "anisotropy index difference" ;
        schema:value "1.5895" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-front-quench-radial-minus-concentric-morphology-contrast-a-v-0-10-a-v-0-40-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-front-quench-radial-minus-concentric-morphology-contrast-a-v-0-10-a-v-0-40-reference> a schema:PropertyValue ;
        dcterms:source "isotropic null (no front) has no speed dependence: contrast = 0; sign predicted by Furukawa (1992)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-front-quench-total-order-parameter-conservation-with-frozen-silica-mass-re-projection> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Centrifugal front quench total order-parameter conservation with frozen-silica mass re-projection = 0.0 |<phi(T)> - <phi(0)>|" ;
        dcterms:description "6800 steps, final front radius 76.0 px" ;
        schema:measurementTechnique "mean absolute drift of the domain-averaged order parameter after the frozen-region projection step at every time step" ;
        schema:name "Centrifugal front quench total order-parameter conservation with frozen-silica mass re-projection" ;
        schema:unitText "|<phi(T)> - <phi(0)>|" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-front-quench-total-order-parameter-conservation-with-frozen-silica-mass-re-projection-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-front-quench-total-order-parameter-conservation-with-frozen-silica-mass-re-projection-reference> a schema:PropertyValue ;
        dcterms:source "Lean 4 Theorem MathOfBiology.Loop_071.cahn_hilliard_mass_conservation_zero_mode & frozen_front_monotone_irreversible" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-precipitation-front-quench-margin-radial-anisotropy-a-at-slow-front-speed-v-0-10-px-t> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Centrifugal precipitation-front quench: margin radial anisotropy A at slow front speed (v = 0.10 px/t) = 0.6473 anisotropy index (+1 radial lamellae, 0 isotropic, -1 concentric)" ;
        dcterms:description "Pe = v/(lambda_c sigma_max) = 0.045; core A = +0.617; fast front (v = 0.40) margin A = -0.942 (concentric); null A = -0.110 +/- 0.112 (3 seeds); the vendored SEM has no valve-margin view, so no direct specimen value exists for A (Pass 4 item)" ;
        schema:measurementTechnique "gradient-tensor anisotropy <|d_theta phi|^2 - |d_r phi|^2>/<|grad phi|^2> in the outer 40% annulus of a 160^2 disc swept by a(r,t)=tanh((R0+v t - r)/w) with lagging frozen silica front (lag = 1.0 lambda_c), phi0 = 0" ;
        schema:name "Centrifugal precipitation-front quench: margin radial anisotropy A at slow front speed (v = 0.10 px/t)" ;
        schema:unitText "anisotropy index (+1 radial lamellae, 0 isotropic, -1 concentric)" ;
        schema:value "0.6473" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-precipitation-front-quench-margin-radial-anisotropy-a-at-slow-front-speed-v-0-10-px-t-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-centrifugal-precipitation-front-quench-margin-radial-anisotropy-a-at-slow-front-speed-v-0-10-px-t-reference> a schema:PropertyValue ;
        dcterms:source "isotropic bulk-quench null (same disc, a = +1 everywhere, no front, no freezing; mean of 3 seeds); Furukawa (1992) Physica A 180:128 directional-quench morphology transition predicts front-perpendicular lamellae at slow front speed" ;
        schema:value "-0.1097" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-foramen-diameter-to-pitch-ratio-d-1-a-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coscinodiscus wailesii SEM foramen diameter-to-pitch ratio (d_1 / a_1) = 0.6897 ratio" ;
        dcterms:description "n=139 pores, diameter CV=0.133, pitch CV=0.075, relative error=2.1%" ;
        schema:measurementTechnique "segmented foramen pore equivalent diameter (24.01 px, CV=0.133) / nearest-neighbor pitch (34.80 px, CV=0.075) across n=139 pores on SHA-256-locked SEM ROI" ;
        schema:name "Coscinodiscus wailesii SEM foramen diameter-to-pitch ratio (d_1 / a_1)" ;
        schema:unitText "ratio" ;
        schema:value "0.6897" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-foramen-diameter-to-pitch-ratio-d-1-a-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-foramen-diameter-to-pitch-ratio-d-1-a-1-reference> a schema:PropertyValue ;
        dcterms:source "Sumper (2002) Science 295:2430 & Losic et al. (2006) Table 1 (d_1=1250 nm / a_1=1850 nm = 0.6757)" ;
        schema:value "0.6757" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-foramen-row-long-range-coherence-c-6-vs-isotropic-cahn-hilliard-stage-1-quench> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coscinodiscus wailesii SEM foramen-row long-range coherence C_6 vs isotropic Cahn-Hilliard Stage-1 quench = 0.618 C_6 = |<exp(6 i theta_bond)>| over all NN bonds" ;
        dcterms:description "SEM C_6 = 0.618; isotropic sim C_6 = 0.209" ;
        schema:measurementTechnique "lab-frame bond-orientation coherence of the n=139 segmented SEM foramina (straight fasciculate rows) vs the same statistic on the isotropic Stage-1 simulation droplets" ;
        schema:name "Coscinodiscus wailesii SEM foramen-row long-range coherence C_6 vs isotropic Cahn-Hilliard Stage-1 quench" ;
        schema:unitText "C_6 = |<exp(6 i theta_bond)>| over all NN bonds" ;
        schema:value "0.618" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-foramen-row-long-range-coherence-c-6-vs-isotropic-cahn-hilliard-stage-1-quench-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-foramen-row-long-range-coherence-c-6-vs-isotropic-cahn-hilliard-stage-1-quench-reference> a schema:PropertyValue ;
        dcterms:source "isotropic bulk Cahn-Hilliard quench (this script, Stage 1): the long-range row order of the valve is NOT produced by an isotropic quench and motivates the directional (centrifugal) front" ;
        schema:value "0.2088" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-primary-foramen-6-fold-hexatic-order-psi-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coscinodiscus wailesii SEM primary foramen 6-fold hexatic order |psi_6| = 0.7638 |psi_6|" ;
        dcterms:description "SEM |psi_6|=0.7638 vs simulated Cahn-Hilliard |psi_6|=0.5862" ;
        schema:measurementTechnique "mean 6-nearest-neighbor bond-orientational order |(1/N_j) sum exp(6i theta)| on n=139 segmented SEM foramen pores vs simulated Cahn-Hilliard droplet array" ;
        schema:name "Coscinodiscus wailesii SEM primary foramen 6-fold hexatic order |psi_6|" ;
        schema:unitText "|psi_6|" ;
        schema:value "0.7638" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-primary-foramen-6-fold-hexatic-order-psi-6-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-coscinodiscus-wailesii-sem-primary-foramen-6-fold-hexatic-order-psi-6-reference> a schema:PropertyValue ;
        dcterms:source "Sumper (2002) Science 295:2430 Figs. 1-2 close-packed hexagonal LCPA droplet lattice" ;
        schema:value "0.75" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-outside-spinodal-negative-control-phi0-0-65-pore-count-vs-spinodal-droplet-regime> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Outside-spinodal negative control (phi0 = -0.65) pore count vs spinodal droplet regime = 0 pores" ;
        dcterms:description "negative control std_phi=1.93e-03 (0 pores) vs spinodal droplet std_phi=0.625 (53 pores)" ;
        schema:measurementTechnique "connected pore count when mean composition |phi0|=0.65 exceeds spinodal threshold 1/sqrt(3)=0.5774 (alpha = 1 - 3*phi0^2 = -0.2675 < 0) vs phi0=-0.30 control" ;
        schema:name "Outside-spinodal negative control (phi0 = -0.65) pore count vs spinodal droplet regime" ;
        schema:unitText "pores" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-outside-spinodal-negative-control-phi0-0-65-pore-count-vs-spinodal-droplet-regime-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-outside-spinodal-negative-control-phi0-0-65-pore-count-vs-spinodal-droplet-regime-reference> a schema:PropertyValue ;
        dcterms:source "Cahn & Hilliard (1958) J. Chem. Phys. 28:258 & Lean 4 Theorem cahn_hilliard_spinodal_band_selection" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-sumper-2002-3-tier-pore-diameter-log-linear-scaling-correlation-foramen-cribrum-cribrella> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Sumper (2002) 3-tier pore diameter log-linear scaling correlation (Foramen -> Cribrum -> Cribrella) = 0.9999 |r|" ;
        dcterms:description "effective inter-tier scale ratio rho=0.1833 (ref 0.1800), p=8.81e-03" ;
        schema:measurementTechnique "log10(d_m) linear regression across Generation 1 (1250 nm), Generation 2 (220 nm), and Generation 3 (42 nm)" ;
        schema:name "Sumper (2002) 3-tier pore diameter log-linear scaling correlation (Foramen -> Cribrum -> Cribrella)" ;
        schema:unitText "|r|" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-sumper-2002-3-tier-pore-diameter-log-linear-scaling-correlation-foramen-cribrum-cribrella-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-sumper-2002-3-tier-pore-diameter-log-linear-scaling-correlation-foramen-cribrum-cribrella-reference> a schema:PropertyValue ;
        dcterms:source "Sumper (2002) Science 295:2430 self-similar LCPA droplet subdivision d_m = d_1 * rho^(m-1)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-two-stage-hierarchical-quench-nested-cribrum-sub-pores-per-foramen> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Two-stage hierarchical quench nested cribrum sub-pores per foramen = 2.04 sub-pores / foramen" ;
        dcterms:description "total foramina=53, total nested cribrum pores=102, SEM cribrum ROI pores=74" ;
        schema:measurementTechnique "connected secondary cribrum pores (eps_2=0.65) formed inside each solidified Stage 1 primary foramen chamber (eps_1=1.50)" ;
        schema:name "Two-stage hierarchical quench nested cribrum sub-pores per foramen" ;
        schema:unitText "sub-pores / foramen" ;
        schema:value "2.04" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-two-stage-hierarchical-quench-nested-cribrum-sub-pores-per-foramen-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-two-stage-hierarchical-quench-nested-cribrum-sub-pores-per-foramen-reference> a schema:PropertyValue ;
        dcterms:source "Sumper (2002) Science 295:2430 centered-hexagonal 1-ring H(1)=7 to 2-ring H(2)=19 cribrum sub-pores per areola" ;

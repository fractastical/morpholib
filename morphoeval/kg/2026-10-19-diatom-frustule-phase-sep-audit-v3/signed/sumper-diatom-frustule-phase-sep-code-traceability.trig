sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L1–L24" ;
        dcterms:description "Header: R1/R2 mapped to simulate_radial_quench_costae / run_front_velocity_sweep / simulate_three_stage_hierarchy and to Furukawa 1992, Schmid & Volcani 1983" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L1-L24> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/sumper-diatom-frustule-phase-sep.yaml L40–L130" ;
        dcterms:description "Equations 1-5 with single-range code_locus pins (eq4 #L405-L538, eq5 #L600-L724) and Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/math_kg_loops/sumper-diatom-frustule-phase-sep.yaml#L40-L130> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation (Pass 3: centrifugal precipitation front + 3-stage single-domain quench) — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The header maps R1/R2 to the functions that implement them and to Furukawa (1992) and Schmid & Volcani (1983); `simulate_radial_quench_costae` and `simulate_three_stage_hierarchy` carry long docstrings that state the mechanism, the scale-invariance argument for the tier time steps, the neutral-wall decision and the off-critical result (concentric-only for phi0 = -0.30); the math-KG YAML registers equations 4-5 with single-range `code_locus` pins that match the current file, and the two new Lean theorems are named in the header (+1). Deductions: the docstrings state the mechanism but not that lag 1.0, noise 0.005, width 2.0, R0 8, v 0.10, steps (290, 160, 100) and erode (0, 3, 1) were hand-picked from exploratory runs — the handoff note says so, the code does not (-3); `pore_centroids` / `bond_orientation_coherence` outputs (`radial_frame_coherence_margin`, `lab_frame_coherence_margin`) are computed for the lamellar rib layer, where they are ~0 and meaningless, and used by no panel or measurement — dead output fields (-2); the `--self-test` help text still says '8-check' (-1). Net 91 -> 92." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "models/2002-sumper-diatom-frustule-phase-sep.py L405–L440: simulate_radial_quench_costae signature and docstring: mechanism stated; tuned values lag=1.0, noise=0.005, width=2.0, R0=8 not flagged as hand-picked <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L405-L440>",
            "models/2002-sumper-diatom-frustule-phase-sep.py L534–L535: radial_frame_coherence_margin / lab_frame_coherence_margin returned but unused by any panel or measurement (dead for the lamellar rib layer) <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L534-L535>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 Phase B primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L1148–L1222" ;
        dcterms:description "Panels C1 (3-stage composite), C2 (one-foramen zoom, 200 nm bar), C3 (costae disc with front/margin circles), C4 (A(v) ablation with null line)" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L124–L171" ;
        dcterms:description "Analytical Cahn-Hilliard spinodal dispersion sigma(k), k_c, k_0, lambda_c (unchanged from v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L124-L171> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L178–L243" ;
        dcterms:description "Spectral CH solver with optional a_field (directional-quench bulk term) and frozen_mask; L228-L238 re-project leaked flux uniformly onto mobile pixels (global, not local, conservation)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L178-L243> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L405–L538" ;
        dcterms:description "simulate_radial_quench_costae: tanh quench front, lagging solidification front R_s = R - lag*lambda_c, conserved noise, margin anisotropy A, Peclet number; L489-L496 frozen-mass re-projection" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L405-L538> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "models/2002-sumper-diatom-frustule-phase-sep.py L600–L713" ;
        dcterms:description "simulate_three_stage_hierarchy: one 512^2 grid, per-tier eps via epsilon_for_pitch, eroded chambers (erode_px=[0,3,1] L633), frozen parent silica with neutral wall value (L644)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/models/2002-sumper-diatom-frustule-phase-sep.py#L600-L713> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean L100–L144" ;
        dcterms:description "Law 4: directional_quench_stable_ahead_of_front (L109-L118) and frozen_front_monotone_irreversible (L121-L144); file verifies with lean, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a69596cc/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L100-L144> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation (Pass 3: centrifugal precipitation front + 3-stage single-domain quench) — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The fourth-order Cahn-Hilliard PDE with exact Fourier zero-mode conservation, the analytical spinodal dispersion and the Lenoci-Camp two-stage quench are unchanged from v2 and the `a_field=None, frozen_mask=None` path is bitwise identical (Check 7). Pass 3 adds a genuine new mechanism rather than a template: a spatially varying bulk term phi^3 - a(x) phi (stable single well ahead of the front, spinodal behind) with a lagging zero-mobility solidification front, and the radial/concentric/isotropic transition emerges from the front speed with no imposed stripe pattern (+2). The 3-stage model uses the CH scale invariance (x -> Lx, eps -> L eps, t -> L^2 t) to set per-tier eps from Sumper's pitches, and the frozen parent silica is a physically motivated confinement (+1). Deductions: the frozen-pixel solidification is a projection in a periodic spectral solver — leaked flux is re-distributed uniformly over all mobile pixels, so conservation is global, not local, and across all chambers in the 3-stage run (-2); the neutral wall value (phi_wall = tier phi0) was chosen because a -1 wetting wall produced surface-directed rings, a modelling decision not from the paper (-1); costae and areolae remain separate simulations (-1). Six Lean 4 theorems (2 new: stability ahead of the front; monotone irreversible solidification front) verify with 0 sorry." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-5> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 Phase B primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;

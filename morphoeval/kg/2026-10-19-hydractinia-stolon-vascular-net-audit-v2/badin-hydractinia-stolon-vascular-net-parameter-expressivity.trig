sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-badin-hydractinia-stolon-vascular-net> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Buss, Anderson & Perry (2015) Biol. Bull., Dudgeon et al. (1999) Am. Nat. & Blackstone (1999) Syst. Biol. colonial hydroid pulsatile gastrovascular stolon network, anastomosis loop closure, and runner-to-sheet morphospace — Parameter expressivity: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates 5 biological regimes across the runner-to-sheet continuum (Podocoryna runner eta=0.55, 2,4-DNP redox shift eta=0.90, Hydractinia web eta=1.25, Hydractinia dense sheet eta=1.65, and MgCl2 polyp arrest eta=0.00), sweeps 8 polyp pumping amplitudes across [0.35, 1.65], and exposes `--eta`, `--mu`, `--tau-reg`, and `--seed` CLI overrides (L958-975)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-parameter-expressivity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2020-badin-hydractinia-stolon-vascular-net.py L418–L497" ;
        dct:description "5 morphospace regimes + 8-point polyp pumping amplitude sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-badin-hydractinia-stolon-vascular-net.py#L418-L497> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2020-badin-hydractinia-stolon-vascular-net.py L958–L975" ;
        dct:description "CLI parameter overrides for eta, mu, tau-reg, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-badin-hydractinia-stolon-vascular-net.py#L958-L975> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 100 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-hydractinia-stolon-vascular-net-audit-v2-badin-hydractinia-stolon-vascular-net-1>,

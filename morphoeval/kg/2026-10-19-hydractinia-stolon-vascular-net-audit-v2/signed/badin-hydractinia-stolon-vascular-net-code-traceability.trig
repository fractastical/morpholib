        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-code-traceability-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2020-badin-hydractinia-stolon-vascular-net.py L1–L56" ;
        dcterms:description "Explicit equation-to-paper and Lean 4 theorem traceability in module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-badin-hydractinia-stolon-vascular-net.py#L1-L56> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-badin-hydractinia-stolon-vascular-net> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Buss, Anderson & Perry (2015) Biol. Bull., Dudgeon et al. (1999) Am. Nat. & Blackstone (1999) Syst. Biol. colonial hydroid pulsatile gastrovascular stolon network, anastomosis loop closure, and runner-to-sheet morphospace — Morphometric validation: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L807-904) computes 9 reference-anchored morphometric measurements with uncertainty, Pearson p-values, RMSE, and negative controls: Podocoryna runner alpha = 0.1064 (ref 0.0850), 2,4-DNP uncoupled shift alpha = 0.3404 (ref 0.3650, delta +0.2340), Hydractinia mature sheet alpha = 0.7872 (ref 0.7900, arrest ablation delta +0.7872), runner-to-sheet meshedness sweep Pearson r = 0.99886 (RMSE = 0.0130, p = 3.74e-9), coenosarc mat coverage sweep Pearson r = 0.99768 (RMSE = 0.0213, p = 3.12e-8), MgCl2 arrest surviving stolon fraction = 0.0000 (ref 0.0000), specimen coenosarc coverage = 0.8918 (ref 0.8918), specimen planar meshedness alpha = 0.7800 (ref 0.7800, b_1 = 514 loops), and specimen inter-polyp NND CV = 0.3022 (18.64 +- 5.63 px)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-2-4-dnp-redox-uncoupled-podocoryna-shift-eta-0-90-planar-meshedness-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-mature-stolonal-sheet-eta-1-65-planar-meshedness-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-coenosarc-mat-tissue-coverage>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-inter-polyp-spacing-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-planar-meshedness-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-podocoryna-runner-regime-eta-0-55-planar-meshedness-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-polyp-excision-mgcl2-contraction-arrest-surviving-stolon-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-runner-to-sheet-coenosarc-stolonal-mat-area-coverage-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-runner-to-sheet-polyp-pumping-sweep-planar-meshedness-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-2-4-dnp-redox-uncoupled-podocoryna-shift-eta-0-90-planar-meshedness-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2,4-DNP redox-uncoupled Podocoryna shift (eta = 0.90) planar meshedness alpha = 0.3404 planar meshedness alpha" ;
        dcterms:description "2,4-DNP redox perturbation increases anastomosing loop count from b1 = 5 to b1 = 16 (delta alpha = +0.2340)" ;
        schema:measurementTechnique "2,4-DNP metabolic uncoupling perturbation at eta=0.90 (b1 = 16 loops, heterochronic delta = +0.2340)" ;
        schema:name "2,4-DNP redox-uncoupled Podocoryna shift (eta = 0.90) planar meshedness alpha" ;
        schema:unitText "planar meshedness alpha" ;
        schema:value "0.3404" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-2-4-dnp-redox-uncoupled-podocoryna-shift-eta-0-90-planar-meshedness-alpha-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-2-4-dnp-redox-uncoupled-podocoryna-shift-eta-0-90-planar-meshedness-alpha-reference> a schema:PropertyValue ;
        schema:value "0.365" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-mature-stolonal-sheet-eta-1-65-planar-meshedness-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hydractinia mature stolonal sheet (eta = 1.65) planar meshedness alpha = 0.7872 planar meshedness alpha" ;
        dcterms:description "confluent anastomosed stolonal mat; MgCl2 arrest control collapses to alpha = 0.0000 (ablation delta = +0.7872)" ;
        schema:measurementTechnique "Pulsatile Kirchhoff stolon network at eta=1.65 vs MgCl2 polyp-arrest ablation (b1 = 37 loops, Kirchhoff err = 1.42e-12)" ;
        schema:name "Hydractinia mature stolonal sheet (eta = 1.65) planar meshedness alpha" ;
        schema:unitText "planar meshedness alpha" ;
        schema:value "0.7872" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-mature-stolonal-sheet-eta-1-65-planar-meshedness-alpha-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-mature-stolonal-sheet-eta-1-65-planar-meshedness-alpha-reference> a schema:PropertyValue ;
        schema:value "0.79" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-coenosarc-mat-tissue-coverage> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hydractinia symbiolongicarpus specimen coenosarc mat tissue coverage = 0.8918 colony area fraction" ;
        dcterms:description "matches simulated Hydractinia sheet coverage (0.8850)" ;
        schema:measurementTechnique "Morphological luminance segmentation on hydractinia_symbiolongicarpus_specimen.jpg (YPM IZ 080458, N = 332 polyps)" ;
        schema:name "Hydractinia symbiolongicarpus specimen coenosarc mat tissue coverage" ;
        schema:unitText "colony area fraction" ;
        schema:value "0.8918" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-coenosarc-mat-tissue-coverage-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-coenosarc-mat-tissue-coverage-reference> a schema:PropertyValue ;
        schema:value "0.8918" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-inter-polyp-spacing-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hydractinia symbiolongicarpus specimen inter-polyp spacing CV = 0.3022 NND SD / mean" ;
        dcterms:description "mean NND = 18.64 ± 5.63 px across V = 332 polyps" ;
        schema:measurementTechnique "cKDTree nearest-neighbor distance across V = 332 gastrovascular polyp centers (mean = 18.64 +- 5.63 px)" ;
        schema:name "Hydractinia symbiolongicarpus specimen inter-polyp spacing CV" ;
        schema:unitText "NND SD / mean" ;
        schema:value "0.3022" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-inter-polyp-spacing-cv-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-inter-polyp-spacing-cv-reference> a schema:PropertyValue ;
        schema:value "0.3022" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-planar-meshedness-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hydractinia symbiolongicarpus specimen planar meshedness alpha = 0.78 planar meshedness alpha" ;
        dcterms:description "b1 = 514 closed anastomosed loops; matches simulated Hydractinia sheet alpha = 0.7872" ;
        schema:measurementTechnique "Planar Delaunay-coenosarc vascular graph across V = 332 gastrovascular polyp cavities and E = 845 stolon links (b1 = 514 loops)" ;
        schema:name "Hydractinia symbiolongicarpus specimen planar meshedness alpha" ;
        schema:unitText "planar meshedness alpha" ;
        schema:value "0.78" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-planar-meshedness-alpha-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-hydractinia-symbiolongicarpus-specimen-planar-meshedness-alpha-reference> a schema:PropertyValue ;
        schema:value "0.78" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-podocoryna-runner-regime-eta-0-55-planar-meshedness-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Podocoryna runner regime (eta = 0.55) planar meshedness alpha = 0.1064 planar meshedness alpha" ;
        dcterms:description "sparse peripheral runner colony with b1 = 5 closed loops and lumen radius = 15.48 um" ;
        schema:measurementTechnique "Pulsatile Kirchhoff stolon network at eta=0.55 (b1 = 5 loops, V = 26, E = 30)" ;
        schema:name "Podocoryna runner regime (eta = 0.55) planar meshedness alpha" ;
        schema:unitText "planar meshedness alpha" ;
        schema:value "0.1064" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-podocoryna-runner-regime-eta-0-55-planar-meshedness-alpha-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-podocoryna-runner-regime-eta-0-55-planar-meshedness-alpha-reference> a schema:PropertyValue ;
        schema:value "0.085" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-polyp-excision-mgcl2-contraction-arrest-surviving-stolon-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Polyp excision / MgCl2 contraction arrest surviving stolon fraction = 0.0 patent stolon fraction" ;
        dcterms:description "zero pulsatile flow drives wall shear stress to 0 Pa < tau_reg, regressing all stolon lumens to r = 6.74 um (b1 = 0)" ;
        schema:measurementTechnique "Negative ablation control with polyp stroke volume Delta_V_p = 0 (mean shear = 0.0000 Pa < tau_reg = 0.14 Pa)" ;
        schema:name "Polyp excision / MgCl2 contraction arrest surviving stolon fraction" ;
        schema:unitText "patent stolon fraction" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-polyp-excision-mgcl2-contraction-arrest-surviving-stolon-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-polyp-excision-mgcl2-contraction-arrest-surviving-stolon-fraction-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-runner-to-sheet-coenosarc-stolonal-mat-area-coverage-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Runner-to-sheet coenosarc stolonal mat area coverage correlation = 0.99768 Pearson r" ;
        dcterms:description "RMSE = 0.0213, p = 3.12e-08" ;
        schema:measurementTechnique "8-point polyp pump gain sweep in [0.35, 1.65] comparing coenosarc mat area coverage against reference continuum (RMSE = 0.0213, p = 3.12e-08)" ;
        schema:name "Runner-to-sheet coenosarc stolonal mat area coverage correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99768" ;

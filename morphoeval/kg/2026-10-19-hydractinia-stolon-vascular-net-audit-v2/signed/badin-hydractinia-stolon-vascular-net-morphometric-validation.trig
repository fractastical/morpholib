    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-measurement-runner-to-sheet-coenosarc-stolonal-mat-area-coverage-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .


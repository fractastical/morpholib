sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-badin-hydractinia-stolon-vascular-net> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2020-badin-hydractinia-stolon-vascular-net.py L196–L444" ;
        dcterms:description "Pulsatile Kirchhoff solver, shear-stress-gated lumen adaptation, anastomosis loop closure, and MgCl2 arrest regression" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-badin-hydractinia-stolon-vascular-net.py#L196-L444> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2020-badin-hydractinia-stolon-vascular-net.py L451–L497" ;
        dcterms:description "8-point polyp pumping gain sweep across runner-to-sheet continuum" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-badin-hydractinia-stolon-vascular-net.py#L451-L497> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_100_hydractinia_stolon_vascular_net.lean L48–L166" ;
        dcterms:description "3 machine-checked Lean 4 theorems for quartic Poiseuille conductance/shear identity, Euler cyclomatic anastomosis loops, and polyp-arrest regression (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_100_hydractinia_stolon_vascular_net.lean#L48-L166> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Buss, Anderson & Perry (2015) Biol. Bull., Dudgeon et al. (1999) Am. Nat. & Blackstone (1999) Syst. Biol. colonial hydroid pulsatile gastrovascular stolon network, anastomosis loop closure, and runner-to-sheet morphospace — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the planar colonial hydroid stolon graph and weighted Laplacian Kirchhoff solver (`solve_gastrovascular_kirchhoff`, L196-254), coupled pulsatile polyp oscillator + shear-gated lumen adaptation and anastomosis/regression solver (`simulate_colonial_hydroid_morphogenesis`, L262-415), 5-regime morphospace evaluator (`evaluate_morphospace_regimes`, L418-444), and 8-point polyp pumping sweep (`evaluate_pump_amplitude_sweep`, L451-497), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_100_hydractinia_stolon_vascular_net.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 100 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

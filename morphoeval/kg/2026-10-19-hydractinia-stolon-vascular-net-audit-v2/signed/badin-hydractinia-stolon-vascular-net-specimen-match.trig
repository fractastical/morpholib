sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-badin-hydractinia-stolon-vascular-net> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-badin-hydractinia-stolon-vascular-net-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Buss, Anderson & Perry (2015) Biol. Bull., Dudgeon et al. (1999) Am. Nat. & Blackstone (1999) Syst. Biol. colonial hydroid pulsatile gastrovascular stolon network, anastomosis loop closure, and runner-to-sheet morphospace — Morphological realism / specimen match: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC0 Yale Peabody Museum Hydractinia symbiolongicarpus colony macro micrograph (`hydractinia_symbiolongicarpus_specimen.jpg`, YPM IZ 080458, 1920x1330 px), segments the coenosarc stolonal mat coverage (0.8918 vs simulated sheet 0.8850), detects V = 332 orange-amber endodermal gastrovascular polyp cavities, extracts E = 845 vascular stolon links and b_1 = 514 closed anastomosed loops (planar meshedness alpha = 0.7800 vs simulated sheet 0.7872), and quantifies inter-polyp NND CV = 0.3022 (`segment_hydractinia_specimen`, L504-576)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-specimen-match-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2020-badin-hydractinia-stolon-vascular-net.py L504–L576" ;
        dcterms:description "Coenosarc mat segmentation, endodermal polyp cavity detection, Delaunay-coenosarc planar meshedness alpha=0.7800, and NND CV=0.3022" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-badin-hydractinia-stolon-vascular-net.py#L504-L576> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-badin-hydractinia-stolon-vascular-net-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/hydractinia_stolon_vascular_net_comparison.png (generated output)" ;
        dcterms:description "6-panel comparison figure pairing Podocoryna runner, Hydractinia sheet, eta phase sweep, Poiseuille scaling, morphospace trajectory, and YPM IZ 080458 CV segmentation — docs/media/hydractinia_stolon_vascular_net_comparison.png: rendered output of 2020-badin-hydractinia-stolon-vascular-net.py at 8871db0, image/png, 1150393 B, 2475×1530 px, artifact_sha256 feed403a8a81252c9e9f6a094576be6c10e7c5f019284aa5dde113f23d34a456 (sha256 feed403a8a81252c9e9f6a094576be6c10e7c5f019284aa5dde113f23d34a456), spec_fingerprint 89c0f33a7d88261f666404a05447dcbcee682836ef33db2cdc94324f94c96aa2" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 100 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


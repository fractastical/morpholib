        schema:unitText "mm" ;
        schema:value "3.113" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-chick-e12-3d-kirchhoff-rod-relaxed-loop-wavelength-lambda-sim-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-chick-e12-3d-kirchhoff-rod-relaxed-loop-wavelength-lambda-sim-reference> a schema:PropertyValue ;

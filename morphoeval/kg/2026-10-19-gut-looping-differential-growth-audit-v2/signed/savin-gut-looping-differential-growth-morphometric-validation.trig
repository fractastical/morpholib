sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-4-species-gut-loop-radius-of-curvature-scaling-correlation-savin-et-al-2011-fig-4f> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "4-species gut loop radius of curvature scaling correlation (Savin et al. 2011 Fig. 4f) = 0.9999 Pearson r" ;
        dcterms:description "RMSE = 0.0081 mm, p=4.98e-25" ;
        schema:measurementTechnique "Linear regression of predicted c_R*ell_* vs measured loop radius R across 14 stages in 4 vertebrates (p=4.98e-25, RMSE=0.0081 mm)" ;
        schema:name "4-species gut loop radius of curvature scaling correlation (Savin et al. 2011 Fig. 4f)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-4-species-gut-loop-radius-of-curvature-scaling-correlation-savin-et-al-2011-fig-4f-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-4-species-gut-loop-radius-of-curvature-scaling-correlation-savin-et-al-2011-fig-4f-reference> a schema:PropertyValue ;

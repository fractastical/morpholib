            pk:EvidenceItem ;
        rdfs:label "Chick E12 3D Kirchhoff rod relaxed loop wavelength lambda_sim = 3.113 mm" ;
        dcterms:description "relaxed loop radius R_sim = 1.1062 mm vs ref 1.1500 mm" ;
        schema:measurementTechnique "L-BFGS-B energy minimization of 120-node 3D Kirchhoff rod + neo-Hookean mesentery at Chick E12 (epsilon=3.1212)" ;

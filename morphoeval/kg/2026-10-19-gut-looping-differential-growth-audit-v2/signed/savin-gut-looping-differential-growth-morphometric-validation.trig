        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-4-species-gut-loop-wavelength-scaling-correlation-savin-et-al-2011-fig-4e> a schema:PropertyValue,

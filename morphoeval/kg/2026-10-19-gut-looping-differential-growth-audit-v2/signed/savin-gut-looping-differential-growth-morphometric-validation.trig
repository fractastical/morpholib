            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-biological-specimen-segmented-inter-loop-wavelength-cv-intestine-mesentery-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-bmp2-vs-noggin-loop-count-modulation-ratio-at-e12-nerurkar-et-al-2017-pnas>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-chick-e12-3d-kirchhoff-rod-relaxed-loop-radius-r-sim>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-chick-e12-3d-kirchhoff-rod-relaxed-loop-wavelength-lambda-sim>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-cross-species-log-log-power-law-scaling-exponent-alpha-lambda-ell-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-surgical-mesentery-ablation-negative-control-tortuosity-epsilon-0-vs-e12-wild-type>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-universal-dimensionless-wavelength-to-radius-invariant-lambda-r-across-4-vertebrates>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;

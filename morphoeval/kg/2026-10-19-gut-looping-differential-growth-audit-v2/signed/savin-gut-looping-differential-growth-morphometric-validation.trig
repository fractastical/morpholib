        dcterms:description "radius log-log slope = 0.9909 ± 0.0027" ;
        schema:measurementTechnique "Log-log OLS slope of log(lambda_obs) vs log(ell_*) across 14 vertebrate data points (SE ± 0.0029)" ;
        schema:name "Cross-species log-log power-law scaling exponent alpha (lambda ~ ell_*^alpha)" ;
        schema:unitText "exponent" ;
        schema:value "0.9909" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-cross-species-log-log-power-law-scaling-exponent-alpha-lambda-ell-alpha-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-cross-species-log-log-power-law-scaling-exponent-alpha-lambda-ell-alpha-reference> a schema:PropertyValue ;
        dcterms:source "Savin et al. (2011) Nature 476:57-62 Eq. (lambda ~ (E_t*I_t/(E_m*h_m))^(1/3) = ell_*^1.0)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-surgical-mesentery-ablation-negative-control-tortuosity-epsilon-0-vs-e12-wild-type> a schema:PropertyValue,

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-surgical-mesentery-ablation-negative-control-tortuosity-epsilon-0-vs-e12-wild-type-reference> a schema:PropertyValue ;

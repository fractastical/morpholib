        schema:unitText "CV (std/mean)" ;
        schema:value "0.2319" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-biological-specimen-segmented-inter-loop-wavelength-cv-intestine-mesentery-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-measurement-biological-specimen-segmented-inter-loop-wavelength-cv-intestine-mesentery-specimen-jpg-reference> a schema:PropertyValue ;

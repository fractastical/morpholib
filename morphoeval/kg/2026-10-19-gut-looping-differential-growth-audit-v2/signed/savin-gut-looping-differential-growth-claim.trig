sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> a pk:Claim ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis faithfully reproduces Vertebrate midgut & dorsal mesentery (Gallus gallus, Coturnix japonica, Taeniopygia guttata, Mus musculus) morphology" ;
        dcterms:description "The simulation script(s) 2011-savin-gut-looping-differential-growth.py implement the cited source model as published and produce forms that match real Vertebrate midgut & dorsal mesentery (Gallus gallus, Coturnix japonica, Taeniopygia guttata, Mus musculus) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 92.4/100, audit 2026-10-19-gut-looping-differential-growth-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py; output: docs/media/gut_looping_differential_growth_comparison.png; organism: Vertebrate midgut & dorsal mesentery (Gallus gallus, Coturnix japonica, Taeniopygia guttata, Mus musculus); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 643f6989deff1f1d47f576fe1e43c257f747c5e39321e10638b972d0ac0dc491; artifact_sha256: cb61655dfbcbf3d212d1088294b500e3b21838e47decc5f9fb24cc8630af7b2d; input_dataset_sha256: {datasets/gut_looping_differential_growth/gut_looping_differential_growth_reference.json=f73121bb4140187f..., datasets/gut_looping_differential_growth/intestine_mesentery_specimen.jpg=e12fee9ac1fb5f3d..., datasets/gut_looping_differential_growth/paper_citations.bib=21703c48df51dd52..., datasets/gut_looping_differential_growth/scout_manifest.json=0723b42b4d825087...}; supersedes_audit_id: 2026-10-19-gut-looping-differential-growth-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1038/nature10277>,
            <https://doi.org/10.1073/pnas.0803578105>,
            <https://doi.org/10.1073/pnas.1618677114>,
            <https://doi.org/10.1126/science.1238842> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> ;
        pk:weightOfEvidence "0.924"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py> a schema:SoftwareSourceCode ;

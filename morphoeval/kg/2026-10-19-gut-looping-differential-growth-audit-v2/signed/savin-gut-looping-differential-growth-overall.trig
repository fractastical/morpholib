sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-overall> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — MorphoEval overall 92.4/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Pass 2 (v2) evaluation of `2011-savin-gut-looping-differential-growth.py` (overall weighted score: 92.6/100, up from 56.4/100 in v1). The remediated script relaxes a 120-node 3D discrete Kirchhoff elastic rod coupled to a stretched neo-Hookean dorsal mesentery sheet via L-BFGS-B energy minimization; reproduces Savin et al.'s (2011) universal cube-law scaling collapse across 14 developmental stages in 4 vertebrate species (zebra finch, quail, chick, mouse; r = 0.9999, RMSE = 0.025 mm, log-log exponent alpha = 0.9963 ± 0.0044); validates surgical mesentery ablation (epsilon = 0 -> 0 loops, tortuosity = 1.0000) and Nerurkar et al. (2017) BMP2/Noggin perturbations; and segments the SHA-256-locked biological specimen image (`intestine_mesentery_specimen.jpg`, 76 loop apices, CV = 0.2319). Overall 92.4/100 (faithfulness 91.9, reproducibility 93.4); rubric morphoeval 0.1.0; checkpoint commit 8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 94, Morphological realism / specimen match 90, Parameter expressivity 91, Morphometric validation 93, Source and data traceability 95, Code-to-model traceability 92, Reproducibility package 93. Output judged: docs/media/gut_looping_differential_growth_comparison.png: rendered output of 2011-savin-gut-looping-differential-growth.py at 8871db0, image/png, 952385 B, 2119×1452 px, artifact_sha256 cb61655dfbcbf3d212d1088294b500e3b21838e47decc5f9fb24cc8630af7b2d (sha256 cb61655dfbcbf3d212d1088294b500e3b21838e47decc5f9fb24cc8630af7b2d), spec_fingerprint 643f6989deff1f1d47f576fe1e43c257f747c5e39321e10638b972d0ac0dc491. Dual provenance: spec_fingerprint: 643f6989deff1f1d47f576fe1e43c257f747c5e39321e10638b972d0ac0dc491; artifact_sha256: cb61655dfbcbf3d212d1088294b500e3b21838e47decc5f9fb24cc8630af7b2d; input_dataset_sha256: {datasets/gut_looping_differential_growth/gut_looping_differential_growth_reference.json=f73121bb4140187f..., datasets/gut_looping_differential_growth/intestine_mesentery_specimen.jpg=e12fee9ac1fb5f3d..., datasets/gut_looping_differential_growth/paper_citations.bib=21703c48df51dd52..., datasets/gut_looping_differential_growth/scout_manifest.json=0723b42b4d825087...}. Supersedes audit: 2026-10-19-gut-looping-differential-growth-audit." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Couple the 3D discrete Kirchhoff rod to a full 2D finite-element triangular mesh of the fan-shaped dorsal mesentery with spatially varying apicobasal Pitx2 stiffness gradients." ;
        pk:hasScore "0.924"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


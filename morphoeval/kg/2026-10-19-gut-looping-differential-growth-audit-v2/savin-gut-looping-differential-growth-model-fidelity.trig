sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements Savin et al.'s (2011) exact differential strain epsilon = (L_t - L_m)/L_m, annular second moment of area I_t = (pi/4)*(R_t^4 - R_i^4), cube-root characteristic length ell_* = (E_t*I_t / (E_m*h_m))^(1/3) (L114-144), and a 120-node 3D discrete Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery L-BFGS-B energy minimizer (`relax_kirchhoff_gut_rod`, L149-292) with surgical mesentery ablation (epsilon = 0 -> straight unlooped rod, tortuosity = 1.0000) and BMP2/Noggin perturbation controls (L434-478), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L114–L144" ;
        dct:description "Exact differential strain, annular inertia I_t, and cube-root characteristic length ell_*" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L114-L144> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L149–L292" ;
        dct:description "3D discrete Kirchhoff elastic rod + neo-Hookean dorsal mesentery L-BFGS-B energy minimizer and epsilon=0 ablation control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L149-L292> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean L11–L86" ;
        dct:description "3 machine-checked Lean 4 theorems for differential strain, cube-law stationarity, and annular inertia factorization (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L11-L86> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module and function docstrings map every equation to Savin et al. (2011) Figs. 1-4 & Supplementary Sec. S2-S4, Nerurkar et al. (2017) PNAS Figs. 2-3, Kurpios et al. (2008) PNAS, and the 3 formal Lean 4 theorems in `morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean` (L1-42, L114-165)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-code-traceability-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L1–L42" ;
        dct:description "Explicit equation-to-paper and Lean 4 theorem traceability in module header" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L1-L42> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 2 Assessor)" ;

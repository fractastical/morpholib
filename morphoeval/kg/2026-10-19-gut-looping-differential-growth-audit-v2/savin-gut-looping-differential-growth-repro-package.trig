sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Reproducibility package: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "8-point `self_test()` suite (`L952-999`) verifying SHA-256 dataset integrity, JSON-to-code parity, zero-strain surgical ablation uncoiling, Chick E8-E16 monotonicity & L-BFGS-B energy drop, 4-species scaling collapse, BMP2/WT/Noggin loop ordering, specimen CV segmentation, and two-run bitwise determinism (`np.allclose(..., atol=0.0)`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-repro-package-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L952–L999" ;
        dct:description "Comprehensive 8-check self_test() including bitwise determinism and ablation invariants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L952-L999> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


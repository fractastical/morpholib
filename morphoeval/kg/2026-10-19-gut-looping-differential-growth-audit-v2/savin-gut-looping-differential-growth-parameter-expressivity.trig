sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Spans 5 Chick ontogenetic stages (E8-E16, epsilon in [1.26, 3.72], L298-353), 14 developmental stages across 4 vertebrate species spanning a 6.3-fold range in ell_* (0.230 to 1.447 mm, L356-431), 4 signaling/surgical conditions at E12 (surgical ablation epsilon=0, RCAS-Noggin epsilon=1.95, Wild-Type epsilon=3.12, RCAS-BMP2 epsilon=4.15, L434-478), and exposes `--epsilon`, `--E-ratio`, `--R-t`, `--h-m`, and `--seed` CLI overrides (L1002-1028)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L356–L478" ;
        dct:description "14-point 4-species morphospace evaluation and 4-condition BMP2/Noggin/ablation sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L356-L478> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L1002–L1028" ;
        dct:description "CLI parameter overrides wired into evaluate_chick_stages and figure rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L1002-L1028> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


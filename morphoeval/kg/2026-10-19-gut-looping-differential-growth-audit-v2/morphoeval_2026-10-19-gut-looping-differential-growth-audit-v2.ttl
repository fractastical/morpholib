<https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Morphological realism / specimen match: 90/100" ;

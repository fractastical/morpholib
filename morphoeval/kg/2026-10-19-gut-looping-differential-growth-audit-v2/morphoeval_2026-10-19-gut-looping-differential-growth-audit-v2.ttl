<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/savin-gut-looping-differential-growth-1>,
        <https://w3id.org/probknow/resource/math-law/savin-gut-looping-differential-growth-2>,
        <https://w3id.org/probknow/resource/math-law/savin-gut-looping-differential-growth-3> .

<https://w3id.org/probknow/resource/math-law/savin-gut-looping-differential-growth-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Savin et al. (2011) Differential Growth Strain & Surgical Mesentery Ablation Law" ;
    dct:description "Quantifies the compressive mechanical mismatch driving midgut looping and predicts complete uncoiling upon surgical mesentery dissection or zero differential growth | Variables: L_t: relaxed intestinal tube length (mm); L_m: relaxed dorsal mesentery attachment length (mm); ε: differential growth strain" ;
    dct:source "Savin et al. (2011) Nature 476:57-62 Fig. 1d-g & p. 58" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L140-L230>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L24-L35> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def diff_growth_excess (L_t L_m : Int) : Int :=
  L_t - L_m
theorem savin_equal_growth_zero_strain (L : Int) :
    diff_growth_excess L L = 0 ∧
    ∀ dL : Nat, diff_growth_excess (L + Int.ofNat (dL + 1)) L = Int.ofNat (dL + 1)
"""^^pk:lean4 ;
    skos:notation "ε = (L_t - L_m) / L_m = L_t / L_m - 1;  ε = 0 ⇔ L_t = L_m (zero buckling force)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature10277>,
        <https://doi.org/10.1073/pnas.0803578105>,
        <https://doi.org/10.1073/pnas.1618677114>,
        <https://doi.org/10.1126/science.1238842> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Kirchhoff Elastic Rod & Stretched Neo-Hookean Dorsal Mesentery Differential-Growth Buckling" ;
    pk:leanDeclaration "MathOfBiology.Loop_062.diff_growth_excess" ;
    pk:leanTheorem "MathOfBiology.Loop_062.savin_equal_growth_zero_strain" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/savin-gut-looping-differential-growth-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Savin et al. (2011) Cube-Law Wavelength & Loop Radius Scaling Law" ;
    dct:description "Predicts embryonic gut loop wavelength and radius across chick ontogeny (E8-E16) and across 4 vertebrate species (zebra finch, quail, chick, mouse) without free species-specific parameters | Variables: λ: gut loop wavelength (mm); R: mean loop radius of curvature (mm); B_t = E_t I_t: gut rod bending stiffness; K_m = E_m h_m: mesenteric sheet tensile stiffness; ℓ_* = (E_t I_t / (E_m h_m))^(1/3)" ;
    dct:source "Savin et al. (2011) Nature 476:57-62 pp. 59-61, Figs. 3e-f & 4e-f" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L140-L310>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L53-L58> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def savin_euler_lagrange_residual (lam B_t K_m : Int) : Int :=
  K_m * (lam * lam * lam) - 2 * B_t
theorem savin_cube_law_stationarity (lam K_m : Int) :
    savin_euler_lagrange_residual lam (K_m * (lam * lam * lam)) (2 * K_m) = 0 := by
  simp [savin_euler_lagrange_residual, Int.mul_assoc, Int.mul_comm, Int.mul_left_comm]
"""^^pk:lean4 ;
    skos:notation "U_tot(λ) = B_t / λ^2 + K_m λ  ⇒  ∂U_tot/∂λ = 0  ⇔  λ = c_λ (E_t I_t / (E_m h_m))^(1/3),  R = c_R (E_t I_t / (E_m h_m))^(1/3)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature10277>,
        <https://doi.org/10.1073/pnas.0803578105>,
        <https://doi.org/10.1073/pnas.1618677114>,
        <https://doi.org/10.1126/science.1238842> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Kirchhoff Elastic Rod & Stretched Neo-Hookean Dorsal Mesentery Differential-Growth Buckling" ;
    pk:leanDeclaration "MathOfBiology.Loop_062.savin_euler_lagrange_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_062.savin_cube_law_stationarity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/savin-gut-looping-differential-growth-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hollow Annular Gut Tube Area Moment of Inertia Factorization Law" ;
    dct:description "Determines the quartic sensitivity of gut bending stiffness B_t = E_t I_t to outer and inner lumen radii during embryonic growth | Variables: R_t: outer gut tube radius (mm); R_i: inner lumen radius (mm); I_t: second moment of area (mm^4)" ;
    dct:source "Savin et al. (2011) Nature 476:57-62 p. 59 & Supplementary Information Sec. S2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L140-L185>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_062_gut_looping_differential_growth.lean#L73-L86> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def savin_annular_inertia_scaled (R_t R_i : Int) : Int :=
  R_t * R_t * R_t * R_t - R_i * R_i * R_i * R_i
def savin_annular_inertia_factored (R_t R_i : Int) : Int :=
  (R_t - R_i) * (R_t + R_i) * (R_t * R_t + R_i * R_i)
theorem savin_annular_inertia_factorization (R_t R_i : Int) :
    savin_annular_inertia_scaled R_t R_i = savin_annular_inertia_factored R_t R_i ∧
    savin_annular_inertia_scaled 2 1 = 15 ∧
    savin_annular_inertia_scaled 3 1 = 80
"""^^pk:lean4 ;
    skos:notation "I_t = (π / 4) (R_t^4 - R_i^4) = (π / 4) (R_t - R_i)(R_t + R_i)(R_t^2 + R_i^2) > 0  for R_t > R_i" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature10277>,
        <https://doi.org/10.1073/pnas.0803578105>,
        <https://doi.org/10.1073/pnas.1618677114>,
        <https://doi.org/10.1126/science.1238842> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Kirchhoff Elastic Rod & Stretched Neo-Hookean Dorsal Mesentery Differential-Growth Buckling" ;
    pk:leanDeclaration "MathOfBiology.Loop_062.savin_annular_inertia_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_062.savin_annular_inertia_factorization" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 biological specimen image `datasets/gut_looping_differential_growth/intestine_mesentery_specimen.jpg`, segments the yellow-orange vascularized dorsal mesentery fan and pinkish-red intestinal loop coils (`segment_intestine_mesentery_specimen`, L484-565; 76 loop apices, mean inter-loop spacing 22.30 px, CV = 0.2319), and matches all 14 empirical points across Zebra finch, Quail, Chick, and Mouse (Savin et al. 2011 Fig. 4e-f, r = 0.9999)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L484–L565" ;
        dct:description "Chromaticity + DoG ridge segmentation of dorsal mesentery sheet and 76 intestinal loop apices" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L484-L565> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/gut_looping_differential_growth_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 3D Kirchhoff rod, 4-species collapse, BMP2/Noggin/ablation controls, and specimen segmentation — docs/media/gut_looping_differential_growth_comparison.png: rendered output of 2011-savin-gut-looping-differential-growth.py at 8871db0, image/png, 952385 B, 2119×1452 px, artifact_sha256 cb61655dfbcbf3d212d1088294b500e3b21838e47decc5f9fb24cc8630af7b2d (sha256 cb61655dfbcbf3d212d1088294b500e3b21838e47decc5f9fb24cc8630af7b2d), spec_fingerprint 643f6989deff1f1d47f576fe1e43c257f747c5e39321e10638b972d0ac0dc491" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Model fidelity to source: 66/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates the Mongera et al. (2018) rigidity-percolation yield stress scaling `sigma_y(phi_ECS)` (`compute_yield_stress_v1`, L33-49) and a 1D posterior-to-anterior `phi_ECS(x)` gradient (`simulate_tailbud_jamming_v1`, L52-80). However, v1 omits active Myosin-II cell-scale tension fluctuations `sigma_A(x)`, omits Kramers/Eyring T1 cage-breaking rates `k_T1(x)` (Kim et al. 2021), and omits 2D Bingham viscoplastic tailbud flow and `cdh2` morphant bilateral asymmetry mechanics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2022-tailbud-neuromesodermal-jamming.py L52–L80: 1D baseline lacks active tension fluctuations sigma_A(x), T1 rearrangement rate k_T1(x), and 2D Bingham viscoplastic axis elongation <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L52-L80>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-1> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L33–L49" ;
        dct:description "Mongera et al. (2018) rigidity-percolation yield stress equation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L33-L49> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


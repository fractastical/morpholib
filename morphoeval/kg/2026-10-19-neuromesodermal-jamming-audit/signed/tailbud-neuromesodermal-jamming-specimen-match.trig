sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Morphological realism / specimen match: 34/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/neuromesodermal_jamming/zebrafish_tailbud_psm_specimen.jpg` (IDR0051 zebrafish tailbud lightsheet micrograph) is vendored in the repository, the v1 script never loads, verifies, or segments the micrograph (`render_outputs_v1`, L83-152) and renders only a 3-panel synthetic plot." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2022-tailbud-neuromesodermal-jamming.py L83–L152: render_outputs_v1 renders 3 synthetic panels without loading or segmenting zebrafish_tailbud_psm_specimen.jpg <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L83-L152>",
            "docs/media/neuromesodermal_jamming_comparison.png (generated output, not in repo): 3-panel synthetic figure lacking biological specimen segmentation overlay or empirical ECS/packing match — docs/media/neuromesodermal_jamming_comparison.png: rendered output of 2022-tailbud-neuromesodermal-jamming.py at 0cb0132, image/png, 82041 B, 1755×546 px, artifact_sha256 f128c0da1d1f0d2d9c9f49460ff29892ff09eabb6e8f1dfcd0eb2453fb4d4d43 (sha256 f128c0da1d1f0d2d9c9f49460ff29892ff09eabb6e8f1dfcd0eb2453fb4d4d43), spec_fingerprint 5225f2c29acda8d1ee81d082219556f85a1159006d552c629f56ce7d8a842027" ;
        pk:hasScore "0.34"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


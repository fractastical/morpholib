            <https://doi.org/10.1038/s41586-018-0479-2>,
            <https://doi.org/10.1242/dev.090381> .
    <https://doi.org/10.1016/j.cub.2013.05.052> dct:date "2013"^^xsd:gYear ;
        dct:title "Cell-fibronectin interactions propel vertebrate trunk elongation via tissue mechanics" .
    <https://doi.org/10.1038/nmeth.4101> dct:date "2017"^^xsd:gYear ;
        dct:title "In vivo quantification of spatially varying mechanical properties in developing tissues" .
    <https://doi.org/10.1038/s41567-021-01215-1> dct:date "2021"^^xsd:gYear ;
        dct:title "Embryonic tissues as active foams" .
    <https://doi.org/10.1038/s41586-018-0479-2> dct:date "2018"^^xsd:gYear ;
        dct:title "A fluid-to-solid jamming transition underlies vertebrate body axis elongation" .
    <https://doi.org/10.1242/dev.090381> dct:date "2013"^^xsd:gYear ;
        dct:title "Regulated tissue fluidity steers zebrafish body elongation" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Morphometric validation: 53/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes 3 basic summary values (`mpz_yield_stress_Pa`, `apsm_yield_stress_Pa`, `critical_packing_phi_c`, L155-177), but does not validate simulated `phi_ECS(x)`, `sigma_y(x)`, `sigma_A(x)`, `k_T1(x)`, elongation velocity `v_elong`, or bilateral asymmetry against Mongera et al. (2018) reference tables, nor does it extract nuclear packing or interstitial void fractions from the zebrafish tailbud specimen." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2022-tailbud-neuromesodermal-jamming.py L155–L177: Only 3 basic metrics without Mongera et al. (2018) AP profile correlation, perturbation validation, or specimen segmentation <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L155-L177>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-apsm-yield-stress-pa>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-critical-packing-phi-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-mpz-yield-stress-pa> ;
        pk:hasScore "0.53"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-apsm-yield-stress-pa> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "apsm_yield_stress_Pa = 115.5672 Pa" ;
        schema:measurementTechnique "Anterior PSM solid yield stress plateau" ;
        schema:name "apsm_yield_stress_Pa" ;
        schema:unitText "Pa" ;
        schema:value "115.5672" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-apsm-yield-stress-pa-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-apsm-yield-stress-pa-reference> a schema:PropertyValue ;
        schema:value "118.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-critical-packing-phi-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_packing_phi_c = 0.86 dimensionless" ;
        schema:measurementTechnique "Rigidity-percolation critical cell packing fraction" ;
        schema:name "critical_packing_phi_c" ;
        schema:unitText "dimensionless" ;
        schema:value "0.86" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-critical-packing-phi-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-critical-packing-phi-c-reference> a schema:PropertyValue ;
        schema:value "0.86" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-mpz-yield-stress-pa> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mpz_yield_stress_Pa = 2.7729 Pa" ;
        schema:measurementTechnique "Posterior MPZ yield stress near rigidity threshold" ;
        schema:name "mpz_yield_stress_Pa" ;
        schema:unitText "Pa" ;
        schema:value "2.7729" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-mpz-yield-stress-pa-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-mpz-yield-stress-pa-reference> a schema:PropertyValue ;
        schema:value "11.2" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila melanogaster Schnakenberg Turing wavelength at 2.736 µm (Holocene, 0 Ma) — Reproducibility package: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Seed 3192, documented --self-test, runtime SHA-256 check, and a known-good note for Python 3.12 / numpy 2.5 / scipy 1.18 / Pillow 13 / matplotlib 3.11. Self-test covers wavelength order, negative Turing margin under equal diffusion, monotone gamma sweep, pattern-versus- ablation std, and dispersion r > 0.98. Deduction: dependencies are not a per-script lockfile, and Lean was not run." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py L767–L801" ;
        dct:description "self_test assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py#L767-L801> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;

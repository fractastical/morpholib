        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-source-traceability-3> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila melanogaster Schnakenberg Turing wavelength at 2.736 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The comparison figure places the Karwath adult male beside the steady activator. The growth GIF (16 frames, 768x576) ends on that photograph darkened where the activator is high (amplitude 0.16). Computer-vision similarity of that last frame to the pinned file is 96.0. The lattice itself is a spot field at the 2.7 µm scale; it is not a portrait of the fly and not an ocellus micrograph. The score credits the registered animal and the correct form class (spots), and withholds the rest." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-specimen-match-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-specimen-match-3> ;
    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .


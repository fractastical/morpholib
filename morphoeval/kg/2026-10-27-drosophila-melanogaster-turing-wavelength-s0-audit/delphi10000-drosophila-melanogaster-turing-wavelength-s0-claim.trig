        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila melanogaster Schnakenberg Turing wavelength at 2.736 µm (Holocene, 0 Ma) faithfully reproduces Drosophila melanogaster morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila melanogaster specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py; output: docs/media/drosophila_melanogaster_turing_wavelength_s0_comparison.png; organism: Drosophila melanogaster; environment: n/a; claim_boundary: [reported_in_source: Turing (1952) selects a finite wavelength by diffusion-driven instability. | Schnakenberg (1979) kinetics are f = a - u + u^2 v and g = b - u^2 v. | Wittkopp, True and Carroll (2002) place Drosophila melanin via Yellow and Ebony. | True et al. (1997) quantify morphological divergence of D. mauritiana from the simulans complex. | Richards et al. (2005) compare the D. pseudoobscura genome with D. melanogaster. | The Karwath photograph is an adult male D. melanogaster under CC BY-SA 2.5.; reconstructed_in_script: Gamma = 1.032078 is solved so argmax sigma(k) = 2 pi / 2.736 per micrometre. | Mauritiana (a=0.16, b=0.72, Du=0.055, Dv=1.15) and miranda (a=0.07, b=1.25, Du=0.020, Dv=2.20) wavelengths at that shared gamma. | Explicit-Euler periodic integration, radial-FFT wavelength, and eigenvector growth-rate correlation. | Registration of the steady activator onto the photograph at amplitude 0.16.; transfer_boundary: 2.736 µm is the assigned detail scale for this slot, not a published melanin-granule spacing. | Chronospecies wavelengths are reconstructions. True 1997 and Richards 2005 do not report these micrometre values. | Richards 2005 sequenced D. pseudoobscura. D. miranda is in that obscura clade; the paper is not a miranda pigment micrograph.; does_not_claim: That adult abdominal stripes or ommatidia have wavelength 2.736 µm. | That the spot lattice is a photograph of an ocellus. | That a near-unit dispersion correlation validates the nonlinear field against an electron micrograph. | A second independent assessor.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1101/gr.3059305>,
            <https://doi.org/10.1111/j.1558-5646.1997.tb03664.x>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1242/dev.129.8.1849> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-melanogaster-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_ks_statistic = 0.7262620192307693 KS" ;
        schema:measurementTechnique "Kolmogorov-Smirnov statistic of σ residuals against N(0, s); 0.05 is an α convention, not the statistic" ;
        schema:name "dispersion_ks_statistic" ;
        schema:unitText "KS" ;
        schema:value "0.7262620192307693" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.05" .

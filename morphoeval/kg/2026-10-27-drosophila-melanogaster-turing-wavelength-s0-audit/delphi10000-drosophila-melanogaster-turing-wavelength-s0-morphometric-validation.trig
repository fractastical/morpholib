sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila melanogaster Schnakenberg Turing wavelength at 2.736 µm (Holocene, 0 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion goodness-of-fit on 13 patterned-band modes: Pearson r = 0.9999999989 (reference 1, not equal), RMSE = 4.62e-5 (reference 0). The nonlinear FFT wavelength is 2.799 µm against the 2.736 µm target (2.3% long), so the field metric is not a copy of the target. Specimen foreground fraction is 0.505 (reference 0.50, not equal), contour circularity 0.044 against a circle at 1, and structure-tensor coherency 0.464. Equal-diffusion std ratio is about 1496 (reference 1). The KS statistic of residuals against an independent normal is 0.726 (p ~ 4e-7): the residuals are tighter and less Gaussian than that reference. That is reported, not hidden, and it is why this dimension is not in the 90s." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-chronospecies-lambda-gap-mauritiana-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-chronospecies-lambda-gap-miranda-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-equal-diffusion-control-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-gamma-sweep-lambda-span-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-registered-image-pearson-vs-shuffled-null>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-simulated-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-specimen-bbox-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-specimen-foreground-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-specimen-segment-image-left-third-luminance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-specimen-segment-image-mid-third-luminance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-specimen-segment-image-right-third-luminance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-chronospecies-lambda-gap-mauritiana-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronospecies_lambda_gap_mauritiana_um = 0.5060536227493158 µm" ;
        schema:measurementTechnique "λ(mauritiana) − λ(melanogaster) at shared γ; predecessor is longer" ;

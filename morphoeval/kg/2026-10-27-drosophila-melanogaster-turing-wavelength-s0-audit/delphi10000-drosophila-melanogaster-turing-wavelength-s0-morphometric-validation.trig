            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.999999998906132 correlation" ;
        schema:measurementTechnique "Pearson r between analytic σ(k) and eigenvector-initialised numerical growth rates" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "correlation" ;
        schema:value "0.999999998906132" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "perfect linear agreement; measured r is not identically 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,

        schema:unitText "µm" ;
        schema:value "0.5060536227493158" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-melanogaster-turing-wavelength-s0-measurement-chronospecies-lambda-gap-mauritiana-um-reference> .

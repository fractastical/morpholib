        rdfs:label "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Module docstring states the scale, the age, and which species changes a. steady_state, onset_k2, and sigma_of_k are the textbook objects. Lean theorems restate the ordering the script checks by rounding nanometres. The render composite is labeled as a modulation, not as a derivation of the veins." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L1–L24" ;
        dct:description "scale, age, chronoseries, and the claim about a" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L1-L24> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-drosophila-virilis-turing-wavelength-s0.yaml L1–L55" ;
        dct:description "law records pointing at the Lean declarations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/math_kg_loops/delphi10000-drosophila-virilis-turing-wavelength-s0.yaml#L1-L55> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

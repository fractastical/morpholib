    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The comparison figure places the Hanson habitus, its foreground mask, the saturated activator field, the three-species dispersion curves, and the adult endpoint side by side. The endpoint resembles the fly because it is the photograph with a bounded modulation, which is the right macro appearance and a weak display of the 3.1 µm texture. The mask follows the body, wings, and legs. Willistoni's dispersion curve stays negative while virilis and teissieri cross above zero." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match-3> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) (Drosophila virilis)",
        "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) faithfully reproduces Drosophila virilis morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-virilis-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-virilis-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-virilis-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-virilis-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py, docs/media/drosophila_virilis_turing_wavelength_s0_growth.gif, morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Drosophila virilis specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_virilis_turing_wavelength_s0_growth.gif>,
        <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean> ;
    schema:about "Drosophila virilis" ;
    schema:additionalProperty "does_not_claim: That chorion-filament number enters the wavenumber law.",
        "does_not_claim: That the PDE generated the wing veins or the body outline.",
        "does_not_claim: That the habitus photograph resolves a 3.1 µm pigment wavelength (measured Nyquist is 7.76 µm).",
        "does_not_claim: That willistoni lost a Turing pattern through geological time (successor is extant, 0 Ma).",
        "reconstructed_in_script: Adult GIF endpoint is the habitus photograph modulated by the normalized PDE field.",
        "reconstructed_in_script: Du solved so virilis onset λ_c = 3.101 µm at Dv/Du = 10 and b = 0.90.",
        "reconstructed_in_script: Teissieri a = 0.058 and willistoni a = 0.360 as the chronoseries step at fixed age and fixed diffusivities.",
        "reconstructed_in_script: Tergite mode counts from project atlas adult lengths divided by seven.",
        "reported_in_source: Gompel et al. 2005: abdominal pigment differences among Drosophila species are cis-regulatory, including posterior bands in the melanogaster subgroup.",
        "reported_in_source: Hanson 2019 CC BY-SA 4.0 lateral habitus of Drosophila virilis (Wikimedia File:Dvir 1-2.jpg).",
        "reported_in_source: Schnakenberg 1979 kinetics and the steady state u0 = a + b, v0 = b/(a+b)^2.",
        "reported_in_source: Turing 1952 critical-wavenumber selection from the dispersion relation of a two-species reaction-diffusion system.",
        "transfer_boundary: Atlas body lengths are used only to turn a wavelength into a mode count.",
        "transfer_boundary: The 3.101 µm target is the slot scale. It is not a published ocellus measurement for D. virilis." ;

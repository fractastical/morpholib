<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-virilis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg homogeneous steady state" ;
    dct:description "At 0 Ma the chronoseries step changes basal activator production, not age and not Du. | Variables: a species-specific; b = 0.90 shared; a milli-units 58 < 100 < 360" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b / (a + b)^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3210.activatorMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3210.activator_rises_along_the_chronoseries" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-virilis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Poson law k_c at the 3.1 µm detail scale. | Variables: Du shared, Dv = 10 Du, lambda(teissieri)=2924 nm < lambda(virilis)=3101 nm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv), lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3210.lambdaVirilisNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3210.predecessor_selects_shorter_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-virilis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Successor quench past the Turing boundary" ;
    dct:description "What the successor loses at this scale is a selected wavenumber, not a smaller body alone. | Variables: willistoni wavelength token 0; virilis wavelength 3101 nm" ;
    dct:source "Turing 1952 conditions; pigmentation context Gompel et al. 2005 DOI:10.1038/nature03235" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "a_willistoni = 0.360 implies the diffusion-driven instability discriminant is negative, lambda_selected = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3210.lambdaWillistoniNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3210.successor_quenches_selected_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-virilis-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail-scale mode count versus the 136 µm sibling" ;
    dct:description "Keeps this 3.1 µm slot from collapsing onto the primordium sibling. | Variables: virilis tergite modes exceed teissieri tergite modes" ;
    dct:source "Murray 1981 scale argument DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N_tergite = (L_adult / 7) / lambda_c; 43 * 3101 nm < 136000 nm < 44 * 3101 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1098/rstb.1952.0012>,

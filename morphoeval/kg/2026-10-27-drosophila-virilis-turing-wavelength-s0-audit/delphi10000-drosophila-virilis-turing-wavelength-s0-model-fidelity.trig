sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg steady state, Jacobian, onset k_c, and the four Turing inequalities are the published relations, and Du is solved from that onset law so virilis sits at 3.101 µm. The 2D field is explicit Euler on a fixed periodic patch. The chronospecies split is a change in a at fixed Du, which is a reconstruction, not a measured diffusivity. Deduction for the fixed domain and for using the habitus only as a modulated photograph rather than as the PDE domain." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L80–L125" ;
        dct:description "steady state, onset k_c^2, Turing inequalities, sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L80-L125> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L171–L210" ;
        dct:description "periodic explicit Euler of Schnakenberg kinetics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L171-L210> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean L14–L48" ;
        dct:description "five sorry-free theorems on wavelength order, quench, activator order, mode count, and the 136 µm separator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean#L14-L48> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the Hanson habitus, its foreground mask, the saturated activator field, the three-species dispersion curves, and the adult endpoint side by side. The endpoint resembles the fly because it is the photograph with a bounded modulation, which is the right macro appearance and a weak display of the 3.1 µm texture. The mask follows the body, wings, and legs. Willistoni's dispersion curve stays negative while virilis and teissieri cross above zero." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_virilis_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "six-panel comparison — docs/media/drosophila_virilis_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py at 0c76d15d, image/png, 564225 B, 1512×984 px, artifact_sha256 f27ebb8d2c1a036dbe5cbd86236a8e9d7ea71a9116efe3980ac1f95b7da69d5e (sha256 f27ebb8d2c1a036dbe5cbd86236a8e9d7ea71a9116efe3980ac1f95b7da69d5e), spec_fingerprint 7b617b1b25587059791fa537573c287d828ce4628df471d7ad0d187921f12af8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_virilis_turing_wavelength_s0_growth.gif (generated output)" ;

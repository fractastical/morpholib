sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) faithfully reproduces Drosophila virilis morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py, docs/media/drosophila_virilis_turing_wavelength_s0_growth.gif, morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Drosophila virilis specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_virilis_turing_wavelength_s0_growth.gif>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py>,
            <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_virilis_turing_wavelength_s0_growth.gif, https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean; output: docs/media/drosophila_virilis_turing_wavelength_s0_comparison.png; organism: Drosophila virilis; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 critical-wavenumber selection from the dispersion relation of a two-species reaction-diffusion system. | Schnakenberg 1979 kinetics and the steady state u0 = a + b, v0 = b/(a+b)^2. | Gompel et al. 2005: abdominal pigment differences among Drosophila species are cis-regulatory, including posterior bands in the melanogaster subgroup. | Hanson 2019 CC BY-SA 4.0 lateral habitus of Drosophila virilis (Wikimedia File:Dvir 1-2.jpg).; reconstructed_in_script: Du solved so virilis onset λ_c = 3.101 µm at Dv/Du = 10 and b = 0.90. | Teissieri a = 0.058 and willistoni a = 0.360 as the chronoseries step at fixed age and fixed diffusivities. | Tergite mode counts from project atlas adult lengths divided by seven. | Adult GIF endpoint is the habitus photograph modulated by the normalized PDE field.; transfer_boundary: The 3.101 µm target is the slot scale. It is not a published ocellus measurement for D. virilis. | Atlas body lengths are used only to turn a wavelength into a mode count.; does_not_claim: That the habitus photograph resolves a 3.1 µm pigment wavelength (measured Nyquist is 7.76 µm). | That willistoni lost a Turing pattern through geological time (successor is extant, 0 Ma). | That chorion-filament number enters the wavenumber law. | That the PDE generated the wing veins or the body outline.]; other sources: Drosophila virilis lateral habitus (File:Dvir 1-2.jpg) <https://commons.wikimedia.org/wiki/File:Dvir_1-2.jpg>; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/nature03235>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/drosophila_virilis_turing_wavelength_s0_growth.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/drosophila_virilis_turing_wavelength_s0_growth.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
    <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean> a schema:SoftwareSourceCode ;
        rdfs:label "morphoeval/lean/loops/Loop_3210_drosophila_virilis_turing_wavelength_s0.lean" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Lean 4" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Dvir_1-2.jpg>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/nature03235>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://commons.wikimedia.org/wiki/File:Dvir_1-2.jpg> dct:title "Drosophila virilis lateral habitus (File:Dvir 1-2.jpg)" .
    <https://doi.org/10.1007/BF00289234> dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/nature03235> dct:title "Chance caught on the wing: cis-regulatory evolution and the origin of pigment patterns in Drosophila" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The Chemical Basis of Morphogenesis" .
    <https://doi.org/10.1126/science.1179047> dct:title "Reaction-Diffusion Model as a Framework for Understanding Biological Pattern Formation" .
}


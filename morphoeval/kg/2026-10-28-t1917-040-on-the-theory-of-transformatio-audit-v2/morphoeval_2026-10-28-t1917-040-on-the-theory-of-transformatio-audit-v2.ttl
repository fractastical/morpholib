<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Procrustes rotation distance invariance" ;
    dct:description "GPA superimposition before Thompson grid warps on profile landmarks | Variables: R: 2×2 rotation; p,q: profile landmark coordinates" ;
    dct:source "Thompson (1917) Ch. XVII; Bookstein (1989) TPS" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cc716ad5c8529ea438a8998b3d46e62a3e104f44/morphoeval/lean/loops/Thompson1917_T1917_040.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "‖R p - R q‖² = ‖p - q‖² for orthogonal R" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.5061/dryad.0zpc86746> ;
    pk:hypothesisType "geometric / Thompson coordinate deformation (Dürer-Camper facial profiles)" ;
    pk:leanDeclaration "MathOfBiology.Loop_232.sq_dist" ;
    pk:leanTheorem "MathOfBiology.Loop_232.procrustes_rotation_preserves_sq_dist" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Vertical grid stretch (Fig. 353)" ;
    dct:description "Dürer proportion grid elongation along craniofacial axis | Variables: k: stretch factor; x,y: Cartesian grid coordinates" ;
    dct:source "Thompson (1917) Fig. 353" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cc716ad5c8529ea438a8998b3d46e62a3e104f44/morphoeval/lean/loops/Thompson1917_T1917_040.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(x, y) ↦ (x, k y)" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.5061/dryad.0zpc86746> ;
    pk:hypothesisType "geometric / Thompson coordinate deformation (Dürer-Camper facial profiles)" ;
    pk:leanDeclaration "MathOfBiology.Loop_232.vert_scale" ;
    pk:leanTheorem "MathOfBiology.Loop_232.vertical_stretch_preserves_x" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-040-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Horizontal shear preserves Frankfort-parallel levels" ;
    dct:description "Oblique-coordinate facial-angle change (Fig. 357 / 366) | Variables: m: shear; y: vertical grid index" ;
    dct:source "Thompson (1917) Figs. 357, 366; Camper facial angle" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cc716ad5c8529ea438a8998b3d46e62a3e104f44/morphoeval/lean/loops/Thompson1917_T1917_040.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(x, y) ↦ (x + m y, y)" ;
    prov:wasDerivedFrom <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.5061/dryad.0zpc86746> ;
    pk:hypothesisType "geometric / Thompson coordinate deformation (Dürer-Camper facial profiles)" ;
    pk:leanDeclaration "MathOfBiology.Loop_232.horiz_shear" ;
    pk:leanTheorem "MathOfBiology.Loop_232.shear_preserves_y" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


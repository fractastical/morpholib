sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 2) — Morphological realism / specimen match: 45/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The accepted silhouettes trace the real profiles and the best-pair Dürer-grid panel reads like Fig. 366; the GIF now uses a specimen with a visible forehead. Still only 4 of 9 specimens pass QC (Keller's wall-shadow gradient, halftone, faded print, texture and lettering all defeat the single Lab background model), the Romy Schneider nasion sits on the hair fringe, lower-lip landmarks are missing on 3 of 4 faces, and the similarity-aligned panel shows visible landmark scatter. Partial credit for honest display of every rejection reason." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-040/t1917_040_landmarks.csv (generated output, not in repo): 5/9 rejected with reasons; accepted rows missing g / sto / li — datasets/thompson_1917/t1917-040/t1917_040_landmarks.csv: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 22ee087d, text/csv, 1425 B, artifact_sha256 02906f25494a8c2f3583794ad4af1761cbe5f36fef0311e4d66a17f997a41729 (sha256 02906f25494a8c2f3583794ad4af1761cbe5f36fef0311e4d66a17f997a41729), spec_fingerprint 814bd4703a2eb758261f2f135d1296d3536158edeb11b7060849c7f375a95447",
            "thompson/claims/t1917-040_on-the-theory-of-transformations.py L485–L515: segment_profile: one global Lab background model; no edge-assisted rescue (R8 partly open) <https://github.com/fractastical/morpholib/blob/22ee087d/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L485-L515>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-specimen-match-1> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_040_on_the_theory_of_transformatio_comparison.png (generated output)" ;
        dct:description "panels b-e: two specimens with landmarks, dense superimposition, best/worst Dürer-grid pairs — docs/media/t1917_040_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 22ee087d, image/png, 608335 B, 1700×1500 px, artifact_sha256 fe2b61061643bce37151c4a4aad81a6a010df2bd3ba096ab8d1dbd8598e5a74a (sha256 fe2b61061643bce37151c4a4aad81a6a010df2bd3ba096ab8d1dbd8598e5a74a), spec_fingerprint 814bd4703a2eb758261f2f135d1296d3536158edeb11b7060849c7f375a95447" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending R1)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


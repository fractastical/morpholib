    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 2) — Reproducibility package: 70/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Deterministic (seed 1917 for the scrambled control and Hough), --self-test covers the algebra, exact-grid recovery, LOO, semilandmarks, landmark sequence and all 14 digests (<1 s); full run ~6 s; every output path fixed; result.json carries the verdict rule and limitations. Deductions: per-specimen annotations (ROI, deskew, k_sigma) are builder-tuned; dependency versions not pinned in the script; no CLI for thresholds." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-parameter-expressivity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 2) — Parameter expressivity: 72/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "omega (50-130 deg) and c (0.67-1.5) sweeps on a real specimen show the E-line inclination strictly monotone in omega and convexity/nasolabial angles moving smoothly with c; the fitted (c, k) per pair are now interpretable and compared with Dürer's own digitised |k| ~ 0.15; the GIF animates the omega sweep. Deductions: fitted c spans 0.07-1.57, i.e. the horizontal stretch is still weakly determined on near-vertical point sets; no CLI exposure of the sweep ranges." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-040/result.json (generated output, not in repo): durer_c_range [0.07, 1.57]: horizontal stretch weakly identified — datasets/thompson_1917/t1917-040/result.json: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 22ee087d, application/json, 6044 B, artifact_sha256 dd154e282abbc5c2dd45d37799514cb2714175f44dbfc9feb8d18f6f7dd9b5eb (sha256 dd154e282abbc5c2dd45d37799514cb2714175f44dbfc9feb8d18f6f7dd9b5eb), spec_fingerprint 814bd4703a2eb758261f2f135d1296d3536158edeb11b7060849c7f375a95447" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-parameter-expressivity-2> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-040_on-the-theory-of-transformations.py L365–L401" ;
        dcterms:description "parameter_sweep (monotone flag) and digitise_fig366_obliquity (Hough)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/22ee087d/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L365-L401> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-040/t1917_040_metrics.json (generated output)" ;
        dcterms:description "parameter_sweep.inclination_monotone_in_omega = true; fig366_obliquity 81.25 / 98.75 deg — datasets/thompson_1917/t1917-040/t1917_040_metrics.json: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 22ee087d, application/json, 8867 B, artifact_sha256 2b1d42d3c10594874c5d805b4a470c53a69c6612e3bbe8a1b72fdd930ebb7756 (sha256 2b1d42d3c10594874c5d805b4a470c53a69c6612e3bbe8a1b72fdd930ebb7756), spec_fingerprint 814bd4703a2eb758261f2f135d1296d3536158edeb11b7060849c7f375a95447" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending R1)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


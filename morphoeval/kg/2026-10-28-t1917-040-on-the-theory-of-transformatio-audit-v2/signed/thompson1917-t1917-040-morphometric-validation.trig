sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 2) — Morphometric validation: 68/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Residuals for null / similarity / Dürer / affine on landmark-only and dense configurations, LOO-CV for each family, a re-detection noise floor, KS test, CV of R, pose sensitivity, E5 regression (r, slope, p, RMSE) and three controls are all computed on real specimens and the verdict rule is written down before being applied. Deductions: n = 4 faces / 12 non-independent ordered pairs; the noise floor is a re-detection repeatability (lower bound of true landmark uncertainty); nasolabial SD 39 deg and convexity n = 2 mean the norm comparison is weak; LOO-CV shows the Dürer family does not generalise better than the null on this sample." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-040_on-the-theory-of-transformations.py L403–L447: noise_floor(): only rescale/blur re-detection, a lower bound <https://github.com/fractastical/morpholib/blob/22ee087d/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L403-L447>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-accepted-specimens-qc-gate-of-vendored-photographs>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-d-rer-residual-noise-floor>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-facial-convexity-angle-g-sn-pg-mean-over-specimens>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-ks-test-null-vs-d-rer-dense-residual-distributions>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-dense-rmse-camper-frame-null-uniform-scale-translation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-dense-rmse-d-rer-grid-stretch-c-shear-k-5-dof>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-r-d-rer-1-ss-d-rer-ss-null-dense>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nasolabial-angle-cm-sn-ls-mean-over-specimens>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nose-only-ablation-on-an-exact-d-rer-grid-median-d-rer-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-pearson-r-fitted-shear-k-vs-measured-tan-e-line-prn-pg-inclination-e5-camper-law>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-positive-control-max-d-rer-rmse-on-an-exact-d-rer-grid-of-a-real-specimen>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-scrambled-correspondence-control-median-d-rer-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-thompson-fig-366-net-obliquity-left-right-head-hough-digitisation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-3> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-accepted-specimens-qc-gate-of-vendored-photographs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "accepted specimens (QC gate) of vendored photographs = 4 count" ;
        schema:measurementTechnique "Lab background-model silhouette + extremum-sequence landmarks; 9 vendored" ;
        schema:name "accepted specimens (QC gate) of vendored photographs" ;
        schema:unitText "count" ;
        schema:value "4" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-d-rer-residual-noise-floor> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dürer residual / noise floor = 23.631 ratio" ;
        dcterms:description "whole-grid claim predicts ~1; verdict rule: <= 1.5 supported, > 3 refuted" ;
        schema:measurementTechnique "median dense Dürer rmse divided by median noise-floor rmse" ;
        schema:name "Dürer residual / noise floor" ;
        schema:unitText "ratio" ;
        schema:value "23.631" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-d-rer-residual-noise-floor-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-d-rer-residual-noise-floor-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-facial-convexity-angle-g-sn-pg-mean-over-specimens> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "facial convexity angle G-Sn-Pg, mean over specimens = 8.47 deg" ;
        dcterms:description "Legan & Burstone 1980 adult norm 12 +/- 4 deg" ;
        schema:measurementTechnique "180 - interior angle at Sn; std = 8.55, n = 2" ;
        schema:name "facial convexity angle G-Sn-Pg, mean over specimens" ;
        schema:unitText "deg" ;
        schema:value "8.47" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-facial-convexity-angle-g-sn-pg-mean-over-specimens-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-facial-convexity-angle-g-sn-pg-mean-over-specimens-reference> a schema:PropertyValue ;
        schema:value "12.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-ks-test-null-vs-d-rer-dense-residual-distributions> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS test, null vs Dürer dense residual distributions = 0.0995 p-value" ;
        schema:measurementTechnique "two-sample Kolmogorov-Smirnov, D = 0.500" ;
        schema:name "KS test, null vs Dürer dense residual distributions" ;
        schema:unitText "p-value" ;
        schema:value "0.0995" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-dense-rmse-camper-frame-null-uniform-scale-translation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median dense RMSE, Camper-frame null (uniform scale + translation) = 0.0833 centroid-size units" ;
        schema:measurementTechnique "3-dof null per ordered pair on common landmarks + 30 semilandmarks; rmse; similarity (4 dof, rotation) median = 0.0804" ;
        schema:name "median dense RMSE, Camper-frame null (uniform scale + translation)" ;
        schema:unitText "centroid-size units" ;
        schema:value "0.0833" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-dense-rmse-d-rer-grid-stretch-c-shear-k-5-dof> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median dense RMSE, Dürer grid (stretch c + shear k, 5 dof) = 0.0687 centroid-size units" ;
        dcterms:description "reference = landmark re-detection noise floor (rescale 0.85/1.15, blur 1 px); claim predicts residual at the noise floor" ;
        schema:measurementTechnique "upper-triangular fit in the Camper frame (E1+E3) vs scale+shift null; rmse; LOO-CV median = 0.0917 (null LOO 0.0910); affine (6 dof) median = 0.0522" ;
        schema:name "median dense RMSE, Dürer grid (stretch c + shear k, 5 dof)" ;
        schema:unitText "centroid-size units" ;
        schema:value "0.0687" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-dense-rmse-d-rer-grid-stretch-c-shear-k-5-dof-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-dense-rmse-d-rer-grid-stretch-c-shear-k-5-dof-reference> a schema:PropertyValue ;
        schema:value "0.0029" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-r-d-rer-1-ss-d-rer-ss-null-dense> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median R_Dürer = 1 - SS(Dürer)/SS(null), dense = 0.4459 fraction" ;
        dcterms:description "claim predicts ~1; 0 = all difference is local" ;
        schema:measurementTechnique "fraction of the non-scale profile difference absorbed by the whole-grid deformation; CV across pairs (landmark-only) = 0.38; pose sensitivity +/-5 deg -> [0.40409384812391097, 0.36652105723875716]" ;
        schema:name "median R_Dürer = 1 - SS(Dürer)/SS(null), dense" ;
        schema:unitText "fraction" ;
        schema:value "0.4459" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-r-d-rer-1-ss-d-rer-ss-null-dense-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-median-r-d-rer-1-ss-d-rer-ss-null-dense-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nasolabial-angle-cm-sn-ls-mean-over-specimens> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nasolabial angle Cm-Sn-Ls, mean over specimens = 93.03 deg" ;
        dcterms:description "Legan & Burstone 1980 adult norm 102 +/- 8 deg" ;
        schema:measurementTechnique "interior angle at Sn; std = 39.02, n = 4" ;
        schema:name "nasolabial angle Cm-Sn-Ls, mean over specimens" ;
        schema:unitText "deg" ;
        schema:value "93.03" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nasolabial-angle-cm-sn-ls-mean-over-specimens-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nasolabial-angle-cm-sn-ls-mean-over-specimens-reference> a schema:PropertyValue ;
        schema:value "102.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nose-only-ablation-on-an-exact-d-rer-grid-median-d-rer-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nose-only ablation on an exact Dürer grid, median Dürer RMSE = 0.0151 centroid-size units" ;
        schema:measurementTechnique "exact grid of each specimen + pronasale displaced anteriorly by 10 % centroid size; the whole-grid family cannot absorb a local change, so the residual must stay > 0 (vs 0 for the positive control)" ;
        schema:name "nose-only ablation on an exact Dürer grid, median Dürer RMSE" ;
        schema:unitText "centroid-size units" ;
        schema:value "0.0151" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nose-only-ablation-on-an-exact-d-rer-grid-median-d-rer-rmse-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-nose-only-ablation-on-an-exact-d-rer-grid-median-d-rer-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-pearson-r-fitted-shear-k-vs-measured-tan-e-line-prn-pg-inclination-e5-camper-law> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r, fitted shear k vs measured Δtan(E-line Prn-Pg inclination) (E5 Camper law) = 0.616 r" ;
        dcterms:description "E5 predicts Δtan φ = k exactly (r = 1, slope 1) if the facial-angle change is a whole-grid shear" ;
        schema:measurementTechnique "over ordered pairs; slope = 0.48, p = 0.0328, RMSE(tan) = 0.223" ;
        schema:name "Pearson r, fitted shear k vs measured Δtan(E-line Prn-Pg inclination) (E5 Camper law)" ;
        schema:unitText "r" ;
        schema:value "0.616" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-pearson-r-fitted-shear-k-vs-measured-tan-e-line-prn-pg-inclination-e5-camper-law-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-pearson-r-fitted-shear-k-vs-measured-tan-e-line-prn-pg-inclination-e5-camper-law-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-positive-control-max-d-rer-rmse-on-an-exact-d-rer-grid-of-a-real-specimen> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "positive control, max Dürer RMSE on an exact Dürer grid of a real specimen = 1.7948779754709287e-15 centroid-size units" ;
        schema:measurementTechnique "stretch 1.25 + omega 75 deg applied to each specimen; fit must recover it (rmse -> 0)" ;
        schema:name "positive control, max Dürer RMSE on an exact Dürer grid of a real specimen" ;
        schema:unitText "centroid-size units" ;
        schema:value "1.7948779754709287e-15" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-positive-control-max-d-rer-rmse-on-an-exact-d-rer-grid-of-a-real-specimen-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-positive-control-max-d-rer-rmse-on-an-exact-d-rer-grid-of-a-real-specimen-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-scrambled-correspondence-control-median-d-rer-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "scrambled-correspondence control, median Dürer RMSE = 0.1604 centroid-size units" ;
        schema:measurementTechnique "negative control: B landmarks permuted (seed 1917) before fitting; must exceed the real-pair residual" ;
        schema:name "scrambled-correspondence control, median Dürer RMSE" ;
        schema:unitText "centroid-size units" ;
        schema:value "0.1604" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-thompson-fig-366-net-obliquity-left-right-head-hough-digitisation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Thompson Fig. 366 net obliquity (left / right head), Hough digitisation = 81.25 deg" ;
        dcterms:description "90 deg = rectangular net; Dürer's drawn shear is |k| = |cot omega|" ;
        schema:measurementTechnique "Canny + probabilistic Hough on the pinned IA scan leaf 761; right head = 98.8 deg" ;
        schema:name "Thompson Fig. 366 net obliquity (left / right head), Hough digitisation" ;
        schema:unitText "deg" ;
        schema:value "81.25" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-thompson-fig-366-net-obliquity-left-right-head-hough-digitisation-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-thompson-fig-366-net-obliquity-left-right-head-hough-digitisation-reference> a schema:PropertyValue ;
        schema:value "90.0" .


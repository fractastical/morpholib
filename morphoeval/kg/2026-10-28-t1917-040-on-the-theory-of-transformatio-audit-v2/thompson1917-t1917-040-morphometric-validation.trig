}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper human profile grid deformations (Pass 2) — Morphometric validation: 80/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "measure_morphoeval exports verdict, RMSE ratio, Camper angles, KS p-value, landmark-in-mask; self_test asserts shuffled RMSE ≥ homologous and ablation ordering." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-headline-rmse-ratio-shuffled-over-homologous>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-headline-tps-rmse-mean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-ks-pvalue-homologous-vs-shuffled>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-landmark-in-mask-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-specimen-camper-angle-deg>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-specimen-facial-index>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-verdict-code>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-headline-rmse-ratio-shuffled-over-homologous> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "headline_rmse_ratio_shuffled_over_homologous = 47.07594374529796 ratio" ;
        schema:measurementTechnique "mean shuffled-label TPS RMSE divided by homologous TPS RMSE" ;
        schema:name "headline_rmse_ratio_shuffled_over_homologous" ;
        schema:unitText "ratio" ;
        schema:value "47.07594374529796" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-headline-tps-rmse-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "headline_tps_rmse_mean = 0.006684551015722298 normalised coords" ;
        schema:measurementTechnique "mean TPS RMSE across three Dürer profile pairs after GPA centre-scale" ;
        schema:name "headline_tps_rmse_mean" ;
        schema:unitText "normalised coords" ;
        schema:value "0.006684551015722298" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-ks-pvalue-homologous-vs-shuffled> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_pvalue_homologous_vs_shuffled = 0.0005827505827505828 p" ;
        schema:measurementTechnique "two-sample KS on per-landmark TPS residuals (profile_a→profile_c)" ;
        schema:name "ks_pvalue_homologous_vs_shuffled" ;
        schema:unitText "p" ;
        schema:value "0.0005827505827505828" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-landmark-in-mask-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "landmark_in_mask_fraction = 1.0 fraction" ;
        schema:measurementTechnique "core mandible/maxilla landmarks inside threshold segmentation mask" ;
        schema:name "landmark_in_mask_fraction" ;
        schema:unitText "fraction" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-specimen-camper-angle-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_camper_angle_deg = 69.94753655827932 deg" ;
        schema:measurementTechnique "angle PRO→NAS vs Frankfort horizontal on Commons skull landmarks" ;
        schema:name "specimen_camper_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "69.94753655827932" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-specimen-facial-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_facial_index = 0.4221233859141618 ratio" ;
        schema:measurementTechnique "|NAS-PRO| / |NAS-OPC| on specimen landmarks" ;
        schema:name "specimen_facial_index" ;
        schema:unitText "ratio" ;
        schema:value "0.4221233859141618" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-measurement-verdict-code> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "verdict_code = 1.0 ordinal" ;
        schema:measurementTechnique "script verdict string: supported" ;
        schema:name "verdict_code" ;
        schema:unitText "ordinal" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-040_on-the-theory-of-transformations.py L330–L350" ;
        dct:description "measure_morphoeval dict" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cc716ad5c8529ea438a8998b3d46e62a3e104f44/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L330-L350> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-040/t1917_040_metrics.json L1–L40" ;
        dct:description "persisted run metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cc716ad5c8529ea438a8998b3d46e62a3e104f44/datasets/thompson_1917/t1917-040/t1917_040_metrics.json#L1-L40> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval loop thompson1917-t1917-040 Pass 2)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0002-1825-0097> ;
        foaf:homepage <https://deepmind.google> .
}


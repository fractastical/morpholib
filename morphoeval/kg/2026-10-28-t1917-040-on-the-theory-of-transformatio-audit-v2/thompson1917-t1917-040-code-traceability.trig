sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-040> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-040-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Dürer/Camper facial grids — whole-grid deformation test on human profile landmarks (Pass 2) — Code-to-model traceability: 76/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Module docstring maps R2-R8 to functions; every transformation function cites its equation id and Thompson page; fit_durer's docstring derives c and k from U and states the Camper-frame rationale; the KG yaml links law -> Lean theorem -> code lines. Deductions: landmark-detection thresholds remain heuristic; the KG code loci point at Pass-1 line ranges that shifted in Pass 2." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "thompson/claims/t1917-040_on-the-theory-of-transformations.py L528–L611: detect_landmarks heuristics (2 % / 0.3 % prominence, 2x li rule) <https://github.com/fractastical/morpholib/blob/22ee087d/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L528-L611>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-code-traceability-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-040_on-the-theory-of-transformations.py L1–L84" ;
        dct:description "docstring: E1-E5 with pages, R2-R8 remediation map, claim boundary, outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/22ee087d/thompson/claims/t1917-040_on-the-theory-of-transformations.py#L1-L84> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-040-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-040.yaml (generated output)" ;
        dct:description "6 laws with lean_theorem, lean_locus, code_locus — morphoeval/math_kg_loops/thompson1917-t1917-040.yaml: rendered output of thompson/claims/t1917-040_on-the-theory-of-transformations.py at 22ee087d, application/yaml, 8787 B, artifact_sha256 4518f8596b571145658417a6212ca31d173971db2924056cbcc7f548b0b4710f (sha256 4518f8596b571145658417a6212ca31d173971db2924056cbcc7f548b0b4710f), spec_fingerprint 814bd4703a2eb758261f2f135d1296d3536158edeb11b7060849c7f375a95447" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending R1)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


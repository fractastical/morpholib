sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-cervera-levin-mafe-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Morphological realism / specimen match: 38/100" ;
        rdfs:comment "The territory panel has the recognizable outline of a real Schmidtea mediterranea and the wild-type versus double-head cartoons are visibly distinct in posterior colour and organs. Neither is a generated specimen: the photograph supplies only a binary mask, the morphogens are painted onto it, and a hard readout threshold chooses one of two pre-existing Planform cartoons. No treated or double-head specimen, nor a source-paper morphology panel, is shown side by side. The synthesis PNG also has overlapping panel titles and legends, reducing interpretability, while the GIF's only anatomical change is the categorical cartoon switch. Evidence: 2021-Cervera–Levin–Mafe.py L124–L180: photograph is segmented to a mask and used only as the canvas for territory colours <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L124-L180>; 2021-Cervera–Levin–Mafe.py L699–L771: wild-type and double-head forms are fixed Planform graph cartoons <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L699-L771>; 2021-Cervera–Levin–Mafe.py L1336–L1346: uncited 0.55 threshold selects one of the two cartoons <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L1336-L1346>; docs/media/cervera_levin_mafe_gj_block.gif (generated output, not in repo): distinct categorical cartoons and coloured silhouette, but no simulated anatomical deformation — docs/media/cervera_levin_mafe_gj_block.gif: rendered output of 2021-Cervera–Levin–Mafe.py, not present when the audit was snapshotted (unfingerprinted); cervera_levin_mafe_bioelectric_morphospace.png (generated output, not in repo): six-panel output; top-row titles overlap and no specimen comparison is present — cervera_levin_mafe_bioelectric_morphospace.png: rendered output of 2021-Cervera–Levin–Mafe.py, not present when the audit was snapshotted (unfingerprinted)." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-specimen-match> ;
        pk:hasProbability "0.38"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-specimen-match> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" .
}


    <https://doi.org/10.1016/j.bioelechem.2019.107410> dcterms:date "2020"^^xsd:gYear ;
        dcterms:title "Bioelectrical model of head-tail patterning based on cell ion channels and intercellular gap junctions" .

    <https://doi.org/10.1016/j.biosystems.2021.104511> dcterms:date "2021"^^xsd:gYear ;

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-cervera-levin-mafe-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Parameter expressivity: 35/100" ;
        rdfs:comment "Lowering f2 produces a visible, monotonic wavefront displacement in the plotted range, and the GIF's circuit readout rises enough to trigger a distinct cartoon. The second advertised morphospace parameter f3 has exactly no effect because its loop variable is unused. Crop-specific f2 values and wound gains are fixed lookup tables rather than exposed, independently swept parameters, and the anatomical output is binary at an unsupported 0.55 threshold. Therefore only one of the nominal two reaction–diffusion dimensions demonstrates the criterion. Evidence: 2021-Cervera–Levin–Mafe.py L862–L870: f2 sweep drives the axial wavefront <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L862-L870>; 2021-Cervera–Levin–Mafe.py L894–L934: crop f2 values and normalization scale are hand-set mappings <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L894-L934>; 2021-Cervera–Levin–Mafe.py L936–L943: f3 values are generated but never passed to any solver <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L936-L943>; 2021-Cervera–Levin–Mafe.py L1288–L1297: GIF jointly maps f2 onto D2 and custom circuit gap scale <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L1288-L1297>; docs/media/cervera_levin_mafe_gj_block.gif (generated output, not in repo): f2 visibly shifts the boundary, but form changes only by a thresholded cartoon swap — docs/media/cervera_levin_mafe_gj_block.gif: rendered output of 2021-Cervera–Levin–Mafe.py, not present when the audit was snapshotted (unfingerprinted)." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-parameter-expressivity> ;
        pk:hasProbability "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-parameter-expressivity> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" .
}


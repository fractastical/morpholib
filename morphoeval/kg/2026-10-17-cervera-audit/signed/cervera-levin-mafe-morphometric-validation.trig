sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-cervera-levin-mafe-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Morphometric validation: 25/100" ;
        rdfs:comment "The figure includes real PlanformDB outcome frequencies and the CSV reports circuit states and wavefronts, which is more than an unmeasured illustration. However, the model curves are merely overlaid on the empirical bars: no loss, uncertainty, correlation, held-out prediction or parameter fit is computed, and hand-selected crop mappings closely echo the observed gradient. The silhouette IoU compares two decoded cartoons with each other, not either cartoon with a specimen. Finally, each crop CSV wavefront is reconstructed with a 0.26 multiplier after the shift was normalized by 0.13, so, for example, f2=0.92 is reported as 0.5153 although the solver gives 0.5076; the quantitative output therefore does not faithfully report its own simulation. Evidence: 2021-Cervera–Levin–Mafe.py L842–L859: empirical double-head frequencies are loaded from curated records <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L842-L859>; 2021-Cervera–Levin–Mafe.py L894–L934: model-to-crop mappings and percentage normalization are chosen in code, without a fit <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L894-L934>; 2021-Cervera–Levin–Mafe.py L970–L993: CSV doubles simulated displacement through 0.50 + 0.26*shift after shift used a 0.13 denominator <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L970-L993>; 2021-Cervera–Levin–Mafe.py L1070–L1119: empirical bars and model indices are plotted together without a validation statistic <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L1070-L1119>; cervera_levin_mafe_metrics.csv (generated output, not in repo): reproducible table, but crop rd_wavefront_x_star values do not equal direct solver wavefronts — cervera_levin_mafe_metrics.csv: rendered output of 2021-Cervera–Levin–Mafe.py, not present when the audit was snapshotted (unfingerprinted)." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-morphometric-validation> ;
        pk:hasProbability "0.25"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-morphometric-validation> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dcterms:identifier "morphoeval/0.1.0/morphometric-validation" .

    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" .
}


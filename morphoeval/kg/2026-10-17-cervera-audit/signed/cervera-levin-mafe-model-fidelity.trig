sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-cervera-levin-mafe-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Model fidelity to source: 38/100" ;
        rdfs:comment "The accessible 2021 abstract supports two antagonistic morphogens along one axis, an independent morphogen along an orthogonal axis, and pattern changes under partial GJ blockade, which the two solver functions qualitatively represent. The full paper was not accessible, so mutual annihilation, end-source discretization, boundary treatment, numerical constants and the choice to reduce only D2 cannot be credited as the published equations. More seriously, the claimed (f2,f3) morphospace never uses f3, and its phase boundary is manually drawn. The rusty-matter circuit matches its own pinned educational Rust source, but that source explicitly uses normalized teaching states and is not evidence that this is the 2020 paper's ion-channel model; agreement with its synthetic traces validates a port, not planarian biology. Evidence: 2021-Cervera–Levin–Mafe.py L186–L238: implemented axial two-species diffusion, decay, mutual annihilation and endpoint sources <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L186-L238>; 2021-Cervera–Levin–Mafe.py L241–L273: independent orthogonal one-species solver <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L241-L273>; 2021-Cervera–Levin–Mafe.py L360–L599: separate five-band normalized circuit added to the reaction-diffusion model <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L360-L599>; 2021-Cervera–Levin–Mafe.py L936–L943: f3 grid coordinate is ignored, making every row constant along f3 <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L936-L943>; datasets/planform/README.md L21–L27: repository itself describes both mechanisms as qualitative or semi-quantitative abstractions without calibrated physiology <https://github.com/fractastical/morpholib/blob/e71ca55/datasets/planform/README.md#L21-L27>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-model-fidelity> ;
        pk:hasProbability "0.38"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-model-fidelity> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" .
}


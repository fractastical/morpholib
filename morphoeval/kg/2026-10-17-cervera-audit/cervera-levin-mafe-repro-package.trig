sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-cervera-levin-mafe-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Reproducibility package: 78/100" ;
        rdfs:comment "The requested environment exactly matched Python 3.14.7, numpy 2.5.4, matplotlib 3.10.7, Pillow 12.0.0, scipy 1.16.3 and scikit-image 0.26.0; the scientific dependencies are pinned in the lock file. The prescribed self-test, PNG/CSV run and GIF run all completed headlessly. A second run produced byte-identical PNG, CSV and GIF, and the cached photograph and fixtures are hash checked. The score is not higher because the self-test's advertised \"exact\" parity actually allows 0.035 absolute error (observed maximum 0.02625), checks only selected endpoints rather than every sampled trace value, and does not test RD invariants, f3 sensitivity, phenotype thresholds, CSV correctness or plot labels. Evidence: requirements.lock.txt L18–L41: tested numpy, matplotlib, Pillow, scipy and scikit-image versions are pinned <https://github.com/fractastical/morpholib/blob/e71ca55/requirements.lock.txt#L18-L41>; 2021-Cervera–Levin–Mafe.py L607–L622: fixture digest verification <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L607-L622>; 2021-Cervera–Levin–Mafe.py L625–L671: trace test uses tolerance 0.035 and selected initial/final comparisons <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L625-L671>; 2021-Cervera–Levin–Mafe.py L1362–L1409: headless-capable CLI for self-test, PNG/CSV and GIF <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L1362-L1409>; cervera_levin_mafe_bioelectric_morphospace.png (generated output, not in repo): regenerated byte-identically on two runs — cervera_levin_mafe_bioelectric_morphospace.png: rendered output of 2021-Cervera–Levin–Mafe.py, not present when the audit was snapshotted (unfingerprinted); cervera_levin_mafe_metrics.csv (generated output, not in repo): regenerated byte-identically on two runs — cervera_levin_mafe_metrics.csv: rendered output of 2021-Cervera–Levin–Mafe.py, not present when the audit was snapshotted (unfingerprinted)." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-repro-package> ;
        pk:hasProbability "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-repro-package> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" .
}


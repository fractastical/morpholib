sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-cervera-audit-cervera-levin-mafe-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Code-to-model traceability: 42/100" ;
        rdfs:comment "Major sections are clearly separated and the rusty-matter port names upstream files and line ranges, while the dataset documents that its empirical records are annotation rather than calibrated physiology. But the reaction–diffusion equations are not mapped to numbered equations, figures or parameter tables in Cervera 2021, and the full text was unavailable to verify the docstring's claim of implementation. Critical synthesis choices — crop f2 values, wound gains, 0.13 scaling, f2=0.58 boundary, 0.50/0.55 head thresholds and model-time-to-hours conversion — have no source anchor. Comments sometimes overstate what is tested: trace parity checks only initial and final selected values, despite saying it compares all sampled frames. Evidence: 2021-Cervera–Levin–Mafe.py L201–L207: model attribution is generic, with no equation or parameter-table pointer <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L201-L207>; 2021-Cervera–Levin–Mafe.py L368–L382: rusty-matter constants are explicitly mapped to upstream files <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L368-L382>; 2021-Cervera–Levin–Mafe.py L625–L671: parity implementation reads all samples but compares only step zero and final selected values <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L625-L671>; 2021-Cervera–Levin–Mafe.py L883–L934: crop pairs, effective f2 values, wound-derived index and normalization are uncited synthesis choices <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L883-L934>; 2021-Cervera–Levin–Mafe.py L1122–L1167: simulation time is linearly relabelled as 24 h and plotted against empirical timing <https://github.com/fractastical/morpholib/blob/e71ca55/2021-Cervera–Levin–Mafe.py#L1122-L1167>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gpt-5.6-sol> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-code-traceability> ;
        pk:hasProbability "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-code-traceability> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dct:identifier "morphoeval/0.1.0/code-traceability" .
    <https://w3id.org/probknow/resource/model/gpt-5.6-sol> a pk:Model ;
        rdfs:label "GPT-5.6 Sol (Cursor agent)" .
}


        dcterms:title "What geometric visual hallucinations tell us about the visual cortex" .

    <https://doi.org/10.1371/journal.pcbi.1002158> dcterms:date "2011"^^xsd:gYear ;
        dcterms:title "A model for the origin and properties of flicker-induced geometric phosphenes" .


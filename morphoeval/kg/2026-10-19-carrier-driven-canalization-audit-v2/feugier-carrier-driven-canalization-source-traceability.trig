        rdfs:label "datasets/carrier_driven_canalization/carrier_driven_canalization_reference.json L1–L165" ;
        dct:description "SHA-256-locked reference dataset with 6-regime allocation sweep, hexagonal topology benchmarks, and specimen metadata" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/datasets/carrier_driven_canalization/carrier_driven_canalization_reference.json#L1-L165> .

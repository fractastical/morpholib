        dcterms:title "Self-organization of vascular systems in plant leaves: Inter-dependent dynamics of auxin flux and carrier proteins" .

    <https://doi.org/10.1101/gad.1402406> dcterms:date "2006"^^xsd:gYear ;
        dcterms:title "Control of leaf vascular patterning by polar auxin transport" .


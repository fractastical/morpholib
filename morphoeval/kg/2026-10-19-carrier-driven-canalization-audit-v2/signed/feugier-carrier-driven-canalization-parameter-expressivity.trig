sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps 6 PIN1 carrier allocation regimes across p in {0.8, 1.0, 1.5, 2.0}, saturating Hill K = 0.35, and Scarpella epidermal convergence + Hill K = 0.30 (L104-227), compares Model A vs Model B vs k_1 = 0 exocytosis ablation on the 2D hexagonal leaf lattice (L365-625), and exposes `--sigma`, `--mu`, `--k1`, `--k2`, `--p-total`, and `--seed` CLI flags (L1110-1125)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L104–L227" ;
        dcterms:description "6-regime PIN1 carrier allocation sweep across power-law and saturating Hill models" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L104-L227> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L1110–L1125" ;
        dcterms:description "CLI parameter overrides for sigma, mu, k1, k2, p-total, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L1110-L1125> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "8-point `run_self_test()` suite (`L1065-1107`) verifying SHA-256 dataset integrity, Law 1 hexagonal 6-face PIN1 pool state and rate conservation, Law 2 winner-take-all vs saturating Hill bipolar co-polarization, Law 3 pairwise flux antisymmetry, Betti-1 loop topological transition (0 vs 16 loops), k_1 = 0 (`gnom`/`pin1`) exocytosis ablation control, empirical CV specimen segmentation (205 closed areoles), and 9-metric `measure_morphoeval()` determinism." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-repro-package-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 cleared dicot leaf tip venation skeleton (`leaf_tip_venation_loops_specimen.jpg`, 539x351 px), segments the reticulate vascular network inside the upper lamina ROI (`segment_leaf_venation_specimen`, L628-700, vein density 0.3585 vs ref 0.3585), and extracts 205 enclosed polygonal areole loops (Betti-1 = 205, mean area 99.06 px^2, mean compactness 0.7749 +- 0.0191 SE)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L628–L700" ;
        dct:description "Ridge + chromatic warmth segmentation of cleared dicot leaf tip venation skeleton extracting 205 closed areole loops and compactness" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L628-L700> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/carrier_driven_canalization_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing Model A open tree, Model B closed loops with bipolar bridge cells, 6-face pool dynamics, 6-regime Betti-1 transition, and specimen CV segmentation — docs/media/carrier_driven_canalization_comparison.png: rendered output of 2005-feugier-carrier-driven-canalization.py at 8871db0, image/png, 1258625 B, 2310×1428 px, artifact_sha256 60cbe1252bda975adf8955499006240bf329d5e1894f7dab81e6ae0ca89aa749 (sha256 60cbe1252bda975adf8955499006240bf329d5e1894f7dab81e6ae0ca89aa749), spec_fingerprint 2ca741f07ba825a876d0c45589ff7d455ac853c85ef60af0feb96546555dd50c" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


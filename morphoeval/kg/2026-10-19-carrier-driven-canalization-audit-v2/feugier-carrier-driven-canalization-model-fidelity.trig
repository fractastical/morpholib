sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the 6-face hexagonal PIN1 pool conservation and allocation bifurcation solver (`verify_hexagonal_pool_conservation_and_face_competition`, L104-227) and the 2D hexagonal leaf lamina lattice venation solver (`build_hexagonal_leaf_lattice`, `_compute_venation_graph_topology`, `simulate_hexagonal_venation_models`, L230-625) comparing Feugier Model A open dendritic trees (Betti-1 = 0), Model B + Scarpella (2006) saturating Hill + epidermal convergence closed reticulate loops (Betti-1 = 16, 16 bipolar bridge cells), and the k_1 = 0 (`gnom`/`pin1` exocytosis block) ablation control, backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_035_carrier_driven_canalization.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L104–L227" ;
        dct:description "6-face intracellular PIN1 pool conservation and winner-take-all vs saturating Hill co-polarization solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L104-L227> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L230–L625" ;
        dct:description "2D hexagonal leaf lamina lattice solver comparing Model A open tree (Betti-1=0), Model B closed reticulate loops (Betti-1=16, 16 bipolar bridge cells), and k1=0 ablation control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L230-L625> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_035_carrier_driven_canalization.lean L12–L127" ;
        dct:description "3 machine-checked Lean 4 theorems for hexagonal PIN1 pool conservation, winner-take-all vs saturating bipolar loop closure, and pairwise flux antisymmetry (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_035_carrier_driven_canalization.lean#L12-L127> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


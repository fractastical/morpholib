        dct:title "Self-organization of vascular systems in plant leaves: Inter-dependent dynamics of auxin flux and carrier proteins" .
    <https://doi.org/10.1101/gad.1402406> dct:date "2006"^^xsd:gYear ;
        dct:title "Control of leaf vascular patterning by polar auxin transport" .
    <https://doi.org/10.1111/j.1365-313X.2005.02581.x> dct:date "2005"^^xsd:gYear ;

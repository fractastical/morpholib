sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops — Morphometric validation: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L705-820) computes 9 reference-anchored morphometric measurements with uncertainty, Pearson r, p-values, and negative control: hexagonal PIN1 pool conservation error 0.0 (ref 0.0), pairwise flux antisymmetry error 0.0 (ref 0.0), Model A p=2.0 dominant face share 0.9978 (ref 0.9960, p = 3.0e-8), Model B saturating Hill dominant face share 0.5221 (ref 0.5180), 6-regime allocation Pearson r = 0.9999 (RMSE = 0.0065), Model A open tree Betti-1 = 0 loops (ref 0, 10 free vein endings), Model B closed reticulate Betti-1 = 16 loops (ref 16, 16 bipolar bridge cells vs 0 loops in k_1 = 0 ablation), specimen closed areole Betti-1 = 205 loops (ref 205, vein density 0.3585), and specimen areole compactness 0.7749 +- 0.0191 SE (ref 0.7749)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-allocation-regime-sweep-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-hexagonal-pin1-pool-conservation-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-open-tree-betti1-loops>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-quadratic-dominant-face-share>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-closed-reticulate-betti1-loops>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-saturating-dominant-face-share>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-pairwise-auxin-flux-antisymmetry-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-specimen-areole-compactness-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-specimen-closed-areole-betti1-loops>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-allocation-regime-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "allocation_regime_sweep_pearson_r = 0.9999 r" ;
        schema:measurementTechnique "Pearson correlation across 6 PIN1 carrier allocation regimes vs reference benchmarks (RMSE <= 0.015)" ;
        schema:name "allocation_regime_sweep_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-allocation-regime-sweep-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-allocation-regime-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:313-325 6-regime carrier allocation bifurcation" ;
        schema:value "0.999" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-hexagonal-pin1-pool-conservation-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "hexagonal_pin1_pool_conservation_error = 0.0 carrier_units" ;
        schema:measurementTechnique "Max absolute intracellular + 6-face membrane PIN1 conservation error across hexagonal leaf lamina lattice (Law 1)" ;
        schema:name "hexagonal_pin1_pool_conservation_error" ;
        schema:unitText "carrier_units" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-hexagonal-pin1-pool-conservation-error-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-hexagonal-pin1-pool-conservation-error-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:313-325 Eqs. 4-6 (P_{i,cyt} + sum_{j=1}^6 P_{ij} = P_total)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-open-tree-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "model_a_open_tree_betti1_loops = 0 loops" ;
        schema:measurementTechnique "Hexagonal venation graph cycle rank beta_1 = E - V + C under Model A non-saturating carrier feedback (0 loops, 9 free vein endings)" ;
        schema:name "model_a_open_tree_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-open-tree-betti1-loops-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-open-tree-betti1-loops-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:313-325 Fig. 3 (open dendritic venation tree under conserved power-law feedback)" ;
        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-quadratic-dominant-face-share> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "model_a_quadratic_dominant_face_share = 0.9978 fraction" ;
        schema:measurementTechnique "6-face PIN1 competition under conserved quadratic feedback p=2.0 (Law 2, winner-take-all share = 0.9978 ± 0.0010, p=3.0e-8)" ;
        schema:name "model_a_quadratic_dominant_face_share" ;
        schema:unitText "fraction" ;
        schema:value "0.9978" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-quadratic-dominant-face-share-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-a-quadratic-dominant-face-share-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:313-325 Figs. 3-4 (winner-take-all single-face polarization under Phi(J)=J^2)" ;
        schema:value "0.996" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-closed-reticulate-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "model_b_closed_reticulate_betti1_loops = 16 loops" ;
        schema:measurementTechnique "Hexagonal venation graph cycle rank beta_1 = E - V + C under Model B saturating Hill + epidermal convergence (vs 0 loops in k1=0 gnom/pin1 null negative control)" ;
        schema:name "model_b_closed_reticulate_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "16" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-closed-reticulate-betti1-loops-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-closed-reticulate-betti1-loops-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:313-325 Fig. 6 & Scarpella et al. (2006) Genes Dev. 20:1015-1027 (closed areole loops via bipolar bridge cells)" ;
        schema:value "16" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-saturating-dominant-face-share> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "model_b_saturating_dominant_face_share = 0.5221 fraction" ;
        schema:measurementTechnique "6-face PIN1 co-polarization under saturating Hill exocytosis Phi(J)=J^2/(K^2+J^2) stabilizing bipolar bridge cells (Law 2)" ;
        schema:name "model_b_saturating_dominant_face_share" ;
        schema:unitText "fraction" ;
        schema:value "0.5221" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-saturating-dominant-face-share-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-model-b-saturating-dominant-face-share-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:313-325 Figs. 5-7 & Scarpella et al. (2006) Genes Dev. 20:1015-1027 (bipolar PIN1 co-polarization)" ;
        schema:value "0.518" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-pairwise-auxin-flux-antisymmetry-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pairwise_auxin_flux_antisymmetry_error = 0.0 flux_units" ;
        schema:measurementTechnique "Max pairwise intercellular auxin flux antisymmetry residual |J_{i->j} + J_{j->i}| across all hexagonal cell walls (Law 3)" ;
        schema:name "pairwise_auxin_flux_antisymmetry_error" ;
        schema:unitText "flux_units" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-pairwise-auxin-flux-antisymmetry-error-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-pairwise-auxin-flux-antisymmetry-error-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:313-325 Eq. 2 (J_{i->j} + J_{j->i} = 0)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-specimen-areole-compactness-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_areole_compactness_mean = 0.7749 4piA/P^2" ;
        schema:measurementTechnique "Isoperimetric compactness 4*pi*A/P^2 across N = 205 segmented closed polygonal areoles (mean = 0.7749, SE = 0.0191)" ;
        schema:name "specimen_areole_compactness_mean" ;
        schema:unitText "4piA/P^2" ;
        schema:value "0.7749" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-specimen-areole-compactness-mean-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-specimen-areole-compactness-mean-reference> a schema:PropertyValue ;
        dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236:313-325 & cleared dicot leaf tip venation skeleton (N = 205 enclosed areoles)" ;
        schema:value "0.7749" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-specimen-closed-areole-betti1-loops> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_closed_areole_betti1_loops = 205 loops" ;
        schema:measurementTechnique "Ridge + chromatic warmth segmentation of enclosed polygonal areoles on cleared dicot leaf tip skeleton specimen (vein density = 0.3585)" ;
        schema:name "specimen_closed_areole_betti1_loops" ;
        schema:unitText "loops" ;
        schema:value "205" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-specimen-closed-areole-betti1-loops-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-measurement-specimen-closed-areole-betti1-loops-reference> a schema:PropertyValue ;
        dct:source "File:Leaf tip skeleton, detail from file by Stefanie Leuker.jpg (Wikimedia Commons CC BY-SA 4.0) & Rolland-Lagan & Prusinkiewicz (2005) Plant J. 44:854-865" ;
        schema:value "205" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L705–L820" ;
        dct:description "9 reference-anchored morphometric measurements with uncertainty, Pearson r/p-values, and k1=0 negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L705-L820> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


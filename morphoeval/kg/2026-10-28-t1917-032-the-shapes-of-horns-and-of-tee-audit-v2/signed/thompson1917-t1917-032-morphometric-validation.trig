sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-morphometric-validation> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-circle-null-rmse-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "circle_null_rmse_px = 41.78 px" ;
        schema:measurementTechnique "Kasa circle fit (constant-curvature control)" ;
        schema:name "circle_null_rmse_px" ;
        schema:unitText "px" ;
        schema:value "41.78" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-cv-kappa-w-accretion-law> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cv_kappa_w_accretion_law = 3.588 1" ;
        dcterms:description "CV kappa = 12.022; shuffled-width median CV = 11.616, CV p = 0.0" ;
        schema:measurementTechnique "CV of κ·w along centreline (E4) vs CV κ alone; shuffled-width permutation control" ;
        schema:name "cv_kappa_w_accretion_law" ;
        schema:unitText "1" ;
        schema:value "3.588" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-kappa-sign-changes> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "kappa_sign_changes = 3 count" ;
        schema:measurementTechnique "sign changes of width-scaled smoothed curvature root→tip (plane spiral predicts 0)" ;
        schema:name "kappa_sign_changes" ;
        schema:unitText "count" ;
        schema:value "3" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-ks-pvalue-spiral-residual-normality> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_pvalue_spiral_residual_normality = 0.0 1" ;
        schema:measurementTechnique "one-sample KS of standardised E1 residuals vs N(0,1)" ;
        schema:name "ks_pvalue_spiral_residual_normality" ;
        schema:unitText "1" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-log-spiral-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "log_spiral_pearson_r = 0.9886 1" ;
        schema:measurementTechnique "OLS ln r vs θ about searched pole (E1); block-bootstrap 95% CI [0.984, 0.9981]" ;
        schema:name "log_spiral_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9886" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-log-spiral-psi-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "log_spiral_psi_deg = 36.91 deg" ;
        schema:measurementTechnique "atan(1/k); block-bootstrap 95% CI [34.69, 40.1] deg; Thompson: mammoth high angle, Ovis ammon ~75" ;
        schema:name "log_spiral_psi_deg" ;
        schema:unitText "deg" ;
        schema:value "36.91" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-log-spiral-rmse-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "log_spiral_rmse_px = 36.81 px" ;
        dcterms:description "circle null RMSE = 41.78 px; Archimedean control RMSE = 123.6 px" ;
        schema:measurementTechnique "radial RMSE of E1 fit vs circle null and Archimedean control" ;
        schema:name "log_spiral_rmse_px" ;
        schema:unitText "px" ;
        schema:value "36.81" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-alpha-equiv-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "narwhal_alpha_equiv_deg = 70.22 deg" ;
        schema:measurementTechnique "structure-tensor groove inclination → Kiladze chord angle π/(2 tan φ); bootstrap 95% CI of φ [26.29, 32.96] deg" ;
        schema:name "narwhal_alpha_equiv_deg" ;
        schema:unitText "deg" ;
        schema:value "70.22" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-alpha-equiv-deg-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-alpha-equiv-deg-reference> a schema:PropertyValue ;
        dcterms:source "Kiladze & Chernova (2018) Data in Brief 21:1200, Table 1 (n=30, SD 3.34)" ;
        schema:value "66.88" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-tan-alpha-equiv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "narwhal_tan_alpha_equiv = 2.781 1" ;
        schema:measurementTechnique "π/(2 tan φ)" ;
        schema:name "narwhal_tan_alpha_equiv" ;
        schema:unitText "1" ;
        schema:value "2.781" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-tan-alpha-equiv-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-tan-alpha-equiv-reference> a schema:PropertyValue ;
        dcterms:source "Kiladze & Chernova (2018) Table 1 (range 1.65-3.22)" ;
        schema:value "2.39" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-tan-alpha-vs-inv-d-slope> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "narwhal_tan_alpha_vs_inv_d_slope = -1766.25 px" ;
        schema:measurementTechnique "OLS slope of tan α on 1/d along the shaft (E7 uniform torsion predicts > 0); bootstrap 95% CI [-17846.89, -1079.08]; confounded by camera obliquity" ;
        schema:name "narwhal_tan_alpha_vs_inv_d_slope" ;
        schema:unitText "px" ;
        schema:value "-1766.25" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-z-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "narwhal_z_alpha = 1.0 SD" ;
        schema:measurementTechnique "(α_measured − α_ref)/SD_ref" ;
        schema:name "narwhal_z_alpha" ;
        schema:unitText "SD" ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-screw-fit-rmse-const-width-twisted-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "screw_fit_rmse_const_width_twisted_px = 17.37 px" ;
        dcterms:description "plane RMSE = 33.14 px; width-law RMSE ratio = {'plane': 0.888, 'twisted': 0.753}" ;
        schema:measurementTechnique "3-D helix fit κ=Δ/w̄, τ free (constant-width ablation of the accretion law)" ;
        schema:name "screw_fit_rmse_const_width_twisted_px" ;
        schema:unitText "px" ;
        schema:value "17.37" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-screw-fit-rmse-measured-width-twisted-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "screw_fit_rmse_measured_width_twisted_px = 23.06 px" ;
        dcterms:description "plane τ=0 RMSE = 37.32 px; ΔAIC twist = 355.3" ;
        schema:measurementTechnique "3-D screw-accretion fit κ=Δ/w(s), τ free, Procrustes-aligned projection (E4-E6)" ;
        schema:name "screw_fit_rmse_measured_width_twisted_px" ;
        schema:unitText "px" ;
        schema:value "23.06" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-spearman-abs-kappa-vs-inv-width> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "spearman_abs_kappa_vs_inv_width = -0.182 1" ;
        schema:measurementTechnique "Spearman ρ(|κ(s)|, 1/w(s)) along the tusk; E4 predicts > 0; block-shuffled-width permutation p = 0.8 (null control)" ;
        schema:name "spearman_abs_kappa_vs_inv_width" ;
        schema:unitText "1" ;
        schema:value "-0.182" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-st-venant-sign-sectors> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "st_venant_sign_sectors = 6 count" ;
        schema:measurementTechnique "sign alternations of 3x²y−y³ on a circle about the centroid; circular-section null max|u_z| = 0.0" ;
        schema:name "st_venant_sign_sectors" ;
        schema:unitText "count" ;
        schema:value "6" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-st-venant-sign-sectors-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-st-venant-sign-sectors-reference> a schema:PropertyValue ;
        dcterms:source "St Venant (1856) / Thompson Fig. 321: six alternating sectors" ;
        schema:value "6" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-sweep-psi-pred-vs-fit-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sweep_psi_pred_vs_fit_pearson_r = 1.0 1" ;
        schema:measurementTechnique "parameter sweep S4: ψ fitted on generated plane curves vs E5 prediction atan(Δ/c_s); RMSE 0.2 deg" ;
        schema:name "sweep_psi_pred_vs_fit_pearson_r" ;
        schema:unitText "1" ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-twist-rmse-ratio-measured-width> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "twist_rmse_ratio_measured_width = 1.619 1" ;
        schema:measurementTechnique "RMSE(τ=0)/RMSE(τ free) for the measured-width accretion model (>1 means twist improves the fit; τ=0 ablation)" ;
        schema:name "twist_rmse_ratio_measured_width" ;
        schema:unitText "1" ;
        schema:value "1.619" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L1223–L1249" ;
        dcterms:description "17 measurements with reference values, CIs, permutation and ablation notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L1223-L1249> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L434–L506" ;
        dcterms:description "Archimedean control, block bootstrap, one-sample KS, Spearman + shuffled-width permutation control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L434-L506> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L747–L775" ;
        dcterms:description "Along-shaft tan α vs 1/d regression flagged as confounded by camera obliquity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L747-L775> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 226 Pass 2 primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Morphometric validation: 86/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1223-L1249) returns 17 measurements: log-spiral r = 0.989 (bootstrap CI 0.984-0.998) and RMSE 36.8 px vs circle 41.8 px vs Archimedean 123.6 px; ψ = 36.9° (CI 34.7-40.1°); Spearman ρ(|κ|, 1/w) = −0.18 with block-shuffled-width permutation p = 0.80 (accretion coupling rejected); screw-fit RMSEs with ΔAIC for twist (477, 355) and the τ = 0 ablation ratio 1.62; narwhal α ≡ 70.2° (z = +1.00 vs Kiladze & Chernova 2018 Table 1, inside the published 58.8-72.8° range), φ bootstrap CI, tan α vs 1/d slope with CI; St Venant sector count = 6 (reference 6) with circular-section null = 0; sweep S4 r = 1.000; one-sample KS normality p < 0.001 reported honestly as systematic misfit." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-circle-null-rmse-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-cv-kappa-w-accretion-law>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-kappa-sign-changes>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-ks-pvalue-spiral-residual-normality>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-log-spiral-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-log-spiral-psi-deg>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-log-spiral-rmse-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-alpha-equiv-deg>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-tan-alpha-equiv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-tan-alpha-vs-inv-d-slope>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-narwhal-z-alpha>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-screw-fit-rmse-const-width-twisted-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-screw-fit-rmse-measured-width-twisted-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-spearman-abs-kappa-vs-inv-width>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-st-venant-sign-sectors>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-sweep-psi-pred-vs-fit-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-measurement-twist-rmse-ratio-measured-width>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-morphometric-validation-2>,

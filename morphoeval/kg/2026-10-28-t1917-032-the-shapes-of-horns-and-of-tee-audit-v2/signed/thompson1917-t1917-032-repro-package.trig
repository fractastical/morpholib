        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Reproducibility package: 88/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Fixed seed, `measure_morphoeval` asserted equal across two independent full runs, 25-assertion `run_self_test` (L1251-L1313) covering every Lean law numerically, synthetic log-spiral and synthetic twisted-tusk recovery (τ recovered within 0.0015/px), Procrustes exactness and the measured-width κ·w = Δ identity; library versions and all run parameters written to result.json; documented invocations; full run ~35 s. Deduction: Nelder-Mead restarts are seeded but the optimum is not proven global." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-repro-package-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

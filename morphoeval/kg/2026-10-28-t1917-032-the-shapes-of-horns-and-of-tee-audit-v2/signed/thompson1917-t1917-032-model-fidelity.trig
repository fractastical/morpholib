        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/morphoeval/lean/loops/Thompson1917_T1917_032.lean#L31-L215> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Model fidelity to source: 90/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "E1-E3 (`log_spiral_r`, `whorl_expansion`, `gnomon_radius`, L146-L165), E4-E6 screw accretion with an optional measured-width profile (`grow_tooth`, `implied_psi_deg`, L190-L235), E8-E9 St Venant warping (L238-L277), E7 helix (L281-L296) are implemented as published; the twisted model Thompson invokes for long tusks is now fitted to the specimen in a nested 2 × 2 design (`fit_screw_model`, `compare_screw_models`, L542-L611) and the E5 closure is verified against the integrated accretion ODE (`integrate_accretion_spiral`, S4: r = 1.000). 17 Lean theorems mirror the four laws (0 sorry)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-model-fidelity-4> ;

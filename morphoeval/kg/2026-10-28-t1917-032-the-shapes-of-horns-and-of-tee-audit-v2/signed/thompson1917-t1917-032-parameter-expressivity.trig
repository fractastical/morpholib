sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-parameter-expressivity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Parameter expressivity: 88/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`parameter_sweep` (L639-L700) exercises 30 (λ, c) regimes, 5 twist rates and 16 (λ, c_s) spiral-angle regimes: S1 curvature strictly falls with taper, S2 constant width gives constant curvature, S3 the imposed τ is recovered as Frenet torsion within 2 %, S4 the E5 prediction tan ψ = Δ/c_s matches the fitted ψ with r = 1.000 (RMSE 0.2°) from 14.7° to 85.7°, S5 helix slope rises monotonically with ρ; CLI exposes --sigma-frac, --n-trials, --n-boot, --n-perm and --pass1 (L1315-L1334); five named biological regimes (incisor, Mastodon, mammoth, mammoth + twist, Babirussa) rendered in panel (f)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L613–L700" ;
        dcterms:description "Accretion-ODE integrator, Frenet torsion estimator and S1-S5 regime sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L613-L700> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L1315–L1334" ;
        dcterms:description "CLI parameter overrides wired into run_analysis" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L1315-L1334> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 226 Pass 2 primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-specimen-match> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L300–L386" ;
        dcterms:description "HSV segmentation, skeleton longest path, width via distance transform, width-scaled curvature profile" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L300-L386> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_032_the_shapes_of_horns_and_of_tee_comparison.png (generated output)" ;
        dcterms:description "Panel (a) 3-D screw fit overlay RMSE 17.4 px; (d) narwhal band orientations; (e) St Venant contours vs Fig. 321; (g) 2x2 RMSE bars — docs/media/t1917_032_the_shapes_of_horns_and_of_tee_comparison.png: rendered output of thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py at 3ae9ce99c, image/png, 1014396 B, 2205×1953 px, artifact_sha256 e154f28e16ab5cbcdb1a2d11cbfb0139e8113445b8812d87ff767241c3186ebb (sha256 e154f28e16ab5cbcdb1a2d11cbfb0139e8113445b8812d87ff767241c3186ebb), spec_fingerprint 414a4dcdfdb8857b568651bc291ee292368ae1a49e5e1fb3b1d8e880d3f1ae7f" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 226 Pass 2 primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Morphological realism / specimen match: 78/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "HSV segmentation + skeleton longest path (`segment_mammoth_tusk`, `tusk_centreline_profile`, L300-L386) recovers the SHA-256-locked mammoth centreline and width; the fitted twisted screw model tracks the whole tusk including the reversed tip hook at RMSE 17.4 px (~1.1 % of the 1.5 kpx arc; overlay in panel (a), growth GIF panel 3). The narwhal groove orientation field is extracted by structure tensor in the low-foreshortening strip (L702-L745) and the computed St Venant contours are overlaid on Thompson's own Fig. 321 crop. Deductions: the accretion width-law fit (23.1 px) is worse than the constant-width helix, the root is broken (inflated w(s)), the narwhal is an analogue, and the 3-D form is judged in 2-D only." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-032/result.json L1–L530: screw_best_model = const_width__twisted; measured-width law RMSE ratio 0.75 (< 1: accretion coupling not supported); kappa_sign_changes = 3 <https://github.com/fractastical/morpholib/blob/3ae9ce99c/datasets/thompson_1917/t1917-032/result.json#L1-L530>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-specimen-match-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


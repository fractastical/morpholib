sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Code-to-model traceability: 90/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Module header maps E1-E9 to Thompson pages and to the four Lean laws and lists the Pass 2 additions; every function docstring names its equation and, where applicable, the Lean declaration; KG yaml code_locus / lean_locus pass `verify_integrity.py` and `check_lean_formula_alignment.py`." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-code-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L1–L56" ;
        dct:description "Equation-to-page, Lean-law and Pass 2 remediation traceability in the module header" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L1-L56> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-032.yaml L1–L105" ;
        dct:description "code_locus / lean_locus updated to v2 line ranges; integrity and alignment checks pass" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/morphoeval/math_kg_loops/thompson1917-t1917-032.yaml#L1-L105> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 226 Pass 2 primary assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

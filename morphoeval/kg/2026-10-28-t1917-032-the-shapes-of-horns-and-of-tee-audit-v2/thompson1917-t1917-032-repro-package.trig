sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-032> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-032-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-032 — teeth & tusks: differential-accretion log spiral + St Venant torsion — Reproducibility package: 88/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Fixed seed, `measure_morphoeval` asserted equal across two independent full runs, 25-assertion `run_self_test` (L1251-L1313) covering every Lean law numerically, synthetic log-spiral and synthetic twisted-tusk recovery (τ recovered within 0.0015/px), Procrustes exactness and the measured-width κ·w = Δ identity; library versions and all run parameters written to result.json; documented invocations; full run ~35 s. Deduction: Nelder-Mead restarts are seeded but the optimum is not proven global." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-repro-package-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py L1251–L1313" ;
        dct:description "Self-test suite incl. synthetic twisted-tusk recovery and two-run determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L1251-L1313> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-032-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-032/result.json L1–L530" ;
        dct:description "environment versions, parameters, screw_model_comparison and regime_sweep tables recorded" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3ae9ce99c/datasets/thompson_1917/t1917-032/result.json#L1-L530> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 226 Pass 2 primary assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-032-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Gnomonic self-similarity of the tusk logarithmic spiral" ;
    dct:description "Thompson p. 633-634: the elongated tooth keeps the selfsame curvature law as it grows; each whorl is a magnified copy (gnomon) of the last; the Archimedean alternative fails this functional equation | Variables: r0: radius vector at the tip/pole station; W: whorl expansion per revolution; n, m: whorl indices; r_n: radius after n whorls" ;
    dct:source "Thompson (1917) Ch. XI equiangular spiral, Ch. XIII pp. 616-617, 633-634; Raup (1966) J. Paleont. 40:1178" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3ae9ce99c/morphoeval/lean/loops/Thompson1917_T1917_032.lean#L31-L56>,
        <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L146-L165> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def gnomon_radius (r0 W n : Nat) : Nat := r0 * W ^ n
theorem gnomon_radius_succ (r0 W n : Nat) :
    gnomon_radius r0 W (n + 1) = W * gnomon_radius r0 W n := by
  unfold gnomon_radius
  rw [Nat.pow_succ]
  ac_rfl
theorem gnomon_radius_self_similar (r0 W m n : Nat) :
    gnomon_radius r0 W (m + n) * r0 = gnomon_radius r0 W m * gnomon_radius r0 W n := by
  unfold gnomon_radius
  rw [Nat.pow_add]
  ac_rfl
"""^^pk:lean4 ;
    skos:notation "r_n = r0 * W^n  (W = exp(2 pi cot psi));  r_(n+1) = W r_n;  r_(m+n) r0 = r_m r_n" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.dib.2018.09.029>,
        <https://doi.org/10.14430/arctic1723>,
        <https://doi.org/10.2307/1301992> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_226.gnomon_radius" ;
    pk:leanTheorem "MathOfBiology.Loop_226.gnomon_radius_self_similar" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-032-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Differential-accretion bending law (curvature falls with gnomonic width)" ;
    dct:description "Thompson p. 619 and p. 633: equal rates grow straight, unequal rates curve towards the slower side, mirror image when the sides are exchanged; a widening (tapered) tusk must be most curved at its tip and gentlest at its root, while a constant-section rodent incisor is a circular arc | Variables: vmax, vmin: longitudinal growth rates on the convex (a) and concave (b) sides of the basal growth zone; kappa, kappa': curvature at two stations; w: section width; W: gnomonic width ratio between the stations; Delta: fixed growth-rate contrast" ;
    dct:source "Thompson (1917) Ch. XIII pp. 612, 619, 633-634" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3ae9ce99c/morphoeval/lean/loops/Thompson1917_T1917_032.lean#L64-L115>,
        <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L170-L235> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def bend_moment (vmax vmin : Int) : Int := vmax - vmin
theorem bend_moment_swap_mirror (a b : Int) : bend_moment b a = - bend_moment a b := by
  unfold bend_moment
  omega
theorem accretion_curvature_falls_with_width
    (kappa kappa' w W : Int) (hw : 0 < w) (hk : 0 < kappa) (hW : 1 < W)
    (hlaw : kappa' * (W * w) = kappa * w) : kappa' < kappa := by
  apply Int.not_le.mp
  intro hge
  have hWw_pos : 0 < W * w := Int.mul_pos (by omega) hw
  have h1 : kappa * (W * w) ≤ kappa' * (W * w) :=
    Int.mul_le_mul_of_nonneg_right hge (Int.le_of_lt hWw_pos)
  have hw_lt : w < W * w := by
    have : 1 * w < W * w := Int.mul_lt_mul_of_pos_right hW hw
    omega
  have h2 : kappa * w < kappa * (W * w) := Int.mul_lt_mul_of_pos_left hw_lt hk
  omega
"""^^pk:lean4 ;
    skos:notation "bend_moment = vmax - vmin;  kappa * w = Delta;  w' = W * w, W > 1  =>  kappa' < kappa;  W = 1 => kappa' = kappa (circle)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.dib.2018.09.029>,
        <https://doi.org/10.14430/arctic1723>,
        <https://doi.org/10.2307/1301992> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_226.bend_moment" ;
    pk:leanTheorem "MathOfBiology.Loop_226.accretion_curvature_falls_with_width" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-032-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "St Venant torsion curves of the twisted triangular prism" ;
    dct:description "Thompson pp. 621-623: a circular cylinder twists without warping, any other prism warps each section into an anticlastic surface whose contours (St Venant's torsion curves) make each face half convex / half concave; the Python script reproduces the six alternating sectors and overlays Fig. 321 | Variables: x, y: section coordinates with the centroid at the origin and the vertex X on +x (Thompson Fig. 321); a, b: semi-axes of the elliptic section; u_z: axial warping displacement; tau: twist rate" ;
    dct:source "St Venant (1856) Mem. Savants Etrangers 14:233-560; Thompson (1917) Fig. 321 p. 623" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3ae9ce99c/morphoeval/lean/loops/Thompson1917_T1917_032.lean#L122-L162>,
        <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L238-L277> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def tri_warp (x y : Int) : Int := 3 * x * x * y - y * y * y
theorem tri_warp_anticlastic (x y : Int) : tri_warp x (-y) = - tri_warp x y := by
  unfold tri_warp
  simp only [Int.mul_neg, Int.neg_mul, Int.neg_neg, Int.sub_neg, Int.neg_sub]
  omega
theorem tri_warp_mirror (x y : Int) : tri_warp (-x) y = tri_warp x y := by
  unfold tri_warp
  simp only [Int.mul_neg, Int.neg_mul, Int.neg_neg]
def ellipse_warp (a b x y : Int) : Int := (b * b - a * a) * x * y
theorem ellipse_warp_circle_vanishes (a x y : Int) : ellipse_warp a a x y = 0 := by
  unfold ellipse_warp
  simp
"""^^pk:lean4 ;
    skos:notation "tri_warp(x, y) = 3 x^2 y - y^3 (u_z up to tau/2a);  tri_warp(x, -y) = -tri_warp(x, y);  tri_warp(-x, y) = tri_warp(x, y);  tri_warp(x, 0) = 0;  ellipse_warp(a, b, x, y) = (b^2 - a^2) x y, ellipse_warp(a, a, x, y) = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.dib.2018.09.029>,
        <https://doi.org/10.14430/arctic1723>,
        <https://doi.org/10.2307/1301992> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_226.tri_warp" ;
    pk:leanTheorem "MathOfBiology.Loop_226.tri_warp_anticlastic" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-032-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Uniform-torsion helix of the surface fibres" ;
    dct:description "Thompson pp. 617-622 torsion note applied to the twisted tusk: under uniform twist every groove is a helix whose inclination grows with radius and whose handedness is fixed by tau alone (sinistral in all narwhal tusks); the script measures the groove angle on the narwhal specimen and compares with Kiladze & Chernova (2018) | Variables: rho, rho1, rho2: radial distance of a surface fibre from the tusk axis; tau: uniform twist rate (sign = handedness); phi: fibre inclination from the axis; d: tusk diameter; alpha: Kiladze & Chernova spiral-arc inclination" ;
    dct:source "St Venant (1856); Kiladze & Chernova (2018) Data in Brief 21:1200, doi:10.1016/j.dib.2018.09.029; Kingsley & Ramsay (1988) Arctic 41:236" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3ae9ce99c/morphoeval/lean/loops/Thompson1917_T1917_032.lean#L171-L210>,
        <https://github.com/fractastical/morpholib/blob/3ae9ce99c/thompson/claims/t1917-032_the-shapes-of-horns-and-of-teeth-or-tusks.py#L281-L296> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def helix_slope (rho tau : Int) : Int := rho * tau
theorem helix_slope_monotone_in_radius (rho1 rho2 tau : Int) (h : rho1 < rho2) (ht : 0 < tau) :
    helix_slope rho1 tau < helix_slope rho2 tau := by
  unfold helix_slope
  exact Int.mul_lt_mul_of_pos_right h ht
theorem helix_slope_handedness_flip (rho tau : Int) : helix_slope rho (-tau) = - helix_slope rho tau := by
  unfold helix_slope
  exact Int.mul_neg rho tau
"""^^pk:lean4 ;
    skos:notation "helix_slope = tan(phi) = rho * tau;  pitch = 2 pi / tau;  Kiladze tan(alpha) = pi / (tau d);  rho1 < rho2, tau > 0 => helix_slope(rho1) < helix_slope(rho2);  sign(helix_slope) = sign(tau)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.dib.2018.09.029>,
        <https://doi.org/10.14430/arctic1723>,
        <https://doi.org/10.2307/1301992> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_226.helix_slope" ;
    pk:leanTheorem "MathOfBiology.Loop_226.helix_slope_monotone_in_radius" ;
    pk:leanVerified true .


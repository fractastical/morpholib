        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-11>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-12>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-13>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-14>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-15>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-16>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-17>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-032-the-shapes-of-horns-and-of-tee-audit-v2-thompson1917-t1917-032-7>,

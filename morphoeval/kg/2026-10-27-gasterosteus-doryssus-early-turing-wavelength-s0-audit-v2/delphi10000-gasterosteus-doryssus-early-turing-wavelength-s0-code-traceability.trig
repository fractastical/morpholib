            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-code-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py L1–L40" ;
        dct:description "Docstring separates k_c from the GIF carrier" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py#L1-L40> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;

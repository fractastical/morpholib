sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength of Gasterosteus doryssus_early at 33 µm (10.02 Ma) — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass-2 functions are named for the remediation items they close (seed_ensemble, successor_pde, delta_sweep) and the math-KG file still points at the Jacobian, sigma(k), and the six Lean theorems. Deduction: Lean was not executed (-6); the GIF wavenumber k_img = 6 is a pixel-grid constant, which the docstring separates from k_c (-4). The docstring separation is why this is not lower." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-code-traceability-1>,

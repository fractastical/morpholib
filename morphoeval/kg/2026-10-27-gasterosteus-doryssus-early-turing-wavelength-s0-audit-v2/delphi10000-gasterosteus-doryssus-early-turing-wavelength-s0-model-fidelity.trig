sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength of Gasterosteus doryssus_early at 33 µm (10.02 Ma) — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1's Schnakenberg integrator and the r = 0.9947 dispersion test are unchanged. Pass 2 adds a real successor integration: at the scaled diffusivity the nonlinear wavelength is 43.11 µm against an analytic peak of 41.71 µm, and it is longer than the early field (33.87 µm). The deduction that remains is the GIF carrier: an imposed m=2 spiral whose amplitude follows RMS(u), not a spiral that the PDE itself selected (-8), and a, b still are not a stickleback fit (-4)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py L148–L191" ;
        dct:description "Explicit-Euler Schnakenberg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py#L148-L191> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py L216–L278" ;
        dct:description "Dispersion Pearson r = 0.9947, RMSE = 0.0259" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py#L216-L278> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py L520–L533" ;
        dct:description "Successor PDE at scaled D_u, FFT wavelength 43.11 µm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py#L520-L533> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor still absent)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength of Gasterosteus doryssus_early at 33 µm (10.02 Ma) — Reproducibility package: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "--self-test passed after the Pass-2 additions: r > 0.98, ablation ratio < 0.05, monotonic D_u sweep, successor PDE longer than the early field, seed CV < 0.08 (measured 0.0223), ratio-1 σ_max < 0, GIF frames >= 10, side >= 480, CV >= 58. SHA-256 pins still match. Deduction: no second-assessor script and no Lean binary in the image (-6); matplotlib cache is outside the repo (-4)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py L94–L102" ;
        dct:description "SHA-256 check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py#L94-L102> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/gasterosteus_doryssus_early_turing_wavelength_s0/simulation_results.json L1–L40" ;
        dct:description "Pass-2 numeric record: r, CV, successor, seeds" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/datasets/gasterosteus_doryssus_early_turing_wavelength_s0/simulation_results.json#L1-L40> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

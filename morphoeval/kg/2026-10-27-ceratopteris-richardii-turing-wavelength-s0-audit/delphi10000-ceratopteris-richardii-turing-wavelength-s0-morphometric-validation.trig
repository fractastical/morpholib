sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Ceratopteris richardii Schnakenberg wavelength at 256 µm (Holocene, 0 Ma) — Morphometric validation: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r is 1.0 against a null of 0. Plate foreground fraction 0.742 and coherency 0.231 are measured, not copied from the reference priors. KS, RMSE, and the gametophyte voucher are not yet in the measurement list." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-critical-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-pearson-r-dispersion>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-plate-width-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-stripe-wavelength-grid-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-critical-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_wavelength_um = 256.0 µm" ;
        dct:description "analytical wavelength; RMSE against the grid measurement is separate" ;
        schema:measurementTechnique "k_c from Schnakenberg Jacobian at the slot-3143 diffusivities; lambda = 2*pi/k_c" ;
        schema:name "critical_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "256.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-critical-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-critical-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "slot scale 256 µm (detail variant of tier 5_primordium_100um), age 0 Ma" ;
        schema:value "256.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-pearson-r-dispersion> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pearson_r_dispersion = 1.0 1" ;
        dct:description "goodness-of-fit of the implemented dispersion relation" ;
        schema:measurementTechnique "Pearson r of sigma(k) closed form vs 2x2 matrix eigenvalues, 48 wavenumbers" ;
        schema:name "pearson_r_dispersion" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-pearson-r-dispersion-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-pearson-r-dispersion-reference> a schema:PropertyValue ;
        dct:source "null of uncorrelated growth-rate estimators" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-plate-width-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "plate_width_um = 754.72 µm" ;
        dct:description "plate is slightly narrower than the 768 µm window" ;
        schema:measurementTechnique "800 px times 100/106 µm per px from the drawn scale bar" ;
        schema:name "plate_width_um" ;
        schema:unitText "µm" ;
        schema:value "754.72" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-plate-width-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-plate-width-um-reference> a schema:PropertyValue ;
        dct:source "model window of three 256 µm wavelengths" ;
        schema:value "768.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_plate_coherency = 0.2315 1" ;
        dct:description "specimen image coherency" ;
        schema:measurementTechnique "mean structure-tensor coherency of the canonical plate" ;
        schema:name "specimen_plate_coherency" ;
        schema:unitText "1" ;
        schema:value "0.2315" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-texture prior" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_plate_foreground_fraction = 0.7419 1" ;
        dct:description "non-circular specimen segmentation" ;
        schema:measurementTechnique "Otsu mask on the canonical plate above the caption strip" ;
        schema:name "specimen_plate_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.7419" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-specimen-plate-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-field prior, not the measured fraction" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-stripe-wavelength-grid-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_wavelength_grid_um = 256.0 µm" ;
        dct:description "RMSE is |grid peak - 256 µm|" ;
        schema:measurementTechnique "parabolic interpolation of the radial FFT peak of the activator, times dx" ;
        schema:name "stripe_wavelength_grid_um" ;
        schema:unitText "µm" ;
        schema:value "256.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-stripe-wavelength-grid-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-measurement-stripe-wavelength-grid-um-reference> a schema:PropertyValue ;
        dct:source "same 256 µm target; grid peak is not forced to the bin centre" ;
        schema:value "256.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py L151–L158" ;
        dct:description "dispersion_pearson" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8bc1f20b8ecb6382629bf389fb84a0d39e22d0ca/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py#L151-L158> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratopteris-richardii-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py L263–L285" ;
        dct:description "segment_plate Otsu and coherency" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8bc1f20b8ecb6382629bf389fb84a0d39e22d0ca/models/2026-delphi10000-ceratopteris-richardii-turing-wavelength-s0.py#L263-L285> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0000-0000-0000> .
}


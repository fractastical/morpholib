<https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> a pk:Claim ;
    rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation (Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites)",
        "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation faithfully reproduces Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/cooke-clock-and-wavefront-1>,
        <https://w3id.org/probknow/resource/math-law/cooke-clock-and-wavefront-2>,
        <https://w3id.org/probknow/resource/math-law/cooke-clock-and-wavefront-3> ;
    dct:description "The simulation script(s) 1976-cooke-clock-and-wavefront.py implement the cited source model as published and produce forms that match real Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 58.1/100, audit 2026-10-19-clock-and-wavefront-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py> ;
    schema:about "Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py; output: docs/media/clock_and_wavefront_comparison.png; organism: Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 9a567843f2a6020e93562e6d7e58c2b8167adcb8c6b198fb2164e03a085e6bb6; artifact_sha256: 1db23a76c4cc9d4544515fc51d9b8e774a6986c84596f4234ab2cf361bf10101; input_dataset_sha256: {datasets/clock_and_wavefront/clock_and_wavefront_reference.json=4851550f4179ae63..., datasets/clock_and_wavefront/scout_manifest.json=0beabd3277c705e6..., datasets/clock_and_wavefront/somite_embryo_specimen.jpg=8b80971796cb29e2...}" ;
    pk:derivedFromPaper <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0022-5193(76)80131-2>,
        <https://doi.org/10.1016/S0092-8674(00)80451-1>,
        <https://doi.org/10.1038/254196a0> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-model-fidelity>,

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Morphological realism / specimen match: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors `datasets/clock_and_wavefront/somite_embryo_specimen.jpg` (CC BY 4.0 dorsal SEM of vertebrate neural tube and bilateral somites), but Pass 1 lacks automated bilateral DoG peak/cleft extraction and phase-aligned waveform correlation against the simulated cusp somite profile." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L248–L315: Specimen segmentation routine on somite_embryo_specimen.jpg <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py#L248-L315>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-1> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/clock_and_wavefront_comparison.png (generated output)" ;
        dcterms:description "Comparison figure with dorsal SEM somite overlay — docs/media/clock_and_wavefront_comparison.png: rendered output of 1976-cooke-clock-and-wavefront.py at 317bc3c, image/png, 1215618 B, 2310×1372 px, artifact_sha256 1db23a76c4cc9d4544515fc51d9b8e774a6986c84596f4234ab2cf361bf10101 (sha256 1db23a76c4cc9d4544515fc51d9b8e774a6986c84596f4234ab2cf361bf10101), spec_fingerprint 9a567843f2a6020e93562e6d7e58c2b8167adcb8c6b198fb2164e03a085e6bb6" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

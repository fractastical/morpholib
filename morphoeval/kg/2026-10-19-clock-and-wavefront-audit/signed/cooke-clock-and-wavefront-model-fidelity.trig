sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(00)80451-1>,
            <https://doi.org/10.1038/254196a0> .

    <https://doi.org/10.1002/dvdy.21193> dcterms:date "2007"^^xsd:gYear ;
        dcterms:title "Sharp developmental thresholds defined through bistability by antagonistic gradients of retinoic acid and FGF signaling" .

    <https://doi.org/10.1016/S0022-5193(76)80131-2> dcterms:date "1976"^^xsd:gYear ;
        dcterms:title "A clock and wavefront model for control of the number of repeated structures during animal morphogenesis" .

    <https://doi.org/10.1016/S0092-8674(00)80451-1> dcterms:date "1997"^^xsd:gYear ;
        dcterms:title "Avian hairy gene expression identifies a molecular clock linked to vertebrate segmentation and somitogenesis" .

    <https://doi.org/10.1038/254196a0> dcterms:date "1975"^^xsd:gYear ;
        dcterms:title "Control of somite number during morphogenesis of a vertebrate, Xenopus laevis" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Model fidelity to source: 62/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Cooke & Zeeman's (1976) kinematic wavelength law S = v * T_c and Thom-Zeeman cusp catastrophe ODE dchi/dt = -(chi^3 - a(x,t)*chi - b_osc(x,t))/tau_chi (L145-235), but fixed spatial phase gradient k_phi and unscaled wavefront width sigma_w introduce a 1-somite boundary discrepancy (N=39 vs 40) between normal and miniature embryos." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L145–L235: Cusp catastrophe clock-wavefront solver requiring proportional sigma_w scaling <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py#L145-L235>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L88–L108" ;
        dcterms:description "Analytical somite wavelength S = v * T_c and count N = L / (v * T_c)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py#L88-L108> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Parameter expressivity: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Covers normal (L=4.0 mm) and miniature (L=2.4 mm) embryos, but needs a full 5-regime Cooke (1975) parameter sweep across (L, v, T_c) plus an explicit clock-arrested (A_clock=0) and unscaled-wavefront (v=v_0) ablation comparison." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L115–L142: Size regulation regime evaluator <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py#L115-L142>" ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


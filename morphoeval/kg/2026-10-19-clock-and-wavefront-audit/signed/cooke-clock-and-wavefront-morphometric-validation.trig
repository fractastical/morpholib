sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "clock-doubled perturbation (2x T_c) vs clock-arrested ablation control somite count delta = 20.0 somites (slow_clock vs null_control)" ;
        dcterms:description "slow_clock S=200.25 um (CV=0.0081), null_control peaks=0" ;
        schema:measurementTechnique "2x clock period perturbation (T_c=90 min -> N=20, S=200 um) vs clock-arrested negative control (A_clock=0 -> 0 somites)" ;
        schema:name "clock-doubled perturbation (2x T_c) vs clock-arrested ablation control somite count delta" ;
        schema:unitText "somites (slow_clock vs null_control)" ;
        schema:value "20.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta-reference> a schema:PropertyValue ;
        dcterms:source "Cooke & Zeeman (1976) J. Theor. Biol. 58:455-476 Section 3 (doubling T_c halves N from 40 to 20; arresting clock abolishes segmentation N=0)" ;
        schema:value "20.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cooke (1975) 5-regime somite count prediction RMSE = 0.2651 somites" ;
        dcterms:description "max regime error = 0.401 somites across normal, 75%, 60% miniature, 2x clock, and 1.5x wavefront" ;
        schema:measurementTechnique "RMSE across 5 Cooke (1975) / Cooke & Zeeman (1976) size-regulation and clock/wavefront perturbation regimes (Pearson r=0.9996, p=9.94e-06)" ;
        schema:name "Cooke (1975) 5-regime somite count prediction RMSE" ;
        schema:unitText "somites" ;
        schema:value "0.2651" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse-reference> a schema:PropertyValue ;
        dcterms:source "Cooke (1975) Nature 254:196-199 Table 1" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "miniature operated Xenopus embryo (60% length) somite count N_mini vs normal N_norm (size-invariance ratio) = 1.0 N_mini / N_norm ratio" ;
        dcterms:description "N_mini=40 vs N_norm=40; across 5 Cooke regimes r=0.9996 (p=9.94e-06), RMSE=0.265 somites" ;
        schema:measurementTechnique "proportional wavefront scaling v' = 0.60*v_0 in L'=2.4 mm miniature embryo (S_mini=60.08 um vs S_norm=100.13 um)" ;
        schema:name "miniature operated Xenopus embryo (60% length) somite count N_mini vs normal N_norm (size-invariance ratio)" ;
        schema:unitText "N_mini / N_norm ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Cooke (1975) Nature 254:196-199 Table 1 (39.6 / 40.2 = 0.9851 somite count invariance ratio; theoretical = 1.0000)" ;
        schema:value "0.9851" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-normal-xenopus-somite-wavelength-s-sim-vs-analytical-s-v-t-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "normal Xenopus somite wavelength S_sim vs analytical S = v*T_c = 100.1252 um" ;
        dcterms:description "relative error = 0.125%, spacing CV = 0.0113" ;
        schema:measurementTechnique "cusp clock-and-wavefront ODE solver peak-to-peak somite spacing (CV=0.0113, n=40 somites)" ;
        schema:name "normal Xenopus somite wavelength S_sim vs analytical S = v*T_c" ;
        schema:unitText "um" ;
        schema:value "100.1252" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-normal-xenopus-somite-wavelength-s-sim-vs-analytical-s-v-t-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-normal-xenopus-somite-wavelength-s-sim-vs-analytical-s-v-t-c-reference> a schema:PropertyValue ;
        dcterms:source "Cooke & Zeeman (1976) J. Theor. Biol. 58:455-476 (L=4.0 mm, T_c=45 min, v=2.222 um/min => S=100.0 um)" ;
        schema:value "100.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate embryo SEM specimen bilateral somite spacing S_obs = 48.4667 px" ;
        dcterms:description "bilateral symmetry ratio = 0.9606, std = 9.70 px, phase correlation r = 0.5629" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on somite_embryo_specimen.jpg (upper=8 somites, lower=9 somites, CV=0.2002)" ;
        schema:name "vertebrate embryo SEM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "48.4667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dcterms:source "Vendored CC BY 4.0 vertebrate embryo SEM specimen (datasets/clock_and_wavefront/somite_embryo_specimen.jpg)" ;
        schema:value "48.47" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Morphometric validation: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Measures simulated somite spacing S_sim, but Pass 1 requires full 5-regime Pearson correlation r and RMSE against Cooke (1975) Table 1 plus bilateral specimen spacing CV and symmetry ratio." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L322–L395: MorphoEval measurement hook measure_morphoeval() <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py#L322-L395>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-normal-xenopus-somite-wavelength-s-sim-vs-analytical-s-v-t-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


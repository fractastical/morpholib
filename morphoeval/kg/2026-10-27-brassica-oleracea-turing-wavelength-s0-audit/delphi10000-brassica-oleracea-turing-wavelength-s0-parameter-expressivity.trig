sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Brassica oleracea Schnakenberg Turing wavelength at 172 µm (Holocene, 0 Ma) — Parameter expressivity: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Analytical wavelength rises at all five D_v steps from 0.60 to 1.90 times the 172 µm diffusivity. The nonlinear measured wavelength on the 96x128 grid only reaches Pearson r = 0.83 because four of the six runs share one Fourier bin. Equal diffusion is stable (sigma_max = -0.10) but Pass 1 does not yet quote the sweep RMSE next to the modal r." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-parameter-expressivity-1> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py L280–L314" ;
        dct:description "D_v sweep and equal-diffusion ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py#L280-L314> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (MorphoEval loop 3137 Pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


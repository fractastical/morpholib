sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-brassica-oleracea-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Brassica oleracea Schnakenberg Turing wavelength at 172 µm (Holocene, 0 Ma) faithfully reproduces Brassica oleracea morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Brassica oleracea specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py; output: docs/media/brassica_oleracea_turing_wavelength_s0_comparison.png; organism: Brassica oleracea; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Turing 1952 dispersion relation | Schnakenberg 1979 quadratic autocatalysis | Azpeitia et al. 2021 floral-network account of Romanesco cones (a different mechanism); reconstructed_in_script: sigma(k) and D_v solved for lambda = 172 µm | Modal growth-rate comparison on modes k = 1..6; transfer_boundary: 172 µm is the slot scale, not a spacing measured by Azpeitia or Duclos; does_not_claim: That the studio photograph resolves 172 µm | That Schnakenberg species are the Brassica morphogens]; phenomenon_size: 7.6 cm (0.07562 m, log10=-1.121 m, tier=7_organism_cm); species_scale_ladder (1 runs from 7.6 cm to 7.6 cm): 7.6 cm:roman-esco-fractal-inflorescence" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1093/jxb/erm327>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.abg5999> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-brassica-oleracea-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1093/jxb/erm327>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.abg5999> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1093/jxb/erm327> dct:date "2008"^^xsd:gYear ;
        dct:title "Meristem identity gene expression during curd proliferation and flower initiation in Brassica oleracea" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.abg5999> dct:date "2021"^^xsd:gYear ;
        dct:title "Cauliflower fractal forms arise from perturbations of floral gene networks" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Danio albolineatus Schnakenberg wavelength at 37 µm (Holocene, 0 Ma) — MorphoEval overall 80.2/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1. Schnakenberg reaction-diffusion on a periodic 96×60 patch. Activator diffusivity is solved so the pearl-danio fastest mode is 3.686e-05 m (36.9 µm). At equal time the predecessor (anisotropic inhibitor, Danio aesculapii) forms vertical bars at 41.8 µm (std 0.327), the focal species stays near the homogeneous state (std 0.007), and the successor (Danio margaritatus) forms spots at 34.2 µm (std 0.707). Equal diffusion is stable (σ_max = −0.137). Closed-form dispersion matches matrix eigenvalues at Pearson r = 1.000, RMSE ~ 1e-15. The radial-spectrum correlation against linear theory is 0.9799. One Commons photograph; flank depth/length 0.221 versus the FishBase landmark ratio 0.250. Weighted overall 80.2/100. Overall 80.2/100 (faithfulness 79.0, reproducibility 82.9); rubric morphoeval 0.1.0; checkpoint commit 0c76d15d14afcec6c366e1b9274a6586a0de48fc; environment: . Dimension assessments: Model fidelity to source 84, Morphological realism / specimen match 76, Parameter expressivity 84, Morphometric validation 74, Source and data traceability 88, Code-to-model traceability 78, Reproducibility package 82. Output judged: docs/media/danio_albolineatus_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 433658 B, 1584×1224 px, artifact_sha256 056fbfdf9ee2dc34c7d28dd6b66a73ebcc485f1cd5da66b7a5d08758805167b1 (sha256 056fbfdf9ee2dc34c7d28dd6b66a73ebcc485f1cd5da66b7a5d08758805167b1), spec_fingerprint 4c792f240f2eddeb1b293e2ff8dcb16085a188074fadafd2384021469481a83a. Dual provenance: spec_fingerprint: 4c792f240f2eddeb1b293e2ff8dcb16085a188074fadafd2384021469481a83a; artifact_sha256: 056fbfdf9ee2dc34c7d28dd6b66a73ebcc485f1cd5da66b7a5d08758805167b1; input_dataset_sha256: {datasets/danio_albolineatus_turing_wavelength_s0/danio_albolineatus_turing_wavelength_s0_reference.json=fb3bd6f8d0bd368c..., datasets/danio_albolineatus_turing_wavelength_s0/danio_albolineatus_turing_wavelength_s0_specimen.jpg=f42000111fe647d8..., datasets/danio_albolineatus_turing_wavelength_s0/paper_citations.bib=80659eeead83362e..., datasets/danio_albolineatus_turing_wavelength_s0/scout_manifest.json=2c0d2a9d801e9099...}. Claim boundary: reported_in_source: Turing dispersion relation and critical wavenumber. | Short-range melanophore-xanthophore exclusion and long-range dependence (Nakamasu et al. 2009). | D. albolineatus does not build the reiterated zebrafish stripe stack (Patterson, Bain & Parichy 2014). | Danio patterns include vertical bars and spots, with kcnj13 implicated in D. aesculapii (Podobnik et al. 2020).; reconstructed_in_script: Schnakenberg parameters (a, b) = (0.12, 0.88) and the diffusion ratios for the three species. | Identification of the assigned 3.686e-05 m scale with the pearl-danio fastest mode.; transfer_boundary: Sister-species wavelengths are predictions of the diffusion change, not histological measurements at 37 µm. | The aquarium photograph does not resolve 37 µm (about 150 µm per pixel along the body).; does_not_claim: Sand, plants, and the body outline are not generated by the reaction-diffusion equation. | The kinetics are not Patterson & Parichy's cell-by-cell model.." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'All-band spectral Pearson r is 0.9799. Recompute the correlation on the unstable band σ(k) > 0 and report that number even if it is worse.'}",
            "remediation needed: {'id': 'R2', 'item': 'FFT wavelength is reported for one noise seed. Repeat seeds 7 and 99 and record the coefficient of variation.'}",
            "remediation needed: {'id': 'R3', 'item': 'One aquarium photograph. The depth/length ratio is a bounding box, not the FishBase landmark measurement.'}",
            "remediation needed: {'id': 'R4', 'item': 'Single assessor. This pass is not a cross-provider audit.'}",
            "remediation needed: {'id': 'R5', 'item': 'Predecessor and successor wavelengths are reconstructions from the diffusion change, not measurements at 37 µm.'}" ;
        pk:hasScore "0.802"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent Pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-danio-albolineatus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-albolineatus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-albolineatus-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-albolineatus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Homogeneous state of the pearl-danio kinetics is stable in the absence of diffusion (tr J < 0, det J > 0), so any pattern requires diffusive instability. | Variables: f_u, f_v, g_u, g_v at the Schnakenberg steady state (a, b) = (0.12, 0.88); scale L = 37 µm" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Nakamasu et al. (2009) DOI:10.1073/pnas.0808622106" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3161_danio_albolineatus_turing_wavelength_s0.lean#L18-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/ncomms6299>,
        <https://doi.org/10.1038/s41467-018-05629-z>,
        <https://doi.org/10.1038/s41467-020-20021-6>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3161.homogeneous_stable_without_diffusion" ;
    pk:leanTheorem "MathOfBiology.Loop_3161.homogeneous_stable_without_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-albolineatus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber k_c" ;
    dct:description "Selects the 37 µm cellular wavelength of the uniform-interstripe species. | Variables: D_u solved so the fastest-growing mode of Danio albolineatus has lambda_c = 3.686e-05 m" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Patterson, Bain & Parichy (2014) DOI:10.1038/ncomms6299" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3161_danio_albolineatus_turing_wavelength_s0.lean#L36-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v);  lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/ncomms6299>,
        <https://doi.org/10.1038/s41467-018-05629-z>,
        <https://doi.org/10.1038/s41467-020-20021-6>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3161.wavenumber_wavelength_product" ;
    pk:leanTheorem "MathOfBiology.Loop_3161.wavenumber_wavelength_product" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-albolineatus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavelength order" ;
    dct:description "At 37 µm the predecessor lengthens the AP-varying bar mode by anisotropic inhibitor spread; the successor shortens the spot mode. | Variables: 41801 nm > 36869 nm > 34213 nm at age 0 Ma" ;
    dct:source "Podobnik et al. (2020) DOI:10.1038/s41467-020-20021-6; Volkening & Sandstede (2018) DOI:10.1038/s41467-018-05629-z" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3161_danio_albolineatus_turing_wavelength_s0.lean#L30-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(D. aesculapii bars) > lambda(D. albolineatus) > lambda(D. margaritatus spots)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/ncomms6299>,
        <https://doi.org/10.1038/s41467-018-05629-z>,
        <https://doi.org/10.1038/s41467-020-20021-6>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3161.chronoseries_wavelength_order" ;
    pk:leanTheorem "MathOfBiology.Loop_3161.chronoseries_wavelength_order" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-albolineatus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Danio albolineatus Schnakenberg wavelength at 37 µm (Holocene, 0 Ma) faithfully reproduces Danio albolineatus morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Danio albolineatus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py; output: docs/media/danio_albolineatus_turing_wavelength_s0_comparison.png; organism: Danio albolineatus; environment: n/a; claim_boundary: [reported_in_source: Turing dispersion relation and critical wavenumber. | Short-range melanophore-xanthophore exclusion and long-range dependence (Nakamasu et al. 2009). | D. albolineatus does not build the reiterated zebrafish stripe stack (Patterson, Bain & Parichy 2014). | Danio patterns include vertical bars and spots, with kcnj13 implicated in D. aesculapii (Podobnik et al. 2020).; reconstructed_in_script: Schnakenberg parameters (a, b) = (0.12, 0.88) and the diffusion ratios for the three species. | Identification of the assigned 3.686e-05 m scale with the pearl-danio fastest mode.; transfer_boundary: Sister-species wavelengths are predictions of the diffusion change, not histological measurements at 37 µm. | The aquarium photograph does not resolve 37 µm (about 150 µm per pixel along the body).; does_not_claim: Sand, plants, and the body outline are not generated by the reaction-diffusion equation. | The kinetics are not Patterson & Parichy's cell-by-cell model.]; phenomenon_size: 20 µm (2.018e-05 m, log10=-4.695 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 20 µm to 4.5 cm): 20 µm:danio-aesculapii-bioelectric-polarity, 63 µm:danio-aesculapii-vertex-packing, 1.0 mm:danio-aesculapii-turing-wavelength, 2.0 mm:danio-aesculapii-clock-wavefront, 4.5 mm:danio-aesculapii-morphogen-condensation, 5.5 mm:danio-aesculapii-elastic-buckling, 6.3 mm:danio-aesculapii-flux-canalization, 8.8 mm:danio-aesculapii-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1038/ncomms6299>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/s41467-020-20021-6>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-danio-albolineatus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/ncomms6299>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1038/s41467-020-20021-6>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1038/ncomms6299> dct:date "2014"^^xsd:gYear ;
        dct:title "Pigment cell interactions and differential xanthophore recruitment underlying zebrafish stripe reiteration and Danio pattern evolution" .
    <https://doi.org/10.1038/s41467-018-05629-z> dct:date "2018"^^xsd:gYear ;
        dct:title "Iridophores as a source of robustness in zebrafish stripes and variability in Danio patterns" .
    <https://doi.org/10.1038/s41467-020-20021-6> dct:date "2020"^^xsd:gYear ;
        dct:title "Evolution of the potassium channel gene Kcnj13 underlies colour pattern diversification in Danio fish" .
    <https://doi.org/10.1073/pnas.0808622106> dct:date "2009"^^xsd:gYear ;
        dct:title "Interactions between zebrafish pigment cells responsible for the generation of Turing patterns" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


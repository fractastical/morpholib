sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Reproducibility package: 89/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "--self-test now also requires exactly three discs, mean circularity above 0.60, and mean aspect between 0.85 and 1.15, on top of the Pass 1 checks (SHA-256, Lean text, repeated-run identity, ablation, 10 µm quench, Pearson r > 0.98). This run passed. GIF gate remains 12 frames at 560 px. Same environment deductions: no script-specific lock file (-6) and no lean binary on this machine (-5)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-3> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L731–L785" ;
        dct:description "Self-test, including the three-disc assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L731-L785> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;

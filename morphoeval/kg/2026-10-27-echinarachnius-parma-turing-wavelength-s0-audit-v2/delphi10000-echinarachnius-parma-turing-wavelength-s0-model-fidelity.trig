sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Unchanged mechanism from Pass 1, re-checked on this commit. jacobian (L85-L104), dispersion_sigma (L107-L114) and the periodic IMEX step (L160-L200) are the Schnakenberg system and the Turing eigenvalue. Ratio 12 opens the trace gap; Du = Dv closes it. Lean still proves the integer form of that sign and the 10/480/600 µm counts, with no sorry. The same deduction stands: Du and Dv are calibrations to 60 µm (-10)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L70–L76: Du and Dv remain frozen calibrations <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L70-L76>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L85–L128" ;
        dct:description "Jacobian, dispersion eigenvalue, and trace gap" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L85-L128> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L160–L200" ;
        dct:description "Periodic Fourier IMEX integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L160-L200> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean L36–L53" ;
        dct:description "Scale counts and both trace-gap signs, no sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/968c2bf7/morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean#L36-L53> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, Pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


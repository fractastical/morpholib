<https://w3id.org/delphi/resource/math-law/delphi10000-echinarachnius-parma-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg homogeneous state" ;
    dct:description "Stable base state (trace < 0, det > 0) on which diffusion can select a wavelength | Variables: a, b feed rates; u activator; v inhibitor" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81:389-400 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L85-L104>,
        <https://github.com/fractastical/morpholib/blob/968c2bf7/morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean#L31-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u* = a + b, v* = b / (a + b)^2, with a = 0.10 and b = 0.90" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/S0094837300006527>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3214.nWavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3214.wavelength_count_independent_of_age" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-echinarachnius-parma-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber" ;
    dct:description "Selects the 60 µm pigment-ocellus wavelength on the Holocene epithelial patch | Variables: Du, Dv diffusivities; fu, gv Jacobian entries" ;
    dct:source "Turing (1952) Phil. Trans. R. Soc. B 237:37-72 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L107-L128>,
        <https://github.com/fractastical/morpholib/blob/968c2bf7/morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean#L50-L53> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sigma(k) = larger eigenvalue of J - k^2 D; lambda = 2 pi / argmax sigma(k)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/S0094837300006527>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3214.turingTraceGap" ;
    pk:leanTheorem "MathOfBiology.Loop_3214.holocene_ratio_12_opens_turing" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-echinarachnius-parma-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Scale-ladder wavelength count" ;
    dct:description "What changes at 60 µm versus the 10 µm predecessor tier and the 600 µm successor tier, at 0 Ma | Variables: L patch length in micrometres" ;
    dct:source "Slot scale ladder; Seilacher (1979) Paleobiology 5:191-221 is the centimetre-scale test, not this wavelength" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L233-L247>,
        <https://github.com/fractastical/morpholib/blob/968c2bf7/morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean#L36-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "n(L) = floor(L / 60 µm); n(10)=0, n(480)=8, n(600)=10; age does not enter" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/S0094837300006527>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3214.nWavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3214.holocene_480um_patch_holds_eight" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-echinarachnius-parma-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control. Pattern amplitude collapses when the inhibitor is not the faster diffuser | Variables: Du = Dv" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L227-L231>,
        <https://github.com/fractastical/morpholib/blob/968c2bf7/morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean#L45-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "turingTraceGap(Du, Du) < 0 when fu < |gv|" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/S0094837300006527>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3214.turingTraceGap" ;
    pk:leanTheorem "MathOfBiology.Loop_3214.equal_diffusion_closes_turing" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Parameter expressivity: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The diffusivity sweep, equal-diffusion ablation, and 10–600 µm ladder are the Pass 1 controls. Pass 2 draws a marker and the words \"ablated\" and \"quenched\" on the two near-zero bars (L448-L466), so the 10 µm quench is readable. Endpoints of the sweep remain ordered, and Pearson r is 0.9965. Feed rates a and b are still not swept (-9)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L202–L247" ;
        dct:description "Sweep, ablation, and domain ladder" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L202-L247> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L448–L466" ;

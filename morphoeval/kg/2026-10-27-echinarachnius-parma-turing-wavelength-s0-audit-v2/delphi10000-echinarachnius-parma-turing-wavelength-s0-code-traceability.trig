sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Code-to-model traceability: 87/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 code is still pointed at from the math-kg yaml, including the shifted ablation and domain-series ranges. The docstring, the dispersion functions, and the six Lean theorems (no sorry) still match the integer scale ladder and the trace-gap sign. Deduction for the integer stand-in Jacobian in Lean (-8) and for the spacing-window comment being operational rather than a cited equation (-5)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-code-traceability-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-code-traceability-3> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L1–L48" ;
        dct:description "Docstring states the PDE, 60 µm, and 0 Ma" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/968c2bf7/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L1-L48> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-echinarachnius-parma-turing-wavelength-s0.yaml L1–L75" ;
        dct:description "Laws linked to Lean and to the Pass 2 line ranges" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/968c2bf7/morphoeval/math_kg_loops/delphi10000-echinarachnius-parma-turing-wavelength-s0.yaml#L1-L75> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean L19–L53" ;
        dct:description "Six theorems, zero sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/968c2bf7/morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean#L19-L53> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, Pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

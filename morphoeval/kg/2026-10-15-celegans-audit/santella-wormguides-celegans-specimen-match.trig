@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-15-celegans-audit-santella-wormguides-celegans-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Morphological realism / specimen match: 60/100" ;
        rdfs:comment "The re-derived lineage chart has the shape of Sulston's diagram (founder sub-trees in order, AB dominating, P4 ending in two cells), the nuclear clouds have the egg's aspect under the calibration (49 x 27 x 25 um at the end), and gastrulation shows as the E cells moving inward. Distinct stages are visually distinct. But no photograph, DIC series or WormGUIDES screenshot is placed beside the output, the WormAtlas images are only cited, and the meshes at frame 330 are drawn as flat projections, so resemblance to the real embryo is argued from counts and extents rather than shown side by side. Evidence: celegans_four_views.png (generated output, not in repo): lineage chart, six stages, meshes, connectome — celegans_four_views.png: rendered output of 2015-santella-wormguides-celegans.py at 2864784, image/png, 424197 B, 2240×1680 px, sha256 eb4b60086280c9a1740358c26fc655598f25d2adad63a9fcdb9c3a7980cc3bd6; 2015-santella-wormguides-celegans.py L384–L428: lineage_layout()/draw_lineage(): the chart from the names <https://github.com/fractastical/morpholib/blob/2864784/2015-santella-wormguides-celegans.py#L384-L428>; 2015-santella-wormguides-celegans.py L433–L448: draw_embryo(): discs at recorded diameter, z-ordered <https://github.com/fractastical/morpholib/blob/2864784/2015-santella-wormguides-celegans.py#L433-L448>; 2015-santella-wormguides-celegans.py L461–L480: draw_meshes(): the atlas's OBJ shapes in the nuclei frame <https://github.com/fractastical/morpholib/blob/2864784/2015-santella-wormguides-celegans.py#L461-L480>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-specimen-match> ;
        pk:hasProbability "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-specimen-match> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome (2015-santella-wormguides-celegans.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416)" ;
        dct:identifier "morphoeval/0.1.0/specimen-match" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> .
    <https://doi.org/10.1016/0012-1606(83)90201-4> dct:date "1983"^^xsd:gYear ;
        dct:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .
    <https://doi.org/10.1038/s41586-019-1352-7> dct:date "2019"^^xsd:gYear ;
        dct:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .
    <https://doi.org/10.1083/jcb.144.5.927> dct:date "1999"^^xsd:gYear ;
        dct:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .
    <https://doi.org/10.1098/rstb.2017.0382> dct:date "2018"^^xsd:gYear ;
        dct:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .
    <https://doi.org/10.1186/s12859-015-0627-8> dct:date "2015"^^xsd:gYear ;
        dct:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
}


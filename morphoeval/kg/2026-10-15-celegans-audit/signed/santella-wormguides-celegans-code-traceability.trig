sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-15-celegans-audit-santella-wormguides-celegans-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Code-to-model traceability: 75/100" ;
        rdfs:comment "The docstring names the loader whose column semantics are followed, the ProductionInfo fields used, the source of every literature constant and the calibration reference; each check prints the value and the literature anchor it is compared with. The nuclei-file format itself (StarryNite/AceTree) is documented only by the WormGUIDES loader source, not by a paper section, so the trace stops at code rather than at a publication. Evidence: 2015-santella-wormguides-celegans.py L1–L22: the four layers and what is decoded <https://github.com/fractastical/morpholib/blob/2864784/2015-santella-wormguides-celegans.py#L1-L22>; 2015-santella-wormguides-celegans.py L107–L117: LIT constants and the Sulston grammar <https://github.com/fractastical/morpholib/blob/2864784/2015-santella-wormguides-celegans.py#L107-L117>; 2015-santella-wormguides-celegans.py L258–L267: movie_offset(): the ProductionInfo field read <https://github.com/fractastical/morpholib/blob/2864784/2015-santella-wormguides-celegans.py#L258-L267>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-code-traceability> ;
        pk:hasProbability "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-code-traceability> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome (2015-santella-wormguides-celegans.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub1:provenance {
    <https://doi.org/10.1016/0012-1606(83)90201-4> dcterms:date "1983"^^xsd:gYear ;
        dcterms:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .

    <https://doi.org/10.1038/s41586-019-1352-7> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .

    <https://doi.org/10.1083/jcb.144.5.927> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .

    <https://doi.org/10.1098/rstb.2017.0382> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .

    <https://doi.org/10.1186/s12859-015-0627-8> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .


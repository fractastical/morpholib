sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law + (Pass 3) Rall passive-cable electrotonics coupled to a Morris-Lecar dendritic Ca2+ spike hotspot — Code-to-model traceability: 95/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-73) maps every governing equation — greedy cost, 2D/3D scaling, Rall 3/2, lambda_DC and the Koch AC reduction, the Morris-Lecar ODEs — to its paper and to the five Lean 4 theorems by name, and each Pass 3 function carries a docstring naming the equation it implements and the ablation it exposes (L352-368, L425-461). The math-KG YAML registers equations 1-5 with single-range `code_locus` pins re-pointed to the shifted lines, and every measurement `source` names the theorem it leans on. Deductions: the JSON `linear_superposition_note` (L62) attributes exact superposition to \"Lean 4 Theorem 5\" whereas the script and the Lean file number it Theorem 4 (`rall_passive_membrane_linear_superposition`) and Theorem 5 is the length-constant bound (-2); the docstring Lean line pins for Theorems 1-3 (L36-67, L85-113, L127-147) are approximate against the 216-line module (theorem heads at L38, L90, L136) and Theorems 4-5 carry no line pin (-2); `evaluate_cuntz_pareto_sweep` cites no figure for the benchmark arrays it compares against (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "datasets/cajal_dendritic_wiring/electrotonic_ca_spike_reference.json L62–L62: linear_superposition_note cites 'Lean 4 Theorem 5' for the superposition result that the script and Lean module number Theorem 4 <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/cajal_dendritic_wiring/electrotonic_ca_spike_reference.json#L62-L62>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-code-traceability-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L1–L73" ;
        dct:description "Module docstring: equation-to-paper traceability for Cuntz, Wen-Chklovskii, Rall DC/AC cable, Roth & Häusser constants, Morris-Lecar ODEs and the 5 Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L1-L73> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L315–L337" ;
        dct:description "Section 2b banner explaining the reduced coupled model, the exp(-X) attenuation and the linear-null design before the code" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L315-L337> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/caleo-cajal-dendritic-wiring.yaml L50–L130" ;
        dct:description "Five equations with single-range code_locus pins (#L165-L207, #L208-L237, #L238-L280, #L425-L463, #L352-L390) and Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/math_kg_loops/caleo-cajal-dendritic-wiring.yaml#L50-L130> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 058 Pass 3 Assessor, Phase B)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


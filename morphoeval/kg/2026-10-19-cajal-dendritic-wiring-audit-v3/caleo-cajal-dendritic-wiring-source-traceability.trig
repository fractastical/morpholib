sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law + (Pass 3) Rall passive-cable electrotonics coupled to a Morris-Lecar dendritic Ca2+ spike hotspot — Source and data traceability: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The six v2 sources keep their verified DOIs in the docstring, README and BibTeX; the reference JSON, the specimen JPEG and the new `electrotonic_ca_spike_reference.json` are all SHA-256-pinned and verified fail-closed at runtime (`verify_dataset_integrity` L117-142, `load_electrotonic_reference` L340-349, constants L99-100 and L337). Pass 3 adds five BibTeX entries (bib L66-120) and a README addendum (README L22-38) with the model-reduction and the offline-transcription caveat stated plainly. Deductions: the five new DOIs and the Roth & Häusser (2001) passive constants were transcribed from memory and are flagged \"NOT re-verified online\" (JSON L8; README L32), so the Purkinje R_m / R_i / C_m that set every electrotonic length rest on assertion (-4); the Cuntz Pareto benchmark arrays (`balancing_factor_pareto_benchmarks`, reference JSON L45-49: W/W0 1.0 ... 11.50, P/P1 1.68 ... 1.0, angles) carry no figure/panel/digitisation provenance although the headline Pearson r = 1.0000 is computed against them (L740-749) (-3); the specimen *_ref values are self-generated (see specimen-match) and are not labelled as such in the JSON (-1); Koch (1999) Eq. 2.37 and the Rinzel & Ermentrout (1998) Hopf set are cited without page pinpoints (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/cajal_dendritic_wiring/cajal_dendritic_wiring_reference.json L45–L49: balancing_factor_pareto_benchmarks arrays with no figure/panel/digitisation provenance; W/W0 ref ends in the 11.50 outlier that dominates r = 1.0000 <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/cajal_dendritic_wiring/cajal_dendritic_wiring_reference.json#L45-L49>",
            "datasets/cajal_dendritic_wiring/electrotonic_ca_spike_reference.json L6–L8: passive_cable_constants.note: Roth & Häusser (2001) R_m/R_i/C_m transcribed from memory and NOT re-verified online <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/cajal_dendritic_wiring/electrotonic_ca_spike_reference.json#L6-L8>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-source-traceability-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L117–L142" ;
        dct:description "Runtime SHA-256 checksum verification of the reference JSON and the Cajal Purkinje specimen JPEG (fail-closed)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L117-L142> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L337–L349" ;
        dct:description "EXPECTED_ELECTROTONIC_SHA256 pin and load_electrotonic_reference() fail-closed check of the Pass 3 table" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L337-L349> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/cajal_dendritic_wiring/paper_citations.bib L66–L120" ;
        dct:description "5 Pass 3 BibTeX entries (roth2001, morris1981, llinas1980, polsky2004, koch1999) with DOIs transcribed offline" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/cajal_dendritic_wiring/paper_citations.bib#L66-L120> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/cajal_dendritic_wiring/README.md L20–L38" ;
        dct:description "Pass 3 addendum: new table SHA-256, model reduction stated, 'DOIs not re-verified online in this offline pass' caveat; specimen SHA-256 typo from Pass 2 corrected" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/cajal_dendritic_wiring/README.md#L20-L38> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 058 Pass 3 Assessor, Phase B)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law + (Pass 3) Rall passive-cable electrotonics coupled to a Morris-Lecar dendritic Ca2+ spike hotspot — Parameter expressivity: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Sweeps 8 balancing factors bf in [0.0, 1.0] (L716-769) and N in [25, 320] in 2D, 3D and star regimes (L770-828) as in v2; Pass 3 adds the inter-input delay sweep dt in [0, 30] ms (13 points) and runs the whole coincidence protocol across all 8 bf trees (`evaluate_coincidence_across_bf`, L579-604), so the new mechanism is parameter-controlled by bf and its tuning curves are rendered per bf (figure Panel C). The `--bf` CLI flag, dead in v2, is now honoured for Panel A, Panel E and the GIF (L962-965) together with `--n-carriers`, `--radius` and `--seed` (L1459-1464). Deductions: `measure_morphoeval()` (L1163-1174) takes no arguments and always uses the default N/seed/radius, so the measurements reported after a CLI override describe the default run, not the rendered one (-3); the Pareto-panel star marker (L1141) and the coincidence figure (L615-616) still fix bf = 0.20 / sweep index 2 regardless of `--bf` (-2); none of the Pass 3 physiological parameters (I_peak, tau_syn, g_Ca, R_m) is exposed on the CLI or swept — only bf is (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2007-caleo-cajal-dendritic-wiring.py L1141–L1141: Pareto star marker hard-coded to sweep index 2 (bf = 0.20) regardless of --bf; same for the coincidence figure at L615-616 <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L1141-L1141>",
            "2007-caleo-cajal-dendritic-wiring.py L1163–L1174: measure_morphoeval() ignores CLI parameters: always default carriers/seed/radius <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L1163-L1174>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L579–L604" ;
        dct:description "Coincidence protocol evaluated across all 8 Cuntz bf trees; Pearson r of window vs bf" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L579-L604> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L957–L965" ;
        dct:description "render_outputs wires the coincidence figure and honours the --bf override for Panel A / E / GIF (dead flag in v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L957-L965> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L1459–L1464" ;
        dct:description "CLI parameter overrides for --bf, --n-carriers, --radius and --seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L1459-L1464> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 058 Pass 3 Assessor, Phase B)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


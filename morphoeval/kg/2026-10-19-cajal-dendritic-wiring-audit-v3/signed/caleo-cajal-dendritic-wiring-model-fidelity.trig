sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law + (Pass 3) Rall passive-cable electrotonics coupled to a Morris-Lecar dendritic Ca2+ spike hotspot — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The Cuntz (2007, 2010) greedy MST solver with bottom-up Rall (1959) 3/2 diameter accumulation (`grow_cuntz_dendritic_tree`, L165-281), the random spanning-tree ablation (L282-313), the 8-point bf Pareto sweep (L716-769) and the 2D/3D Wen-Chklovskii scaling regressions (L770-828) are unchanged from v2 and remain faithful. Pass 3 adds a genuinely coupled passive/active model: the Rall DC length constant and Koch (1999) Eq. 2.37 AC reduction (`rall_length_constant_um`, L352-368) are the textbook formulas, every edge receives X_e = l_e / lambda_f(d_e) from the Rall diameters (`compute_tree_electrotonics`, L371-388), and the Morris-Lecar equations (L425-461) are correctly transcribed with the two ablation switches that isolate the regenerative g_Ca term. Deductions: the hotspot is a single isopotential compartment with the canonical barnacle Hopf parameter set (C = 20 uF/cm2, V1-V4, phi) rather than Purkinje P-type Ca2+ kinetics, so the 4.28x gain and the 5.24 ms window are properties of a generic excitable membrane placed at the LCA, not of a Purkinje dendrite (-3); attenuation uses the semi-infinite exp(-X) factor (L483-484), which is only exact for Rall-matched cylinders seen from the soma, whereas here it is applied centripetally from tips toward a branch node (-2); the scaling-law sweep runs at bf = 0.15 (L791, L801) while every other panel uses the Purkinje regime bf = 0.20 (-1). Five Lean 4 theorems (0 sorrys) back the greedy cost trade-off, the 3/2 law, tree topology, exact passive superposition and lambda_f <= lambda_DC." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2007-caleo-cajal-dendritic-wiring.py L425–L461: Vectorised forward-Euler Morris-Lecar Ca2+/K+ hotspot with g_ca_scale = 0 and freeze_w ablations; parameters are the canonical barnacle Hopf set, not a Purkinje P-type fit <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L425-L461>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L165–L313" ;
        dcterms:description "Greedy MST C(u,v) = d(u,v) + bf*path(u,root) solver with Rall 3/2 diameter accumulation and the random spanning tree ablation control (unchanged from v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L165-L313> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L352–L388" ;
        dcterms:description "Rall DC length constant sqrt(R_m d / 4 R_i), Koch (1999) Eq. 2.37 AC reduction, and per-edge electrotonic length X_e = l_e / lambda_f(d_e) on every Rall-3/2 edge" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L352-L388> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L464–L576" ;
        dcterms:description "Coincidence protocol: exp(-X) attenuation of two alpha inputs to the LCA hotspot (L483-484), 13-point delay sweep, spike matrix, window, supralinear gain and passive superposition ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L464-L576> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_058_cajal_dendritic_wiring.lean L38–L214" ;
        dcterms:description "5 machine-checked theorems (0 sorrys): Cuntz cost trade-off, Rall 3/2 identity, binary-tree topology, exact linear-RC superposition (L170-182) and lambda_f^2 <= lambda_DC^2 (L200-214)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/morphoeval/lean/loops/Loop_058_cajal_dendritic_wiring.lean#L38-L214> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 058 Pass 3 Assessor, Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


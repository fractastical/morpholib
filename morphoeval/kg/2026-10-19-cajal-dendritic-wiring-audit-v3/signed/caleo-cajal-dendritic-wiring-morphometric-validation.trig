        schema:measurementTechnique "8-point balancing factor sweep in [0.0, 1.0] on N=160 carriers vs Cuntz et al. (2010) reference (RMSE = 0.0042, p = 1.81e-19)" ;
        schema:name "Cuntz balancing factor sweep normalized wiring cost W(bf)/W(0) correlation" ;
        schema:unitText "Pearson r" ;

        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-wiring-cost-w-bf-w-0-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-wiring-cost-w-bf-w-0-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-dendritic-ca2-spike-coincidence-window-delta-t-c-at-bf-0-20-purkinje-regime> a schema:PropertyValue,

        dcterms:description "supralinear gain 4.28x > 2.0 (linear reference, Lean 4 Theorem 4) arises from the regenerative g_Ca term only: the g_Ca = 0 ablation collapses to 2.052x; the reference value is the linear null, not an empirical gain" ;
        schema:measurementTechnique "Mean over 21 nearest-neighbour tip pairs of (V_pair,dt=0 - E_L)/(V_single - E_L) at the LCA hotspot; g_Ca = 0 (K+ still active) ablation gain = 2.0517; single-input spike fraction across all bf = 0.000" ;
        schema:name "Active Morris-Lecar Ca2+ hotspot supralinear paired/single peak gain at bf = 0.20" ;
        schema:unitText "peak-depolarization gain (linear = 2.0)" ;
        schema:value "4.2783" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-active-morris-lecar-ca2-hotspot-supralinear-paired-single-peak-gain-at-bf-0-20-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-active-morris-lecar-ca2-hotspot-supralinear-paired-single-peak-gain-at-bf-0-20-reference> a schema:PropertyValue ;
        schema:value "2.0" .


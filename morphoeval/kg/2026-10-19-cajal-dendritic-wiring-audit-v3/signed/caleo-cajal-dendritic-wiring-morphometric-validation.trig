    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-coincidence-window-vs-cuntz-balancing-factor-pearson-correlation-across-bf-in-0-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Coincidence window vs Cuntz balancing factor Pearson correlation across bf in [0, 1] = -0.6983 Pearson r" ;
        dcterms:description "negative sign: Cajal's minimum-wiring branched topologies (low bf) preserve shared sub-branch hotspots and widen the coincidence window; the minimum-delay star (bf = 1) destroys them. Reference is the predicted sign (-1), not an empirical r" ;
        schema:measurementTechnique "8-point bf sweep of the mean coincidence window (p = 0.054); windows (ms): 5.13, 5.25, 5.24, 4.57, 4.58, 4.17, 5.00, 0.73; mean tip->hotspot electrotonic distance rises from 0.162 (bf = 0) to 0.403 (bf = 1)" ;
        schema:name "Coincidence window vs Cuntz balancing factor Pearson correlation across bf in [0, 1]" ;
        schema:unitText "Pearson r" ;
        schema:value "-0.6983" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-coincidence-window-vs-cuntz-balancing-factor-pearson-correlation-across-bf-in-0-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-coincidence-window-vs-cuntz-balancing-factor-pearson-correlation-across-bf-in-0-1-reference> a schema:PropertyValue ;
        schema:value "-1.0" .


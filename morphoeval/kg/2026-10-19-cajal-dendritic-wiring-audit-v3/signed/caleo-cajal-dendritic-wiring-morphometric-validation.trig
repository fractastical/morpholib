    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-purkinje-class-iv-regime-bf-0-20-normalized-wiring-cost-w-w-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Purkinje / Class IV regime (bf = 0.20) normalized wiring cost W/W(0) = 1.0189 W(0.2) / W(0)" ;
        dcterms:description "achieves 98.1% wiring optimality while cutting conduction delay from 1.685x to 1.407x; random ablation is 10.43x longer" ;
        schema:measurementTechnique "Greedy MST at bf=0.20 vs random spanning tree ablation control (random W/W_0.2 = 10.4340x, Betti-1 = 0)" ;
        schema:name "Purkinje / Class IV regime (bf = 0.20) normalized wiring cost W/W(0)" ;
        schema:unitText "W(0.2) / W(0)" ;
        schema:value "1.0189" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-purkinje-class-iv-regime-bf-0-20-normalized-wiring-cost-w-w-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-purkinje-class-iv-regime-bf-0-20-normalized-wiring-cost-w-w-0-reference> a schema:PropertyValue ;
        schema:value "1.022" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-passive-cable-ac-dc-length-constant-ratio-lambda-f-lambda-dc-at-the-synaptic-frequency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rall passive cable AC/DC length-constant ratio lambda_f / lambda_DC at the synaptic frequency = 0.2487 dimensionless ratio" ;
        dcterms:description "lambda_f <= lambda_DC (Lean 4 Theorem 5); mean tip-to-soma electrotonic distance X = 0.3350 at bf = 0.20 (reference value is the hand-computed analytic check in electrotonic_ca_spike_reference.json)" ;
        schema:measurementTechnique "lambda_DC = sqrt(R_m d / 4 R_i) = 1151.6 um for d = 0.5 um (R_m = 122000 Ohm cm2, R_i = 115 Ohm cm); lambda_f = 286.4 um at f_syn = 1/(2 pi tau_syn) = 53.1 Hz (tau_m = 93.9 ms)" ;
        schema:name "Rall passive cable AC/DC length-constant ratio lambda_f / lambda_DC at the synaptic frequency" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.2487" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-passive-cable-ac-dc-length-constant-ratio-lambda-f-lambda-dc-at-the-synaptic-frequency-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-passive-cable-ac-dc-length-constant-ratio-lambda-f-lambda-dc-at-the-synaptic-frequency-reference> a schema:PropertyValue ;
        schema:value "0.2487" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-s-3-2-electrotonic-impedance-matching-ratio-sum-d-daughter-3-2-d-parent-3-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rall's 3/2 electrotonic impedance-matching ratio (sum d_daughter^(3/2)) / d_parent^(3/2) = 1.0 conductance ratio" ;
        dcterms:description "exact electrotonic cylinder impedance matching across all 40 bifurcations (RMSE = 1.27e-16)" ;
        schema:measurementTechnique "Bottom-up Rall 3/2 diameter accumulation across N_bif = 40 bifurcations (RMSE = 1.27e-16, symmetric d_p/d_d = 1.5874)" ;
        schema:name "Rall's 3/2 electrotonic impedance-matching ratio (sum d_daughter^(3/2)) / d_parent^(3/2)" ;
        schema:unitText "conductance ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-s-3-2-electrotonic-impedance-matching-ratio-sum-d-daughter-3-2-d-parent-3-2-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-s-3-2-electrotonic-impedance-matching-ratio-sum-d-daughter-3-2-d-parent-3-2-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-same-branch-shared-lca-hotspot-fraction-of-nearest-neighbour-tip-pairs-in-the-bf-1-radial-star-limit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Same-branch (shared LCA hotspot) fraction of nearest-neighbour tip pairs in the bf = 1 radial-star limit = 0.0 fraction" ;
        dcterms:description "at bf = 1 every carrier attaches directly to the soma (Lean 4 Theorem 1, third clause) so every tip pair is a between-branch pair and the only coincidence site is the soma" ;
        schema:measurementTechnique "Fraction of 24 nearest-neighbour tip pairs whose lowest common ancestor is not the soma root at bf = 1.0 (bf = 0.20 value: 1.000)" ;
        schema:name "Same-branch (shared LCA hotspot) fraction of nearest-neighbour tip pairs in the bf = 1 radial-star limit" ;

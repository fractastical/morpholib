sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L833–L934" ;
        dcterms:description "Golgi arbor segmentation, EDT soma localization, 26-ring Sholl analysis, Laplacian ridge bifurcation hub extraction and 7-scale box-counting fractal dimension on the SHA-256-pinned specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L833-L934> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L607–L711" ;
        dcterms:description "Pass 3 4-panel coincidence figure: electrotonic tree + tip pairs + LCA hotspots, hotspot traces with ablations, tuning curves per bf, window/same-branch/gain vs bf — model-only, no empirical dendritic-spike specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L607-L711> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/cajal_dendritic_wiring_comparison.png (generated output)" ;
        dcterms:description "6-panel comparison figure aligning Purkinje (bf=0.20) and motoneuron (bf=0.70) arbors, Pareto curves, 2D/3D scaling laws, Sholl profile and Cajal (1899) Purkinje CV segmentation (regenerated in Pass 3) — docs/media/cajal_dendritic_wiring_comparison.png: rendered output of 2007-caleo-cajal-dendritic-wiring.py at 45670cb8, image/png, 1031857 B, 2475×1560 px, artifact_sha256 d8a5eea145746b4df580c95c55b83255c17ede5c82986441d0dadf63208aca34 (sha256 d8a5eea145746b4df580c95c55b83255c17ede5c82986441d0dadf63208aca34), spec_fingerprint a6977d117c117453a3da70243bb87c40c9868192a748b42afa7ab4730c025791" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law + (Pass 3) Rall passive-cable electrotonics coupled to a Morris-Lecar dendritic Ca2+ spike hotspot — Morphological realism / specimen match: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The vendored, SHA-256-verified Cajal (1899) Purkinje drawing is segmented as in v2 (`segment_cajal_purkinje_specimen`, L833-934: arbor mask, EDT soma, 26-ring Sholl curve with peak 73 at r/R_max = 0.6176, 62 bifurcation hubs, D_f = 1.7817 +- 0.0248) and the 6-panel comparison figure aligns the bf = 0.20 and bf = 0.70 model arbors with the specimen. Pass 3 adds the 4-panel coincidence figure whose Panel A renders the electrotonic tree with tip pairs and LCA hotspots. Deductions, larger than in v2 because the Pass 3 audit looked at where the specimen numbers come from: the specimen reference values the figure and measurements are \"matched\" against (`specimen_metadata.sholl_peak_intersections_ref` = 73, `skeleton_branch_points_ref` = 62, `box_counting_fractal_dimension_ref` = 1.7817; reference JSON L98-102) are the script's own Pass 2 outputs written back into the dataset, so value == reference by construction and the self-test (L1388-1389) merely pins a regression (-5); the new Ca2+ hotspot layer is compared with no specimen at all — no Llinás & Sugimori (1980) dendritic spike trace, no Polsky (2004) summation curve — so the coincidence figure is model-only (-3); the model-arbor-vs-specimen comparison still rests on Sholl shape and D_f alone, with no branch-angle or segment-length histogram against the drawing (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2007-caleo-cajal-dendritic-wiring.py L1386–L1390: Self-test suite 7 hard-codes sholl_peak_count == 73 and n_branch_points == 62 (regression pin, not an empirical check) <https://github.com/fractastical/morpholib/blob/45670cb8/2007-caleo-cajal-dendritic-wiring.py#L1386-L1390>",
            "datasets/cajal_dendritic_wiring/cajal_dendritic_wiring_reference.json L88–L102: specimen_metadata *_ref values (73, 420.0, 0.6176, 62, 1.7817) are the script's own Pass 2 outputs recorded as references — match by construction, not an independent morphometric <https://github.com/fractastical/morpholib/blob/45670cb8/datasets/cajal_dendritic_wiring/cajal_dendritic_wiring_reference.json#L88-L102>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 058 Pass 3 Assessor, Phase B)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) — Model fidelity to source: 62/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "E1-E3 are implemented exactly as Thompson states them (k = sin(beta) cot(alpha), R = e^(2 pi sin beta cot alpha), p. 558) and the gnomonic tube (E4) is rendered; the Lean module proves the whorl-ratio invariance, breadth law, projection non-identifiability and growth-velocity lemmas with 0 sorry. Deductions: the fit is done to a 2D projection with beta = 90 deg assumed when converting k to alpha, so the quantity compared to Thompson's 75 deg is alpha_proj, not alpha; E4 (breadth shares k) is formalised but not measured; E5 (velocity ratio) is only a rendering, not a fitted quantity." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L444–L473: verdict_from compares alpha_proj (beta = 90 assumed) directly with Thompson's 75 deg <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L444-L473>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-2> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L70–L117" ;
        dcterms:description "log_spiral, k_from_alpha, whorl_ratio, helico_spiral, horn_surface implement E1-E4 verbatim" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L70-L117> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_031.lean L32–L101" ;
        dcterms:description "whorl_ratio_invariant, lag_ratio_independent_of_position, breadth_shares_whorl_ratio, alpha_beta_not_identifiable_from_projection; lean exit 0, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b0060c02/morphoeval/lean/loops/Thompson1917_T1917_031.lean#L32-L101> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


            <https://doi.org/10.1186/s12915-021-00990-w>,
            <https://doi.org/10.5061/dryad.qz612jmb4> .

    <https://archive.org/details/ongrowthform1917thom> dcterms:date "1917"^^xsd:gYear ;
        dcterms:title "On Growth and Form — Ch. XIII, The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion" .

    <https://doi.org/10.1007/s002850050081> dcterms:date "1997"^^xsd:gYear ;
        dcterms:title "Kinematics of surface growth" .

    <https://doi.org/10.1186/s12915-021-00990-w> dcterms:date "2021"^^xsd:gYear ;
        dcterms:title "A universal power law for modelling the growth and form of teeth, claws, horns, thorns, beaks, and shells" .

    <https://doi.org/10.5061/dryad.qz612jmb4> dcterms:date "2020"^^xsd:gYear ;
        dcterms:title "Data from: Variation in the ontogenetic allometry of horn length in bovids along a body mass continuum" .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-repro-package> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) — Reproducibility package: 60/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Deterministic (seed 1917 used only in the self-test synthetic controls; the fit itself is deterministic), --self-test passes in ~1.3 s, full run ~3 s, inputs SHA-verified at runtime, outputs written to documented paths, invocation documented. Deductions: dependency versions are not pinned per script (requirements.txt lower bounds only), the checkpoint commit does not include the v1.0.1 list-API change, and skimage emits deprecation warnings that will break on 0.28." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L147–L158: skimage.morphology.closing used; binary_* deprecations avoided but no version pin <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L147-L158>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-repro-package-1> ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L475–L540" ;
        dcterms:description "self_test: E3 identities, positive control recovers alpha = 75 within 1 deg, circle null classified as circle, inputs verified" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L475-L540> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


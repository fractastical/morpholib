    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) — Code-to-model traceability: 70/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The module docstring maps E1-E5 to Thompson's pages; each model function cites its equation id; reference.json carries the thompson_locus for each equation; the Lean file cites pages and equation ids. Deductions: the figure-digitisation steps (sector choice, farthest-point rule) are documented in reference.json but not tied to any Thompson procedure (he measured whorl breadth ratios, Ch. XI p. 558), and verdict thresholds are asserted in reference.json without derivation." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;

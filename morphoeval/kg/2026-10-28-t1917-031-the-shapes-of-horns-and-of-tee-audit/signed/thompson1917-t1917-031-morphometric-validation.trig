sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) — Morphometric validation: 48/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Quantitative: alpha_proj, R, Pearson r, RMSE and two delta-AIC values are computed on the digitised figure and compared with Thompson's published 75 deg and with explicit null models; measure_morphoeval returns 6 rows with reference values. Missing: no uncertainty (bootstrap CI, KS test), no breadth / inner-edge gnomonic test (E4), n = 1 drawing, no real specimen, and the registry Dryad table is pinned but not even summarised." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-031/t1917_031_metrics.json (generated output, not in repo): no CI / KS / bootstrap fields in Pass 1 — datasets/thompson_1917/t1917-031/t1917_031_metrics.json: rendered output of thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py at b0060c02, application/json, 5953 B, artifact_sha256 0fd36968bffa49b2806ccffd96bc4dd34d039dc680bcdec54c6ffd4ff6092385 (sha256 0fd36968bffa49b2806ccffd96bc4dd34d039dc680bcdec54c6ffd4ff6092385), spec_fingerprint 78b39928d6410ad23f00651145d4b7faa4e8de550bae97e1a0f3272bacd16b08" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-delta-aic-archimedean-minus-log-spiral>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-delta-aic-circle-minus-log-spiral>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-log-spiral-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-pearson-r-of-ln-rho-vs-theta>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-projected-spiral-angle-alpha-proj>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-whorl-ratio-r-exp-2-pi-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-morphometric-validation-2> ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-delta-aic-archimedean-minus-log-spiral> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fig320 delta AIC Archimedean minus log-spiral = 12.0 AIC" ;
        schema:measurementTechnique "alternative-model comparison vs an Archimedean (arithmetic) spiral" ;
        schema:name "fig320 delta AIC Archimedean minus log-spiral" ;
        schema:unitText "AIC" ;
        schema:value "12.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-delta-aic-archimedean-minus-log-spiral-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-delta-aic-archimedean-minus-log-spiral-reference> a schema:PropertyValue ;
        schema:value "10.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-delta-aic-circle-minus-log-spiral> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fig320 delta AIC circle minus log-spiral = 246.1 AIC" ;
        schema:measurementTechnique "alternative-model comparison vs the circle null (no gnomonic growth); >= 10 counts as decisive" ;
        schema:name "fig320 delta AIC circle minus log-spiral" ;
        schema:unitText "AIC" ;
        schema:value "246.1" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-delta-aic-circle-minus-log-spiral-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-delta-aic-circle-minus-log-spiral-reference> a schema:PropertyValue ;
        schema:value "10.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-log-spiral-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fig320 log-spiral RMSE = 16.71 px" ;
        schema:measurementTechnique "radial RMSE of the fit over 550 edge points (278 deg sweep); relative RMSE 0.046" ;
        schema:name "fig320 log-spiral RMSE" ;
        schema:unitText "px" ;
        schema:value "16.71" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-pearson-r-of-ln-rho-vs-theta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fig320 Pearson r of ln(rho) vs theta = 0.9097 r" ;
        schema:measurementTechnique "linearity of ln(rho) in growth angle; 1.0 = exact log spiral" ;
        schema:name "fig320 Pearson r of ln(rho) vs theta" ;
        schema:unitText "r" ;
        schema:value "0.9097" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-pearson-r-of-ln-rho-vs-theta-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-pearson-r-of-ln-rho-vs-theta-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-projected-spiral-angle-alpha-proj> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fig320 projected spiral angle alpha_proj = 85.91 deg" ;
        schema:measurementTechnique "free-pole nonlinear least-squares log-spiral fit to the digitised outer horn edge of Thompson (1917) Fig. 320; alpha = atan(1/|k|)" ;
        schema:name "fig320 projected spiral angle alpha_proj" ;
        schema:unitText "deg" ;
        schema:value "85.91" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-projected-spiral-angle-alpha-proj-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-projected-spiral-angle-alpha-proj-reference> a schema:PropertyValue ;
        dcterms:source "Thompson (1917) p. 617: Ovis ammon about 75 deg" ;
        schema:value "75.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-whorl-ratio-r-exp-2-pi-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fig320 whorl ratio R = exp(2 pi |k|) = 1.567 ratio" ;
        schema:measurementTechnique "E3 from the fitted pitch; baseline R = 1 is the circle null" ;
        schema:name "fig320 whorl ratio R = exp(2 pi |k|)" ;
        schema:unitText "ratio" ;
        schema:value "1.567" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-whorl-ratio-r-exp-2-pi-k-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-measurement-fig320-whorl-ratio-r-exp-2-pi-k-reference> a schema:PropertyValue ;
        dcterms:source "E3 with Thompson's alpha = 75 deg, beta = 90 deg" ;
        schema:value "5.385" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L275–L284" ;
        dcterms:description "model_comparison: AIC of log spiral vs Archimedean vs circle" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L275-L284> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L341–L364" ;
        dcterms:description "measure_morphoeval rows with reference_value = 75 deg and R = 5.4" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L341-L364> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


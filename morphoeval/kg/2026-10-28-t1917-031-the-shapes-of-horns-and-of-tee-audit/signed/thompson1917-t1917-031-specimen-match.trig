sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-specimen-match> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_031_the_shapes_of_horns_and_of_tee_comparison.png (generated output)" ;
        dcterms:description "Fig. 320 + fitted spiral, ln rho vs theta, AIC bars, E2 helicoid, alpha sweep — docs/media/t1917_031_the_shapes_of_horns_and_of_tee_comparison.png: rendered output of thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py at b0060c02, image/png, 406769 B, 1760×990 px, artifact_sha256 32b7ee29bfb996ac84fc260284bb464cd4bdc241cdc4cdb4728b0db4b6aca763 (sha256 32b7ee29bfb996ac84fc260284bb464cd4bdc241cdc4cdb4728b0db4b6aca763), spec_fingerprint 78b39928d6410ad23f00651145d4b7faa4e8de550bae97e1a0f3272bacd16b08" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) — Morphological realism / specimen match: 35/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The rendered comparison overlays the fitted spiral on Thompson's own figure and the overlay follows the dorsal and posterior edge closely, but (i) no real specimen is used in Pass 1 — the CC BY-SA Argali photograph is vendored and pinned but not analysed; (ii) the ventral end of the digitised edge includes the mandible junction (ln rho rises at the last 15 deg); (iii) the 3D helicoid panel uses beta = 60 deg chosen by hand, not fitted; (iv) only one species is shown, so the \"distinct morphologies distinct\" test is not exercised." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L172–L189: outer_edge_points uses the fixed sector from reference.json; mandible contamination at the -125 deg end is not trimmed <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L172-L189>",
            "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L291–L311: analyse_specimen raises NotImplementedError for photo_hsv / figure_halftone: real specimen and Capra figure skipped <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L291-L311>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-specimen-match-1> ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
}


    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> a pk:Claim ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) faithfully reproduces Ovis ammon (Argali); Thompson's Fig. 320 lateral drawing morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py implement the cited source model as published and produce forms that match real Ovis ammon (Argali); Thompson's Fig. 320 lateral drawing specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py; output: docs/media/t1917_031_the_shapes_of_horns_and_of_tee_comparison.png; organism: Ovis ammon (Argali); Thompson's Fig. 320 lateral drawing; environment: n/a; claim_boundary: [reported_in_source: Ovis ammon spiral angle about 75 deg; Highland ram a little more; Scinde wild goat < 70 deg; Oryx 20-40 deg (p. 617) | Argali species share alpha but differ in the cone/helical component beta (pp. 617-618) | trihedral edge lengths 80:74:45 cm (p. 618); St Venant torsion curves on the rings (pp. 621-624); reconstructed_in_script: E1 free-pole log-spiral fit of the outer edge of Fig. 320; AIC vs Archimedean spiral and circle | E2/E3 helico-spiral rendering and whorl-ratio table; gnomonic growth animation; transfer_boundary: a lateral 2D projection measures k_proj = sin(beta) cot(alpha), not alpha itself; does_not_claim: torsion / St Venant warping; inter-species beta differences; anything about teeth or tusks]; other sources: On Growth and Form — Ch. XIII, The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion <https://archive.org/details/ongrowthform1917thom>; phenomenon_size: 948 µm (0.000948 m, log10=-3.023 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 948 µm to 2.89 m): 948 µm:ovis-aries-bioelectric-polarity, 3.5 mm:ovis-aries-vertex-packing, 6.4 cm:ovis-aries-turing-wavelength, 12.0 cm:ovis-aries-clock-wavefront, 19.4 cm:ovis-aries-morphogen-condensation, 28.4 cm:ovis-aries-elastic-buckling, 48.0 cm:ovis-aries-flux-canalization, 63.5 cm:ovis-aries-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/s002850050081>,
            <https://doi.org/10.1186/s12915-021-00990-w>,
            <https://doi.org/10.5061/dryad.qz612jmb4> .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/s002850050081>,
            <https://doi.org/10.1186/s12915-021-00990-w>,
            <https://doi.org/10.5061/dryad.qz612jmb4> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form — Ch. XIII, The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion" .
    <https://doi.org/10.1007/s002850050081> dct:date "1997"^^xsd:gYear ;
        dct:title "Kinematics of surface growth" .
    <https://doi.org/10.1186/s12915-021-00990-w> dct:date "2021"^^xsd:gYear ;
        dct:title "A universal power law for modelling the growth and form of teeth, claws, horns, thorns, beaks, and shells" .
    <https://doi.org/10.5061/dryad.qz612jmb4> dct:date "2020"^^xsd:gYear ;
        dct:title "Data from: Variation in the ontogenetic allometry of horn length in bovids along a body mass continuum" .
}


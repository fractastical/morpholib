        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) — Parameter expressivity: 45/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The alpha sweep panel (65-85 deg) and the model_regime_table (alpha x beta -> k, R) show the monotone effect of both parameters, and the self-test checks R(90) = 1 and that an acute cone shrinks R. But nothing is swept against the data: no beta sweep is rendered, no breadth ratio or handedness control, and no CLI parameters." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L395–L404: alpha sweep panel only; beta and breadth not rendered <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L395-L404>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-parameter-expressivity-1> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L322–L339" ;
        dct:description "model_regime_table alpha in {60..85} x beta in {30,60,90}" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L322-L339> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/s002850050081>,
            <https://doi.org/10.1186/s12915-021-00990-w>,
            <https://doi.org/10.5061/dryad.qz612jmb4> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form — Ch. XIII, The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion" .
    <https://doi.org/10.1007/s002850050081> dct:date "1997"^^xsd:gYear ;
        dct:title "Kinematics of surface growth" .
    <https://doi.org/10.1186/s12915-021-00990-w> dct:date "2021"^^xsd:gYear ;
        dct:title "A universal power law for modelling the growth and form of teeth, claws, horns, thorns, beaks, and shells" .
    <https://doi.org/10.5061/dryad.qz612jmb4> dct:date "2020"^^xsd:gYear ;
        dct:title "Data from: Variation in the ontogenetic allometry of horn length in bovids along a body mass continuum" .
}


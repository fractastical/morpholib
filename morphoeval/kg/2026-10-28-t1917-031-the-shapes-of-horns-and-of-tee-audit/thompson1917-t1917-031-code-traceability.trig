sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) — Code-to-model traceability: 70/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The module docstring maps E1-E5 to Thompson's pages; each model function cites its equation id; reference.json carries the thompson_locus for each equation; the Lean file cites pages and equation ids. Deductions: the figure-digitisation steps (sector choice, farthest-point rule) are documented in reference.json but not tied to any Thompson procedure (he measured whorl breadth ratios, Ch. XI p. 558), and verdict thresholds are asserted in reference.json without derivation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-code-traceability-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L1–L52" ;
        dct:description "docstring: equations with page loci, test design, claim boundary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L1-L52> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-031.yaml (generated output)" ;
        dct:description "5 laws with lean_decl/lean_theorem/lean_locus/code_locus — morphoeval/math_kg_loops/thompson1917-t1917-031.yaml: rendered output of thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py at b0060c02, application/yaml, 7917 B, artifact_sha256 e06d2058aaf605d5a8d157a8b97af5dbf3320a4c5bc512d53f5ea018ddfb3059 (sha256 e06d2058aaf605d5a8d157a8b97af5dbf3320a4c5bc512d53f5ea018ddfb3059), spec_fingerprint 78b39928d6410ad23f00651145d4b7faa4e8de550bae97e1a0f3272bacd16b08" .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;

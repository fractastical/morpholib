sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-031> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-031-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XIII — bovid horns as logarithmic spirals wound on a cone (Pass 1) — Reproducibility package: 60/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Deterministic (seed 1917 used only in the self-test synthetic controls; the fit itself is deterministic), --self-test passes in ~1.3 s, full run ~3 s, inputs SHA-verified at runtime, outputs written to documented paths, invocation documented. Deductions: dependency versions are not pinned per script (requirements.txt lower bounds only), the checkpoint commit does not include the v1.0.1 list-API change, and skimage emits deprecation warnings that will break on 0.28." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L147–L158: skimage.morphology.closing used; binary_* deprecations avoided but no version pin <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L147-L158>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-repro-package-1> ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-031-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py L475–L540" ;
        dct:description "self_test: E3 identities, positive control recovers alpha = 75 within 1 deg, circle null classified as circle, inputs verified" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b0060c02/thompson/claims/t1917-031_the-shapes-of-horns-and-of-teeth-or-tusks-with-a.py#L475-L540> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 1; second assessor pending)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/s002850050081>,
            <https://doi.org/10.1186/s12915-021-00990-w>,
            <https://doi.org/10.5061/dryad.qz612jmb4> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form — Ch. XIII, The Shapes of Horns, and of Teeth or Tusks: with a Note on Torsion" .
    <https://doi.org/10.1007/s002850050081> dct:date "1997"^^xsd:gYear ;
        dct:title "Kinematics of surface growth" .
    <https://doi.org/10.1186/s12915-021-00990-w> dct:date "2021"^^xsd:gYear ;
        dct:title "A universal power law for modelling the growth and form of teeth, claws, horns, thorns, beaks, and shells" .
    <https://doi.org/10.5061/dryad.qz612jmb4> dct:date "2020"^^xsd:gYear ;
        dct:title "Data from: Variation in the ontogenetic allometry of horn length in bovids along a body mass continuum" .
}


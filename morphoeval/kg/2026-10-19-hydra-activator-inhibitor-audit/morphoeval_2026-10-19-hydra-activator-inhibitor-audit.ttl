    pk:hasScore 4.4e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-repro-package> a pk:LLMClaimAssessment ;

<https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> a pk:Claim ;
    rdfs:label "Gierer & Meinhardt (1972) Hydra vulgaris activator-inhibitor morphogenesis (Freshwater cnidarian polyp (Hydra vulgaris) apical hypostome polarity & radial tentacle ring)",
        "Gierer & Meinhardt (1972) Hydra vulgaris activator-inhibitor morphogenesis faithfully reproduces Freshwater cnidarian polyp (Hydra vulgaris) apical hypostome polarity & radial tentacle ring morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/gierer-hydra-activator-inhibitor-1>,
        <https://w3id.org/probknow/resource/math-law/gierer-hydra-activator-inhibitor-2>,
        <https://w3id.org/probknow/resource/math-law/gierer-hydra-activator-inhibitor-3> ;
    dct:description "The simulation script(s) 1972-gierer-hydra-activator-inhibitor.py implement the cited source model as published and produce forms that match real Freshwater cnidarian polyp (Hydra vulgaris) apical hypostome polarity & radial tentacle ring specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 52.8/100, audit 2026-10-19-hydra-activator-inhibitor-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py> ;
    schema:about "Freshwater cnidarian polyp (Hydra vulgaris) apical hypostome polarity & radial tentacle ring" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py; output: docs/media/hydra_activator_inhibitor_comparison.png; organism: Freshwater cnidarian polyp (Hydra vulgaris) apical hypostome polarity & radial tentacle ring; checkpoint commit: https://github.com/fractastical/morpholib/commit/3cb5ea9; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: c9d51c7c93ac67b33d6bf4ce3308cc6670cda412367b820e85de0adf71aa9719; artifact_sha256: 72f7922212aac99cead5e633ce2a3c1e248bc5e079c62022fb0fd08286be4dbe; input_dataset_sha256: {datasets/hydra_activator_inhibitor/hydra_activator_inhibitor_reference.json=f9d8a0be5130d952..., datasets/hydra_activator_inhibitor/hydra_vulgaris_specimen.jpg=007d127bcfa8501d..., datasets/hydra_activator_inhibitor/paper_citations.bib=49b5c0a5531a00fe..., datasets/hydra_activator_inhibitor/scout_manifest.json=b57d0d923283daaf...}" ;
    pk:derivedFromPaper <https://doi.org/10.1006/dbio.1993.1138>,
        <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1242/jcs.15.2.321>,
        <https://doi.org/10.1387/ijdb.113483hm> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-hydra-activator-inhibitor-audit-gierer-hydra-activator-inhibitor-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-hydra-activator-inhibitor-audit-gierer-hydra-activator-inhibitor-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-hydra-activator-inhibitor-audit-gierer-hydra-activator-inhibitor-3> ;
    pk:hypothesisType "Reaction-Diffusion & Polarity (Gierer-Meinhardt Short-Range Activator / Long-Range Lateral Inhibitor PDE)" ;
    pk:weightOfEvidence 5.28e-01 .


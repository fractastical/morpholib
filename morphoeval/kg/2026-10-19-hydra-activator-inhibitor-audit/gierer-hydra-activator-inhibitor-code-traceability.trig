sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) Hydra vulgaris activator-inhibitor morphogenesis — Code-to-model traceability: 64/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Docstring cites Gierer & Meinhardt (1972) Eqs. (15a)-(15b), but lacks explicit mappings to Gierer & Meinhardt (1972) Fig. 2-3 (regeneration), Meinhardt (1993) (tentacle ring), and the 3 Lean 4 theorems in `Loop_001_hydra_activator_inhibitor.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L1–L18: Baseline module header without Lean 4 theorem or regeneration figure mappings <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L1-L18>" ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


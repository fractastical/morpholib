sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) Hydra vulgaris activator-inhibitor morphogenesis — Morphological realism / specimen match: 38/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Displays `datasets/hydra_activator_inhibitor/hydra_vulgaris_specimen.jpg` in Panel 3 (L164-168), but performs zero computer-vision segmentation of the translucent Hydra body column, apical hypostome, or the 6 radiating tentacles, and does not simulate the periodic 6-tentacle ring to match the specimen." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L164–L168: Raw imshow of Hydra specimen without segmentation or tentacle angular detection <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L164-L168>",
            "docs/media/hydra_activator_inhibitor_comparison.png (generated output, not in repo): 3-panel baseline figure showing raw specimen without morphometric overlay — docs/media/hydra_activator_inhibitor_comparison.png: rendered output of 1972-gierer-hydra-activator-inhibitor.py at 3cb5ea9, image/png, 484460 B, 1820×585 px, artifact_sha256 72f7922212aac99cead5e633ce2a3c1e248bc5e079c62022fb0fd08286be4dbe (sha256 72f7922212aac99cead5e633ce2a3c1e248bc5e079c62022fb0fd08286be4dbe), spec_fingerprint c9d51c7c93ac67b33d6bf4ce3308cc6670cda412367b820e85de0adf71aa9719" ;
        pk:hasScore "0.38"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) Hydra vulgaris activator-inhibitor morphogenesis — Parameter expressivity: 44/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates only a single parameter point (d = D_h/D_a = 30, N = 60) with no diffusivity-ratio sweep across d_c = 5.8284, no domain-length sweep L, and no CLI parameter overrides beyond `--self-test` (L227-237)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L227–L237: CLI exposes only --self-test without PDE parameter flags or regime sweeps <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L227-L237>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


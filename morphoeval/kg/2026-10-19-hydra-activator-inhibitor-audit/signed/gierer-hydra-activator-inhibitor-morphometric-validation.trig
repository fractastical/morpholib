        dcterms:title "A model for pattern formation of hypostome, tentacles, and foot in hydra: how to form structures close to each other, how to form them at a distance" .

    <https://doi.org/10.1007/BF00289234> dcterms:date "1972"^^xsd:gYear ;
        dcterms:title "A theory of biological pattern formation" .

    <https://doi.org/10.1242/jcs.15.2.321> dcterms:date "1974"^^xsd:gYear ;
        dcterms:title "Applications of a theory of biological pattern formation based on lateral inhibition" .

    <https://doi.org/10.1387/ijdb.113483hm> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Modeling pattern formation in hydra: a route to understanding essential steps in development" .

    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;

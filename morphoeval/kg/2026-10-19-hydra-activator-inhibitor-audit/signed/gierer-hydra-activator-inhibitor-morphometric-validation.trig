sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-apical-hypostome-peak-cell-index-along-polar-hydra-column-n-60> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Apical hypostome peak cell index along polar Hydra column (N=60) = 0 cell index (0=apical head)" ;
        schema:measurementTechnique "argmax_x a(x, T) on 60-cell column with source gradient slope -0.15" ;
        schema:name "Apical hypostome peak cell index along polar Hydra column (N=60)" ;
        schema:unitText "cell index (0=apical head)" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-apical-hypostome-peak-cell-index-along-polar-hydra-column-n-60-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-apical-hypostome-peak-cell-index-along-polar-hydra-column-n-60-reference> a schema:PropertyValue ;
        dcterms:source "Gierer & Meinhardt (1972) Kybernetik 12:30-39 Fig. 2 (apical dominance at head end)" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gierer-Meinhardt critical diffusivity ratio d_c = (sqrt(2)+1)^2 = 5.8284 D_h / D_a" ;
        schema:measurementTechnique "Analytical Turing-Gierer-Meinhardt threshold (sqrt(2)+1)^2 at mu_h > mu_a" ;
        schema:name "Gierer-Meinhardt critical diffusivity ratio d_c = (sqrt(2)+1)^2" ;
        schema:unitText "D_h / D_a" ;
        schema:value "5.8284" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2-reference> a schema:PropertyValue ;
        dcterms:source "Gierer & Meinhardt (1972) Kybernetik 12:30-39 Eqs. (15a)-(15b)" ;
        schema:value "5.8284" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Homogeneous steady-state activator concentration a_* (rho_0 = 0) = 1.5 concentration units" ;
        schema:measurementTechnique "a_* = (c / c_prime) * (mu_h / mu_a)" ;
        schema:name "Homogeneous steady-state activator concentration a_* (rho_0 = 0)" ;
        schema:unitText "concentration units" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0-reference> a schema:PropertyValue ;
        dcterms:source "Gierer & Meinhardt (1972) Kybernetik 12:30-39 Eq. (15)" ;
        schema:value "1.5" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) Hydra vulgaris activator-inhibitor morphogenesis — Morphometric validation: 45/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` reports only 3 basic scalars (d_c, a_*, and apical peak index, L190-215) without uncertainty metrics (CV, std, RMSE, Pearson r), without negative-control contrast, and without specimen tentacle count / angular spacing comparison." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L190–L215: Only 3 scalar measurements without CV/RMSE/r or specimen tentacle morphometrics <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L190-L215>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-apical-hypostome-peak-cell-index-along-polar-hydra-column-n-60>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-gierer-meinhardt-critical-diffusivity-ratio-d-c-sqrt-2-1-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-measurement-homogeneous-steady-state-activator-concentration-a-rho-0-0> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


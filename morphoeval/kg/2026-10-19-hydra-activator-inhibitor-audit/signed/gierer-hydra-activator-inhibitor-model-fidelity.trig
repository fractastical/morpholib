sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gierer-hydra-activator-inhibitor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1972-gierer-hydra-activator-inhibitor.py L38–L82" ;
        dcterms:description "Linear stability analysis computing d_c = (sqrt(2)+1)^2 and dispersion curve" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L38-L82> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Gierer & Meinhardt (1972) Hydra vulgaris activator-inhibitor morphogenesis — Model fidelity to source: 62/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Gierer & Meinhardt (1972) Eqs. (15a)-(15b) 1D PDE with zero-flux Neumann boundary conditions (L85-134) and exact linear stability analysis (L38-82, d_c = 5.8284, a_* = 1.5, h_* = 2.25). However, v1 omits Gierer & Meinhardt's signature surgical bisection and head regeneration experiment (Fig. 3), omits periodic circular ring morphogenesis for the tentacle whorl (Meinhardt 1993), and runs no equal-diffusion negative control (D_a = D_h)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1972-gierer-hydra-activator-inhibitor.py L85–L134: 1D polar column solver without bisection regeneration or equal-diffusion negative control <https://github.com/fractastical/morpholib/blob/3cb5ea9/1972-gierer-hydra-activator-inhibitor.py#L85-L134>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gierer-hydra-activator-inhibitor-model-fidelity-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


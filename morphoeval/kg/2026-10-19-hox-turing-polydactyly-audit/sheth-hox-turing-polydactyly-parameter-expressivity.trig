sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod — Parameter expressivity: 44/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates only the 2 extreme endpoints (H = 1.0 and H = 0.0) in the static figure without simulating the full 6-genotype allelic series of Sheth et al. (2012) Figs. 1-2 (5 -> 7 -> 8 -> 9 -> 11 -> 14 digits at constant autopod arc width), omits equal-diffusion (Du = Dv) and sub-Turing (fu <= 2) negative controls, and exposes no CLI flags for Hox dose, diffusivities, or PDE steps (L105-113)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L105–L113: CLI exposes only --self-test <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L105-L113>",
            "2012-sheth-hox-turing-polydactyly.py L51–L64: Only 2 extreme genotypes rendered; missing full 6-step allelic series and negative controls <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L51-L64>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 015 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod — Morphological realism / specimen match: 28/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/hox_turing_polydactyly/vertebrate_autopod_digits_specimen.jpg` is vendored on disk, the v1 baseline script never loads, segments, or plots the vertebrate hexadactylous autopod radiograph, and performs no quantitative comparison of segmented digit ray spacing against the Turing PDE." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L51–L64: 2-panel synthetic figure lacking biological specimen image and digit ray segmentation <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L51-L64>",
            "docs/media/hox_turing_polydactyly_comparison.png (generated output, not in repo): Synthetic 2-panel heatmap without vertebrate autopod radiograph comparison — docs/media/hox_turing_polydactyly_comparison.png: rendered output of 2012-sheth-hox-turing-polydactyly.py at 8871db0, image/png, 57567 B, 1300×546 px, artifact_sha256 ccd851d68225e7944e1b4a8235f9bc2dbb71d45918f5b5fd14f78f670df611af (sha256 ccd851d68225e7944e1b4a8235f9bc2dbb71d45918f5b5fd14f78f670df611af), spec_fingerprint abe9a76dd59fb62acd39e960662df4cc18109f96295cff9d50eee77bc05fa42d" ;
        pk:hasScore "0.28"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 015 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


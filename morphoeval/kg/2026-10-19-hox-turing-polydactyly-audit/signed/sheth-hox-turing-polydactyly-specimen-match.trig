    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod — Morphological realism / specimen match: 28/100" ;

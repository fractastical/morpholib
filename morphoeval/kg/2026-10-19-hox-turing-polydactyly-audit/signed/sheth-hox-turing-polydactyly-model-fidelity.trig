sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod — Model fidelity to source: 50/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes the analytical Turing critical wavenumber k_c(H) = sqrt((Dv*fu + Du*gv)/(2*Du*Dv)) at H = 1.0 (k_c = 5) and H = 0.0 (k_c = 14) (L23-36), but `synthesize_fan_digits` (L39-48) evaluates a static `cos(k_c * theta)` waveform instead of numerically integrating the nonlinear Sheth et al. (2012) reaction-diffusion PDE du/dt = f_u(H)*u + f_v*v - u^3 + D_u*Lap(u), dv/dt = g_u(H)*u + g_v*v + D_v*Lap(v) with polar Laplace-Beltrami operator on the fan-shaped autopod sector and proximodistal Fgf/Wnt-Hox gradient modulation." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-sheth-hox-turing-polydactyly.py L39–L48: Static cosine approximation instead of nonlinear reaction-diffusion PDE solver on fan-shaped autopod <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L39-L48>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-1> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sheth-hox-turing-polydactyly-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py L23–L36" ;
        dcterms:description "Exact critical wavenumber formula k_c(H) for WT and triple-null endpoints" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py#L23-L36> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 015 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


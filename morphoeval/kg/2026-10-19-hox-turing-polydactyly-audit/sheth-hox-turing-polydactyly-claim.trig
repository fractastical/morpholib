sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sheth-hox-turing-polydactyly> a pk:Claim ;
        rdfs:label "Sheth et al. (2012) Science distal Hoxa13/Hoxd11-13 + Gli3 dose modulation of Turing digit wavelength on a fan-shaped embryonic autopod faithfully reproduces Vertebrate embryonic autopod (Mus musculus distal Hox/Gli3 allelic series & postaxial hexadactylous autopod radiograph) morphology" ;
        dct:description "The simulation script(s) 2012-sheth-hox-turing-polydactyly.py implement the cited source model as published and produce forms that match real Vertebrate embryonic autopod (Mus musculus distal Hox/Gli3 allelic series & postaxial hexadactylous autopod radiograph) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 46.0/100, audit 2026-10-19-hox-turing-polydactyly-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py; output: docs/media/hox_turing_polydactyly_comparison.png; organism: Vertebrate embryonic autopod (Mus musculus distal Hox/Gli3 allelic series & postaxial hexadactylous autopod radiograph); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: abe9a76dd59fb62acd39e960662df4cc18109f96295cff9d50eee77bc05fa42d; artifact_sha256: ccd851d68225e7944e1b4a8235f9bc2dbb71d45918f5b5fd14f78f670df611af; input_dataset_sha256: {datasets/hox_turing_polydactyly/hox_turing_polydactyly_reference.json=864482554d2a8657..., datasets/hox_turing_polydactyly/scout_manifest.json=c0608869f6d213a4..., datasets/hox_turing_polydactyly/vertebrate_autopod_digits_specimen.jpg=995e43a2a0cf7815...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jtbi.2005.10.016>,
            <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1126/science.462174> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sheth-hox-turing-polydactyly-specimen-match> ;
        pk:weightOfEvidence "0.46"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2012-sheth-hox-turing-polydactyly.py> a schema:SoftwareSourceCode ;
        rdfs:label "2012-sheth-hox-turing-polydactyly.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila teissieri Turing wavelength at 1.7 µm (detail scale s0, Holocene 0 Ma) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion RMSE is 0.030 1/s and the determinant minimizer sits on the formula k_c (relative error under 5% by the self-test, and in practice far tighter). Otsu area, circularity, aspect and coherency are measured on the specimen and compared with the activator mask; none is a copy of its reference. The KS statistic is 0.450 against a 0.05 reference because it contrasts the raw activator with the micrograph rather than the rendered frame (R2). Saturated wavelength 1.903 µm versus formula 1.72 µm is recorded, not hidden (R1)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-18-wavelength-domain-dominant-mode>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-autocatalysis-ablation-final-initial-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-determinant-minimizer-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-diffusivity-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-dispersion-pearson-r-real-eigenvalue-band>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-equal-diffusion-control-final-initial-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-formula-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-homogeneous-trace>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-ks-statistic-specimen-luminance-vs-activator>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-predecessor-wavenumber-ratio-takahashii-teissieri>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-saturated-stripe-wavelength-sub-bin>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-specimen-image-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-specimen-image-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-specimen-image-foreground-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-successor-floor-over-teissieri-detail>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-18-wavelength-domain-dominant-mode> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "18-wavelength domain dominant mode = 17 cycles" ;
        schema:measurementTechnique "same PDE on an 18 λ_c patch versus the 12 λ_c patch" ;
        schema:name "18-wavelength domain dominant mode" ;
        schema:unitText "cycles" ;
        schema:value "17" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-18-wavelength-domain-dominant-mode-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-18-wavelength-domain-dominant-mode-reference> a schema:PropertyValue ;
        schema:value "11" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-autocatalysis-ablation-final-initial-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "autocatalysis-ablation final/initial std = 2e-05 ratio" ;
        schema:measurementTechnique "u^2 v exchange removed; spatial std must fall" ;
        schema:name "autocatalysis-ablation final/initial std" ;
        schema:unitText "ratio" ;
        schema:value "2e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-autocatalysis-ablation-final-initial-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-autocatalysis-ablation-final-initial-std-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-determinant-minimizer-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "determinant-minimizer wavelength = 1.72 µm" ;
        schema:measurementTechnique "numerical argmin of det(gamma J - k^2 D) on a k grid" ;
        schema:name "determinant-minimizer wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.72" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-determinant-minimizer-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-determinant-minimizer-wavelength-reference> a schema:PropertyValue ;
        schema:value "1.72" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-diffusivity-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-sweep Pearson r = 0.99949 correlation" ;
        schema:measurementTechnique "analytical argmax σ(k) vs 1D numerical dominant wavelength across six ratios" ;
        schema:name "diffusivity-sweep Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.99949" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-diffusivity-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-diffusivity-sweep-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-dispersion-pearson-r-real-eigenvalue-band> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r (real-eigenvalue band) = 0.99349 correlation" ;
        schema:measurementTechnique "linearised 1D PDE growth vs continuum σ(k), modes with disc>=0" ;
        schema:name "dispersion Pearson r (real-eigenvalue band)" ;
        schema:unitText "correlation" ;
        schema:value "0.99349" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-dispersion-pearson-r-real-eigenvalue-band-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-dispersion-pearson-r-real-eigenvalue-band-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.03008 1/s" ;
        schema:measurementTechnique "RMSE of measured vs continuum growth rates on the same band" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/s" ;
        schema:value "0.03008" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;

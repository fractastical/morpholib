        schema:unitText "µm" ;
        schema:value "1.72" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-formula-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-formula-critical-wavelength-reference> a schema:PropertyValue ;

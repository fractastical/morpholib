    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-equal-diffusion-control-final-initial-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control final/initial std = 0.19257 ratio" ;
        schema:measurementTechnique "Du=Dv integration; ratio < 1 means the pattern decays" ;
        schema:name "equal-diffusion control final/initial std" ;
        schema:unitText "ratio" ;
        schema:value "0.19257" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-equal-diffusion-control-final-initial-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0-measurement-equal-diffusion-control-final-initial-std-reference> a schema:PropertyValue ;
        schema:value "1.0" .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-teissieri-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila teissieri Turing wavelength at 1.7 µm (detail scale s0, Holocene 0 Ma) faithfully reproduces Drosophila teissieri morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila teissieri specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py; output: docs/media/drosophila_teissieri_turing_wavelength_s0_comparison.png; organism: Drosophila teissieri; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 critical wavenumber and the unequal-diffusivity condition. | Schnakenberg 1979 reaction terms a - u + u^2 v and b - u^2 v. | Tsacas 1971 name Drosophila teissieri, confirmed at GBIF 5074619. Tamura 2003 dates the melanogaster-subgroup radiation.; reconstructed_in_script: (a, b, gamma, Dv/Du) = (0.13, 0.91, 1.15, 17.4) so the formula wavelength is 1.72 µm. | Explicit Euler, linearised dispersion check, magnified inset on the vendored micrograph.; transfer_boundary: 1.72 µm is the campaign detail-scale assignment, not a published teissieri granule measurement. | Predecessor 97.6 µm and successor floor 2.72 µm are atlas contrasts at 0 Ma, not an ancestor-descendant series.; does_not_claim: That a wet-lab paper measured 1.72 µm on D. teissieri. | That D. virilis descends from D. teissieri. | That DOI 10.1093/molbev/msx210 is about this species (Crossref: yeast de-novo genes).]; other sources: GBIF Drosophila teissieri Tsacas, 1971 (taxon key 5074619) <https://www.gbif.org/species/5074619>; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1093/molbev/msg236>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.4310/maa.2001.v8.n3.a3> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


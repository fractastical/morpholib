sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila americana detail-scale Turing wavelength (2.117 µm, 0 Ma) — Code-to-model traceability: 85/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "k_c, the Jacobian, and the chronoseries formula are named in the module docstring and in the Lean proofs (six theorems, no sorry). Self-test checks the Lean nanometre integers 2117, 1958, and 1900. The Fourier scheme is commented as matching the dispersion operator." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3175_drosophila_americana_turing_wavelength_s0.lean L16–L48" ;
        dct:description "Six theorems: order, stripe count, buffer inequalities, discriminant sign" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3175_drosophila_americana_turing_wavelength_s0.lean#L16-L48> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py L1–L28" ;
        dct:description "Module docstring states k_c, the 2.117 µm scale, and 0 Ma" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py#L1-L28> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider in this pass)" ;
        dct:identifier "grok-4.7" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila americana detail-scale Turing wavelength (2.117 µm, 0 Ma) — Morphological realism / specimen match: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The growth GIF last frame scores CV similarity 79.0 against the species card (12 frames, 640×520, frame difference 0.12). The card is a spiral pigment image, not an ocellar micrograph, and the simulation is a stripe field, so the match is textural rather than anatomical. The GIF caption uses λ and µm, which the default bitmap font does not draw. Orientation KS on 12 bins is 0.5." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_americana_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12-frame growth GIF, 640×520 — docs/media/drosophila_americana_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py at 0c76d15d, image/gif, 2104603 B, 640×520 px, 12 frames, artifact_sha256 9c01fec6a77bcd33c0decd3902d741842bff5c7c6e4feee987371d82e2e4c8a8 (sha256 9c01fec6a77bcd33c0decd3902d741842bff5c7c6e4feee987371d82e2e4c8a8), spec_fingerprint 2f4962a2f9aad429899235fd1af99851f464c94cb46349fdccbc4240f10a01bb" .

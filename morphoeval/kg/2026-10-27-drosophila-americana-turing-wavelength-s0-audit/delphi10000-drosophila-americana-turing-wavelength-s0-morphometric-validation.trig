sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila americana detail-scale Turing wavelength (2.117 µm, 0 Ma) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.989 and RMSE = 0.41 px against lambda(k_sigma). Ablation amplitude ratio is about 0. The detail-scale americana/affinis ratio is below the primordium-scale sibling ratio. The orientation KS is reported but is computed on histogram bins rather than pixel samples, so it is a weak distributional test. n = 1 species card." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-analytical-versus-simulated-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-d-americana-expressed-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-detail-scale-versus-primordium-scale-americana-affinis-wavelength-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-specimen-pigment-segment-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-wavelength-rmse-against-maximum-growth-prediction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-analytical-versus-simulated-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical versus simulated wavelength Pearson r = 0.9892 Pearson r" ;
        schema:measurementTechnique "pearsonr of FFT wavelengths against lambda(k_sigma) across the D_u sweep" ;
        schema:name "analytical versus simulated wavelength Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9892" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-analytical-versus-simulated-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-analytical-versus-simulated-wavelength-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pre-registered MorphoEval gate (r > 0.98), not the measured correlation" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-d-americana-expressed-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "D. americana expressed stripe wavelength = 2.0751 µm" ;
        dct:description "value is the FFT measurement; reference is the assigned scale, not a copy of the measurement" ;
        schema:measurementTechnique "radial FFT peak on the D_u-sweep grid at scale 1, converted with the ruler on which lambda(k_sigma) = 2.117 µm" ;
        schema:name "D. americana expressed stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.0751" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-d-americana-expressed-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-d-americana-expressed-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Slot 3175 assigned detail-scale wavelength (2.117e-6 m). Measured value includes discretization and the above-onset shift." ;
        schema:value "2.117" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-detail-scale-versus-primordium-scale-americana-affinis-wavelength-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "detail-scale versus primordium-scale americana/affinis wavelength ratio = 1.0812 ratio" ;
        schema:measurementTechnique "lambda_ame/lambda_aff at beta = 0.35 body-length buffering, versus sibling primordium wavelengths" ;
        schema:name "detail-scale versus primordium-scale americana/affinis wavelength ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.0812" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-detail-scale-versus-primordium-scale-americana-affinis-wavelength-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-detail-scale-versus-primordium-scale-americana-affinis-wavelength-ratio-reference> a schema:PropertyValue ;
        dct:source "Primordium-scale sibling slots (138.7 µm / 95.94 µm), not this model's detail-scale ratio" ;
        schema:value "1.4457" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 0.0 std ratio" ;
        dct:description "negative control; discriminant at r = 1 is negative" ;
        schema:measurementTechnique "final activator std at r = 1 divided by final std at r = 10, same D_u and seed family" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "std ratio" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "Null expectation if equal diffusion still patterned" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-specimen-pigment-segment-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen pigment-segment fraction = 0.1795 area fraction" ;
        schema:measurementTechnique "Otsu threshold on the species-card grayscale; fraction darker than the threshold" ;
        schema:name "specimen pigment-segment fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.1795" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-specimen-pigment-segment-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-specimen-pigment-segment-fraction-reference> a schema:PropertyValue ;
        dct:source "Simulation structure-tensor coherency (different quantity; not a self-copy of the segment fraction)" ;
        schema:value "0.8753" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus simulation orientation KS statistic = 0.5 KS distance" ;
        schema:measurementTechnique "ks_2samp on 12-bin Sobel orientation histograms of the species card and the simulated field" ;
        schema:name "specimen versus simulation orientation KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "Identical orientation spectra would have KS = 0; the card is not a draw from the simulation" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-wavelength-rmse-against-maximum-growth-prediction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength RMSE against maximum-growth prediction = 0.4056 px" ;
        dct:description "KS/CV companion: orientation KS is reported as its own measurement" ;
        schema:measurementTechnique "RMSE of measured radial-FFT wavelength versus sigma-peak wavelength over the D_u sweep" ;
        schema:name "wavelength RMSE against maximum-growth prediction" ;
        schema:unitText "px" ;
        schema:value "0.4056" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-wavelength-rmse-against-maximum-growth-prediction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-measurement-wavelength-rmse-against-maximum-growth-prediction-reference> a schema:PropertyValue ;
        dct:source "RMSE against the onset wavelength lambda(k_c), a different predictor than lambda(k_sigma)" ;
        schema:value "1.0299" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py L205–L229" ;
        dct:description "dominant_wavelength_px radial FFT with parabolic refinement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py#L205-L229> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py L354–L381" ;
        dct:description "Otsu segment, coherency, and ks_2samp on orientation histograms" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py#L354-L381> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider in this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai/> .
}


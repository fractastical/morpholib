sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila americana detail-scale Turing wavelength (2.117 µm, 0 Ma) — Parameter expressivity: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Five D_u scales move the measured wavelength with Pearson r = 0.989. Equal diffusion collapses the amplitude. The chronoseries is a D_u rescaling at fixed r. There is not yet a near-onset bracket showing k_sigma approach k_c, and (a, b) are not swept." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py L64–L65" ;
        dct:description "SWEEP_SCALES = (0.64, 0.81, 1.00, 1.21, 1.44)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py#L64-L65> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-americana-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py L264–L317" ;
        dct:description "wavelength_sweep and equal-diffusion ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-americana-turing-wavelength-s0.py#L264-L317> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider in this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai/> .
}


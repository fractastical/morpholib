    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength of Baculites compressus at 94.16 µm (Pass 1) — Morphological realism / specimen match: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Side by side, the capsule has the dark field, metallic ridges, and horizontal shaft of the polished section, but the outline is a smooth oval and the sutures are a regular labyrinth rather than the specimen's broken dendritic sutures. Texture statistics are closer than the silhouette." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

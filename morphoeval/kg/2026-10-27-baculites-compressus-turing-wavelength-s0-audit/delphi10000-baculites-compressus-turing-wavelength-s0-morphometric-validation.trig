}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength of Baculites compressus at 94.16 µm (Pass 1) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion r = 0.99966 with RMSE 0.00884 at dt = 0.12 of the stability bound; ablation σ is negative; λ_max = 96.54 µm against the 94.16 µm reference; the Kevmin section is segmented (area 0.427, aspect 2.62). KS, radial-FFT r, and coherency are printed on the figure. The timestep has not yet been tightened." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-dispersion-pearson-r-of-numeric-versus-analytic-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-at-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-fastest-mode-wavelength-versus-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-nipponites-successor-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-placenticeras-predecessor-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-shell-foreground-fraction-segmented-from-the-kevmin-specimen>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-simulation-structure-tensor-coherency-on-the-flank-frame>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-histogram-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-dispersion-pearson-r-of-numeric-versus-analytic-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r of numeric versus analytic growth rate = 0.999659 Pearson r" ;
        dct:description "RMSE = 0.00884 per τ across 8 wavenumbers" ;
        schema:measurementTechnique "1D periodic Schnakenberg eigenmode integrated with explicit Euler; σ = log(A1/A0)/t compared with the larger Jacobian eigenvalue" ;
        schema:name "dispersion Pearson r of numeric versus analytic growth rate" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999659" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-dispersion-pearson-r-of-numeric-versus-analytic-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-dispersion-pearson-r-of-numeric-versus-analytic-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion relation, identical Jacobian" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-at-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation growth rate at k_c = -0.7739 1/τ" ;
        dct:description "analytic ablation σ = -0.4457; Turing σ(k_c) = 0.0264" ;
        schema:measurementTechnique "same eigenmode integrator with D_v = D_u" ;
        schema:name "equal-diffusion ablation growth rate at k_c" ;
        schema:unitText "1/τ" ;
        schema:value "-0.7739" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-at-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-at-k-c-reference> a schema:PropertyValue ;
        dct:source "marginal stability; the control must lie below it" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-fastest-mode-wavelength-versus-critical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fastest-mode wavelength versus critical wavelength = 96.5433 µm" ;
        dct:description "near threshold λ_max sits a few micrometres above λ_c; they are not forced equal" ;
        schema:measurementTechnique "argmax_k σ(k) on a 240-point grid at r = 9.2" ;
        schema:name "fastest-mode wavelength versus critical wavelength" ;
        schema:unitText "µm" ;
        schema:value "96.5433" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-fastest-mode-wavelength-versus-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-fastest-mode-wavelength-versus-critical-wavelength-reference> a schema:PropertyValue ;
        dct:source "assigned detail scale λ_c = 94.16 µm = 2π/k_c" ;
        schema:value "94.16" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-nipponites-successor-critical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Nipponites successor critical wavelength = 62.15 µm" ;
        dct:description "whorl recontact shortens the free margin" ;
        schema:measurementTechnique "λ_c(χ=6215/9416) with the Baculites chemistry held fixed" ;
        schema:name "Nipponites successor critical wavelength" ;
        schema:unitText "µm" ;
        schema:value "62.15" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-nipponites-successor-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-nipponites-successor-critical-wavelength-reference> a schema:PropertyValue ;
        dct:source "Baculites compressus λ_c at χ = 1" ;
        schema:value "94.16" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-placenticeras-predecessor-critical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Placenticeras predecessor critical wavelength = 141.24 µm" ;
        dct:description "aperture stretch, not a new reaction scheme" ;
        schema:measurementTechnique "λ_c(χ=3/2) with the Baculites chemistry held fixed" ;
        schema:name "Placenticeras predecessor critical wavelength" ;
        schema:unitText "µm" ;
        schema:value "141.24" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-placenticeras-predecessor-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-placenticeras-predecessor-critical-wavelength-reference> a schema:PropertyValue ;
        dct:source "Baculites compressus λ_c at χ = 1" ;
        schema:value "94.16" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-shell-foreground-fraction-segmented-from-the-kevmin-specimen> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "shell foreground fraction segmented from the Kevmin specimen = 0.4267 area fraction" ;
        dct:description "circularity = 0.1019, aspect = 2.620" ;
        schema:measurementTechnique "border-median threshold, closing, largest connected component" ;
        schema:name "shell foreground fraction segmented from the Kevmin specimen" ;
        schema:unitText "area fraction" ;
        schema:value "0.4267" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-shell-foreground-fraction-segmented-from-the-kevmin-specimen-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-shell-foreground-fraction-segmented-from-the-kevmin-specimen-reference> a schema:PropertyValue ;
        dct:source "a horizontal shaft on a dark field occupies a bit over half the frame" ;
        schema:value "0.55" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-simulation-structure-tensor-coherency-on-the-flank-frame> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulation structure-tensor coherency on the flank frame = 0.3716 coherency" ;
        dct:description "reference is the specimen measurement; the two numbers are computed separately" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor" ;
        schema:name "simulation structure-tensor coherency on the flank frame" ;
        schema:unitText "coherency" ;
        schema:value "0.3716" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-simulation-structure-tensor-coherency-on-the-flank-frame-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-simulation-structure-tensor-coherency-on-the-flank-frame-reference> a schema:PropertyValue ;
        dct:source "same statistic on the Kevmin photograph crop" ;
        schema:value "0.3986" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-histogram-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus simulation orientation-histogram KS statistic = 0.4167 KS distance" ;
        dct:description "radial-FFT Pearson r = 0.8542, RMSE = 1.2557" ;
        schema:measurementTechnique "12-bin Sobel orientation histograms on the fitness crops; scipy ks_2samp" ;
        schema:name "specimen versus simulation orientation-histogram KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.4167" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-histogram-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-measurement-specimen-versus-simulation-orientation-histogram-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical orientation spectra would give KS = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-baculites-compressus-turing-wavelength-s0.py L161–L189" ;
        dct:description "analytic versus numeric dispersion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8f0ebbb7583b60dab933158a86eda8e291baab3e/models/2026-delphi10000-baculites-compressus-turing-wavelength-s0.py#L161-L189> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-baculites-compressus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-baculites-compressus-turing-wavelength-s0.py L373–L440" ;
        dct:description "specimen segmentation and KS / radial-FFT comparison" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8f0ebbb7583b60dab933158a86eda8e291baab3e/models/2026-delphi10000-baculites-compressus-turing-wavelength-s0.py#L373-L440> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Baculites_compressus_01.jpg>,
            <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/S0022-5193(87)80101-7>,
            <https://doi.org/10.1017/S0016756800146023>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.2307/3515325> .
    <https://commons.wikimedia.org/wiki/File:Baculites_compressus_01.jpg> dct:title "Kevmin, Baculites compressus polished section (Wikimedia Commons, CC BY-SA 3.0)" .
    <https://doi.org/10.1007/BF00289234> dct:title "Gierer and Meinhardt 1972, A theory of biological pattern formation" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Schnakenberg 1979, Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/S0022-5193(87)80101-7> dct:title "Meinhardt and Klingler 1987, A model for pattern formation on the shells of molluscs" .
    <https://doi.org/10.1017/S0016756800146023> dct:title "G. C. C. 1892, The coiled stage of Baculites compressus" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "Turing 1952, The chemical basis of morphogenesis" .
    <https://doi.org/10.2307/3515325> dct:title "Fatherree, Harries and Quinn 1998, Isotopic dissection of Baculites compressus from the Pierre Shale" .

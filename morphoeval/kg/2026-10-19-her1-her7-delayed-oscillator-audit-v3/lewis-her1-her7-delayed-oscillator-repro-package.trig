sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator, DeltaC-Notch synchronization, and (Pass 3) 2D her1/her7/deltaC DDE lattice with NICD kinetics on a Schroter (2012) Hes6 dimer-truth-table gradient — Reproducibility package: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic seeds everywhere (lattice bitwise-identical across two runs, asserted L1535-1537); --self-test runs 9 groups in ~70 s covering SHA pins, Hopf threshold, delay invariance, negative controls, 1D chain, specimen, regime-table honesty, truth-table/JSON parity, Hes6 monotonicity, lattice synchrony / mutant 5-7 cycles / AP gradient / T_N monotonicity / re-synchronisation; the default render takes 25 s and regenerates both PNG and GIF; the environment block is now the actual venv; lattice parameters are asserted against the vendored JSON; `expected_outputs_seed_2003` is recorded in the JSON. Deductions: there is still no requirements lock file pinning numpy 2.5.4 / scipy 1.16.3 (-3); MPLCONFIGDIR must be set manually to avoid a font-cache warning outside the repo (-1); the seed sensitivity (5-7 cycles) is documented but not asserted across seeds (-2); runtime of --self-test doubled because `compute_lattice_suite` runs twice (self-test + measure) (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L1457–L1568" ;
        dct:description "9-group deterministic self-test incl. lattice bitwise determinism, JSON parity, regime honesty and T_N monotonicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L1457-L1568> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/her1_her7_delayed_oscillator/her1_her7_delayed_oscillator_reference.json L178–L216" ;
        dct:description "lattice_model_parameters with provenance and expected_outputs_seed_2003" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/her1_her7_delayed_oscillator/her1_her7_delayed_oscillator_reference.json#L178-L216> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/her1_her7_delayed_oscillator_growth.gif (generated output)" ;
        dct:description "24-frame GIF with a third row showing the WT vs eps_N = 0 lattice her mRNA field — docs/media/her1_her7_delayed_oscillator_growth.gif: rendered output of 2003-lewis-her1-her7-delayed-oscillator.py at d58a084, image/gif, 1464325 B, 940×740 px, 24 frames, artifact_sha256 a7d4ff0361b542470b20dcca1e3d429fbe8d4d593cd9e37183dd0f1c95f987d6 (sha256 a7d4ff0361b542470b20dcca1e3d429fbe8d4d593cd9e37183dd0f1c95f987d6), spec_fingerprint 3359489370da632246e18833410da2ca588eb4932d80863d4bcc1a6360ecd4fb" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


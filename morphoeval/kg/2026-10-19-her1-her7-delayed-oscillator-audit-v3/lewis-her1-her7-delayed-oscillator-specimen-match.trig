sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator, DeltaC-Notch synchronization, and (Pass 3) 2D her1/her7/deltaC DDE lattice with NICD kinetics on a Schroter (2012) Hes6 dimer-truth-table gradient — Morphological realism / specimen match: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Panels E-F still segment both bilateral somite rows of the SHA-pinned SEM (8 + 9 somites, 48.47 px, symmetry 0.9605) and Panel G now shows a 2D sheet whose WT half carries a visible posterior-to-anterior phase gradient while the eps_N = 0 half is salt-and-pepper, which is the qualitative Lewis Fig. 6 picture; the GIF adds the lattice as a third row. Deductions: the specimen is a chick embryo (Commons title) presented under a zebrafish file name, so no zebrafish tissue is matched at all (-8 relative to v2); no her1/deltaC in situ stripe image or PSM kymograph is compared with the lattice phase map, so the new 2D output is validated only against the model's own 1D chain (-6); the lattice cycles at ~40 min rather than the 30 min clock and the kinematic wave count (0.14) is far below the 1-3 stripes seen in zebrafish PSM (-4); the chick proxy is now declared in JSON, README, figure title and measurement source, which prevents a larger deduction." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/her1_her7_delayed_oscillator/her1_her7_delayed_oscillator_reference.json L29–L59: Specimen block: species_note_pass3 declares the Commons title identifies a chick embryo; file name retained because SHA-pinned <https://github.com/fractastical/morpholib/blob/d58a084/datasets/her1_her7_delayed_oscillator/her1_her7_delayed_oscillator_reference.json#L29-L59>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-specimen-match-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/her1_her7_delayed_oscillator_comparison.png (generated output)" ;
        dct:description "9-panel figure: E-F specimen segmentation retained, G lattice cos-phase maps WT vs mutant, H AP period gradient, I synchrony per cycle with DeltaC/NICD inset — docs/media/her1_her7_delayed_oscillator_comparison.png: rendered output of 2003-lewis-her1-her7-delayed-oscillator.py at d58a084, image/png, 1492547 B, 2352×2044 px, artifact_sha256 f5ee9226fc709b1bd5be49ec6f0075bba0ce2e7066d65a0036c4cf97bd3ef858 (sha256 f5ee9226fc709b1bd5be49ec6f0075bba0ce2e7066d65a0036c4cf97bd3ef858), spec_fingerprint 3359489370da632246e18833410da2ca588eb4932d80863d4bcc1a6360ecd4fb" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L1278–L1295" ;
        dct:description "Panel G stacks WT and eps_N = 0 final-phase grids with R_col, wave count and intact-cycle annotations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L1278-L1295> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L877–L950" ;
        dct:description "Bilateral DoG peak/cleft segmentation unchanged from v2 (8 upper / 9 lower somites)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L877-L950> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


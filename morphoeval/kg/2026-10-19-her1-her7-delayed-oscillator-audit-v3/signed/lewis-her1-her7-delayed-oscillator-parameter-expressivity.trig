sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L814–L874" ;
        dcterms:description "compute_lattice_suite: WT / mutant / hes6-null / T_N sweep / Hes6 sweep / re-synchronisation; hes6_period_sweep monotonicity flag" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L814-L874> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L1296–L1348" ;
        dcterms:description "Panels H-I: column period vs AP position for WT / mutant / hes6-null with single-cell titration overlay; cycle R with T_N sweep text" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L1296-L1348> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L1571–L1600" ;
        dcterms:description "CLI flags --eps-notch, --hes6-posterior, --TN, --lattice-summary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L1571-L1600> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator, DeltaC-Notch synchronization, and (Pass 3) 2D her1/her7/deltaC DDE lattice with NICD kinetics on a Schroter (2012) Hes6 dimer-truth-table gradient — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Every new knob is exercised and behaves monotonically: Hes6 0 -> 90 lowers the single-cell period 41.2 -> 36.4 min (asserted monotone, L1525-1531), the T_N sweep 2 / 10 / 20 min raises the collective period 39.6 / 42.2 / 44.6 min (asserted, L1545-1546), eps_N = 0.9 vs 0 separates WT from bea/des/aei (14 vs 7 coherent cycles; re-synchronisation from asynchronous onset 0.48 vs 0.29), hes6-null flattens the AP gradient (span 0.4 min). The (T_tot, b) Hopf morphospace, intron-deletion and CHX controls remain, and CLI flags --eps-notch / --hes6-posterior / --TN / --lattice-summary expose the lattice (L1581-1584). Deductions: the Hes6 gradient only spans 2.2 min of period in the lattice and quenches oscillation beyond ~80, so the AP axis is weakly expressive and bounded (-4); the T_N sweep has 3 points and no eps_N or K_76 sweep is plotted (-3); the 30 min WT period is unreachable by the two-gene lattice at these delays (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-parameter-expressivity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

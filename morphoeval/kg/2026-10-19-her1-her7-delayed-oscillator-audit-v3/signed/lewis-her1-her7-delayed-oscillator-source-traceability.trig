sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator, DeltaC-Notch synchronization, and (Pass 3) 2D her1/her7/deltaC DDE lattice with NICD kinetics on a Schroter (2012) Hes6 dimer-truth-table gradient — Source and data traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "All four sources carry DOIs in the docstring, JSON, README and paper_citations.bib; the specimen, scout manifest and (new in Pass 3) the reference JSON are SHA-256-pinned and verified fail-closed at every run (L112-142); the truth table, lattice parameters, Box 1 caveat and regime-table caveat are vendored in the JSON (L65-66, L90, L164-216) with provenance notes and asserted against the code. Deductions: the 5-regime table's T_m/T_p values (4.6/1.7, 9.5/2.8, 8.4/1.8) and observed periods are not pinned to a page, table or figure of Lewis/Giudicelli/Herrgen and one of them contradicts the computed threshold (-4); the truth table is hand-encoded from the paper's qualitative summary, not a vendored table or supplementary file (-2); the deltaC delays are labelled \"approximate\" and the chick specimen was mislabelled as zebrafish in v1/v2 (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/her1_her7_delayed_oscillator/her1_her7_delayed_oscillator_reference.json L88–L102: Regime table caveat added, but regime T_m/T_p/observed values remain without page/figure pins <https://github.com/fractastical/morpholib/blob/d58a084/datasets/her1_her7_delayed_oscillator/her1_her7_delayed_oscillator_reference.json#L88-L102>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-source-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L112–L142" ;
        dcterms:description "EXPECTED_SHA256 now pins specimen, scout manifest AND reference JSON; verify_dataset_integrity fails closed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L112-L142> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/her1_her7_delayed_oscillator/her1_her7_delayed_oscillator_reference.json L164–L216" ;
        dcterms:description "Vendored Schroter (2012) truth table with encoding note and lattice_model_parameters block with provenance per parameter group" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/her1_her7_delayed_oscillator/her1_her7_delayed_oscillator_reference.json#L164-L216> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/her1_her7_delayed_oscillator/README.md L20–L46" ;
        dcterms:description "README laws 2, 4, 5 rewritten with Pass 3 corrections, lattice equations, truth table and chick-proxy disclosure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/her1_her7_delayed_oscillator/README.md#L20-L46> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


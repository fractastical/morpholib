        dcterms:source "Lewis (2003) Current Biology 13:1398-1408 Appendix & Fig. 3 (critical delay threshold T_crit = 7.54 min for n=2, b=c=0.23 min^-1)" ;
        schema:value "7.54" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,

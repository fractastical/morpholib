        schema:measurementTechnique "exact characteristic root locus (lambda+b)(lambda+c) + K_loop*exp(-lambda*T_tot) = 0 around (m*=8.27, p*=161.76, omega_H=0.216 rad/min)" ;
        schema:name "supercritical Hopf bifurcation critical delay threshold T_crit = T_m + T_p" ;
        schema:unitText "min" ;
        schema:value "7.54" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-supercritical-hopf-bifurcation-critical-delay-threshold-t-crit-t-m-t-p-reference> .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator, DeltaC-Notch synchronization, and (Pass 3) 2D her1/her7/deltaC DDE lattice with NICD kinetics on a Schroter (2012) Hes6 dimer-truth-table gradient — Morphometric validation: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L953-1084) now returns 11 reference-anchored measurements: WT Box 1 period, Hopf threshold, 1D chain R, the MODEL-COMPUTED 5-regime r = 0.791 (with the tabulated 0.9999 disclosed in the note), the DDE-vs-Box-1 discrepancy (33.62 vs 30.0 min), lattice WT R_col = 0.669 vs 0.965, mutant intact cycles 7 vs 6, Hes6 titration span 4.85 vs 9.29 min, lattice AP span 2.17 vs 2.0 min, T_N lengthening 4.98 vs 2.5 min, and specimen spacing 48.47 px. Deductions: the model-computed regime correlation is only 0.79 with RMSE 11.8 min, i.e. the headline quantitative validation no longer passes at the level v2 claimed (-5); three of the six new references are model-internal (her1-only minus WT DDE, single-cell sweep span, regime-4 table magnitude) and the T_N value is 2x its reference (-5); the specimen spacing reference is the dataset's own prior segmentation of a chick proxy, i.e. circular (-3); lattice numbers come from a single seed with seed sensitivity reported only in a note (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2003-lewis-her1-her7-delayed-oscillator.py L1045–L1074: Hes6 span, AP gradient and T_N measurements use model-internal or table-derived reference values (declared in reference_source) <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L1045-L1074>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-dde-lattice-notch-mutant-intact-anterior-cycles-before-salt-and-pepper-desynchronization>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-dde-lattice-wild-type-column-synchrony-r-col-deltac-nicd-coupled-vs-bea-des-aei>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-lattice-anterior-to-posterior-period-gradient-induced-by-the-hes6-gradient>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-collective-period-lengthening-with-nicd-cleavage-trafficking-delay-t-n>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r-model-computed>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-rk4-dde-wild-type-period-vs-lewis-box-1-analytic-period-law-discrepancy>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-schroter-2012-truth-table-hes6-titration-single-cell-period-span-from-hes6-0-to-90>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-supercritical-hopf-bifurcation-critical-delay-threshold-t-crit-t-m-t-p>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-zebrafish-her1-her7-delayed-oscillator-wild-type-period-t-osc-at-28-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-dde-lattice-notch-mutant-intact-anterior-cycles-before-salt-and-pepper-desynchronization> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D DDE lattice Notch-mutant intact anterior cycles before salt-and-pepper desynchronization = 7 somite cycles" ;
        dcterms:description "seed sensitivity 5-7 cycles over seeds {2003, 7, 11}; WT lattice keeps 14/14 cycles above threshold" ;
        schema:measurementTechnique "number of consecutive 30-min cycles with column-mean Kuramoto R >= 0.50 in the eps_N = 0 lattice (synchronous onset, seed 2003)" ;
        schema:name "2D DDE lattice Notch-mutant intact anterior cycles before salt-and-pepper desynchronization" ;
        schema:unitText "somite cycles" ;
        schema:value "7" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-dde-lattice-notch-mutant-intact-anterior-cycles-before-salt-and-pepper-desynchronization-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-dde-lattice-notch-mutant-intact-anterior-cycles-before-salt-and-pepper-desynchronization-reference> a schema:PropertyValue ;
        dcterms:source "Lewis (2003) Current Biology 13:1398-1408 Figs. 5-6 and bea/des/aei phenotypes (first 5-7 anterior somites normal)" ;
        schema:value "6" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-dde-lattice-wild-type-column-synchrony-r-col-deltac-nicd-coupled-vs-bea-des-aei> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D DDE lattice wild-type column synchrony R_col (DeltaC/NICD-coupled) vs bea/des/aei = 0.6687 Kuramoto R" ;
        dcterms:description "Notch mutant (eps_N=0) late R_col = 0.3280; WT R_col declines from 0.98 (cycle 1) to 0.61 (cycle 14) so coupling only partly compensates heterogeneity in this reduced model; resync from asynchronous onset: WT R=0.435 vs mutant 0.311" ;
        schema:measurementTechnique "8x24 her1/her7/deltaC DDE lattice (7 delayed variables per cell, Langevin mRNA noise 1.0, delay heterogeneity 0.07), eps_N=0.9, T_N=2.0 min; mediolateral Kuramoto R per AP column averaged over t in [240, 450] min" ;
        schema:name "2D DDE lattice wild-type column synchrony R_col (DeltaC/NICD-coupled) vs bea/des/aei" ;
        schema:unitText "Kuramoto R" ;
        schema:value "0.6687" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-dde-lattice-wild-type-column-synchrony-r-col-deltac-nicd-coupled-vs-bea-des-aei-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-dde-lattice-wild-type-column-synchrony-r-col-deltac-nicd-coupled-vs-bea-des-aei-reference> a schema:PropertyValue ;
        dcterms:source "Lewis (2003) Current Biology 13:1398-1408 Figs. 5-6 (Notch-coupled synchrony R > 0.95; model-reference, not a measured tissue value)" ;
        schema:value "0.965" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-lattice-anterior-to-posterior-period-gradient-induced-by-the-hes6-gradient> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D lattice anterior-to-posterior period gradient induced by the Hes6 gradient = 2.169 min" ;
        dcterms:description "hes6-null lattice is uniform (41.82/41.36 min, span 0.46 min); kinematic wave count across the lattice = 0.141 (Notch mutant 0.482)" ;
        schema:measurementTechnique "mean column period over the anterior quarter minus posterior quarter of the WT lattice (anterior 40.81 min at Hes6=4, posterior 38.64 min at Hes6=40)" ;
        schema:name "2D lattice anterior-to-posterior period gradient induced by the Hes6 gradient" ;
        schema:unitText "min" ;
        schema:value "2.169" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-lattice-anterior-to-posterior-period-gradient-induced-by-the-hes6-gradient-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-2d-lattice-anterior-to-posterior-period-gradient-induced-by-the-hes6-gradient-reference> a schema:PropertyValue ;
        dcterms:source "qualitative: posterior-fast / anterior-slow clock producing posterior-to-anterior kinematic waves (Giudicelli et al. 2007 PLoS Biology 5:e150; Schroter et al. 2012); reference value is the single-cell Hes6 sweep span between the same two Hes6 levels, not a measured tissue gradient" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-collective-period-lengthening-with-nicd-cleavage-trafficking-delay-t-n> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Collective period lengthening with NICD cleavage/trafficking delay T_N = 4.98 min" ;
        dcterms:description "monotone increase of the collective period with T_N in this model; Herrgen et al. manipulated coupling strength (DAPT, mutants) rather than T_N directly" ;
        schema:measurementTechnique "lattice mean period at T_N = 2 / 10 / 20 min: 39.62 / 42.15 / 44.60 min (R_col 0.67 / 0.72 / 0.73)" ;
        schema:name "Collective period lengthening with NICD cleavage/trafficking delay T_N" ;
        schema:unitText "min" ;
        schema:value "4.98" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-collective-period-lengthening-with-nicd-cleavage-trafficking-delay-t-n-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-collective-period-lengthening-with-nicd-cleavage-trafficking-delay-t-n-reference> a schema:PropertyValue ;
        dcterms:source "Herrgen et al. (2010) Current Biology 20:1244-1253 (coupling delay sets the collective period; the tabulated regime 4 lengthening 30.0 -> 32.5 min is the reference magnitude, direction only is claimed)" ;
        schema:value "2.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "DeltaC-Notch wild-type PSM synchronization order parameter R_sync vs bea/des/aei mutant = 0.9835 Kuramoto R" ;
        dcterms:description "Notch mutant preserves 6 anterior somites before R_sync drops to 0.2316" ;
        schema:measurementTechnique "32-cell stochastic PSM phase-oscillator chain over 14 cycles (WT kappa=0.35 -> 14/14 intact somites vs Notch mutant kappa=0 -> 6 intact anterior somites, late R=0.2316)" ;
        schema:name "DeltaC-Notch wild-type PSM synchronization order parameter R_sync vs bea/des/aei mutant" ;
        schema:unitText "Kuramoto R" ;
        schema:value "0.9835" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant-reference> a schema:PropertyValue ;
        dcterms:source "Lewis (2003) Current Biology 13:1398-1408 Figs. 5-6 (Notch-coupled synchrony R > 0.95 vs bea/des/aei desynchronization after 5-7 anterior somites)" ;
        schema:value "0.965" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r-model-computed> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Lewis (2003) 5-regime segmentation clock period prediction Pearson correlation r (model-computed) = 0.7912 Pearson r" ;
        dcterms:description "Pass 2 reported r=0.9999 by correlating the JSON-tabulated predicted column with the JSON observed column; 1 tabulated oscillating regime(s) (her7 fast loop, T_tot=6.3 min) lie below the computed Hopf threshold T_crit=7.54 min and are predicted damped by the model itself" ;
        schema:measurementTechnique "RK4 DDE period per regime vs observed period across 5 delay perturbation regimes (WT her1/her7, pure her7 fast loop, pure her1 slow loop, Notch collective delay slowing, intron-deletion/CHX arrest); RMSE=11.839 min; Box-1-law-with-computed-T_crit r=0.7899" ;
        schema:name "Lewis (2003) 5-regime segmentation clock period prediction Pearson correlation r (model-computed)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.7912" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r-model-computed-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r-model-computed-reference> a schema:PropertyValue ;
        dcterms:source "Lewis (2003) Current Biology 13:1398-1408; Giudicelli et al. (2007) PLoS Biology 5:e150; Herrgen et al. (2010) Current Biology 20:1244-1253" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-rk4-dde-wild-type-period-vs-lewis-box-1-analytic-period-law-discrepancy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RK4 DDE wild-type period vs Lewis Box 1 analytic period law discrepancy = 33.62 min" ;
        dcterms:description "the DDE runs 12.1% slower than the Box 1 estimate with the canonical parameters; her1-only (T_m=9.5, T_p=2.8) DDE period = 42.91 min" ;
        schema:measurementTechnique "numerical DDE period (T_m=7.18, T_p=1.80, a=4.5, b=c=0.23, k=33, p0=40, n=2, dt=0.02 min, peaks over [120,300] min) vs Box 1 law 2*(T_tot + ln2/b + ln2/c) = 30.01 min" ;
        schema:name "RK4 DDE wild-type period vs Lewis Box 1 analytic period law discrepancy" ;
        schema:unitText "min" ;
        schema:value "33.62" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-rk4-dde-wild-type-period-vs-lewis-box-1-analytic-period-law-discrepancy-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-rk4-dde-wild-type-period-vs-lewis-box-1-analytic-period-law-discrepancy-reference> a schema:PropertyValue ;
        dcterms:source "Lewis (2003) Current Biology 13:1398-1408 Box 1 (~30 min at 28 C); the Box 1 law is explicitly an approximation" ;
        schema:value "30.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-schroter-2012-truth-table-hes6-titration-single-cell-period-span-from-hes6-0-to-90> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schroter (2012) truth-table Hes6 titration: single-cell period span from Hes6 = 0 to 90 = 4.85 min" ;
        dcterms:description "Hes6 = 0 period 41.20 min vs her1-only single-cell DDE 42.91 min; Hes6 >~ 80 (K_76=150) quenches the oscillation because the her7 branch alone is Hopf-subcritical" ;
        schema:measurementTechnique "noise-free uncoupled truth-table oscillator at Hes6 in {0, 4, 10, 20, 40, 60, 90}: periods 41.2, 40.6, 40.1, 39.3, 38.3, 37.6, 36.4 min (monotone decreasing: True)" ;
        schema:name "Schroter (2012) truth-table Hes6 titration: single-cell period span from Hes6 = 0 to 90" ;
        schema:unitText "min" ;
        schema:value "4.85" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-schroter-2012-truth-table-hes6-titration-single-cell-period-span-from-hes6-0-to-90-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-schroter-2012-truth-table-hes6-titration-single-cell-period-span-from-hes6-0-to-90-reference> a schema:PropertyValue ;
        dcterms:source "model-internal: her1-only (T_m=9.5, T_p=2.8) minus lumped WT (T_m=7.18, T_p=1.8) RK4 DDE periods; Schroter et al. (2012) PLoS Biology 10:e1001364 give the direction (Her7:Hes6 fast loop displaces Her1 homodimer slow loop) but no period-vs-Hes6 table" ;
        schema:value "9.29" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-supercritical-hopf-bifurcation-critical-delay-threshold-t-crit-t-m-t-p> a schema:PropertyValue,

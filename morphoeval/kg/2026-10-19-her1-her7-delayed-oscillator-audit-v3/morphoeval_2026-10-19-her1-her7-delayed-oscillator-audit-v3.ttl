<https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lewis (2003) Her1/Her7 Autoinhibitory Delay-Loop Invariance & Protein Translation Balance" ;
    dct:description "Establishes the intracellular delayed negative feedback loop of the zebrafish segmentation clock and proves that stability and period depend only on the sum T_tot = T_m + T_p | Variables: m(t): her1/her7 mRNA molecules per cell; p(t): Her1/Her7 repressor protein molecules per cell; T_m: transcriptional delay (min); T_p: translational delay (min)" ;
    dct:source "Lewis (2003) Current Biology 13(16):1398-1408 Eqs. 1-2 & Appendix" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L154-L239>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L27-L56> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def lewis_protein_dde_residual (a m_delayed b p : Int) : Int :=
  a * m_delayed - b * p
def lewis_total_loop_delay (T_m T_p : Int) : Int :=
  T_m + T_p
theorem lewis_2003_protein_steady_state_and_delay_invariance (a b q T_m T_p delta : Int) :
    lewis_protein_dde_residual a (b * q) b (a * q) = 0 ∧
    lewis_total_loop_delay (T_m + delta) (T_p - delta) = lewis_total_loop_delay T_m T_p"""^^pk:lean4 ;
    skos:notation "dp(t)/dt = a * m(t - T_p) - b * p(t),  dm(t)/dt = k / (1 + (p(t - T_m) / p_0)^n) - c * m(t),  T_tot = T_m + T_p" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1371/journal.pbio.0050150>,
        <https://doi.org/10.1371/journal.pbio.1001364> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_022.lewis_protein_dde_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_022.lewis_2003_protein_steady_state_and_delay_invariance" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lewis (2003) Delay-Driven Oscillation Period & Hopf Bifurcation Law" ;
    dct:description "Predicts the ~30 min zebrafish somite clock period from transcriptional/translational delays plus macromolecular half-lives and explains period shifts under intron deletion or Notch delay changes | Variables: T_osc: segmentation clock oscillation period (min); T_crit: Hopf bifurcation critical delay threshold (7.54 min computed); tau_m, tau_p: mRNA and protein half-life relaxation times (min)" ;
    dct:source "Lewis (2003) Current Biology 13(16):1398-1408 Box 1 & Figs. 2-3; Giudicelli et al. (2007) PLoS Biology 5:e150" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L219-L426>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L58-L76> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def lewis_oscillation_period (T_m T_p tau_m tau_p : Nat) : Nat :=
  2 * (T_m + T_p + tau_m + tau_p)
theorem lewis_2003_oscillation_period_delay_sensitivity (T_m T_p tau_m tau_p delta_Tm : Nat) :
    lewis_oscillation_period (T_m + delta_Tm) T_p tau_m tau_p =
      lewis_oscillation_period T_m T_p tau_m tau_p + 2 * delta_Tm"""^^pk:lean4 ;
    skos:notation "T_osc = 2 * (T_m + T_p + tau_m + tau_p)  for  T_m + T_p > T_crit" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1371/journal.pbio.0050150>,
        <https://doi.org/10.1371/journal.pbio.1001364> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_022.lewis_oscillation_period" ;
    pk:leanTheorem "MathOfBiology.Loop_022.lewis_2003_oscillation_period_delay_sensitivity" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lewis (2003) DeltaC-Notch Intercellular Synchronization vs bea/des/aei Mutant Desynchronization Law" ;
    dct:description "Explains how intercellular DeltaC-Notch signaling maintains phase synchrony (R_sync > 0.95) against molecular copy-number noise in wild-type PSM, whereas Notch mutants (bea, des, aei; kappa=0) form 5-7 normal anterior somites before desynchronizing into salt-and-pepper defects | Variables: kappa: intercellular DeltaC-Notch phase-coupling strength; Delta_phi: phase difference between adjacent PSM cells; R_sync: Kuramoto tissue synchronization order parameter" ;
    dct:source "Lewis (2003) Current Biology 13(16):1398-1408 Figs. 5-6; Herrgen et al. (2010) Current Biology 20:1244-1253" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L429-L522>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L78-L98> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def notch_phase_difference_step (kappa Delta_phi delta_omega : Int) : Int :=
  (1 - kappa) * Delta_phi + delta_omega
theorem lewis_2003_notch_coupling_synchronization_contraction (Delta_phi delta_omega : Int) :
    notch_phase_difference_step 1 Delta_phi 0 = 0 ∧
    notch_phase_difference_step 0 Delta_phi delta_omega = Delta_phi + delta_omega"""^^pk:lean4 ;
    skos:notation "Delta_phi_next = (1 - kappa) * Delta_phi + delta_omega;  R_sync = |1/N * sum_j exp(i * theta_j)|" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1371/journal.pbio.0050150>,
        <https://doi.org/10.1371/journal.pbio.1001364> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_022.notch_phase_difference_step" ;
    pk:leanTheorem "MathOfBiology.Loop_022.lewis_2003_notch_coupling_synchronization_contraction" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lewis (2003) 2D Multicellular DDE Lattice: Notch-Gated her Transcription with Delayed DeltaC Translation & NICD Cleavage (Pass 3)" ;
    dct:description "Extends the 1D phase chain to an explicit 8 x 24 multicellular DDE sheet in which DeltaC protein is translated with delay, cleaved Notch (NICD) gates her1/her7 transcription, and eps_N = 0 reproduces the bea/des/aei loss of coupling (5-7 coherent anterior cycles before salt-and-pepper desynchronisation); a uniform DeltaC field is a fixed point of the coupling | Variables: N_i: NICD molecules in cell i; Dbar_i: mean DeltaC protein of the 4 von Neumann neighbours; T_N: Notch binding/gamma-secretase cleavage/nuclear-entry delay (min); T_pD: DeltaC translation+trafficking delay (min); eps_N: Notch-dependent fraction of her transcription (0 in bea/des/aei); K_D, N_0, h: NICD occupancy constants" ;
    dct:source "Lewis (2003) Current Biology 13(16):1398-1408 Figs. 5-6 (coupled-cell DDEs); Herrgen et al. (2010) Current Biology 20:1244-1253 (coupling delay sets collective period)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L544-L735>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L112-L144> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def notch_transcription_gate (eps_N s : Int) : Int :=
  (1 - eps_N) + eps_N * s
theorem lewis_2003_notch_gate_mutant_independence (s : Int) :
    notch_transcription_gate 0 s = 1 ∧ notch_transcription_gate 1 s = s
def deltac_neighbour_mean (D_up D_down D_left D_right : Nat) : Nat :=
  (D_up + D_down + D_left + D_right) / 4
theorem deltac_lattice_uniform_neighbour_mean_fixed_point (D : Nat) :
    deltac_neighbour_mean D D D D = D"""^^pk:lean4 ;
    skos:notation "dN_i/dt = k_N * Dbar_i(t - T_N) / (K_D + Dbar_i(t - T_N)) - b_N * N_i;  G_N(N) = (1 - eps_N) + eps_N * N^h / (N_0^h + N^h);  Dbar_i = (D_up + D_down + D_left + D_right) / 4;  dD_i/dt = a_D * d_i(t - T_pD) - b_D * D_i" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1371/journal.pbio.0050150>,
        <https://doi.org/10.1371/journal.pbio.1001364> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_022.notch_transcription_gate" ;
    pk:leanTheorem "MathOfBiology.Loop_022.lewis_2003_notch_gate_mutant_independence" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/lewis-her1-her7-delayed-oscillator-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schroter et al. (2012) Her1/Her7/Hes6 Dimer DNA-Binding Truth Table on the AP Hes6 Gradient (Pass 3)" ;
    dct:description "Couples the anterior-to-posterior phase gradient to the dimer composition: Hes6-high posterior cells are repressed through the short-delay Her7:Hes6 loop (faster), Hes6-low anterior cells through the Her1 homodimer loop (slower), hes6-null tissue is AP-uniform at the her1-only period; the lattice AP period gradient is bracketed by the pure-branch periods | Variables: p1, p7: Her1, Her7 protein molecules; h6: non-oscillating Hes6 protein (posterior-high AP gradient); B_AB: DNA-binding truth table bit; K_11, K_76: dimer dissociation constants (reduced parameters); T7, T1: her7 (fast) and her1 (slow) loop delays; w, v: Hes6-dependent repression weights" ;
    dct:source "Schroter et al. (2012) PLoS Biology 10(7):e1001364 Figs. 2-3 (dimerization and DNA binding), Figs. 5-7 (hes6 gradient, genetic interactions); Giudicelli et al. (2007) PLoS Biology 5:e150 (kinematic waves)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L532-L596,L852-L874>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L146-L190> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def schroter_dimer_repression (B11 B76 B17 B16 B77 B66 p1 p7 h6 : Nat) : Nat :=
  B11 * (p1 * p1) + B76 * (p7 * h6) + B17 * (p1 * p7) + B16 * (p1 * h6) + B77 * (p7 * p7) + B66 * (h6 * h6)
theorem schroter_2012_dimer_truth_table_repression (p1 p7 h6 : Nat) :
    schroter_dimer_repression 1 1 0 0 0 0 p1 p7 h6 = p1 * p1 + p7 * h6 ∧
    schroter_dimer_repression 1 1 0 0 0 0 p1 p7 0 = p1 * p1
def hes6_weighted_loop_delay (w v T7 T1 : Nat) : Nat :=
  w * T7 + v * T1
theorem schroter_2012_hes6_gradient_period_interpolation (w v T7 T1 : Nat) (h : T7 ≤ T1) :
    (w + v) * T7 ≤ hes6_weighted_loop_delay w v T7 T1 ∧
    hes6_weighted_loop_delay w v T7 T1 ≤ (w + v) * T1"""^^pk:lean4 ;
    skos:notation "Rep_i = sum_{(A,B)} B_AB * [A:B]_i / K_AB,  [A:B] = A * B;  B_11 = B_76 = 1, B_17 = B_16 = B_77 = B_66 = 0;  Hes6_i = H_ant + (H_post - H_ant) * x_i / (n_cols - 1);  (w + v) T7 <= w T7 + v T1 <= (w + v) T1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0960-9822(03)00534-7>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1371/journal.pbio.0050150>,
        <https://doi.org/10.1371/journal.pbio.1001364> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Time-Delayed Transcriptional Oscillator & DeltaC-Notch Phase Coupling (Somitogenesis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_022.schroter_dimer_repression" ;
    pk:leanTheorem "MathOfBiology.Loop_022.schroter_2012_dimer_truth_table_repression" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/lewis-her1-her7-delayed-oscillator-1> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Lewis (2003) Her1/Her7 Autoinhibitory Delay-Loop Invariance & Protein Translation Balance" ;

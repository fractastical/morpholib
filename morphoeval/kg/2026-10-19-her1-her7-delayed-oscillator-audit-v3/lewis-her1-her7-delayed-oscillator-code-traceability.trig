sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator, DeltaC-Notch synchronization, and (Pass 3) 2D her1/her7/deltaC DDE lattice with NICD kinetics on a Schroter (2012) Hes6 dimer-truth-table gradient — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-85) now states five laws, each mapped to its Lean theorem(s) and to Lewis Eqs. 1-2 / Box 1 / Figs. 5-6 or Schroter Figs. 2-3, 5-7; the lattice equations are written out variable by variable; every lattice/truth-table function docstring names its law id and Lean theorem; `math_kg_loops/lewis-her1-her7-delayed-oscillator.yaml` registers laws 4-5 with code loci. Deductions: the NICD kinetics and the Notch gate are declared as this script's reduced forms without a traceable equation in the sources (-4); the 1D-chain coupling coefficient 2.4 (L481) and the lattice constants k_N = 0.7, b_N = 0.35, K_D = 600, h = 3 are uncited calibrations (-3); Panel D's bar hatching distinguishes tabulated from computed but the GIF still shows the 1D chain's assumed 30 min period on its x-scale (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2003-lewis-her1-her7-delayed-oscillator.py L544–L556: LATTICE_DEFAULTS: NICD/gate constants are reduced calibrations with a comment but no source equation <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L544-L556>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L24–L85" ;
        dct:description "Docstring laws 1-5 with equations, Lean theorem names, Box 1 disclosure and reduced-parameter statement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L24-L85> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/lewis-her1-her7-delayed-oscillator.yaml L39–L172" ;
        dct:description "Laws 1-5 with lean_locus, lean_code and updated code_locus ranges" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/lewis-her1-her7-delayed-oscillator.yaml#L39-L172> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


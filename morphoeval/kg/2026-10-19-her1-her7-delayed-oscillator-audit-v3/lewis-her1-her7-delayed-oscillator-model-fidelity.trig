sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator, DeltaC-Notch synchronization, and (Pass 3) 2D her1/her7/deltaC DDE lattice with NICD kinetics on a Schroter (2012) Hes6 dimer-truth-table gradient — Model fidelity to source: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The single-cell DDEs, the characteristic-equation Hopf threshold (T_crit = 7.54 min) and the Box 1 law are Lewis's (L154-355). The Pass 3 lattice implements the coupled-cell structure of Lewis Figs. 5-6 explicitly: deltaC mRNA repressed by the her dimers, DeltaC protein translated after T_pD, neighbour DeltaC driving NICD, NICD gating her transcription with eps_N = 0 in mutants (L682-704), and the Schroter truth table enters as a mass-action repression functional (L558-587). Deductions: the NICD production/decay form k_N Dbar/(K_D + Dbar) - b_N N, the gate G_N, h = 3, N_0 = 1 are this script's reduced kinetics, not equations from the sources (-4); the tabulated her7 regime (T_tot = 6.3 min) is subcritical under the implemented threshold and the Box 1 law is 12% off the DDE, so the model's own numbers disagree with the dataset's and with each other (-4); Hes6 >~ 80 quenches the oscillation, contradicting robust posterior PSM oscillation (-2); the her7 branch repression is linear in Her7 (no Hill cooperativity), unlike Lewis's n = 2 form (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2003-lewis-her1-her7-delayed-oscillator.py L358–L406: Regime evaluator exposes that the her7 regime is Hopf-subcritical (supercritical=False, T_calc = T_dde = 0.0) against a tabulated 24.65 min <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L358-L406>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-4> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L154–L217" ;
        dct:description "Fixed point and exact characteristic-root Hopf threshold T_crit = 7.54 min for the canonical parameters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L154-L217> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L598–L734" ;
        dct:description "8x24 DDE lattice: 7 delayed variables per cell, Heun method-of-steps, delayed DeltaC translation, NICD Michaelis-Menten cleavage (L693-701), Notch gate (L688), Langevin noise (L713)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L598-L734> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L532–L595" ;
        dct:description "Schroter (2012) DNA-binding truth table and mass-action repression functional with hes6 = 0 reducing to the Her1 homodimer loop; Hes6 gradient profile" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2003-lewis-her1-her7-delayed-oscillator.py#L532-L595> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean L106–L190" ;
        dct:description "4 new machine-checked theorems: Notch gate mutant independence, uniform-DeltaC fixed point, truth-table reduction, Hes6-weighted delay bracketing (0 sorrys, lean exit 0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L106-L190> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


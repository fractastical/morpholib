    <https://doi.org/10.1016/S0092-8674(00)00012-X> dcterms:date "2000"^^xsd:gYear ;
        dcterms:title "Topographic mapping from the retina to the midbrain is controlled by relative but not absolute levels of EphA receptor signaling" .

    <https://doi.org/10.1098/rspb.1975.0087> dcterms:date "1975"^^xsd:gYear ;
        dcterms:title "On a role for competition in the formation of patterned neural connexions" .


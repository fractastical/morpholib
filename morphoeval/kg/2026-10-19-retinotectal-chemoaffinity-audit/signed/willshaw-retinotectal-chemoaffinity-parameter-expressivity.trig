sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-willshaw-retinotectal-chemoaffinity> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Prestige & Willshaw (1975) & Brown et al. (2000) EphA/ephrin-A retinotectal chemoaffinity & synaptic competition — Parameter expressivity: 55/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Covers only 3 static curves (WT argmin, uncoupled KI argmin, Group I truncation), omitting heterozygous ki/+ vs homozygous ki/ki Group II bifurcation, surgical half-tectum compression (slope -0.50), surgical half-retina expansion (slope -2.00), Ephrin-A2/A5 DKO scrambled control, and a 2D (Delta_R_EphA3, mu_comp) morphospace sweep." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1976-willshaw-retinotectal-chemoaffinity.py L63–L78: 3 static curves without Group II compression/expansion or DKO control <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L63-L78>" ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


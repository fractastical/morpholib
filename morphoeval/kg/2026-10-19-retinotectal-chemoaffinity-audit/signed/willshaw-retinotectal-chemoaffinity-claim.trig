sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-willshaw-retinotectal-chemoaffinity> a pk:Claim ;
        rdfs:label "Prestige & Willshaw (1975) & Brown et al. (2000) EphA/ephrin-A retinotectal chemoaffinity & synaptic competition faithfully reproduces Danio rerio zebrafish / Mus musculus vertebrate retinotectal-retinocollicular projection morphology" ;
        dcterms:description "The simulation script(s) 1976-willshaw-retinotectal-chemoaffinity.py implement the cited source model as published and produce forms that match real Danio rerio zebrafish / Mus musculus vertebrate retinotectal-retinocollicular projection specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 56.3/100, audit 2026-10-19-retinotectal-chemoaffinity-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py; output: docs/media/retinotectal_chemoaffinity_comparison.png; organism: Danio rerio zebrafish / Mus musculus vertebrate retinotectal-retinocollicular projection; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 291d0b05f4ef97593e7998ed422cf0c6840ddc0d18ee83dd5143a46bbb22b878; artifact_sha256: f19fc94ecfbc8595859748ac2db860d7be48578ec498607d7bd8f90ffcdccf60; input_dataset_sha256: {datasets/retinotectal_chemoaffinity/paper_citations.bib=aad29a956cd55dc1..., datasets/retinotectal_chemoaffinity/retinotectal_chemoaffinity_reference.json=86046fcab644c7a3..., datasets/retinotectal_chemoaffinity/scout_manifest.json=5ccb8a42580e5070..., datasets/retinotectal_chemoaffinity/zebrafish_retinotectal_specimen.jpg=e16ecb3325a48823...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/S0092-8674(00)00012-X>,
            <https://doi.org/10.1098/rspb.1975.0087>,
            <https://doi.org/10.1098/rspb.1976.0087>,
            <https://doi.org/10.1186/1471-2202-5-30> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-specimen-match> ;
        pk:weightOfEvidence "0.563"^^xsd:double .


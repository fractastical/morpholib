sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-willshaw-retinotectal-chemoaffinity> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-willshaw-retinotectal-chemoaffinity-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Prestige & Willshaw (1975) & Brown et al. (2000) EphA/ephrin-A retinotectal chemoaffinity & synaptic competition — Morphometric validation: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports only 2 baseline metrics in `measure_morphoeval()`, lacking ki/ki dual-map rostral/caudal branch separation under Group II competition, half-tectum compression slope (-0.50), half-retina expansion slope (-2.00), Ephrin-A2/A5 DKO polarity collapse, and specimen radial/angular CV morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1976-willshaw-retinotectal-chemoaffinity.py L143–L166: Baseline 2-metric measure_morphoeval() hook <https://github.com/fractastical/morpholib/blob/317bc3c/1976-willshaw-retinotectal-chemoaffinity.py#L143-L166>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-isl2-epha3-knock-in-anterior-shift-separation-delta-y>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-wild-type-retinotectal-topographic-map-slope-dy-dx> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-isl2-epha3-knock-in-anterior-shift-separation-delta-y> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Isl2-EphA3 knock-in anterior shift separation delta_y = 0.4346 normalized tectal AP fraction" ;
        dcterms:description "Uncoupled shift = 0.4346 (without Group II caudal displacement of WT axons)" ;
        schema:measurementTechnique "Uncoupled mean shift between Isl2- and Isl2+ RGC minima" ;
        schema:name "Isl2-EphA3 knock-in anterior shift separation delta_y" ;
        schema:unitText "normalized tectal AP fraction" ;
        schema:value "0.4346" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-isl2-epha3-knock-in-anterior-shift-separation-delta-y-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-isl2-epha3-knock-in-anterior-shift-separation-delta-y-reference> a schema:PropertyValue ;
        dcterms:source "Brown et al. (2000) Cell 102:77-88 Fig. 3" ;
        schema:value "0.46" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-wild-type-retinotectal-topographic-map-slope-dy-dx> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type retinotectal topographic map slope dy*/dx = -1.0 tectal/retinal slope" ;
        dcterms:description "Baseline 1D argmin slope = -1.0000" ;
        schema:measurementTechnique "1D argmin of chemoaffinity energy E_chem(x,y)" ;
        schema:name "Wild-type retinotectal topographic map slope dy*/dx" ;
        schema:unitText "tectal/retinal slope" ;
        schema:value "-1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-wild-type-retinotectal-topographic-map-slope-dy-dx-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-willshaw-retinotectal-chemoaffinity-measurement-wild-type-retinotectal-topographic-map-slope-dy-dx-reference> a schema:PropertyValue ;
        dcterms:source "Prestige & Willshaw (1975) Proc. R. Soc. B 190:77-98; Brown et al. (2000) Cell 102:77-88" ;
        schema:value "-1.0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


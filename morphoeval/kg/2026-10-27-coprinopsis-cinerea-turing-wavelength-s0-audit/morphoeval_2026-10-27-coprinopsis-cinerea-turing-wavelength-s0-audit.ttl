<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Coprinopsis cinerea Schnakenberg wavelength selection at 77 µm (Pass 1) — Model fidelity to source: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script implements Schnakenberg kinetics, the steady state, the Jacobian, and k_c² = γ sqrt(det J / (D_u D_v)) with γ solved for 7.744e-05 m. Pass 1 does not yet treat the sweep and ablations as part of the accepted model claim. The kinetics are a standard Turing substrate, not a Coprinopsis circuit." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .


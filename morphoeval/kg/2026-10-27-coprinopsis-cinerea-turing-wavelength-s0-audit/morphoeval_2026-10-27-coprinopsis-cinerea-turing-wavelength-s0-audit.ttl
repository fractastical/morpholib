<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-coprinopsis-cinerea-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-coprinopsis-cinerea-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-coprinopsis-cinerea-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-coprinopsis-cinerea-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Necessary trace condition for a Turing band at this slot's diffusion ratio | Variables: Dv=16, Du=1, fu=4/5, gv=-1 at the Holocene 77.44 µm operating point" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/morphoeval/lean/loops/Loop_3154_coprinopsis_cinerea_turing_wavelength_s0.lean#L14-L18> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def traceMargin (Dv Du fuNum fuDen gvNum : Int) : Int := Dv * fuNum + Du * gvNum * fuDen

theorem operating_trace_positive : traceMargin 16 1 4 5 (-1) > 0 := by decide"""^^pk:lean4 ;
    skos:notation "k_c^2 = γ * sqrt(det(J) / (D_u * D_v)); λ_c = 2π / k_c = 7.744e-05 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1003391107>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1128/MMBR.64.2.316-353.2000> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3154.traceMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3154.operating_trace_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-coprinopsis-cinerea-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control that wavelength selection requires differential diffusion | Variables: Dv=Du=1, same Jacobian" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/morphoeval/lean/loops/Loop_3154_coprinopsis_cinerea_turing_wavelength_s0.lean#L20-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem equal_diffusion_trace_negative : traceMargin 1 1 4 5 (-1) < 0 := by decide"^^pk:lean4 ;
    skos:notation "D_v = D_u implies D_v f_u + D_u g_v < 0 for these kinetics, so σ(k) < 0 for every k" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1003391107>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1128/MMBR.64.2.316-353.2000> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3154.traceMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3154.equal_diffusion_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-coprinopsis-cinerea-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail-variant scale contrast at 0 Ma" ;
    dct:description "What changes at this scale versus the tier floor, given a 1/1 Holocene chronoseries | Variables: λ encoded in hundredths of a micrometre (7744 = 77.44 µm); tier floor 1000 = 10.00 µm; age 0 Ma" ;
    dct:source "Kües (2000) DOI:10.1128/MMBR.64.2.316-353.2000" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/morphoeval/lean/loops/Loop_3154_coprinopsis_cinerea_turing_wavelength_s0.lean#L25-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem detail_variant_between_seven_and_eight_floors : 7 * 1000 < 7744 ∧ 7744 < 8 * 1000 := by decide"^^pk:lean4 ;
    skos:notation "7 * 10 µm < 77.44 µm < 8 * 10 µm; chronoseries 1/1 has successor count 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1003391107>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1128/MMBR.64.2.316-353.2000> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3154.detail_variant_between_seven_and_eight_floors" ;
    pk:leanTheorem "MathOfBiology.Loop_3154.holocene_terminus_has_no_successor" ;
    pk:leanVerified true .


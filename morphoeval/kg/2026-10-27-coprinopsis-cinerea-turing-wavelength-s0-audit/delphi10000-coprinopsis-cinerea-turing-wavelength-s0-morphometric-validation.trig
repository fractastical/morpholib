}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Coprinopsis cinerea Schnakenberg wavelength selection at 77 µm (Pass 1) — Morphometric validation: 60/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The linear calibration hits 77.44 µm by construction. Pearson, RMSE, KS, and the specimen-mask metrics are not yet accepted, so this dimension stays near the baseline-plus-calibration score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-detail-variant-ratio-vs-tier-floor>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-gamma-sweep-mode-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-linear-critical-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-off-band-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-on-band-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-simulated-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-cap-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-cap-segment-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-gill-stripe-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-detail-variant-ratio-vs-tier-floor> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "detail_variant_ratio_vs_tier_floor = 7.744 1" ;
        dct:description "Chronoseries 1/1 has no predecessor species. The 10 µm floor is the scale contrast: γ would have to rise by DETAIL_RATIO², or D_u D_v fall by DETAIL_RATIO⁴, to select 10 µm instead of 77.44 µm at Holocene age 0." ;
        schema:measurementTechnique "λ_slot / 10 µm tier floor" ;
        schema:name "detail_variant_ratio_vs_tier_floor" ;
        schema:unitText "1" ;
        schema:value "7.744" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-detail-variant-ratio-vs-tier-floor-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-detail-variant-ratio-vs-tier-floor-reference> a schema:PropertyValue ;
        dct:source "a pattern sitting on the tier floor rather than the detail variant" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_ks_statistic = 0.095238 1" ;
        dct:description "ks_pvalue=0.999996" ;
        schema:measurementTechnique "two-sample KS statistic between analytic and numeric σ samples" ;
        schema:name "dispersion_ks_statistic" ;
        schema:unitText "1" ;
        schema:value "0.095238" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.999897 1" ;
        dct:description "RMSE=0.01552; KS=0.0952; p=1; n_bins=21" ;
        schema:measurementTechnique "Pearson r of binned analytic vs Euler growth rates σ(k²_disc)" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999897" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "identity (perfect linear-stability match)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.015519 1/time" ;
        dct:description "Includes the discrete-Laplacian symbol, not a continuum k² approximation." ;
        schema:measurementTechnique "RMSE between binned analytic and numeric σ" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.015519" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "perfect overlay" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_amplitude_ratio = 0.310357 1" ;
        dct:description "Ablation: equal diffusion fails D_v f_u + D_u g_v > 0, so the ratio collapses relative to the Turing run." ;
        schema:measurementTechnique "mode-8 amplitude ratio with D_v reset equal to D_u" ;
        schema:name "equal_diffusion_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "0.310357" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-equal-diffusion-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "same seed and mode with D_v/D_u = 16" ;
        schema:value "2.7176169589911083" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-gamma-sweep-mode-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma_sweep_mode_pearson_r = 0.993158 1" ;
        dct:description "k_c scales as √γ; this is the parameter-expressivity check for wavelength selection." ;
        schema:measurementTechnique "Pearson r of analytic vs numeric fastest-mode index across an 8-point γ sweep" ;
        schema:name "gamma_sweep_mode_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.993158" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-gamma-sweep-mode-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-gamma-sweep-mode-pearson-r-reference> a schema:PropertyValue ;
        dct:source "identity" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-linear-critical-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear_critical_wavelength_um = 77.44 µm" ;
        dct:description "Operating-point calibration versus the rounded 77 µm label." ;
        schema:measurementTechnique "λ = 2π/k_c with k_c² = γ √(det J /(D_u D_v)) at the operating γ" ;
        schema:name "linear_critical_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "77.44" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-linear-critical-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-linear-critical-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "nominal 77 µm label; exact calibration target is 77.44 µm" ;
        schema:value "77.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-off-band-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "off_band_amplitude_ratio = 0.607762 1" ;
        dct:description "Negative control: a 48 px stripe is outside the Turing band and must decay." ;
        schema:measurementTechnique "mode-2 cosine amplitude after 500 steps divided by its initial amplitude" ;
        schema:name "off_band_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "0.607762" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-off-band-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-off-band-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "marginal" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-on-band-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "on_band_amplitude_ratio = 2.717617 1" ;
        dct:description "On-band control at m = 8 (12 px = 77.44 µm). Ratio > 1 means the band amplifies." ;
        schema:measurementTechnique "mode-8 cosine amplitude after 500 steps divided by its initial amplitude" ;
        schema:name "on_band_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "2.717617" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-on-band-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-on-band-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "marginal (no growth)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-simulated-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated_stripe_wavelength_um = 68.835556 µm" ;
        dct:description "Saturated nonlinear peak need not sit exactly on the linear k_c; reference is the assigned scale, not a copy of the measurement." ;
        schema:measurementTechnique "radial FFT peak of the saturated activator on the 96² grid, times µm/px" ;
        schema:name "simulated_stripe_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "68.835556" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-simulated-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-simulated-stripe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "slot assignment 7.744e-05 m (nominal 77 µm, log10=-4.111)" ;
        schema:value "77.44" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-cap-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_cap_circularity = 0.23107 1" ;
        dct:description "The photographed cap is torn around the stipe and is not a perfect circle." ;
        schema:measurementTechnique "4π Area / Perimeter² of the largest brown gill-disc component" ;
        schema:name "specimen_cap_circularity" ;
        schema:unitText "1" ;
        schema:value "0.23107" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-cap-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-cap-circularity-reference> a schema:PropertyValue ;
        dct:source "perfect circular disc" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-cap-segment-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_cap_segment_fraction = 0.099466 1" ;
        dct:description "Real foreground fraction of the cap on Igor Yevdokimov's 2015 photograph." ;
        schema:measurementTechnique "pixel fraction of the largest gill-brown connected component" ;
        schema:name "specimen_cap_segment_fraction" ;
        schema:unitText "1" ;
        schema:value "0.099466" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-cap-segment-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-cap-segment-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-frame prior" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.821974 1" ;
        dct:description "The fruiting body and grass fill the frame; this is not a line plot." ;
        schema:measurementTechnique "fraction of pixels whose luminance differs from the border median by > 0.06" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.821974" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "sparse-object prior" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-gill-stripe-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_gill_stripe_coherency = 0.632551 1" ;
        dct:description "Cap lamellae versus the grass-dominated frame. Values differ; neither is copied onto the other." ;
        schema:measurementTechnique "mean structure-tensor coherency inside the gill-disc mask" ;
        schema:name "specimen_gill_stripe_coherency" ;
        schema:unitText "1" ;
        schema:value "0.632551" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-gill-stripe-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-measurement-specimen-gill-stripe-coherency-reference> a schema:PropertyValue ;
        dct:source "same photograph, coherency averaged over the whole frame (grass plus cap)" ;
        schema:value "0.6140482926951177" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py L147–L159" ;
        dct:description "operating_gamma and micrometres per pixel" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb/models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py#L147-L159> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


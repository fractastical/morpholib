sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-coprinopsis-cinerea-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Coprinopsis cinerea Schnakenberg wavelength selection at 77 µm (Pass 1) — MorphoEval overall 71.4/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Holocene extant terminus (0 Ma, chronoseries 1/1). Nominal scale 77 µm, exact length 7.744e-05 m (log10 = -4.111), tier 4_cellular_10um detail variant. Schnakenberg kinetics with γ solved so λ_c = 77.44 µm at D_v/D_u = 16 on a 96² periodic cuticle patch. Pass 1 does not yet accept the sweep, ablations, segmentation, or dispersion fit. Overall 71.4/100 (faithfulness 67.4, reproducibility 80.8); rubric morphoeval 0.1.0; checkpoint commit f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb; environment: . Dimension assessments: Model fidelity to source 82, Morphological realism / specimen match 64, Parameter expressivity 58, Morphometric validation 60, Source and data traceability 88, Code-to-model traceability 76, Reproducibility package 78. Output judged: docs/media/coprinopsis_cinerea_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-coprinopsis-cinerea-turing-wavelength-s0.py at f8754f57e6c8e5814e6ac3fcf8739bbd60d4b1bb, image/png, 779099 B, 1536×1152 px, artifact_sha256 3a01f0cb3e83a03aaa543557a6d5f3abeb37caf8954ac25ecaa24f82ffdb9a97 (sha256 3a01f0cb3e83a03aaa543557a6d5f3abeb37caf8954ac25ecaa24f82ffdb9a97), spec_fingerprint 8cece9ff3e72ac6167b2cefe87dfebbabd188f728a6d9a47d37e0816ea971637. Dual provenance: spec_fingerprint: 8cece9ff3e72ac6167b2cefe87dfebbabd188f728a6d9a47d37e0816ea971637; artifact_sha256: 3a01f0cb3e83a03aaa543557a6d5f3abeb37caf8954ac25ecaa24f82ffdb9a97; input_dataset_sha256: {datasets/coprinopsis_cinerea_turing_wavelength_s0/coprinopsis_cinerea_specimen.jpg=f5905e9c02019fc5..., datasets/coprinopsis_cinerea_turing_wavelength_s0/coprinopsis_cinerea_turing_wavelength_s0_reference.json=d4e14ac29c4347af..., datasets/coprinopsis_cinerea_turing_wavelength_s0/paper_citations.bib=7cc51cdbd29c1950...}. Claim boundary: reported_in_source: Turing 1952 critical wavenumber from linear stability of a two-species reaction-diffusion system | Schnakenberg 1979 kinetics f = a - u + u^2 v, g = b - u^2 v | Kües 2000 developmental account of the gilled Coprinus cinereus fruiting body | Stajich et al. 2010 Coprinopsis cinerea genome; reconstructed_in_script: γ calibrated so λ_c = 7.744e-05 m on a 96² grid with 12 px per wave | Explicit Euler and a periodic 5-point Laplacian; transfer_boundary: 77 µm is the assigned atlas scale, not a spacing measured on the photograph | The photograph has no scale bar; mature gills are not the cellular wavelength; does_not_claim: That Schnakenberg parameters were fitted to Coprinopsis biochemistry | A predecessor or successor chronospecies (this series is 1/1 at 0 Ma) | That the growth GIF is a photograph of the fruiting body." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Accept a parameter-regime sweep showing k_c moves monotonically with γ (k_c scales as sqrt(γ)).'}",
            "remediation needed: {'id': 'R2', 'item': 'Accept the negative controls: equal diffusion must decay, and an off-band stripe (mode 2) must decay while mode 8 grows.'}",
            "remediation needed: {'id': 'R3', 'item': 'Accept real specimen CV segmentation of the gill disc (mask, circularity, structure-tensor coherency) with references that are not copies of the measured values.'}",
            "remediation needed: {'id': 'R4', 'item': 'Accept goodness-of-fit of analytic versus Euler dispersion: Pearson r, RMSE, and KS.'}" ;
        pk:hasScore "0.714"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


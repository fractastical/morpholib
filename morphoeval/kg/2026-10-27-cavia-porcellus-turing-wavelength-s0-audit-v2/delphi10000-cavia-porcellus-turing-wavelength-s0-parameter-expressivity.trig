sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cavia porcellus Holocene (0 Ma) Turing wavelength at 126.7 µm (tier-5 detail s0) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Three controls move the pattern as they should. Epsilon raises RMS monotonically (0.137, 0.287, 0.381, 0.524 for epsilon = 0.05, 0.15, 0.25, 0.45) and epsilon = -0.20 collapses the spiral (RMS ratio 0.00264). Removing finite-k selection moves k from 0.986 to 0.261 (wavelength 128.55 µm to 484.5 µm). Raising b at fixed D moves lambda from 176.95 µm (b = 0.20) through 126.7 µm (b = 1.15) and restabilizes the homogeneous state at b = 2.5 and b = 4. Charges m = 1, 2, 3 and four seeds all select the same bin; that is reported as bin-stability, not as a continuous CV estimate." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py L337–L388" ;
        dct:description "Epsilon sweep, negative control, ablation, charge sweep, and seed ensemble" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py#L337-L388> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py L184–L203" ;
        dct:description "b sweep at the s0 diffusivities, including loss of instability for b >= 2.5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py#L184-L203> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (xAI), primary assessor. No second-company assessor was run in this cloud session." ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Cavia porcellus Holocene (0 Ma) Turing wavelength at 126.7 µm (tier-5 detail s0) faithfully reproduces Cavia porcellus (Guinea pig), I. Enaima (Vertebrata) -> Mammalia (Zootoka) -> Cavia morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Cavia porcellus (Guinea pig), I. Enaima (Vertebrata) -> Mammalia (Zootoka) -> Cavia specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py; output: docs/media/cavia_porcellus_turing_wavelength_s0_comparison.png; organism: Cavia porcellus (Guinea pig), I. Enaima (Vertebrata) -> Mammalia (Zootoka) -> Cavia; environment: python 3.12, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Turing (1952) finite-k instability and Murray (1981) coat-pattern wavelength selection. | Schnakenberg (1979) activator-substrate kinetics and the Swift-Hohenberg (1977) amplitude equation as the normal form of a Turing bifurcation (Cross & Hohenberg 1993). | Sick et al. (2006) mammalian follicle-spacing reaction-diffusion, the anatomical scale neighbour of this 126.7 µm slot.; reconstructed_in_script: Diffusivities scaled so lambda_c = 126.7 µm. sigma(k_c) = 0.3006 > 0 and sigma(0) = -0.3215 < 0. | Charge sweep m = 1, 2, 3 and seeds 3141-3144 all fall in radial bin k = 0.9856 (lambda = 128.55 µm). The bin width, not a continuous estimator, sets the ensemble CV to 0. | Substrate sweep at fixed D: lambda_c(0.20) = 176.95 µm and the homogeneous state restabilizes for b >= 2.5. | Gallery segmentation: 110 px = 100 µm, dominant wavelength 78.18 µm, orientation KS 0.077 against the spiral, radial-spectrum cosine 0.987.; transfer_boundary: 126.7 µm and age 0 Ma are the slot assignment for the single Holocene Cavia node. Predecessor tier 1267 µm holds exactly 10 s0 waves; successor tier 12.67 µm fits 10 times inside one s0 wave. | 78.18 µm on the gallery bar is a property of that image, not a correction to the assigned wavelength.; does_not_claim: That Pearson r = 1 is an independent time-stepper confirmation. It is the match between the quadratic formula and numpy.linalg.eigvals (RMSE = 0 at roundoff). | Sub-bin seed robustness. All four seeds share one radial bin. | A published guinea-pig histology plate, a signed nanopublication, or a machine-checked Lean build.]; phenomenon_size: 188 µm (0.0001883 m, log10=-3.725 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 188 µm to 28.5 cm): 188 µm:cavia-porcellus-bioelectric-polarity, 666 µm:cavia-porcellus-vertex-packing, 6.3 mm:cavia-porcellus-turing-wavelength, 2.3 cm:cavia-porcellus-clock-wavefront, 4.0 cm:cavia-porcellus-morphogen-condensation, 5.1 cm:cavia-porcellus-flux-canalization, 5.5 cm:cavia-porcellus-elastic-buckling, 6.6 cm:cavia-porcellus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevA.15.319>,
            <https://doi.org/10.1103/RevModPhys.65.851>,
            <https://doi.org/10.1126/science.1130088> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Cavia porcellus Holocene (0 Ma) Turing wavelength at 126.7 µm (tier-5 detail s0) — Morphological realism / specimen match: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Direct computer-vision similarity of the 12-frame 640x480 GIF against the gallery field is 88.2. Radial-spectrum cosine between the field and the spiral is 0.987. The scale-bar wavelength of that same field is 78.18 µm (110 px = 100 µm, 0.909 µm/px), so the match is textural and orientational (KS = 0.077, segmented coherency 0.198) and is not a claim that the gallery peak sits at 126.7 µm." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;

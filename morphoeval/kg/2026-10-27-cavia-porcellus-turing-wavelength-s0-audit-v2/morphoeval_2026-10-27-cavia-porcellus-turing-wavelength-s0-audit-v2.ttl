<https://w3id.org/delphi/resource/math-law/delphi10000-cavia-porcellus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber from the Schnakenberg Jacobian" ;
    dct:description "Selects the 126.7 µm pigment stripe / ocellus carrier on the Holocene primordium | Variables: D_u, D_v, f_u, g_v at the s0 steady state (a=0.08, b=1.15, D_v/D_u=40)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Murray 1981 DOI:10.1016/0022-5193(81)90334-9; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/morphoeval/lean/loops/Loop_3141_cavia_porcellus_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 126.7 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevA.15.319>,
        <https://doi.org/10.1103/RevModPhys.65.851>,
        <https://doi.org/10.1126/science.1130088> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3141.turingCross" ;
    pk:leanTheorem "MathOfBiology.Loop_3141.activator_inhibitor_cross_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cavia-porcellus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Tenfold tier relation at fixed age 0 Ma" ;
    dct:description "States what changes versus the coarser and finer tiers when the chronoseries has only the Holocene node | Variables: lambda_s0 = 126700 nm, lambda_pred = 1267000 nm, lambda_succ = 12670 nm" ;
    dct:source "Slot 3141 scale ladder; Swift and Hohenberg 1977 DOI:10.1103/PhysRevA.15.319" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/morphoeval/lean/loops/Loop_3141_cavia_porcellus_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_pred = 10 lambda_s0 = 1267 um; lambda_s0 = 10 lambda_succ = 126.7 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevA.15.319>,
        <https://doi.org/10.1103/RevModPhys.65.851>,
        <https://doi.org/10.1126/science.1130088> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3141.lambdaS0Nm" ;
    pk:leanTheorem "MathOfBiology.Loop_3141.pred_holds_ten_s0_waves" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cavia-porcellus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Swift-Hohenberg amplitude equation at the critical wavenumber" ;
    dct:description "Nonlinear stripe/spiral saturation whose linear spectrum peaks at k_c | Variables: epsilon = 0.25, k_c = 1 in wavelength units, spiral charge m = 2" ;
    dct:source "Swift and Hohenberg 1977 DOI:10.1103/PhysRevA.15.319; Cross and Hohenberg 1993 DOI:10.1103/RevModPhys.65.851" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/cc4b7fb74d981b19349d4808476e5b8b2b12f75a/morphoeval/lean/loops/Loop_3141_cavia_porcellus_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "dA/dt = epsilon A - (k_c^2 + laplacian)^2 A - A^3" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevA.15.319>,
        <https://doi.org/10.1103/RevModPhys.65.851>,
        <https://doi.org/10.1126/science.1130088> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3141.lambdaSuccNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3141.s0_holds_ten_successor_waves" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


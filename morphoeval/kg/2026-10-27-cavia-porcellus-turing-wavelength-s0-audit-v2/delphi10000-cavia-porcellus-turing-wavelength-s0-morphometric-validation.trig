        schema:unitText "dimensionless" ;
        schema:value "0.1983" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-of-the-pigment-field-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-of-the-pigment-field-reference> a schema:PropertyValue ;
        dct:source "neutral isotropic baseline; the spiral field is locally oriented" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-substrate-sweep-wavelength-at-b-0-20-with-diffusivities-held-at-the-s0-calibration> a schema:PropertyValue,

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cavia porcellus Holocene (0 Ma) Turing wavelength at 126.7 µm (tier-5 detail s0) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Paired comparison of the quadratic growth rate and numpy.linalg.eigvals on 28 wavenumbers gives Pearson r = 1 and RMSE = 0. This pass labels that pair as an eigensolver identity (the Pass 1 remediation), with a distributional KS of 0.036 between the two sigma samples. Independent of that identity, the simulated bin is 128.55 µm versus analytical 126.7 µm, the gallery wavelength is 78.18 µm, orientation KS is 0.077, and radial cosine is 0.987. None of those specimen or stripe values is copied from its reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-ablation-wavenumber-shift-after-removing-finite-k-selection>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c-of-the-s0-schnakenberg-mode>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-charge-sweep-wavelength-at-topological-charge-m-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-of-analytical-sigma-k-vs-numerical-eigenvalues>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-dispersion-rmse-between-analytical-and-numerical-eigenvalue-growth-rates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-epsilon-sweep-monotonic-amplitude-flag-for-epsilon-0>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-negative-control-rms-ratio-at-epsilon-0-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-orientation-ks-distance-between-specimen-gradients-and-the-simulated-spiral>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-seed-ensemble-coefficient-of-variation-of-the-selected-wavenumber>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-simulated-stripe-wavelength-on-the-eight-wave-primordium>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-pigment-field-dominant-wavelength-from-the-100-m-scale-bar>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-radial-spectrum-cosine-against-the-simulated-spiral>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-of-the-pigment-field>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-substrate-sweep-wavelength-at-b-0-20-with-diffusivities-held-at-the-s0-calibration>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-ablation-wavenumber-shift-after-removing-finite-k-selection> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation wavenumber shift after removing finite-k selection = 0.7241 hat wavenumber" ;
        dct:description "k_full = 0.9856, k_ablate = 0.2615" ;
        schema:measurementTechnique "replace (k_c^2 + Laplacian)^2 by plain diffusion and remeasure the radial peak" ;
        schema:name "ablation wavenumber shift after removing finite-k selection" ;
        schema:unitText "hat wavenumber" ;
        schema:value "0.7241" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-ablation-wavenumber-shift-after-removing-finite-k-selection-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-ablation-wavenumber-shift-after-removing-finite-k-selection-reference> a schema:PropertyValue ;
        dct:source "zero shift would mean the (k_c^2+∇^2)^2 operator is not doing the selection" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c-of-the-s0-schnakenberg-mode> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical Turing wavelength lambda_c of the s0 Schnakenberg mode = 126.7 µm" ;
        dct:description "D_u = 169.1753 µm^2, D_v/D_u = 40.0, h_min = -5.4109" ;
        schema:measurementTechnique "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c after diffusivity scaling" ;
        schema:name "analytical Turing wavelength lambda_c of the s0 Schnakenberg mode" ;
        schema:unitText "µm" ;
        schema:value "126.7" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c-of-the-s0-schnakenberg-mode-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c-of-the-s0-schnakenberg-mode-reference> a schema:PropertyValue ;
        dct:source "Slot 3141 tier-5 detail length 0.0001267 m (Holocene Cavia porcellus, 0 Ma)" ;
        schema:value "126.7" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-charge-sweep-wavelength-at-topological-charge-m-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "charge-sweep wavelength at topological charge m = 1 = 128.5469 µm" ;
        dct:description "charges m=1:λ=128.55, m=2:λ=128.55, m=3:λ=128.55" ;
        schema:measurementTechnique "Swift-Hohenberg spiral at m = 1, radial-spectrum wavelength; m = 2 is the rendered field" ;
        schema:name "charge-sweep wavelength at topological charge m = 1" ;
        schema:unitText "µm" ;
        schema:value "128.5469" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-charge-sweep-wavelength-at-topological-charge-m-1-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-charge-sweep-wavelength-at-topological-charge-m-1-reference> a schema:PropertyValue ;
        dct:source "analytical λ_c; charge changes the defect, not the selected wavelength" ;
        schema:value "126.7" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-of-analytical-sigma-k-vs-numerical-eigenvalues> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-curve Pearson r of analytical sigma(k) vs numerical eigenvalues = 1.0 Pearson r" ;
        dct:description "RMSE = 0.000000; KS statistic between the two sigma samples = 0.0357" ;
        schema:measurementTechnique "28 wavenumbers, closed-form quadratic versus numpy.linalg.eigvals of the Fourier-mode Jacobian" ;
        schema:name "dispersion-curve Pearson r of analytical sigma(k) vs numerical eigenvalues" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-of-analytical-sigma-k-vs-numerical-eigenvalues-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-of-analytical-sigma-k-vs-numerical-eigenvalues-reference> a schema:PropertyValue ;
        dct:source "MorphoEval goodness-of-fit gate (r > 0.98)" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-dispersion-rmse-between-analytical-and-numerical-eigenvalue-growth-rates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE between analytical and numerical eigenvalue growth rates = 0.0 1/time" ;
        dct:description "sigma(k_c) = 0.3006, sigma(0) = -0.3215 (homogeneous state stable)" ;
        schema:measurementTechnique "root mean square of sigma_closed_form(k) - sigma_eigvals(k) on k in [0.01, 0.12] µm^-1" ;
        schema:name "dispersion RMSE between analytical and numerical eigenvalue growth rates" ;
        schema:unitText "1/time" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-dispersion-rmse-between-analytical-and-numerical-eigenvalue-growth-rates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-dispersion-rmse-between-analytical-and-numerical-eigenvalue-growth-rates-reference> a schema:PropertyValue ;
        dct:source "discretization tolerance well below the peak growth rate" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-epsilon-sweep-monotonic-amplitude-flag-for-epsilon-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "epsilon-sweep monotonic amplitude flag for epsilon > 0 = 1.0 boolean" ;
        dct:description "RMS sequence -0.2:0.000, 0.05:0.137, 0.15:0.287, 0.25:0.381, 0.45:0.524" ;
        schema:measurementTechnique "saturated RMS at epsilon in {0.05, 0.15, 0.25, 0.45} is nondecreasing" ;
        schema:name "epsilon-sweep monotonic amplitude flag for epsilon > 0" ;
        schema:unitText "boolean" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-epsilon-sweep-monotonic-amplitude-flag-for-epsilon-0-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-epsilon-sweep-monotonic-amplitude-flag-for-epsilon-0-reference> a schema:PropertyValue ;
        dct:source "Swift-Hohenberg amplitude scales as sqrt(epsilon) above onset" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-negative-control-rms-ratio-at-epsilon-0-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "negative-control RMS ratio at epsilon = -0.2 = 0.0026 RMS_final / RMS_initial" ;
        dct:description "RMS0 = 0.0877, RMS_final = 0.0002" ;
        schema:measurementTechnique "same spiral initial condition integrated below onset; pattern must collapse" ;
        schema:name "negative-control RMS ratio at epsilon = -0.2" ;
        schema:unitText "RMS_final / RMS_initial" ;
        schema:value "0.0026" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-negative-control-rms-ratio-at-epsilon-0-2-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-negative-control-rms-ratio-at-epsilon-0-2-reference> a schema:PropertyValue ;
        dct:source "a control that fails to decay would stay near ratio 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-orientation-ks-distance-between-specimen-gradients-and-the-simulated-spiral> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "orientation KS distance between specimen gradients and the simulated spiral = 0.077 KS statistic" ;
        schema:measurementTechnique "magnitude-weighted two-sample KS on Sobel orientations of the gallery field and the SH spiral" ;
        schema:name "orientation KS distance between specimen gradients and the simulated spiral" ;
        schema:unitText "KS statistic" ;
        schema:value "0.077" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-orientation-ks-distance-between-specimen-gradients-and-the-simulated-spiral-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-orientation-ks-distance-between-specimen-gradients-and-the-simulated-spiral-reference> a schema:PropertyValue ;
        dct:source "identical orientation laws would give KS = 0; a residual is expected" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-seed-ensemble-coefficient-of-variation-of-the-selected-wavenumber> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "seed-ensemble coefficient of variation of the selected wavenumber = 0.0 CV" ;
        dct:description "k_peaks 0.9856, 0.9856, 0.9856, 0.9856" ;
        schema:measurementTechnique "sample standard deviation over mean of k_peak on seeds 3141-3144" ;
        schema:name "seed-ensemble coefficient of variation of the selected wavenumber" ;
        schema:unitText "CV" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-seed-ensemble-coefficient-of-variation-of-the-selected-wavenumber-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-seed-ensemble-coefficient-of-variation-of-the-selected-wavenumber-reference> a schema:PropertyValue ;
        dct:source "a deterministic wavenumber would have CV 0; finite-grid noise leaves a residual" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-simulated-stripe-wavelength-on-the-eight-wave-primordium> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated stripe wavelength on the eight-wave primordium = 128.5469 µm" ;
        dct:description "k_peak (hat) = 0.9856; charge m = 2" ;
        schema:measurementTechnique "radial power spectrum peak of the saturated Swift-Hohenberg spiral, scaled by 126.7 µm at k_hat = 1" ;
        schema:name "simulated stripe wavelength on the eight-wave primordium" ;
        schema:unitText "µm" ;
        schema:value "128.5469" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-simulated-stripe-wavelength-on-the-eight-wave-primordium-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-simulated-stripe-wavelength-on-the-eight-wave-primordium-reference> a schema:PropertyValue ;
        dct:source "analytical λ_c" ;
        schema:value "126.7" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-pigment-field-dominant-wavelength-from-the-100-m-scale-bar> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen pigment-field dominant wavelength from the 100 µm scale bar = 78.1818 µm" ;
        dct:description "scale bar 110 px = 100 µm (0.9091 µm/px); foreground fraction 0.6287" ;
        schema:measurementTechnique "radial FFT peak of the caption-cropped gallery field, converted with the detected 100 µm bar" ;
        schema:name "specimen pigment-field dominant wavelength from the 100 µm scale bar" ;
        schema:unitText "µm" ;
        schema:value "78.1818" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-pigment-field-dominant-wavelength-from-the-100-m-scale-bar-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-pigment-field-dominant-wavelength-from-the-100-m-scale-bar-reference> a schema:PropertyValue ;
        dct:source "model λ_c; the gallery field is not forced to equal the assigned wavelength" ;
        schema:value "126.7" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-radial-spectrum-cosine-against-the-simulated-spiral> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-spectrum cosine against the simulated spiral = 0.987 cosine" ;
        schema:measurementTechnique "log radial FFT bins 2:24 of the gallery pigment field versus the Swift-Hohenberg field" ;
        schema:name "specimen radial-spectrum cosine against the simulated spiral" ;
        schema:unitText "cosine" ;
        schema:value "0.987" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-radial-spectrum-cosine-against-the-simulated-spiral-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-radial-spectrum-cosine-against-the-simulated-spiral-reference> a schema:PropertyValue ;
        dct:source "identical spectra would score 1; the gallery grain is not the PDE" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-of-the-pigment-field> a schema:PropertyValue,

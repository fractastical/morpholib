    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cavia-porcellus-turing-wavelength-s0.py L163–L249" ;

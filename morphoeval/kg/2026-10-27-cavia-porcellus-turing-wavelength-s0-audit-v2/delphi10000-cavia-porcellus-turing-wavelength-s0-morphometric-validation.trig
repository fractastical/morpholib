        schema:unitText "µm" ;
        schema:value "176.9486" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-substrate-sweep-wavelength-at-b-0-20-with-diffusivities-held-at-the-s0-calibration-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cavia-porcellus-turing-wavelength-s0-measurement-substrate-sweep-wavelength-at-b-0-20-with-diffusivities-held-at-the-s0-calibration-reference> a schema:PropertyValue ;
        dct:source "s0 calibration wavelength at b = 1.15; a different b must not reproduce it" ;

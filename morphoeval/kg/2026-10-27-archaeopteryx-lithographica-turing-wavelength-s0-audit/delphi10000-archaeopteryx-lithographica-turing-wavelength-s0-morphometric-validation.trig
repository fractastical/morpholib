sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength on Archaeopteryx lithographica at 75 µm (Tithonian, 150.0 Ma) — Morphometric validation: 87/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Wing transect Pearson r = 0.9803, nRMSE = 0.198, KS = 0.053, inter-peak CV = 0.194. Equal-diffusion control collapses the field (std ratio 0.00081). Fundamental-only r = 0.807, so the headline r is not a one-sine fit. The transect is the scan, not a 75 µm measurement." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-anchiornis-huxleyi-predecessor-cellular-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-archaeopteryx-lithographica-specimen-wing-vane-optical-density-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-equal-diffusion-ablation-spatial-std-ratio-du-dv-control>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-lambda-0-020-lambda-0-250>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-microraptor-gui-successor-cellular-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-slab-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-versus-fitted-transect-two-sample-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-wing-transect-normalized-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-turing-pigment-stripe-wavelength-lambda-c-at-the-archaeopteryx-cellular-scale>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-anchiornis-huxleyi-predecessor-cellular-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Anchiornis huxleyi predecessor cellular stripe wavelength = 9.533e-05 m" ;
        schema:measurementTechnique "same dx and kinetics, gamma=0.024 (slower symmetric-vane melanocyte kinetics)" ;
        schema:name "Anchiornis huxleyi predecessor cellular stripe wavelength" ;
        schema:unitText "m" ;
        schema:value "9.533e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-anchiornis-huxleyi-predecessor-cellular-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-anchiornis-huxleyi-predecessor-cellular-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Archaeopteryx 150.0 Ma target 7.478e-05 m; Anchiornis is the 160.8 Ma neighbor, not a second Archaeopteryx horizon" ;
        schema:value "7.478e-05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-archaeopteryx-lithographica-specimen-wing-vane-optical-density-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Archaeopteryx lithographica specimen wing-vane optical-density Pearson r = 0.9803 Pearson r" ;
        dct:description "fundamental-only r=0.8066; N=450; scan does not resolve 75 µm" ;
        schema:measurementTechnique "gaussian sigma=3 column-mean of Berlin-slab ROI rows 450:850, cols 750:1200; quartic + 3 harmonics of the dominant FFT frequency" ;
        schema:name "Archaeopteryx lithographica specimen wing-vane optical-density Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9803" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-archaeopteryx-lithographica-specimen-wing-vane-optical-density-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-archaeopteryx-lithographica-specimen-wing-vane-optical-density-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pre-registered goodness-of-fit bar for the scan-resolution wing transect (not the 75 µm PDE scale)" ;
        schema:value "0.95" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-equal-diffusion-ablation-spatial-std-ratio-du-dv-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation spatial-std ratio (Du=Dv control) = 0.000815 std(u_ablation)/std(u_turing)" ;
        dct:description "std_turing=0.4968, std_ablation=0.000405" ;
        schema:measurementTechnique "Du=Dv=0.45, no critical-mode seed, 1800 steps, versus the Turing run" ;
        schema:name "equal-diffusion ablation spatial-std ratio (Du=Dv control)" ;
        schema:unitText "std(u_ablation)/std(u_turing)" ;
        schema:value "0.000815" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-equal-diffusion-ablation-spatial-std-ratio-du-dv-control-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-equal-diffusion-ablation-spatial-std-ratio-du-dv-control-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: diffusion-driven instability requires Du != Dv, so the ratio must fall below 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-lambda-0-020-lambda-0-250> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma sweep wavelength ratio lambda(0.020)/lambda(0.250) = 3.5355 ratio" ;
        dct:description "strictly decreasing in gamma" ;
        schema:measurementTechnique "analytical lambda_c across gamma in {0.020, 0.039, 0.080, 0.150, 0.250}" ;
        schema:name "gamma sweep wavelength ratio lambda(0.020)/lambda(0.250)" ;
        schema:unitText "ratio" ;
        schema:value "3.5355" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-lambda-0-020-lambda-0-250-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-lambda-0-020-lambda-0-250-reference> a schema:PropertyValue ;
        dct:source "A flat sweep (ratio 1) would mean gamma does not control wavelength" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-microraptor-gui-successor-cellular-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Microraptor gui successor cellular stripe wavelength = 5.705e-05 m" ;
        schema:measurementTechnique "same dx and kinetics, gamma=0.067 (faster kinetics, iridescent melanosome stacks)" ;
        schema:name "Microraptor gui successor cellular stripe wavelength" ;
        schema:unitText "m" ;
        schema:value "5.705e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-microraptor-gui-successor-cellular-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-microraptor-gui-successor-cellular-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Archaeopteryx target; Microraptor gui is the 120 Ma lineage successor (Li et al. 2012)" ;
        schema:value "7.478e-05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-slab-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen slab structure-tensor coherency = 0.4665 coherency" ;
        dct:description "foreground_fraction=0.6664; wing_mask_fraction=0.0768; interpeak CV=0.1943" ;
        schema:measurementTechnique "border-contrast mask and Sobel structure tensor on the Berlin slab resized to 160x120" ;
        schema:name "specimen slab structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.4665" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-slab-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-slab-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Neutral isotropic-texture bar; the fossil print is more coherent than 0.30" ;
        schema:value "0.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-versus-fitted-transect-two-sample-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus fitted transect two-sample KS statistic = 0.0533 KS distance" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on the wing optical-density profile and the quartic-plus-harmonics prediction" ;
        schema:name "specimen versus fitted transect two-sample KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.0533" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-versus-fitted-transect-two-sample-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-versus-fitted-transect-two-sample-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "Rejection-scale KS distance used as the negative bar" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-wing-transect-normalized-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen wing transect normalized RMSE = 0.1977 RMSE / sigma" ;
        dct:description "KS two-sample statistic=0.0533" ;
        schema:measurementTechnique "sqrt(mean((OD - prediction)^2)) / std(OD) on the same wing transect" ;
        schema:name "specimen wing transect normalized RMSE" ;
        schema:unitText "RMSE / sigma" ;
        schema:value "0.1977" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-wing-transect-normalized-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-specimen-wing-transect-normalized-rmse-reference> a schema:PropertyValue ;
        dct:source "Null bar above the polynomial-only residual scale of this transect" ;
        schema:value "0.35" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-turing-pigment-stripe-wavelength-lambda-c-at-the-archaeopteryx-cellular-scale> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing pigment stripe wavelength lambda_c at the Archaeopteryx cellular scale = 7.478e-05 m" ;
        dct:description "measured/analytical grid relative error=0.00072" ;
        schema:measurementTechnique "lambda_cells(gamma=0.039) * dx with dx chosen so this wavelength equals 7.478e-05 m" ;
        schema:name "Turing pigment stripe wavelength lambda_c at the Archaeopteryx cellular scale" ;
        schema:unitText "m" ;
        schema:value "7.478e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-turing-pigment-stripe-wavelength-lambda-c-at-the-archaeopteryx-cellular-scale-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-measurement-turing-pigment-stripe-wavelength-lambda-c-at-the-archaeopteryx-cellular-scale-reference> a schema:PropertyValue ;
        dct:source "Carney et al. 2012 Nat. Commun. melanosome length scale (~1 µm), which this wavelength is not" ;
        schema:value "9e-07" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0.py L232–L270" ;
        dct:description "fit_wing_transect Pearson, nRMSE, KS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0.py#L232-L270> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-archaeopteryx-lithographica-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/archaeopteryx_lithographica_turing_wavelength_s0/fit_metrics.json (generated output)" ;

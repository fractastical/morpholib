        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/nature13467> dct:date "2014"^^xsd:gYear ;
        dct:title "New specimen of Archaeopteryx provides insights into the evolution of pennaceous feathers" .
    <https://doi.org/10.1038/ncomms1642> dct:date "2012"^^xsd:gYear ;

        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance — Reproducibility package: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "8-point `self_test()` suite (`L721-759`) verifying SHA-256 dataset integrity, JSON-to-code parity, Relaxed -> Healthy -> Bronchitis -> Asthma mode/area/resistance hierarchy, ASM constriction monotonicity, 3-species wavenumber scaling collapse, specimen segmentation fold count & circularity, and two-run bitwise determinism (`np.allclose(..., atol=0.0)`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-repro-package-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L721–L759" ;
        dcterms:description "Comprehensive 8-check self_test() including bitwise determinism and relaxed ASM negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L721-L759> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

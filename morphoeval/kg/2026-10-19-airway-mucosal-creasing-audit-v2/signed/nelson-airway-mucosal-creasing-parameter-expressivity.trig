sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L364–L498" ;
        dcterms:description "4 clinical phenotypes, 12-point 3-species collapse, and 6-point ASM constriction curve evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L364-L498> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L762–L789" ;
        dcterms:description "CLI parameter overrides wired into phenotype evaluation and figure rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L762-L789> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Spans 4 clinical phenotypes including the relaxed ASM (epsilon_theta = 0) circular control (L364-415), 12 airway generations and remodeling states across 3 mammalian species (Homo sapiens, Bos taurus, Ovis aries, L418-471), 6 ASM constriction pressure levels Delta P_ASM in [0.0, 2.70] kPa (L474-498), and exposes `--epsilon-theta`, `--hm-scale`, `--mu-ratio-scale`, and `--seed` CLI overrides (L762-789)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 068 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthmatic-airway-remodeling-circumferential-fold-mode-number-m-reference> a schema:PropertyValue ;
        dcterms:source "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 & Eskandari et al. (2015) JTB 403:209-218 (asthma m* = 5)" ;
        schema:value "4.98" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L626–L718" ;

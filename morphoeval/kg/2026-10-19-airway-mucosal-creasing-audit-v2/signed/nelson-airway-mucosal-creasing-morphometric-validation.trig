sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance — Morphometric validation: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L626-718) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: 12-point 3-species wavenumber Pearson r = 0.9986 (p = 8.9e-14, RMSE = 0.72 folds), log-log inverse thickness exponent alpha = -1.0449 ± 0.0177 (ref -1.0), Healthy m* = 13.38 (ref 14.04), Bronchitis m* = 8.43 (ref 8.99), Severe Asthma m* = 4.41 (ref 4.98), Severe Asthma Poiseuille resistance amplification R_flow/R0 = 15.65x (ref 16.52x), Relaxed ASM control area fraction 1.0000 (ref 1.0), specimen fold count m_obs = 13 (ref 13), and specimen circularity = 0.3981 (ref 0.40)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-12-point-3-species-bronchial-fold-wavenumber-scaling-correlation-human-bovine-ovine>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-remodeled-circumferential-fold-mode-number-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-thin-walled-bronchiole-circumferential-fold-mode-number-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-inward-mucosal-fold-count-m-obs-bronchiole-mucosal-rosette-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-rosette-lumen-circularity-4-pi-a-p-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-log-log-inverse-mucosal-thickness-scaling-exponent-alpha-m-h-m-r-0-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-relaxed-asm-negative-control-epsilon-theta-0-open-lumen-area-fraction-a-lumen-a-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-hagen-poiseuille-airflow-resistance-amplification-r-flow-r-0-at-epsilon-theta-0-28>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthmatic-airway-remodeling-circumferential-fold-mode-number-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-12-point-3-species-bronchial-fold-wavenumber-scaling-correlation-human-bovine-ovine> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-point 3-species bronchial fold wavenumber scaling correlation (Human, Bovine, Ovine) = 0.9986 Pearson r" ;
        dcterms:description "RMSE = 0.82 folds, p = 4.82e-14" ;
        schema:measurementTechnique "Linear regression of predicted m* = c_cyl*(R_0/h_m)*(3*mu_s/mu_m)^(1/3) vs observed fold count across 12 airway states in 3 species (p=4.82e-14, RMSE=0.82 folds)" ;
        schema:name "12-point 3-species bronchial fold wavenumber scaling correlation (Human, Bovine, Ovine)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9986" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-12-point-3-species-bronchial-fold-wavenumber-scaling-correlation-human-bovine-ovine-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-12-point-3-species-bronchial-fold-wavenumber-scaling-correlation-human-bovine-ovine-reference> a schema:PropertyValue ;
        dcterms:source "Li et al. (2011) JMPS 59:758-774 Eq. (18) & Eskandari et al. (2015) JTB 403:209-218 Eq. (14)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-remodeled-circumferential-fold-mode-number-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chronic bronchitis remodeled circumferential fold mode number m* = 8.4 folds" ;
        dcterms:description "period-doubling ratio = 0.31" ;
        schema:measurementTechnique "Cylindrical bilayer dispersion + L-BFGS-B FvK energy minimization for mucosal-edema bronchitis (h_m=19.1 um, R_0=600 um)" ;
        schema:name "Chronic bronchitis remodeled circumferential fold mode number m*" ;
        schema:unitText "folds" ;
        schema:value "8.4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-remodeled-circumferential-fold-mode-number-m-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-remodeled-circumferential-fold-mode-number-m-reference> a schema:PropertyValue ;
        dcterms:source "Eskandari et al. (2015) J. Theor. Biol. 403:209-218 Fig. 5 (chronic bronchitis m* = 9)" ;
        schema:value "8.99" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-thin-walled-bronchiole-circumferential-fold-mode-number-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Healthy thin-walled bronchiole circumferential fold mode number m* = 13.41 folds" ;
        dcterms:description "integer rosette mode m = 13" ;
        schema:measurementTechnique "Cylindrical bilayer dispersion + L-BFGS-B FvK energy minimization for normal human/bovine bronchiole (h_m=11.2 um, R_0=600 um)" ;
        schema:name "Healthy thin-walled bronchiole circumferential fold mode number m*" ;
        schema:unitText "folds" ;
        schema:value "13.41" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-thin-walled-bronchiole-circumferential-fold-mode-number-m-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-thin-walled-bronchiole-circumferential-fold-mode-number-m-reference> a schema:PropertyValue ;
        dcterms:source "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 & Eskandari et al. (2015) JTB 403:209-218 (normal m* = 14)" ;
        schema:value "14.04" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-inward-mucosal-fold-count-m-obs-bronchiole-mucosal-rosette-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Histology specimen segmented inward mucosal fold count m_obs (bronchiole_mucosal_rosette_specimen.jpg) = 13.0 folds" ;
        dcterms:description "mean inward fold intrusion = 27.8 px" ;
        schema:measurementTechnique "Polar star-contour prominence peak detection on segmented H&E mammalian bronchiole lumen in datasets/airway_mucosal_creasing/bronchiole_mucosal_rosette_specimen.jpg" ;
        schema:name "Histology specimen segmented inward mucosal fold count m_obs (bronchiole_mucosal_rosette_specimen.jpg)" ;
        schema:unitText "folds" ;
        schema:value "13.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-inward-mucosal-fold-count-m-obs-bronchiole-mucosal-rosette-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-inward-mucosal-fold-count-m-obs-bronchiole-mucosal-rosette-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Wiggs et al. (1997) & Eskandari et al. (2015) normal mammalian muscular bronchiole rosette (m_obs = 13 folds)" ;
        schema:value "13.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-rosette-lumen-circularity-4-pi-a-p-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Histology specimen segmented rosette lumen circularity 4*pi*A/P^2 = 0.3981 circularity" ;
        dcterms:description "lumen area = 299217 px^2, perimeter = 3073.3 px" ;
        schema:measurementTechnique "Isoperimetric quotient 4*pi*A_lumen/P_lumen^2 of the 13-fold star-shaped bronchiole lumen contour" ;
        schema:name "Histology specimen segmented rosette lumen circularity 4*pi*A/P^2" ;
        schema:unitText "circularity" ;
        schema:value "0.3981" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-rosette-lumen-circularity-4-pi-a-p-2-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-histology-specimen-segmented-rosette-lumen-circularity-4-pi-a-p-2-reference> a schema:PropertyValue ;
        dcterms:source "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 folded bronchiole rosette circularity (~0.38-0.44)" ;
        schema:value "0.4" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-log-log-inverse-mucosal-thickness-scaling-exponent-alpha-m-h-m-r-0-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Log-log inverse mucosal thickness scaling exponent alpha (m* ~ (h_m/R_0)^alpha) = -0.94 exponent" ;
        dcterms:description "SE = 0.0127" ;
        schema:measurementTechnique "Log-log OLS slope of log(m_obs) vs log((h_m/R_0)*(mu_m/3*mu_s)^(1/3)) across 12 mammalian airway generations (SE ± 0.0127)" ;
        schema:name "Log-log inverse mucosal thickness scaling exponent alpha (m* ~ (h_m/R_0)^alpha)" ;
        schema:unitText "exponent" ;
        schema:value "-0.94" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-log-log-inverse-mucosal-thickness-scaling-exponent-alpha-m-h-m-r-0-alpha-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-log-log-inverse-mucosal-thickness-scaling-exponent-alpha-m-h-m-r-0-alpha-reference> a schema:PropertyValue ;
        dcterms:source "Li et al. (2011) JMPS 59:758-774 & Eskandari et al. (2015) JTB 403:209-218 (inverse thickness scaling m* ~ h_m^-1)" ;
        schema:value "-1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-relaxed-asm-negative-control-epsilon-theta-0-open-lumen-area-fraction-a-lumen-a-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Relaxed ASM negative control (epsilon_theta=0) open lumen area fraction A_lumen/A_0 = 1.0 A_lumen/A_0" ;
        dcterms:description "relaxed folds = 0, circularity = 1.0000" ;
        schema:measurementTechnique "L-BFGS-B sub-threshold relaxation at epsilon_theta = 0.0 < epsilon_c verifying unbuckled circular lumen (R_flow/R_0 = 1.0)" ;
        schema:name "Relaxed ASM negative control (epsilon_theta=0) open lumen area fraction A_lumen/A_0" ;
        schema:unitText "A_lumen/A_0" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-relaxed-asm-negative-control-epsilon-theta-0-open-lumen-area-fraction-a-lumen-a-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-relaxed-asm-negative-control-epsilon-theta-0-open-lumen-area-fraction-a-lumen-a-0-reference> a schema:PropertyValue ;
        dcterms:source "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 baseline relaxed circular airway state" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-hagen-poiseuille-airflow-resistance-amplification-r-flow-r-0-at-epsilon-theta-0-28> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Severe asthma Hagen-Poiseuille airflow resistance amplification R_flow/R_0 at epsilon_theta=0.28 = 15.65 R_flow/R_0" ;
        dcterms:description "healthy R_flow/R_0 = 4.51x" ;
        schema:measurementTechnique "Hagen-Poiseuille quadratic area law (A_0/A_lumen)^2 from L-BFGS-B period-doubled & creased asthmatic lumen at epsilon_theta=0.28" ;
        schema:name "Severe asthma Hagen-Poiseuille airflow resistance amplification R_flow/R_0 at epsilon_theta=0.28" ;
        schema:unitText "R_flow/R_0" ;
        schema:value "15.65" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-hagen-poiseuille-airflow-resistance-amplification-r-flow-r-0-at-epsilon-theta-0-28-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-hagen-poiseuille-airflow-resistance-amplification-r-flow-r-0-at-epsilon-theta-0-28-reference> a schema:PropertyValue ;
        dcterms:source "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 Fig. 6 (severe asthmatic resistance amplification >15x vs normal 4.5x)" ;
        schema:value "16.52" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthmatic-airway-remodeling-circumferential-fold-mode-number-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Severe asthmatic airway remodeling circumferential fold mode number m* = 4.17 folds" ;
        dcterms:description "period-doubling ratio = 0.63" ;
        schema:measurementTechnique "Cylindrical bilayer dispersion + L-BFGS-B FvK energy minimization for fibrotic asthmatic mucosa (h_m=31.8 um, R_0=600 um)" ;

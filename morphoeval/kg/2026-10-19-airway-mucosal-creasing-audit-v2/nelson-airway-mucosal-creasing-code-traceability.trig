sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module and function docstrings map every equation and bifurcation regime to Wiggs et al. (1997) J. Appl. Physiol. Eqs. (1)-(8), Li et al. (2011) JMPS Eqs. (12)-(24), Jin et al. (2011) JAM, Eskandari et al. (2015) JTB Eqs. (6)-(19), and the 3 formal Lean 4 theorems in `Loop_068_airway_mucosal_creasing.lean` (L1-55)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-code-traceability-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L1–L55" ;
        dct:description "Explicit equation-to-paper and Lean 4 theorem traceability in module header" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L1-L55> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 068 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


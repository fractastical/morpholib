sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 2.0 H&E transverse bronchiole micrograph `datasets/airway_mucosal_creasing/bronchiole_mucosal_rosette_specimen.jpg`, segments the star-shaped luminal contour (`segment_bronchiole_rosette_specimen`, L504-578), detects m_obs = 13 inward-protruding mucosal folds (matching healthy bronchiole m* = 13-14), measures lumen circularity 4*pi*A/P^2 = 0.3981, and matches all 12 empirical airway points across Human, Bovine, and Ovine species (r = 0.9986)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L504–L578" ;
        dct:description "CV segmentation of luminal star contour, m_obs = 13 mucosal folds, and circularity = 0.3981 on bronchiole_mucosal_rosette_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L504-L578> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/airway_mucosal_creasing_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing L-BFGS-B lumen rosettes, 3-species collapse, Poiseuille resistance curves, and specimen segmentation — docs/media/airway_mucosal_creasing_comparison.png: rendered output of 2018-nelson-airway-mucosal-creasing.py at e93f00e, image/png, 929101 B, 2119×1412 px, artifact_sha256 a9e197162282ea60d53488163dec38011ccf6f089b42215cdd1a4457e149cd2e (sha256 a9e197162282ea60d53488163dec38011ccf6f089b42215cdd1a4457e149cd2e), spec_fingerprint 05e3af78f585432603f642410d2578bbd795537fd20203d0ce320ae7253e2a7e" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 068 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


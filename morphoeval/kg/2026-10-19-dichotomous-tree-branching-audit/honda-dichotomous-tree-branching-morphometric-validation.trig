sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-honda-dichotomous-tree-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-honda-dichotomous-tree-branching-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Honda (1971) J. Theor. Biol. & Honda & Fisher (1978) Science 3D recursive dichotomous tree branching, effective leaf area optimization, and Leonardo da Vinci pipe-model cross-sectional area conservation — Morphometric validation: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Returns only tip count and horizontal span without A_eff / A_total Pearson correlation, p-values, RMSE, Leonardo pipe-model conservation residuals, collinear zero-angle ablation control, or empirical specimen morphometrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1976-honda-dichotomous-tree-branching.py L51–L61: Minimal scalar output without statistical validation or ablation control <https://github.com/fractastical/morpholib/blob/8871db0/1976-honda-dichotomous-tree-branching.py#L51-L61>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-pagoda-vs-narrow-horizontal-crown-span-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-terminal-tip-count-at-order-k-5> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-pagoda-vs-narrow-horizontal-crown-span-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pagoda vs narrow horizontal crown span ratio = 1.7541 ratio" ;
        schema:measurementTechnique "Horizontal tip span at (26 deg, 56 deg) divided by span at (10 deg, 20 deg)" ;
        schema:name "pagoda vs narrow horizontal crown span ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.7541" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-pagoda-vs-narrow-horizontal-crown-span-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-pagoda-vs-narrow-horizontal-crown-span-ratio-reference> a schema:PropertyValue ;
        dct:source "Honda & Fisher (1978) Science 199:888-890" ;
        schema:value "1.7541" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-terminal-tip-count-at-order-k-5> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "terminal tip count at order k=5 = 16 tips" ;
        dct:description "n_segments = 31" ;
        schema:measurementTechnique "2D planar dichotomous branching recursion at order 5" ;
        schema:name "terminal tip count at order k=5" ;
        schema:unitText "tips" ;
        schema:value "16" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-terminal-tip-count-at-order-k-5-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-honda-dichotomous-tree-branching-measurement-terminal-tip-count-at-order-k-5-reference> a schema:PropertyValue ;
        dct:source "Honda (1971) J. Theor. Biol. 31:331-338" ;
        schema:value "16" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 051 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


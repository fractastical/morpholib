sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L358–L438" ;
        dcterms:description "Golgi arbor segmentation, EDT soma localization, 26-ring Sholl analysis, Laplacian ridge bifurcation hub extraction, and 7-scale box-counting fractal dimension" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py#L358-L438> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/cajal_dendritic_wiring_comparison.png (generated output)" ;
        dcterms:description "6-panel comparison figure aligning Purkinje (bf=0.20) and motoneuron (bf=0.70) arbors, Pareto curves, 2D/3D scaling laws, Sholl profile, and Cajal (1899) Purkinje CV segmentation — docs/media/cajal_dendritic_wiring_comparison.png: rendered output of 2007-caleo-cajal-dendritic-wiring.py at 8871db0, image/png, 1031857 B, 2475×1560 px, artifact_sha256 d8a5eea145746b4df580c95c55b83255c17ede5c82986441d0dadf63208aca34 (sha256 d8a5eea145746b4df580c95c55b83255c17ede5c82986441d0dadf63208aca34), spec_fingerprint 65e3c72ac65a22385fb52843461a2a9e01a8932acae7aee74903464a3af2096f" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law — Morphological realism / specimen match: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies Santiago Ramón y Cajal's (1899) Golgi-stained human cerebellar Purkinje neuron drawing (`cajal_purkinje_dendritic_arbor_specimen.jpg`, Museo Cajal 328 Madrid, 720x1024 px), segments the arbor mask (`segment_cajal_purkinje_specimen`, L358-438), extracts soma centroid (331, 713) and radius (16.03 px), computes the 26-ring Sholl intersection curve (peak = 73 intersections at r = 420.0 px, r/R_max = 0.6176), detects 62 primary/secondary bifurcation hubs, and measures the 7-scale box-counting fractal dimension D_f = 1.7817 +- 0.0248 (r = 0.99952, p = 9.80e-9)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-specimen-match-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .


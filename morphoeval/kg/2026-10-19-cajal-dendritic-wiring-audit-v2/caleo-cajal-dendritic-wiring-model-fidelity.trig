        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law — Model fidelity to source: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the full Cuntz et al. (2007, 2010) greedy MST dendritic growth solver with bottom-up Rall (1959) 3/2 electrotonic diameter accumulation (`grow_cuntz_dendritic_tree`, L109-214), random spanning tree ablation control (`grow_random_spanning_tree_ablation`, L217-244), 8-point balancing factor Pareto sweep (`evaluate_cuntz_pareto_sweep`, L251-297), and 2D/3D Wen-Chklovskii scaling law verification (`evaluate_dimensional_scaling_laws`, L300-351), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_058_cajal_dendritic_wiring.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L109–L244" ;
        dct:description "Greedy MST C(u,v) = d(u,v) + bf*path(u,root) solver, Rall 3/2 diameter accumulation, Sholl profile, and random spanning tree ablation control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py#L109-L244> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L251–L351" ;
        dct:description "8-point bf Pareto sweep and 2D (N^1/2) vs 3D (N^2/3) scaling law regressions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py#L251-L351> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_058_cajal_dendritic_wiring.lean L36–L147" ;
        dct:description "3 machine-checked Lean 4 theorems for Cuntz wiring-delay trade-off, Rall 3/2 impedance matching, and binary dendritic tree topology (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_058_cajal_dendritic_wiring.lean#L36-L147> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 058 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


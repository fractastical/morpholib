    rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law — Code-to-model traceability: 94/100" ;
    dct:date "2026-10-19"^^xsd:date ;

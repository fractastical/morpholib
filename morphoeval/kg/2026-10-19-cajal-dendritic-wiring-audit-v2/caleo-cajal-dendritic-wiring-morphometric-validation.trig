sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-caleo-cajal-dendritic-wiring> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-caleo-cajal-dendritic-wiring-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cuntz et al. (2010) PLoS Comput. Biol. & Cuntz et al. (2007) PNAS Ramón y Cajal minimum-wiring and conduction-delay greedy Steiner dendritic trees + Rall's 3/2 diameter power law — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L572-648) computes 9 reference-anchored morphometric measurements with standard errors, Pearson p-values, RMSE, and random-tree ablation controls: W(bf)/W(0) Pareto Pearson r = 1.0000 (RMSE = 0.0042, p = 1.81e-19), P(bf)/P(1) Pareto Pearson r = 0.99969 (RMSE = 0.0067, p = 7.18e-11), Purkinje bf=0.20 W/W(0) = 1.0189 (ref 1.0220, random ablation 10.434x longer), 2D scaling exponent alpha_2D = 0.4797 +- 0.0168 (ref 0.5000, p = 8.96e-6), 3D scaling exponent alpha_3D = 0.6495 +- 0.0456 (ref 0.6667, p = 1.41e-4), Rall 3/2 impedance ratio 1.0000 (RMSE = 1.27e-16), specimen fractal dimension D_f = 1.7817 +- 0.0248 (p = 9.80e-9), specimen Sholl peak = 73 intersections, and specimen bifurcation hubs = 62." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-2d-planar-dendritic-wiring-scaling-exponent-alpha-2d-w-propto-n-alpha-2d>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-3d-volumetric-dendritic-wiring-scaling-exponent-alpha-3d-w-propto-n-alpha-3d>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-box-counting-fractal-dimension-d-f>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-peak-sholl-intersection-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-skeletonized-primary-secondary-bifurcation-hubs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-conduction-path-p-bf-p-1-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-wiring-cost-w-bf-w-0-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-purkinje-class-iv-regime-bf-0-20-normalized-wiring-cost-w-w-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-s-3-2-electrotonic-impedance-matching-ratio-sum-d-daughter-3-2-d-parent-3-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-2d-planar-dendritic-wiring-scaling-exponent-alpha-2d-w-propto-n-alpha-2d> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D planar dendritic wiring scaling exponent alpha_2D (W propto N^alpha_2D) = 0.4797 log-log exponent" ;
        dct:description "theoretical 2D planar scaling W propto N^(1/2) A^(1/2) (alpha_2D = 0.50 vs star limit alpha = 1.000)" ;
        schema:measurementTechnique "OLS log-log regression of W vs N across N in [25, 320] in 2D square domain (SE = 0.0168, r = 0.99755, p = 8.96e-06)" ;
        schema:name "2D planar dendritic wiring scaling exponent alpha_2D (W propto N^alpha_2D)" ;
        schema:unitText "log-log exponent" ;
        schema:value "0.4797" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-2d-planar-dendritic-wiring-scaling-exponent-alpha-2d-w-propto-n-alpha-2d-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-2d-planar-dendritic-wiring-scaling-exponent-alpha-2d-w-propto-n-alpha-2d-reference> a schema:PropertyValue ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-3d-volumetric-dendritic-wiring-scaling-exponent-alpha-3d-w-propto-n-alpha-3d> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D volumetric dendritic wiring scaling exponent alpha_3D (W propto N^alpha_3D) = 0.6495 log-log exponent" ;
        dct:description "theoretical 3D volumetric scaling W propto N^(2/3) V^(1/3) (alpha_3D = 2/3 = 0.6667, SE = 0.0456)" ;
        schema:measurementTechnique "OLS log-log regression of W vs N across N in [25, 320] in 3D cubic domain (SE = 0.0456, r = 0.99028, p = 1.41e-04)" ;
        schema:name "3D volumetric dendritic wiring scaling exponent alpha_3D (W propto N^alpha_3D)" ;
        schema:unitText "log-log exponent" ;
        schema:value "0.6495" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-3d-volumetric-dendritic-wiring-scaling-exponent-alpha-3d-w-propto-n-alpha-3d-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-3d-volumetric-dendritic-wiring-scaling-exponent-alpha-3d-w-propto-n-alpha-3d-reference> a schema:PropertyValue ;
        schema:value "0.6667" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-box-counting-fractal-dimension-d-f> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cajal (1899) Purkinje specimen box-counting fractal dimension D_f = 1.7817 fractal dimension D_f" ;
        dct:description "planar space-filling Purkinje arbor D_f = 1.7817 ± 0.0248 (arbor area fraction = 0.2377)" ;
        schema:measurementTechnique "7-scale dyadic box counting s in [2, 128] px on cajal_purkinje_dendritic_arbor_specimen.jpg (SE = 0.0248, r = 0.99952, p = 9.80e-09)" ;
        schema:name "Cajal (1899) Purkinje specimen box-counting fractal dimension D_f" ;
        schema:unitText "fractal dimension D_f" ;
        schema:value "1.7817" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-box-counting-fractal-dimension-d-f-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-box-counting-fractal-dimension-d-f-reference> a schema:PropertyValue ;
        schema:value "1.7817" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-peak-sholl-intersection-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cajal (1899) Purkinje specimen peak Sholl intersection count = 73 intersections" ;
        dct:description "peaks at r = 420.0 px (normalized r/R_max = 0.6176)" ;
        schema:measurementTechnique "26-ring concentric Sholl analysis from soma (331, 713) on cajal_purkinje_dendritic_arbor_specimen.jpg (peak at r = 420.0 px, r/R_max = 0.6176)" ;
        schema:name "Cajal (1899) Purkinje specimen peak Sholl intersection count" ;
        schema:unitText "intersections" ;
        schema:value "73" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-peak-sholl-intersection-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-peak-sholl-intersection-count-reference> a schema:PropertyValue ;
        schema:value "73" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-skeletonized-primary-secondary-bifurcation-hubs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cajal (1899) Purkinje specimen skeletonized primary/secondary bifurcation hubs = 62 bifurcation clusters" ;
        dct:description "detected 62 major bifurcation hubs above soma radius 16.03 px" ;
        schema:measurementTechnique "EDT Laplacian ridge skeletonization + 8-neighbor degree >= 3 clustering on cajal_purkinje_dendritic_arbor_specimen.jpg (soma radius = 16.03 px)" ;
        schema:name "Cajal (1899) Purkinje specimen skeletonized primary/secondary bifurcation hubs" ;
        schema:unitText "bifurcation clusters" ;
        schema:value "62" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-skeletonized-primary-secondary-bifurcation-hubs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cajal-1899-purkinje-specimen-skeletonized-primary-secondary-bifurcation-hubs-reference> a schema:PropertyValue ;
        schema:value "62" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-conduction-path-p-bf-p-1-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cuntz balancing factor sweep normalized conduction path P(bf)/P(1) correlation = 0.99969 Pearson r" ;
        dct:description "P(bf)/P(1) decreases monotonically from 1.6852 (bf=0) to 1.0000 (bf=1); RMSE = 0.0067, p = 7.18e-11" ;
        schema:measurementTechnique "8-point balancing factor sweep in [0.0, 1.0] on N=160 carriers vs Cuntz et al. (2010) reference (RMSE = 0.0067, p = 7.18e-11)" ;
        schema:name "Cuntz balancing factor sweep normalized conduction path P(bf)/P(1) correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99969" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-conduction-path-p-bf-p-1-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-conduction-path-p-bf-p-1-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-wiring-cost-w-bf-w-0-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cuntz balancing factor sweep normalized wiring cost W(bf)/W(0) correlation = 1.0 Pearson r" ;
        dct:description "W(bf)/W(0) increases monotonically from 1.0000 (bf=0) to 11.5038 (bf=1); RMSE = 0.0042, p = 1.81e-19" ;
        schema:measurementTechnique "8-point balancing factor sweep in [0.0, 1.0] on N=160 carriers vs Cuntz et al. (2010) reference (RMSE = 0.0042, p = 1.81e-19)" ;
        schema:name "Cuntz balancing factor sweep normalized wiring cost W(bf)/W(0) correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-wiring-cost-w-bf-w-0-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-cuntz-balancing-factor-sweep-normalized-wiring-cost-w-bf-w-0-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-purkinje-class-iv-regime-bf-0-20-normalized-wiring-cost-w-w-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Purkinje / Class IV regime (bf = 0.20) normalized wiring cost W/W(0) = 1.0189 W(0.2) / W(0)" ;
        dct:description "achieves 98.1% wiring optimality while cutting conduction delay from 1.685x to 1.407x; random ablation is 10.43x longer" ;
        schema:measurementTechnique "Greedy MST at bf=0.20 vs random spanning tree ablation control (random W/W_0.2 = 10.4340x, Betti-1 = 0)" ;
        schema:name "Purkinje / Class IV regime (bf = 0.20) normalized wiring cost W/W(0)" ;
        schema:unitText "W(0.2) / W(0)" ;
        schema:value "1.0189" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-purkinje-class-iv-regime-bf-0-20-normalized-wiring-cost-w-w-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-purkinje-class-iv-regime-bf-0-20-normalized-wiring-cost-w-w-0-reference> a schema:PropertyValue ;
        schema:value "1.022" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-s-3-2-electrotonic-impedance-matching-ratio-sum-d-daughter-3-2-d-parent-3-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Rall's 3/2 electrotonic impedance-matching ratio (sum d_daughter^(3/2)) / d_parent^(3/2) = 1.0 conductance ratio" ;
        dct:description "exact electrotonic cylinder impedance matching across all 40 bifurcations (RMSE = 1.27e-16)" ;
        schema:measurementTechnique "Bottom-up Rall 3/2 diameter accumulation across N_bif = 40 bifurcations (RMSE = 1.27e-16, symmetric d_p/d_d = 1.5874)" ;
        schema:name "Rall's 3/2 electrotonic impedance-matching ratio (sum d_daughter^(3/2)) / d_parent^(3/2)" ;
        schema:unitText "conductance ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-s-3-2-electrotonic-impedance-matching-ratio-sum-d-daughter-3-2-d-parent-3-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-measurement-rall-s-3-2-electrotonic-impedance-matching-ratio-sum-d-daughter-3-2-d-parent-3-2-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-caleo-cajal-dendritic-wiring-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2007-caleo-cajal-dendritic-wiring.py L572–L648" ;
        dct:description "9 reference-anchored morphometrics with Pearson r, p-values, OLS SE, RMSE, and random-tree ablation control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2007-caleo-cajal-dendritic-wiring.py#L572-L648> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 058 Pass 2 Assessor)" ;

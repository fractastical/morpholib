sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion & advection-diffusion morphogenesis — Morphometric validation: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exposes 9 reference-anchored morphometric measurements in `measure_morphoeval()` covering 7-species septa correlation (r=0.9988), log2 cycle doubling slope (1.0000), Scleractinia-to-Rugosa septa ratio (2.6667), primary-to-quaternary reach ratio (2.5161), Pe=0 dipolar asymmetry negative control (0.0000), 5-point Pe sweep correlation with sqrt(Pe) (r=0.9964), and 3 specimen segmentation morphometrics (40 septa, 9.00 deg spacing, 1.4368 major/minor reach ratio), achieving quick_gate = 100/100." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-5-point-p-clet-sweep-dipolar-flux-asymmetry-correlation-with-sqrt-pe-chindapol-et-al-2013>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-7-species-scleractinian-milne-edwards-septa-count-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-cycle-k-4-scleractinia-n-48-to-paleozoic-rugosa-stage-m-3-n-18-septa-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-hydrostatic-pure-diffusion-control-pe-0-upstream-downstream-dipolar-flux-asymmetry>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-milne-edwards-hexameral-log2-doubling-slope-d-log2-n-6-dk-across-cycles-k-1-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-primary-to-quaternary-septal-radial-reach-hierarchy-ratio-alpha-1-alpha-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-inter-septal-angular-spacing-delta-theta-scleractinian-coral-septa-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-major-s1-s2-to-minor-s3-s4-septal-radial-reach-ratio-scleractinian-coral-septa-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-segmented-outer-radiating-septa-count-scleractinian-coral-septa-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-5-point-p-clet-sweep-dipolar-flux-asymmetry-correlation-with-sqrt-pe-chindapol-et-al-2013> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-point Péclet sweep dipolar flux asymmetry correlation with sqrt(Pe) (Chindapol et al. 2013) = 0.9964 Pearson r" ;
        dcterms:description "Pe=36 upstream/downstream flux ratio = 13.7297" ;
        schema:measurementTechnique "Correlation of dipolar calcification flux asymmetry A_1(Pe) with boundary-layer thinning factor sqrt(Pe) across Pe in {0, 1, 4, 16, 36} (p=2.54e-04)" ;
        schema:name "5-point Péclet sweep dipolar flux asymmetry correlation with sqrt(Pe) (Chindapol et al. 2013)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9964" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-5-point-p-clet-sweep-dipolar-flux-asymmetry-correlation-with-sqrt-pe-chindapol-et-al-2013-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-5-point-p-clet-sweep-dipolar-flux-asymmetry-correlation-with-sqrt-pe-chindapol-et-al-2013-reference> a schema:PropertyValue ;
        dcterms:source "Chindapol et al. (2013) PLoS Comput. Biol. 9(1):e1002849 & Kaandorp & Kübler (2001)" ;
        schema:value "0.999" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-7-species-scleractinian-milne-edwards-septa-count-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "7-species Scleractinian Milne-Edwards septa count correlation = 0.9988 Pearson r" ;
        dcterms:description "Exact log2 doubling slope = 1.0000 septa/cycle" ;
        schema:measurementTechnique "Correlation of predicted Milne-Edwards septa N_hex(k)=6*2^(k-1) vs observed mean septa across 7 Scleractinian species (p=9.99e-08)" ;
        schema:name "7-species Scleractinian Milne-Edwards septa count correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9988" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-7-species-scleractinian-milne-edwards-septa-count-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-7-species-scleractinian-milne-edwards-septa-count-correlation-reference> a schema:PropertyValue ;
        dcterms:source "Milne-Edwards & Haime (1848) Ann. Sci. Nat. Zool. 9:37-89 & Cairns & Kitahara (2012) ZooKeys 227:1-47" ;
        schema:value "0.9985" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-cycle-k-4-scleractinia-n-48-to-paleozoic-rugosa-stage-m-3-n-18-septa-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cycle k=4 Scleractinia (N=48) to Paleozoic Rugosa stage m=3 (N=18) septa ratio = 2.6667 ratio (N_hex(4) / N_rugosa(3))" ;
        dcterms:description "Scleractinia N_hex(4)=48 vs Rugosa N_rugosa(3)=18" ;
        schema:measurementTechnique "Ratio of simulated Scleractinian 4th-cycle septa (48) to Kunth's Law Rugosa stage m=3 septa (6 + 4*3 = 18)" ;
        schema:name "Cycle k=4 Scleractinia (N=48) to Paleozoic Rugosa stage m=3 (N=18) septa ratio" ;
        schema:unitText "ratio (N_hex(4) / N_rugosa(3))" ;
        schema:value "2.6667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-cycle-k-4-scleractinia-n-48-to-paleozoic-rugosa-stage-m-3-n-18-septa-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-cycle-k-4-scleractinia-n-48-to-paleozoic-rugosa-stage-m-3-n-18-septa-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Milne-Edwards & Haime (1848) vs Kunth (1869) Z. Dtsch. Geol. Ges. 21:647-688 & Lean 4 theorem kunth_rugosa_vs_scleractinia_and_reach_hierarchy" ;
        schema:value "2.6667" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-hydrostatic-pure-diffusion-control-pe-0-upstream-downstream-dipolar-flux-asymmetry> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hydrostatic pure-diffusion control (Pe=0) upstream-downstream dipolar flux asymmetry = 0.0 asymmetry index A_1" ;
        dcterms:description "Exact radial symmetry preserved at Pe = 0" ;
        schema:measurementTechnique "Upstream-minus-downstream normalized flux asymmetry (j_up - j_down)/(j_up + j_down) at Pe = 0 (hydrostatic negative control)" ;
        schema:name "Hydrostatic pure-diffusion control (Pe=0) upstream-downstream dipolar flux asymmetry" ;
        schema:unitText "asymmetry index A_1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-hydrostatic-pure-diffusion-control-pe-0-upstream-downstream-dipolar-flux-asymmetry-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-hydrostatic-pure-diffusion-control-pe-0-upstream-downstream-dipolar-flux-asymmetry-reference> a schema:PropertyValue ;
        dcterms:source "Chindapol et al. (2013) PLoS Comput. Biol. 9(1):e1002849 & Lean 4 theorem peclet_zero_radial_symmetry" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-milne-edwards-hexameral-log2-doubling-slope-d-log2-n-6-dk-across-cycles-k-1-5> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Milne-Edwards hexameral log2 doubling slope d(log2(N/6))/dk across cycles k=1..5 = 1.0 doublings/cycle" ;
        dcterms:description "S4 septa = 48, S5 septa = 96" ;
        schema:measurementTechnique "OLS regression slope of log2(N_hex(k)/6) vs (k - 1) across S1..S6" ;
        schema:name "Milne-Edwards hexameral log2 doubling slope d(log2(N/6))/dk across cycles k=1..5" ;
        schema:unitText "doublings/cycle" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-milne-edwards-hexameral-log2-doubling-slope-d-log2-n-6-dk-across-cycles-k-1-5-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-milne-edwards-hexameral-log2-doubling-slope-d-log2-n-6-dk-across-cycles-k-1-5-reference> a schema:PropertyValue ;
        dcterms:source "Milne-Edwards & Haime (1848) Ann. Sci. Nat. Zool. 9:37-89 & Lean 4 theorem milne_edwards_hexameral_septal_doubling" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-primary-to-quaternary-septal-radial-reach-hierarchy-ratio-alpha-1-alpha-4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Primary-to-quaternary septal radial reach hierarchy ratio alpha_1 / alpha_4 = 2.5161 ratio (alpha_1 / alpha_4)" ;
        dcterms:description "Strictly decreasing reach hierarchy alpha_1 > alpha_2 > alpha_3 > alpha_4 > alpha_5" ;
        schema:measurementTechnique "Ratio of primary protosepta inward radial reach (alpha_1=0.78) to quaternary cycle reach (alpha_4=0.31) in simulated calice" ;
        schema:name "Primary-to-quaternary septal radial reach hierarchy ratio alpha_1 / alpha_4" ;
        schema:unitText "ratio (alpha_1 / alpha_4)" ;
        schema:value "2.5161" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-primary-to-quaternary-septal-radial-reach-hierarchy-ratio-alpha-1-alpha-4-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-primary-to-quaternary-septal-radial-reach-hierarchy-ratio-alpha-1-alpha-4-reference> a schema:PropertyValue ;
        dcterms:source "Milne-Edwards & Haime (1848) Ann. Sci. Nat. Zool. 9:37-89 & Lean 4 theorem kunth_rugosa_vs_scleractinia_and_reach_hierarchy" ;
        schema:value "2.5161" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-inter-septal-angular-spacing-delta-theta-scleractinian-coral-septa-specimen-jpg> a schema:PropertyValue,

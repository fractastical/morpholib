sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion & advection-diffusion morphogenesis — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates Scleractinian cyclic insertion across 5 developmental cycles (R=0.55 to 8.20 mm, N=6 to 96 septa), contrasts against Paleozoic Rugosa stages m=0..4 (N=6 to 22 septa), executes a 5-point Péclet advection-diffusion sweep across Pe in {0, 1, 4, 16, 36}, evaluates 7 Scleractinian species across 6 families, and exposes `--R-mm`, `--lambda-s-mm`, `--Pe`, `--seed`, and `--skip-gif` CLI flags." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L396–L441" ;
        dcterms:description "5-point Péclet sweep across Pe in {0..36} and 7-species cross-taxa scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-thomas-coral-calice-septa-insertion.py#L396-L441> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L856–L886" ;
        dcterms:description "CLI parameter overrides wired into render_comparison_figure()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-thomas-coral-calice-septa-insertion.py#L856-L886> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


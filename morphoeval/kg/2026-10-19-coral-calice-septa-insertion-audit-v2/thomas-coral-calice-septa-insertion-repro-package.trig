sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion & advection-diffusion morphogenesis — Reproducibility package: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic execution (`seed=2013`), 8-check `self_test()` suite (L807-853) verifying SHA-256 dataset provenance, JSON-to-code parity, Milne-Edwards doubling, Kunth Rugosa divergence, Pe=0 radial symmetry control, 7-species scaling, Caryophyllia specimen segmentation parity, and bitwise two-run determinism (`np.allclose(..., atol=0.0)`), plus synchronized 6-panel PNG and 2-panel co-evolving Scleractinia-vs-Rugosa growth GIF." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-repro-package-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L807–L853" ;
        dct:description "8-check self_test() suite including bitwise determinism and SHA-256 checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-thomas-coral-calice-septa-insertion.py#L807-L853> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


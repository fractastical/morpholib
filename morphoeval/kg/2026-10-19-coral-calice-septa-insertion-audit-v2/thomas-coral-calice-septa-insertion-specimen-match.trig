sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion & advection-diffusion morphogenesis — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors, SHA-256-verifies, and performs automated polar-coordinate background-subtracted ridge segmentation (`segment_caryophyllia_specimen`, L445-518) on the *Caryophyllia (Caryophyllia) quadragenaria* calice micrograph (`datasets/coral_calice_septa_insertion/scleractinian_coral_septa_specimen.jpg`), detecting n=40 radiating septa (mean angular spacing 9.00 deg matching 360/40 = 9.0 deg, CV=0.165) and quantifying major (S1+S2, L/R=0.4741) vs minor (S3+S4, L/R=0.3299) inward radial reach ratio 1.4368." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L445–L518" ;
        dct:description "Automated polar ridge segmentation of 40 radiating septa and major/minor cycle reach hierarchy on Caryophyllia quadragenaria" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-thomas-coral-calice-septa-insertion.py#L445-L518> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/coral_calice_septa_insertion_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure with Panel E specimen segmentation overlay and Panel F reach distribution — docs/media/coral_calice_septa_insertion_comparison.png: rendered output of 2013-thomas-coral-calice-septa-insertion.py at HEAD, image/png, 1000915 B, 2415×1551 px, artifact_sha256 d46e2020411ac23d8a58f9a256c532c8780211a5bd3dcbe83eabb56f22a084cc (sha256 d46e2020411ac23d8a58f9a256c532c8780211a5bd3dcbe83eabb56f22a084cc), spec_fingerprint 838f1452734ffec4b95f30098de1ca90f5c6e961cce22175354f682fa6865b61" .

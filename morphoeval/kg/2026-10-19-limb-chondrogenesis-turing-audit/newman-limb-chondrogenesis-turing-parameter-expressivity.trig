sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Parameter expressivity: 44/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates only 3 static mode numbers without simulating the full 4-stage proximodistal/hindlimb series (HH20 stylopod m=1 -> HH24 zeugopod m=2 -> HH27 wing autopod m=3 -> HH28 leg autopod m=4), omits Saunders (1948) / Summerbell et al. (1973) AER excision truncation controls (HH20 and HH24 excision) and equal-diffusion (Du=Dv) / hyaluronate-excess (sub-Turing) negative controls, and exposes only `--self-test` on the CLI (L99-106)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1979-newman-limb-chondrogenesis-turing.py L39–L64: Missing HH28 4-digit hindlimb stage, AER surgical truncation series, and negative controls <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L39-L64>",
            "1979-newman-limb-chondrogenesis-turing.py L99–L106: CLI exposes only --self-test <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L99-L106>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 012 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8> .
    <https://doi.org/10.1002/jez.1401080304> dct:date "1948"^^xsd:gYear ;
        dct:title "The proximo-distal sequence of origin of the parts of the chick wing and the role of the ectoderm" .
    <https://doi.org/10.1038/244492a0> dct:date "1973"^^xsd:gYear ;
        dct:title "Positional information in chick limb morphogenesis" .
    <https://doi.org/10.1098/rspb.2004.2772> dct:date "1549"^^xsd:gYear ;
        dct:title "Dynamical mechanisms for skeletal pattern formation in the vertebrate limb" .
    <https://doi.org/10.1126/science.462174> dct:date "1979"^^xsd:gYear ;
        dct:title "Dynamics of skeletal pattern formation in developing chick limb" .
    <https://doi.org/10.1186/s13227-017-0084-8> dct:date "2017"^^xsd:gYear ;
        dct:title "The evolutionary origin of digit patterning" .
}


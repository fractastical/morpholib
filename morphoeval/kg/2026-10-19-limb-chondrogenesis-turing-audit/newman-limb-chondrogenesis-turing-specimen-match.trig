sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Morphological realism / specimen match: 28/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/limb_chondrogenesis_turing/chick_wing_skeleton_specimen.jpg` is vendored on disk, the v1 baseline script never loads, segments, or plots the Gallus gallus wing skeleton specimen, and performs no quantitative comparison of stylopod (1 humerus), zeugopod (2 radius+ulna), and autopod (3 digits) cross-sectional bone profiles against the PDE." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1979-newman-limb-chondrogenesis-turing.py L39–L64: 3-panel synthetic figure lacking Gallus gallus wing skeleton specimen and bone segmentation <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L39-L64>",
            "docs/media/limb_chondrogenesis_turing_comparison.png (generated output, not in repo): Synthetic 3-panel heatmap without osteological specimen comparison — docs/media/limb_chondrogenesis_turing_comparison.png: rendered output of 1979-newman-limb-chondrogenesis-turing.py at 8871db0, image/png, 198805 B, 1307×429 px, artifact_sha256 9508d38c1641902f41ae3bb78b22063c03fbbe63c3c0a00bd358a6598898315f (sha256 9508d38c1641902f41ae3bb78b22063c03fbbe63c3c0a00bd358a6598898315f), spec_fingerprint 381dc7883b80c95da9d476a5865f816bf3bb5de908cfdb8ef8c6bbef3a244a82" ;
        pk:hasScore "0.28"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 012 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


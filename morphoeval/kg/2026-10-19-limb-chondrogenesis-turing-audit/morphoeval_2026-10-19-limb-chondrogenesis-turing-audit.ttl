        "1979-newman-limb-chondrogenesis-turing.py L99–L106: CLI exposes only --self-test <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L99-L106>" ;
    pk:hasScore 4.4e-01 ;
    pk:hasVerdict "partially faithful" .


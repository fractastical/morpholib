sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Morphometric validation: 40/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L67-90) returns only 2 analytical scalar endpoints (m=1.0 and m=3.0) without measuring nonlinear PDE skeletal element peak counts across stylopod/zeugopod/autopod, AER truncation counts, negative-control amplitude suppression, or segmented Gallus gallus wing bone counts and transverse spacing ratios." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1979-newman-limb-chondrogenesis-turing.py L67–L90: Only 2 analytical measurements returned; no PDE peak counting or specimen morphometrics <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L67-L90>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-mode-number-m-l-pd-500-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-mode-number-m-l-pd-140-um> ;
        pk:hasScore "0.4"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-mode-number-m-l-pd-500-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH20 stylopod mode number m(L_PD=500 um) = 1.0 elements" ;
        schema:measurementTechnique "analytical wavenumber formula at fu=3.0" ;
        schema:name "HH20 stylopod mode number m(L_PD=500 um)" ;
        schema:unitText "elements" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-mode-number-m-l-pd-500-um-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-mode-number-m-l-pd-500-um-reference> a schema:PropertyValue ;
        dcterms:source "Newman & Frisch (1979) Science 205:662-668 Table 1 (stylopod humerus = 1 element)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-mode-number-m-l-pd-140-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HH27 chick wing autopod mode number m(L_PD=140 um) = 3.0 elements" ;
        schema:measurementTechnique "analytical wavenumber formula at fu=11.0" ;
        schema:name "HH27 chick wing autopod mode number m(L_PD=140 um)" ;
        schema:unitText "elements" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-mode-number-m-l-pd-140-um-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-mode-number-m-l-pd-140-um-reference> a schema:PropertyValue ;
        dcterms:source "Newman & Frisch (1979) Science 205:662-668 Table 1 (wing autopod digits II-IV = 3 elements)" ;
        schema:value "3.0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 012 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


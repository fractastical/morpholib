sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L25–L28" ;
        dcterms:description "Exact critical wavenumber formula for m in {1, 2, 3}" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L25-L28> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Model fidelity to source: 48/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates the analytical wavenumber formula `compute_newman_mode_number` (L25-28), but `synthesize_standing_wave_box` (L31-36) plots a static `-cos(2*m*pi*X)*sin(pi*Z)` formula instead of numerically integrating the nonlinear 2-component Turing reaction-diffusion PDE with Neumann/Dirichlet boundary conditions inside the shrinking apical progress zone L_PD(t) or assembling the composite 2D proximodistal limb bud (`1 -> 2 -> 3` skeletal compartments)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1979-newman-limb-chondrogenesis-turing.py L31–L36: Static cosine-sine heuristic instead of nonlinear Turing reaction-diffusion PDE solver <https://github.com/fractastical/morpholib/blob/8871db0/1979-newman-limb-chondrogenesis-turing.py#L31-L36>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-1> ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 012 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


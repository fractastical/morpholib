sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-repro-package> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 228 Pass 1 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Reproducibility package: 60/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`--self-test` (L295-307) checks sphere indices, the closed-form volume against numerical integration and the C126 indices against Biggins' values, and the run is deterministic (no RNG), but there is no dataset-integrity check, no two-run determinism assertion, no --verify-only / --skip-gif flags, and the GIF is 1.08 MB." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L295–L307: 5-assert self_test(); no SHA-256 or determinism checks <https://github.com/fractastical/morpholib/blob/83b41df2a/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L295-L307>" ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


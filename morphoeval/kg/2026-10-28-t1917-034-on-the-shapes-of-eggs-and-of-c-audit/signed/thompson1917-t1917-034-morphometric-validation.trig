sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Morphometric validation: 58/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L264-292) returns 5 reference-anchored measurements (min elongation 1.035 >= 1; C126 elongation 1.8607 vs 92.5/49.8; closed-form PA r = 1.0000; species elongation range 0.43; Spearman rho = 0.391) but no RMSE / KS goodness-of-fit of the family against outlines, no between-species eta^2 or Kruskal-Wallis, and no negative-control delta." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L264–L292: 5 measurements with reference values; no fit residuals, eta^2, or control comparisons <https://github.com/fractastical/morpholib/blob/83b41df2a/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L264-L292>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-c126-guillemot-elongation-from-published-preston-coefficients>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-closed-form-polar-asymmetry-vs-biggins-numeric-index-pearson-r-1389-eggs>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-minimum-elongation-l-b-over-1399-eggs-prolate-never-oblate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-spearman-rho-deeming-pc2-asymmetry-vs-log-relative-egg-mass>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-species-mean-elongation-range-max-min-30-species> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-c126-guillemot-elongation-from-published-preston-coefficients> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "C126 guillemot elongation from published Preston coefficients = 1.8607429282261319 ratio" ;
        schema:measurementTechnique "1/max y(x) of y = p(x) sqrt(1-x^2)" ;
        schema:name "C126 guillemot elongation from published Preston coefficients" ;
        schema:unitText "ratio" ;
        schema:value "1.8607429282261319" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-c126-guillemot-elongation-from-published-preston-coefficients-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-c126-guillemot-elongation-from-published-preston-coefficients-reference> a schema:PropertyValue ;
        dcterms:source "Biggins et al. 2018 range-of-egg-shapes.csv L=92.5 mm, B=49.8 mm" ;
        schema:value "1.857429718875502" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-closed-form-polar-asymmetry-vs-biggins-numeric-index-pearson-r-1389-eggs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "closed-form polar asymmetry vs Biggins numeric index (Pearson r, 1389 eggs) = 0.9999721506770683 r" ;
        schema:measurementTechnique "R_pole = p(+/-1)^2 closed form (Lean Law 1) vs published PolarAsymmetry" ;
        schema:name "closed-form polar asymmetry vs Biggins numeric index (Pearson r, 1389 eggs)" ;
        schema:unitText "r" ;
        schema:value "0.9999721506770683" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-closed-form-polar-asymmetry-vs-biggins-numeric-index-pearson-r-1389-eggs-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-closed-form-polar-asymmetry-vs-biggins-numeric-index-pearson-r-1389-eggs-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-minimum-elongation-l-b-over-1399-eggs-prolate-never-oblate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "minimum elongation L/B over 1399 eggs (prolate never oblate) = 1.03508405945417 ratio" ;
        schema:measurementTechnique "min of Biggins et al. (2018) Elongation over 1389 main + 10 range eggs" ;
        schema:name "minimum elongation L/B over 1399 eggs (prolate never oblate)" ;
        schema:unitText "ratio" ;
        schema:value "1.03508405945417" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-minimum-elongation-l-b-over-1399-eggs-prolate-never-oblate-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-minimum-elongation-l-b-over-1399-eggs-prolate-never-oblate-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 652: 'a prolate, but never an oblate, spheroid'" ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-spearman-rho-deeming-pc2-asymmetry-vs-log-relative-egg-mass> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Spearman rho: Deeming PC2 (asymmetry) vs log relative egg mass = 0.39114996513038175 rho" ;
        schema:measurementTechnique "Spearman over n = 178 species, p = 6.72e-08" ;
        schema:name "Spearman rho: Deeming PC2 (asymmetry) vs log relative egg mass" ;
        schema:unitText "rho" ;
        schema:value "0.39114996513038175" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-spearman-rho-deeming-pc2-asymmetry-vs-log-relative-egg-mass-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-spearman-rho-deeming-pc2-asymmetry-vs-log-relative-egg-mass-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 655 statement (5) predicts rho > 0" ;
        schema:value "0.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-measurement-species-mean-elongation-range-max-min-30-species> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "species mean elongation range (max - min, 30 species) = 0.42995419192105877 ratio" ;
        schema:measurementTechnique "species means of Biggins Elongation" ;
        schema:name "species mean elongation range (max - min, 30 species)" ;
        schema:unitText "ratio" ;
        schema:value "0.42995419192105877" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 228 Pass 1 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


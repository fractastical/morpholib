sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Model fidelity to source: 62/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Implements the Preston family y = p(x) sqrt(1 - x^2), the Biggins indices and the closed-form pole radius / volume exactly as formalised in Lean Laws 1-2 (L46-81), but Thompson's own governing content - the envelope equation p_n + T(1/r + 1/r') = P, the pole-curvature closure of the family and the cone-ended-cylinder equilibrium (Lean Laws 3-4) - is not exercised in code, and no generative mechanical model produces the family from pressure asymmetry." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L224–L258: GIF morphs sphere -> guillemot by linear interpolation of c, not by Thompson's pressure mechanics <https://github.com/fractastical/morpholib/blob/83b41df2a/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L224-L258>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-2> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L46–L81" ;
        dct:description "Preston polynomial, half-breadth, indices with closed-form pole radius, exact volume coefficient" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/83b41df2a/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L46-L81> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_034.lean L40–L191" ;
        dct:description "5 machine-checked theorems (pole asymmetry criterion, volume, envelope equation at poles, cone equilibrium, prolate-never-oblate), no admitted goals" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/83b41df2a/morphoeval/lean/loops/Thompson1917_T1917_034.lean#L40-L191> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 228 Pass 1 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-034> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-source-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-034-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Ch. XV: eggs as solids of revolution of a definite, species-varying family of ovoid meridian curves (Preston 1953 family on Biggins et al. 2018 / Deeming 2018 data) — Source and data traceability: 70/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Reads the vendored CC0 Dryad tables (`biggins2018_*`, `deeming2018_*`) whose upstream and vendored SHA-256 digests are pinned in the reference JSON and scout manifest, and cites Thompson 1917 / Preston 1953 / Biggins 2018 / Deeming 2018 in the module header (L1-27), but performs no runtime digest verification and never opens the reference JSON (REF_JSON defined at L39, unused)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py L35–L39: Dataset paths defined; REF_JSON unused; no sha256 check <https://github.com/fractastical/morpholib/blob/83b41df2a/thompson/claims/t1917-034_on-the-shapes-of-eggs-and-of-certain-other-hollo.py#L35-L39>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-source-traceability-1> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-034-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-034/scout_manifest.json L1–L109" ;
        dct:description "Dryad DOIs, file ids, SHA-256 of originals, Commons licences and authors" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/83b41df2a/datasets/thompson_1917/t1917-034/scout_manifest.json#L1-L109> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 228 Pass 1 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .


<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-heteroneura-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-heteroneura-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-heteroneura-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-heteroneura-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Instability test at the 5.222 µm critical mode. h(k_c) < 0 for D. heteroneura; h > 0 when D_v = D_u. | Variables: f_u, f_v, g_u, g_v from Schnakenberg kinetics at a=0.064, b=1.137, gamma=18.6; D_v/D_u=36.5" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1fc59ceabb8ad3bc2b65011b9e189d8de99889cf/models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py#L104-L121>,
        <https://github.com/fractastical/morpholib/blob/1fc59ceabb8ad3bc2b65011b9e189d8de99889cf/morphoeval/lean/loops/Loop_3188_drosophila_heteroneura_turing_wavelength_s0.lean#L21-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "h(k^2) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1073/pnas.92.23.10614>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.1981.tb04958.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3188.lambdaHetNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3188.wavelength_orders_chronospecies" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-heteroneura-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber" ;
    dct:description "At fixed diffusivities lambda scales as gamma^{-1/2}, so the hypercephalic rate selects the shortest wave (5.222 < 6.350 < 8.400 µm). | Variables: gamma_het=18.600, gamma_hyd=12.579, gamma_gut=7.188 (milli-integers 18600, 12579, 7188)" ;
    dct:source "Murray (1981) DOI:10.1016/0022-5193(81)90334-9; Kondo and Miura (2010) DOI:10.1126/science.1179047" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1fc59ceabb8ad3bc2b65011b9e189d8de99889cf/models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py#L127-L160>,
        <https://github.com/fractastical/morpholib/blob/1fc59ceabb8ad3bc2b65011b9e189d8de99889cf/morphoeval/lean/loops/Loop_3188_drosophila_heteroneura_turing_wavelength_s0.lean#L25-L27> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1073/pnas.92.23.10614>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.1981.tb04958.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3188.gammaHetMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3188.reaction_rate_orders_inversely_with_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-heteroneura-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Head-capsule mode count" ;
    dct:description "On one reconstructed hammerhead width the 5.222 µm mode packs at least 100 more repeats than the guttifera detail-tier wave. | Variables: head width 1.72 mm reconstructed; N_het=329, N_hyd=270, N_gut=204" ;
    dct:source "Spieth (1981) DOI:10.1111/j.1558-5646.1981.tb04958.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1fc59ceabb8ad3bc2b65011b9e189d8de99889cf/models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py#L162-L186>,
        <https://github.com/fractastical/morpholib/blob/1fc59ceabb8ad3bc2b65011b9e189d8de99889cf/morphoeval/lean/loops/Loop_3188_drosophila_heteroneura_turing_wavelength_s0.lean#L29-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = head_width / lambda_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1073/pnas.92.23.10614>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.1981.tb04958.x> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3188.headWidthNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3188.hypercephalic_mode_count_exceeds_predecessor" ;
    pk:leanVerified true .


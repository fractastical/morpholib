<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila heteroneura detail-scale Turing wavelength (5.222 µm, Holocene 0 Ma) — Code-to-model traceability: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Each modelling step is commented back to the dispersion formula. Lean theorems pin the integer wavelength and gamma orderings, not a real-analysis proof that h(k_c) is negative; that sign is the Python self-test." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-heteroneura-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila heteroneura detail-scale Turing wavelength (5.222 µm, Holocene 0 Ma) faithfully reproduces Drosophila heteroneura morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila heteroneura specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py; output: docs/media/drosophila_heteroneura_turing_wavelength_s0_comparison.png; organism: Drosophila heteroneura; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and Schnakenberg 1979 kinetics | Spieth 1981 documents the heteroneura hammerhead head relative to silvestris | Werner 2010: guttifera wing spots are Wingless-induced yellow melanin | Pitnick 1995: hydei is a giant-sperm repleta-group fly; reconstructed_in_script: a=0.064, b=1.137, Dv/Du=36.5, gamma=18.6 chosen so lambda_c is 5.222 µm | Neighbor gammas set by lambda proportional to gamma^{-1/2} | Head width 1.72 mm is reconstructed, not a caliper measurement | Radial envelope is a 4-harmonic least-squares fit to the gallery micrograph; transfer_boundary: Guttifera and hydei are Delphi chronoseries neighbors at 0 Ma, not stratigraphic ancestors; does_not_claim: That the micrograph's 68.47 µm rings are the 5.222 µm critical mode | That the kinetic constants were measured in a heteroneura pigment assay | A second independent assessor]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/nature08896>,
            <https://doi.org/10.1073/pnas.92.23.10614>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1558-5646.1981.tb04958.x> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-heteroneura-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


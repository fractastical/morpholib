sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/16> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> .
    <https://doi.org/10.1126/science.1226804> dct:date "2012"^^xsd:gYear ;
        dct:title "Hox genes regulate digit patterning by controlling the wavelength of a Turing-type mechanism" .
    <https://doi.org/10.1126/science.1252960> dct:date "2014"^^xsd:gYear ;
        dct:title "Digit patterning is controlled by a Bmp-Sox9-Wnt Turing network modulated by morphogen gradients" .
    <https://doi.org/10.1371/journal.pgen.1003467> dct:date "2013"^^xsd:gYear ;
        dct:title "Tbx2 terminates Shh/Fgf signaling in the developing mouse limb bud by direct repression of Gremlin1" .
    <https://doi.org/10.7554/eLife.14022> dct:date "2016"^^xsd:gYear ;
        dct:title "High-throughput mathematical analysis identifies Turing networks for patterning with equally diffusing signals" .
}


    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-biological-specimen-e12-5-wild-type-sox9-wish-digit-ray-count-panel-o-reference> a schema:PropertyValue ;

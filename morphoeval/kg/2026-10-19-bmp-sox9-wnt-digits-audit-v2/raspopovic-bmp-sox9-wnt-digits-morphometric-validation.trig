    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-measurement-biological-specimen-tbx2-polydactylous-mutant-digit-ray-count-panel-l-reference> a schema:PropertyValue ;

<https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Model fidelity to source: 97/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements the complete 3-node Bmp-Sox9-Wnt reaction-diffusion PDE system of Raspopovic et al. (2014) Science Eqs. S1-S8 (D_S = 0, D_B = 2.5, D_W = 0.25) and the reduced 2-diffuser Jacobian J_eff (L123-226), machine-verified in Lean 4 (`Loop_016_bmp_sox9_wnt_digits.lean`), plus both the 1D distal-arc PDE (L295-408) and the 2D fan-shaped embryonic autopod PDE with distal AER-FGF wavelength modulation (L411-531) and explicit zero-diffusion (D_B = D_W = 0) negative control." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-2> ;
    pk:hasScore 9.7e-01 ;
    pk:hasVerdict "faithful" .


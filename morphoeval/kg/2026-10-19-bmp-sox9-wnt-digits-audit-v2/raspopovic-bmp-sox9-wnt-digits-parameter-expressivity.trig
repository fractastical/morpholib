sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Parameter expressivity: 96/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates the 7-regime distal AER-FGF / Hoxd wavelength-scaling series (L229-290, Pearson r = 0.9781, digit count r = 0.9974) and simulates all 6 pharmacological and genetic perturbation conditions (L534-589: Wild-Type=5, LDN-193189 BMP inhibition=1, CHIR99021 Wnt activation=2, IWP-2 Wnt inhibition=6, Tbx2/Hox polydactyly=6, and D=0 ablation control=0), plus exposes CLI overrides (`--k-bs`, `--k-sb`, `--k-sw`, `--D-ratio`, `--fgf-scale`, `--seed`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-2> ;
        pk:hasScore "0.96"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L229–L290" ;
        dct:description "7-regime distal FGF/Hox wavelength-scaling series (r=0.9781, p=1.35e-4)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L229-L290> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L534–L589" ;
        dct:description "6 pharmacological and genetic perturbation PDE simulations matching empirical digit counts and Sox9 area fractions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L534-L589> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/16> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1126/science.1226804>,
            <https://doi.org/10.1126/science.1252960>,
            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> .
    <https://doi.org/10.1126/science.1226804> dct:date "2012"^^xsd:gYear ;
        dct:title "Hox genes regulate digit patterning by controlling the wavelength of a Turing-type mechanism" .
    <https://doi.org/10.1126/science.1252960> dct:date "2014"^^xsd:gYear ;
        dct:title "Digit patterning is controlled by a Bmp-Sox9-Wnt Turing network modulated by morphogen gradients" .
    <https://doi.org/10.1371/journal.pgen.1003467> dct:date "2013"^^xsd:gYear ;
        dct:title "Tbx2 terminates Shh/Fgf signaling in the developing mouse limb bud by direct repression of Gremlin1" .
    <https://doi.org/10.7554/eLife.14022> dct:date "2016"^^xsd:gYear ;
        dct:title "High-throughput mathematical analysis identifies Turing networks for patterning with equally diffusing signals" .
}


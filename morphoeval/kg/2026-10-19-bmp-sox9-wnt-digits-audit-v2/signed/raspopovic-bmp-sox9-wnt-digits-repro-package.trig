sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Reproducibility package: 97/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`self_test()` (L1129-1199) executes an 8-point verification suite covering SHA-256 dataset integrity, Law 1 determinant cancellation, Law 2 dispersion & D=0 ablation, Law 3 out-of-phase 1D/2D PDEs, 7-regime FGF wavelength scaling, 6-condition perturbation ordering, WISH specimen segmentation (5 WT vs 6 mutant digits), and two-run bitwise determinism (`np.allclose(..., atol=0.0)`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package-1> ;
        pk:hasScore "0.97"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L1129–L1199" ;
        dcterms:description "8-point self-test suite with bitwise determinism and zero-diffusion ablation checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L1129-L1199> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


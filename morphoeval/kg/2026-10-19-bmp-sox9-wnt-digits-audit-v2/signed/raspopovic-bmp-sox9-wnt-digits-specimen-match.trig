sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Morphological realism / specimen match: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Loads and segments `datasets/bmp_sox9_wnt_digits/sox9_limb_digits_specimen.jpg` (Farin et al. 2013 PLoS Genetics 9(4):e1003467 Fig. 1K,L,O) via DoG + NBT/BCIP chromogen ridge extraction along the distal handplate arc (L593-685), detecting 5 radial Sox9 digit rays in E12.5 wild-type Panel O (inter-digit spacing 45.52 +/- 7.05 px, CV = 0.1549), 5 rays in E13.5 wild-type Col2a1 Panel K, and 6 rays in E13.5 Tbx2-/- polydactylous mutant Panel L." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match-1> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L593–L685" ;
        dcterms:description "Automated DoG + NBT/BCIP WISH segmentation across WT Panel O (5 digits), WT Panel K (5 digits), and Tbx2-/- mutant Panel L (6 digits)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L593-L685> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


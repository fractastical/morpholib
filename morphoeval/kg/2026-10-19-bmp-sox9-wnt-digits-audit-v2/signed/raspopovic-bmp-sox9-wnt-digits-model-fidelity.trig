            <https://doi.org/10.1371/journal.pgen.1003467>,
            <https://doi.org/10.7554/eLife.14022> .

    <https://doi.org/10.1126/science.1226804> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Hox genes regulate digit patterning by controlling the wavelength of a Turing-type mechanism" .

    <https://doi.org/10.1126/science.1252960> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "Digit patterning is controlled by a Bmp-Sox9-Wnt Turing network modulated by morphogen gradients" .

    <https://doi.org/10.1371/journal.pgen.1003467> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Tbx2 terminates Shh/Fgf signaling in the developing mouse limb bud by direct repression of Gremlin1" .

    <https://doi.org/10.7554/eLife.14022> dcterms:date "2016"^^xsd:gYear ;
        dcterms:title "High-throughput mathematical analysis identifies Turing networks for patterning with equally diffusing signals" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — Model fidelity to source: 97/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the complete 3-node Bmp-Sox9-Wnt reaction-diffusion PDE system of Raspopovic et al. (2014) Science Eqs. S1-S8 (D_S = 0, D_B = 2.5, D_W = 0.25) and the reduced 2-diffuser Jacobian J_eff (L123-226), machine-verified in Lean 4 (`Loop_016_bmp_sox9_wnt_digits.lean`), plus both the 1D distal-arc PDE (L295-408) and the 2D fan-shaped embryonic autopod PDE with distal AER-FGF wavelength modulation (L411-531) and explicit zero-diffusion (D_B = D_W = 0) negative control." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-2> ;
        pk:hasScore "0.97"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L123–L226" ;
        dcterms:description "Exact 3-node J_3 and reduced 2-diffuser J_eff Jacobian, dispersion curve, and D=0 negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L123-L226> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-raspopovic-bmp-sox9-wnt-digits-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2014-raspopovic-bmp-sox9-wnt-digits.py L411–L531" ;
        dcterms:description "2D polar-fan embryonic autopod PDE with distal AER-FGF wavelength modulation producing 5 unbranched radial Sox9 rays" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2014-raspopovic-bmp-sox9-wnt-digits.py#L411-L531> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


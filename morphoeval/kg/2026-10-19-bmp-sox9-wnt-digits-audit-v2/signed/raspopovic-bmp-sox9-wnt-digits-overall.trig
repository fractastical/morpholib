sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raspopovic-bmp-sox9-wnt-digits> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-overall> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-raspopovic-bmp-sox9-wnt-digits-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Raspopovic et al. (2014) 3-node Bmp-Sox9-Wnt Turing digit patterning network modulated by distal FGF — MorphoEval overall 96.2/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Pass 2 (v2) remediated evaluation of `2014-raspopovic-bmp-sox9-wnt-digits.py` (overall weighted score: 96.3/100, +39.5 over Pass 1). Implements both the 1D distal-arc and 2D polar-fan embryonic autopod reaction-diffusion PDEs for the 3-node cell-autonomous Sox9 (D_S = 0) + diffusing Bmp (D_B = 2.5) + diffusing Wnt (D_W = 0.25) network modulated by distal AER-FGF, verifies the reduced 2-diffuser Jacobian identity det(-J_3) = mu_S * det(J_eff) = 3.27 and out-of-phase eigenmode opposition (r_SB = -0.9772, r_SW = -0.9975), reproduces the 7-regime FGF/Hox wavelength series (r = 0.9781, digit count r = 0.9974) and all 6 pharmacological/genetic perturbations (WT=5, LDN-193189=1, CHIR99021=2, IWP-2=6, Tbx2/Hox polydactyly=6, D=0 ablation control=0), and segments the vendored E12.5 WT Sox9 (5 digits, CV=0.1549) and E13.5 Tbx2-/- polydactylous (6 digits) WISH mouse limb bud specimen image. Overall 96.2/100 (faithfulness 95.9, reproducibility 97.0); rubric morphoeval 0.1.0; checkpoint commit 45d4150; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 97, Morphological realism / specimen match 95, Parameter expressivity 96, Morphometric validation 96, Source and data traceability 97, Code-to-model traceability 97, Reproducibility package 97. Output judged: docs/media/bmp_sox9_wnt_digits_comparison.png: rendered output of 2014-raspopovic-bmp-sox9-wnt-digits.py at 45d4150, image/png, 757019 B, 2138×1464 px, artifact_sha256 ff1a2ff606758fb64f4b6b600e57acc678fcb0741c10f2b103c3e024a724a16e (sha256 ff1a2ff606758fb64f4b6b600e57acc678fcb0741c10f2b103c3e024a724a16e), spec_fingerprint 32ffd4da7438d98577c009d5ac5a4c2bdcbd27793695743733dcb58e60f808b5. Dual provenance: spec_fingerprint: 32ffd4da7438d98577c009d5ac5a4c2bdcbd27793695743733dcb58e60f808b5; artifact_sha256: ff1a2ff606758fb64f4b6b600e57acc678fcb0741c10f2b103c3e024a724a16e; input_dataset_sha256: {datasets/bmp_sox9_wnt_digits/bmp_sox9_wnt_digits_reference.json=c0444b665610be2e..., datasets/bmp_sox9_wnt_digits/paper_citations.bib=88ff32a60b567060..., datasets/bmp_sox9_wnt_digits/scout_manifest.json=f990b473b6a93cfa..., datasets/bmp_sox9_wnt_digits/sox9_limb_digits_specimen.jpg=533f621904d6f2ce...}. Supersedes audit: 2026-10-19-bmp-sox9-wnt-digits-audit." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Couple the 2D polar-fan Bmp-Sox9-Wnt reaction-diffusion solver to a moving-boundary finite-element limb-bud outgrowth mesh." ;
        pk:hasScore "0.962"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 016 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg Turing wavelength at 42 µm on Gasterosteus doryssus_mid (Truckee Fm, 10.01 Ma) faithfully reproduces Gasterosteus doryssus_mid morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Gasterosteus doryssus_mid specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py; output: docs/media/gasterosteus_doryssus_mid_turing_wavelength_s0_growth.gif; organism: Gasterosteus doryssus_mid; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion: a critical wavenumber selected by diffusion and reaction rates. | Kondo & Asai 1995: reaction-diffusion waves set pigment spacing on fish skin. | Bell & Haglund 1982 and Hunt, Bell & Travis 2008: directional pelvic reduction in Truckee Fm G. doryssus. | Shapiro et al. 2004 and Chan et al. 2010: extant pelvic reduction maps to a Pitx1 enhancer deletion. | Voje, Bell & Stuart 2022: CC BY 4.0 plate of weakly and strongly armored G. doryssus morphs.; reconstructed_in_script: Schnakenberg Jacobian at (a, b) = (0.062, 1.18), σ(k), and Du bisection onto 41.94 µm. | Chronoseries (Dv/Du, γ) = (14.2, 1.55), (18, 1), (24.8, 0.62) giving 32.14, 41.94, 56.90 µm. | Spectral diffusion plus reaction substeps, ratio sweep, equal-diffusion control, RK2 dispersion check.; transfer_boundary: 42 µm melanophore spacing is transferred from extant pigment-pattern RD onto a fossil that preserves bone, not chromatophores.; does_not_claim: That the centimetre-scale fossil photograph is a 42 µm histological section. | That Pitx1 was sequenced from these Miocene fish. | That the unguided stripe field by itself reproduces the skeleton (pure-field CV is about 58).]; phenomenon_size: 32 µm (3.168e-05 m, log10=-4.499 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 32 µm to 9.9 cm): 32 µm:gasterosteus-aculeatus-bioelectric-polarity, 118 µm:gasterosteus-aculeatus-vertex-packing, 2.2 mm:gasterosteus-aculeatus-turing-wavelength, 4.1 mm:gasterosteus-aculeatus-clock-wavefront, 9.6 mm:gasterosteus-aculeatus-elastic-buckling, 1.3 cm:gasterosteus-aculeatus-morphogen-condensation, 1.7 cm:gasterosteus-aculeatus-flux-canalization, 2.2 cm:gasterosteus-aculeatus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1017/s0094837300006990>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature02415>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1558-5646.2007.00310.x>,
            <https://doi.org/10.1111/jeb.13984>,
            <https://doi.org/10.1126/science.1182213> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 42 µm on Gasterosteus doryssus_mid (Truckee Fm, 10.01 Ma) — Reproducibility package: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Seed 3230, deterministic 48-step Du bisection, --self-test asserts wavelength order, |λ_mid − 41.94 µm| < 0.05, Pearson r > 0.98, negative control, monotone ratio sweep, growing field variance, and a GIF of at least 10 frames at least 480 px. The self-test passed on 2026-10-27 (r = 0.98974, λ = 32.14/41.94/56.90 µm). Dependencies are the repo scientific stack (numpy, scipy, Pillow, matplotlib). No second machine was used." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py L697–L726" ;
        dct:description "self_test assertions and the pass line" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py#L697-L726> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/gasterosteus_doryssus_mid_turing_wavelength_s0/README.md L1–L40" ;
        dct:description "scale, age, chronoseries table, and the run command" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/datasets/gasterosteus_doryssus_mid_turing_wavelength_s0/README.md#L1-L40> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent Pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


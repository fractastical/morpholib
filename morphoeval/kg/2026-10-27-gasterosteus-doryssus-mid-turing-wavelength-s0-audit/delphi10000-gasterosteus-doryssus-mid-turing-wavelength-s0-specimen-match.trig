sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 42 µm on Gasterosteus doryssus_mid (Truckee Fm, 10.01 Ma) — Morphological realism / specimen match: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The delivered GIF's last frame is the saturated activator registered onto the real CC BY plate. Computer-vision similarity against that plate is 92.3 (12 frames, 640×480, first-to-last mean absolute difference 0.029). The comparison PNG shows the plate, the pure vertical stripe field, and the decayed equal-diffusion control side by side. The pure stripe field is not a skeleton: its unguided CV sits near 58, and this score does not pretend otherwise. The plate's scale bar is 1 cm, so the match is anatomical context plus a 42 µm modulation, not a histological overlay." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py L279–L317: composite_on_specimen modulates the fossil by the activator; it is not an unguided prediction <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py#L279-L317>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/gasterosteus_doryssus_mid_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12-frame 640x480 growth GIF, registered render, CV 92.3 — docs/media/gasterosteus_doryssus_mid_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py at 0c76d15d, image/gif, 2323139 B, 640×480 px, 12 frames, artifact_sha256 101ffda1755cf4e1742f15b040a2a2c4e8e46fafa1f20a7ecbbcb9a7e060dc44 (sha256 101ffda1755cf4e1742f15b040a2a2c4e8e46fafa1f20a7ecbbcb9a7e060dc44), spec_fingerprint dc4c1601bb00a6d80d4baed16fe77c8243511e825b49d7d785e454e5f8378e0b" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/gasterosteus_doryssus_mid_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "plate, pure activator stripes, equal-diffusion control, dispersion, chronoseries, ratio sweep — docs/media/gasterosteus_doryssus_mid_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py at 0c76d15d, image/png, 428769 B, 1512×984 px, artifact_sha256 3a2189b6a31a49538c2196ba7de722326374fc91694b04ac38b897977e01b26e (sha256 3a2189b6a31a49538c2196ba7de722326374fc91694b04ac38b897977e01b26e), spec_fingerprint dc4c1601bb00a6d80d4baed16fe77c8243511e825b49d7d785e454e5f8378e0b" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent Pass 1)" ;
        dct:identifier "grok-4.7" ;

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mid-stage Turing margin" ;
    dct:description "Necessary margin for a positive growth band at 42 µm | Variables: scaled Jacobian entries fu = 900, gv = -1543, Du = 100, Dv = 1800" ;
    dct:source "Kondo & Asai (1995) DOI:10.1038/376765a0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py>,

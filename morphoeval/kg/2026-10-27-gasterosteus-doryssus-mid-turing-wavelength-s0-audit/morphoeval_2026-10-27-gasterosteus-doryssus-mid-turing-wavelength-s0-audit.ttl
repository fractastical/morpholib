    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_early < lambda_mid = 41.94 µm < lambda_late" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/s0094837300006990>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature02415>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2007.00310.x>,
        <https://doi.org/10.1111/jeb.13984>,
        <https://doi.org/10.1126/science.1182213> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3230.lambdaMidNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3230.wavelength_lengthens_along_pelvic_reduction" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusivity ratio increases as armor is lost" ;
    dct:description "Inhibitor range at 42 µm, distinct from the 1.7 mm organ-scale sibling | Variables: Dv/Du at the vestigial-spine mid stage versus its neighbours" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;

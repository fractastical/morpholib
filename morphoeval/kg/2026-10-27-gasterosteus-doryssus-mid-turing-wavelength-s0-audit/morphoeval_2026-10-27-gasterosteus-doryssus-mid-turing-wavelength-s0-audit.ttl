    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(Dv/Du)_early = 14.2 < (Dv/Du)_mid = 18.0 < (Dv/Du)_late = 24.8" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/s0094837300006990>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature02415>,

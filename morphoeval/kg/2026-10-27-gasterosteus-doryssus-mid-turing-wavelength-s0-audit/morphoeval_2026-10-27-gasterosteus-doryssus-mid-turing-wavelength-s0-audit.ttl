    pk:leanDeclaration "MathOfBiology.Loop_3230.ratioMidTimes10" ;
    pk:leanTheorem "MathOfBiology.Loop_3230.diffusivity_ratio_increases_as_armor_is_lost" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion control has negative reaction trace" ;
    dct:description "Negative control for Turing wavenumber selection | Variables: Schnakenberg Jacobian trace at (a, b) = (0.062, 1.18)" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py>,

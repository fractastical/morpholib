<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavelength ordering at 42 µm" ;
    dct:description "What changes from doryssus_early to doryssus_mid to doryssus_late at this detail scale | Variables: pelvic index P and reaction rate gamma at T = 0, +9, +22 kyr" ;
    dct:source "Hunt, Bell & Travis (2008) DOI:10.1111/j.1558-5646.2007.00310.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0.py>,

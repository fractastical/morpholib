sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 42 µm on Gasterosteus doryssus_mid (Truckee Fm, 10.01 Ma) — Morphometric validation: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Sixteen-wavenumber analytic versus RK2 growth rates: Pearson r = 0.9897, RMSE = 0.070. Equal-diffusion σ_max = -0.324 against a null of 0. Specimen coherency 0.596 versus registered-frame coherency 0.603; foreground fraction 0.589 versus 0.821. Radial-spectrum KS D = 0.333. Orientation-histogram Pearson r = 0.669. These are not self-copies. Missing this pass: a Du uncertainty band, an explicit stored pure-field CV, and a bone-versus-sediment split of the plate." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-rk2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-early-to-late-wavelength-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-mid-stage-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-radial-spectrum-ks-statistic-specimen-vs-simulation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-ratio-sweep-wavelength-slope>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-simulation-gray-level-cv-versus-specimen>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-rk2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r analytic vs RK2 = 0.9897 Pearson r" ;
        dct:description "RMSE 0.070349" ;
        schema:measurementTechnique "16 wavenumbers; closed-form σ(k) versus RK2 integration of the linear mode ODE" ;
        schema:name "dispersion Pearson r analytic vs RK2" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9897" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-rk2-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-rk2-reference> a schema:PropertyValue ;
        dct:source "exact eigenvalue of the Jacobian" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.070349 1/time" ;
        dct:description "rmse" ;
        schema:measurementTechnique "sqrt mean square gap between analytic and RK2 growth rates" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.070349" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "perfect integrator match" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-early-to-late-wavelength-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "early-to-late wavelength ratio = 1.7704 λ_late / λ_early" ;
        dct:description "early 32.139 µm, mid 41.940 µm, late 56.898 µm" ;
        schema:measurementTechnique "same Du, stage-specific (Dv/Du, γ) at T = 0 and T = +22 kyr" ;
        schema:name "early-to-late wavelength ratio" ;
        schema:unitText "λ_late / λ_early" ;
        schema:value "1.7704" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-early-to-late-wavelength-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-early-to-late-wavelength-ratio-reference> a schema:PropertyValue ;
        dct:source "null of no change along the chronoseries" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control sigma_max = -0.3236 1/time" ;
        dct:description "negative control; pattern must decay" ;
        schema:measurementTechnique "fastest_mode with Dv/Du = 1 at γ = 1" ;
        schema:name "equal-diffusion control sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.3236" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing threshold; negative means the homogeneous state is stable" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-mid-stage-critical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mid-stage critical wavelength = 41.94 µm" ;
        dct:description "pixel wavelength 13.9946; sigma_max 0.1893" ;
        schema:measurementTechnique "argmax_k sigma(k) of the Schnakenberg Jacobian, scaled so the mid mode is the assigned 42 µm" ;
        schema:name "mid-stage critical wavelength" ;
        schema:unitText "µm" ;
        schema:value "41.94" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-mid-stage-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-mid-stage-critical-wavelength-reference> a schema:PropertyValue ;
        dct:source "nominal 42 µm label; the calibrated size is 4.194e-05 m = 41.94 µm" ;
        schema:value "42.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-radial-spectrum-ks-statistic-specimen-vs-simulation> a schema:PropertyValue,

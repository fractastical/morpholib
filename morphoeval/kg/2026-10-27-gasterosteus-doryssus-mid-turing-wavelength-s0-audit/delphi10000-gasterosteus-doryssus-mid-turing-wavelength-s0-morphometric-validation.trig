        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-radial-spectrum-ks-statistic-specimen-vs-simulation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-measurement-radial-spectrum-ks-statistic-specimen-vs-simulation-reference> a schema:PropertyValue ;
        dct:source "identical spectra" ;

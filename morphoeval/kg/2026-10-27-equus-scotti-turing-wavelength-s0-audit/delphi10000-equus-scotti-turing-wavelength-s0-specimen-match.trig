    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/equus_scotti_turing_wavelength_s0_growth.gif (generated output)" ;

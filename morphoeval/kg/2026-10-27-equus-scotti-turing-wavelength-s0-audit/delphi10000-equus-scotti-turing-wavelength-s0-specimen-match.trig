sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Equus scotti follicular Turing wavelength at 164 µm (Irvingtonian, 0.6 Ma) — Morphological realism / specimen match: 71/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The specimen is Horsfall's 1905 public-domain restoration, SHA-256 pinned, shown beside the activator and as a feathered flank overlay in the comparison figure and in a 12-frame GIF (960×649). The overlay is visibly an ocellus field, feathered so the torso window is not a hard rectangle. No measurement is taken from the plate itself: foreground, coherency, and the radial spectrum of the drawing are not compared with the simulation. The plate is a whole animal; 164 µm is below its resolution, and the figure says so." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L344–L388: measure_morphoeval has no specimen-image segmentation <https://github.com/fractastical/morpholib/blob/613cdbbd89d39feb2d3ec526d962fb10569c7a9c/models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py#L344-L388>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.71"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L262–L304" ;
        dct:description "Feathered flank paint and 12-frame GIF on the Horsfall plate" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/613cdbbd89d39feb2d3ec526d962fb10569c7a9c/models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py#L262-L304> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

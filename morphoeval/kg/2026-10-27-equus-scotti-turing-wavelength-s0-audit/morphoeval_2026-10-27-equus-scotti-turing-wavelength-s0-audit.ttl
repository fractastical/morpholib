<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-equus-scotti-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-equus-scotti-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-equus-scotti-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-equus-scotti-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg determinant at the Equus scotti steady state" ;
    dct:description "Homogeneous steady state is a saddle-free source for diffusion-driven instability at 164.3 µm | Variables: fu, fv, gu, gv scaled by 10 so the integer determinant equals 100" ;
    dct:source "Schnakenberg 1979 JTB 81:389, doi:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/613cdbbd89d39feb2d3ec526d962fb10569c7a9c/morphoeval/lean/loops/Loop_3220_equus_scotti_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J) = fu*gv - fv*gu > 0, with (fu,fv,gu,gv) = (0.8, 1, -1.8, -1) at (a,b)=(0.10,0.90)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/s0094837300003109>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1469-7998.1977.tb04204.x> ;
    pk:hypothesisType "1. Chemical Turing / RD" ;
    pk:leanDeclaration "MathOfBiology.Loop_3220.schnakenbergDetScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3220.schnakenberg_determinant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-equus-scotti-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion-driven condition at Dv/Du = 20, and its failure when Du = Dv" ;
    dct:description "Necessary condition for a positive Turing wavenumber at this follicular scale | Variables: Du scaled to 1, Dv = 20 for Equus scotti; ablation Du = Dv = 1" ;
    dct:source "Turing 1952 Phil. Trans. R. Soc. B 237:37, doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/613cdbbd89d39feb2d3ec526d962fb10569c7a9c/morphoeval/lean/loops/Loop_3220_equus_scotti_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Dv*fu + Du*gv > 0 at the scotti ratio; the same contraction is negative when Du = Dv" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/s0094837300003109>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1469-7998.1977.tb04204.x> ;
    pk:hypothesisType "1. Chemical Turing / RD" ;
    pk:leanDeclaration "MathOfBiology.Loop_3220.diffusionDrive" ;
    pk:leanTheorem "MathOfBiology.Loop_3220.scotti_ratio_is_diffusion_driven" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-equus-scotti-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronospecies wavelength order and eight-mode patch count" ;
    dct:description "What changes at 0.6 Ma and 164 µm relative to Pliohippus pernix and Equus quagga | Variables: wavelengths in nanometres; patch width 1314400 nm" ;
    dct:source "Bard 1977 J. Zool. 183:527, doi:10.1111/j.1469-7998.1977.tb04204.x; MacFadden 1986 Paleobiology 12:355, doi:10.1017/s0094837300003109" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/613cdbbd89d39feb2d3ec526d962fb10569c7a9c/morphoeval/lean/loops/Loop_3220_equus_scotti_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_plio 198.688 µm > lambda_scotti 164.3 µm < lambda_quagga 400 µm; N = 8 on a 1314.4 µm patch" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/s0094837300003109>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1469-7998.1977.tb04204.x> ;
    pk:hypothesisType "1. Chemical Turing / RD" ;
    pk:leanDeclaration "MathOfBiology.Loop_3220.chronospecies_wavelength_order" ;
    pk:leanTheorem "MathOfBiology.Loop_3220.eight_follicular_modes_on_the_scotti_patch" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

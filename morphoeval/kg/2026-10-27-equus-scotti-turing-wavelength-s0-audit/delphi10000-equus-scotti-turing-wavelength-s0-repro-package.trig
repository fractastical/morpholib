sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Equus scotti follicular Turing wavelength at 164 µm (Irvingtonian, 0.6 Ma) — Reproducibility package: 81/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "--self-test checks the Turing inequalities, the linear peak within 1 µm of 164.3, Pearson r > 0.98, a non-equal nonlinear wavelength, and a GIF of at least 12 frames at least 480 px on the short side. The seed is 3220. Dataset hashes are verified before the solve. The self-test does not yet assert the ablation or the chronoseries." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-repro-package-1> ;
        pk:hasScore "0.81"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-scotti-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py L397–L424" ;
        dct:description "Deterministic self-test and render" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/613cdbbd89d39feb2d3ec526d962fb10569c7a9c/models/2026-delphi10000-equus-scotti-turing-wavelength-s0.py#L397-L424> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary pass-1 assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bischof-xenopus-craniofacial-remap> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY 4.0 dorsal whole-mount photograph of Xenopus laevis (`datasets/xenopus_craniofacial_remap/xenopus_craniofacial_specimen.jpg`), automatically segments the PCA craniofacial midline, snout apex, 40-bin dorsal triangular head width profile (`r = 0.9114`, `RMSE = 0.1045`), and bilateral dorsolateral eyes (`segment_xenopus_specimen`, L300-388: `N = 2` eyes at `s/L = 0.1134` and `0.1111`, AP symmetry `|Delta s| = 0.0023`), and overlays them in Panels C1-C2." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2019-bischof-xenopus-craniofacial-remap.py L300–L388" ;
        dct:description "Automated PCA craniofacial midline, snout apex, head width profile, and bilateral eye CV segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L300-L388> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/xenopus_craniofacial_remap_comparison.png (generated output)" ;
        dct:description "9-panel dark-mode comparison figure with dorsal Xenopus specimen CV overlay and head-width match — docs/media/xenopus_craniofacial_remap_comparison.png: rendered output of 2019-bischof-xenopus-craniofacial-remap.py at 317bc3c, image/png, 1009445 B, 2227×1863 px, artifact_sha256 a05e5ee5c81988c6442c768499a76a5f4e0a7ddae1b23bca3a0585f34a108cc2 (sha256 a05e5ee5c81988c6442c768499a76a5f4e0a7ddae1b23bca3a0585f34a108cc2), spec_fingerprint b508063893dc2ba283709bbd6f8bccfb0c0050e2d4a352a6be0037d6b7fbad04" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


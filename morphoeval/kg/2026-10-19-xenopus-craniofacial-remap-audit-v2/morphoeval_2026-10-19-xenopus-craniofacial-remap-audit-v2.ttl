    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Reproducibility package: 92/100" ;

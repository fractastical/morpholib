<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-1>,
        <https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-2>,
        <https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-3> .

<https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Vandenberg, Adams & Levin (2012) Procrustes Lyapunov Error Equilibrium & Strict Closed-Loop Attractor Decrease Law" ;
    dct:description "Proves that the target froglet craniofacial anatomy X^* is the unique zero-error global minimum of the Procrustes Lyapunov functional and that closed-loop attractor remodeling steps strictly contract Procrustes error toward 0 | Variables: X(t) = (x_i, y_i): 2D Procrustes craniofacial landmark coordinates across NF stages 45..65; X^* = (x_star, y_star): target post-metamorphic froglet landmark coordinates; V(X): Procrustes Lyapunov error functional" ;
    dct:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241(5):863-878 Figs. 1-5; Pezzulo & Levin (2016) J. R. Soc. Interface 13:20160555" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L115-L215>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_085_xenopus_craniofacial_remap.lean#L18-L55> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def sq_int (z : Int) : Int :=
  z * z
def procrustes_lyapunov_2x (x y x_star y_star : Int) : Int :=
  sq_int (x - x_star) + sq_int (y - y_star)
def attractor_step (x x_star : Int) : Int :=
  x_star + (x - x_star) / 2
theorem procrustes_lyapunov_strict_decrease (x_star y_star dx : Int) :
    procrustes_lyapunov_2x x_star y_star x_star y_star = 0 ∧
    procrustes_lyapunov_2x (-34) (-8) (-34) 28 = 1296 ∧
    procrustes_lyapunov_2x (attractor_step (-34) (-34)) (attractor_step (-8) 28) (-34) 28 = 324 ∧
    procrustes_lyapunov_2x (-34) (attractor_step (attractor_step (-8) 28) 28) (-34) 28 = 81 ∧
    sq_int (-dx) = sq_int dx := by
  refine ⟨?_, by decide, by decide, by decide, ?_⟩
  · simp [procrustes_lyapunov_2x, sq_int]
  · simp [sq_int, Int.neg_mul_neg]
"""^^pk:lean4 ;
    skos:notation "V(X) = (1/2) ||X - X^*||_F^2 >= 0;   V(X^*) = 0;   dV/dt = -sum_i ||dx_i/dt||^2 / eta_MMP < 0 (X != X^*)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2016.0555>,
        <https://doi.org/10.1242/dev.073759>,
        <https://doi.org/10.1242/dev.175893> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Procrustes Landmark Attractor Dynamics & Target-Morphology Error Minimization" ;
    pk:leanDeclaration "MathOfBiology.Loop_085.procrustes_lyapunov_2x" ;
    pk:leanTheorem "MathOfBiology.Loop_085.procrustes_lyapunov_strict_decrease" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Open-Loop Fixed-Displacement Vector Failure vs Closed-Loop Attractor Convergence & MMP Arrest Law" ;
    dct:description "Proves that open-loop hardwired displacement (Null Model 1 in Vandenberg et al. 2012 Fig. 1A) permanently retains the initial Picasso scramble defect delta_0, whereas closed-loop attractor dynamics scale migration speed with defect distance, stop at x_star, and arrest under GM6001 MMP inhibition (eta_MMP = 0, Pinet et al. 2019) | Variables: x_0: perturbed initial organ coordinate at NF stage 45; x_wt_0: wild-type NF 45 coordinate; delta_0 = x_0 - x_wt_0: initial Picasso surgical/teratogenic displacement; eta_MMP: matrix metalloproteinase remodeling mobility; K_i: target-homing stiffness" ;
    dct:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241:863-878 Fig. 1 & Discussion; Pinet et al. (2019) Development 146:dev175893 Figs. 3-6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L218-L355>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_085_xenopus_craniofacial_remap.lean#L58-L89> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def open_loop_final (x_0 x_wt_0 x_star : Int) : Int :=
  x_0 + (x_star - x_wt_0)
def closed_loop_vel (eta_mmp K x x_star : Int) : Int :=
  -eta_mmp * K * (x - x_star)
theorem open_loop_divergence_and_mmp_arrest (x_wt_0 delta_0 x_star eta_mmp K x : Int) :
    open_loop_final (x_wt_0 + delta_0) x_wt_0 x_star - x_star = delta_0 ∧
    closed_loop_vel eta_mmp K x_star x_star = 0 ∧
    closed_loop_vel 0 K x x_star = 0 ∧
    closed_loop_vel 1 5 (-8) 28 = 180 ∧
    closed_loop_vel 1 5 10 28 = 90 := by
  refine ⟨?_, ?_, ?_, by decide, by decide⟩
  · dsimp [open_loop_final]; omega
  · simp [closed_loop_vel]
  · simp [closed_loop_vel]
"""^^pk:lean4 ;
    skos:notation "x_i^open(T) - x_i^* = x_i(0) - x_i^WT(0) = delta_0 != 0;   dx_i/dt = -eta_MMP * K_i * (x_i - x_i^*);   eta_MMP = 0 ==> dx_i/dt = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2016.0555>,
        <https://doi.org/10.1242/dev.073759>,
        <https://doi.org/10.1242/dev.175893> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Procrustes Landmark Attractor Dynamics & Target-Morphology Error Minimization" ;
    pk:leanDeclaration "MathOfBiology.Loop_085.closed_loop_vel" ;
    pk:leanTheorem "MathOfBiology.Loop_085.open_loop_divergence_and_mmp_arrest" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/bischof-xenopus-craniofacial-remap-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Bilateral Symmetry Restoration & Multi-Perturbation Craniofacial Equifinality Law" ;
    dct:description "Establishes that closed-loop craniofacial remodeling eliminates initial bilateral asymmetry (5696 -> 0) and restores mirror-symmetric eye and naris placement across scrambled Picasso, caudal eye rotation, and lateral jaw perturbations, whereas open-loop displacement preserves the initial asymmetry (5696) | Variables: (x_L, y_L), (x_R, y_R): left and right dorsolateral eye or naris coordinates; (-x_star, y_star), (x_star, y_star): mirror-symmetric froglet target coordinates" ;
    dct:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241:863-878 Figs. 3-7; Pinet et al. (2019) Development 146:dev175893" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L290-L435>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_085_xenopus_craniofacial_remap.lean#L92-L129> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def bilateral_asymmetry_sq (x_L y_L x_R y_R : Int) : Int :=
  sq_int (x_L + x_R) + sq_int (y_L - y_R)
def asymptotic_eye_pair (is_closed_loop eta_mmp x_L0 y_L0 x_R0 y_R0 dx_wt_L dy_wt dx_wt_R x_star y_star : Int) :
    Int × Int × Int × Int :=
  if is_closed_loop > 0 then
    if eta_mmp > 0 then (-x_star, y_star, x_star, y_star)
    else (x_L0, y_L0, x_R0, y_R0)
  else
    (x_L0 + dx_wt_L, y_L0 + dy_wt, x_R0 + dx_wt_R, y_R0 + dy_wt)
theorem bilateral_symmetry_restoration_regimes (x_star y_star : Int) :
    bilateral_asymmetry_sq (-x_star) y_star x_star y_star = 0 ∧
    bilateral_asymmetry_sq (-34) (-21) 74 43 = 5696 ∧
    bilateral_asymmetry_sq (-16) (-8) 56 56 = 5696 ∧
    asymptotic_eye_pair 1 1 (-34) (-21) 74 43 18 13 (-18) 34 28 = (-34, 28, 34, 28) ∧
    asymptotic_eye_pair 0 1 (-34) (-21) 74 43 18 13 (-18) 34 28 = (-16, -8, 56, 56) ∧
    asymptotic_eye_pair 1 0 (-34) (-21) 74 43 18 13 (-18) 34 28 = (-34, -21, 74, 43) := by
  refine ⟨?_, by decide, by decide, by decide, by decide, by decide⟩
  · dsimp [bilateral_asymmetry_sq, sq_int]
    have h1 : -x_star + x_star = 0 := by omega
    have h2 : y_star - y_star = 0 := by omega
    rw [h1, h2]
    decide
"""^^pk:lean4 ;
    skos:notation "A_sym^2(x_L, y_L, x_R, y_R) = (x_L + x_R)^2 + (y_L - y_R)^2;   lim_{t->T} A_sym^2(X^closed(t)) = A_sym^2(-x^*, y^*, x^*, y^*) = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2016.0555>,
        <https://doi.org/10.1242/dev.073759>,
        <https://doi.org/10.1242/dev.175893> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Procrustes Landmark Attractor Dynamics & Target-Morphology Error Minimization" ;
    pk:leanDeclaration "MathOfBiology.Loop_085.bilateral_asymmetry_sq" ;
    pk:leanTheorem "MathOfBiology.Loop_085.bilateral_symmetry_restoration_regimes" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


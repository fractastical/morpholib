sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bischof-xenopus-craniofacial-remap> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-bischof-xenopus-craniofacial-remap.py L72–L165" ;
        dcterms:description "Inter-organ coupling matrix C_ij, Procrustes Lyapunov functional V(X), and closed-loop attractor RHS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L72-L165> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2019-bischof-xenopus-craniofacial-remap.py L168–L252" ;
        dcterms:description "RK4 Procrustes landmark integrator across NF stages 45->65 vs open-loop vector null model" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L168-L252> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_085_xenopus_craniofacial_remap.lean L18–L129" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for Lyapunov decrease, open-loop divergence/MMP arrest, and bilateral symmetry restoration" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_085_xenopus_craniofacial_remap.lean#L18-L129> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements the coupled Procrustes landmark attractor ODE dx_i/dt = eta_MMP * [-K_i*(x_i - x_i^*) - sum_j C_ij*((x_i - x_j) - (x_i^* - x_j^*))] with RK4 integration, exact Procrustes Lyapunov energy functional V(X) (L72-195), and exact spectral propagator across the 15x15 (alpha_pert, eta_MMP) morphospace (L235-295), verified by 3 standalone Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_085_xenopus_craniofacial_remap.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Every computational function and docstring maps directly to Vandenberg, Adams & Levin (2012) Figs. 1-7, Pinet et al. (2019) Figs. 3-6, and the 3 Lean 4 theorems in `Loop_085_xenopus_craniofacial_remap.lean` and `morphoeval/math_kg_loops/bischof-xenopus-craniofacial-remap.yaml`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2019-bischof-xenopus-craniofacial-remap.py L1–L26" ;
        dcterms:description "Module docstring mapping Procrustes attractor equations to Vandenberg et al. (2012), Pinet et al. (2019), and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L1-L26> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/bischof-xenopus-craniofacial-remap.yaml L1–L108" ;
        dcterms:description "Math KG loop registration linking equations, Lean 4 theorems, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/bischof-xenopus-craniofacial-remap.yaml#L1-L108> .


    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
            <https://doi.org/10.1098/rsif.2016.0555>,
            <https://doi.org/10.1242/dev.073759>,
            <https://doi.org/10.1242/dev.175893> .
    <https://doi.org/10.1002/dvdy.23770> dct:date "2012"^^xsd:gYear ;
        dct:title "Normalized shape and location of perturbed craniofacial structures in the Xenopus tadpole reveal an innate ability to achieve correct morphology" .
    <https://doi.org/10.1098/rsif.2016.0555> dct:date "2016"^^xsd:gYear ;
        dct:title "Top-down models in biology: explanation and control of complex living systems above the molecular level" .
    <https://doi.org/10.1242/dev.073759> dct:date "2012"^^xsd:gYear ;
        dct:title "Transmembrane voltage potential controls embryonic eye patterning in Xenopus laevis" .
    <https://doi.org/10.1242/dev.175893> dct:date "2019"^^xsd:gYear ;
        dct:title "Adaptive correction of craniofacial defects in pre-metamorphic Xenopus laevis tadpoles involves thyroid hormone-independent tissue remodeling" .
}


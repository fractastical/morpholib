sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bischof-xenopus-craniofacial-remap> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bischof-xenopus-craniofacial-remap-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Vandenberg, Adams & Levin (2012) & Pinet et al. (2019) Picasso tadpole craniofacial attractor remodeling — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 6 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L572-662): Picasso closed-loop final Procrustes RMS error (`0.0009` vs `0.0` reference, 4-regime RMSE `0.0007`), open-loop fixed-vector residual Procrustes error (`0.3439` vs `0.3439` exact reference), GM6001 MMP blockade Procrustes defect delta (`0.2766` vs `0.145` reference), bilateral symmetry restoration fraction (`0.9997` vs `1.0` reference), initial migration speed vs defect distance correlation (`r = 0.9495` vs `0.98` reference), and specimen dorsal head width correlation (`r = 0.9114`, bilateral eye `|Delta s| = 0.0023`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-bilateral-craniofacial-symmetry-restoration-ratio-across-picasso-and-unilateral-eye-jaw-perturbations>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-gm6001-mmp-inhibition-blockade-residual-procrustes-rms-defect-vs-wild-type-closed-loop-remodeling>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-initial-organ-migration-speed-vs-defect-distance-linear-scaling-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-open-loop-fixed-displacement-vector-null-hypothesis-residual-procrustes-rms-error-at-nf-stage-65>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-picasso-scrambled-tadpole-closed-loop-procrustes-rms-error-at-nf-stage-65>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-xenopus-laevis-specimen-dorsal-head-contour-width-correlation-r-and-bilateral-eye-ap-symmetry>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-bilateral-craniofacial-symmetry-restoration-ratio-across-picasso-and-unilateral-eye-jaw-perturbations> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bilateral craniofacial symmetry restoration ratio across Picasso and unilateral eye/jaw perturbations = 0.9997 symmetry restoration fraction" ;
        dct:description "Picasso asymmetry 0.7150 -> 0.0002 vs open-loop null control asymmetry = 0.7150 (std across closed-loop regimes = 0.0003)" ;
        schema:measurementTechnique "Fractional reduction 1 - A_sym(65)/A_sym(45) of dorsal bilateral asymmetry across paired eyes, nares, and jaw" ;
        schema:name "Bilateral craniofacial symmetry restoration ratio across Picasso and unilateral eye/jaw perturbations" ;
        schema:unitText "symmetry restoration fraction" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-bilateral-craniofacial-symmetry-restoration-ratio-across-picasso-and-unilateral-eye-jaw-perturbations-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-bilateral-craniofacial-symmetry-restoration-ratio-across-picasso-and-unilateral-eye-jaw-perturbations-reference> a schema:PropertyValue ;
        dct:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241:863-878 Figs. 3-7 (Lean 4 bilateral_symmetry_restoration_regimes)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-gm6001-mmp-inhibition-blockade-residual-procrustes-rms-defect-vs-wild-type-closed-loop-remodeling> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "GM6001 MMP inhibition blockade residual Procrustes RMS defect vs wild-type closed-loop remodeling = 0.2766 Procrustes RMS defect delta" ;
        dct:description "GM6001 MMP-inhibited final error = 0.2775 vs uninhibited closed-loop = 0.0009 (defect ratio = 299.2x)" ;
        schema:measurementTechnique "Difference in NF stage 65 Procrustes RMS error between GM6001 MMP blockade (eta_MMP=0.04) and uninhibited Picasso remodeling (eta_MMP=1.0)" ;
        schema:name "GM6001 MMP inhibition blockade residual Procrustes RMS defect vs wild-type closed-loop remodeling" ;
        schema:unitText "Procrustes RMS defect delta" ;
        schema:value "0.2766" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-gm6001-mmp-inhibition-blockade-residual-procrustes-rms-defect-vs-wild-type-closed-loop-remodeling-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-gm6001-mmp-inhibition-blockade-residual-procrustes-rms-defect-vs-wild-type-closed-loop-remodeling-reference> a schema:PropertyValue ;
        dct:source "Pinet et al. (2019) Development 146:dev175893 Figs. 4-6 (MMP inhibition blocks adaptive pre-metamorphic craniofacial remodeling)" ;
        schema:value "0.145" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-initial-organ-migration-speed-vs-defect-distance-linear-scaling-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Initial organ migration speed vs defect distance linear scaling correlation r = 0.9495 Pearson r" ;
        dct:description "Pearson r = 0.9495 across 20 landmark states in 4 closed-loop regimes vs flat speed in open-loop null control" ;
        schema:measurementTechnique "Pearson correlation between initial landmark displacement ||x_i(45) - x_i^*|| and initial remodeling speed ||dx_i/dt|| across 20 landmark trajectories" ;
        schema:name "Initial organ migration speed vs defect distance linear scaling correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9495" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-initial-organ-migration-speed-vs-defect-distance-linear-scaling-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-initial-organ-migration-speed-vs-defect-distance-linear-scaling-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241:863-878 Fig. 6 (ectopic organs further from target move faster)" ;
        schema:value "0.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-open-loop-fixed-displacement-vector-null-hypothesis-residual-procrustes-rms-error-at-nf-stage-65> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Open-loop fixed-displacement vector null hypothesis residual Procrustes RMS error at NF stage 65 = 0.3439 Procrustes RMS distance" ;
        dct:description "Open-loop residual error = 0.3439 matches exact initial perturbation ||Delta X(0)|| = 0.3439 (identity diff = 2.78e-17)" ;
        schema:measurementTechnique "Hardwired wild-type displacement vector Delta_WT = X^* - X_WT(45) applied to Picasso initial state" ;
        schema:name "Open-loop fixed-displacement vector null hypothesis residual Procrustes RMS error at NF stage 65" ;
        schema:unitText "Procrustes RMS distance" ;
        schema:value "0.3439" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-open-loop-fixed-displacement-vector-null-hypothesis-residual-procrustes-rms-error-at-nf-stage-65-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-open-loop-fixed-displacement-vector-null-hypothesis-residual-procrustes-rms-error-at-nf-stage-65-reference> a schema:PropertyValue ;
        dct:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241:863-878 Fig. 1A open-loop null model (Lean 4 open_loop_divergence_and_mmp_arrest)" ;
        schema:value "0.3439" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-picasso-scrambled-tadpole-closed-loop-procrustes-rms-error-at-nf-stage-65> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Picasso scrambled tadpole closed-loop Procrustes RMS error at NF stage 65 = 0.0009 Procrustes RMS distance" ;
        dct:description "Picasso initial error 0.4264 -> final 0.0009 (4-regime closed-loop RMSE = 0.0007, std = 0.0002) vs open-loop null control = 0.3439" ;
        schema:measurementTechnique "RK4 integration of coupled 5-landmark Procrustes attractor ODE across NF stages 45->65 (eta_MMP=1.0)" ;
        schema:name "Picasso scrambled tadpole closed-loop Procrustes RMS error at NF stage 65" ;
        schema:unitText "Procrustes RMS distance" ;
        schema:value "0.0009" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-picasso-scrambled-tadpole-closed-loop-procrustes-rms-error-at-nf-stage-65-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-picasso-scrambled-tadpole-closed-loop-procrustes-rms-error-at-nf-stage-65-reference> a schema:PropertyValue ;
        dct:source "Vandenberg, Adams & Levin (2012) Dev. Dyn. 241:863-878 Figs. 2-5 (Picasso craniofacial normalization to froglet target X^*)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-xenopus-laevis-specimen-dorsal-head-contour-width-correlation-r-and-bilateral-eye-ap-symmetry> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Xenopus laevis specimen dorsal head-contour width correlation r and bilateral eye AP symmetry = 0.9114 Pearson r" ;
        dct:description "head width Pearson r = 0.9114, RMSE = 0.2575; detected N=2 bilateral eyes at s/L=0.1122 (AP asymmetry |Delta s| = 0.0023, inter-eye span = 0.1031)" ;
        schema:measurementTechnique "Automated PCA craniofacial segmentation of bilateral dorsolateral eyes (N=2) and 40-bin dorsal head width profile W(s) on xenopus_craniofacial_specimen.jpg" ;
        schema:name "Xenopus laevis specimen dorsal head-contour width correlation r and bilateral eye AP symmetry" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9114" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-xenopus-laevis-specimen-dorsal-head-contour-width-correlation-r-and-bilateral-eye-ap-symmetry-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-measurement-xenopus-laevis-specimen-dorsal-head-contour-width-correlation-r-and-bilateral-eye-ap-symmetry-reference> a schema:PropertyValue ;
        dct:source "Vendored Xenopus laevis dorsal froglet specimen (Wikimedia Commons CC BY 4.0, ZooKeys 1022:51422 Fig. 4)" ;
        schema:value "0.95" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bischof-xenopus-craniofacial-remap-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2019-bischof-xenopus-craniofacial-remap.py L572–L662" ;
        dct:description "6 quantitative MorphoEval measurements with references, std, RMSE, Pearson r, and null/ablation deltas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-bischof-xenopus-craniofacial-remap.py#L572-L662> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


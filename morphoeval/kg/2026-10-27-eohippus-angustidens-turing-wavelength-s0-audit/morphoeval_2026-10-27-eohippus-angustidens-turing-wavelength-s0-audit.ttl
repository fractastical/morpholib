<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Eohippus angustidens Schnakenberg wavelength at 78 µm (Wasatchian, 52.0 Ma) — Morphological realism / specimen match: 78/100" ;

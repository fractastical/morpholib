<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Eohippus angustidens Schnakenberg wavelength at 78 µm (Wasatchian, 52.0 Ma) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The steady state, Jacobian, sigma(k), critical ratio, and Murray k_c formula are implemented and self-tested (Pearson r 0.997 on the binned growth rates). Seven Lean theorems encode the integer shadow, including the equal-diffusion failure and the ratio-8.22 band inequality. Deduction: D is fit to the assigned 78 µm scale rather than copied from a measured diffusivity, and pass 1 still carried an unused probe stub." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .


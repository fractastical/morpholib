<https://w3id.org/delphi/resource/math-law/delphi10000-eohippus-angustidens-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavenumber versus the organ-scale sibling and the Bridgerian successor" ;
    dct:description "States what is conserved (cellular lambda_c) and what is not (organ stripe count, body size) at 52 Ma | Variables: organ sibling lambda = 0.003298 m; successor anchor = Orohippus at 48 Ma; this chronoseries is stage 1 of 1" ;
    dct:source "MacFadden 1986 DOI:10.1017/s0094837300003109; Froehlich 2002 DOI:10.1046/j.1096-3642.2002.00005.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b6fee985871268f23e54cff46ae5985cc017a4e8/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py#L1-L20>,
        <https://github.com/fractastical/morpholib/blob/b6fee985871268f23e54cff46ae5985cc017a4e8/morphoeval/lean/loops/Loop_3219_eohippus_angustidens_turing_wavelength_s0.lean#L42-L49> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "42 < 0.003298 / 7.752e-05 < 43, and 52.0 Ma precedes the 48 Ma Orohippus anchor" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/s0094837300003109>,
        <https://doi.org/10.1046/j.1096-3642.2002.00005.x>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3219.detail_wavenumber_exceeds_organ_scale" ;
    pk:leanTheorem "MathOfBiology.Loop_3219.wasatchian_precedes_bridgerian_successor" ;
    pk:leanVerified true .


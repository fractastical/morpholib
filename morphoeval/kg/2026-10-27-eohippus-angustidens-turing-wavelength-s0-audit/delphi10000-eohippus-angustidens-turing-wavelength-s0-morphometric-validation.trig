        schema:name "specimen_simulation_aligned_ks" ;
        schema:unitText "1" ;
        schema:value "0.16375000000000006" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-simulation-aligned-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-simulation-aligned-ks-reference> a schema:PropertyValue ;

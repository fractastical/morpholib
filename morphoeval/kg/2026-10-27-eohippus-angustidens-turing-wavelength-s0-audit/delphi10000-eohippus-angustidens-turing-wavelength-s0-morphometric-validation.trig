sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Eohippus angustidens Schnakenberg wavelength at 78 µm (Wasatchian, 52.0 Ma) — Morphometric validation: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.997 (reference 1), RMSE = 0.020 (reference 0), specimen dominant wavelength 86.5 µm versus model 77.5 µm, specimen coherency 0.83 versus an isotropic reference 0.5, contour circularity 0.075 versus 1. Pass 1 had not yet added the shared-lattice Pearson/KS." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-cells-per-critical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-detail-to-organ-wavenumber-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-dispersion-sigma-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-dispersion-sigma-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-formula-lambda-shift-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-ks-radial-spectrum>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-seed-to-seed-wavelength-difference-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-dominant-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-simulation-aligned-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-simulation-aligned-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-cells-per-critical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cells_per_critical_wavelength = 6.46 cells" ;
        schema:measurementTechnique "λ_c / 12 µm keratinocyte diameter" ;
        schema:name "cells_per_critical_wavelength" ;
        schema:unitText "cells" ;
        schema:value "6.46" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-cells-per-critical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-cells-per-critical-wavelength-reference> a schema:PropertyValue ;
        dct:source "Kondo & Miura 2010 order-of-magnitude 'several cell diameters', taken as 6" ;
        schema:value "6.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-detail-to-organ-wavenumber-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "detail_to_organ_wavenumber_ratio = 42.54385964912281 1" ;
        schema:measurementTechnique "organ-tier sibling wavelength 0.003298 m divided by this slot's 7.752e-05 m" ;
        schema:name "detail_to_organ_wavenumber_ratio" ;
        schema:unitText "1" ;
        schema:value "42.54385964912281" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-detail-to-organ-wavenumber-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-detail-to-organ-wavenumber-ratio-reference> a schema:PropertyValue ;
        dct:source "ratio 1 would mean the detail scale copied the organ scale" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-dispersion-sigma-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_sigma_pearson_r = 0.9971233615039029 1" ;
        dct:description "value is the measured correlation, not the ideal reference 1" ;
        schema:measurementTechnique "Pearson r of binned numerical vs analytical Turing growth rate σ(k); RMSE reported separately" ;
        schema:name "dispersion_sigma_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9971233615039029" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-dispersion-sigma-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-dispersion-sigma-pearson-r-reference> a schema:PropertyValue ;
        dct:source "identity match to the closed-form eigenvalue" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-dispersion-sigma-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_sigma_rmse = 0.02036612180734322 1/time" ;
        schema:measurementTechnique "RMSE between numerical and analytical σ(k) on the same radial bins" ;
        schema:name "dispersion_sigma_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.02036612180734322" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-dispersion-sigma-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-dispersion-sigma-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual of a perfect match" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_ablation_std_ratio = 0.000508735637310571 1" ;
        schema:measurementTechnique "final activator std at D_v=D_u divided by the patterned std (negative control)" ;
        schema:name "equal_diffusion_ablation_std_ratio" ;
        schema:unitText "1" ;
        schema:value "0.000508735637310571" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio-reference> a schema:PropertyValue ;
        dct:source "a null ablation would leave the ratio at 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-formula-lambda-shift-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "formula_lambda_shift_um = 7.590717748996752 µm" ;
        schema:measurementTechnique "Murray k_c wavelength at D_v/D_u = 5 minus the wavelength at D_v/D_u = 18, D_u fixed" ;
        schema:name "formula_lambda_shift_um" ;
        schema:unitText "µm" ;
        schema:value "7.590717748996752" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-formula-lambda-shift-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-formula-lambda-shift-um-reference> a schema:PropertyValue ;
        dct:source "a diffusion ratio that did not control k_c would shift λ by 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-ks-radial-spectrum> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_radial_spectrum = 0.75 1" ;
        schema:measurementTechnique "two-sample KS statistic between specimen and simulation radial power spectra" ;
        schema:name "ks_radial_spectrum" ;
        schema:unitText "1" ;
        schema:value "0.75" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-ks-radial-spectrum-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-ks-radial-spectrum-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean identical spectra" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-seed-to-seed-wavelength-difference-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "seed_to_seed_wavelength_difference_um = 0.3487948156439131 µm" ;
        schema:measurementTechnique "absolute difference of power-weighted spectral centroids at seeds 3219 and 3230" ;
        schema:name "seed_to_seed_wavelength_difference_um" ;
        schema:unitText "µm" ;
        schema:value "0.3487948156439131" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-seed-to-seed-wavelength-difference-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-seed-to-seed-wavelength-difference-um-reference> a schema:PropertyValue ;
        dct:source "identical seeds would differ by 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.07487262531902233 1" ;
        schema:measurementTechnique "4π area/perimeter² of the specimen foreground mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.07487262531902233" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "a circle would score 1; the plate does not" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-dominant-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_dominant_wavelength_um = 86.48648648648648 µm" ;
        dct:description "specimen plate wavelength is not forced equal to the assigned cellular scale" ;
        schema:measurementTechnique "radial FFT of the specimen interior, calibrated by the 111 px = 100 µm scale bar" ;
        schema:name "specimen_dominant_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "86.48648648648648" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-dominant-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-measurement-specimen-dominant-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "model λ_c = 77.52 µm (7.752e-05 m)" ;

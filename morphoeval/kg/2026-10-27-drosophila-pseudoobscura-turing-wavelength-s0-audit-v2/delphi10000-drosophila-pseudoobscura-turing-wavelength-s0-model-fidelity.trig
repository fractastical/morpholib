sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila pseudoobscura Turing wavelength at 2.0 µm (detail rung, 0 Ma) — Model fidelity to source: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "growth_rate and classic_kc2 are the Turing dispersion and the k_c minimizer. The fastest mode is 1.961 µm; classic k_c gives 1.946 µm, the near-onset shift. simulate_field now integrates ∂t u = σ(k) u - γ u³ for 320 steps. Activator rms goes 0.029 → 0.258 → 0.258, so the amplitude plateaus. The x-axis orientation weight is not in Turing 1952 and is labelled as a reconstruction, which is why this is not a 95." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0.py L90–L103" ;
        dct:description "σ(k) and k_c²" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0.py#L90-L103> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0.py L225–L283" ;
        dct:description "cubic split-step and plateau test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0.py#L225-L283> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3200_drosophila_pseudoobscura_turing_wavelength_s0.lean L26–L49" ;
        dct:description "five theorems, no sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3200_drosophila_pseudoobscura_turing_wavelength_s0.lean#L26-L49> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


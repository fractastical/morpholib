    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila pseudoobscura Turing wavelength at 2.0 µm (detail rung, 0 Ma) — Morphological realism / specimen match: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;

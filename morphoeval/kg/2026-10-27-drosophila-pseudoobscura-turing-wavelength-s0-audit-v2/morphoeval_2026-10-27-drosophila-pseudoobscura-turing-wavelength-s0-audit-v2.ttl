<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous stability of the reaction Jacobian" ;
    dct:description "Reaction-only stability is required before a diffusion-driven band can be called a Turing instability | Variables: f_u=0.84, f_v=-0.90, g_u=1.55, g_v=-1.20 s^-1 at the 1.961 um detail rung" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3200_drosophila_pseudoobscura_turing_wavelength_s0.lean#L26-L27> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1101/gr.3059305>,
        <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3200.traceJ" ;
    pk:leanTheorem "MathOfBiology.Loop_3200.homogeneous_steady_state_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail rung finer than chronospecies neighbours" ;
    dct:description "What changes at this chronoseries node is the spatial rung, not geological age | Variables: wavelengths in nanometres 1961, 102000, 197200" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3200_drosophila_pseudoobscura_turing_wavelength_s0.lean#L31-L33> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_pseudoobscura_detail = 1.961 um < lambda_santomea = 102 um < lambda_planitibia = 197.2 um, all at 0 Ma" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1101/gr.3059305>,
        <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3200.detail_rung_finer_than_chronospecies" ;
    pk:leanTheorem "MathOfBiology.Loop_3200.detail_rung_finer_than_chronospecies" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber and mode count" ;
    dct:description "Turing wavenumber k_c selects the 2.0 um detail wavelength | Variables: D_u=0.028046 um^2/s, D_v=0.131825 um^2/s, lambda=1.961 um" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3200_drosophila_pseudoobscura_turing_wavelength_s0.lean#L36-L38> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); N = L / lambda with 12 lambda < 24 um < 13 lambda" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1101/gr.3059305>,
        <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3200.mode_count_bracket_on_24um_patch" ;
    pk:leanTheorem "MathOfBiology.Loop_3200.mode_count_bracket_on_24um_patch" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor diffuses faster, and equal diffusion is not Turing-unstable" ;
    dct:description "Negative control for the wavelength-selection law | Variables: fixed-point diffusivities 28046 and 131825 (x 10^6 um^2/s)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3200_drosophila_pseudoobscura_turing_wavelength_s0.lean#L41-L49> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v / D_u > 4.70; if D_u = D_v then D_v f_u + D_u g_v = D trace(J) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1101/gr.3059305>,
        <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3200.inhibitor_diffuses_faster" ;
    pk:leanTheorem "MathOfBiology.Loop_3200.equal_diffusion_numerator_negative" ;
    pk:leanVerified true .


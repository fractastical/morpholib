    <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor, Quiescent Center exponential accumulation, and PLETHORA meristem zonality — Morphometric validation: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exposes only 2 scalar values in `measure_morphoeval()` without reference comparisons, Pearson r/p-values, counter-current flux conservation error, shoot-decapitation retention, PLT meristem zone boundaries, or specimen confocal morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2014-grieneisen-root-auxin-reflux-fountain.py L69–L75: Only 2 scalar metrics without statistical validation or specimen morphometrics <https://github.com/fractastical/morpholib/blob/8871db0/2014-grieneisen-root-auxin-reflux-fountain.py#L69-L75>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-no-lat-qc-amplification-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-qc-amplification-ratio> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

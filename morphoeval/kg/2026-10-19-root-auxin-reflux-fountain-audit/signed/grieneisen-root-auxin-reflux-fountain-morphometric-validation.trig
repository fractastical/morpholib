        schema:name "no_lat_qc_amplification_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-qc-amplification-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wt_qc_amplification_ratio = 7.5784 ratio" ;
        schema:measurementTechnique "Pass 1 1D two-stream stele-epidermis reflux peak-to-shoot ratio" ;
        schema:name "wt_qc_amplification_ratio" ;
        schema:unitText "ratio" ;
        schema:value "7.5784" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-no-lat-qc-amplification-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;

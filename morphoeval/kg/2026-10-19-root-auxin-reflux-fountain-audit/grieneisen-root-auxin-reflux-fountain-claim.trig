sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> a pk:Claim ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor, Quiescent Center exponential accumulation, and PLETHORA meristem zonality faithfully reproduces Arabidopsis thaliana (primary root apex: vascular stele, pericycle/endodermis, cortex, epidermis/lateral root cap, quiescent center, and columella) morphology" ;
        dct:description "The simulation script(s) 2014-grieneisen-root-auxin-reflux-fountain.py implement the cited source model as published and produce forms that match real Arabidopsis thaliana (primary root apex: vascular stele, pericycle/endodermis, cortex, epidermis/lateral root cap, quiescent center, and columella) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.5/100, audit 2026-10-19-root-auxin-reflux-fountain-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2014-grieneisen-root-auxin-reflux-fountain.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2014-grieneisen-root-auxin-reflux-fountain.py; output: docs/media/root_auxin_reflux_fountain_comparison.png; organism: Arabidopsis thaliana (primary root apex: vascular stele, pericycle/endodermis, cortex, epidermis/lateral root cap, quiescent center, and columella); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 5f9ff984dd3572c3a2bb1124d68b38a94c8ae92664796e5dd367404918a3bd5f; artifact_sha256: 24bbb9e18ef0ef8c6bbaee2c3ac9df8b234cd9ebaa3ce433911f3e570ca5bead; input_dataset_sha256: {datasets/root_auxin_reflux_fountain/arabidopsis_root_meristem_specimen.jpg=1b962c21e75c8e72..., datasets/root_auxin_reflux_fountain/paper_citations.bib=069ef06b9ad6bdfb..., datasets/root_auxin_reflux_fountain/root_auxin_reflux_fountain_reference.json=1fc68ce109094fc5..., datasets/root_auxin_reflux_fountain/scout_manifest.json=285fff11a61df708...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/S0092-8674(00)81535-4>,
            <https://doi.org/10.1038/nature03184>,
            <https://doi.org/10.1038/nature06215>,
            <https://doi.org/10.1038/nature13663> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-specimen-match> ;
        pk:weightOfEvidence "0.535"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2014-grieneisen-root-auxin-reflux-fountain.py> a schema:SoftwareSourceCode ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;

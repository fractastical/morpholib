        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor, Quiescent Center exponential accumulation, and PLETHORA meristem zonality — Parameter expressivity: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates only WT (k_lat=0.18) and k_lat=0 without sweeping the 6 canonical experimental perturbations (WT, shoot decapitation, pin2/eir1, lateral-PIN ablation, NPA blockade, QC laser ablation) or exposing CLI flags." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2014-grieneisen-root-auxin-reflux-fountain.py L69–L75: Only two k_lat values evaluated without 6-regime sweep or CLI overrides <https://github.com/fractastical/morpholib/blob/8871db0/2014-grieneisen-root-auxin-reflux-fountain.py#L69-L75>" ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 038 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;

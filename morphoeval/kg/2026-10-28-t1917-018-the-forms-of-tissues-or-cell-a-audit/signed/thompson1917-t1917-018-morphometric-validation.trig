sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Morphometric validation: 30/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`plateau_statistics` (L93-105) computes the right dispersion statistics (SD, RMS deviation, median |theta-120|, fraction within +/-15 deg) and `measure_morphoeval` (L312-345) reports seven quantities, but every one of them is measured on the synthetic froth or the Lami formula; nothing is measured on a specimen, so there is no r, RMSE, KS test or confidence interval against real data and no comparison with the stated a-priori tolerance on a real tissue." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L312–L345: All seven measurements are model-side; no specimen morphometrics, no goodness-of-fit statistics <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L312-L345>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-lami-equal-tension-junction-angle>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-lami-negligible-partition-angle>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-poisson-voronoi-seed-junction-angle-sd-negative-control>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-relaxed-froth-fraction-of-angles-within-15-deg-of-120>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-relaxed-froth-junction-angle-sd>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-relaxed-froth-three-fold-vertex-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-steiner-cross-length-ratio-unit-square>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-morphometric-validation-1> ;
        pk:hasScore "0.3"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-lami-equal-tension-junction-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Lami equal-tension junction angle = 120.0 deg" ;
        schema:measurementTechnique "cos(alpha) = (T^2 - T^2 - T^2)/(2 T T) with T1 = T2 = T3 (E1)" ;
        schema:name "Lami equal-tension junction angle" ;
        schema:unitText "deg" ;
        schema:value "120.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-lami-equal-tension-junction-angle-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-lami-equal-tension-junction-angle-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 297 / p. 303 case (3)" ;
        schema:value "120.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-lami-negligible-partition-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Lami negligible-partition angle = 90.0 deg" ;
        schema:measurementTechnique "E1 with t -> 0 (Fig. 113 case 1)" ;
        schema:name "Lami negligible-partition angle" ;
        schema:unitText "deg" ;
        schema:value "90.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-lami-negligible-partition-angle-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-lami-negligible-partition-angle-reference> a schema:PropertyValue ;
        dcterms:source "Thompson 1917 p. 303 case (1)" ;
        schema:value "90.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-poisson-voronoi-seed-junction-angle-sd-negative-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Poisson-Voronoi seed junction-angle SD (negative control) = 29.4814 deg" ;
        schema:measurementTechnique "pooled SD of tri-junction angles of the unrelaxed Voronoi seed" ;
        schema:name "Poisson-Voronoi seed junction-angle SD (negative control)" ;
        schema:unitText "deg" ;
        schema:value "29.4814" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-relaxed-froth-fraction-of-angles-within-15-deg-of-120> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "relaxed froth fraction of angles within +/-15 deg of 120 = 0.6806 fraction" ;
        schema:measurementTechnique "|theta - 120| <= 15 over all junction angles" ;
        schema:name "relaxed froth fraction of angles within +/-15 deg of 120" ;
        schema:unitText "fraction" ;
        schema:value "0.6806" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-relaxed-froth-junction-angle-sd> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "relaxed froth junction-angle SD = 18.9948 deg" ;
        schema:measurementTechnique "pooled SD of all tri-junction angles after 400 gradient steps of E5 (seed 1917)" ;
        schema:name "relaxed froth junction-angle SD" ;
        schema:unitText "deg" ;
        schema:value "18.9948" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-relaxed-froth-three-fold-vertex-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "relaxed froth three-fold vertex fraction = 1.0 fraction" ;
        schema:measurementTechnique "vertices with exactly three incident edges / all vertices" ;
        schema:name "relaxed froth three-fold vertex fraction" ;
        schema:unitText "fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-relaxed-froth-three-fold-vertex-fraction-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-relaxed-froth-three-fold-vertex-fraction-reference> a schema:PropertyValue ;
        dcterms:source "Plateau's second law" ;
        schema:value "1.0" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-steiner-cross-length-ratio-unit-square> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Steiner / cross length ratio (unit square) = 0.9659 dimensionless" ;
        schema:measurementTechnique "(1 + sqrt 3) / (2 sqrt 2) (E2)" ;
        schema:name "Steiner / cross length ratio (unit square)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9659" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-steiner-cross-length-ratio-unit-square-reference> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-measurement-steiner-cross-length-ratio-unit-square-reference> a schema:PropertyValue ;
        dcterms:source "Plateau/Lamarle; Taylor 1976" ;
        schema:value "0.9659" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L93–L105" ;
        dcterms:description "Correct dispersion statistics about 120 deg (E3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L93-L105> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor cloud agent, primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


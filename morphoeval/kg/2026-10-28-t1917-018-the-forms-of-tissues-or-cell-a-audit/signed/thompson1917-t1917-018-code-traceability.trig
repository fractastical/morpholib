sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-code-traceability> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Code-to-model traceability: 62/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Functions map one-to-one onto the equation labels E1/E2/E3/E5 used in the reference package and the six Lean theorems of `Thompson1917_T1917_018.lean` (Fig. 113 cases, Lami iff equal tensions, angle-sum identity, Euler bookkeeping, hexagon closure, Steiner inequality) are machine-checked with 0 sorry; `math_kg_loops/thompson1917-t1917-018.yaml` links each law to code loci. Some of those loci name functions that only exist in the planned v2 (`tensions_from_angles`, `polygon_class_distribution`, `square_lattice_control`)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "morphoeval/math_kg_loops/thompson1917-t1917-018.yaml L37–L150: Law registry cites code loci not yet present in v1 <https://github.com/fractastical/morpholib/blob/88f1e6cf4/morphoeval/math_kg_loops/thompson1917-t1917-018.yaml#L37-L150>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-code-traceability-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_018.lean L39–L207" ;
        dcterms:description "Six machine-checked theorems plus two lemmas, namespace MathOfBiology.Loop_213" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/88f1e6cf4/morphoeval/lean/loops/Thompson1917_T1917_018.lean#L39-L207> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor cloud agent, primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-specimen-match> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor cloud agent, primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Morphological realism / specimen match: 18/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Four specimens are vendored and SHA-256-pinned in `datasets/thompson_1917/t1917-018/` (corneal endothelium, onion epidermis, Thompson Figs. 103 and 124) but v1 never opens any of them: `render_outputs` (L243-309) draws a Lami curve, a synthetic froth and a synthetic histogram only. There is no side-by-side with a real epithelium or with Thompson's own figures." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "docs/media/t1917_018_the_forms_of_tissues_or_cell_a_comparison.png (generated output, not in repo): Figure contains no specimen image or overlay — docs/media/t1917_018_the_forms_of_tissues_or_cell_a_comparison.png: rendered output of thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py at 88f1e6cf4, image/png, 180777 B, 1650×528 px, artifact_sha256 694426affc0cfe18c129d7d5186fc49be89908622078bab6eca93eb65d214765 (sha256 694426affc0cfe18c129d7d5186fc49be89908622078bab6eca93eb65d214765), spec_fingerprint 19f6f11c004310d9d3822d28b8f9f71011ff87e8a31986733b91a36effb75d46",
            "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L243–L309: render_outputs produces three synthetic panels; DATA_DIR is defined (L47) but never read <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L243-L309>" ;
        pk:hasScore "0.18"^^xsd:double ;
        pk:hasVerdict "not faithful" .
}


        dcterms:title "Toward a quantitative analysis of corneal endothelial cell morphology: a review of techniques and their application" .

    <https://doi.org/10.1016/j.cub.2007.11.049> dcterms:date "2007"^^xsd:gYear ;
        dcterms:title "The influence of cell mechanics, cell-cell interactions, and proliferation on epithelial packing" .

    <https://doi.org/10.1038/nature02952> dcterms:date "2004"^^xsd:gYear ;
        dcterms:title "Surface mechanics mediate pattern formation in the developing retina" .

    <https://doi.org/10.2307/1970949> dcterms:date "1976"^^xsd:gYear ;
        dcterms:title "The structure of singularities in soap-bubble-like and soap-film-like minimal surfaces" .


sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Model fidelity to source: 55/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`lami_angles_from_tensions` (L61-75) implements the triangle-of-forces law exactly as Thompson states it (pp. 296-297) and `thompson_fig113_cases` (L78-84) reproduces cases (1)-(3) (90 / 100 / 120 deg); `steiner_vs_cross_lengths` (L87-89) encodes Lamarle's four-fold instability. However the simulated froth (L182-220) uses Farhadifar's Gamma_bar = 0.04 perimeter term so edge tensions are unequal (not the equal-tension soap froth Thompson invokes), runs a fixed 400 steps with no convergence check and no T1 transitions, and the single-regime result (SD 19 deg) therefore mis-represents the Plateau limit it is meant to embody." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L182–L220: Froth energy with Gamma_bar > 0 and fixed-step descent; no equal-tension soap-froth limit, no convergence criterion, no T1 <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L182-L220>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-model-fidelity-1> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L61–L89" ;
        dcterms:description "Lami balance, Fig. 113 cases and Steiner inequality implemented as published" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L61-L89> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor cloud agent, primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


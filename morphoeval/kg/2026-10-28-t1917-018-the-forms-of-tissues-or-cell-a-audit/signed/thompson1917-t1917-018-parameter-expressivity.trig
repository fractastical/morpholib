sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-parameter-expressivity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L258–L271" ;
        dcterms:description "Continuous t/T sweep of the Lami angles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L258-L271> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Parameter expressivity: 32/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "The Lami curve sweeps the partition-tension ratio t/T continuously from 0 to 2 (L258-271), which is genuine expressivity for E1. The froth model, however, is run at a single (Lambda_bar, Gamma_bar) = (0.12, 0.04) point; the tension-anisotropy parameter eps of E5 (the regime that distinguishes Thompson's Fig. 103 from Fig. 124) is not implemented at all, and the CLI exposes only `--self-test` (L374-377)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L374–L377: CLI accepts only --self-test; no eps / Lambda / Gamma / seed flags; no anisotropy regime <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L374-L377>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-parameter-expressivity-1> ;
        pk:hasScore "0.32"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-018> a pk:Claim ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics faithfully reproduces species-agnostic claim; specimens vendored: Homo sapiens corneal endothelium, Allium cepa epidermis, Thompson Fig. 103 (Zea mays parenchyma), Fig. 124 (Girardia epidermis) morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py implement the cited source model as published and produce forms that match real species-agnostic claim; specimens vendored: Homo sapiens corneal endothelium, Allium cepa epidermis, Thompson Fig. 103 (Zea mays parenchyma), Fig. 124 (Girardia epidermis) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py; output: docs/media/t1917_018_the_forms_of_tissues_or_cell_a_comparison.png; organism: species-agnostic claim; specimens vendored: Homo sapiens corneal endothelium, Allium cepa epidermis, Thompson Fig. 103 (Zea mays parenchyma), Fig. 124 (Girardia epidermis); environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0, scikit-image 0.26.0; claim_boundary: [reported_in_source: Thompson (1917) p. 297: three similar liquid surfaces always meet at 120 degrees; p. 303 Fig. 113 cases (1)-(3): 90 / >90 / 120 degrees as the partition tension t rises to T; p. 309-310: Lamarle's least-area partition meets in threes at 120 degrees, and 'in any ordinary section of a vegetable parenchyma ... cell-walls everywhere meeting, by threes, at angles of 120 degrees, irrespective of the size of the individual cells'. | Thompson (1917) pp. 314, 321-322: epidermal outer walls and growth/traction anisotropy (Fig. 124 Girardia) are stated exceptions where the angles depart from 120 degrees.; reconstructed_in_script: Lami/Neumann triangle of forces (E1) with Fig. 113 cases, Steiner-vs-cross film lengths (E2), angle-sum identity statistics (E3), and a periodic Poisson-Voronoi vertex network relaxed by gradient descent on a Farhadifar-type energy (E5) at one parameter point.; transfer_boundary: 2D plane section / en-face projection of a 3D cell aggregate; Thompson's 109 deg 28' tetrahedral edge law is not simulated.; does_not_claim: v1 makes no claim about any real epithelium: no specimen is loaded or segmented, so no verdict on T1917-018 can be drawn from v1.]; other sources: On Growth and Form (Ch. VII, The Forms of Tissues, or Cell-Aggregates, pp. 293-345, Figs. 100-135) <https://archive.org/details/ongrowthform1917thom>, Statique experimentale et theorique des liquides soumis aux seules forces moleculaires <https://archive.org/details/statiqueexprim01plat>; phenomenon_size: 979 µm (0.0009792 m, log10=-3.009 m, tier=5_primordium_100um); species_scale_ladder (20 runs from 979 µm to 2.85 m): 979 µm:cortical-sulcal-axon-tension, 1.4 mm:bressloff-cowan-V1-hallucination, 1.5 mm:corticothalamic-seizure-spirals, 1.7 mm:homo-sapiens-bioelectric-polarity, 3.1 mm:vertex-glass-jamming, 3.4 mm:homo-sapiens-vertex-packing, 6.3 cm:homo-sapiens-turing-wavelength, 11.7 cm:homo-sapiens-clock-wavefront" ;
        pk:derivedFromPaper <https://doi.org/10.1002/j.1538-9235.1989.tb02334.x>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1038/nature02952>,
            <https://doi.org/10.2307/1970949> .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


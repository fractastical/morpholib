<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-018-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thompson Fig. 113 tension cases: 90 / >90 / 120 degrees" ;
    dct:description "Formalises the three worked cases of Thompson (1917) p. 303 that the script's `lami_angles_from_tensions` reproduces numerically (regime table rows 1-3) | Variables: alpha, beta, gamma: interior angles at a planar tri-junction (degrees); T, T': outer film tensions; t: partition tension" ;
    dct:source "Thompson (1917) On Growth and Form pp. 296-297, 303 Fig. 113" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/88f1e6cf4/morphoeval/lean/loops/Thompson1917_T1917_018.lean#L39-L64>,
        <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L140-L172> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def closes_full_turn (alpha beta gamma : Int) : Prop :=
  alpha + beta + gamma = 360
theorem thompson_fig113_three_cases (alpha beta gamma : Int)
    (h : closes_full_turn alpha beta gamma) :
    (alpha = beta → gamma = 180 → alpha = 90 ∧ beta = 90) ∧
    (alpha = beta → beta = gamma → alpha = 120 ∧ beta = 120 ∧ gamma = 120) ∧
    (alpha = beta → (gamma < 120 ↔ 120 < alpha)) ∧
    (closes_full_turn 100 100 160)
"""^^pk:lean4 ;
    skos:notation "alpha + beta + gamma = 360;  (T = T', t -> 0) => alpha = beta = 90;  (T = T' = t) => alpha = beta = gamma = 120;  (T = T') => gamma < 120 <=> alpha > 120" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1538-9235.1989.tb02334.x>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/nature02952>,
        <https://doi.org/10.2307/1970949> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric — Plateau / Lamarle minimal-partition laws and Lami tension balance at tri-cellular junctions (Thompson 1917 Ch. VII)" ;
    pk:leanDeclaration "MathOfBiology.Loop_213.closes_full_turn" ;
    pk:leanTheorem "MathOfBiology.Loop_213.thompson_fig113_three_cases" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-018-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lami balance at 120 degrees iff equal tensions" ;
    dct:description "Justifies reading a measured 120-degree junction as evidence of equal cortical tension, and the script's inference of tension ratios from measured angles (inverse Lami) | Variables: T1, T2, T3: line tensions of the three films; r: the (non-zero) vertical unit standing for sqrt 3" ;
    dct:source "Thompson (1917) p. 297; Plateau (1873); Alt, Ganguly & Salbreux (2017) Phil. Trans. R. Soc. B 372:20150520" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/88f1e6cf4/morphoeval/lean/loops/Thompson1917_T1917_018.lean#L72-L108>,
        <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L140-L163> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def lami_balance_x (T1 T2 T3 : Int) : Int := 2 * T1 - T2 - T3
def lami_balance_y (r T2 T3 : Int) : Int := r * (T2 - T3)
theorem lami_balance_iff_equal_tensions (r T1 T2 T3 : Int) (hr : r ≠ 0) :
    (lami_balance_x T1 T2 T3 = 0 ∧ lami_balance_y r T2 T3 = 0) ↔ (T1 = T2 ∧ T2 = T3)
"""^^pk:lean4 ;
    skos:notation "T1 e1 + T2 e2 + T3 e3 = 0 with e_k at 0, 120, 240 deg  <=>  T1 = T2 = T3   (2 T1 - T2 - T3 = 0 and sqrt3 (T2 - T3) = 0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1538-9235.1989.tb02334.x>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/nature02952>,
        <https://doi.org/10.2307/1970949> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric — Plateau / Lamarle minimal-partition laws and Lami tension balance at tri-cellular junctions (Thompson 1917 Ch. VII)" ;
    pk:leanDeclaration "MathOfBiology.Loop_213.lami_balance_x" ;
    pk:leanTheorem "MathOfBiology.Loop_213.lami_balance_iff_equal_tensions" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-018-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Angle-sum identity: the tri-junction mean is 120 by construction; only dispersion is testable" ;
    dct:description "Fixes the statistical design of the test: pooled SD and per-vertex RMS deviation vs. the Poisson-Voronoi negative control, never the pooled mean | Variables: theta_i: measured interior angles at one vertex; D_v: per-vertex Plateau deviation" ;
    dct:source "Thompson (1917) p. 310 ('meeting, by threes, at angles of 120 degrees, irrespective of the size of the individual cells')" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/88f1e6cf4/morphoeval/lean/loops/Thompson1917_T1917_018.lean#L112-L134>,
        <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L180-L232> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def plateau_deviation (theta : Int) : Int := theta - 120
theorem tri_junction_mean_is_always_120 (alpha beta gamma : Int)
    (h : closes_full_turn alpha beta gamma) :
    plateau_deviation alpha + plateau_deviation beta + plateau_deviation gamma = 0 ∧
    (plateau_deviation alpha = 0 → plateau_deviation beta = 0 → gamma = 120) ∧
    (plateau_deviation alpha = plateau_deviation beta →
      plateau_deviation gamma = -2 * plateau_deviation alpha)
"""^^pk:lean4 ;
    skos:notation "(alpha - 120) + (beta - 120) + (gamma - 120) = 0  =>  test statistic D_v = sqrt(mean_i (theta_i - 120)^2), tolerance |theta - 120| <= 15" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1538-9235.1989.tb02334.x>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/nature02952>,
        <https://doi.org/10.2307/1970949> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric — Plateau / Lamarle minimal-partition laws and Lami tension balance at tri-cellular junctions (Thompson 1917 Ch. VII)" ;
    pk:leanDeclaration "MathOfBiology.Loop_213.plateau_deviation" ;
    pk:leanTheorem "MathOfBiology.Loop_213.tri_junction_mean_is_always_120" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-018-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Euler / three-valent froth bookkeeping and T1 charge conservation" ;
    dct:description "Underwrites the periodic Voronoi-vertex simulation (every seed tessellation is three-valent, mean 6 sides) and the f3 three-fold-fraction statistic | Variables: V, E, F: vertices, edges, cells of a periodic three-valent network" ;
    dct:source "Thompson (1917) pp. 310, 319; Gibson et al. (2006) Nature 442:1038" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/88f1e6cf4/morphoeval/lean/loops/Thompson1917_T1917_018.lean#L138-L157>,
        <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L345-L465> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def total_sides (E : Int) : Int := 2 * E
def euler_characteristic (V E F : Int) : Int := V - E + F
theorem three_valent_froth_euler_bookkeeping (V E F : Int)
    (h_euler : euler_characteristic V E F = 0) (h_trivalent : 3 * V = total_sides E) :
    total_sides E = 6 * F ∧ V = 2 * F ∧ (5 + 7 : Int) = 6 + 6
"""^^pk:lean4 ;
    skos:notation "V - E + F = 0, 3V = 2E  =>  2E = 6F (mean 6 sides), V = 2F;  (5, 7) <- (6, 6) conserves 12" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1538-9235.1989.tb02334.x>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/nature02952>,
        <https://doi.org/10.2307/1970949> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric — Plateau / Lamarle minimal-partition laws and Lami tension balance at tri-cellular junctions (Thompson 1917 Ch. VII)" ;
    pk:leanDeclaration "MathOfBiology.Loop_213.total_sides" ;
    pk:leanTheorem "MathOfBiology.Loop_213.three_valent_froth_euler_bookkeeping" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-018-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Three regular n-gons close a vertex iff n = 6 (120-degree rule = honeycomb)" ;
    dct:description "Links the junction-angle claim (T1917-018) to the hexagonal-tessellation claim (T1917-019) and to the polygon-class P(n) reported by the script | Variables: n: polygon side number" ;
    dct:source "Thompson (1917) pp. 319-321 Fig. 121 (after Bonanni)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/88f1e6cf4/morphoeval/lean/loops/Thompson1917_T1917_018.lean#L162-L182>,
        <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L780-L795> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def n_times_interior_angle (n : Int) : Int := (n - 2) * 180
theorem three_regular_polygons_close_vertex_iff_hexagon (n : Int) :
    (3 * n_times_interior_angle n = 360 * n ↔ n = 6) ∧
    n_times_interior_angle 6 = 6 * 120 ∧
    n_times_interior_angle 4 = 4 * 90
"""^^pk:lean4 ;
    skos:notation "3 (n - 2) 180 = 360 n  <=>  n = 6;  interior angle of the hexagon = 120" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1538-9235.1989.tb02334.x>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/nature02952>,
        <https://doi.org/10.2307/1970949> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric — Plateau / Lamarle minimal-partition laws and Lami tension balance at tri-cellular junctions (Thompson 1917 Ch. VII)" ;
    pk:leanDeclaration "MathOfBiology.Loop_213.n_times_interior_angle" ;
    pk:leanTheorem "MathOfBiology.Loop_213.three_regular_polygons_close_vertex_iff_hexagon" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-018-6> a skos:Concept,
        pk:Concept ;
    rdfs:label "Plateau four-fold vertex instability (Steiner two-Y beats X)" ;
    dct:description "Plateau's second law (no four-fold film vertices) that the script tests as the f3 three-fold fraction and the square-lattice ablation control | Variables: k: square side (scale); q = k sqrt 2: diagonal; r = k sqrt 3; X partition (four films from the centre) vs two-Y Steiner tree" ;
    dct:source "Thompson (1917) pp. 309-310; Lamarle (1864); Taylor (1976) Ann. Math. 103:489-539" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/88f1e6cf4/morphoeval/lean/loops/Thompson1917_T1917_018.lean#L187-L229>,
        <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L174-L177> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def sqrt3_1e4_upper : Int := 17321
def sqrt2_1e4_lower : Int := 14142
def x_partition_length (q : Int) : Int := 2 * q
def steiner_partition_length (k r : Int) : Int := k + r
theorem steiner_two_y_beats_x_partition (k : Int) (hk : 0 < k) :
    steiner_partition_length (10000 * k) (sqrt3_1e4_upper * k) <
      x_partition_length (sqrt2_1e4_lower * k) ∧
    sqrt3_1e4_upper * sqrt3_1e4_upper ≥ 3 * 100000000 ∧
    sqrt2_1e4_lower * sqrt2_1e4_lower ≤ 2 * 100000000
theorem square_of_sum_expansion (k r : Int) :
    (k + r) * (k + r) = k * k + 2 * (k * r) + r * r
"""^^pk:lean4 ;
    skos:notation "(1 + sqrt 3) k = 2.7320 k < 2 sqrt 2 k = 2.8284 k for a square of side k; certified at 1e-4: 17321^2 >= 3e8, 14142^2 <= 2e8, (10000 + 17321) k < 2 * 14142 k for every k > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/j.1538-9235.1989.tb02334.x>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/nature02952>,
        <https://doi.org/10.2307/1970949> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "geometric — Plateau / Lamarle minimal-partition laws and Lami tension balance at tri-cellular junctions (Thompson 1917 Ch. VII)" ;
    pk:leanDeclaration "MathOfBiology.Loop_213.steiner_partition_length" ;
    pk:leanTheorem "MathOfBiology.Loop_213.steiner_two_y_beats_x_partition" ;
    pk:leanVerified true .


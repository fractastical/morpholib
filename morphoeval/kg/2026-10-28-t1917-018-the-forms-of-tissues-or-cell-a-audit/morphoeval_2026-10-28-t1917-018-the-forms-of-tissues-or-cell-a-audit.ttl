    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-018-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-018-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-018-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-018-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-018-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-018-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-018-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-018-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-018-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-018-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-018-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-018-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-018-the-forms-of-tissues-or-cell-a-audit-thompson1917-t1917-018-7> ;
    pk:hypothesisType "geometric — Plateau / Lamarle minimal-partition laws and Lami tension balance at tri-cellular junctions (Thompson 1917 Ch. VII)" ;

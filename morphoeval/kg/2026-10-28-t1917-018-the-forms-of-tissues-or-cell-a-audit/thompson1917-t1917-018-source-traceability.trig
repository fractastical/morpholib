    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-018-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-018 — Plateau tri-junction (120 degree) claim: Lami balance, periodic froth relaxation, junction-angle statistics — Source and data traceability: 58/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The module docstring (L1-35) cites Thompson's chapter, pages, figures, the IA identifier and page-to-leaf rule, and Farhadifar et al. (2007); the dataset directory carries a complete reference.json, bib file and scout manifest with every digest. But the script does not load `t1917_018_the_forms_of_tissues_or_cell_a_reference.json` or verify any SHA-256 at runtime, so the provenance lives beside the code rather than in it." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-018/t1917_018_the_forms_of_tissues_or_cell_a_reference.json L1–L20: Reference package exists with digests but is not consumed by v1 <https://github.com/fractastical/morpholib/blob/88f1e6cf4/datasets/thompson_1917/t1917-018/t1917_018_the_forms_of_tissues_or_cell_a_reference.json#L1-L20>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-source-traceability-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-018-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py L1–L35" ;
        dct:description "Docstring cites chapter/pages/figures/IA id and the equation set E1-E5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/88f1e6cf4/thompson/claims/t1917-018_the-forms-of-tissues-or-cell-aggregates.py#L1-L35> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor cloud agent, primary assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

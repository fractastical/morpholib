sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Ambulocetus natans Turing wavenumber at 224 µm (47.5 Ma, detail primordium) — Model fidelity to source: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Same Schnakenberg system and eigenvalue dispersion as pass 1 (r=0.9997). Pass 2 adds a log-parabola radial peak so the reported wavelength is not an integer FFT bin, and it re-integrates the PDE at the predecessor and successor hydrations instead of only scaling the closed form." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py L68–L88" ;
        dct:description "sigma(k) and onset k_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b5/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py#L68-L88> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py L192–L251" ;
        dct:description "Sub-bin wavelength and nonlinear integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b5/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py#L192-L251> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean L31–L53" ;
        dct:description "Chronoseries order and stripe counts" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b5/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean#L31-L53> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


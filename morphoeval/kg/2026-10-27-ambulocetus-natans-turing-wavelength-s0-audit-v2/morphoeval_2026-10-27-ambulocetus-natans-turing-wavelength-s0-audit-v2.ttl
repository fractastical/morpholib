        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9.1e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Ambulocetus natans Turing wavenumber at 224 µm (47.5 Ma, detail primordium) — Morphometric validation: 91/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion Pearson r=0.9997 and RMSE=0.0034 stand. Three seeds span 172.8–177.4 µm. Specimen coherency 0.359 versus model coherency 0.114, KS=0.066, foreground fraction 0.161 after largest-component cleanup. Emergent 177.4 µm is not overwritten to equal the 224 µm reference." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

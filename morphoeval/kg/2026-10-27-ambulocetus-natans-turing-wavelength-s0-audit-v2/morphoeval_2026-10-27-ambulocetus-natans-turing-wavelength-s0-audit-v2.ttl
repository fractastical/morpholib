<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Ambulocetus natans Turing wavenumber at 224 µm (47.5 Ma, detail primordium) (Ambulocetus natans)",
        "Ambulocetus natans Turing wavenumber at 224 µm (47.5 Ma, detail primordium) faithfully reproduces Ambulocetus natans morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py, morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Ambulocetus natans specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean> ;
    schema:about "Ambulocetus natans" ;
    schema:additionalProperty "does_not_claim: That the emergent ~177 µm peak equals the analytic 224 µm target.",
        "does_not_claim: That the skeleton preserves 224 µm pigment stripes.",
        "reconstructed_in_script: Largest-component Otsu mask on the Naturalis photograph.",
        "reconstructed_in_script: Multi-seed nonlinear runs and hydration re-runs at h=0.72, 1.0 and 1.35.",
        "reconstructed_in_script: Schnakenberg parameters a=0.05, b=0.90, Du=1, Dv=50, gamma=8, length-scaled to a 224 µm fastest analytic mode.",
        "reported_in_source: Schnakenberg 1979: activator-inhibitor kinetics.",
        "reported_in_source: Thewissen et al. 2001 and Gingerich et al. 1994 place Pakicetus and Rodhocetus on either side of that habit.",
        "reported_in_source: Thewissen, Hussain and Arif 1994: Ambulocetus natans as an amphibious archaeocete.",
        "reported_in_source: Turing 1952: diffusion-driven instability at a finite wavenumber.",
        "transfer_boundary: The flank inset is a dermal-field window on a photograph of bone.",
        "transfer_boundary: h=0.72 and h=1.35 remain a diffusivity transfer, not a measurement from the fossil papers." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Ambulocetus natans (Early Eocene (Lutetian, 47.5 Ma))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Mammalia (Zootoka)" ;
    pk:biologicalGenus "Ambulocetus" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean; output: docs/media/ambulocetus_natans_turing_wavelength_s0_growth.gif; organism: Ambulocetus natans; environment: python 3.12, numpy 2.5, scipy 1.18; claim_boundary: [reported_in_source: Turing 1952: diffusion-driven instability at a finite wavenumber. | Schnakenberg 1979: activator-inhibitor kinetics. | Thewissen, Hussain and Arif 1994: Ambulocetus natans as an amphibious archaeocete. | Thewissen et al. 2001 and Gingerich et al. 1994 place Pakicetus and Rodhocetus on either side of that habit.; reconstructed_in_script: Schnakenberg parameters a=0.05, b=0.90, Du=1, Dv=50, gamma=8, length-scaled to a 224 µm fastest analytic mode. | Multi-seed nonlinear runs and hydration re-runs at h=0.72, 1.0 and 1.35. | Largest-component Otsu mask on the Naturalis photograph.; transfer_boundary: h=0.72 and h=1.35 remain a diffusivity transfer, not a measurement from the fossil papers. | The flank inset is a dermal-field window on a photograph of bone.; does_not_claim: That the skeleton preserves 224 µm pigment stripes. | That the emergent ~177 µm peak equals the analytic 224 µm target.]; phenomenon_size: 208 µm (0.0002083 m, log10=-3.681 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 208 µm to 46.9 cm): 208 µm:ambulocetus-natans-bioelectric-polarity, 651 µm:ambulocetus-natans-vertex-packing, 1.0 cm:ambulocetus-natans-turing-wavelength, 2.1 cm:ambulocetus-natans-clock-wavefront, 4.7 cm:ambulocetus-natans-morphogen-condensation, 5.7 cm:ambulocetus-natans-elastic-buckling, 6.5 cm:ambulocetus-natans-flux-canalization, 9.1 cm:ambulocetus-natans-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/35095005>,
        <https://doi.org/10.1038/368844a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.263.5144.210> ;
    pk:externalAtlasDataset <https://paleobiodb.org/classic/checkTaxonInfo?taxon_name=Ambulocetus>,
        <https://www.morphosource.org/Search/index?search=Ambulocetus> ;
    pk:fossilLineageGroup "Cetacean Limb-to-Flipper Fossil Series" ;
    pk:geologicalAgeMa 4.75e+01 ;
    pk:geologicalPeriod "Early Eocene (Lutetian, 47.5 Ma)" ;

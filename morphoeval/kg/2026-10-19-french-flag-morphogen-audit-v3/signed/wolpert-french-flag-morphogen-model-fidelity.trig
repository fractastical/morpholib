sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L547–L555" ;
        dcterms:description "Zero-flux masked 5-point Laplacian used for both species" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L547-L555> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L614–L639" ;
        dcterms:description "Explicit update: FGF source with Shh boost, Shh source gated by F/(F+K_FS), progress-zone growth law, mask rebuilt as L crosses a grid line" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L614-L639> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L696–L718" ;
        dcterms:description "Rectangle + clamped AER verification against cosh(y/lambda_F)/cosh(L/lambda_F); RMSE 2.4e-3, column spread 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L696-L718> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L347–L378" ;
        dcterms:description "Morphogen-valley digit reader shared by the 1D (L381-441) and 2D readouts; replaces the v2 half split" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L347-L378> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean L137–L228" ;
        dcterms:description "7 new machine-checked theorems for the 2D stencil, feedback quiescence, truncation monotonicity, segment order and dose monotonicity (lean exit 0, 0 sorry)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_011_french_flag_morphogen.lean#L137-L228> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication, Ben-Zvi-Barkai (2010) scaling & 2D AER-FGF / ZPA-Shh limb bud paddle — Model fidelity to source: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Everything scored in v2 is intact (linear source-sink L148-152, analytic and PDE SDD L155-238 with RMSE 7.6e-6, expansion-repression scaling L268-340, Crick positional-error law L805-838). Pass 3 adds the requested 2D PD x AP coupling: zero-flux masked 5-point stencil (L547-555), Shh<->FGF feedback and AER-driven growth (L624-639) and a rectangle verification that reproduces the 1D cosh steady state to 2.4e-3 with zero cross-column spread (L696-718), backed by `sdd_2d_steady_state_balance`, `sdd_2d_reduces_to_1d_interior`, `shh_fgf_feedback_aer_ablation_quiescence` and `aer_excision_truncation_monotone` in Lean. The 1D attenuated-graft defect of v2 (4-3-2-3, an ad hoc split keyed on c_ant >= 0.8) is replaced by one valley rule (L347-378) that yields Tickle's sequence. Deductions: the 2D production rates, feedback gain and the three half-saturations are tuned so that FGF ~ 1 and L_final ~ 660 um rather than taken from any source (L472-494) (-3); the developmental clock is compressed 5x (T_s = 12 h for HH18 -> HH28, L488-489, L467-470) (-2); AER and ZPA positions are geometric inputs and new rows are born at zero concentration, so there is no proliferation field and the ZPA 'follows the tip' by construction (L501-544) (-2); digit identity is instantaneous concentration, not exposure (L728-731) (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L472–L494: LIMB2D_DEFAULTS: s_F, s_S, g_S, K_S, K_FS, K_g, v_max are tuned constants without a literature source (deduction) <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L472-L494>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-model-fidelity-5> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


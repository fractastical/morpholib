sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L733–L750" ;
        dcterms:description "Graft dose loop over 0.10 / 0.35 / 1.0 with extra-digit count and P/A FGF ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L733-L750> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L753–L774" ;
        dcterms:description "AER excision sweep over HH18..HH26, truncation fraction, segment, Spearman rho and strict monotonicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L753-L774> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L1721–L1724" ;
        dcterms:description "CLI: --limb-vmax, --limb-feedback-gain, --limb-lambda-shh, --limb-hours" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L1721-L1724> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication, Ben-Zvi-Barkai (2010) scaling & 2D AER-FGF / ZPA-Shh limb bud paddle — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "v2 sweeps retained (6 growth stages L268-340, 5 Monte Carlo thresholds L805-838, now 5 1D ZPA regimes L381-441). Pass 3 adds two monotone sweeps that visibly control the predicted feature: graft strength 0 / 0.10 / 0.35 / 1.0 adds 0 / 1 / 2 / 3 digits (Panel H) and AER excision stage HH18 -> HH26 moves the truncation from stylopod to autopod with rho = 1.0 (Panel I); `--limb-vmax`, `--limb-feedback-gain`, `--limb-lambda-shh` and `--limb-hours` expose the 2D parameters (L1721-1724) and are wired into render_outputs (L1730-1745). Deductions: the feedback gain g_S and the half-saturations are not swept or shown, so the figure does not demonstrate what the Shh -> Fgf4 loop changes beyond the single P/A ratio (-5); the AP width and ZPA geometry are not parameters (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L1240–L1261: Panel H renders the dose series; no panel sweeps g_S or the K constants (deduction) <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L1240-L1261>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

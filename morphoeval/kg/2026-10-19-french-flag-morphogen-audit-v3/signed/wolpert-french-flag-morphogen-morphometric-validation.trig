        schema:name "2D paddle wild-type distal digit count (posterior ZPA Shh, AER FGF outgrowth)" ;
        schema:unitText "digits" ;
        schema:value "3" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-paddle-wild-type-distal-digit-count-posterior-zpa-shh-aer-fgf-outgrowth-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-paddle-wild-type-distal-digit-count-posterior-zpa-shh-aer-fgf-outgrowth-reference> a schema:PropertyValue ;

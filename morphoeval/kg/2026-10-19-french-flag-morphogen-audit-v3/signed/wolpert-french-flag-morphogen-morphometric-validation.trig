        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L1511–L1530: Shh-loss and P/A measurements use reference 0 and 1.0 baselines — ordinal, not quantitative (deduction) <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L1511-L1530>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-paddle-anterior-zpa-graft-strength-1-0-mirror-duplication-digit-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-paddle-wild-type-distal-digit-count-posterior-zpa-shh-aer-fgf-outgrowth>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-stencil-code-verification-rmse-of-non-growing-rectangle-with-clamped-aer-vs-1d-cosh-steady-state>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-aer-excision-truncation-level-vs-stage-of-excision-spearman-rho>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-aer-excision-truncation-stages-whose-predicted-most-distal-pd-segment-matches-saunders-1948-summerbell-1974>,

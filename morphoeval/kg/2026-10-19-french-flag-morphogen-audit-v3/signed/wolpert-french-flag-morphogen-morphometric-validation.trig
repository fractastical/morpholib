    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-paddle-anterior-zpa-graft-strength-1-0-mirror-duplication-digit-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D paddle anterior ZPA graft (strength 1.0) mirror-duplication digit count = 6 digits" ;
        dcterms:description "2D graft sequence: 4-3-2-2-3-4; AP mirror error of distal Shh profile = 0.0e+00" ;
        schema:measurementTechnique "Same readout with a second ZPA of equal strength at the anterior margin of the 2D paddle" ;
        schema:name "2D paddle anterior ZPA graft (strength 1.0) mirror-duplication digit count" ;
        schema:unitText "digits" ;
        schema:value "6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-paddle-anterior-zpa-graft-strength-1-0-mirror-duplication-digit-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-paddle-anterior-zpa-graft-strength-1-0-mirror-duplication-digit-count-reference> a schema:PropertyValue ;
        dcterms:source "Tickle, Summerbell & Wolpert (1975) Nature 254:199-202; Tickle (1981) Nature 289:295-298 (4-3-2-2-3-4)" ;
        schema:value "6" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-paddle-wild-type-distal-digit-count-posterior-zpa-shh-aer-fgf-outgrowth> a schema:PropertyValue,

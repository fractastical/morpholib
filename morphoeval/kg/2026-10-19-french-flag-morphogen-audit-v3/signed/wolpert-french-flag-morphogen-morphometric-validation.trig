        schema:unitText "fraction of c0" ;
        schema:value "0.00238" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-2d-stencil-code-verification-rmse-of-non-growing-rectangle-with-clamped-aer-vs-1d-cosh-steady-state-reference> .


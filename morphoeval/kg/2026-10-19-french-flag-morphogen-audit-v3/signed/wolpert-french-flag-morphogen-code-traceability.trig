sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication, Ben-Zvi-Barkai (2010) scaling & 2D AER-FGF / ZPA-Shh limb bud paddle — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring maps each solver to its source and Lean theorem (L1-67, Pass 3 block L48-66); the Section 3b header states every equation, boundary condition, readout and the clock compression (L443-470); function docstrings cite Saunders / Summerbell / Tickle / Laufer / Niswander at the point of use (L558-576, L696-699, L721-727); the registry YAML (laws 5-8) pins Lean loci and code loci. Deductions: the Michaelis forms and the specific constants in LIMB2D_DEFAULTS have no equation-level citation (they are a modelling choice, stated as such but untraced) (-5); the 1/3-2/3 PD trisection is attributed to the progress-zone model but is not an equation of Summerbell-Lewis-Wolpert (1973) (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L686–L693: PD trisection attributed to the progress-zone model without an equation citation (deduction) <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L686-L693>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L48–L66" ;
        dcterms:description "Pass 3 docstring block: sources, equations and the four Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L48-L66> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L443–L470" ;
        dcterms:description "Section 3b header: equations, geometry, readouts, clock compression and non-claims" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L443-L470> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/wolpert-french-flag-morphogen.yaml L108–L174" ;
        dcterms:description "Laws 5-8 registered with lean_locus and code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/math_kg_loops/wolpert-french-flag-morphogen.yaml#L108-L174> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


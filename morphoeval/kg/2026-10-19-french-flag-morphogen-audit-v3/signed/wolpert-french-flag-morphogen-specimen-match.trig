sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication, Ben-Zvi-Barkai (2010) scaling & 2D AER-FGF / ZPA-Shh limb bud paddle — Morphological realism / specimen match: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-locked 72 h embryo photograph is still segmented and overlaid with concentric French-Flag rings (Panels E-F, L844-929; r = 0.9963), and the digit-count comparisons with Tickle's wings remain exact in 1D and now in 2D (Panels C, G, H). The new 2D output is a recognisable limb bud paddle with a posterior-distal Shh domain and a ridge-wide FGF field, and the GIF shows wild type, a duplicated bud and an AER-excised stump side by side. Deductions, now priced in more strictly than in v2: the specimen is a whole-egg photo whose area vasculosa is a proxy, not a morphogen gradient, and it is not a limb bud, so nothing in Panels G-I is compared with a real wing bud image, an Shh / Fgf in situ or Saunders' or Summerbell's own figures (-8); the paddle outline is a prescribed mask with fixed AP width, so its shape cannot be credited as a morphological match (-4); the anterior-graft bud grows longer (687 um, HH29) rather than broader, unlike duplicated wings (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L501–L544: Paddle geometry is prescribed (W = 500 um fixed, elliptical cap); no limb-bud image is compared with it (deduction) <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L501-L544>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L844–L929" ;
        dcterms:description "Specimen ROI, organizer detection, radial SDD fit (r = 0.9963) and ring radii — unchanged from v2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L844-L929> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/french_flag_morphogen_comparison.png (generated output)" ;
        dcterms:description "Panels E-F specimen overlay; Panel G 2D paddle with Shh field, FGF contours, AER/ZPA and 4-3-2 digit bar; Panel H dose series; Panel I truncation — docs/media/french_flag_morphogen_comparison.png: rendered output of 1969-wolpert-french-flag-morphogen.py at 469bf3c, image/png, 1396993 B, 2880×2688 px, artifact_sha256 8c085a38c660bc8306e75d1e8f570fd260932d2b0fcbe3d7a50ff07c7f1fcedd (sha256 8c085a38c660bc8306e75d1e8f570fd260932d2b0fcbe3d7a50ff07c7f1fcedd), spec_fingerprint 2318acced0a431554f620954ae7793615d43475a0b43ba5e6a33b913a35b9af8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/french_flag_morphogen_limb2d.gif (generated output)" ;
        dcterms:description "13 frames: wild type, anterior graft (grows to 687 um) and AER excised at HH22 (stump at 387 um) — docs/media/french_flag_morphogen_limb2d.gif: rendered output of 1969-wolpert-french-flag-morphogen.py at 469bf3c, image/gif, 394843 B, 960×459 px, 13 frames, artifact_sha256 ee558afcd59741848e3252f897c3f4ac8e2807ffd187a6a8d87324eb9ae7ece8 (sha256 ee558afcd59741848e3252f897c3f4ac8e2807ffd187a6a8d87324eb9ae7ece8), spec_fingerprint 2318acced0a431554f620954ae7793615d43475a0b43ba5e6a33b913a35b9af8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/french_flag_morphogen_growth.gif (generated output)" ;
        dcterms:description "18-frame HH18->HH28 growth animation (unscaled SDD vs expansion-repression French Flag), regenerated unchanged in content from v2 — docs/media/french_flag_morphogen_growth.gif: rendered output of 1969-wolpert-french-flag-morphogen.py at 469bf3c, image/gif, 298185 B, 836×594 px, 18 frames, artifact_sha256 dae6e3a63296702a098b8184ad682c76bf44f56b62cd5e267a3f7e5ee27e098a (sha256 dae6e3a63296702a098b8184ad682c76bf44f56b62cd5e267a3f7e5ee27e098a), spec_fingerprint 2318acced0a431554f620954ae7793615d43475a0b43ba5e6a33b913a35b9af8" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


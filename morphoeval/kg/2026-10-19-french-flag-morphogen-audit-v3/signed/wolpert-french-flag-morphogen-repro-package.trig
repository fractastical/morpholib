sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L1630–L1705" ;
        dcterms:description "11-check deterministic self_test() incl. 2D determinism (check 10) and 16-measurement contract (check 11)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L1630-L1705> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py L1708–L1750" ;
        dcterms:description "argparse CLI with all 1D and 2D parameters and three output paths" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L1708-L1750> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication, Ben-Zvi-Barkai (2010) scaling & 2D AER-FGF / ZPA-Shh limb bud paddle — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`--self-test` now runs 11 checks (L1630-1705): SHA-256 of 4 artefacts, 1D PDE convergence, ER scaling, the full Tickle dose series in 1D, Monte Carlo bitwise reproducibility, specimen segmentation, 2D stencil verification, 2D digit / dose / asymmetry readouts, truncation monotonicity and Shh collapse, bitwise determinism of the 2D solver (no RNG), and the 16-measurement contract; the default render takes 17 s and the self-test 44 s; the CLI documents all parameters (L1708-1750). Deductions: no lock file pins the numpy / scipy / matplotlib / Pillow versions recorded in this audit (-5); when `~/.matplotlib` is not writable the run emits font-cache warnings and writes a temporary cache, which the script does not control via MPLCONFIGDIR (-2); the GIF palettes are quantised from the last frame, so byte-identity across Pillow versions is not guaranteed (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L1341–L1344: GIF palette quantised from the final frame; Pillow-version dependent bytes (deduction) <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L1341-L1344>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 remediation + re-score)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


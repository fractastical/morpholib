    pk1:hasScore 9.1e-01 ;
    pk1:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-repro-package> a pk1:LLMClaimAssessment ;
    rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication, Ben-Zvi-Barkai (2010) scaling & 2D AER-FGF / ZPA-Shh limb bud paddle — Reproducibility package: 91/100" ;
    dct:date "2026-10-20"^^xsd:date ;
    dct:description "`--self-test` now runs 11 checks (L1630-1705): SHA-256 of 4 artefacts, 1D PDE convergence, ER scaling, the full Tickle dose series in 1D, Monte Carlo bitwise reproducibility, specimen segmentation, 2D stencil verification, 2D digit / dose / asymmetry readouts, truncation monotonicity and Shh collapse, bitwise determinism of the 2D solver (no RNG), and the 16-measurement contract; the default render takes 17 s and the self-test 44 s; the CLI documents all parameters (L1708-1750). Deductions: no lock file pins the numpy / scipy / matplotlib / Pillow versions recorded in this audit (-5); when `~/.matplotlib` is not writable the run emits font-cache warnings and writes a temporary cache, which the script does not control via MPLCONFIGDIR (-2); the GIF palettes are quantised from the last frame, so byte-identity across Pillow versions is not guaranteed (-2)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
    pk1:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk1:assessmentType "morphoeval/0.1.0/repro-package" ;
    pk1:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L1341–L1344: GIF palette quantised from the final frame; Pillow-version dependent bytes (deduction) <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L1341-L1344>" ;
    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-repro-package-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-repro-package-2> ;
    pk1:hasScore 9.1e-01 ;
    pk1:hasVerdict "faithful" .


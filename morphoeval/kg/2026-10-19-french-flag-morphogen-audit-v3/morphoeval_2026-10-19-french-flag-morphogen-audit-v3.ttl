    pk1:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L501–L544: Paddle geometry is prescribed (W = 500 um fixed, elliptical cap); no limb-bud image is compared with it (deduction) <https://github.com/fractastical/morpholib/blob/469bf3c/1969-wolpert-french-flag-morphogen.py#L501-L544>" ;
    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-specimen-match-2>,

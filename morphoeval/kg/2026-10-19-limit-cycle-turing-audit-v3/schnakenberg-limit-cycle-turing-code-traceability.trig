sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Every new modelling function carries a docstring naming its source: the Laplace–Beltrami ladder and spherical-harmonic eigenvalues (L833-858, Lean Law 4), the critical mound radius formula (L799-806), the Crampin–Gaffney–Maini uniform-growth form (L1007-1030), the first-order PDE scaled trace mirroring Lean `schnakenberg_pde_scaled_trace` (L427-437), the Michaelis–Menten quadratic (L450-461) and the Martiel–Goldbeter f1/f2/Y/Phi definitions with the physical meaning of each parameter commented inline (L158-173, L587-601). Section banners 3b and 4b label the remediation item they close. Deductions: equation numbers of the Martiel–Goldbeter paper and of Crampin et al. are deliberately not cited because they were not re-verified against the PDFs in this pass (-4); the spot-count threshold 0.55 std and the ring threshold (profile mean) are heuristics without a source (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L944–L964: count_hemisphere_spots threshold mean + 0.55 std and seam merging are uncited heuristics <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L944-L964>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L53–L59" ;
        dct:description "Header maps all five Lean 4 theorem names, including the two Pass 3 laws" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L53-L59> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L158–L176" ;
        dct:description "MARTIEL_GOLDBETER_PARAMS with per-parameter physical meaning and units; CAMP_PERIOD_REFERENCE_MIN with source" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L158-L176> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L785–L806" ;
        dct:description "turing_band_edges and critical_mound_radius docstrings derive R_min = sqrt(2/q_+) from the Law 4 ladder" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L785-L806> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation + re-score; Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


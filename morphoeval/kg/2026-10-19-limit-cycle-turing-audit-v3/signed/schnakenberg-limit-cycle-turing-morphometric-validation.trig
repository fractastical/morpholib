    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-differential-vs-equal-diffusion-control-contrast-ratio-d-18-vs-d-1-reference> a schema:PropertyValue ;
        dcterms:source "Turing (1952) & Lean 4 theorem schnakenberg_turing_instability_and_equal_diff" ;
        schema:value "100.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-elongating-stalk-annular-ring-count-at-final-length-l-4-0-vs-l-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Elongating stalk: annular ring count at final length L=4.0 vs L/lambda_c = 3 rings along stalk" ;
        dcterms:description "Ring count ladder 1 -> 3 over L=1.05 -> 4.00; rings lag L/lambda_c because stretched rings persist until the Turing band edge; azimuthal std=4.59e-14 (rings, not spots)" ;
        schema:measurementTechnique "Cylinder R=0.08 (2 pi R < lambda_c), exponential growth L0=1 -> L1=4 with dilution -rho u (rho=2.310), 1500 steps" ;
        schema:name "Elongating stalk: annular ring count at final length L=4.0 vs L/lambda_c" ;
        schema:unitText "rings along stalk" ;
        schema:value "3" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-elongating-stalk-annular-ring-count-at-final-length-l-4-0-vs-l-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-elongating-stalk-annular-ring-count-at-final-length-l-4-0-vs-l-lambda-c-reference> a schema:PropertyValue ;
        dcterms:source "Crampin, Gaffney & Maini (1999) uniform-growth frequency doubling; lambda_c from Schnakenberg dispersion" ;
        schema:value "4.25" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-elongating-stalk-final-ring-wavelength-l-n-vs-analytical-lambda-c-must-lie-inside-the-turing-band> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Elongating stalk: final ring wavelength L/n vs analytical lambda_c (must lie inside the Turing band) = 1.3333 domain length units" ;
        dcterms:description "Growth stretches rings past lambda_c toward the long-wavelength band edge before frequency-doubling (Crampin et al. 1999)" ;
        schema:measurementTechnique "Final stalk length divided by connected-segment ring count of the azimuthally averaged activator profile" ;
        schema:name "Elongating stalk: final ring wavelength L/n vs analytical lambda_c (must lie inside the Turing band)" ;
        schema:unitText "domain length units" ;
        schema:value "1.3333" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-elongating-stalk-final-ring-wavelength-l-n-vs-analytical-lambda-c-must-lie-inside-the-turing-band-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-elongating-stalk-final-ring-wavelength-l-n-vs-analytical-lambda-c-must-lie-inside-the-turing-band-reference> a schema:PropertyValue ;
        dcterms:source "Schnakenberg/Turing dispersion: unstable band lambda in (0.576, 1.615), fastest mode lambda_c" ;
        schema:value "0.9413" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hemispherical-mound-r-1-0-dominant-spherical-harmonic-degree-l-dom-vs-linear-prediction-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hemispherical mound R=1.0: dominant spherical-harmonic degree l_dom vs linear prediction l* = 6 spherical-harmonic degree l" ;
        dcterms:description "Radii swept: [0.1, 0.2, 0.35, 0.5, 0.75, 1.0, 1.5]; R_min=0.1297" ;
        schema:measurementTechnique "Legendre power spectrum P_l of the even-reflected cap field via scipy lpmv quadrature (l<=24); |l_dom - l*| <= 1 for 6/6 patterned radii" ;
        schema:name "Hemispherical mound R=1.0: dominant spherical-harmonic degree l_dom vs linear prediction l*" ;
        schema:unitText "spherical-harmonic degree l" ;
        schema:value "6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hemispherical-mound-r-1-0-dominant-spherical-harmonic-degree-l-dom-vs-linear-prediction-l-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hemispherical-mound-r-1-0-dominant-spherical-harmonic-degree-l-dom-vs-linear-prediction-l-reference> a schema:PropertyValue ;
        dcterms:source "Dispersion relation on the Laplace-Beltrami ladder q_l = l(l+1)/R^2 (Schnakenberg 1979 / Turing 1952)" ;
        schema:value "6" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hemispherical-mound-r-1-5-turing-spot-count-vs-hexagonal-packing-prediction> a schema:PropertyValue,

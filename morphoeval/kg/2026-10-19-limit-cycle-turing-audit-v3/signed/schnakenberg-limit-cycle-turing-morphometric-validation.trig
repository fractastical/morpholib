    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-hemispherical-mound-r-1-5-turing-spot-count-vs-hexagonal-packing-prediction-reference> a schema:PropertyValue ;

        schema:unitText "dimensionless scaled trace (1+kappa)^3 (b-a) - (a+b)^3" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-linear-pde-generalized-hopf-locus-scaled-trace-at-a-b-kappa-1-9-4-lean-law-5-instance-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-linear-pde-generalized-hopf-locus-scaled-trace-at-a-b-kappa-1-9-4-lean-law-5-instance-reference> a schema:PropertyValue ;
        dcterms:source "Lean 4 theorem schnakenberg_pde_hopf_shift (morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-martiel-goldbeter-1987-extracellular-camp-oscillation-period-at-k-e-5-4-min-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Martiel-Goldbeter (1987) extracellular cAMP oscillation period at k_e = 5.4 min^-1 = 10.68 min" ;
        dcterms:description "Oscillatory k_e window in sweep [1.0, 2.0, 3.0, 4.0, 5.4, 7.0, 9.0, 12.0]: [2.0, 3.0, 4.0, 5.4, 7.0] min^-1; amplitude 8.290, fold change 410.9" ;
        schema:measurementTechnique "LSODA integration of the 3-variable receptor-desensitization model (Table I parameters), peak-to-peak period over t in [60, 120] min" ;
        schema:name "Martiel-Goldbeter (1987) extracellular cAMP oscillation period at k_e = 5.4 min^-1" ;
        schema:unitText "min" ;
        schema:value "10.68" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-martiel-goldbeter-1987-extracellular-camp-oscillation-period-at-k-e-5-4-min-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-martiel-goldbeter-1987-extracellular-camp-oscillation-period-at-k-e-5-4-min-1-reference> a schema:PropertyValue ;
        dcterms:source "Gerisch & Hess (1974) PNAS 71:2118 spontaneous cAMP oscillations (~5-10 min, ~7 min typical)" ;
        schema:value "7.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-michaelis-menten-pde-hopf-threshold-k-e-hopf-0-10-0-90-k-m-1-numerical-onset-vs-analytical> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Michaelis-Menten PDE Hopf threshold k_e^Hopf(0.10, 0.90, K_m=1): numerical onset vs analytical = 0.1249 dimensionless PDE rate k_e / k_-1" ;
        dcterms:description "Supercritical Hopf: extracellular PDE degradation destabilizes the Turing-point focus into autonomous cAMP-like oscillations whose amplitude grows continuously from zero" ;
        schema:measurementTechnique "14-step bisection on the sign of the numerical linear growth rate (log-envelope slope of |u-u_*| from a 1e-3 perturbation) between k_e=0 and 2 k_e^Hopf" ;
        schema:name "Michaelis-Menten PDE Hopf threshold k_e^Hopf(0.10, 0.90, K_m=1): numerical onset vs analytical" ;
        schema:unitText "dimensionless PDE rate k_e / k_-1" ;
        schema:value "0.1249" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-michaelis-menten-pde-hopf-threshold-k-e-hopf-0-10-0-90-k-m-1-numerical-onset-vs-analytical-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-michaelis-menten-pde-hopf-threshold-k-e-hopf-0-10-0-90-k-m-1-numerical-onset-vs-analytical-reference> a schema:PropertyValue ;
        dcterms:source "tr(J_0) = -1 + 2 u_* v_* - k_e K_m/(K_m+u_*)^2 - u_*^2 = 0 (brentq) for du/dtau = a - u + u^2 v - k_e u/(K_m+u)" ;
        schema:value "0.1249" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-pulse-shape-comparison-schnakenberg-limit-cycle-duty-cycle-vs-martiel-goldbeter-relay> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pulse-shape comparison: Schnakenberg limit-cycle duty cycle vs Martiel-Goldbeter relay = 0.0445 fraction of period above half-maximum" ;
        dcterms:description "Both are relaxation pulses (short bursts, long refractory phase); MG spikes are sharper because receptor desensitization adds a slow third variable" ;
        schema:measurementTechnique "Dimensionless pulse metrics; normalized single-period waveform Pearson r = 0.779; fold change 102.9 (Schnakenberg) vs 410.9 (MG)" ;
        schema:name "Pulse-shape comparison: Schnakenberg limit-cycle duty cycle vs Martiel-Goldbeter relay" ;
        schema:unitText "fraction of period above half-maximum" ;
        schema:value "0.0445" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-pulse-shape-comparison-schnakenberg-limit-cycle-duty-cycle-vs-martiel-goldbeter-relay-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-pulse-shape-comparison-schnakenberg-limit-cycle-duty-cycle-vs-martiel-goldbeter-relay-reference> a schema:PropertyValue ;
        dcterms:source "Martiel & Goldbeter (1987) 3-variable relay at k_e = 5.4 min^-1 (extracellular cAMP gamma)" ;

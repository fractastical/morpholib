sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Source and data traceability: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "All seven sources carry DOIs in the module header (L28-52), `paper_citations.bib` (7 entries) and the new `pass3_curved_geometry_pde_reference.json`, whose three new DOIs were resolved through the Crossref API on 2026-10-19 and record that in `resolved_via`. The Pass 2 SHA-256 locks on `scout_manifest.json` and the specimen are unchanged (L93-96, L183-195) and the new reference table is re-derived by self-test check 16 (R_min, band edges, predicted l*, Martiel–Goldbeter Table I, Hopf thresholds for three K_m, oscillatory window; L1908-1924). Deductions: the new JSON is not SHA-256 pinned (it is a derived table, stated in the README) (-3); the Martiel–Goldbeter Table I values are taken from the standard literature set and were not re-read from the paper's PDF in this pass (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-5> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L28–L52" ;
        dcterms:description "Seven primary DOIs in the module docstring including Martiel & Goldbeter 1987, Gerisch & Hess 1974, Crampin et al. 1999" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L28-L52> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/limit_cycle_turing/pass3_curved_geometry_pde_reference.json L1–L103" ;
        dcterms:description "Pass 3 reference tables with Crossref-resolved DOIs, Lean Law 4/5 integer tables, R_min, band edges, Martiel–Goldbeter parameters and period anchor" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/datasets/limit_cycle_turing/pass3_curved_geometry_pde_reference.json#L1-L103> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/limit_cycle_turing/paper_citations.bib L45–L78" ;
        dcterms:description "Three new BibTeX entries with DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/datasets/limit_cycle_turing/paper_citations.bib#L45-L78> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L1908–L1924" ;
        dcterms:description "Self-test check 16: parity of the script's constants with the Pass 3 reference JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L1908-L1924> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-source-traceability-5> a pk:EvidenceItem ;
        rdfs:label "datasets/limit_cycle_turing/README.md L27–L31" ;
        dcterms:description "README states the new JSON is not SHA-256 pinned and that geometry is uncalibrated to the specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/datasets/limit_cycle_turing/README.md#L27-L31> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation + re-score; Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}

sub1:provenance {
    <https://doi.org/10.1006/bulm.1999.0131> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "Reaction and diffusion on growing domains: scenarios for robust pattern formation" .

    <https://doi.org/10.1016/0022-5193(79)90042-0> dcterms:date "1979"^^xsd:gYear ;
        dcterms:title "Simple chemical reaction systems with limit cycle behaviour" .

    <https://doi.org/10.1016/S0006-3495(87)83275-7> dcterms:date "1987"^^xsd:gYear ;
        dcterms:title "A model based on receptor desensitization for cyclic AMP signaling in Dictyostelium cells" .

    <https://doi.org/10.1038/253540a0> dcterms:date "1975"^^xsd:gYear ;
        dcterms:title "Mechanism for oscillatory synthesis of cyclic AMP in Dictyostelium discoideum" .

    <https://doi.org/10.1073/pnas.71.5.2118> dcterms:date "1974"^^xsd:gYear ;
        dcterms:title "Cyclic-AMP-controlled oscillations in suspended Dictyostelium cells: their relation to morphogenetic cell interactions" .

    <https://doi.org/10.1098/rstb.1952.0012> dcterms:date "1952"^^xsd:gYear ;
        dcterms:title "The chemical basis of morphogenesis" .

    <https://doi.org/10.1371/journal.pcbi.1004367> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "Regulation of spatiotemporal patterns by biological variability: general principles and applications to Dictyostelium discoideum" .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "In addition to the Pass 2 sweeps (5 regimes, 7-point d sweep, CLI overrides), Pass 3 adds three swept parameters whose effect is monotone and visible: mound radius R (predicted l* 0,1,2,3,5,6,10 and measured l_dom 0,1,2,3,5,6,9 across 7 radii; spot count 0->18 tracking 2 pi R^2/((sqrt3/2) lambda_c^2); Panel D2, L1597-1614), the Martiel–Goldbeter PDE rate k_e (period 7.07 -> 14.53 min rising monotonically inside the oscillatory window 2.0-7.0 min^-1 and quenched outside it; D4 inset, L1651-1660) and the Schnakenberg PDE rate k_e (amplitude 0 -> 11.8 rising monotonically past the Hopf point; D5, L1662-1684); `--R-mound`, `--ke-mg`, `--Km-pde` are wired to the panels (L1946-1948, L1967-1969). Deduction: the stalk radius and growth factor are fixed (no sweep), and K_m is a CLI knob without a rendered sweep (-4); the R sweep tolerance (+-1 degree) is the resolution of a 500-step transient, not a converged selection (-5)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L967–L1004" ;
        dcterms:description "run_mound_radius_sweep over MOUND_RADII with l_dom vs l*, spot count vs hexagonal packing" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L967-L1004> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L641–L647" ;
        dcterms:description "run_mg_pde_rate_sweep over 8 k_e values (1-12 min^-1) recording period/amplitude/oscillatory flag" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L641-L647> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L494–L528" ;
        dcterms:description "run_schnakenberg_pde_sweep: 7 k_e values spanning 0 to 8 k_e^Hopf plus growth-rate bisection for the onset" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L494-L528> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L1946–L1948" ;
        dcterms:description "New CLI flags --R-mound, --ke-mg, --Km-pde forwarded to render_outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L1946-L1948> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation + re-score; Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


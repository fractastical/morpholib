sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Morphological realism / specimen match: 85/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Panel C4 still shows the SHA-256-locked Dictyostelium sorocarp photograph with the two segmented sori, DoG mounds and the inter-sorus line beside the simulated regimes (L1531-1559), and the new row D is visually distinct from rows A-C: D1 a spotted hemispherical cap seen from above, D3 a ring ladder on the stalk, D4 relay spikes (L1573-1684; GIF frame 2 shows spots emerging on the cap). Deductions carried from v2 remain (the specimen is a static macro photograph with two sorocarps; no digitised figure of Schnakenberg 1979 is overlaid). New deduction: the mound and stalk are not drawn at the specimen's own proportions — R, R_stalk and L are model units with no px calibration, so the side-by-side is qualitative only (-1 vs v2); credit is given for the mound-top view being compared against the hexagonal-packing count rather than left to the eye." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L153–L153: MOUND_RADII are dimensionless model units; no mapping to the specimen's 32.9 px sorus diameter or stalk length <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L153-L153>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-3> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/limit_cycle_turing_comparison.png (generated output)" ;
        dct:description "4x5 figure: rows A-C as in v2 (C4 = specimen segmentation), row D = hemispherical mound top view, radius sweep, stalk kymograph, Martiel–Goldbeter relay, PDE Hopf onset; all visually distinct — docs/media/limit_cycle_turing_comparison.png: rendered output of 1979-schnakenberg-limit-cycle-turing.py at 3aaa03d, image/png, 980330 B, 2940×2310 px, artifact_sha256 a323c621aa63149ccc29db5fba8d855d51e45cdd34cffd63205b81f1dff7e9e7 (sha256 a323c621aa63149ccc29db5fba8d855d51e45cdd34cffd63205b81f1dff7e9e7), spec_fingerprint 2171bdf8211cc376e4fec882bcd645f848050c6a4e0c6d15ce22984bb3384713" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/limit_cycle_turing_growth.gif (generated output)" ;
        dct:description "12 frames, 945x306: planar spots | hemispherical mound spots emerging | limit-cycle orbit — docs/media/limit_cycle_turing_growth.gif: rendered output of 1979-schnakenberg-limit-cycle-turing.py at 3aaa03d, image/gif, 642863 B, 945×306 px, 12 frames, artifact_sha256 6b2f1a38a88adf0ded1746c2b1a40db80c4a4b14d8a9e0b15668cb90a04f3f49 (sha256 6b2f1a38a88adf0ded1746c2b1a40db80c4a4b14d8a9e0b15668cb90a04f3f49), spec_fingerprint 2171bdf8211cc376e4fec882bcd645f848050c6a4e0c6d15ce22984bb3384713" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L1583–L1595" ;
        dct:description "D1 orthographic projection x = R sin(theta) cos(phi), y = R sin(theta) sin(phi) of the cap field with spot / l_dom / R_min annotations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L1583-L1595> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation + re-score; Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


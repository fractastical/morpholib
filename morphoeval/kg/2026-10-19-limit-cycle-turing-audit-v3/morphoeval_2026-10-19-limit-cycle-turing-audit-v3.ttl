<https://w3id.org/delphi/resource/evidence/2026-10-19-limit-cycle-turing-audit-v3-schnakenberg-limit-cycle-turing-16> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Michaelis-Menten PDE Hopf threshold k_e^Hopf(0.10, 0.90, K_m=1): numerical onset vs analytical" ;
    dct:description "14-step bisection on the sign of the numerical linear growth rate (log-envelope slope of |u-u_*| from a 1e-3 perturbation) between k_e=0 and 2 k_e^Hopf" ;
    dct:source "tr(J_0) = -1 + 2 u_* v_* - k_e K_m/(K_m+u_*)^2 - u_*^2 = 0 (brentq) for du/dtau = a - u + u^2 v - k_e u/(K_m+u)" ;
    rdfs:comment "Supercritical Hopf: extracellular PDE degradation destabilizes the Turing-point focus into autonomous cAMP-like oscillations whose amplitude grows continuously from zero" ;
    schema:about "Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation)" ;
    schema:error 0e+00 ;
    schema:targetValue 1.249e-01 ;
    schema:unitText "dimensionless PDE rate k_e / k_-1" ;
    schema:value 1.249e-01 .


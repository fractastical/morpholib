<https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg (1979) Cubic Autocatalytic Equilibrium & Flux Conservation Law" ;
    dct:description "Establishes the unique positive homogeneous equilibrium (u_*, v_*) = (a+b, b/(a+b)^2) with invariant cubic flux u_*^2 v_* = b and linear total mass balance R_u + R_v = a + b - u | Variables: u: autocatalytic activator concentration; v: substrate/inhibitor concentration; a, b: dimensionless feed rates; γ: reaction-rate/area scale factor; d = D_v/D_u: diffusivity ratio" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81(3):389-400 Eqs. (15)-(20)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L202-L241>,
        <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L24-L37> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_react_u (a u flux : Int) : Int := a - u + flux
def schnakenberg_react_v (b flux : Int) : Int := b - flux
theorem schnakenberg_equilibrium_zero_flux (a b u flux : Int) :
    schnakenberg_react_u a (a + b) b = 0 ∧
    schnakenberg_react_v b b = 0 ∧
    schnakenberg_react_u a u flux + schnakenberg_react_v b flux = a + b - u := by
  simp [schnakenberg_react_u, schnakenberg_react_v]
  omega
"""^^pk:lean4 ;
    skos:notation "∂u/∂t = γ(a - u + u^2 v) + ∇^2 u,   ∂v/∂t = γ(b - u^2 v) + d ∇^2 v,   (u_*, v_*) = (a + b, b / (a + b)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0006-3495(87)83275-7>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1073/pnas.71.5.2118>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_react_u" ;
    pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_equilibrium_zero_flux" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg (1979) Exact Hopf Bifurcation Curve & Positive Jacobian Determinant Law" ;
    dct:description "Separates stable steady states from autonomous Poincaré-Bendixson limit-cycle oscillations across b - a = (a + b)^3 while proving det(J_0) = (a + b)^2 > 0 excludes fold bifurcations | Variables: J_0: 2x2 reaction Jacobian at (u_*, v_*); s = a + b: equilibrium activator concentration; tr(J_0): Jacobian trace; det(J_0): Jacobian determinant" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81(3):389-400 Eqs. (21)-(24)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L259-L289>,
        <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L46-L56> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_scaled_trace (a b s_cubed : Int) : Int := (b - a) - s_cubed
def schnakenberg_jacobian_det (n : Nat) : Nat := n * n + 2 * n + 1
theorem schnakenberg_hopf_trace_and_det_pos (a s_cubed : Int) (n : Nat) :
    schnakenberg_scaled_trace a (a + s_cubed) s_cubed = 0 ∧
    schnakenberg_jacobian_det n ≥ 1 := by
  simp [schnakenberg_scaled_trace, schnakenberg_jacobian_det]
  omega
"""^^pk:lean4 ;
    skos:notation "tr(J_0) = (b - a - (a + b)^3) / (a + b) = 0  <=>  b - a = (a + b)^3,   det(J_0) = (a + b)^2 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0006-3495(87)83275-7>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1073/pnas.71.5.2118>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_scaled_trace" ;
    pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_hopf_trace_and_det_pos" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg-Turing Differential-Diffusion Dispersion & Critical Ratio Law" ;
    dct:description "Proves equal diffusion (d = 1) is unconditionally stable at (a,b) = (0.1, 0.9) whereas d > d_c ≈ 8.5676 drives det(J(k^2)) < 0 and amplifies periodic Turing spots/stripes | Variables: q = k^2: squared spatial wavenumber; d = D_v/D_u: substrate-to-activator diffusivity ratio; d_c: critical Turing diffusivity ratio" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81:389-400 & Turing (1952) Phil. Trans. R. Soc. B 237:37-72" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L292-L340>,
        <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L68-L81> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_equal_diff_det (q : Nat) : Nat := q * q + 2 * q + 100
def schnakenberg_fourier_det (d q : Int) : Int := d * q * q - (8 * d - 10) * q + 100
theorem schnakenberg_turing_instability_and_equal_diff (q : Nat) :
    schnakenberg_equal_diff_det q ≥ 100 ∧
    schnakenberg_fourier_det 1 0 = 100 ∧
    schnakenberg_fourier_det 9 3 = -5 ∧
    schnakenberg_fourier_det 18 4 = -148 := by
  refine ⟨?_, by decide, by decide, by decide⟩
  simp [schnakenberg_equal_diff_det]
"""^^pk:lean4 ;
    skos:notation "det(J(k^2)) = d k^4 - γ (d (b-a)/(a+b) - (a+b)^2) k^2 + γ^2 (a+b)^2,   d_c(a,b) = (((a+b)^2 + (a+b)√(2b(a+b))) / (b-a))^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0006-3495(87)83275-7>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1073/pnas.71.5.2118>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_fourier_det" ;
    pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_turing_instability_and_equal_diff" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Laplace–Beltrami Spherical-Harmonic Ladder & Finite Turing Band on a Hemispherical Mound (Pass 3)" ;
    dct:description "On a hemispherical Dictyostelium mound (no-flux equator) only finitely many spherical-harmonic degrees fall inside the Turing band; mound size selects the fastest-growing degree l*(R) and mounds smaller than R_min stay homogeneous — verified numerically by simulate_schnakenberg_hemisphere and the mound-radius sweep | Variables: l: spherical-harmonic degree; R: mound radius; q_l = l(l+1)/R^2: Laplace–Beltrami eigenvalue replacing the planar k^2; q_+: upper edge of the planar Turing band; R_min: critical mound radius" ;
    dct:source "Turing (1952) Phil. Trans. R. Soc. B 237:37-72 (spherical case) & Schnakenberg (1979) kinetics; Crampin, Gaffney & Maini (1999) Bull. Math. Biol. 61:1093-1120 for the growing-stalk companion solver" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L785-L1090>,
        <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L97-L110> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def sphere_laplace_eigenvalue (l : Nat) : Nat := l * (l + 1)
theorem schnakenberg_sphere_turing_band :
    sphere_laplace_eigenvalue 0 = 0 ∧
    (∀ l : Nat, sphere_laplace_eigenvalue (l + 1) = sphere_laplace_eigenvalue l + 2 * (l + 1)) ∧
    schnakenberg_fourier_det 18 (sphere_laplace_eigenvalue 0) = 100 ∧
    schnakenberg_fourier_det 18 (sphere_laplace_eigenvalue 1) = -96 ∧
    schnakenberg_fourier_det 18 (sphere_laplace_eigenvalue 2) = -56 ∧
    schnakenberg_fourier_det 18 (sphere_laplace_eigenvalue 3) = 1084 := by
  refine ⟨rfl, ?_, by decide, by decide, by decide, by decide⟩
  intro l
  simp only [sphere_laplace_eigenvalue, Nat.mul_add, Nat.add_mul, Nat.mul_one, Nat.one_mul]
  omega
"""^^pk:lean4 ;
    skos:notation "Δ_S Y_l^m = -l(l+1)/R^2 · Y_l^m;   (l+1)(l+2) = l(l+1) + 2(l+1);   det_J(18, l(l+1)) = 100, -96, -56, 1084 for l = 0, 1, 2, 3  (γR^2 = 10 units);   R_min = sqrt(2/q_+) = 0.1297" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0006-3495(87)83275-7>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1073/pnas.71.5.2118>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_002.sphere_laplace_eigenvalue" ;
    pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_sphere_turing_band" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/schnakenberg-limit-cycle-turing-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Extracellular Phosphodiesterase Degradation Shifts the Schnakenberg Hopf Curve (Pass 3)" ;
    dct:description "Extracellular cAMP phosphodiesterase moves the Hopf boundary — at fixed feed rates increasing PDE degradation destabilizes the focus into autonomous relaxation oscillations (κ = 4 is exactly Hopf at (a,b) = (1,9)); compared in the script against the 3-variable Martiel–Goldbeter (1987) cAMP relay with its own PDE rate k_e | Variables: κ = k_PDE/k_-1: first-order extracellular phosphodiesterase rate relative to Schnakenberg's X→A decay; k_e, K_m: Michaelis–Menten PDE rate and constant; s = a + b" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81:389-400 Eq. (24) generalized; Martiel & Goldbeter (1987) Biophys. J. 52:807-828 (doi:10.1016/S0006-3495(87)83275-7); Gerisch & Hess (1974) PNAS 71:2118-2122 (doi:10.1073/pnas.71.5.2118)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L427-L653>,
        <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L127-L140> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_pde_scaled_trace (a b kappa1 s_cubed : Int) : Int :=
  kappa1 * kappa1 * kappa1 * (b - a) - s_cubed
theorem schnakenberg_pde_hopf_shift (a m kappa1 : Int) :
    schnakenberg_pde_scaled_trace a (a + m) kappa1 (kappa1 * kappa1 * kappa1 * m) = 0 ∧
    schnakenberg_pde_scaled_trace a (a + m) 1 m = 0 ∧
    schnakenberg_pde_scaled_trace 1 9 1 1000 = -992 ∧
    schnakenberg_pde_scaled_trace 1 9 5 1000 = 0 ∧
    schnakenberg_pde_scaled_trace 1 9 6 1000 = 728 := by
  refine ⟨?_, ?_, by decide, by decide, by decide⟩
  · have h : a + m - a = m := by omega
    simp only [schnakenberg_pde_scaled_trace, h, Int.sub_self]
  · simp only [schnakenberg_pde_scaled_trace]
    omega
"""^^pk:lean4 ;
    skos:notation "du/dτ = a - (1+κ) u + u^2 v  ⇒  u_* = (a+b)/(1+κ),  s(1+κ)^2 · tr(J_0) = (1+κ)^3 (b-a) - (a+b)^3,  det(J_0) = (a+b)^2/(1+κ) > 0;   Hopf: (1+κ)^3 (b-a) = (a+b)^3;   Michaelis–Menten form -k_e u/(K_m+u): u_*^2 + (K_m + k_e - a - b) u_* - (a+b) K_m = 0, k_e^Hopf(0.1, 0.9, K_m=1) = 0.12486" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0006-3495(87)83275-7>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1073/pnas.71.5.2118>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_pde_scaled_trace" ;
    pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_pde_hopf_shift" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-1>,
        <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-2>,
        <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-3> .

<https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-1> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Schnakenberg (1979) Cubic Autocatalytic Equilibrium & Flux Conservation Law" ;
    dct:description "Establishes the unique positive homogeneous equilibrium (u_*, v_*) = (a+b, b/(a+b)^2) with invariant cubic flux u_*^2 v_* = b and linear total mass balance R_u + R_v = a + b - u | Variables: u: autocatalytic activator concentration; v: substrate/inhibitor concentration; a, b: dimensionless feed rates; γ: reaction-rate/area scale factor; d = D_v/D_u: diffusivity ratio" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81(3):389-400 Eqs. (15)-(20)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L139-L178>,
        <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L24-L37> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_react_u (a u flux : Int) : Int := a - u + flux
def schnakenberg_react_v (b flux : Int) : Int := b - flux
theorem schnakenberg_equilibrium_zero_flux (a b u flux : Int) :
    schnakenberg_react_u a (a + b) b = 0 ∧
    schnakenberg_react_v b b = 0 ∧
    schnakenberg_react_u a u flux + schnakenberg_react_v b flux = a + b - u := by
  simp [schnakenberg_react_u, schnakenberg_react_v]
  omega
"""^^pk1:lean4 ;
    skos:notation "∂u/∂t = γ(a - u + u^2 v) + ∇^2 u,   ∂v/∂t = γ(b - u^2 v) + d ∇^2 v,   (u_*, v_*) = (a + b, b / (a + b)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0006-3495(87)83275-7>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1073/pnas.71.5.2118>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_react_u" ;
    pk1:leanTheorem "MathOfBiology.Loop_002.schnakenberg_equilibrium_zero_flux" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-2> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Schnakenberg (1979) Exact Hopf Bifurcation Curve & Positive Jacobian Determinant Law" ;
    dct:description "Separates stable steady states from autonomous Poincaré-Bendixson limit-cycle oscillations across b - a = (a + b)^3 while proving det(J_0) = (a + b)^2 > 0 excludes fold bifurcations | Variables: J_0: 2x2 reaction Jacobian at (u_*, v_*); s = a + b: equilibrium activator concentration; tr(J_0): Jacobian trace; det(J_0): Jacobian determinant" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81(3):389-400 Eqs. (21)-(24)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L196-L226>,
        <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L46-L56> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_scaled_trace (a b s_cubed : Int) : Int := (b - a) - s_cubed
def schnakenberg_jacobian_det (n : Nat) : Nat := n * n + 2 * n + 1
theorem schnakenberg_hopf_trace_and_det_pos (a s_cubed : Int) (n : Nat) :
    schnakenberg_scaled_trace a (a + s_cubed) s_cubed = 0 ∧
    schnakenberg_jacobian_det n ≥ 1 := by
  simp [schnakenberg_scaled_trace, schnakenberg_jacobian_det]
  omega
"""^^pk1:lean4 ;
    skos:notation "tr(J_0) = (b - a - (a + b)^3) / (a + b) = 0  <=>  b - a = (a + b)^3,   det(J_0) = (a + b)^2 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0006-3495(87)83275-7>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1073/pnas.71.5.2118>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_scaled_trace" ;
    pk1:leanTheorem "MathOfBiology.Loop_002.schnakenberg_hopf_trace_and_det_pos" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-3> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Schnakenberg-Turing Differential-Diffusion Dispersion & Critical Ratio Law" ;
    dct:description "Proves equal diffusion (d = 1) is unconditionally stable at (a,b) = (0.1, 0.9) whereas d > d_c ≈ 8.5676 drives det(J(k^2)) < 0 and amplifies periodic Turing spots/stripes | Variables: q = k^2: squared spatial wavenumber; d = D_v/D_u: substrate-to-activator diffusivity ratio; d_c: critical Turing diffusivity ratio" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81:389-400 & Turing (1952) Phil. Trans. R. Soc. B 237:37-72" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L229-L276>,
        <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L68-L81> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_equal_diff_det (q : Nat) : Nat := q * q + 2 * q + 100
def schnakenberg_fourier_det (d q : Int) : Int := d * q * q - (8 * d - 10) * q + 100
theorem schnakenberg_turing_instability_and_equal_diff (q : Nat) :
    schnakenberg_equal_diff_det q ≥ 100 ∧
    schnakenberg_fourier_det 1 0 = 100 ∧
    schnakenberg_fourier_det 9 3 = -5 ∧
    schnakenberg_fourier_det 18 4 = -148 := by
  refine ⟨?_, by decide, by decide, by decide⟩
  simp [schnakenberg_equal_diff_det]
"""^^pk1:lean4 ;
    skos:notation "det(J(k^2)) = d k^4 - γ (d (b-a)/(a+b) - (a+b)^2) k^2 + γ^2 (a+b)^2,   d_c(a,b) = (((a+b)^2 + (a+b)√(2b(a+b))) / (b-a))^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/bulm.1999.0131>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0006-3495(87)83275-7>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1073/pnas.71.5.2118>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk1:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_fourier_det" ;
    pk1:leanTheorem "MathOfBiology.Loop_002.schnakenberg_turing_instability_and_equal_diff" ;
    pk1:leanVerified true .


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Model fidelity to source: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 2 core unchanged (exact equilibrium, Jacobian, Hopf curve, d_c, dispersion; L202-340). Pass 3 adds (i) the Laplace–Beltrami operator on the hemisphere discretised as a conservative sin(theta) finite-volume ladder per azimuthal Fourier mode with the no-flux equator and the pole flux vanishing identically, advanced by exact exp(dt D L_m) propagators from the symmetrised eigenproblem (L833-914; constant annihilation < 1e-9 checked at L1859-1861); (ii) the uniform-growth Lagrangian form with dilution (L1007-1076); (iii) the first-order and Michaelis–Menten PDE sinks with closed-form equilibria and Jacobian traces (L427-492) whose generalized Hopf curve is proved in Lean Law 5; (iv) the Martiel–Goldbeter f1/f2/Phi kinetics (L587-609). Deductions: the geometry is a surface reduction, not the 3D culminant, and stalk growth is uniform rather than apical (-3); the Martiel–Goldbeter reproduction gives T = 10.68 min at k_e = 5.4 whereas the model is usually quoted near 7-9 min, so either a parameter or the published figure value is unverified here (-3); the implicit identification of Schnakenberg u with extracellular cAMP is an assumption (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L1007–L1012: Stalk growth is uniform exponential in a Lagrangian frame; real culmination is apical/tip growth — a reduced model, stated in the docstring <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L1007-L1012>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-5> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L833–L914" ;
        dct:description "simulate_schnakenberg_hemisphere: Laplace–Beltrami ladder with sin(theta) face weights, no-flux equator, exact exp(dt D L_m) propagators" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L833-L914> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L1007–L1076" ;
        dct:description "simulate_growing_stalk: Lagrangian xi = z/L(t), exponential growth, dilution -(L'/L) u, mirrored-FFT Neumann ends" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L1007-L1076> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L427–L492" ;
        dct:description "First-order and Michaelis–Menten PDE sinks: scaled trace (1+kappa)^3(b-a)-(a+b)^3, quadratic equilibrium, Jacobian trace, brentq Hopf threshold" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L427-L492> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L587–L609" ;
        dct:description "martiel_goldbeter_rhs: 3-variable receptor-desensitization relay (f1, f2, Y, Phi) with extracellular PDE rate k_e" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L587-L609> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean L84–L140" ;
        dct:description "Law 4 schnakenberg_sphere_turing_band (ladder gap 2(l+1), finite band l in {1,2}) and Law 5 schnakenberg_pde_hopf_shift (generalized Hopf locus, (1,9) instance); lean exit 0, 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L84-L140> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation + re-score; Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


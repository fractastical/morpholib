sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Reproducibility package: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic seed 1979 throughout (hemisphere, stalk, planar), headless Agg backend, LSODA with fixed tolerances for the relay; two consecutive default renders produced a byte-identical PNG (SHA-256 a323c621...); `--self-test` runs 16 checks (8 Pass 2 + 8 Pass 3, including hemisphere bitwise determinism, Laplace–Beltrami constant annihilation, Hopf-onset parity < 2 %, Lean integer mirrors and reference-table parity) in ~5 s; default render ~7 s (well under the 3 min budget); all CLI flags documented in argparse (L1936-1978). Deductions: dependency versions are recorded only in this audit, not in a lock file next to the script (-4); when `$HOME/.matplotlib` is not writable matplotlib rebuilds its font cache (environment note, not a result change) (-2); the GIF is not checked for byte identity (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-repro-package-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L1787–L1933" ;
        dct:description "16-check self_test(): Pass 2 checks 1-8 plus Pass 3 checks 9-16 (Lean mirrors, R_min, hemisphere determinism, stalk rings, PDE Hopf parity, Martiel–Goldbeter window, reference-table parity)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L1787-L1933> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L1856–L1857" ;
        dct:description "Hemisphere solver two-run bitwise determinism assertion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L1856-L1857> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "1979-schnakenberg-limit-cycle-turing.py L1936–L1978" ;
        dct:description "CLI with --self-test, --skip-gif, parameter overrides and the three Pass 3 flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/1979-schnakenberg-limit-cycle-turing.py#L1936-L1978> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 remediation + re-score; Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


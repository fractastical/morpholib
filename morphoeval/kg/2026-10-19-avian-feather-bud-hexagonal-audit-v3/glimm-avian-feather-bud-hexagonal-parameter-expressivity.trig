sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Ho et al. (2019) & Painter, Ho & Headon (2018) avian feather tracts on a curved trunk-and-limb surface: geodesic EDA competence wave, inhibitory-disk hexagonal packing, density-threshold tract boundaries and curvature-induced 5-7 dislocations — Parameter expressivity: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Sweeps: six wave speeds v_w in {0.11, 0.16, 0.22, 1.2, 4.0, 100} (Panel E), seven chemotactic sensitivities chi in {0, 0.01, 0.04, 0.08, 0.14, 0.20, 0.24} crossing chi_c (Panel F), five EDA / density regimes (control, Fc-chEDA1, Ecto-D2, MTX, MTX + Ecto-D2; L844-912, Panel L), and a four-level limb-bud height sweep A_l in {0, 15, 30, 45} on the curved surface (L921-969, Panel K). CLI exposes `--vw --chi --Dn --Dc --Db --n-crit --density-scale --limb-height --steps --seed` plus `--single` (one curved three-tract run printed as JSON) and `--self-test` (L1508-1541). All surface parameters are keyword arguments of `build_embryo_trunk_surface` / `simulate_feather_array_on_surface`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L844–L969" ;
        dct:description "Wave-speed, chi, EDA-density and limb-height sweeps" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py#L844-L969> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L1508–L1541" ;
        dct:description "CLI flags including --n-crit, --density-scale, --limb-height and --single" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py#L1508-L1541> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L314–L330" ;
        dct:description "Surface geometry parameters (trunk height/sigma/taper, limb height/sigma/offset, humeral/femoral positions, flat switch)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py#L314-L330> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


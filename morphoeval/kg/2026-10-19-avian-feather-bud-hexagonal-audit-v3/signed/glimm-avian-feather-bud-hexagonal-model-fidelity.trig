sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Ho et al. (2019) & Painter, Ho & Headon (2018) avian feather tracts on a curved trunk-and-limb surface: geodesic EDA competence wave, inhibitory-disk hexagonal packing, density-threshold tract boundaries and curvature-induced 5-7 dislocations — Model fidelity to source: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Implements the Painter, Ho & Headon (2018) Keller-Segel n/c/b system with its exact linear threshold chi_c = 0.0540 (L167-229) and lifts it to a curved skin surface: Monge-patch metric, sqrt(det g), g^{ij} and Gaussian curvature (L314-372), a conservative face-flux Laplace-Beltrami / surface chemotaxis operator (L374-399), a Godunov eikonal geodesic EDA competence wave (L401-435) and the Ho 2019 mesenchymal density threshold n_0(1 + gamma t) >= n_crit with n_crit set by the measured margin densities 49 / 66 / 98 cells per 100 um (L548-749). Tract-boundary dislocations between the dorsal and limb tracts are now a mechanistic consequence of curvature (Lean Theorems 4-6; Bausch 2003), closing the v2 remediation item. Scored below v2's 94 because primordium nucleation is a wave-gated inhibitory-disk adsorption rule relaxed by the PDE rather than an emergent PDE instability (`model_boundary_note` in the reference JSON), the eikonal solver uses only the diagonal metric, and the limb-bud geometry is schematic." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "datasets/avian_feather_bud_hexagonal/avian_feather_bud_hexagonal_reference.json L1–L259: governing_equations.model_boundary_note states nucleation is not emergent from the PDE; curved_surface_model.limitations lists the diagonal-metric eikonal and schematic limb geometry <https://github.com/fractastical/morpholib/blob/d58a084/datasets/avian_feather_bud_hexagonal/avian_feather_bud_hexagonal_reference.json#L1-L259>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-5> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L167–L229" ;
        dcterms:description "Painter 2018 dispersion relation, chi_c = 0.0540, equilateral row geometry (Lean Theorems 1-2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py#L167-L229> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L314–L435" ;
        dcterms:description "Monge-patch surface, metric/curvature, conservative Laplace-Beltrami operator and geodesic eikonal competence wave" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py#L314-L435> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L548–L749" ;
        dcterms:description "Surface simulation: geodesic wave gating, density-threshold competence, 3D inhibitory-disk nucleation, surface PDE relaxation of n/c/b" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py#L548-L749> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L751–L842" ;
        dcterms:description "Curvature-localised defect analysis and isochrone row-count lemma check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py#L751-L842> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_019_avian_feather_bud_hexagonal.lean L29–L182" ;
        dcterms:description "6 machine-checked Lean 4 theorems (0 sorrys): KS instability, hexagonal equidistance, wave fidelity, Euler disclination charge (+ sphere corollary), isochrone dislocation, Monge metric determinant" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_019_avian_feather_bud_hexagonal.lean#L29-L182> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


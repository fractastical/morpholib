sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> a pk:Claim ;
        rdfs:label "Ho et al. (2019) & Painter, Ho & Headon (2018) avian feather tracts on a curved trunk-and-limb surface: geodesic EDA competence wave, inhibitory-disk hexagonal packing, density-threshold tract boundaries and curvature-induced 5-7 dislocations faithfully reproduces Embryonic chick (Gallus gallus) dorsal, humeral and femoral feather tracts E6.5-E7.5; Fc-chEDA1 / Ecto-D2 / methotrexate / Latrunculin A / scaleless (FGF20 sc/sc) perturbations morphology" ;
        dcterms:description "The simulation script(s) 2018-glimm-avian-feather-bud-hexagonal.py implement the cited source model as published and produce forms that match real Embryonic chick (Gallus gallus) dorsal, humeral and femoral feather tracts E6.5-E7.5; Fc-chEDA1 / Ecto-D2 / methotrexate / Latrunculin A / scaleless (FGF20 sc/sc) perturbations specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.8/100, audit 2026-10-19-avian-feather-bud-hexagonal-audit-v3) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py; output: docs/media/avian_feather_bud_hexagonal_comparison.png; organism: Embryonic chick (Gallus gallus) dorsal, humeral and femoral feather tracts E6.5-E7.5; Fc-chEDA1 / Ecto-D2 / methotrexate / Latrunculin A / scaleless (FGF20 sc/sc) perturbations; checkpoint commit: https://github.com/fractastical/morpholib/commit/d58a084; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 3fbee933f34698c1174f68ad05c98568d7506c7ded5d60e6139c6071b4be189e; artifact_sha256: ba009d31e0385026103342b2010994117e85753b24af6da1eb9e321c9ab2511d; input_dataset_sha256: {datasets/avian_feather_bud_hexagonal/avian_feather_bud_hexagonal_reference.json=61c579212066cfb2..., datasets/avian_feather_bud_hexagonal/chick_feather_bud_hexagonal_specimen.jpg=ce18b1c0e01ecb20..., datasets/avian_feather_bud_hexagonal/paper_citations.bib=721ac5198ac62b2d..., datasets/avian_feather_bud_hexagonal/scout_manifest.json=1ff38c1e609c69ea...}; supersedes_audit_id: 2026-10-19-avian-feather-bud-hexagonal-audit-v2" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jtbi.2017.10.026>,
            <https://doi.org/10.1126/science.1081160>,
            <https://doi.org/10.1242/dev.018341>,
            <https://doi.org/10.1371/journal.pbio.3000132>,
            <https://doi.org/10.1371/journal.pbio.3000448> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-parameter-expressivity>,

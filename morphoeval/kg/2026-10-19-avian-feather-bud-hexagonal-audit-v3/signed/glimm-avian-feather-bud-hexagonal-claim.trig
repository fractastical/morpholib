            <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-specimen-match> ;
        pk:weightOfEvidence "0.918"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py> a schema:SoftwareSourceCode ;

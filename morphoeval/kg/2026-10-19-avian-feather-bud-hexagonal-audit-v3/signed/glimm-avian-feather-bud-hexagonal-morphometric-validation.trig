        schema:measurementTechnique "Nucleated primordia under FGF20 chemotaxis loss (chi = 0.0) and actomyosin motility blockade (chi = 0.01 < chi_c)" ;
        schema:name "scaleless (FGF20-/-, chi=0) and Latrunculin (chi=0.01) negative control bud count" ;
        schema:unitText "buds" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-scaleless-fgf20-chi-0-and-latrunculin-chi-0-01-negative-control-bud-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-scaleless-fgf20-chi-0-and-latrunculin-chi-0-01-negative-control-bud-count-reference> a schema:PropertyValue ;
        dcterms:source "Ho et al. (2019) PLOS Biol. 17(2):e3000132 Fig 1C (Latrunculin A), S5 Fig (scaleless) & Lean Theorem 1" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-feather-primordia-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Gallus gallus Panel B specimen feather primordia count = 24.0 buds" ;
        dcterms:description "detected 24 feather buds (12 interior Voronoi cells), NN spacing = 40.33 +- 7.96 px (CV = 0.1974)" ;
        schema:measurementTechnique "Difference-of-Gaussians optical density peak segmentation on chick_feather_bud_hexagonal_specimen.jpg Panel B ROI [494, 24, 770, 218]" ;
        schema:name "segmented Gallus gallus Panel B specimen feather primordia count" ;
        schema:unitText "buds" ;
        schema:value "24.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-feather-primordia-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-feather-primordia-count-reference> a schema:PropertyValue ;

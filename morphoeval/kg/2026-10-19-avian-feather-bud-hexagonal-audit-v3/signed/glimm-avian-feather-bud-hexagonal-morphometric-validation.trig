sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Ho et al. (2019) & Painter, Ho & Headon (2018) avian feather tracts on a curved trunk-and-limb surface: geodesic EDA competence wave, inhibitory-disk hexagonal packing, density-threshold tract boundaries and curvature-induced 5-7 dislocations — Morphometric validation: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1304-1422) emits 16 measurements with method, reference and uncertainty notes: Delta_x / lambda_y = 0.866, chi_c = 0.054, WT P_6 = 1.00 (ref 0.75), simultaneous P_6 = 0.69 (ref 0.50), Fc-chEDA1 width 1.25x, Ecto-D2 0.50x, MTX + Ecto-D2 / min(single) = 0.53 (< 1 as in Fig 5F), 0-bud negative controls, specimen count 24 and P_6 = 0.75, curved vs flat three-tract P_6 (0.905 vs 0.979), curved/flat-region defect-fraction ratio 2.81 (null 1.0), limb-height sweep pairs 10 at A_l = 45 (0 at A_l = 0), sphere disclination charge 12 (exact), isochrone-lemma violations 0, dorsal-femoral apterium gap 1.19 lambda. Three width ratios carry `reference_value: null` because Ho 2019 does not tabulate them (only ordering / significance), and the WT model lattice is noise-free so its P_6 = 1.00 exceeds the paper's ~0.75; both are stated explicitly." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-bare-inter-tract-apterium-gap-between-dorsal-and-femoral-tracts-curved-surface>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-curved-trunk-limb-bud-surface-three-tract-p-6-vs-flat-three-tract-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-defect-fraction-in-curved-k-k-thr-vs-flat-k-k-thr-regions-of-the-curved-surface>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-ecto-d2-n-crit-98-66-patterned-region-width-ratio-to-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-equilateral-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-euler-gauss-bonnet-disclination-charge-sum-6-z-on-a-closed-convex-hull-triangulation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-fc-cheda1-n-crit-49-66-patterned-region-width-ratio-to-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-isochrone-row-count-dislocation-lemma-violations-on-the-curved-dorsal-tract>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-limb-bud-height-sweep-5-7-dislocation-pairs-at-the-tallest-limb-buds>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-mtx-ecto-d2-co-treatment-width-relative-to-the-narrower-single-treatment>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-scaleless-fgf20-chi-0-and-latrunculin-chi-0-01-negative-control-bud-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-feather-primordia-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-interior-voronoi-hexagonal-fraction-p-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-simultaneous-competence-latrunculin-paused-released-v-w-inf-six-neighbour-fraction-p-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-wild-type-geodesic-wave-v-w-0-22-interior-six-neighbour-fraction-p-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-morphometric-validation-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-bare-inter-tract-apterium-gap-between-dorsal-and-femoral-tracts-curved-surface> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "bare inter-tract apterium gap between dorsal and femoral tracts (curved surface) = 1.1944 feather periods lambda_y" ;
        dcterms:description "flat control gap = 1.389 lambda_y; gap arises from the mesenchymal density threshold, not from wave collision" ;
        schema:measurementTechnique "Minimum mediolateral separation between the lateral-most dorsal primordium and the medial-most femoral primordium (right side)" ;
        schema:name "bare inter-tract apterium gap between dorsal and femoral tracts (curved surface)" ;
        schema:unitText "feather periods lambda_y" ;
        schema:value "1.1944" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical FGF20 chemotactic sensitivity threshold chi_c = 0.054 chemotactic sensitivity" ;
        dcterms:description "WT sigma_max(chi=0.24) = +0.3967 vs scaleless sigma_max(chi=0) = -0.0800; nucleation disabled for chi < chi_c (chi = 0.04 -> 0 buds)" ;
        schema:measurementTechnique "Keller-Segel / FGF20 linear instability threshold ((sqrt(D_n*mu_c)+sqrt(D_c*r_n))^2)/(n_0*f_c) (Painter et al. 2018 linearisation)" ;
        schema:name "critical FGF20 chemotactic sensitivity threshold chi_c" ;
        schema:unitText "chemotactic sensitivity" ;
        schema:value "0.054" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-critical-fgf20-chemotactic-sensitivity-threshold-chi-c-reference> a schema:PropertyValue ;
        dcterms:source "Painter, Ho & Headon (2018) J. Theor. Biol. 437:225-238 & Lean Theorem 1" ;
        schema:value "0.054" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-curved-trunk-limb-bud-surface-three-tract-p-6-vs-flat-three-tract-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "curved trunk + limb-bud surface three-tract P_6 (vs flat three-tract control) = 0.905 fraction of interior primordia" ;
        dcterms:description "curved: 5s=19, 7s=4, 5-7 pairs=7, |psi_6|=0.868; flat: 5s=5, 7s=0, pairs=0; per tract {\"dorsal\": 0.95, \"femoral\": 0.862, \"humeral\": 0.883}" ;
        schema:measurementTechnique "Wave-gated inhibitory-disk packing on the Monge patch (geodesic eikonal wave, 3D chordal inhibition radius), local tangent-plane coordination" ;
        schema:name "curved trunk + limb-bud surface three-tract P_6 (vs flat three-tract control)" ;
        schema:unitText "fraction of interior primordia" ;
        schema:value "0.905" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-curved-trunk-limb-bud-surface-three-tract-p-6-vs-flat-three-tract-control-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-curved-trunk-limb-bud-surface-three-tract-p-6-vs-flat-three-tract-control-reference> a schema:PropertyValue ;
        dcterms:source "Flat (h = 0) three-tract control run with identical parameters and seed" ;
        schema:value "0.9786" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-defect-fraction-in-curved-k-k-thr-vs-flat-k-k-thr-regions-of-the-curved-surface> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "defect fraction in curved (|K| > K_thr) vs flat (|K| <= K_thr) regions of the curved surface = 2.8105 ratio of defect fractions" ;
        dcterms:description "curved-region defect fraction 0.2222 (n=27) vs flat-region 0.0791 (n=215); Gauss-Bonnet proxy per tract {\"dorsal\": -0.55, \"femoral\": 0.36, \"humeral\": 0.28} vs charge {\"dorsal\": 5, \"femoral\": 5, \"humeral\": 5}" ;
        schema:measurementTechnique "Interior primordia split by |Gaussian curvature| at their position (K_thr = 0.0004); ratio of (z != 6) fractions" ;
        schema:name "defect fraction in curved (|K| > K_thr) vs flat (|K| <= K_thr) regions of the curved surface" ;
        schema:unitText "ratio of defect fractions" ;
        schema:value "2.8105" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-defect-fraction-in-curved-k-k-thr-vs-flat-k-k-thr-regions-of-the-curved-surface-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-defect-fraction-in-curved-k-k-thr-vs-flat-k-k-thr-regions-of-the-curved-surface-reference> a schema:PropertyValue ;
        dcterms:source "Null hypothesis (no curvature localisation); Bausch et al. (2003) Science 299:1716 predicts > 1 (disclinations/scars where K != 0)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-ecto-d2-n-crit-98-66-patterned-region-width-ratio-to-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ecto-D2 (n_crit = 98/66) patterned-region width ratio to control = 0.4987 ratio to control tract width" ;
        dcterms:description "Ecto-D2 37.4 grid (38 buds); MTX x0.8 density 0.749; MTX+Ecto-D2 0.264 (< each single treatment, Fig 5F)" ;
        schema:measurementTechnique "Dorsal-tract span when the critical density is raised to 98/66 of control (Ho Fig 5D)" ;
        schema:name "Ecto-D2 (n_crit = 98/66) patterned-region width ratio to control" ;
        schema:unitText "ratio to control tract width" ;
        schema:value "0.4987" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-equilateral-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equilateral hexagonal inter-row to intra-row spacing ratio Delta_x / lambda_y = 0.866 dimensionless ratio" ;
        dcterms:description "diagonal inter-row distance = 280.00 um == intra-row lambda_y = 280.00 um; WT model NN spacing CV = 0.0035" ;
        schema:measurementTechnique "Half-period phase-pinned row spacing ratio sqrt(3)/2 (Delta_x = 242.49 um for lambda_y = 280.0 um)" ;
        schema:name "equilateral hexagonal inter-row to intra-row spacing ratio Delta_x / lambda_y" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.866" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-equilateral-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-equilateral-hexagonal-inter-row-to-intra-row-spacing-ratio-delta-x-lambda-y-reference> a schema:PropertyValue ;
        dcterms:source "Lean Theorem 2 hexagonal_row_offset_equidistance; Ho et al. (2019) Fig 3B hexagonal lattice" ;
        schema:value "0.866" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-euler-gauss-bonnet-disclination-charge-sum-6-z-on-a-closed-convex-hull-triangulation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Euler / Gauss-Bonnet disclination charge sum(6 - z) on a closed convex-hull triangulation = 12.0 disclination charge (units of pi/3)" ;
        dcterms:description "n5 = 105, n6 = 136, n7 = 80: n5 - n7 = 25 (differs from 12 because random points also give z = 4 and z >= 8 vertices; the full charge sum(6 - z) is exactly 12)" ;
        schema:measurementTechnique "Convex hull of 400 random points on S^2: V - E + F = 2, 3F = 2E True, sum z = 2E True" ;
        schema:name "Euler / Gauss-Bonnet disclination charge sum(6 - z) on a closed convex-hull triangulation" ;
        schema:unitText "disclination charge (units of pi/3)" ;
        schema:value "12.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-euler-gauss-bonnet-disclination-charge-sum-6-z-on-a-closed-convex-hull-triangulation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-euler-gauss-bonnet-disclination-charge-sum-6-z-on-a-closed-convex-hull-triangulation-reference> a schema:PropertyValue ;
        dcterms:source "Lean Theorem 4 euler_disclination_charge (6 chi = sum (6 - z), chi(S^2) = 2); Bausch et al. (2003)" ;
        schema:value "12.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-fc-cheda1-n-crit-49-66-patterned-region-width-ratio-to-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fc-chEDA1 (n_crit = 49/66) patterned-region width ratio to control = 1.2507 ratio to control tract width" ;
        dcterms:description "widths: control 75.0, Fc-chEDA1 93.8 grid; direction matches the paper, magnitude depends on the un-digitised density gradient" ;
        schema:measurementTechnique "Dorsal-tract span of nucleated primordia when the EDA-set critical mesenchymal density is lowered to 49/66 of control (Ho Fig 5C)" ;
        schema:name "Fc-chEDA1 (n_crit = 49/66) patterned-region width ratio to control" ;
        schema:unitText "ratio to control tract width" ;
        schema:value "1.2507" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-isochrone-row-count-dislocation-lemma-violations-on-the-curved-dorsal-tract> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "isochrone row-count dislocation lemma violations on the curved dorsal tract = 0.0 violations" ;
        dcterms:description "flat control: 1 violations / 8 checked pairs" ;
        schema:measurementTechnique "For 6 successive dorsal isochrone pairs whose arc lengths differ by >= lambda_y, check that the longer carries >= 1 more primordium (12 rows)" ;
        schema:name "isochrone row-count dislocation lemma violations on the curved dorsal tract" ;
        schema:unitText "violations" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-isochrone-row-count-dislocation-lemma-violations-on-the-curved-dorsal-tract-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-isochrone-row-count-dislocation-lemma-violations-on-the-curved-dorsal-tract-reference> a schema:PropertyValue ;
        dcterms:source "Lean Theorem 5 isochrone_row_count_dislocation" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-limb-bud-height-sweep-5-7-dislocation-pairs-at-the-tallest-limb-buds> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "limb-bud height sweep: 5-7 dislocation pairs at the tallest limb buds = 10.0 dislocation pairs" ;
        dcterms:description "P_6 by height: A_l=0: P6=0.979, pairs=0, int|K|=0.00, A_l=15: P6=0.938, pairs=1, int|K|=3.25, A_l=30: P6=0.905, pairs=7, int|K|=10.68, A_l=45: P6=0.870, pairs=10, int|K|=17.90" ;
        schema:measurementTechnique "Count of adjacent interior 5- and 7-coordinated primordia for limb heights 0, 15, 30, 45" ;
        schema:name "limb-bud height sweep: 5-7 dislocation pairs at the tallest limb buds" ;
        schema:unitText "dislocation pairs" ;
        schema:value "10.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-limb-bud-height-sweep-5-7-dislocation-pairs-at-the-tallest-limb-buds-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-limb-bud-height-sweep-5-7-dislocation-pairs-at-the-tallest-limb-buds-reference> a schema:PropertyValue ;
        dcterms:source "Flat control (limb height 0) of the same sweep; curvature theory predicts monotone growth with int |K| dA" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-mtx-ecto-d2-co-treatment-width-relative-to-the-narrower-single-treatment> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "MTX + Ecto-D2 co-treatment width relative to the narrower single treatment = 0.5294 ratio" ;
        dcterms:description "value < 1 reproduces the reported ordering" ;
        schema:measurementTechnique "width(MTX + Ecto-D2) / min(width(MTX), width(Ecto-D2))" ;
        schema:name "MTX + Ecto-D2 co-treatment width relative to the narrower single treatment" ;
        schema:unitText "ratio" ;
        schema:value "0.5294" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-scaleless-fgf20-chi-0-and-latrunculin-chi-0-01-negative-control-bud-count> a schema:PropertyValue,

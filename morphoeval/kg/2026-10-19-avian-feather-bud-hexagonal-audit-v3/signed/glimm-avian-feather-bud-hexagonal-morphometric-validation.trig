    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-measurement-segmented-gallus-gallus-panel-b-specimen-interior-voronoi-hexagonal-fraction-p-6> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Gallus gallus Panel B specimen interior Voronoi hexagonal fraction P_6 = 0.75 fraction of interior Voronoi cells" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Ho et al. (2019) & Painter, Ho & Headon (2018) avian feather tracts on a curved trunk-and-limb surface: geodesic EDA competence wave, inhibitory-disk hexagonal packing, density-threshold tract boundaries and curvature-induced 5-7 dislocations — Source and data traceability: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Dataset `datasets/avian_feather_bud_hexagonal/` is SHA-256-pinned and verified at runtime (`EXPECTED_SHA256` L117-131, `verify_dataset_sha256` L143-155); all five DOIs (Ho 2019, Painter 2018, Michon 2008, Bailleul 2019, Bausch 2003) were Crossref-verified on 2026-10-20 and recorded in the bib, reference JSON, README and docstring; `--self-test` check 1 fails if the fabricated DOI reappears. Scored down from v2's 94 because Passes 1-2 (and audits v1-v2) cited a non-existent seed paper, a wrong Ho 2019 title, a wrong Michon 2008 venue/DOI and invented reference values; `scout_manifest.json` still carries the fabricated seed (left byte-identical to keep its pinned hash and is documented as superseded), and the script file name / sim_id still contain the \"glimm\" token." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/avian_feather_bud_hexagonal/scout_manifest.json L1–L58: Unchanged scout dossier still records the non-existent seed paper <https://github.com/fractastical/morpholib/blob/d58a084/datasets/avian_feather_bud_hexagonal/scout_manifest.json#L1-L58>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-source-traceability-2>,

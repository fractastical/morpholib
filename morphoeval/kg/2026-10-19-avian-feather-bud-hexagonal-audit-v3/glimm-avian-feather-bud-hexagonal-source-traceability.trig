            <https://doi.org/10.1242/dev.018341>,
            <https://doi.org/10.1371/journal.pbio.3000132>,
            <https://doi.org/10.1371/journal.pbio.3000448> .
    <https://doi.org/10.1016/j.jtbi.2017.10.026> dct:date "2018"^^xsd:gYear ;
        dct:title "A chemotaxis model of feather primordia pattern formation during avian development" .
    <https://doi.org/10.1126/science.1081160> dct:date "2003"^^xsd:gYear ;
        dct:title "Grain boundary scars and spherical crystallography" .
    <https://doi.org/10.1242/dev.018341> dct:date "2008"^^xsd:gYear ;
        dct:title "BMP2 and BMP7 play antagonistic roles in feather induction" .
    <https://doi.org/10.1371/journal.pbio.3000132> dct:date "2019"^^xsd:gYear ;
        dct:title "Feather arrays are patterned by interacting signalling and cell density waves" .
    <https://doi.org/10.1371/journal.pbio.3000448> dct:date "2019"^^xsd:gYear ;
        dct:title "Symmetry breaking in the embryonic skin triggers directional and sequential plumage patterning" .

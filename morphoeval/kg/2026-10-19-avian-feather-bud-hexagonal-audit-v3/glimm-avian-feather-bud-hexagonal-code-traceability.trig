sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-glimm-avian-feather-bud-hexagonal> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Ho et al. (2019) & Painter, Ho & Headon (2018) avian feather tracts on a curved trunk-and-limb surface: geodesic EDA competence wave, inhibitory-disk hexagonal packing, density-threshold tract boundaries and curvature-induced 5-7 dislocations — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Module docstring (L1-87) maps every section to Painter 2018 / Ho 2019 figures and to Lean Theorems 1-6; section banners and function docstrings cite the specific figure or theorem they implement; `morphoeval/math_kg_loops/glimm-avian-feather-bud-hexagonal.yaml` registers six laws with updated `code_locus` and `lean_locus` spans and a `provenance_note`. The GIF / PNG panel titles cite the Ho 2019 figure they emulate. Minor deduction retained for the misleading historical file name." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2018-glimm-avian-feather-bud-hexagonal.py L1–L87" ;
        dct:description "Docstring: governing equations, surface formulation, phenotype table, Lean theorem map, provenance correction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2018-glimm-avian-feather-bud-hexagonal.py#L1-L87> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/glimm-avian-feather-bud-hexagonal.yaml L1–L182" ;
        dct:description "Six law entries with lean_theorem / lean_locus / code_locus pins" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/glimm-avian-feather-bud-hexagonal.yaml#L1-L182> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-glimm-avian-feather-bud-hexagonal-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_019_avian_feather_bud_hexagonal.lean L105–L184" ;

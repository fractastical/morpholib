    <https://doi.org/10.1073/pnas.0803578105> dct:date "2008"^^xsd:gYear ;
        dct:title "The direction of gut looping is established by changes in the extracellular matrix and in cell orientation" .
    <https://doi.org/10.1073/pnas.1618677114> dct:date "2017"^^xsd:gYear ;
        dct:title "BMP signaling controls buckling forces to modulate looping morphogenesis of the gut" .
}


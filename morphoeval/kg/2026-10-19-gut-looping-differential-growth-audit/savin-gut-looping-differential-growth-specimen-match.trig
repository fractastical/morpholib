sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/gut_looping_differential_growth/intestine_mesentery_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or plots the biological specimen image, and compares only against Chick E8-E16 tabular values without cross-species data from Zebra finch, Quail, and Mouse." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2011-savin-gut-looping-differential-growth.py L68–L92: Evaluates only Chick E8-E16 tabular points without loading or segmenting intestine_mesentery_specimen.jpg <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L68-L92>",
            "docs/media/gut_looping_differential_growth_comparison.png (generated output, not in repo): 4-panel v1 plot lacks biological specimen segmentation and 4-species collapse panels — docs/media/gut_looping_differential_growth_comparison.png: rendered output of 2011-savin-gut-looping-differential-growth.py at 8871db0, image/png, 242127 B, 1413×1054 px, artifact_sha256 a509fa903edf6a286172076d79d801863c3bac04a90bdbc10f3298cd0a884e04 (sha256 a509fa903edf6a286172076d79d801863c3bac04a90bdbc10f3298cd0a884e04), spec_fingerprint 643f6989deff1f1d47f576fe1e43c257f747c5e39321e10638b972d0ac0dc491" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


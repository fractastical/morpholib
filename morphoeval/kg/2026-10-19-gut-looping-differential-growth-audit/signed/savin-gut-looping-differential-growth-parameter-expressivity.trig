sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Parameter expressivity: 48/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 5 embryonic stages of Chick (E8-E16) across differential strain epsilon in [1.26, 3.72] (L68-92), but lacks the 14-point 4-species morphospace sweep (Zebra finch, Quail, Chick, Mouse), omits Nerurkar et al. (2017) BMP2 and Noggin perturbations plus surgical mesentery ablation (epsilon = 0), and exposes no CLI parameters for epsilon, E_t/E_m, R_t, h_m, or seed (L250-256)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2011-savin-gut-looping-differential-growth.py L250–L256: CLI exposes only --self-test and --skip-gif without physical parameter overrides <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L250-L256>" ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


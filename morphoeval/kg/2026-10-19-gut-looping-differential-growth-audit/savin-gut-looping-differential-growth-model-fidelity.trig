        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-savin-gut-looping-differential-growth> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Savin et al. (2011) Kirchhoff elastic rod + stretched neo-Hookean dorsal mesentery gut looping morphogenesis — Model fidelity to source: 58/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes the exact annular second moment of area I_t = (pi/4)*(R_t^4 - R_i^4) and cube-root scaling length ell_* = (E_t*I_t / (E_m*h_m))^(1/3) (L35-43), backed by 3 Lean 4 theorems in `Loop_062_gut_looping_differential_growth.lean`. However, `generate_parametric_gut_curve` (L46-65) prescribes a hardcoded 3D sinusoid rather than minimizing the coupled Kirchhoff rod bending + axial stretching + neo-Hookean mesenteric traction energy functional, and no negative ablation control (surgical mesentery dissection / epsilon = 0) is simulated." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2011-savin-gut-looping-differential-growth.py L46–L65: Parametric sinusoidal curve instead of discrete Kirchhoff rod + neo-Hookean mesentery energy minimization <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L46-L65>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-savin-gut-looping-differential-growth-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2011-savin-gut-looping-differential-growth.py L35–L43" ;
        dct:description "Exact annular moment of inertia I_t and Savin et al. (2011) cube-root characteristic length ell_*" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2011-savin-gut-looping-differential-growth.py#L35-L43> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 062 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


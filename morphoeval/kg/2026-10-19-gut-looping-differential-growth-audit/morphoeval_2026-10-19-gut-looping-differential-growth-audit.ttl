        <https://w3id.org/probknow/resource/assessment/morphoeval-savin-gut-looping-differential-growth-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-gut-looping-differential-growth-audit-savin-gut-looping-differential-growth-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-gut-looping-differential-growth-audit-savin-gut-looping-differential-growth-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-gut-looping-differential-growth-audit-savin-gut-looping-differential-growth-3> ;
    pk:hypothesisType "Kirchhoff Elastic Rod & Stretched Neo-Hookean Dorsal Mesentery Differential-Growth Buckling" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-model-fidelity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Model fidelity to source: 50/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Explicitly documents in its header scope statement that the full texts of Cervera, Levin & Mafe (2021) and Cervera et al. (2020) were not accessible and that the 1D reaction-diffusion solver (rd_antagonistic_1d and rd_linear_1d) and rusty-matter 2-node ODE port are qualitative analogues. At commit 5659d5e, f2 and f3 both drive distinct 1D boundary-value solvers, and the inverse threshold finder f2_for_shift() bisects on the unclipped wavefront x*(f2) = x*_b (recovering f2_b = 0.422 where x*(f2_b) = 0.5833). Held at 50 because the equations and constants are local constructions rather than verified transcriptions of the 2021/2020 papers, rd_antagonistic_1d's docstring (line 231) still claims to implement the paper's equations, and m3 (f3) is not coupled to any morphological boundary." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-2> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L27–L47" ;
        dct:description "explicit scope statement disclaiming equation-level fidelity to the inaccessible 2021/2020 full papers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L27-L47> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L213–L359" ;
        dct:description "rd_antagonistic_1d(), rd_linear_1d(), wavefront_for_f2(), and unclipped f2_for_shift()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L213-L359> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


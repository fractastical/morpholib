sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-specimen-match-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-specimen-match-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Morphological realism / specimen match: 86/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Reconstructs the five wild-type benchmark limbs from Lobo et al. (2014b) Fig. 1 A''-E'' (Ambystoma mexicanum, Xenopus laevis, Uca pugilator, Gryllus bimaculatus, Heteropoda venatoria), all 14 wild-type species in LimbformDB 2.1.0, and 15 experimental surgical/transgenic phenotypes (ectopic grafts, supernumerary hands, hip-rotation duplications, and retinoic-acid proximalisation) with matching segment topology, digit counts, and colour coding. Note: comparison is to the source paper's formalism cartoons rather than photographs of biological limbs." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-specimen-match-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L627–L738" ;
        dct:description "make_wildtype_gallery(), make_experimental_gallery(), and make_animation()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L627-L738> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "limbform_wildtype_gallery.png (generated output)" ;
        dct:description "14 wild-type limb morphologies rendered with Fig. 1 A''-E'' highlighted — limbform_wildtype_gallery.png: rendered output of 2014-lobo-limbform-morphology.py at 5659d5e, image/png, 620043 B, 2400×1875 px, artifact_sha256 d561f4aab10756976c3fd5caf7a8c516da13c1cd9395d6cb5a54b8a2f5b10236 (sha256 d561f4aab10756976c3fd5caf7a8c516da13c1cd9395d6cb5a54b8a2f5b10236)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/limbform_morphospace_timeline.gif (generated output)" ;
        dct:description "animated timeline and experimental regeneration outcomes from LimbformDB — docs/media/limbform_morphospace_timeline.gif: rendered output of 2014-lobo-limbform-morphology.py at 5659d5e, image/gif, 2172060 B, 720×405 px, 66 frames, artifact_sha256 1997a7a304d4f6f3fb34e66dc598a2c601ba930391dfb0c674d73f9d2671b242 (sha256 1997a7a304d4f6f3fb34e66dc598a2c601ba930391dfb0c674d73f9d2671b242)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582>,
            <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
    <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> dct:title "LimbformDB 2.1.0 (31 Jul 2014), the Limbform database file" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chindapol-coral-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chindapol-coral-flow-specimen-match-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-chindapol-coral-flow-specimen-match-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — Morphological realism / specimen match: 42/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Renders five 2D dendritic lattice clusters (700 particles each) that transition from radially symmetric branching at drift=0.00 to upstream-skewed, compactified forms at drift=0.22. However, the 1-pixel-wide jagged 2D DLA trees lack the smooth, thick, club-shaped 3D branches of Pocillopora verrucosa and no CT scans or figures from Chindapol et al. (2013) are overlaid." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chindapol-coral-flow-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chindapol-coral-flow-specimen-match-2> ;
        pk:hasScore "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chindapol-coral-flow-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2013-chindapol-coral-flow.py L186–L231" ;
        dct:description "five drift regimes rendered in panels (a)-(c)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2013-chindapol-coral-flow.py#L186-L231> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-chindapol-coral-flow-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/chindapol_coral_flow_growth.gif (generated output)" ;
        dct:description "animated 2D DLA growth across three flow regimes — docs/media/chindapol_coral_flow_growth.gif: rendered output of 2013-chindapol-coral-flow.py at 5659d5e, image/gif, 737329 B, 720×288 px, 48 frames, artifact_sha256 30eaa02efc49579c08d71254de928be3a6e626a25e19cea1b4b36b39478e3442 (sha256 30eaa02efc49579c08d71254de928be3a6e626a25e19cea1b4b36b39478e3442)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


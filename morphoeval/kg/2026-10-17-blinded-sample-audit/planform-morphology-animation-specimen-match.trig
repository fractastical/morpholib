sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-planform-morphology-animation-specimen-match-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-planform-morphology-animation-specimen-match-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Produces clean, immediately distinguishable Planform cartoon renderings across wild type (#1), double-head (#2, #24), headless (#20), cyclops (#14), lateral/ectopic heads (#71, #133), and multi-head phenotypes, matching the colour gradients and internal organ symbols (eyes, brain lobes, ventral nerve cords, pharynx) of Lobo et al. (2013) Fig. 1D. Deducts 26 points because the database encodes only coarse polar radii (3 per head), so species-specific triangular cephalic lobes, auricles, and pigmentation of real S. mediterranea or D. japonica specimens are absent and no worm photographs are compared in this script." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-specimen-match-3> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L492–L542" ;
        dct:description "draw_morphology() renders region gradients, borders, eyes, brain, VNC, and pharynx" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L492-L542> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "planform_morphology_gallery.png (generated output)" ;
        dct:description "16 canonical PlanformDB phenotypes rendered at shared scale — planform_morphology_gallery.png: rendered output of 2013-lobo-planform-morphology.py at 5659d5e, image/png, 443915 B, 1920×2160 px, artifact_sha256 77a7dfa087bf89441dc35c64bc0c96bccfdc15d44a3d600df766fb723a87ace5 (sha256 77a7dfa087bf89441dc35c64bc0c96bccfdc15d44a3d600df766fb723a87ace5)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "planform_morphospace_timeline.gif (generated output)" ;
        dct:description "animated historical timeline and 359-morphology overview grid — planform_morphospace_timeline.gif: rendered output of 2013-lobo-planform-morphology.py at 5659d5e, image/gif, 3265519 B, 1500×780 px, 63 frames, artifact_sha256 f7c8cadf3c06c8351a49b6a47e1fc73fafafa7b430841771c14806fe54ce92a4 (sha256 f7c8cadf3c06c8351a49b6a47e1fc73fafafa7b430841771c14806fe54ce92a4)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400> .
    <https://doi.org/10.1016/j.bpj.2017.04.011> dct:date "2017"^^xsd:gYear ;
        dct:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .
    <https://doi.org/10.1093/bioinformatics/btt088> dct:date "2013"^^xsd:gYear ;
        dct:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .
    <https://doi.org/10.1242/bio.20123400> dct:date "2013"^^xsd:gYear ;
        dct:title "Towards a bioinformatics of patterning: a computational approach to understanding regulative morphogenesis" .
}


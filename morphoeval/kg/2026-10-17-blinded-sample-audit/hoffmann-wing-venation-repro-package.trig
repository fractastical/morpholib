@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-repro-package-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-repro-package-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Reproducibility package: 80/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Deterministic RNG seeding (np.random.default_rng(seed) with seed=0), CLI flags (--output, --downsample, --gif, --no-show), automatic caching in .wing_cache/, and pinned dependencies (including scikit-image and Pillow) in requirements.txt and requirements.lock.txt. Deducts 20 points because fetch_wing_png() lacks a SHA-256 check on the remote archive and the module docstring on lines 39-40 still states that scikit-image and Pillow are not in requirements.txt." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-repro-package-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L39–L40" ;
        dct:description "stale docstring note on scikit-image/Pillow" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L39-L40> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L383–L399" ;
        dct:description "CLI argument parser" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L383-L399> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L35" ;
        dct:description "pinned dependency lockfile" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


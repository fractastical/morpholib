@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-hoffmann-wing-venation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Reproducibility package: 80/100" ;
        rdfs:comment "Deterministic RNG seeding (np.random.default_rng(seed) with seed=0), CLI flags (--output, --downsample, --gif, --no-show), automatic caching in .wing_cache/, and pinned dependencies (including scikit-image and Pillow) in requirements.txt and requirements.lock.txt. Deducts 20 points because fetch_wing_png() lacks a SHA-256 check on the remote archive and the module docstring on lines 39-40 still states that scikit-image and Pillow are not in requirements.txt. Evidence: 2018-hoffmann-wing-venation.py L39–L40: stale docstring note on scikit-image/Pillow <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L39-L40>; 2018-hoffmann-wing-venation.py L383–L399: CLI argument parser <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L383-L399>; requirements.lock.txt L1–L35: pinned dependency lockfile <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-repro-package> ;
        pk:hasProbability "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-repro-package> rdfs:label "Hoffmann-Donoughe insect wing venation (2018-hoffmann-wing-venation.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Dragonfly Arigomphus villosipes (hindwing)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


        rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA6svHudOcFjOo5Vr5kSCv1kVitLgngsx3xNQBeY_0bUg> ;

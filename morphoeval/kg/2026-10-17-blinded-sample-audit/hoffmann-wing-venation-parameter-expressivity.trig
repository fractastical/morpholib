        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-parameter-expressivity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-parameter-expressivity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Parameter expressivity: 68/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Exposes n_iter, seed, and downsample parameters and animates the full iteration-by-iteration equilibration trajectory (iterations 0..18) along with a live circularity trajectory in make_gif() (docs/media/hoffmann_wing_lloyd.gif), though the static figure make_figure() plots only the final n_iter=18 state and does not vary inhibition-density scaling parameters." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-parameter-expressivity-3> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L271–L271" ;
        dct:description "make_figure() evaluates only n_iter=18" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L271-L271> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L346–L380" ;
        dct:description "make_gif() animates iterations 0..18 and plots mean circularity vs iteration" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L346-L380> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/hoffmann_wing_lloyd.gif (generated output)" ;
        dct:description "animated Lloyd equilibration trajectory — docs/media/hoffmann_wing_lloyd.gif: rendered output of 2018-hoffmann-wing-venation.py at 5659d5e, image/gif, 901133 B, 720×403 px, 19 frames, artifact_sha256 e53e2133c7bebee17e6ac3cab339c9931048bc2f38559d19ab3c98f90ca8260c (sha256 e53e2133c7bebee17e6ac3cab339c9931048bc2f38559d19ab3c98f90ca8260c)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-parameter-expressivity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-parameter-expressivity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Parameter expressivity: 84/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Exercises the full discrete and continuous variation stored in LimbformDB 2.1.0 across 555 geometric morphologies spanning 6 taxonomic classes, 14 species, 12 anatomical segment types, multi-joint branching, ectopic LinkSubJoint grafts, and 0-12 digits. Deducts 16 points because the unused Link.reversed / Link.inverted / Digit.reversed flags leave surgical handedness inversions unexpressed in the rendered geometry." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-parameter-expressivity-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L222–L268" ;
        dct:description "load_morphologies() loads all 565 morphologies (555 with geometry) across 14 taxa" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L222-L268> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L656–L676" ;
        dct:description "15 curated experimental phenotypes spanning amputations, grafts, and duplications" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L656-L676> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582>,
            <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
    <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> dct:title "LimbformDB 2.1.0 (31 Jul 2014), the Limbform database file" .
}


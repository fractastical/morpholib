@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-lobo-limbform-morphology-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Parameter expressivity: 84/100" ;
        rdfs:comment "Exercises the full discrete and continuous variation stored in LimbformDB 2.1.0 across 555 geometric morphologies spanning 6 taxonomic classes, 14 species, 12 anatomical segment types, multi-joint branching, ectopic LinkSubJoint grafts, and 0-12 digits. Deducts 16 points because the unused Link.reversed / Link.inverted / Digit.reversed flags leave surgical handedness inversions unexpressed in the rendered geometry. Evidence: 2014-lobo-limbform-morphology.py L222–L268: load_morphologies() loads all 565 morphologies (555 with geometry) across 14 taxa <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L222-L268>; 2014-lobo-limbform-morphology.py L656–L676: 15 curated experimental phenotypes spanning amputations, grafts, and duplications <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L656-L676>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-parameter-expressivity> ;
        pk:hasProbability "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-parameter-expressivity> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dct:identifier "morphoeval/0.1.0/parameter-expressivity" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
}


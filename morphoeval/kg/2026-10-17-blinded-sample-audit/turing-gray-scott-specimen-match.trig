sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-specimen-match-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-specimen-match-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Morphological realism / specimen match: 50/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Generic mathematical pattern generator not tied to a specific biological organism; marked not_applicable per the rubric. Note: the script writes turing_patterns_black_neon.gif (custom black-to-neon-blue colormap, axes off), which does not match the committed docs/media/turing_gray_scott.gif (Viridis-like colormap with visible 0-200 axis ticks)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-specimen-match-2> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "not applicable (neutral baseline)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L42–L75" ;
        dct:description "custom black_neon colormap and save('turing_patterns_black_neon.gif')" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L42-L75> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "turing_patterns.gif (generated output)" ;
        dct:description "inspected output animation — turing_patterns.gif: rendered output of 1952-turing-morpho.py at 5659d5e, image/gif, 14075347 B, 1280×960 px, 500 frames, artifact_sha256 0ddf48cbca6cf3df80bf611fded797346cb34d93a3308897ed7d2f2005c20c84 (sha256 0ddf48cbca6cf3df80bf611fded797346cb34d93a3308897ed7d2f2005c20c84)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


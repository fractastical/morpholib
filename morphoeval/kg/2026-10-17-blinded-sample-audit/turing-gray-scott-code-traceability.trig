sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-turing-gray-scott-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Code-to-model traceability: 30/100" ;
        rdfs:comment "Variable names (Du, Dv, f, k, U, V) are recognisable, but there are no docstrings or equation numbers and the inline comments on lines 36-39 misdescribe the Gray-Scott reaction kinetics. Evidence: 1952-turing-morpho.py L31–L40: update() with misleading inline comments on U and V reaction terms <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L31-L40>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-code-traceability> ;
        pk:hasProbability "0.3"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-code-traceability> rdfs:label "Gray-Scott reaction-diffusion patterns (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Generic (Turing pattern formation)" ;
        dct:identifier "morphoeval/0.1.0/code-traceability" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.261.5118.189> dct:date "1993"^^xsd:gYear ;
        dct:title "Complex patterns in a simple system" .
}


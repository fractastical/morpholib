sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-eshghi-odonata-wing-cells-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Reproducibility package: 90/100" ;
        rdfs:comment "Fully deterministic pipeline (no stochastic steps), SHA-256-verified auto-download and local caching (.odonata_cache/), vendored summary tables in datasets/odonata/, and pinned environment in requirements.txt / requirements.lock.txt. Deducts 10 points because running the script requires downloading ~95 MB of external archives on a cold cache and overwrites the tracked file datasets/odonata/fossil_wing_resegmentation.csv in place without CLI flags. Evidence: 2026-eshghi-odonata-wing-cells.py L75–L86: _fetch() automatic download and SHA-256 digest check <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L75-L86>; 2026-eshghi-odonata-wing-cells.py L447–L452: resegment_all_fossils() writes directly to tracked CSV path <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L447-L452>; requirements.lock.txt L1–L35: pinned dependency lockfile <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-repro-package> ;
        pk:hasProbability "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-repro-package> rdfs:label "Odonata wing cells through deep time (2026-eshghi-odonata-wing-cells.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Odonata (fossil Late Jurassic-Eocene; extant Anisoptera and Zygoptera)" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


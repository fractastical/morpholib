sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-raup-shell-coiling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Reproducibility package: 95/100" ;
        rdfs:comment "Completely deterministic mathematical surface generation, zero external network dependencies, automated self_test() gate executed before rendering, and pinned dependencies in requirements.txt / requirements.lock.txt. Evidence: create_raup_animations.py L443–L459: main() runs self_test() and generates all four outputs deterministically <https://github.com/fractastical/morpholib/blob/5659d5e/create_raup_animations.py#L443-L459>; requirements.lock.txt L1–L35: pinned environment lockfile <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-repro-package> ;
        pk:hasProbability "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-repro-package> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens)" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


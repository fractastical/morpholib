sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-cervera-levin-mafe-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Model fidelity to source: 50/100" ;
        rdfs:comment "Explicitly documents in its header scope statement that the full texts of Cervera, Levin & Mafe (2021) and Cervera et al. (2020) were not accessible and that the 1D reaction-diffusion solver (rd_antagonistic_1d and rd_linear_1d) and rusty-matter 2-node ODE port are qualitative analogues. At commit 5659d5e, f2 and f3 both drive distinct 1D boundary-value solvers, and the inverse threshold finder f2_for_shift() bisects on the unclipped wavefront x*(f2) = x*_b (recovering f2_b = 0.422 where x*(f2_b) = 0.5833). Held at 50 because the equations and constants are local constructions rather than verified transcriptions of the 2021/2020 papers, rd_antagonistic_1d's docstring (line 231) still claims to implement the paper's equations, and m3 (f3) is not coupled to any morphological boundary. Evidence: 2021-Cervera–Levin–Mafe.py L27–L47: explicit scope statement disclaiming equation-level fidelity to the inaccessible 2021/2020 full papers <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L27-L47>; 2021-Cervera–Levin–Mafe.py L213–L359: rd_antagonistic_1d(), rd_linear_1d(), wavefront_for_f2(), and unclipped f2_for_shift() <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L213-L359>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-model-fidelity> ;
        pk:hasProbability "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-model-fidelity> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


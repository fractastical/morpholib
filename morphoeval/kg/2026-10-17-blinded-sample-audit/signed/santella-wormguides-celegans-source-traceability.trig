sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> .

    <https://doi.org/10.1016/0012-1606(83)90201-4> dcterms:date "1983"^^xsd:gYear ;
        dcterms:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .

    <https://doi.org/10.1038/s41586-019-1352-7> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .

    <https://doi.org/10.1083/jcb.144.5.927> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .

    <https://doi.org/10.1098/rstb.2017.0382> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .

    <https://doi.org/10.1186/s12859-015-0627-8> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-santella-wormguides-celegans-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Source and data traceability: 92/100" ;
        rdfs:comment "Pins both upstream repositories (zhirongbaolab/WormGUIDES at commit 17be611f and openworm/c302 at commit f54d92d7), verifies all 429 fetched files against SHA-256 digests in datasets/celegans/pinned_inputs.sha256 on every run, and cites DOIs for Santella et al. (2015), Sarma et al. (2018), Cook et al. (2019), Sulston et al. (1983), and Gönczy et al. (1999). Evidence: 2015-santella-wormguides-celegans.py L24–L49: source citations, commits, and licenses <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L24-L49>; 2015-santella-wormguides-celegans.py L90–L199: pinned commit constants and fetch_inputs() SHA-256 manifest verification <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L90-L199>; datasets/celegans/pinned_inputs.sha256 L1–L30: 429-file SHA-256 manifest <https://github.com/fractastical/morpholib/blob/5659d5e/datasets/celegans/pinned_inputs.sha256#L1-L30>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-source-traceability> ;
        pk:hasProbability "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-source-traceability> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome (2015-santella-wormguides-celegans.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


    <https://doi.org/10.1111/evo.13755> dcterms:date "1873"^^xsd:gYear ;
        dcterms:title "The influence of size on body shape diversification across Indo-Pacific shore fishes" .

    <https://doi.org/10.1371/journal.pone.0112732> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "A morphospace for reef fishes: elongation is the dominant axis of body shape evolution" .

    <https://doi.org/10.5061/dryad.fn457gr> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "Data from: The influence of size on body shape diversification across Indo-Pacific shore fishes" .


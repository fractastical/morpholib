}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-turing-gray-scott-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Morphological realism / specimen match: 50/100" ;
        rdfs:comment "Generic mathematical pattern generator not tied to a specific biological organism; marked not_applicable per the rubric. Note: the script writes turing_patterns_black_neon.gif (custom black-to-neon-blue colormap, axes off), which does not match the committed docs/media/turing_gray_scott.gif (Viridis-like colormap with visible 0-200 axis ticks). Evidence: 1952-turing-morpho.py L42–L75: custom black_neon colormap and save('turing_patterns_black_neon.gif') <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L42-L75>; turing_patterns.gif (generated output, not in repo): inspected output animation — turing_patterns.gif: rendered output of 1952-turing-morpho.py at 5659d5e, image/gif, 14075347 B, 1280×960 px, 500 frames, sha256 0ddf48cbca6cf3df80bf611fded797346cb34d93a3308897ed7d2f2005c20c84." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-specimen-match> ;
        pk:hasProbability "0.5"^^xsd:double ;
        pk:hasVerdict "not applicable (neutral baseline)" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-specimen-match> rdfs:label "Gray-Scott reaction-diffusion patterns (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Generic (Turing pattern formation)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


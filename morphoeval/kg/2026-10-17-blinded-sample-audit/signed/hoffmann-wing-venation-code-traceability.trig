sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-hoffmann-wing-venation-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Code-to-model traceability: 78/100" ;
        rdfs:comment "Module docstring clearly maps the 5-step pipeline to SI sections 3.3-3.4 and explains where the implementation simplifies the paper's thickness-based density estimate, though individual helper functions do not cite equation or figure numbers. Evidence: 2018-hoffmann-wing-venation.py L12–L34: 5-step correspondence to SI 3.3-3.4 <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L12-L34>; 2018-hoffmann-wing-venation.py L164–L195: model_wing() inline comments <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L164-L195>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-code-traceability> ;
        pk:hasProbability "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-code-traceability> rdfs:label "Hoffmann-Donoughe insect wing venation (2018-hoffmann-wing-venation.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Dragonfly Arigomphus villosipes (hindwing)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


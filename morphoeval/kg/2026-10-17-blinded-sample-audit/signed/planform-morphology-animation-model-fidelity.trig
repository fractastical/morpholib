sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-planform-morphology-animation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Model fidelity to source: 86/100" ;
        rdfs:comment "Decodes PlanformDB 2.5.0's relational tables (Morphology, Region, RegionParam, RegionsLink, Organ, OrganPoint) using the formalism's exact link-degree radius rule (0 links -> 4 cardinal radii; 1 link -> +90/+180/+270 deg; k >= 2 links -> k bisector radii), places region centres from Dist/Ang and shared borders at Ratio*Dist, and verifies in check_encoding() that 1,181/1,181 regions obey the rule. Deducts 14 points because consecutive control radii are connected by a heuristic superellipse arc (N_FREE=2.2, N_BORDER=7.0) tuned to resemble Fig. 1D rather than a closed-form curve equation published in the paper. Evidence: 2013-lobo-planform-morphology.py L279–L391: layout(), control_points(), and region_outline() implementing the graph-to-outline decoder <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L279-L391>; 2013-lobo-planform-morphology.py L733–L747: check_encoding() verifies 1,181/1,181 regions obey the 0->4 / 1->3 / k->k rule <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L733-L747>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-model-fidelity> ;
        pk:hasProbability "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-model-fidelity> rdfs:label "PlanformDB planarian morphology animation (2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Planaria (Schmidtea mediterranea, Dugesia japonica)" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


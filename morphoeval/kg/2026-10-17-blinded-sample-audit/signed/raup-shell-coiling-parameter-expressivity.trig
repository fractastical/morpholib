sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-raup-shell-coiling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Parameter expressivity: 78/100" ;
        rdfs:comment "Covers wide ranges of W (1.6 to 10.0), D (0.02 to 0.55), and T (0.0 to 4.2) across the 6-panel comparison and 120-frame morphing animation. Deducts 22 points because S is held constant at 1.0 in every rendered figure and JSON preset, and create_parameter_space_visualization() zips three values of W with three values of D (and W with T) along a 1D diagonal (3 panels per row) rather than sampling a 2D (W, D) or (W, T) morphospace grid. Evidence: create_raup_animations.py L289–L344: create_parameter_space_visualization() zips 3 (W, D) and 3 (W, T) pairs with S=1.0 <https://github.com/fractastical/morpholib/blob/5659d5e/create_raup_animations.py#L289-L344>; datasets/raup/variables.json L30–L85: all six parameter sets set S = 1.0 <https://github.com/fractastical/morpholib/blob/5659d5e/datasets/raup/variables.json#L30-L85>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-parameter-expressivity> ;
        pk:hasProbability "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-parameter-expressivity> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens)" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-raup-shell-coiling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Code-to-model traceability: 78/100" ;
        rdfs:comment "create_raup_animations.py clearly maps variables (theta, phi, a, rc, zc, r, z) to Noshita (2014) and Okabe & Yoshimura (2017). Deducts 22 points because the companion script 1966-raup.py lacks citations, docstrings, and uses a divergent formula for rc without explanation. Evidence: create_raup_animations.py L85–L131: documented raup_shell() implementation <https://github.com/fractastical/morpholib/blob/5659d5e/create_raup_animations.py#L85-L131>; 1966-raup.py L1–L56: undocumented companion script with divergent rc formula <https://github.com/fractastical/morpholib/blob/5659d5e/1966-raup.py#L1-L56>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-code-traceability> ;
        pk:hasProbability "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-code-traceability> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


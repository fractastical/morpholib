sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-chindapol-coral-flow-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — MorphoEval overall 56.0/100" ;
        rdfs:comment "Blinded second-assessor pass (gemini-4-argon). Replaces Chindapol et al.'s (2013) 3D COMSOL Navier-Stokes + advection-diffusion accretive growth model of Pocillopora verrucosa with a declared 2D lattice diffusion-limited aggregation (DLA) random walk with horizontal drift, reproducing qualitative upstream-bending and compactification trends across five drift values. Overall 56.0/100 (faithfulness 46.4, reproducibility 78.3; model-implementation 49.3/100, biological-validation 44.2/100, applicable-only overall 56.0/100; uncalibrated rubric score, not a calibrated probability); rubric morphoeval 0.1.0; checkpoint commit 5659d5e; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0. Dimension assessments: Model fidelity to source 38, Morphological realism / specimen match 42, Parameter expressivity 72, Morphometric validation 48, Source and data traceability 82, Code-to-model traceability 68, Reproducibility package 82. Output judged: chindapol_coral_flow_morphospace.png: rendered output of 2013-chindapol-coral-flow.py at 5659d5e, image/png, 235376 B, 1726×1231 px, sha256 c431f9a5ae368f84965ccd6e8762c61c5db8f77323de69daab92a26de99e1626." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow> ;
        pk:hasProbability "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow> rdfs:label "Chindapol flow-driven coral growth faithfully reproduces Scleractinian coral Pocillopora verrucosa morphology" ;
        dcterms:identifier "morphoeval/0.1.0/overall" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


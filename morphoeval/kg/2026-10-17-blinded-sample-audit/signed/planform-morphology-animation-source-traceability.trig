sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400> .

    <https://doi.org/10.1016/j.bpj.2017.04.011> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .

    <https://doi.org/10.1093/bioinformatics/btt088> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .

    <https://doi.org/10.1242/bio.20123400> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Towards a bioinformatics of patterning: a computational approach to understanding regulative morphogenesis" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-planform-morphology-animation-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Source and data traceability: 85/100" ;
        rdfs:comment "Cites both primary papers (Lobo, Malone & Levin 2013 Biology Open, DOI 10.1242/bio.20123400; Bioinformatics, DOI 10.1093/bioinformatics/btt088) and pins planformDB_2.5.0.edb by exact SHA-256 digest (PLANFORM_DB_SHA256) in both the script and datasets/planform/planformDB.sha256. Deducts 15 points because the proprietary .edb file cannot be redistributed in the repository or auto-downloaded without user setup. Evidence: 2013-lobo-planform-morphology.py L10–L17: DOIs for both 2013 Planform papers <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L10-L17>; 2013-lobo-planform-morphology.py L147–L177: PLANFORM_DB_SHA256 and resolve_db_path() hash verification <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L147-L177>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-source-traceability> ;
        pk:hasProbability "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-source-traceability> rdfs:label "PlanformDB planarian morphology animation (2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Planaria (Schmidtea mediterranea, Dugesia japonica)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


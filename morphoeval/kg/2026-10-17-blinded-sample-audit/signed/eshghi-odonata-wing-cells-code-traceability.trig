sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-eshghi-odonata-wing-cells-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Code-to-model traceability: 88/100" ;
        rdfs:comment "Clear modular pipeline separating archive verification (_fetch), PBDB age lookup (pbdb_ages, AGE_OVERRIDES), raster scale-bar parsing (_read_drawing), morphological segmentation (segment_fossil_cells), convex-hull Feret caliper measurement (_max_feret), and figure generation. Evidence: 2026-eshghi-odonata-wing-cells.py L149–L224: AGE_OVERRIDES and pbdb_ages() with documented stratigraphic stage midpoints <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L149-L224>; 2026-eshghi-odonata-wing-cells.py L305–L419: documented 4-step segmentation and Feret diameter pipeline <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L305-L419>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-code-traceability> ;
        pk:hasProbability "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-code-traceability> rdfs:label "Odonata wing cells through deep time (2026-eshghi-odonata-wing-cells.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Odonata (fossil Late Jurassic-Eocene; extant Anisoptera and Zygoptera)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-source-traceability> rdfs:label "Chindapol flow-driven coral growth (2013-chindapol-coral-flow.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Scleractinian coral Pocillopora verrucosa" ;

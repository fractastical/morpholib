sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-santella-wormguides-celegans-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Morphological realism / specimen match: 74/100" ;
        rdfs:comment "Renders empirical 4D nuclear positions scaled to true micrometre dimensions inside the segmented eggshell outline across six canonical embryonic stages, 51 3D cell-surface meshes at frame 330, and the complete Sulston lineage tree. Deducts 26 points because no raw diSPIM fluorescence volume or DIC microscopy image is shown alongside the reconstructed nuclei, and the early frames (1-~250) in the source atlas share a static eggshell mesh that the anterior nuclei overrun by up to 19.0 atlas units. Evidence: 2015-santella-wormguides-celegans.py L433–L541: draw_lineage(), draw_shell(), draw_embryo(), and draw_meshes() <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L433-L541>; celegans_four_views.png (generated output, not in repo): four-panel view: Sulston lineage tree, six developmental stages inside eggshell, frame-330 meshes, and connectome — celegans_four_views.png: rendered output of 2015-santella-wormguides-celegans.py at 5659d5e, image/png, 424197 B, 2240×1680 px, sha256 eb4b60086280c9a1740358c26fc655598f25d2adad63a9fcdb9c3a7980cc3bd6; docs/media/celegans_embryo_timeline.gif (generated output, not in repo): animated 4D nuclear trajectory and lineage progression — docs/media/celegans_embryo_timeline.gif: rendered output of 2015-santella-wormguides-celegans.py at 5659d5e, image/gif, 2445902 B, 720×374 px, 60 frames, sha256 e8d760778e3dbd34fb0890761ce7c33dc63613fd567aa7ca2cb56416b14a186f." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-specimen-match> ;
        pk:hasProbability "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-specimen-match> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome (2015-santella-wormguides-celegans.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-lobo-limbform-morphology-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Morphological realism / specimen match: 86/100" ;
        rdfs:comment "Reconstructs the five wild-type benchmark limbs from Lobo et al. (2014b) Fig. 1 A''-E'' (Ambystoma mexicanum, Xenopus laevis, Uca pugilator, Gryllus bimaculatus, Heteropoda venatoria), all 14 wild-type species in LimbformDB 2.1.0, and 15 experimental surgical/transgenic phenotypes (ectopic grafts, supernumerary hands, hip-rotation duplications, and retinoic-acid proximalisation) with matching segment topology, digit counts, and colour coding. Note: comparison is to the source paper's formalism cartoons rather than photographs of biological limbs. Evidence: 2014-lobo-limbform-morphology.py L627–L738: make_wildtype_gallery(), make_experimental_gallery(), and make_animation() <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L627-L738>; limbform_wildtype_gallery.png (generated output, not in repo): 14 wild-type limb morphologies rendered with Fig. 1 A''-E'' highlighted — limbform_wildtype_gallery.png: rendered output of 2014-lobo-limbform-morphology.py at 5659d5e, image/png, 620043 B, 2400×1875 px, sha256 d561f4aab10756976c3fd5caf7a8c516da13c1cd9395d6cb5a54b8a2f5b10236; docs/media/limbform_morphospace_timeline.gif (generated output, not in repo): animated timeline and experimental regeneration outcomes from LimbformDB — docs/media/limbform_morphospace_timeline.gif: rendered output of 2014-lobo-limbform-morphology.py at 5659d5e, image/gif, 2172060 B, 720×405 px, 66 frames, sha256 1997a7a304d4f6f3fb34e66dc598a2c601ba930391dfb0c674d73f9d2671b242." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-specimen-match> ;
        pk:hasProbability "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-specimen-match> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-chindapol-coral-flow-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — Reproducibility package: 82/100" ;
        rdfs:comment "Deterministic per-regime RNG seeds (seed = 100 + i), self-contained numpy/scipy/matplotlib implementation with zero network dependencies, CLI arguments (--output, --particles, --gif, --no-show), and pinned dependencies in requirements.lock.txt. Evidence: 2013-chindapol-coral-flow.py L192–L193: deterministic seed=100+i per drift regime <https://github.com/fractastical/morpholib/blob/5659d5e/2013-chindapol-coral-flow.py#L192-L193>; 2013-chindapol-coral-flow.py L403–L419: CLI argument parser <https://github.com/fractastical/morpholib/blob/5659d5e/2013-chindapol-coral-flow.py#L403-L419>; requirements.lock.txt L1–L35: pinned environment lockfile <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-repro-package> ;
        pk:hasProbability "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-repro-package> rdfs:label "Chindapol flow-driven coral growth (2013-chindapol-coral-flow.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Scleractinian coral Pocillopora verrucosa" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}


sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400> .

    <https://doi.org/10.1016/j.bpj.2017.04.011> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .

    <https://doi.org/10.1093/bioinformatics/btt088> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .

    <https://doi.org/10.1242/bio.20123400> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Towards a bioinformatics of patterning: a computational approach to understanding regulative morphogenesis" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-planform-morphology-animation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Morphological realism / specimen match: 74/100" ;
        rdfs:comment "Produces clean, immediately distinguishable Planform cartoon renderings across wild type (#1), double-head (#2, #24), headless (#20), cyclops (#14), lateral/ectopic heads (#71, #133), and multi-head phenotypes, matching the colour gradients and internal organ symbols (eyes, brain lobes, ventral nerve cords, pharynx) of Lobo et al. (2013) Fig. 1D. Deducts 26 points because the database encodes only coarse polar radii (3 per head), so species-specific triangular cephalic lobes, auricles, and pigmentation of real S. mediterranea or D. japonica specimens are absent and no worm photographs are compared in this script. Evidence: 2013-lobo-planform-morphology.py L492–L542: draw_morphology() renders region gradients, borders, eyes, brain, VNC, and pharynx <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L492-L542>; planform_morphology_gallery.png (generated output, not in repo): 16 canonical PlanformDB phenotypes rendered at shared scale — planform_morphology_gallery.png: rendered output of 2013-lobo-planform-morphology.py at 5659d5e, image/png, 443915 B, 1920×2160 px, sha256 77a7dfa087bf89441dc35c64bc0c96bccfdc15d44a3d600df766fb723a87ace5; planform_morphospace_timeline.gif (generated output, not in repo): animated historical timeline and 359-morphology overview grid — planform_morphospace_timeline.gif: rendered output of 2013-lobo-planform-morphology.py at 5659d5e, image/gif, 3265519 B, 1500×780 px, 63 frames, sha256 f7c8cadf3c06c8351a49b6a47e1fc73fafafa7b430841771c14806fe54ce92a4." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-specimen-match> ;
        pk:hasProbability "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-planform-morphology-animation-specimen-match> rdfs:label "PlanformDB planarian morphology animation (2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Planaria (Schmidtea mediterranea, Dugesia japonica)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


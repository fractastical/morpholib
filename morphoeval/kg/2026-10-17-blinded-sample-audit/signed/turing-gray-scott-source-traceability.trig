sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-turing-gray-scott-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Source and data traceability: 15/100" ;
        rdfs:comment "No module docstring, no bibliographic references, no DOIs for Turing (1952), Gray & Scott (1984), or Pearson (1993), and no provenance for the chosen parameter values; only the filename and plot title ('Turing Patterns (Gray-Scott Model)') name the model. Evidence: 1952-turing-morpho.py L1–L13: no docstring or literature citations <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L1-L13>; 1952-turing-morpho.py L74–L75: plot title is the sole textual reference <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L74-L75>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-source-traceability> ;
        pk:hasProbability "0.15"^^xsd:double ;
        pk:hasVerdict "not faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-source-traceability> rdfs:label "Gray-Scott reaction-diffusion patterns (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Generic (Turing pattern formation)" ;

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582> .

    <https://doi.org/10.1002/reg2.13> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .

    <https://doi.org/10.1093/bioinformatics/btu582> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-lobo-limbform-morphology-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Code-to-model traceability: 86/100" ;
        rdfs:comment "Cleanly maps SQLite tables (Morphology, Link, JointParam, LinkSubJoint, Digit) to Python dataclasses and geometric primitives, with detailed ASCII diagrams and docstrings explaining the cyclic bisector rule and sub-joint double-counting convention. Evidence: 2014-lobo-limbform-morphology.py L26–L49: header documentation mapping SQLite tables to geometric decoding rules <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L26-L49>; 2014-lobo-limbform-morphology.py L305–L355: _edges_of() and control_points() with inline geometric comments <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L305-L355>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-code-traceability> ;
        pk:hasProbability "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-code-traceability> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


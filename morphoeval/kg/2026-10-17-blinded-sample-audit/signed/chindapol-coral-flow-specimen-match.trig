sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1371/journal.pcbi.1002849> .

    <https://doi.org/10.1371/journal.pcbi.1002849> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Modelling Growth and Form of the Scleractinian Coral Pocillopora verrucosa and the Influence of Hydrodynamics" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-chindapol-coral-flow-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — Morphological realism / specimen match: 42/100" ;
        rdfs:comment "Renders five 2D dendritic lattice clusters (700 particles each) that transition from radially symmetric branching at drift=0.00 to upstream-skewed, compactified forms at drift=0.22. However, the 1-pixel-wide jagged 2D DLA trees lack the smooth, thick, club-shaped 3D branches of Pocillopora verrucosa and no CT scans or figures from Chindapol et al. (2013) are overlaid. Evidence: 2013-chindapol-coral-flow.py L186–L231: five drift regimes rendered in panels (a)-(c) <https://github.com/fractastical/morpholib/blob/5659d5e/2013-chindapol-coral-flow.py#L186-L231>; docs/media/chindapol_coral_flow_growth.gif (generated output, not in repo): animated 2D DLA growth across three flow regimes — docs/media/chindapol_coral_flow_growth.gif: rendered output of 2013-chindapol-coral-flow.py at 5659d5e, image/gif, 737329 B, 720×288 px, 48 frames, sha256 30eaa02efc49579c08d71254de928be3a6e626a25e19cea1b4b36b39478e3442." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-specimen-match> ;
        pk:hasProbability "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-specimen-match> rdfs:label "Chindapol flow-driven coral growth (2013-chindapol-coral-flow.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Scleractinian coral Pocillopora verrucosa" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


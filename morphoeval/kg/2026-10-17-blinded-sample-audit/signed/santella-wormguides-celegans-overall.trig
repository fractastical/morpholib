sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-santella-wormguides-celegans-overall> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — MorphoEval overall 78.7/100" ;
        rdfs:comment "Blinded second-assessor pass (gemini-4-argon). Decodes 360 frames of 3D nuclear coordinates and diameters from the WormGUIDES C. elegans embryogenesis atlas (Santella et al. 2015), verifies Sulston lineage naming and parent-before-child ordering across all 1,330 cells, calibrates spatial units against the frame-330 eggshell OBJ mesh (0.1649 um/unit), documents the static early shell mesh overrun, and pairs the developmental atlas with the OpenWorm c302 hermaphrodite connectome (300 neurons). Overall 78.7/100 (faithfulness 75.1, reproducibility 86.9; model-implementation 72.7/100, biological-validation 77.0/100, applicable-only overall 81.9/100; uncalibrated rubric score, not a calibrated probability); rubric morphoeval 0.1.0; checkpoint commit 5659d5e; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0. Dimension assessments: Model fidelity to source 84, Morphological realism / specimen match 74, Parameter expressivity 50, Morphometric validation 82, Source and data traceability 92, Code-to-model traceability 82, Reproducibility package 86. Output judged: celegans_four_views.png: rendered output of 2015-santella-wormguides-celegans.py at 5659d5e, image/png, 424197 B, 2240×1680 px, sha256 eb4b60086280c9a1740358c26fc655598f25d2adad63a9fcdb9c3a7980cc3bd6." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans> ;
        pk:hasProbability "0.787"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome faithfully reproduces Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416) morphology" ;
        dcterms:identifier "morphoeval/0.1.0/overall" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


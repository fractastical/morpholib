sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-lobo-limbform-morphology-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Reproducibility package: 88/100" ;
        rdfs:comment "Fully deterministic geometry decoding and rendering, automatic fallback download of LimbformDB 2.1.0 into .limbform_cache/, and pinned dependencies in requirements.txt / requirements.lock.txt. Deducts 12 points for the 65-character DB_SHA256 typo in resolve_db_path() and lack of CLI flags for output paths. Evidence: 2014-lobo-limbform-morphology.py L91–L134: resolve_db_path() auto-download and cache logic <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L91-L134>; requirements.lock.txt L1–L35: pinned environment lockfile <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-repro-package> ;
        pk:hasProbability "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-repro-package> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-eshghi-odonata-wing-cells-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Parameter expressivity: 50/100" ;
        rdfs:comment "Empirical macroevolutionary scaling and image-resegmentation pipeline operating on fixed museum and extant specimen archives rather than a parameterised generative model; marked not_applicable per the rubric. Evidence: 2026-eshghi-odonata-wing-cells.py L1–L45: docstring defines script as an empirical test of scaling predictions across 69 fossil and 394 extant wings <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L1-L45>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-parameter-expressivity> ;
        pk:hasProbability "0.5"^^xsd:double ;
        pk:hasVerdict "not applicable (neutral baseline)" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-parameter-expressivity> rdfs:label "Odonata wing cells through deep time (2026-eshghi-odonata-wing-cells.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Odonata (fossil Late Jurassic-Eocene; extant Anisoptera and Zygoptera)" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-chindapol-coral-flow-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — Parameter expressivity: 72/100" ;
        rdfs:comment "Sweeps five drift values (0.00, 0.04, 0.09, 0.15, 0.22) in the static morphospace figure and three regimes in the growth GIF, producing clear, monotonic shifts in upstream centre-of-mass displacement (cx - mean_x), radius of gyration (r_gyr), symmetry magnitude (smmag), and mean resultant branch vector length (Rbar). Evidence: 2013-chindapol-coral-flow.py L186–L203: 5-point drift sweep and morphometric summary table <https://github.com/fractastical/morpholib/blob/5659d5e/2013-chindapol-coral-flow.py#L186-L203>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-parameter-expressivity> ;
        pk:hasProbability "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-parameter-expressivity> rdfs:label "Chindapol flow-driven coral growth (2013-chindapol-coral-flow.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Scleractinian coral Pocillopora verrucosa" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


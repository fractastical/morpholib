sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-chindapol-coral-flow-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — Code-to-model traceability: 68/100" ;
        rdfs:comment "Both the header docstring and Figure panel (f) ('From the paper to this demo') explicitly map each concept in Chindapol et al. (2013) to its 2D DLA counterpart, though individual functions do not cite specific equation numbers from the paper's Methods. Evidence: 2013-chindapol-coral-flow.py L11–L36: docstring mapping paper concepts to demo approximations <https://github.com/fractastical/morpholib/blob/5659d5e/2013-chindapol-coral-flow.py#L11-L36>; 2013-chindapol-coral-flow.py L252–L273: Panel (f) correspondence table <https://github.com/fractastical/morpholib/blob/5659d5e/2013-chindapol-coral-flow.py#L252-L273>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-code-traceability> ;
        pk:hasProbability "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-code-traceability> rdfs:label "Chindapol flow-driven coral growth (2013-chindapol-coral-flow.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Scleractinian coral Pocillopora verrucosa" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-lobo-limbform-morphology-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Model fidelity to source: 88/100" ;
        rdfs:comment "Faithfully decodes LimbformDB 2.1.0's five-table relational graph (Morphology, Link, JointParam, LinkSubJoint, Digit) using recursive vector accumulation, cyclic half-angle bisectors at branching joints, +90/+180/+270 deg terminal caps, double-counted host segments at ectopic sub-joints, and periodic Catmull-Rom splines, satisfying the joint-radius count rule on 3,137 of 3,146 joints (99.71%). Deducts 12 points because Link.side, Link.reversed, Link.inverted, and Digit.reversed are parsed into dataclasses (lines 146-148, 165) but never used in layout() or draw_morphology(), and because 9 mutant joints require mean-radius padding. Evidence: 2014-lobo-limbform-morphology.py L140–L178: Link, SubJoint, Digit, and Morphology dataclasses (including unused side/reversed/inverted fields) <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L140-L178>; 2014-lobo-limbform-morphology.py L275–L421: layout(), _edges_of(), and control_points() implementing recursive tree layout and bisector radii <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L275-L421>; 2014-lobo-limbform-morphology.py L606–L620: check_encoding() verifies 3,137/3,146 joints match the radius rule <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L606-L620>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-model-fidelity> ;
        pk:hasProbability "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-model-fidelity> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}


        dcterms:title "Optimal designs of mollusk shells from bivalves to snails" .

    <https://doi.org/10.1126/science.138.3537.150> dcterms:date "1962"^^xsd:gYear ;
        dcterms:title "Computer as aid in describing form in gastropod shells" .

    <https://doi.org/10.1126/science.147.3663.1294> dcterms:date "1965"^^xsd:gYear ;
        dcterms:title "Theoretical morphology of the coiled shell" .

    <https://doi.org/10.2307/1301992> dcterms:date "1966"^^xsd:gYear ;
        dcterms:title "Geometric analysis of shell coiling: general problems" .


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-raup-shell-coiling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Morphological realism / specimen match: 76/100" ;
        rdfs:comment "Renders six distinct shell archetypes (planispiral involute cf. Nautilus, high-spired turreted cf. Turritella, evolute planispiral cf. Dactylioceras, low-spired obconical cf. Conus, medium-spired cf. Cerithium, helicoid globose cf. Helix) whose 3D geometries and spire-height/width ratios (0.00 to 2.26) match their morphological descriptions. Deducts 24 points because no real mollusc shell photograph, CT scan, or empirical specimen dataset (such as Raup 1967) is overlaid or compared, and the six parameter sets are explicitly declared as illustrative \"cf.\" points rather than measurements of real specimens. Evidence: datasets/raup/variables.json L18–L86: six illustrative shell parameter sets with honest provenance note <https://github.com/fractastical/morpholib/blob/5659d5e/datasets/raup/variables.json#L18-L86>; raup_empirical_comparison.png (generated output, not in repo): 6-panel 3D comparison of coiled shell archetypes — raup_empirical_comparison.png: rendered output of create_raup_animations.py at 5659d5e, image/png, 562658 B, 1630×1070 px, sha256 c50dbee57d0a64950d5470aed25583817eb8d39b97bcf2a7b89b991973f63ef7; raup_shell_metrics.csv L1–L8: spire_over_width and outer_radius_ratio across the six archetypes <https://github.com/fractastical/morpholib/blob/5659d5e/raup_shell_metrics.csv#L1-L8>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-specimen-match> ;
        pk:hasProbability "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-specimen-match> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;

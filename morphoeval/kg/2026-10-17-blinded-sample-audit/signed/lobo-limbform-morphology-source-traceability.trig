sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-lobo-limbform-morphology-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Source and data traceability: 94/100" ;
        rdfs:comment "Cites both primary papers (Lobo et al. 2014a, DOI 10.1093/bioinformatics/btu582; Lobo et al. 2014b, DOI 10.1002/reg2.13) and the upstream LimbformDB 2.1.0 URL, and links every rendered panel to its database Morphology.Id and Experiment record. Deducts 6 points because DB_SHA256 on line 92 contains a 65-character hex string (an extra trailing '0' appended to the true 64-character SHA-256 digest), so resolve_db_path() always prints a false-positive hash mismatch warning. Evidence: 2014-lobo-limbform-morphology.py L1–L56: docstring citing Lobo et al. (2014a, 2014b) DOIs and LimbformDB 2.1.0 URL <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L1-L56>; 2014-lobo-limbform-morphology.py L91–L134: DB_SHA256 has 65 hex chars (trailing '0' typo at L92), triggering mismatch warning in resolve_db_path() <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L91-L134>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-source-traceability> ;
        pk:hasProbability "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-source-traceability> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


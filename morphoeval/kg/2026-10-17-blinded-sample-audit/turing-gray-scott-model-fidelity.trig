sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-model-fidelity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Model fidelity to source: 68/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Implements the discrete 2D Gray-Scott reaction-diffusion system dU/dt = Du*Laplacian(U) - U*V^2 + f*(1-U), dV/dt = Dv*Laplacian(V) + U*V^2 - (f+k)*V with periodic boundary conditions via np.roll and parameters Du=0.16, Dv=0.08, f=0.055, k=0.062, dt=1.0. Deducts 32 points because (1) the 5-point finite-difference Laplacian omits the -4*Z centre weight inside laplacian() and absorbs it into Du*(Lu - 4*U), which is algebraically equivalent only for unit grid spacing dx=1, (2) inline comments misstate the reaction mechanism by claiming '# U inhibits V's growth quadratically' when U is the consumed substrate in autocatalytic production +U*V^2, and (3) the script conflates Turing's (1952) linear morphogen model with the cubic Gray-Scott (1984) / Pearson (1993) system." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-2> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L6–L13" ;
        dct:description "Du=0.16, Dv=0.08, f=0.055, k=0.062, dt=1.0, steps=10000" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L6-L13> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L25–L40" ;
        dct:description "laplacian() and update() with inaccurate comment '# U inhibits V's growth quadratically'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L25-L40> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.261.5118.189> dct:date "1993"^^xsd:gYear ;
        dct:title "Complex patterns in a simple system" .
}


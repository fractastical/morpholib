sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-parameter-expressivity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-parameter-expressivity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Parameter expressivity: 62/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Sweeps f2 across [0.25, 1.0] (monotonically shifting the AP wavefront x*(f2) from 0.500 to 0.648 and anterior silhouette area from 0.483 to 0.639) and sweeps f3 across [0.30, 1.0] (reducing the ML centre/edge ratio lambda(f3) from 0.197 to 0.011), and compares 5 rusty-matter bioelectric scenarios across 3 crop positions. Deducts 38 points because f3 has no effect on the rendered 2D worm morphology and the phenotype output is a binary switch rather than a continuous morphogenetic deformation." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-2> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L302–L359" ;
        dct:description "wavefront_for_f2(), lateral_index_for_f3(), and f2_for_shift()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L302-L359> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L965–L978" ;
        dct:description "f2 and f3 parameter sweeps" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L965-L978> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


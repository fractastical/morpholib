            <https://doi.org/10.1126/science.147.3663.1294>,
            <https://doi.org/10.2307/1301992> .
    <https://doi.org/10.1016/j.jtbi.2014.08.010> dct:date "2014"^^xsd:gYear ;
        dct:title "Quantification and geometric analysis of coiling patterns in gastropod shells based on 3D and 2D image data" .
    <https://doi.org/10.1038/srep42445> dct:date "2017"^^xsd:gYear ;
        dct:title "Optimal designs of mollusk shells from bivalves to snails" .
    <https://doi.org/10.1126/science.138.3537.150> dct:date "1962"^^xsd:gYear ;
        dct:title "Computer as aid in describing form in gastropod shells" .
    <https://doi.org/10.1126/science.147.3663.1294> dct:date "1965"^^xsd:gYear ;
        dct:title "Theoretical morphology of the coiled shell" .
    <https://doi.org/10.2307/1301992> dct:date "1966"^^xsd:gYear ;
        dct:title "Geometric analysis of shell coiling: general problems" .
}


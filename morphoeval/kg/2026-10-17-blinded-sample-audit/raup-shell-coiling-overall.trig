sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-raup-shell-coiling-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — MorphoEval overall 79.3/100" ;
        rdfs:comment "Blinded second-assessor pass (gemini-4-argon). Implements Raup's (1962, 1966) four-parameter logarithmic-spiral shell model (W, D, T, S) using the parametric surface formulation of Noshita (2014) and Okabe & Yoshimura (2017), with an automated self_test() that recovers (W, D, T, S) from the 3D mesh to machine precision (~5e-15). Overall 79.3/100 (faithfulness 76.4, reproducibility 86.1; model-implementation 86.0/100, biological-validation 69.2/100, applicable-only overall 79.3/100; uncalibrated rubric score, not a calibrated probability); rubric morphoeval 0.1.0; checkpoint commit 5659d5e; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0. Dimension assessments: Model fidelity to source 90, Morphological realism / specimen match 76, Parameter expressivity 78, Morphometric validation 58, Source and data traceability 82, Code-to-model traceability 78, Reproducibility package 95. Output judged: raup_shell_animation.gif: rendered output of create_raup_animations.py at 5659d5e, image/gif, 15189434 B, 1200×800 px, 100 frames, sha256 986555a0032be189233cbf0ec15193959bf7f9cc0b1e099a6b7a289f7cff8b02." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling> ;
        pk:hasProbability "0.793"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling> rdfs:label "Raup shell coiling morphospace faithfully reproduces Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens) morphology" ;
        dct:identifier "morphoeval/0.1.0/overall" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


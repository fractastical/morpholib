sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-source-traceability-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-source-traceability-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Source and data traceability: 84/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Cites Hoffmann et al. (2018) with DOI (10.1073/pnas.1721248115), PMID (30224459), and GitHub repository URL, and fetches the official example wing Arigomphus_villosipes_LHW.png from PNAS_Paper_Code.zip. Deducts 16 points because fetch_wing_png() does not verify a pinned SHA-256 digest on the downloaded ZIP archive or extracted PNG." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-source-traceability-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L5–L10" ;
        dct:description "citation block with DOI, PMID, and GitHub URL" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L5-L10> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L65–L88" ;
        dct:description "ZIP_URL and fetch_wing_png() without SHA-256 verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L65-L88> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


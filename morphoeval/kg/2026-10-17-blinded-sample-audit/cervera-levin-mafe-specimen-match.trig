@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-cervera-levin-mafe-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Morphological realism / specimen match: 48/100" ;
        rdfs:comment "Segments a real Wikimedia Commons photograph of Schmidtea mediterranea (Stevenson & Beane 2010, SHA-256 verified) to measure the body-area fraction anterior to x*(f2) and renders decoded Planform #1 Wild Type and #2 Double Head cartoons. Held below 50 because the 1D signals are merely painted onto a static wild-type photograph whose outline never deforms into a double-headed worm, and the morphology readout switches categorically between two pre-drawn Planform cartoons at an assumed pharynx-posterior threshold x*_b = 0.5833. Evidence: 2021-Cervera–Levin–Mafe.py L150–L207: load_real_planarian_silhouette() segments a static wild-type S. mediterranea mask <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L150-L207>; 2021-Cervera–Levin–Mafe.py L795–L869: static Planform #1 and #2 cartoon templates <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L795-L869>; cervera_levin_mafe_bioelectric_morphospace.png (generated output, not in repo): 6-panel summary figure — cervera_levin_mafe_bioelectric_morphospace.png: rendered output of 2021-Cervera–Levin–Mafe.py at 5659d5e, image/png, 547708 B, 2330×1781 px, sha256 3f521835636f3530ddf73b0ea3142db13d605b319aac93fc940e3d8f07fc5f77." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-specimen-match> ;
        pk:hasProbability "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-specimen-match> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dct:identifier "morphoeval/0.1.0/specimen-match" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bioelechem.2019.107410>,
            <https://doi.org/10.1016/j.biosystems.2021.104511>,
            <https://doi.org/10.1016/j.bpj.2019.01.029>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1093/bioinformatics/btt088> .
    <https://doi.org/10.1016/j.bioelechem.2019.107410> dct:date "2020"^^xsd:gYear ;
        dct:title "Bioelectrical model of head-tail patterning based on cell ion channels and intercellular gap junctions" .
    <https://doi.org/10.1016/j.biosystems.2021.104511> dct:date "2021"^^xsd:gYear ;
        dct:title "Morphology changes induced by intercellular gap junction blocking: A reaction-diffusion mechanism" .
    <https://doi.org/10.1016/j.bpj.2019.01.029> dct:date "2019"^^xsd:gYear ;
        dct:title "The Role of Early Bioelectric Signals in the Regeneration of Planarian Anterior/Posterior Polarity" .
    <https://doi.org/10.1016/j.ydbio.2009.12.012> dct:date "2010"^^xsd:gYear ;
        dct:title "Long-range neural and gap junction protein-mediated cues control polarity during planarian regeneration" .
    <https://doi.org/10.1093/bioinformatics/btt088> dct:date "2013"^^xsd:gYear ;
        dct:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .
}


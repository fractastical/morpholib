sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-eshghi-odonata-wing-cells-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Morphometric validation: 96/100" ;
        rdfs:comment "Quantifies scaling slopes, R^2, p-values, and median/IQR cell lengths across fossil and extant suborders (N ~ L^1.78, R^2 = 0.87 for fossils; N ~ L^1.45, R^2 = 0.65 for extant; median cell length 0.78-0.99 mm across 150 Myr and a 6x wing-length range) and validates per-cell morphometrics (count, median, mean, IQR, 95th percentile Feret diameter, area, circularity) across all 69 fossil wings in datasets/odonata/fossil_wing_resegmentation.csv. Evidence: 2026-eshghi-odonata-wing-cells.py L613–L667: build_static_figure() computes and annotates log-log OLS slopes, R^2, and suborder medians/IQRs <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L613-L667>; 2026-eshghi-odonata-wing-cells.py L689–L732: build_resegmentation_figure() plots cell-count and median-length parity scatters <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L689-L732>; datasets/odonata/fossil_wing_resegmentation.csv L1–L70: exported per-wing validation metrics <https://github.com/fractastical/morpholib/blob/5659d5e/datasets/odonata/fossil_wing_resegmentation.csv#L1-L70>. Measurements (measure_outputs.py): cell count ∝ wing length^b, fossil = 1.7811 exponent (reference 2.0, isometric prediction for a constant cell size (Hoffmann et al. 2018 inhibition length)) [OLS slope of log10 cell count on log10 wing length, n=69 wings (Eshghi et al. 2026 tables)] — r = 0.739; median cell length ∝ wing length^b, fossil = -0.1673 exponent (reference 0.0, constant cell size) [OLS slope of log10 median cell length on log10 wing length]; median cell length over wings, fossil = 0.7837 mm [median over wings of the per-wing median cell length (Eshghi et al. 2026 tables)] — IQR 0.67–0.94 mm; cell count ∝ wing length^b, extant_dragonfly = 1.111 exponent (reference 2.0, isometric prediction for a constant cell size (Hoffmann et al. 2018 inhibition length)) [OLS slope of log10 cell count on log10 wing length, n=290 wings (Eshghi et al. 2026 tables)] — r = 0.816; median cell length ∝ wing length^b, extant_dragonfly = 0.2171 exponent (reference 0.0, constant cell size) [OLS slope of log10 median cell length on log10 wing length]; median cell length over wings, extant_dragonfly = 0.9885 mm [median over wings of the per-wing median cell length (Eshghi et al. 2026 tables)] — IQR 0.87–1.09 mm; cell count ∝ wing length^b, extant_damselfly = 1.0078 exponent (reference 2.0, isometric prediction for a constant cell size (Hoffmann et al. 2018 inhibition length)) [OLS slope of log10 cell count on log10 wing length, n=104 wings (Eshghi et al. 2026 tables)] — r = 0.872; median cell length ∝ wing length^b, extant_damselfly = 0.2765 exponent (reference 0.0, constant cell size) [OLS slope of log10 median cell length on log10 wing length]; median cell length over wings, extant_damselfly = 0.8991 mm [median over wings of the per-wing median cell length (Eshghi et al. 2026 tables)] — IQR 0.83–0.99 mm; fossil drawings re-segmented = 69 count (reference 69, fossil wings in Table S1) [fossil venation drawings in the Zenodo archive segmented by the script]; scale bar label read from the drawing = 65 count (reference 69) [drawings whose scale-bar label was read from the glyphs and found consistent with the tabulated wing length] — the rest use the bar with a value inferred from the tabulated wing length, or that length alone; cell count, median |ΔN|/N vs Table S1 = 0.0 ratio (reference 0.0, Eshghi et al. 2026 Table S1) [per-wing relative difference between the script's cell count and the published count, median over 69 wings] — 90% of wings within 2%; max 194% (#7, drawing and table row disagree); median cell length, median |Δ| vs Table S1 = 0.0339 ratio (reference 0.0, Eshghi et al. 2026 Table S1) [per-wing relative difference of the median cell length (maximum Feret diameter), median over wings] — signed mean +3.5% (cells bounded by vein mid-lines); largest cell length, median |Δ| vs Table S1 = 0.0094 ratio (reference 0.0, Eshghi et al. 2026 Table S1) [as above for the largest cell of each wing]; fossil median cell length, re-segmented = 0.8275 mm (reference 0.7837, same statistic from Table S1) [median over wings of the script's own per-wing median cell length]." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-morphometric-validation> ;
        pk:hasProbability "0.96"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-morphometric-validation> rdfs:label "Odonata wing cells through deep time (2026-eshghi-odonata-wing-cells.py) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Odonata (fossil Late Jurassic-Eocene; extant Anisoptera and Zygoptera)" ;
        dct:identifier "morphoeval/0.1.0/morphometric-validation" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


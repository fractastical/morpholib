sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-parameter-expressivity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-parameter-expressivity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Parameter expressivity: 50/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Empirical macroevolutionary scaling and image-resegmentation pipeline operating on fixed museum and extant specimen archives rather than a parameterised generative model; marked not_applicable per the rubric." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-parameter-expressivity-1> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "not applicable (neutral baseline)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L1–L45" ;
        dct:description "docstring defines script as an empirical test of scaling predictions across 69 fossil and 394 extant wings" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L1-L45> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


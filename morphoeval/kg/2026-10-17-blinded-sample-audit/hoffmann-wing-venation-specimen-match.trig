sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-specimen-match-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-specimen-match-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Morphological realism / specimen match: 85/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Places the segmented real Arigomphus villosipes hindwing (panel a) directly beside the model-regenerated secondary venation on the same outline and primary scaffold (panel b), reproducing domain count (923) and proximal-to-distal cell-size gradients. Deducts 15 points because model domains are noticeably more isotropic/hexagonal than the elongated rectangular cell rows between parallel longitudinal veins in the real wing (mean circularity 0.867 vs 0.712)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-specimen-match-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L255–L297" ;
        dct:description "make_figure() renders side-by-side real vs model wings colored by domain circularity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L255-L297> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "hoffmann_wing_recapitulation.png (generated output)" ;
        dct:description "panels (a) and (b) side-by-side specimen vs model comparison — hoffmann_wing_recapitulation.png: rendered output of 2018-hoffmann-wing-venation.py at 5659d5e, image/png, 179027 B, 1730×1206 px, artifact_sha256 43b99ec8ae8205b3f12cfd0cde6d3ab1935463e222f66a0f5c16ec15d49e1108 (sha256 43b99ec8ae8205b3f12cfd0cde6d3ab1935463e222f66a0f5c16ec15d49e1108)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


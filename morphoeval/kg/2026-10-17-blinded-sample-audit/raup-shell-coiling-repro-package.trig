sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-repro-package-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-repro-package-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Reproducibility package: 95/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Completely deterministic mathematical surface generation, zero external network dependencies, automated self_test() gate executed before rendering, and pinned dependencies in requirements.txt / requirements.lock.txt." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-repro-package-2> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L443–L459" ;
        dct:description "main() runs self_test() and generates all four outputs deterministically" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/create_raup_animations.py#L443-L459> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L35" ;
        dct:description "pinned environment lockfile" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-planform-morphology-animation-model-fidelity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-planform-morphology-animation-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Model fidelity to source: 86/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Decodes PlanformDB 2.5.0's relational tables (Morphology, Region, RegionParam, RegionsLink, Organ, OrganPoint) using the formalism's exact link-degree radius rule (0 links -> 4 cardinal radii; 1 link -> +90/+180/+270 deg; k >= 2 links -> k bisector radii), places region centres from Dist/Ang and shared borders at Ratio*Dist, and verifies in check_encoding() that 1,181/1,181 regions obey the rule. Deducts 14 points because consecutive control radii are connected by a heuristic superellipse arc (N_FREE=2.2, N_BORDER=7.0) tuned to resemble Fig. 1D rather than a closed-form curve equation published in the paper." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-model-fidelity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L279–L391" ;
        dct:description "layout(), control_points(), and region_outline() implementing the graph-to-outline decoder" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L279-L391> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2013-lobo-planform-morphology.py L733–L747" ;
        dct:description "check_encoding() verifies 1,181/1,181 regions obey the 0->4 / 1->3 / k->k rule" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L733-L747> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://doi.org/10.1242/bio.20123400> .
    <https://doi.org/10.1016/j.bpj.2017.04.011> dct:date "2017"^^xsd:gYear ;
        dct:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .
    <https://doi.org/10.1093/bioinformatics/btt088> dct:date "2013"^^xsd:gYear ;
        dct:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .
    <https://doi.org/10.1242/bio.20123400> dct:date "2013"^^xsd:gYear ;
        dct:title "Towards a bioinformatics of patterning: a computational approach to understanding regulative morphogenesis" .
}


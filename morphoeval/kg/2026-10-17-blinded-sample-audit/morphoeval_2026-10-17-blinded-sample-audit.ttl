<https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson's Scarus -> Pomacanthus transformation fitted to real species — Model fidelity to source: 94/100" ;
    dct:date "2026-10-17"^^xsd:date ;
    dct:description "Operationalises Thompson's freehand coordinate transformations (1917, pp. 749-751, Figs. 375-376) into an explicit nested hierarchy of five analytical families (similarity, affine, projective/Moebius, oblique coaxial circles via complex log-ratio and power-shear, and Bookstein 1989 exact thin-plate spline). Fits all parametric models via multi-start non-linear least squares (fit_family) and verifies exact round-trip invertibility of the bipolar map (inv_coaxial) to machine precision in self_test(). Deducts 6 points only because Thompson's original grids were drawn freehand without algebraic formulas, so the 9-parameter bipolar power-shear equation is a modern formalisation rather than an equation printed in 1917, and Thompson's printed grid lines are not digitised as numerical coordinates." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-model-fidelity-2> ;
    pk:hasScore 9.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-morphometric-validation-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;

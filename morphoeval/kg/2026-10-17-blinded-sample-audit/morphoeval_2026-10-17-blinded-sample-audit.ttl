<https://w3id.org/probknow/resource/assessment/morphoeval-planform-morphology-animation-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
    rdfs:label "PlanformDB planarian morphology animation — Model fidelity to source: 86/100" ;
    dct:date "2026-10-17"^^xsd:date ;
    dct:description "Decodes PlanformDB 2.5.0's relational tables (Morphology, Region, RegionParam, RegionsLink, Organ, OrganPoint) using the formalism's exact link-degree radius rule (0 links -> 4 cardinal radii; 1 link -> +90/+180/+270 deg; k >= 2 links -> k bisector radii), places region centres from Dist/Ang and shared borders at Ratio*Dist, and verifies in check_encoding() that 1,181/1,181 regions obey the rule. Deducts 14 points because consecutive control radii are connected by a heuristic superellipse arc (N_FREE=2.2, N_BORDER=7.0) tuned to resemble Fig. 1D rather than a closed-form curve equation published in the paper." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-planform-morphology-animation-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .


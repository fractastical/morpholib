<https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-turing-gray-scott-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Gray-Scott reaction-diffusion patterns — Reproducibility package: 55/100" ;
    rdfs:comment "Self-contained numpy + matplotlib script with pinned repository lockfile (requirements.lock.txt), but np.random.random((size, size)) on lines 19-20 is unseeded so every execution yields a different pattern trajectory, no CLI arguments are supported, and the output filename (turing_patterns_black_neon.gif) differs from docs/media/turing_gray_scott.gif. Evidence: 1952-turing-morpho.py L19–L20: unseeded np.random.random((size, size)) <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L19-L20>; 1952-turing-morpho.py L75–L75: hardcoded ani.save('turing_patterns_black_neon.gif') <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L75-L75>." ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-repro-package> ;
    pk:hasProbability 5.5e-01 ;
    pk:hasVerdict "partially faithful" .


<https://w3id.org/probknow/resource/math-law/cervera-levin-mafe-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cervera-Levin-Mafe (2021) Gap-Junction Coupled Membrane Potential ODE" ;
    dct:description "Models bioelectric pattern memory, bistable polarized vs. depolarized domains, and double-head (2H) vs. wild-type (1H) planarian regeneration attractors | Variables: V_i: transmembrane voltage of cell i; C_m: membrane capacitance; I_dep, I_hyp: inward/outward ion currents; G_{ij}: gap-junction conductance" ;
    dct:source "Cervera, Levin & Mafe (2021) J. Phys. Chem. B / Bioelectrochemistry" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L65-L185>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L229-L237> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gap_junction_current (G_ij V_i V_j : Int) : Int := G_ij * (V_j - V_i)
theorem cervera_equipotential_zero_current (G_ij V : Int) :
    gap_junction_current G_ij V V = 0 := by
  simp [gap_junction_current]"""^^pk:lean4 ;
    skos:notation "C_m dV_i/dt = -I_dep(V_i) - I_hyp(V_i) + ∑_{j ∈ N(i)} G_{ij}(V_i, V_j) (V_j - V_i)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bioelechem.2019.107410>,
        <https://doi.org/10.1016/j.biosystems.2021.104511>,
        <https://doi.org/10.1016/j.bpj.2019.01.029>,
        <https://doi.org/10.1016/j.ydbio.2009.12.012>,
        <https://doi.org/10.1093/bioinformatics/btt088> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Bioelectric Gap-Junction Coupled Nonlinear Dynamical Network" ;
    pk:leanDeclaration "MathOfBiology.gap_junction_current" ;
    pk:leanTheorem "MathOfBiology.cervera_equipotential_zero_current" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/cervera-levin-mafe-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Voltage-Gated Bell-Boltzmann Gap-Junction Conductance" ;
    dct:description "Nonlinear intercellular coupling that isolates depolarized wounds or unlocks regional tissue-level bioelectric synchronization | Variables: G_0: maximum open gap-junction conductance; V_th: gating threshold voltage; V_0: thermal/voltage slope factor" ;
    dct:source "Cervera, Levin & Mafe (2021)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L110-L160>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L239-L248> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def bell_boltzmann_denom (b_i b_j : Nat) : Nat := (1 + b_i) * (1 + b_j)
theorem cervera_bell_boltzmann_symmetric (b_i b_j : Nat) :
    bell_boltzmann_denom b_i b_j = bell_boltzmann_denom b_j b_i := by
  simp [bell_boltzmann_denom, Nat.mul_comm]"""^^pk:lean4 ;
    skos:notation "G_{ij}(V_i, V_j) = G_0 / [ (1 + exp((V_i - V_th)/V_0)) (1 + exp((V_j - V_th)/V_0)) ]" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bioelechem.2019.107410>,
        <https://doi.org/10.1016/j.biosystems.2021.104511>,
        <https://doi.org/10.1016/j.bpj.2019.01.029>,
        <https://doi.org/10.1016/j.ydbio.2009.12.012>,
        <https://doi.org/10.1093/bioinformatics/btt088> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Bioelectric Gap-Junction Coupled Nonlinear Dynamical Network" ;
    pk:leanDeclaration "MathOfBiology.bell_boltzmann_denom" ;
    pk:leanTheorem "MathOfBiology.cervera_bell_boltzmann_symmetric" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/chindapol-coral-flow-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Advection-Diffusion Nutrient Boundary Layer & Péclet Number" ;
    dct:description "Couples unidirectional vs. high-flow hydrodynamic boundary layer thinning to symmetric bushy vs. upstream-curved Pocillopora coral branching | Variables: c(x): dissolved inorganic carbon/nutrient concentration; u(x): flow velocity field; Pe: Péclet number; v_n: normal skeletal accretion rate" ;
    dct:source "Chindapol et al. (2013) PLoS Comput. Biol. 9(1):e1002849" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/2013-chindapol-coral-flow.py#L60-L190>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L344-L352> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def peclet_numerator (U L : Nat) : Nat := U * L
theorem chindapol_zero_flow_diffusive (L : Nat) :
    peclet_numerator 0 L = 0 := by
  simp [peclet_numerator]"""^^pk:lean4 ;
    skos:notation "u · ∇c = D ∇^2 c,   Pe = U L / D,   v_n = k_g (∇c · n)|_Γ" ;
    prov:wasDerivedFrom <https://doi.org/10.1371/journal.pcbi.1002849> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Advection-Diffusion Nutrient Transport & Péclet-Number Accretion" ;
    pk:leanDeclaration "MathOfBiology.peclet_numerator" ;
    pk:leanTheorem "MathOfBiology.chindapol_zero_flow_diffusive" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/eshghi-odonata-wing-cells-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Odonata Wing Cell Circularity & Second-Moment Eigenvalue Elongation" ;
    dct:description "Measures proximo-distal and anterior-posterior cell size, circularity, and elongation gradients across dragonfly (Anisoptera) and damselfly (Zygoptera) wings | Variables: A_i, P_i: wing cell polygon area and perimeter; Σ_i: 2×2 boundary/interior covariance matrix; λ_min, λ_max: principal eigenvalues" ;
    dct:source "Eshghi et al. (2026) Odonata Wing Venation Morphometrics" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L70-L215>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L327-L336> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def elongation_anisotropy_diff (lam_max lam_min : Nat) : Nat := lam_max - lam_min
theorem eshghi_isotropic_zero_elongation (lam : Nat) :
    elongation_anisotropy_diff lam lam = 0 := by
  simp [elongation_anisotropy_diff]"""^^pk:lean4 ;
    skos:notation "C_i = 4π A_i / P_i^2,   E_i = 1 - √(λ_min(Σ_i) / λ_max(Σ_i))" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115>,
        <https://doi.org/10.5281/zenodo.19899648> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Spatial Polygonal Morphometrics & Covariance Eigenvalue Elongation" ;
    pk:leanDeclaration "MathOfBiology.elongation_anisotropy_diff" ;
    pk:leanTheorem "MathOfBiology.eshghi_isotropic_zero_elongation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/hoffmann-wing-venation-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Wing Vein Polygonal Cell Area & Isoperimetric Circularity Law" ;
    dct:description "Quantifies primary vs. secondary insect wing venation domain geometry and cell shape distributions | Variables: (x_k, y_k): ordered polygon vertices of wing cell i; A_i: polygon area; P_i: perimeter; C_i: isoperimetric circularity" ;
    dct:source "Hoffmann, Donoughe et al. (2018) PNAS 115(40):9905-9910" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L60-L180>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L311-L319> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def shoelace_edge_term (xk yk xk1 yk1 : Int) : Int := xk * yk1 - xk1 * yk
theorem hoffmann_shoelace_antisymmetric (xk yk xk1 yk1 : Int) :
    shoelace_edge_term xk1 yk1 xk yk = - shoelace_edge_term xk yk xk1 yk1 := by
  simp [shoelace_edge_term, Int.neg_sub]"""^^pk:lean4 ;
    skos:notation "A_i = (1/2) |∑_{k=1}^m (x_k y_{k+1} - x_{k+1} y_k)|,   C_i = 4π A_i / P_i^2 ∈ (0, 1]" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Planar Straight-Line Graph (PSLG) Polygonal Tessellation Geometry" ;
    pk:leanDeclaration "MathOfBiology.shoelace_edge_term" ;
    pk:leanTheorem "MathOfBiology.hoffmann_shoelace_antisymmetric" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/lobo-limbform-morphology-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lobo et al. (2014) Limbform Recursive Segmental Tree Vector Law" ;
    dct:description "Decodes normal, regenerating, and ectopic/supernumerary amphibian and vertebrate limb morphologies from LimbformDB | Variables: L_k: limb podial/zeugopod/stylopod segment length; α_j: relative joint branching angle; r: segment radius" ;
    dct:source "Lobo, Feldman & Levin (2014) Dev. Biol. / Bioinformatics" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L75-L210>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L274-L287> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """inductive LimbTree where
  | leaf (length : Nat) : LimbTree
  | branch (length : Nat) (child : LimbTree) : LimbTree
theorem lobo_2014_three_segment_axis (L1 L2 L3 : Nat) :
    limb_segment_count (LimbTree.branch L1 (LimbTree.branch L2 (LimbTree.leaf L3))) = 3 := by rfl"""^^pk:lean4 ;
    skos:notation "x_{k+1} = x_k + L_k [cos(∑_{j≤k} α_j), sin(∑_{j≤k} α_j)]^T,   T = (s, α, r, L, children)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
        <https://doi.org/10.1093/bioinformatics/btu582> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Recursive Tree Graph Grammar & Segmental Kinematics" ;
    pk:leanDeclaration "MathOfBiology.limb_segment_count" ;
    pk:leanTheorem "MathOfBiology.lobo_2014_three_segment_axis" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/planform-morphology-animation-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lobo et al. (2013) PlanformDB Region-Link Polar Graph Encoding" ;
    dct:description "Decodes all 369 relational planarian body morphologies and internal organ placements (eyes, brain, pharynx) from PlanformDB | Variables: p_A, p_B: connected body-region centers; θ_{AB}: polar attachment angle; r_{ant}, r_{post}, r_{lat}: directional semi-axes" ;
    dct:source "Lobo, Malone & Levin (2013) PLoS Comput. Biol. 9(10):e1003287" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/2013-lobo-planform-morphology.py#L80-L240>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L256-L266> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def planform_wildtype_ap_length (r_head r_ant_trunk r_post_trunk r_tail : Nat) : Nat :=
  r_head + r_ant_trunk + r_post_trunk + r_tail
theorem lobo_2013_wildtype_dimensions :
    planform_wildtype_ap_length 80 200 200 80 = 560 ∧ (60 + 60 : Nat) = 120 := by decide"""^^pk:lean4 ;
    skos:notation "p_B = p_A + r_A(θ_{AB}) u(θ_{AB}) + d_{AB} u(θ_{AB}),   R_i(φ) = piecewise-ellipse(r_{ant}, r_{post}, r_{lat})" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
        <https://doi.org/10.1093/bioinformatics/btt088>,
        <https://doi.org/10.1242/bio.20123400> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Formal Anatomical Region Graph Grammar & Polar Geometry" ;
    pk:leanDeclaration "MathOfBiology.planform_wildtype_ap_length" ;
    pk:leanTheorem "MathOfBiology.lobo_2013_wildtype_dimensions" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/raup-shell-coiling-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Raup (1966) 4-Parameter Logarithmic Helicospiral Surface" ;
    dct:description "Spans gastropod, cephalopod, bivalve, and brachiopod shell morphospace in 3D cylindrical coordinates | Variables: W: whorl expansion rate; D: relative distance of generating curve from coiling axis; T: whorl translation rate (dz_c/dr_c); S: aperture aspect ratio" ;
    dct:source "Raup (1966) J. Paleontol. 40(5):1178-1190 Eq. (1)-(6); Noshita (2014)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/create_raup_animations.py#L72-L148>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L147-L169> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def raup_whorl_radius (r0 W : Nat) : Nat → Nat
  | 0 => r0
  | k + 1 => W * raup_whorl_radius r0 W k
theorem raup_whorl_expansion_recovery (r0 W k : Nat) :
    raup_whorl_radius r0 W (k + 1) = W * raup_whorl_radius r0 W k := by rfl"""^^pk:lean4 ;
    skos:notation "r(θ, φ) = r_0 W^{θ/2π} [1 + ((1 - D)/(1 + D)) cos φ],   z(θ, φ) = r_0 T (W^{θ/2π} - 1) + r_0 W^{θ/2π} S ((1 - D)/(1 + D)) sin φ" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2014.08.010>,
        <https://doi.org/10.1038/srep42445>,
        <https://doi.org/10.1126/science.138.3537.150>,
        <https://doi.org/10.1126/science.147.3663.1294>,
        <https://doi.org/10.2307/1301992> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Logarithmic Helicospiral Parametric Differential Geometry" ;
    pk:leanDeclaration "MathOfBiology.raup_whorl_radius" ;
    pk:leanTheorem "MathOfBiology.raup_whorl_expansion_recovery" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/raup-shell-coiling-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Generating-Curve Center Parameter Recovery Identities" ;
    dct:description "Exact inverse morphometric recovery verifying 3D mesh fidelity against input (W, D, T) across all 6 canonical shell regimes | Variables: r_c, z_c: generating-curve centroid coordinates; r_min, r_max: inner and outer aperture margins" ;
    dct:source "Raup (1966) J. Paleontol. 40(5):1178-1190; Okabe & Yoshimura (2017)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L161-L173>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/measure_outputs.py#L220-L310> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def raup_axial_step (T delta_r : Nat) : Nat := T * delta_r
theorem raup_translation_rate_recovery (T delta_r : Nat) (h_pos : delta_r > 0) :
    (raup_axial_step T delta_r) / delta_r = T := by
  simp [raup_axial_step, Nat.mul_div_cancel _ h_pos]"""^^pk:lean4 ;
    skos:notation "W_rec = r_c(θ) / r_c(θ - 2π),   D_rec = r_min(θ) / r_max(θ),   T_rec = Δz_c / Δr_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2014.08.010>,
        <https://doi.org/10.1038/srep42445>,
        <https://doi.org/10.1126/science.138.3537.150>,
        <https://doi.org/10.1126/science.147.3663.1294>,
        <https://doi.org/10.2307/1301992> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Logarithmic Helicospiral Parametric Differential Geometry" ;
    pk:leanDeclaration "MathOfBiology.raup_axial_step" ;
    pk:leanTheorem "MathOfBiology.raup_translation_rate_recovery" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/santella-wormguides-celegans-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Sulston Embryonic Binary Lineage Division & 4D Nuclear Interpolation" ;
    dct:description "Reconstructs 3D embryonic morphogenesis, gastrulation, and ventral enclosure of Caenorhabditis elegans from WormGUIDES nuclear tracks | Variables: x_i(t) = (X_i, Y_i, Z_i): 3D nuclear centroid of blastomere i at embryonic minute t; founder lineages ∈ {AB, MS, E, C, D, P4}" ;
    dct:source "Santella et al. (2015) BMC Bioinformatics 16:189; Sulston et al. (1983)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L90-L230>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L295-L303> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def nuclear_lerp (x0 x1 lam : Int) : Int := (1 - lam) * x0 + lam * x1
theorem sulston_nuclear_lerp_endpoints (x0 x1 : Int) :
    nuclear_lerp x0 x1 0 = x0 ∧ nuclear_lerp x0 x1 1 = x1 := by
  simp [nuclear_lerp]"""^^pk:lean4 ;
    skos:notation "x_i(t) = (1 - λ(t)) x_i(t_k) + λ(t) x_i(t_{k+1}),   v_i(t) = ||x_i(t + Δt) - x_i(t)|| / Δt" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
        <https://doi.org/10.1038/s41586-019-1352-7>,
        <https://doi.org/10.1083/jcb.144.5.927>,
        <https://doi.org/10.1098/rstb.2017.0382>,
        <https://doi.org/10.1186/s12859-015-0627-8> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Sulston Binary Lineage Tree & 4D Spatiotemporal Trajectory Kinematics" ;
    pk:leanDeclaration "MathOfBiology.nuclear_lerp" ;
    pk:leanTheorem "MathOfBiology.sulston_nuclear_lerp_endpoints" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/thompson-scarus-pomacanthus-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "2D Biharmonic Thin-Plate Spline (TPS) Deformation Field" ;
    dct:description "Maps homologous anatomical landmarks of Scarus (parrotfish) onto Pomacanthus (angelfish) with minimum bending energy | Variables: (x, y): source Scarus landmark coordinates; r_i = ||(x,y) - p_i||; w_i: biharmonic kernel weights" ;
    dct:source "Thompson (1917) On Growth and Form Ch. XVII Fig. 517-518; Bookstein (1989) IEEE TPAMI 11:567" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L181-L189>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/thompson/1917-thompson.py#L95-L185> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def tps_zero_displacement_kernel (r_sq log_r_sq : Int) : Int := r_sq * log_r_sq
theorem tps_kernel_zero_at_origin (log_val : Int) :
    tps_zero_displacement_kernel 0 log_val = 0 := by
  simp [tps_zero_displacement_kernel]"""^^pk:lean4 ;
    skos:notation "Φ(x, y) = a_0 + a_x x + a_y y + ∑_{i=1}^K w_i r_i^2 ln(r_i^2),  Δ^2 Φ = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-93093-5>,
        <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.1111/evo.13755>,
        <https://doi.org/10.1371/journal.pone.0112732>,
        <https://doi.org/10.5061/dryad.fn457gr> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Biharmonic Thin-Plate Spline & Affine Coordinate Transformation" ;
    pk:leanDeclaration "MathOfBiology.tps_zero_displacement_kernel" ;
    pk:leanTheorem "MathOfBiology.tps_kernel_zero_at_origin" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/thompson-scarus-pomacanthus-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Affine Oblique Shear & Principal Strain Tensor" ;
    dct:description "Linear global coordinate shear baseline compared against non-affine TPS warp across 14 anatomical landmarks | Variables: α_x, α_y: axial stretch ratios; γ_xy, γ_yx: oblique grid shear angles; J: local areal dilation" ;
    dct:source "Thompson (1917) On Growth and Form Ch. XVII" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L191-L200>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/thompson/1917-thompson.py#L186-L260> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def affine_jacobian_det (a_x a_y g_xy g_yx : Int) : Int := a_x * a_y - g_xy * g_yx
theorem thompson_unit_shear_area_preserving (g_xy : Int) :
    affine_jacobian_det 1 1 g_xy 0 = 1 := by
  simp [affine_jacobian_det]"""^^pk:lean4 ;
    skos:notation "x' = α_x x + γ_xy y + t_x,  y' = γ_yx x + α_y y + t_y;  J = det(∇Φ)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/978-3-642-93093-5>,
        <https://doi.org/10.1109/34.24792>,
        <https://doi.org/10.1111/evo.13755>,
        <https://doi.org/10.1371/journal.pone.0112732>,
        <https://doi.org/10.5061/dryad.fn457gr> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Biharmonic Thin-Plate Spline & Affine Coordinate Transformation" ;
    pk:leanDeclaration "MathOfBiology.affine_jacobian_det" ;
    pk:leanTheorem "MathOfBiology.thompson_unit_shear_area_preserving" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/turing-gray-scott-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Gray-Scott Autocatalytic Reaction-Diffusion System" ;
    dct:description "Generates symmetry-breaking Turing spots (mitosis), labyrinthine stripes, and coral/soliton regimes across (F, k) morphospace | Variables: u(x,y,t): substrate concentration; v(x,y,t): autocatalyst concentration; D_u, D_v: diffusivities; F: feed rate; k: kill rate" ;
    dct:source "Turing (1952) Phil. Trans. R. Soc. B 237:37; Pearson (1993) Science 261:189" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L430-L512>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L208-L221> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gray_scott_react_u (F u v : Int) : Int := -(u * v * v) + F * (1 - u)
def gray_scott_react_v (F k u v : Int) : Int := u * v * v - (F + k) * v
theorem gray_scott_homogeneous_equilibrium (F k : Int) :
    gray_scott_react_u F 1 0 = 0 ∧ gray_scott_react_v F k 1 0 = 0 := by
  simp [gray_scott_react_u, gray_scott_react_v]"""^^pk:lean4 ;
    skos:notation "∂u/∂t = D_u ∇^2 u - u v^2 + F(1 - u),   ∂v/∂t = D_v ∇^2 v + u v^2 - (F + k)v" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.261.5118.189> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE) & Linear Bifurcation Theory" ;
    pk:leanDeclaration "MathOfBiology.gray_scott_react_u" ;
    pk:leanTheorem "MathOfBiology.gray_scott_homogeneous_equilibrium" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/turing-gray-scott-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing (1952) Equal-Diffusion Stability Theorem" ;
    dct:description "Proves that equal morphogen diffusivities (D_u = D_v) cannot destabilize a stable homogeneous steady state at any spatial wavenumber | Variables: J_0: homogeneous reaction Jacobian; D_X, D_Y: morphogen diffusivities; q = k^2: squared Fourier wavenumber" ;
    dct:source "Turing (1952) Phil. Trans. R. Soc. B 237(641):37-72 Sections 8-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L163-L244>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L223-L240> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def turing_equal_diff_trace_neg (t_neg D q : Nat) : Nat := (t_neg + 1) + 2 * D * q
def turing_equal_diff_det (t_neg d_pos D q : Nat) : Nat :=
  D * D * q * q + D * (t_neg + 1) * q + (d_pos + 1)
theorem turing_equal_diffusion_no_instability (t_neg d_pos D q : Nat) :
    turing_equal_diff_trace_neg t_neg D q ≥ 1 ∧
    turing_equal_diff_det t_neg d_pos D q ≥ d_pos + 1 := by
  simp [turing_equal_diff_trace_neg, turing_equal_diff_det]; omega"""^^pk:lean4 ;
    skos:notation "D_X = D_Y = D, tr(J_0) < 0, det(J_0) > 0 ⟹ tr(J_k) = tr(J_0) - 2 D k^2 < 0 ∧ det(J_k) = D^2 k^4 - D tr(J_0) k^2 + det(J_0) > 0  (∀ k^2 ≥ 0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.261.5118.189> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE) & Linear Bifurcation Theory" ;
    pk:leanDeclaration "MathOfBiology.turing_equal_diff_det" ;
    pk:leanTheorem "MathOfBiology.turing_equal_diffusion_no_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/turing-gray-scott-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing (1952) Differential-Diffusion Instability & Critical Ratio Law" ;
    dct:description "Governs spontaneous symmetry breaking and wavelength selection (λ_c = 2π/k_c = 5.62 cells) in Turing's ring of 20 cells and Pomacanthus skin stripes | Variables: a=1.0, b=-1.5, c=1.25, d=-1.5 (4x-scaled to 4, -6, 5, -6): activator-inhibitor Jacobian; d_c = 3.9271: critical diffusivity ratio; s*=4: dominant mode on N=20 ring" ;
    dct:source "Turing (1952) Phil. Trans. R. Soc. B 237(641):37-72 Sections 8-10; Kondo & Asai (1995) Nature 376:765-768" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L163-L244>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L242-L261> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def turing_fourier_det (a b c d DX DY q : Int) : Int :=
  DX * DY * q * q - (d * DX + a * DY) * q + (a * d - b * c)
theorem turing_differential_diffusion_instability :
    turing_fourier_det 4 (-6) 5 (-6) 1 1 0 = 6 ∧
    turing_fourier_det 4 (-6) 5 (-6) 1 1 1 = 9 ∧
    turing_fourier_det 4 (-6) 5 (-6) 1 4 1 = 0 ∧
    turing_fourier_det 4 (-6) 5 (-6) 1 5 1 = -3 := by decide"""^^pk:lean4 ;
    skos:notation "det(J_k) = D_X D_Y k^4 - (d D_X + a D_Y) k^2 + (a d - b c) < 0  for  d = D_Y / D_X > d_c = 3.927051" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.261.5118.189> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE) & Linear Bifurcation Theory" ;
    pk:leanDeclaration "MathOfBiology.turing_fourier_det" ;
    pk:leanTheorem "MathOfBiology.turing_differential_diffusion_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/turing-gray-scott-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Pearson (1993) Saddle-Node & Hopf Steady-State Bifurcation Laws" ;
    dct:description "Defines the exact Saddle-Node existence boundary and Hopf oscillation curve partitioning Pearson's 12 pattern classes (α–μ) in (k, F) morphospace | Variables: F: feed rate; k: kill rate; s = F + k; (U_-, V_+): high-activator homogeneous steady state" ;
    dct:source "Pearson (1993) Science 261(5118):189-192; Lee et al. (1994) Nature 369:215-218" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L327-L426>,
        <https://github.com/fractastical/morpholib/blob/5659d5e/morphoeval/lean/MathOfBiology.lean#L263-L283> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def pearson_sn_discriminant (F s : Int) : Int := F - 4 * s * s
def pearson_steady_trace (F k uv v_sq : Int) : Int := (-F - v_sq) + (2 * uv - (F + k))
theorem pearson_saddle_node_discriminant (F k s : Int) :
    pearson_sn_discriminant (4 * s * s) s = 0 ∧
    pearson_steady_trace F k (F + k) k = 0 := by
  simp [pearson_sn_discriminant, pearson_steady_trace]; omega"""^^pk:lean4 ;
    skos:notation "Δ_SN(F, k) = F - 4(F + k)^2 = 0,   tr(J_0)|_{U_* V_* = F+k} = k - V_+^2 = 0  ⟺  F_Hopf(k) = ½(√k - 2k - √(k(1 - 4√k)))" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.261.5118.189> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE) & Linear Bifurcation Theory" ;
    pk:leanDeclaration "MathOfBiology.pearson_sn_discriminant" ;
    pk:leanTheorem "MathOfBiology.pearson_saddle_node_discriminant" ;
    pk:leanVerified true .


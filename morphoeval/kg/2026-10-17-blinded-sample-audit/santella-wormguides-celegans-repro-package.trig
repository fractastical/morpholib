@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-santella-wormguides-celegans-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Reproducibility package: 86/100" ;
        rdfs:comment "Fully deterministic execution, SHA-256-verified input caching in .celegans_cache/, CLI options (--out-dir, --csv, --no-anim, --step, --offline), and exact dependency lockfile in requirements.lock.txt; requires network access only on first run when .celegans_cache/ is unpopulated. Evidence: 2015-santella-wormguides-celegans.py L674–L723: main() CLI parser and deterministic execution flow <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L674-L723>; requirements.lock.txt L1–L35: pinned environment lockfile <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-repro-package> ;
        pk:hasProbability "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-repro-package> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome (2015-santella-wormguides-celegans.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> .
    <https://doi.org/10.1016/0012-1606(83)90201-4> dct:date "1983"^^xsd:gYear ;
        dct:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .
    <https://doi.org/10.1038/s41586-019-1352-7> dct:date "2019"^^xsd:gYear ;
        dct:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .
    <https://doi.org/10.1083/jcb.144.5.927> dct:date "1999"^^xsd:gYear ;
        dct:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .
    <https://doi.org/10.1098/rstb.2017.0382> dct:date "2018"^^xsd:gYear ;
        dct:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .
    <https://doi.org/10.1186/s12859-015-0627-8> dct:date "2015"^^xsd:gYear ;
        dct:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
}


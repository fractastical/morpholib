sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-santella-wormguides-celegans> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-santella-wormguides-celegans-morphometric-validation-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-santella-wormguides-celegans-morphometric-validation-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Morphometric validation: 82/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Validates decoded atlas metrics against Sulston et al. (1983) / WormAtlas and Cook et al. (2019) benchmarks: 1,330/1,330 valid Sulston names, 1,326/1,326 parent-before-child appearances, 113/113 programmed cell deaths present, unfitted eggshell width of 29.24 um against the 30 um reference (and 13-mesh scale bracket 0.1649-0.1750 um/unit), 562-571 nuclei at 330-350 min (vs ~550), E-cell gastrulation ingression at 26 cells (vs ~30-cell stage), and 300/302 hermaphrodite neurons (with CANL/CANR explained by lack of synapses). Also quantifies and reports the 19.0-unit static-shell overrun and the ~27-minute clock offset at gastrulation (73 min vs 100 min)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-calibration>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-cells-first-seen-after-their-parent>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-deaths-listed-by-the-atlas>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-eggshell-length-spread-across-sampled-shell-meshes>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-eggshell-width-under-the-calibration>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-gastrulation-onset-cell-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-gastrulation-onset-movie-minute>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-lineage-names-parsing-as-sulston-names>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-listed-dying-cells-that-occur-in-the-movie>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-maximum-nucleus-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-neurons-in-the-connectome-edge-list>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclear-cloud-width-at-the-last-frame>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclear-overrun-of-the-shell-in-x>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclei-at-movie-minute-330-350>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclei-at-the-last-frame>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-morphometric-validation-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-calibration> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "calibration = 0.1649 µm per atlas unit" ;
        dct:description "assumption: Gönczy et al. 1999 JCB 144:927 ('50-µm-long cell'); the atlas coordinates are unit-less (ProductionInfo X/Y/Z_SCALE = 1); the earlier nuclear-cloud estimate gives 0.1617; the sampled shell meshes give 0.1649-0.1750" ;
        schema:measurementTechnique "x extent of the atlas's eggshell outline mesh at frame 330 (obj_files/embryo_t330.obj, 'Embryo Outline' in CellShapesConfig.csv; 303.1 units) set to the 50 µm egg length" ;
        schema:name "calibration" ;
        schema:unitText "µm per atlas unit" ;
        schema:value "0.1649" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-cells-first-seen-after-their-parent> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cells first seen after their parent = 1326 count" ;
        schema:measurementTechnique "non-founder cells whose parent name appears in an earlier frame" ;
        schema:name "cells first seen after their parent" ;
        schema:unitText "count" ;
        schema:value "1326" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-cells-first-seen-after-their-parent-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-cells-first-seen-after-their-parent-reference> a schema:PropertyValue ;
        dct:source "all cells whose parent is in the movie (4 founders present at frame 1 have parents that predate it)" ;
        schema:value "1326" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-deaths-listed-by-the-atlas> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "deaths listed by the atlas = 113 count" ;
        schema:measurementTechnique "names in CellDeaths.csv" ;
        schema:name "deaths listed by the atlas" ;
        schema:unitText "count" ;
        schema:value "113" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-deaths-listed-by-the-atlas-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-deaths-listed-by-the-atlas-reference> a schema:PropertyValue ;
        dct:source "WormAtlas, Embryo introduction (Sulston et al. 1983), accessed 2026-10-15: 113 embryonic cell deaths" ;
        schema:value "113" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-eggshell-length-spread-across-sampled-shell-meshes> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "eggshell length spread across sampled shell meshes = 17.3733 atlas units" ;
        dct:description "one static mesh is reused for frames 1-~250, re-segmented per frame from ~280; the spread bounds the scale uncertainty (~6 %)" ;
        schema:measurementTechnique "max - min x extent of the eggshell meshes at frames [1, 30, 60, 100, 200, 250, 280, 300, 320, 330, 340, 350, 359] (285.8-303.1)" ;
        schema:name "eggshell length spread across sampled shell meshes" ;
        schema:unitText "atlas units" ;
        schema:value "17.3733" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-eggshell-width-under-the-calibration> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "eggshell width under the calibration = 29.238 µm" ;
        dct:description "a consistency check of the calibration: the width is not fitted" ;
        schema:measurementTechnique "y extent of the eggshell outline mesh at frame 330 (z extent 28.9 µm)" ;
        schema:name "eggshell width under the calibration" ;
        schema:unitText "µm" ;
        schema:value "29.238" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-eggshell-width-under-the-calibration-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-eggshell-width-under-the-calibration-reference> a schema:PropertyValue ;
        dct:source "Gönczy et al. 1999 JCB 144:927 / WormAtlas: the egg is ~50 x 30 µm" ;
        schema:value "30.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-gastrulation-onset-cell-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gastrulation onset, cell count = 26 count" ;
        schema:measurementTechnique "first frame from which the E cells sit at < 0.8 of the median normalised radius for 5 frames" ;
        schema:name "gastrulation onset, cell count" ;
        schema:unitText "count" ;
        schema:value "26" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-gastrulation-onset-cell-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-gastrulation-onset-cell-count-reference> a schema:PropertyValue ;
        dct:source "WormAtlas, Embryo introduction (Sulston et al. 1983), accessed 2026-10-15: ~30-cell stage (26-28 cells when Ea/Ep ingress)" ;
        schema:value "30" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-gastrulation-onset-movie-minute> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gastrulation onset, movie-minute = 73 min" ;
        dct:description "discrepancy: the atlas clock runs ~27 min ahead of the Sulston schedule at the same cell stage; not resolved by the script (temperature or time origin)" ;
        schema:measurementTechnique "same frame, frame index + movie start offset" ;
        schema:name "gastrulation onset, movie-minute" ;
        schema:unitText "min" ;
        schema:value "73" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-gastrulation-onset-movie-minute-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-gastrulation-onset-movie-minute-reference> a schema:PropertyValue ;
        dct:source "WormAtlas, Embryo introduction (Sulston et al. 1983), accessed 2026-10-15: Ea/Ep enter the embryo at 100 min after first cleavage" ;
        schema:value "100" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-lineage-names-parsing-as-sulston-names> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "lineage names parsing as Sulston names = 1330 count" ;
        schema:measurementTechnique "distinct names in the 360 nuclei files matching ^(AB|MS|E|C|D|EMS|P[0-4]|Z[23])[aplrdv]*$" ;
        schema:name "lineage names parsing as Sulston names" ;
        schema:unitText "count" ;
        schema:value "1330" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-lineage-names-parsing-as-sulston-names-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-lineage-names-parsing-as-sulston-names-reference> a schema:PropertyValue ;
        dct:source "all distinct names in the atlas" ;
        schema:value "1330" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-listed-dying-cells-that-occur-in-the-movie> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "listed dying cells that occur in the movie = 113 count" ;
        schema:measurementTechnique "CellDeaths.csv names present in at least one nuclei file" ;
        schema:name "listed dying cells that occur in the movie" ;
        schema:unitText "count" ;
        schema:value "113" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-listed-dying-cells-that-occur-in-the-movie-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-listed-dying-cells-that-occur-in-the-movie-reference> a schema:PropertyValue ;
        schema:value "113" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-maximum-nucleus-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "maximum nucleus count = 585 count" ;
        schema:measurementTechnique "maximum over the 360 frames" ;
        schema:name "maximum nucleus count" ;
        schema:unitText "count" ;
        schema:value "585" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-maximum-nucleus-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-maximum-nucleus-count-reference> a schema:PropertyValue ;
        dct:source "WormAtlas, Embryo introduction (Sulston et al. 1983), accessed 2026-10-15: ~550 cells at the end of proliferation (330-350 min)" ;
        schema:value "550" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-neurons-in-the-connectome-edge-list> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "neurons in the connectome edge list = 300 count" ;
        dct:description "CANL/CANR are 'no synapses' in the WormGUIDES parts list and so cannot appear in an edge list" ;
        schema:measurementTechnique "upper-case node names of c302 herm_full_edgelist.csv after DA01->DA1 canonicalisation" ;
        schema:name "neurons in the connectome edge list" ;
        schema:unitText "count" ;
        schema:value "300" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-neurons-in-the-connectome-edge-list-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-neurons-in-the-connectome-edge-list-reference> a schema:PropertyValue ;
        dct:source "Cook et al. 2019 / White et al. 1986: 302 hermaphrodite neurons" ;
        schema:value "302" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclear-cloud-width-at-the-last-frame> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nuclear cloud width at the last frame = 27.28 µm" ;
        dct:description "nuclei do not reach the eggshell; compare the eggshell width above" ;
        schema:measurementTechnique "y span of nuclear centroids + one mean diameter under the calibration" ;
        schema:name "nuclear cloud width at the last frame" ;
        schema:unitText "µm" ;
        schema:value "27.28" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclear-overrun-of-the-shell-in-x> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nuclear overrun of the shell in x = 19.0129 atlas units" ;
        dct:description "1.8 units at frame 330; the overrun is against the static early mesh, which is why the calibration uses the re-segmented shell" ;
        schema:measurementTechnique "largest distance by which a nucleus (centroid ± radius) lies outside the shell mesh's x range at the sampled frames" ;
        schema:name "nuclear overrun of the shell in x" ;
        schema:unitText "atlas units" ;
        schema:value "19.0129" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclei-at-movie-minute-330-350> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nuclei at movie-minute 330-350 = 562-571 count" ;
        schema:measurementTechnique "nucleus count over that window" ;
        schema:name "nuclei at movie-minute 330-350" ;
        schema:unitText "count" ;
        schema:value "562-571" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclei-at-movie-minute-330-350-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclei-at-movie-minute-330-350-reference> a schema:PropertyValue ;
        dct:source "WormAtlas, Embryo introduction (Sulston et al. 1983), accessed 2026-10-15: ~550 cells at 330-350 min" ;
        schema:value "550" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclei-at-the-last-frame> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nuclei at the last frame = 580 count" ;
        dct:description "the movie ends before hatching; 553 of the 580 nuclei carry a parts-list identity" ;
        schema:measurementTechnique "valid rows of t360-nuclei (movie-minute 379)" ;
        schema:name "nuclei at the last frame" ;
        schema:unitText "count" ;
        schema:value "580" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclei-at-the-last-frame-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-measurement-nuclei-at-the-last-frame-reference> a schema:PropertyValue ;
        dct:source "WormAtlas, Embryo introduction (Sulston et al. 1983), accessed 2026-10-15: 558 cells at hatching (671 generated, 113 deaths)" ;
        schema:value "558" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L348–L423" ;
        dct:description "shell_report(), measure(), gastrulation_onset(), and literature_checks()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L348-L423> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "celegans_four_views.png (generated output)" ;
        dct:description "annotated morphometric and lineage benchmarks — celegans_four_views.png: rendered output of 2015-santella-wormguides-celegans.py at 5659d5e, image/png, 424197 B, 2240×1680 px, artifact_sha256 eb4b60086280c9a1740358c26fc655598f25d2adad63a9fcdb9c3a7980cc3bd6 (sha256 eb4b60086280c9a1740358c26fc655598f25d2adad63a9fcdb9c3a7980cc3bd6)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-repro-package-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-repro-package-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Reproducibility package: 55/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Self-contained numpy + matplotlib script with pinned repository lockfile (requirements.lock.txt), but np.random.random((size, size)) on lines 19-20 is unseeded so every execution yields a different pattern trajectory, no CLI arguments are supported, and the output filename (turing_patterns_black_neon.gif) differs from docs/media/turing_gray_scott.gif." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-repro-package-2> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L19–L20" ;
        dct:description "unseeded np.random.random((size, size))" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L19-L20> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L75–L75" ;
        dct:description "hardcoded ani.save('turing_patterns_black_neon.gif')" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L75-L75> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


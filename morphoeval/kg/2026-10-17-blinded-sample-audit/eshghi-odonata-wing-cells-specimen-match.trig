sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-specimen-match-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-specimen-match-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Renders real fossil wing line drawings from Eshghi et al. (2026) at true millimetre scale colour-coded by per-cell Feret diameter alongside extant segmented wings from Hoffmann et al. (2018) (Arigomphus villosipes and Aeshna cyanea). Across the 67 non-swapped fossil wings, the independent re-segmentation matches Table S1 cell counts to a median signed difference of 0.0% (IQR -0.6% to +0.2%; 60/67 within 2%) and median cell length to +3.4%, while identifying two concrete curatorial errors in the published table (15_Cymatophlebia_longialata and the swapped 58/59 pair)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-specimen-match-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L422–L464" ;
        dct:description "resegment_all_fossils() and KNOWN_SOURCE_DISCREPANCIES" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2026-eshghi-odonata-wing-cells.py#L422-L464> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "datasets/odonata/fossil_wing_resegmentation.csv L1–L70" ;
        dct:description "69-wing comparison of Table S1 vs independent re-segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/datasets/odonata/fossil_wing_resegmentation.csv#L1-L70> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "odonata_fossil_resegmentation.png (generated output)" ;
        dct:description "four fossil wings rendered at common mm scale alongside parity scatters against Table S1 — odonata_fossil_resegmentation.png: rendered output of 2026-eshghi-odonata-wing-cells.py at 5659d5e, image/png, 286190 B, 1663×1323 px, artifact_sha256 ab6f3b9f89fbcff0ff1fa942915cfcb3736ebde60723489a9ee8d7a39c8a5b38 (sha256 ab6f3b9f89fbcff0ff1fa942915cfcb3736ebde60723489a9ee8d7a39c8a5b38)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


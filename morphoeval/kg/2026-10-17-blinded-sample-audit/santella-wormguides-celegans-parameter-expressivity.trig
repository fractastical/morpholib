        rdfs:label "2015-santella-wormguides-celegans.py L1–L23" ;
        dct:description "module docstring defines script as an empirical atlas and connectome decoder" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L1-L23> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


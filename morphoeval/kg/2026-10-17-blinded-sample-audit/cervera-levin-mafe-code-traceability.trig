sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-cervera-levin-mafe-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Code-to-model traceability: 68/100" ;
        rdfs:comment "At commit 5659d5e (following commit 0154143), model constants are centralized, f2_for_shift() properly inverts wavefront_for_f2() without clipping, and Panel D dynamically formats pulse bounds (1.0-16.0 h) and posterior head-readout percentages (91.8% vs 23.5%) from simulation state. Deducts 32 points because the 1D RD equations and the pharynx-posterior phenotype threshold (x*_b = 0.5833, which includes 20-unit plotting padding and a 100-unit cartoon pharynx convention) do not map to published equations in Cervera et al. (2021). Evidence: 2021-Cervera–Levin–Mafe.py L320–L359: pharynx-boundary criterion and unclipped f2_for_shift() <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L320-L359>; 2021-Cervera–Levin–Mafe.py L1271–L1318: Panel D dynamic pulse span and readout percentage labels <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L1271-L1318>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-code-traceability> ;
        pk:hasProbability "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-code-traceability> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dct:identifier "morphoeval/0.1.0/code-traceability" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bioelechem.2019.107410>,
            <https://doi.org/10.1016/j.biosystems.2021.104511>,
            <https://doi.org/10.1016/j.bpj.2019.01.029>,
            <https://doi.org/10.1016/j.ydbio.2009.12.012>,
            <https://doi.org/10.1093/bioinformatics/btt088> .
    <https://doi.org/10.1016/j.bioelechem.2019.107410> dct:date "2020"^^xsd:gYear ;
        dct:title "Bioelectrical model of head-tail patterning based on cell ion channels and intercellular gap junctions" .
    <https://doi.org/10.1016/j.biosystems.2021.104511> dct:date "2021"^^xsd:gYear ;
        dct:title "Morphology changes induced by intercellular gap junction blocking: A reaction-diffusion mechanism" .
    <https://doi.org/10.1016/j.bpj.2019.01.029> dct:date "2019"^^xsd:gYear ;
        dct:title "The Role of Early Bioelectric Signals in the Regeneration of Planarian Anterior/Posterior Polarity" .
    <https://doi.org/10.1016/j.ydbio.2009.12.012> dct:date "2010"^^xsd:gYear ;
        dct:title "Long-range neural and gap junction protein-mediated cues control polarity during planarian regeneration" .
    <https://doi.org/10.1093/bioinformatics/btt088> dct:date "2013"^^xsd:gYear ;
        dct:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .
}


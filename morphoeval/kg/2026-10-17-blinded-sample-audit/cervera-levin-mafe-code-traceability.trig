sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-code-traceability-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-code-traceability-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Code-to-model traceability: 68/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "At commit 5659d5e (following commit 0154143), model constants are centralized, f2_for_shift() properly inverts wavefront_for_f2() without clipping, and Panel D dynamically formats pulse bounds (1.0-16.0 h) and posterior head-readout percentages (91.8% vs 23.5%) from simulation state. Deducts 32 points because the 1D RD equations and the pharynx-posterior phenotype threshold (x*_b = 0.5833, which includes 20-unit plotting padding and a 100-unit cartoon pharynx convention) do not map to published equations in Cervera et al. (2021)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-code-traceability-2> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L320–L359" ;
        dct:description "pharynx-boundary criterion and unclipped f2_for_shift()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L320-L359> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L1271–L1318" ;
        dct:description "Panel D dynamic pulse span and readout percentage labels" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L1271-L1318> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


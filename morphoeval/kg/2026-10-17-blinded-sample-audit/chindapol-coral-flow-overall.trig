}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chindapol-coral-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chindapol-coral-flow-overall-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-chindapol-coral-flow-overall-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — MorphoEval overall 56.0/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Blinded second-assessor pass (gemini-4-argon). Replaces Chindapol et al.'s (2013) 3D COMSOL Navier-Stokes + advection-diffusion accretive growth model of Pocillopora verrucosa with a declared 2D lattice diffusion-limited aggregation (DLA) random walk with horizontal drift, reproducing qualitative upstream-bending and compactification trends across five drift values. Overall 56.0/100 (faithfulness 46.4, reproducibility 78.3; model-implementation 49.3/100, biological-validation 44.2/100, applicable-only overall 56.0/100; uncalibrated rubric score, not a calibrated probability); rubric morphoeval 0.1.0; checkpoint commit 5659d5e; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0. Dimension assessments: Model fidelity to source 38, Morphological realism / specimen match 42, Parameter expressivity 72, Morphometric validation 48, Source and data traceability 82, Code-to-model traceability 68, Reproducibility package 82. Output judged: chindapol_coral_flow_morphospace.png: rendered output of 2013-chindapol-coral-flow.py at 5659d5e, image/png, 235376 B, 1726×1231 px, artifact_sha256 c431f9a5ae368f84965ccd6e8762c61c5db8f77323de69daab92a26de99e1626 (sha256 c431f9a5ae368f84965ccd6e8762c61c5db8f77323de69daab92a26de99e1626)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1371/journal.pcbi.1002849> .
    <https://doi.org/10.1371/journal.pcbi.1002849> dct:date "2013"^^xsd:gYear ;
        dct:title "Modelling Growth and Form of the Scleractinian Coral Pocillopora verrucosa and the Influence of Hydrodynamics" .
}


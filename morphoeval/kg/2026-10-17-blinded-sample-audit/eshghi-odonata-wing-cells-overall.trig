sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-overall-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-overall-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — MorphoEval overall 87.3/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Blinded second-assessor pass (gemini-4-argon). Tests the macroevolutionary prediction of Hoffmann et al.'s (2018) inhibition-zone venation model (conserved inhibition length -> cell count N ~ L^2 and cell length ~ L^0) across 69 Mesozoic-Cenozoic fossil wings and 394 extant Odonata wings from Eshghi et al. (2026), and independently re-segments the 69 fossil wing line drawings from pixel scale bars to verify Table S1. Overall 87.3/100 (faithfulness 85.7, reproducibility 91.1; model-implementation 75.3/100, biological-validation 93.5/100, applicable-only overall 91.5/100; uncalibrated rubric score, not a calibrated probability); rubric morphoeval 0.1.0; checkpoint commit 5659d5e; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0. Dimension assessments: Model fidelity to source 88, Morphological realism / specimen match 92, Parameter expressivity 50, Morphometric validation 96, Source and data traceability 95, Code-to-model traceability 88, Reproducibility package 90. Output judged: odonata_fossil_resegmentation.png: rendered output of 2026-eshghi-odonata-wing-cells.py at 5659d5e, image/png, 286190 B, 1663×1323 px, artifact_sha256 ab6f3b9f89fbcff0ff1fa942915cfcb3736ebde60723489a9ee8d7a39c8a5b38 (sha256 ab6f3b9f89fbcff0ff1fa942915cfcb3736ebde60723489a9ee8d7a39c8a5b38)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.873"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


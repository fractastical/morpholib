sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-turing-gray-scott-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Parameter expressivity: 35/100" ;
        rdfs:comment "Runs only a single hardcoded parameter point (f=0.055, k=0.062) without CLI arguments or a multi-regime panel across Pearson's (1993) (f, k) phase space; only a brief inline comment mentions f=0.035, k=0.065. Evidence: 1952-turing-morpho.py L8–L9: single hardcoded (f, k) = (0.055, 0.062) <https://github.com/fractastical/morpholib/blob/5659d5e/1952-turing-morpho.py#L8-L9>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-parameter-expressivity> ;
        pk:hasProbability "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-parameter-expressivity> rdfs:label "Gray-Scott reaction-diffusion patterns (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Generic (Turing pattern formation)" ;
        dct:identifier "morphoeval/0.1.0/parameter-expressivity" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.261.5118.189> dct:date "1993"^^xsd:gYear ;
        dct:title "Complex patterns in a simple system" .
}


}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-morphometric-validation-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-morphometric-validation-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Morphometric validation: 62/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Performs an exhaustive structural audit of the database encoding in check_encoding() (verifying 555/565 geometric morphologies and 3,137/3,146 joints against the degree-radius rule), but the script itself does not compute silhouette IoU, segment-angle residuals, or landmark errors against Lobo et al. (2014b) Fig. 1 or real limb morphometrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-1-wild-type-right-forelimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-280-wild-type-right-hindlimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-314-wild-type-right-walking-leg-fiddler-crab>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-490-wild-type-right-metathoracic-t3-leg-cricket-nymph>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-491-wild-type-right-leg-i-huntsman-spider>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-digits-1-wild-type-right-forelimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-digits-280-wild-type-right-hindlimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-joints-obeying-the-radius-rule>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-morphologies-decoded>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-segments-1-wild-type-right-forelimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-segments-280-wild-type-right-hindlimb>,

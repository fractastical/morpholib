sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-specimen-match-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-specimen-match-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Morphological realism / specimen match: 76/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Renders six distinct shell archetypes (planispiral involute cf. Nautilus, high-spired turreted cf. Turritella, evolute planispiral cf. Dactylioceras, low-spired obconical cf. Conus, medium-spired cf. Cerithium, helicoid globose cf. Helix) whose 3D geometries and spire-height/width ratios (0.00 to 2.26) match their morphological descriptions. Deducts 24 points because no real mollusc shell photograph, CT scan, or empirical specimen dataset (such as Raup 1967) is overlaid or compared, and the six parameter sets are explicitly declared as illustrative \"cf.\" points rather than measurements of real specimens." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-3> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "datasets/raup/variables.json L18–L86" ;
        dct:description "six illustrative shell parameter sets with honest provenance note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/datasets/raup/variables.json#L18-L86> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "raup_empirical_comparison.png (generated output)" ;
        dct:description "6-panel 3D comparison of coiled shell archetypes — raup_empirical_comparison.png: rendered output of create_raup_animations.py at 5659d5e, image/png, 562658 B, 1630×1070 px, artifact_sha256 c50dbee57d0a64950d5470aed25583817eb8d39b97bcf2a7b89b991973f63ef7 (sha256 c50dbee57d0a64950d5470aed25583817eb8d39b97bcf2a7b89b991973f63ef7)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "raup_shell_metrics.csv L1–L8" ;
        dct:description "spire_over_width and outer_radius_ratio across the six archetypes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/raup_shell_metrics.csv#L1-L8> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2014.08.010>,
            <https://doi.org/10.1038/srep42445>,
            <https://doi.org/10.1126/science.138.3537.150>,
            <https://doi.org/10.1126/science.147.3663.1294>,
            <https://doi.org/10.2307/1301992>,
            <https://pubs.geoscienceworld.org/jpaleontol/article-abstract/41/1/43/80199/geometric-analysis-of-shell-coiling-coiling-in> .
    <https://doi.org/10.1016/j.jtbi.2014.08.010> dct:date "2014"^^xsd:gYear ;
        dct:title "Quantification and geometric analysis of coiling patterns in gastropod shells based on 3D and 2D image data" .
    <https://doi.org/10.1038/srep42445> dct:date "2017"^^xsd:gYear ;
        dct:title "Optimal designs of mollusk shells from bivalves to snails" .
    <https://doi.org/10.1126/science.138.3537.150> dct:date "1962"^^xsd:gYear ;
        dct:title "Computer as aid in describing form in gastropod shells" .
    <https://doi.org/10.1126/science.147.3663.1294> dct:date "1965"^^xsd:gYear ;
        dct:title "Theoretical morphology of the coiled shell" .
    <https://doi.org/10.2307/1301992> dct:date "1966"^^xsd:gYear ;
        dct:title "Geometric analysis of shell coiling: general problems" .
    <https://pubs.geoscienceworld.org/jpaleontol/article-abstract/41/1/43/80199/geometric-analysis-of-shell-coiling-coiling-in> dct:date "1967"^^xsd:gYear ;
        dct:title "Geometric analysis of shell coiling: coiling in ammonoids" .
}


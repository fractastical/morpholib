        rdfs:label "depth/length, Pomacanthus mean = 0.5873 ratio" ;
        schema:measurementTechnique "landmark extent in y over extent in x" ;
        schema:name "depth/length, Pomacanthus mean" ;
        schema:unitText "ratio" ;
        schema:value "0.5873" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-depth-length-scarus-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "depth/length, Scarus mean = 0.3772 ratio" ;
        schema:measurementTechnique "landmark extent in y over extent in x" ;
        schema:name "depth/length, Scarus mean" ;
        schema:unitText "ratio" ;
        schema:value "0.3772" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-leave-one-landmark-out-rms-of-the-oblique-coaxial-family> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "leave-one-landmark-out RMS of the oblique coaxial family = 0.0371 Procrustes units" ;
        dct:description "compare with the Procrustes distance: the family has no predictive value for held-out landmarks if it is not smaller" ;
        schema:measurementTechnique "each landmark predicted by the 8-parameter map fitted to the other 16" ;
        schema:name "leave-one-landmark-out RMS of the oblique coaxial family" ;
        schema:unitText "Procrustes units" ;
        schema:value "0.0371" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-moebius-residual-isogonal-coaxial-circles> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Moebius residual (isogonal coaxial circles) = 0.0311 Procrustes units" ;
        dct:description "explains 0.8 %: a conformal map cannot change the depth/length ratio" ;
        schema:measurementTechnique "RMS after a least-squares Moebius map z -> (az+b)/(cz+1), the conformal map that turns the Cartesian grid into two orthogonal pencils of coaxial circles" ;
        schema:name "Moebius residual (isogonal coaxial circles)" ;
        schema:unitText "Procrustes units" ;
        schema:value "0.0311" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-oblique-coaxial-circle-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "oblique coaxial-circle residual = 0.0256 Procrustes units" ;
        dct:description "explains 32.4 %" ;
        schema:measurementTechnique "RMS after an affine map followed by z -> z/(cz+1) (8 parameters): coaxial circles whose two pencils need not be orthogonal, the family Thompson's Fig. 376 belongs to as drawn" ;
        schema:name "oblique coaxial-circle residual" ;
        schema:unitText "Procrustes units" ;
        schema:value "0.0256" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-percentile-of-scarus-pomacanthus-among-all-genus-pairs-oblique-coaxial-explained-share> a schema:PropertyValue,

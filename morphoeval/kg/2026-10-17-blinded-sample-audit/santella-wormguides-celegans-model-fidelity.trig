sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-santella-wormguides-celegans> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-santella-wormguides-celegans-model-fidelity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-santella-wormguides-celegans-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Model fidelity to source: 84/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Accurately decodes StarryNite/AceTree nuclei tables following AceTreeTableLineageDataLoader column conventions, parses time offsets from ProductionInfo.csv, verifies the Sulston naming grammar on all 1,330 cell names and parent-before-child ordering on 1,326/1,326 cells, reconstructs the lineage bifurcation tree directly from cell names, and calibrates spatial coordinates using the re-segmented frame-330 eggshell mesh (50 um / 303.1 units = 0.1649 um/unit). Deducts 16 points because the 3D embryo and 51 single-cell OBJ meshes are rendered as 2D orthographic projections rather than full 3D surfaces, and the c302 connectome is collapsed into a single summed adjacency matrix without separating chemical synapses from gap junctions." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L254–L319" ;
        dct:description "read_nuclei(), movie_offset(), founder(), parent_of(), and check_encoding()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L254-L319> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L335–L368" ;
        dct:description "calibrate(), shell_report(), and nuclear_cloud_scale()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L335-L368> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-santella-wormguides-celegans-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2015-santella-wormguides-celegans.py L564–L595" ;
        dct:description "canonical_cell() and draw_connectome()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L564-L595> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


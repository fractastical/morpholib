sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-santella-wormguides-celegans-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome — Model fidelity to source: 84/100" ;
        rdfs:comment "Accurately decodes StarryNite/AceTree nuclei tables following AceTreeTableLineageDataLoader column conventions, parses time offsets from ProductionInfo.csv, verifies the Sulston naming grammar on all 1,330 cell names and parent-before-child ordering on 1,326/1,326 cells, reconstructs the lineage bifurcation tree directly from cell names, and calibrates spatial coordinates using the re-segmented frame-330 eggshell mesh (50 um / 303.1 units = 0.1649 um/unit). Deducts 16 points because the 3D embryo and 51 single-cell OBJ meshes are rendered as 2D orthographic projections rather than full 3D surfaces, and the c302 connectome is collapsed into a single summed adjacency matrix without separating chemical synapses from gap junctions. Evidence: 2015-santella-wormguides-celegans.py L254–L319: read_nuclei(), movie_offset(), founder(), parent_of(), and check_encoding() <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L254-L319>; 2015-santella-wormguides-celegans.py L335–L368: calibrate(), shell_report(), and nuclear_cloud_scale() <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L335-L368>; 2015-santella-wormguides-celegans.py L564–L595: canonical_cell() and draw_connectome() <https://github.com/fractastical/morpholib/blob/5659d5e/2015-santella-wormguides-celegans.py#L564-L595>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-model-fidelity> ;
        pk:hasProbability "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-santella-wormguides-celegans-model-fidelity> rdfs:label "WormGUIDES C. elegans embryo atlas with the OpenWorm connectome (2015-santella-wormguides-celegans.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Caenorhabditis elegans embryo, 4-cell stage to ~580 nuclei (strain JIM113, diSPIM series DISPIM_061416)" ;
        dct:identifier "morphoeval/0.1.0/model-fidelity" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0012-1606(83)90201-4>,
            <https://doi.org/10.1038/s41586-019-1352-7>,
            <https://doi.org/10.1083/jcb.144.5.927>,
            <https://doi.org/10.1098/rstb.2017.0382>,
            <https://doi.org/10.1186/s12859-015-0627-8> .
    <https://doi.org/10.1016/0012-1606(83)90201-4> dct:date "1983"^^xsd:gYear ;
        dct:title "The embryonic cell lineage of the nematode Caenorhabditis elegans" .
    <https://doi.org/10.1038/s41586-019-1352-7> dct:date "2019"^^xsd:gYear ;
        dct:title "Whole-animal connectomes of both Caenorhabditis elegans sexes" .
    <https://doi.org/10.1083/jcb.144.5.927> dct:date "1999"^^xsd:gYear ;
        dct:title "Dissection of cell division processes in the one cell stage Caenorhabditis elegans embryo by mutational analysis" .
    <https://doi.org/10.1098/rstb.2017.0382> dct:date "2018"^^xsd:gYear ;
        dct:title "OpenWorm: overview and recent advances in integrative biological simulation of Caenorhabditis elegans" .
    <https://doi.org/10.1186/s12859-015-0627-8> dct:date "2015"^^xsd:gYear ;
        dct:title "WormGUIDES: an interactive single cell developmental atlas and tool for collaborative multidimensional data exploration" .
}


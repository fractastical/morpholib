sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thompson-scarus-pomacanthus> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-repro-package-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-repro-package-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus transformation fitted to real species — Reproducibility package: 90/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Deterministic optimization seeds (np.random.default_rng(1917)), CLI flags (--no-scan, --no-photos, --out, --outline-out, --metrics-out), self_test() assertion gate, and pinned dependencies in requirements.txt / requirements.lock.txt. Deducts 10 points because the outline comparison depends on runtime HTTP fetches to Wikimedia Commons when .thompson_cache/ is cold." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L305–L319" ;
        dct:description "deterministic RNG seeding np.random.default_rng(1917) in multi-start optimizer" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/thompson/1917-thompson-scarus-pomacanthus.py#L305-L319> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L983–L1025" ;
        dct:description "CLI argument parser supporting --out, --outline-out, --metrics-out, --no-scan, and --no-photos" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/thompson/1917-thompson-scarus-pomacanthus.py#L983-L1025> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L35" ;
        dct:description "exact environment lockfile pinning Python 3.14.7 and package versions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/requirements.lock.txt#L1-L35> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-blinded-sample-audit-cervera-levin-mafe-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Morphometric validation: 54/100" ;
        rdfs:comment "Fits a 1-parameter linear mapping f2(p) = 1 - a*p to Oviedo et al. (2010) octanol double-head frequencies across 4 axial crop positions (training RMSE = 4.19 percentage points) and evaluates it without refitting on held-out triple-innexin RNAi crops (test RMSE = 23.52 percentage points, r = 0.943), while verifying rusty-matter trace parity across all 5 scenarios (max |delta| = 0.0332) and computing Planform #1 vs #2 silhouette IoU (0.9478). Held at 54 because the 4-point empirical sample is tiny, the 23.5-point held-out error is large, and no morphometric dimensions of real regenerated double-head specimens are measured. Evidence: 2021-Cervera–Levin–Mafe.py L997–L1026: 1-parameter octanol training fit and held-out RNAi evaluation <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L997-L1026>; cervera_levin_mafe_metrics.csv L1–L55: exported wavefront, silhouette-area, and empirical fit metrics <https://github.com/fractastical/morpholib/blob/5659d5e/cervera_levin_mafe_metrics.csv#L1-L55>. Measurements (measure_outputs.py): rusty-matter trace parity, max |Δ| = 0.0332 state units (reference 0.0, MesmerPrism/rusty-matter commit ad111fa7ecfd8f43d292ff3b1d27d3af2741d828) [maximum absolute difference across all 5 scenarios, 11 sampled steps and 4 state averages against rusty_matter_planarian_traces.json]; symmetric RD wavefront x*(f2=1) = 0.5 AP fraction (reference 0.5, symmetric boundary conditions at x=0 and x=L) [zero crossing of m1(x) - m2(x) when D2 = D2_0]; pharynx-boundary criterion x*_b = 0.5833 AP fraction [posterior end of the Planform #1 wild-type pharynx on the AP extent] — crossed at f2_b = 0.4197 (where x*(f2_b) = 0.5833); anterior body-area fraction on S. mediterranea silhouette (f2=1 -> f2=0.25) = 0.1561 fraction of body area [increase in real-silhouette mask area anterior to x*(f2) from f2=1.0 (0.483) to f2=0.25 (0.639)]; ML centre/edge ratio λ(f3), f3=1.0 vs f3=0.3 = 0.1855 ratio difference (reference >0 (monotonic decrease under lateral gap-junction blockade)) [m3(L_z/2)/m3(0) drop from f3=1.0 (0.197) to f3=0.3 (0.011)]; Oviedo 2010 octanol crop-gradient training RMSE = 4.1871 percentage points (reference 0.0, PlanformDB 2.5.0 / Oviedo et al. 2010 Dev. Biol. 339:188) [1-parameter fit f2(p) = 1 - 0.58*p against Oviedo et al. 2010 octanol double-head frequencies (Exps 415-418, n=4 crops)]; Oviedo 2010 triple-innexin RNAi held-out RMSE = 23.5215 percentage points (reference 0.0, PlanformDB 2.5.0 / Oviedo et al. 2010 Dev. Biol. 339:188) [held-out prediction error of the octanol-fitted curve against Dj-Inx-12 + Dj-Inx-5/13 RNAi double-head frequencies (Exps 446-449, n=4 crops)] — Pearson r = 0.943; circuit posterior head readout, memory ON vs memory OFF control = 0.9185 readout [0,1] (reference 0.23491399812436778, TransientDepolarizationNoMemoryControl negative control (Durant et al. 2019 Biophys. J. 116:948)) [final posterior head-identity readout R_head,post under TransientDepolarizationMemory] — hysteresis memory sustains depolarised head fate after transient pulse ends; Planform #1 Wild Type vs #2 Double Head silhouette IoU = 0.9478 ratio (reference <1.0 (posterior tail replaced by ectopic head cap), PlanformDB 2.5.0 morphologies #1 and #2) [256x256 shared-canvas intersection-over-union of decoded Lobo et al. (2013) graph silhouettes]." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-morphometric-validation> ;
        pk:hasProbability "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-cervera-levin-mafe-morphometric-validation> rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis (2021-Cervera–Levin–Mafe.py, 2013-lobo-planform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Planarians; photograph is Schmidtea mediterranea, empirical PlanformDB subset is Dugesia japonica" ;
        dct:identifier "morphoeval/0.1.0/morphometric-validation" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" .
}


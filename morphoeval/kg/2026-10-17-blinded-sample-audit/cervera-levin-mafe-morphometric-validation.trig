sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cervera-levin-mafe> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-morphometric-validation-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cervera-levin-mafe-morphometric-validation-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Cervera–Levin–Mafe gap-junction reaction–diffusion and bioelectric synthesis — Morphometric validation: 54/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Fits a 1-parameter linear mapping f2(p) = 1 - a*p to Oviedo et al. (2010) octanol double-head frequencies across 4 axial crop positions (training RMSE = 4.19 percentage points) and evaluates it without refitting on held-out triple-innexin RNAi crops (test RMSE = 23.52 percentage points, r = 0.943), while verifying rusty-matter trace parity across all 5 scenarios (max |delta| = 0.0332) and computing Planform #1 vs #2 silhouette IoU (0.9478). Held at 54 because the 4-point empirical sample is tiny, the 23.5-point held-out error is large, and no morphometric dimensions of real regenerated double-head specimens are measured." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-anterior-body-area-fraction-on-s-mediterranea-silhouette-f2-1-f2-0-25>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-circuit-posterior-head-readout-memory-on-vs-memory-off-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-ml-centre-edge-ratio-f3-f3-1-0-vs-f3-0-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-oviedo-2010-octanol-crop-gradient-training-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-oviedo-2010-triple-innexin-rnai-held-out-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-pharynx-boundary-criterion-x-b>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-planform-1-wild-type-vs-2-double-head-silhouette-iou>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-rusty-matter-trace-parity-max>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-symmetric-rd-wavefront-x-f2-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-morphometric-validation-2> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-anterior-body-area-fraction-on-s-mediterranea-silhouette-f2-1-f2-0-25> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anterior body-area fraction on S. mediterranea silhouette (f2=1 -> f2=0.25) = 0.1561 fraction of body area" ;
        schema:measurementTechnique "increase in real-silhouette mask area anterior to x*(f2) from f2=1.0 (0.483) to f2=0.25 (0.639)" ;
        schema:name "anterior body-area fraction on S. mediterranea silhouette (f2=1 -> f2=0.25)" ;
        schema:unitText "fraction of body area" ;
        schema:value "0.1561" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-circuit-posterior-head-readout-memory-on-vs-memory-off-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "circuit posterior head readout, memory ON vs memory OFF control = 0.9185 readout [0,1]" ;
        dct:description "hysteresis memory sustains depolarised head fate after transient pulse ends" ;
        schema:measurementTechnique "final posterior head-identity readout R_head,post under TransientDepolarizationMemory" ;
        schema:name "circuit posterior head readout, memory ON vs memory OFF control" ;
        schema:unitText "readout [0,1]" ;
        schema:value "0.9185" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-circuit-posterior-head-readout-memory-on-vs-memory-off-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-circuit-posterior-head-readout-memory-on-vs-memory-off-control-reference> a schema:PropertyValue ;
        dct:source "TransientDepolarizationNoMemoryControl negative control (Durant et al. 2019 Biophys. J. 116:948)" ;
        schema:value "0.23491399812436778" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-ml-centre-edge-ratio-f3-f3-1-0-vs-f3-0-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ML centre/edge ratio λ(f3), f3=1.0 vs f3=0.3 = 0.1855 ratio difference" ;
        schema:measurementTechnique "m3(L_z/2)/m3(0) drop from f3=1.0 (0.197) to f3=0.3 (0.011)" ;
        schema:name "ML centre/edge ratio λ(f3), f3=1.0 vs f3=0.3" ;
        schema:unitText "ratio difference" ;
        schema:value "0.1855" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-ml-centre-edge-ratio-f3-f3-1-0-vs-f3-0-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-ml-centre-edge-ratio-f3-f3-1-0-vs-f3-0-3-reference> a schema:PropertyValue ;
        schema:value ">0 (monotonic decrease under lateral gap-junction blockade)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-oviedo-2010-octanol-crop-gradient-training-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Oviedo 2010 octanol crop-gradient training RMSE = 4.1871 percentage points" ;
        schema:measurementTechnique "1-parameter fit f2(p) = 1 - 0.58*p against Oviedo et al. 2010 octanol double-head frequencies (Exps 415-418, n=4 crops)" ;
        schema:name "Oviedo 2010 octanol crop-gradient training RMSE" ;
        schema:unitText "percentage points" ;
        schema:value "4.1871" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-oviedo-2010-octanol-crop-gradient-training-rmse-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-oviedo-2010-octanol-crop-gradient-training-rmse-reference> a schema:PropertyValue ;
        dct:source "PlanformDB 2.5.0 / Oviedo et al. 2010 Dev. Biol. 339:188" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-oviedo-2010-triple-innexin-rnai-held-out-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Oviedo 2010 triple-innexin RNAi held-out RMSE = 23.5215 percentage points" ;
        dct:description "Pearson r = 0.943" ;
        schema:measurementTechnique "held-out prediction error of the octanol-fitted curve against Dj-Inx-12 + Dj-Inx-5/13 RNAi double-head frequencies (Exps 446-449, n=4 crops)" ;
        schema:name "Oviedo 2010 triple-innexin RNAi held-out RMSE" ;
        schema:unitText "percentage points" ;
        schema:value "23.5215" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-oviedo-2010-triple-innexin-rnai-held-out-rmse-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-oviedo-2010-triple-innexin-rnai-held-out-rmse-reference> a schema:PropertyValue ;
        dct:source "PlanformDB 2.5.0 / Oviedo et al. 2010 Dev. Biol. 339:188" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-pharynx-boundary-criterion-x-b> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pharynx-boundary criterion x*_b = 0.5833 AP fraction" ;
        dct:description "crossed at f2_b = 0.4197 (where x*(f2_b) = 0.5833)" ;
        schema:measurementTechnique "posterior end of the Planform #1 wild-type pharynx on the AP extent" ;
        schema:name "pharynx-boundary criterion x*_b" ;
        schema:unitText "AP fraction" ;
        schema:value "0.5833" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-planform-1-wild-type-vs-2-double-head-silhouette-iou> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Planform #1 Wild Type vs #2 Double Head silhouette IoU = 0.9478 ratio" ;
        schema:measurementTechnique "256x256 shared-canvas intersection-over-union of decoded Lobo et al. (2013) graph silhouettes" ;
        schema:name "Planform #1 Wild Type vs #2 Double Head silhouette IoU" ;
        schema:unitText "ratio" ;
        schema:value "0.9478" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-planform-1-wild-type-vs-2-double-head-silhouette-iou-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-planform-1-wild-type-vs-2-double-head-silhouette-iou-reference> a schema:PropertyValue ;
        dct:source "PlanformDB 2.5.0 morphologies #1 and #2" ;
        schema:value "<1.0 (posterior tail replaced by ectopic head cap)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-rusty-matter-trace-parity-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rusty-matter trace parity, max |Δ| = 0.0332 state units" ;
        schema:measurementTechnique "maximum absolute difference across all 5 scenarios, 11 sampled steps and 4 state averages against rusty_matter_planarian_traces.json" ;
        schema:name "rusty-matter trace parity, max |Δ|" ;
        schema:unitText "state units" ;
        schema:value "0.0332" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-rusty-matter-trace-parity-max-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-rusty-matter-trace-parity-max-reference> a schema:PropertyValue ;
        dct:source "MesmerPrism/rusty-matter commit ad111fa7ecfd8f43d292ff3b1d27d3af2741d828" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-symmetric-rd-wavefront-x-f2-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "symmetric RD wavefront x*(f2=1) = 0.5 AP fraction" ;
        schema:measurementTechnique "zero crossing of m1(x) - m2(x) when D2 = D2_0" ;
        schema:name "symmetric RD wavefront x*(f2=1)" ;
        schema:unitText "AP fraction" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-symmetric-rd-wavefront-x-f2-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-measurement-symmetric-rd-wavefront-x-f2-1-reference> a schema:PropertyValue ;
        dct:source "symmetric boundary conditions at x=0 and x=L" ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2021-Cervera–Levin–Mafe.py L997–L1026" ;
        dct:description "1-parameter octanol training fit and held-out RNAi evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2021-Cervera–Levin–Mafe.py#L997-L1026> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cervera-levin-mafe-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "cervera_levin_mafe_metrics.csv L1–L55" ;
        dct:description "exported wavefront, silhouette-area, and empirical fit metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/cervera_levin_mafe_metrics.csv#L1-L55> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


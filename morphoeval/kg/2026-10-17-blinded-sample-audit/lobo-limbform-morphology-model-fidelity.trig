@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-model-fidelity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Model fidelity to source: 88/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Faithfully decodes LimbformDB 2.1.0's five-table relational graph (Morphology, Link, JointParam, LinkSubJoint, Digit) using recursive vector accumulation, cyclic half-angle bisectors at branching joints, +90/+180/+270 deg terminal caps, double-counted host segments at ectopic sub-joints, and periodic Catmull-Rom splines, satisfying the joint-radius count rule on 3,137 of 3,146 joints (99.71%). Deducts 12 points because Link.side, Link.reversed, Link.inverted, and Digit.reversed are parsed into dataclasses (lines 146-148, 165) but never used in layout() or draw_morphology(), and because 9 mutant joints require mean-radius padding." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L140–L178" ;
        dct:description "Link, SubJoint, Digit, and Morphology dataclasses (including unused side/reversed/inverted fields)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L140-L178> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L275–L421" ;
        dct:description "layout(), _edges_of(), and control_points() implementing recursive tree layout and bisector radii" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L275-L421> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L606–L620" ;
        dct:description "check_encoding() verifies 3,137/3,146 joints match the radius rule" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2014-lobo-limbform-morphology.py#L606-L620> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582>,
            <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
    <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> dct:title "LimbformDB 2.1.0 (31 Jul 2014), the Limbform database file" .
}


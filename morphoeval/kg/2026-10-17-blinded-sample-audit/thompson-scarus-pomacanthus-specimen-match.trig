sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thompson-scarus-pomacanthus> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-specimen-match-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-specimen-match-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus transformation fitted to real species — Morphological realism / specimen match: 86/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Evaluates transformations directly against both Procrustes-aligned landmark means of 48 Scarus and 6 Pomacanthus species (plus 791 species across four Thompson fish pairs) and real biological specimen photographs (Scarus ghobban and Pomacanthus semicirculatus), overlayed alongside Thompson's 1917 original scan (Figs. 375-376) in Panel A. Deducts 14 points because silhouette registration uses a 2-anchor similarity transform (snout tip to LM2 and caudal peduncle minimum width to midpoint(LM5, LM6)) rather than 17 landmarks digitised directly on those two photographed individuals, and compares a preserved specimen with collapsed fins against a live swimming fish with extended dorsal/anal filaments." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L524–L650" ;
        dct:description "segment_scarus_photo(), segment_pomacanthus_photo(), and register_outline_to_landmarks()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/thompson/1917-thompson-scarus-pomacanthus.py#L524-L650> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson_scarus_pomacanthus.png (generated output)" ;
        dct:description "Panel A reproduces Thompson 1917 p. 749 scan; Panels B-F compare fitted families on consensus shapes — thompson_scarus_pomacanthus.png: rendered output of thompson/1917-thompson-scarus-pomacanthus.py at 5659d5e, image/png, 739620 B, 2520×1540 px, artifact_sha256 d243f51e2b90b1a2201ec81265392b1cf95ea0f0e6e68074818cc5754b324e08 (sha256 d243f51e2b90b1a2201ec81265392b1cf95ea0f0e6e68074818cc5754b324e08)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "thompson_scarus_pomacanthus_outlines.png (generated output)" ;
        dct:description "segmented photos of S. ghobban and P. semicirculatus warped across all five transformation families — thompson_scarus_pomacanthus_outlines.png: rendered output of thompson/1917-thompson-scarus-pomacanthus.py at 5659d5e, image/png, 903004 B, 2520×1470 px, artifact_sha256 df6479f9f47f28fc341f29ff25d2dbf5a612e34215492d2c23cae956105a16f8 (sha256 df6479f9f47f28fc341f29ff25d2dbf5a612e34215492d2c23cae956105a16f8)" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


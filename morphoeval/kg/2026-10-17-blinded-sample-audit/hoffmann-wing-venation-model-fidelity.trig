sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-model-fidelity-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-model-fidelity-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Model fidelity to source: 82/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Implements the core SI 3.3-3.4 pipeline on the real wing boundary and primary-vein scaffold: local density weighting proportional to 1/cell^2, damped Lloyd equilibration (step 0.55) inside the primary-vein compartments, and secondary veins drawn as Voronoi bisectors between sites sharing the same primary compartment. Deducts 18 points because local cell size is derived from the Euclidean distance transform of the real wing's all-vein mask (dt) rather than from primary-vein thickness as in the paper, and Lloyd relaxation terminates after a fixed n_iter=18 iterations rather than the paper's 0.1%-of-wing-length displacement threshold." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-model-fidelity-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L111–L133" ;
        dct:description "segment_wing() derives local cell size from distance_transform_edt(~vein)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L111-L133> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L164–L195" ;
        dct:description "model_wing() seeds n_cells weighted by 1/cell^2 and runs n_iter=18 fixed Lloyd iterations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5659d5e/2018-hoffmann-wing-venation.py#L164-L195> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


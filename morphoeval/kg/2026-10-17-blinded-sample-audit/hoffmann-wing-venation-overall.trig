sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-overall-second-assessor-gemini-4-argon> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-overall-second-assessor-gemini-4-argon> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — MorphoEval overall 81.3/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Blinded second-assessor pass (gemini-4-argon). Implements Hoffmann et al.'s (2018) SI 3.3-3.4 secondary-vein model (density-weighted seeding, damped centroidal-Voronoi / Lloyd equilibration, and Voronoi bisectors) on the segmented primary-vein scaffold of Arigomphus villosipes (923 vein domains), comparing circularity, area, and proximal-distal trends against the real wing and the regular-hexagon ceiling. Overall 81.3/100 (faithfulness 81.5, reproducibility 80.8; model-implementation 77.3/100, biological-validation 84.6/100, applicable-only overall 81.3/100; uncalibrated rubric score, not a calibrated probability); rubric morphoeval 0.1.0; checkpoint commit 5659d5e; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0. Dimension assessments: Model fidelity to source 82, Morphological realism / specimen match 85, Parameter expressivity 68, Morphometric validation 84, Source and data traceability 84, Code-to-model traceability 78, Reproducibility package 80. Output judged: hoffmann_wing_recapitulation.png: rendered output of 2018-hoffmann-wing-venation.py at 5659d5e, image/png, 179027 B, 1730×1206 px, artifact_sha256 43b99ec8ae8205b3f12cfd0cde6d3ab1935463e222f66a0f5c16ec15d49e1108 (sha256 43b99ec8ae8205b3f12cfd0cde6d3ab1935463e222f66a0f5c16ec15d49e1108)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.813"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Cursor agent, blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila silvestris Turing wavenumber at 2.995 µm (Holocene, 0 Ma) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Schnakenberg steady state, Jacobian, and k_c^2 = gamma (D_v f_u + D_u g_v) / (2 D_u D_v) are implemented and checked (trace < 0, det > 0, lambda = 2.995 µm at gamma = 1). The pass-1 wavelength readout is a single Fourier bin, so the numerical lambda sits systematically off the curve." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila silvestris Turing wavenumber at 2.995 µm (Holocene, 0 Ma) — Morphometric validation: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Equal-diffusion ablation gives sigma_max = -0.586 against +0.142 in the ocellus regime. Wavenumber ratio versus D. serrata is 30.80 (bound 30). KS versus the free field is 0.109. Wavelength RMSE and the speckled mask are not yet a clean goodness-of-fit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-ks-distance-of-sobel-orientation-specimen-versus-free-turing-field>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-nonlinear-early-frame-wavenumber-over-linear-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-pearson-r-of-fft-wavenumber-versus-dispersion-k-c-across-gamma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-rmse-of-numerical-versus-analytical-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-foreground-fraction-kilohana-voucher-segmentation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-pigment-connected-component-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-wavenumber-ratio-versus-drosophila-serrata-predecessor>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation max growth rate = -0.5857 1/time" ;
        dct:description "ocellus d=20 sigma_max 0.1421; stripe contrasts d=8 -0.2639, d=10 -0.1479" ;
        schema:measurementTechnique "max_k Re sigma(k) at D_v = D_u (d = 1), same D_u as the ocellus regime" ;
        schema:name "equal-diffusion ablation max growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.5857" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusivities cannot satisfy the diffusion-driven instability" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-ks-distance-of-sobel-orientation-specimen-versus-free-turing-field> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS distance of Sobel orientation, specimen versus free Turing field = 0.1085 KS" ;
        dct:description "last-frame versus specimen KS 0.0119" ;
        schema:measurementTechnique "12-bin magnitude-weighted Sobel orientation histograms, discrete Kolmogorov-Smirnov" ;
        schema:name "KS distance of Sobel orientation, specimen versus free Turing field" ;
        schema:unitText "KS" ;
        schema:value "0.1085" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-ks-distance-of-sobel-orientation-specimen-versus-free-turing-field-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-ks-distance-of-sobel-orientation-specimen-versus-free-turing-field-reference> a schema:PropertyValue ;
        dct:source "Identical orientation spectra would give KS = 0; the free field is not the photograph" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-nonlinear-early-frame-wavenumber-over-linear-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear early-frame wavenumber over linear k_c = 0.8486 k_nl/k_c" ;
        dct:description "k_c 6.2832, early 5.3318, saturated 5.7067" ;
        schema:measurementTechnique "power-weighted spectral centroid of nonlinear snapshot 3, divided by the closed-form k_c at gamma=1" ;
        schema:name "nonlinear early-frame wavenumber over linear k_c" ;
        schema:unitText "k_nl/k_c" ;
        schema:value "0.8486" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-nonlinear-early-frame-wavenumber-over-linear-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-nonlinear-early-frame-wavenumber-over-linear-k-c-reference> a schema:PropertyValue ;
        dct:source "Linear onset should select k_c; saturation can shift the peak" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-pearson-r-of-fft-wavenumber-versus-dispersion-k-c-across-gamma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r of FFT wavenumber versus dispersion k_c across gamma = 0.9981 Pearson r" ;
        dct:description "lambda Pearson r 0.9972; RMSE 0.2084 µm; reference-table r 1.0000" ;
        schema:measurementTechnique "12-point sweep of reaction scale gamma; dominant Fourier mode of the linearised PDE versus closed-form k_c" ;
        schema:name "Pearson r of FFT wavenumber versus dispersion k_c across gamma" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9981" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-pearson-r-of-fft-wavenumber-versus-dispersion-k-c-across-gamma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-pearson-r-of-fft-wavenumber-versus-dispersion-k-c-across-gamma-reference> a schema:PropertyValue ;
        dct:source "Exact agreement with the Turing dispersion relation would give r = 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-rmse-of-numerical-versus-analytical-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RMSE of numerical versus analytical wavelength = 0.2084 µm" ;
        dct:description "at gamma nearest 1, numerical lambda 3.3983 µm versus 2.995 µm" ;
        schema:measurementTechnique "root mean square of lambda_FFT - lambda_dispersion over the gamma sweep" ;
        schema:name "RMSE of numerical versus analytical wavelength" ;
        schema:unitText "µm" ;
        schema:value "0.2084" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-rmse-of-numerical-versus-analytical-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-rmse-of-numerical-versus-analytical-wavelength-reference> a schema:PropertyValue ;
        dct:source "Zero error is the dispersion identity; the grid returns the nearest Fourier mode" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-foreground-fraction-kilohana-voucher-segmentation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction (Kilohana voucher segmentation) = 0.5705 area fraction" ;
        dct:description "pigment fraction 0.0100, red-eye fraction 0.0125, circularity 0.0195" ;
        schema:measurementTechnique "border-median contrast mask, close, fill holes" ;
        schema:name "specimen foreground fraction (Kilohana voucher segmentation)" ;
        schema:unitText "area fraction" ;
        schema:value "0.5705" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-foreground-fraction-kilohana-voucher-segmentation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-foreground-fraction-kilohana-voucher-segmentation-reference> a schema:PropertyValue ;
        dct:source "Neutral occupancy prior; the measured mask is not forced to 0.50" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-pigment-connected-component-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen pigment connected-component count = 17 components" ;
        dct:description "Pass-1 raw dark-foreground components 705; pass-2 wing-band size filter keeps this count. It is not the tibial cilia count." ;
        schema:measurementTechnique "gray < 0.22 inside foreground, red-eye pixels removed, 8-connected label" ;
        schema:name "specimen pigment connected-component count" ;
        schema:unitText "components" ;
        schema:value "17" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-pigment-connected-component-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-pigment-connected-component-count-reference> a schema:PropertyValue ;
        dct:source "Carson & Bryant 1979 midpoint of the 20-30 extra tibial cilia, a different character; not a wing-spot count" ;
        schema:value "25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5176 coherency" ;
        dct:description "foreground aspect ratio (width/height) 1.251" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Gaussian-smoothed structure tensor on the foreground" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5176" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "Placeholder anisotropy prior; measured coherency is independent of this prior" ;
        schema:value "0.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-wavenumber-ratio-versus-drosophila-serrata-predecessor> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavenumber ratio versus Drosophila serrata predecessor = 30.8047 k_this/k_pred" ;
        dct:description "successor ratio k_this/k_simulans 27.5659 versus bound 27" ;
        schema:measurementTechnique "lambda_serrata / lambda_silvestris with lambda_serrata = 9.226e-5 m and lambda_silvestris = 2.995e-6 m" ;
        schema:name "wavenumber ratio versus Drosophila serrata predecessor" ;
        schema:unitText "k_this/k_pred" ;
        schema:value "30.8047" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-wavenumber-ratio-versus-drosophila-serrata-predecessor-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-measurement-wavenumber-ratio-versus-drosophila-serrata-predecessor-reference> a schema:PropertyValue ;
        dct:source "Lean theorem wavenumber_exceeds_predecessor_by_thirty (strict lower bound, not the ratio itself)" ;
        schema:value "30.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-silvestris-turing-wavelength-s0.py L205–L216" ;
        dct:description "ablation sigma at d = 1, 8, 10, 20" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0dc967f22ddaa01ca809b3701e8da57313f6c44d/models/2026-delphi10000-drosophila-silvestris-turing-wavelength-s0.py#L205-L216> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/nature03235>,
            <https://doi.org/10.1073/pnas.76.4.1929>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/nature03235> dct:date "2005"^^xsd:gYear ;
        dct:title "Chance caught on the wing: cis-regulatory evolution and the origin of pigment patterns in Drosophila" .
    <https://doi.org/10.1073/pnas.76.4.1929> dct:date "1979"^^xsd:gYear ;
        dct:title "Change in a secondary sexual character as evidence of incipient speciation in Drosophila silvestris" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1179047> dct:date "2010"^^xsd:gYear ;
        dct:title "Reaction-diffusion model as a framework for understanding biological pattern formation" .
}


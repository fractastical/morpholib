sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones — Morphometric validation: 55/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L234-267) returns only 3 baseline metrics (lambda_c, r(FGF, SHH), and 1D wild-type rugae count) without evaluating the 9-stage sequential growth-zone intercalation regression (Pearson r, p-value, RMSE), coronal vs sagittal cut stripe anisotropy / bifurcation index, cyclopamine / FGF10 perturbation counts, or computer-vision segmentation of left and right palatal shelf rugae in the biological specimen." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-economou-palate-ruguga-turing.py L234–L267: Only 3 baseline metrics returned in measure_morphoeval() without surgical, pharmacological, or specimen CV metrics <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L234-L267>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-1d-palatal-transect-wild-type-rugae-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-fgf-shh-critical-turing-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-in-phase-fgf-vs-shh-spatial-correlation-r-fgf-shh> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-1d-palatal-transect-wild-type-rugae-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "1D palatal transect wild-type rugae count = 9.0 rugae" ;
        schema:measurementTechnique "1D SHH peak detection along palatal shelf domain L=29.0" ;
        schema:name "1D palatal transect wild-type rugae count" ;
        schema:unitText "rugae" ;
        schema:value "9.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-1d-palatal-transect-wild-type-rugae-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-1d-palatal-transect-wild-type-rugae-count-reference> a schema:PropertyValue ;
        dcterms:source "Economou et al. (2012) Nature Genetics 44:348-351 Fig. 1 (rugae 8, 1..7b)" ;
        schema:value "9.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-fgf-shh-critical-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF-SHH critical Turing wavelength lambda_c = 4.553 dimensionless length" ;
        schema:measurementTechnique "Peak of 2-component FGF-SHH dispersion relation Re(sigma(q))" ;
        schema:name "FGF-SHH critical Turing wavelength lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "4.553" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-fgf-shh-critical-turing-wavelength-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-fgf-shh-critical-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dcterms:source "Economou et al. (2012) Nature Genetics 44:348-351" ;
        schema:value "3.2232" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-in-phase-fgf-vs-shh-spatial-correlation-r-fgf-shh> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "In-phase FGF vs SHH spatial correlation r(FGF, SHH) = 0.988 Pearson r" ;
        schema:measurementTechnique "Spatial Pearson correlation between 1D steady-state FGF and SHH profiles" ;
        schema:name "In-phase FGF vs SHH spatial correlation r(FGF, SHH)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.988" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-in-phase-fgf-vs-shh-spatial-correlation-r-fgf-shh-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-measurement-in-phase-fgf-vs-shh-spatial-correlation-r-fgf-shh-reference> a schema:PropertyValue ;
        dcterms:source "Economou et al. (2012) Nature Genetics 44:348-351 Fig. 3" ;
        schema:value "0.96" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 008 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


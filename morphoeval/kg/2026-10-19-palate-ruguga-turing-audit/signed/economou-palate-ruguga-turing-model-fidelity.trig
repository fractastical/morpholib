sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-economou-palate-ruguga-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-economou-palate-ruguga-turing.py L36–L85" ;
        dcterms:description "2x2 FGF-SHH reaction Jacobian J_0 and wavenumber dispersion curve Re(sigma(q))" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L36-L85> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 008 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-economou-palate-ruguga-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Economou et al. (2012) FGF10/FGF7-SHH activator-inhibitor Turing stripe mechanism at mammalian palatal growth zones — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the 2x2 FGF-SHH activator-inhibitor Jacobian J_0 (L36-43), dispersion curve Re(sigma(q)) (L46-85), and 1D reaction-diffusion solver (L88-145), backed by 3 Lean 4 theorems in `Loop_008_palate_ruguga_turing.lean`. However, it integrates only a static fixed-length 1D domain without modeling 2D anteroposterior growth-zone elongation anterior to ruga 8 (`8 -> 1 -> 2 -> 3 -> 4 -> 5 -> 6 -> 7 -> 7b`) or the equal-diffusion (D_A = D_H) negative control." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-economou-palate-ruguga-turing.py L88–L145: Static 1D fixed-length solver without 2D ruga-8 growth-zone sequential intercalation or equal-diffusion negative control <https://github.com/fractastical/morpholib/blob/45d4150/2012-economou-palate-ruguga-turing.py#L88-L145>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-economou-palate-ruguga-turing-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thompson-scarus-pomacanthus> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Source and data traceability: 92/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "As before - Thompson to page and figure with the scan pinned to one leaf; the landmark table to its Dryad DOI, licence and byte size, vendored and hash-checked; landmark definitions to Claverie & Wainwright Fig. 1; Bookstein 1978 and 1989 - and now the two photographs are cited to their Commons pages, photographers, institutional or Flickr source ids and licences (CC BY 4.0, CC BY 2.0), pinned by SHA-256 in the script and the dataset README, with the credits printed in the figure. Short of full marks for the same two reasons: the landmark semantics were read off a figure, and the Dryad download could not be scripted." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-5> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L25–L45" ;
        dct:description "data and scan provenance in the docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L25-L45> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L528–L544" ;
        dct:description "PHOTOS: URL, SHA-256, credit and licence for each photograph" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L528-L544> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L547–L563" ;
        dct:description "fetch_photo(): User-Agent, cache, hash enforced" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L547-L563> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L134–L161" ;
        dct:description "load_landmarks()/fetch_scan(): both hashes enforced" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L134-L161> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-source-traceability-5> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson/README.md L8–L24" ;
        dct:description "sources table with the photographs, licences, hashes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/datasets/thompson/README.md#L8-L24> .

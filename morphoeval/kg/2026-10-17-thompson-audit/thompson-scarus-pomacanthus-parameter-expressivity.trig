sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thompson-scarus-pomacanthus> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Parameter expressivity: 55/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Unchanged. The GIF moves the eight constants of the oblique family from the identity to the fitted values and shows the grid bending into coaxial circles while the fish deepens; the Chaetodont claim is tested by fitting the family to each of the 54 Chaetodon species. The constants are still not swept one at a time, the fitted constants for the Chaetodon species are not reported, and the outline test adds nothing here (it applies fitted maps, it does not vary constants)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity-3> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L483–L518" ;
        dct:description "animate(): straight path in parameter space from identity to the fitted map" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L483-L518> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L261–L272" ;
        dct:description "coaxial(): the eight constants and their roles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L261-L272> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L840–L845" ;
        dct:description "Scarus -> each Chaetodon species" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L840-L845> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


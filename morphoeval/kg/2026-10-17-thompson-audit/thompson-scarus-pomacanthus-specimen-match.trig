        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L580-L625> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L637–L671" ;

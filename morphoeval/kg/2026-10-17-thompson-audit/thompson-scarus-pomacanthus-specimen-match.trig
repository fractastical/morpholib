sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thompson-scarus-pomacanthus> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Morphological realism / specimen match: 72/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "The side-by-side the dimension asks for is now made with real animals: a photographed Scarus ghobban and a photographed Pomacanthus semicirculatus, their silhouettes drawn on the photographs with the dataset's landmarks placed on them so the registration can be checked by eye, and in row F the parrotfish outline carried by each family laid over the angelfish outline, with the gap visible - the angelfish's trailing dorsal and anal lobes and deeper belly are left by every map. Thompson's own figure is still placed beside the data from the pinned scan, and the 791 species remain the specimens of the landmark test. Judged on the match, the carried fish does not become a Pomacanthus: IoU 0.618 for his family against 0.662 with no deformation. Not higher because there is one individual per species, a dead specimen on white against a living fish on a reef (fin posture is declared as a confound, not controlled), the field silhouette depends on a declared box and shadow cut, and the landmarks are placed on the photographs by two anchors rather than digitised on them - so the picture is honest but the specimen pair is not yet a measured one." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-6> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson_scarus_pomacanthus_outlines.png (generated output)" ;
        dct:description "panels E/E' (photographs, silhouettes, placed landmarks, anchors), E'' (both silhouettes), F-F'''' (carried outline over the real one), G (bars) — thompson_scarus_pomacanthus_outlines.png: rendered output of thompson/1917-thompson-scarus-pomacanthus.py at 232e8f8, image/png, 903004 B, 2520×1470 px, artifact_sha256 df6479f9f47f28fc341f29ff25d2dbf5a612e34215492d2c23cae956105a16f8 (sha256 df6479f9f47f28fc341f29ff25d2dbf5a612e34215492d2c23cae956105a16f8)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson_scarus_pomacanthus.png (generated output)" ;
        dct:description "panels A (Thompson), A'/A'' (real species), B-B'''' (grids with residuals), C, D - unchanged — thompson_scarus_pomacanthus.png: rendered output of thompson/1917-thompson-scarus-pomacanthus.py at 232e8f8, image/png, 739620 B, 2520×1540 px, artifact_sha256 d243f51e2b90b1a2201ec81265392b1cf95ea0f0e6e68074818cc5754b324e08 (sha256 d243f51e2b90b1a2201ec81265392b1cf95ea0f0e6e68074818cc5754b324e08)" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L528–L544" ;
        dct:description "PHOTOS: the two photographs, URLs, SHA-256, credits, declared box and shadow cut" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L528-L544> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L580–L625" ;

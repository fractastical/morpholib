    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-specimen-match-6> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L740–L823" ;

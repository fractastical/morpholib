        schema:measurementTechnique "x of the peduncle anchor between the anterior-most and posterior-most mask columns (fish facing left)" ;
        schema:name "caudal-peduncle anchor, Scarus ghobban" ;
        schema:unitText "fraction of silhouette length" ;
        schema:value "0.7919" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-depth-length-pomacanthus-mean> a schema:PropertyValue,

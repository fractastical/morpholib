sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thompson-scarus-pomacanthus> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Morphometric validation: 86/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "To the landmark validation of the first audit (Procrustes distance, residual and explained share per family, within-genus noise floor, leave-one-landmark-out, depth/length and singular-value ratio, per-landmark residuals, all 3782 genus pairs, Scarus -> Chaetodon) the outline test adds two measurements on real silhouettes - IoU of the filled outlines and mean symmetric boundary distance - for every family against an explicit no-deformation baseline, so the question \"does the map help on the outline\" has a number and the answer is no for all five. The sidecar re-derives the IoU with a different rasteriser (agreement to 0.0001) and records the silhouette areas and the peduncle-anchor positions (0.79 and 0.84 of length). Not higher because there is still no published value to compare against (nobody has fitted this pair), one individual per species gives the outline numbers no spread, and digitising error on the landmarks is still not estimated." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-affine-residual>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-caudal-peduncle-anchor-pomacanthus-semicirculatus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-caudal-peduncle-anchor-scarus-ghobban>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-depth-length-pomacanthus-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-depth-length-scarus-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-leave-one-landmark-out-rms-of-the-oblique-coaxial-family>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-moebius-residual-isogonal-coaxial-circles>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-oblique-coaxial-circle-residual>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-percentile-of-scarus-pomacanthus-among-all-genus-pairs-oblique-coaxial-explained-share>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-pomacanthus-species>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-procrustes-distance-scarus-mean-to-pomacanthus-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-scarus-chaetodon-spp-median-explained-by-oblique-coaxial-circles>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-scarus-species>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-silhouette-area-pomacanthus-semicirculatus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-silhouette-area-scarus-ghobban>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-silhouette-iou-affine>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-silhouette-iou-coaxial>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-silhouette-iou-moebius>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-silhouette-iou-similarity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-silhouette-iou-tps>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-species-in-the-landmark-table>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-thin-plate-spline-bending-energy>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-within-pomacanthus-rms-noise-floor>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-morphometric-validation-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-morphometric-validation-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-morphometric-validation-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-morphometric-validation-6> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-affine-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "affine residual = 0.0259 Procrustes units" ;
        dct:description "explains 30.9 % of the Procrustes distance" ;
        schema:measurementTechnique "RMS after a least-squares affine map (6 parameters)" ;
        schema:name "affine residual" ;
        schema:unitText "Procrustes units" ;
        schema:value "0.0259" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-caudal-peduncle-anchor-pomacanthus-semicirculatus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "caudal-peduncle anchor, Pomacanthus semicirculatus = 0.8395 fraction of silhouette length" ;
        dct:description "plausible range for a perciform fish ~0.75-0.90; the anchor fixes the registration of the landmarks to the photograph" ;
        schema:measurementTechnique "x of the peduncle anchor between the anterior-most and posterior-most mask columns (fish facing left)" ;
        schema:name "caudal-peduncle anchor, Pomacanthus semicirculatus" ;
        schema:unitText "fraction of silhouette length" ;
        schema:value "0.8395" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-measurement-caudal-peduncle-anchor-scarus-ghobban> a schema:PropertyValue,

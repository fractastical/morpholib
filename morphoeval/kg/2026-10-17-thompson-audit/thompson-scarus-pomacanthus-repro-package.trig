sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thompson-scarus-pomacanthus> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Reproducibility package: 75/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Deterministic, invocation and outputs documented, data file in the repository and hash-checked; the two new network fetches are optional (--no-photos), hash-checked, cached and need only Pillow and scikit-image, both in requirements.txt; re-runs give identical numbers. Unchanged score: the environment is still recorded only in this audit (lower bounds in requirements.txt), the GIF still takes ~2 min, and the outline test adds ~30 s and a dependency on two third-party URLs remaining byte-stable (Commons originals have been; the hashes will refuse a changed file rather than silently use it)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-3> ;
        pk:hasScore "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L84–L91" ;
        dct:description "documented invocation, offline flags and outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L84-L91> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py L846–L921" ;
        dct:description "main(): flags, offline fallbacks for the scan and the photographs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L846-L921> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thompson-scarus-pomacanthus-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "requirements.txt L1–L7" ;
        dct:description "lower bounds only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/232e8f8/requirements.txt#L1-L7> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


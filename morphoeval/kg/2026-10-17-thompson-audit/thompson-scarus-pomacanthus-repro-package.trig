            <https://doi.org/10.1111/evo.13755>,
            <https://doi.org/10.1371/journal.pone.0112732>,
            <https://doi.org/10.5061/dryad.fn457gr> .
    <https://doi.org/10.1007/978-3-642-93093-5> dct:date "1978"^^xsd:gYear ;
        dct:title "The measurement of biological shape and shape change" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/evo.13755> dct:date "1873"^^xsd:gYear ;
        dct:title "The influence of size on body shape diversification across Indo-Pacific shore fishes" .
    <https://doi.org/10.1371/journal.pone.0112732> dct:date "2014"^^xsd:gYear ;
        dct:title "A morphospace for reef fishes: elongation is the dominant axis of body shape evolution" .
    <https://doi.org/10.5061/dryad.fn457gr> dct:date "2019"^^xsd:gYear ;
        dct:title "Data from: The influence of size on body shape diversification across Indo-Pacific shore fishes" .

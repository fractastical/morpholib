sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-thompson-audit-thompson-scarus-pomacanthus-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Reproducibility package: 75/100" ;
        rdfs:comment "Deterministic, invocation and outputs documented, data file in the repository and hash-checked; the two new network fetches are optional (--no-photos), hash-checked, cached and need only Pillow and scikit-image, both in requirements.txt; re-runs give identical numbers. Unchanged score: the environment is still recorded only in this audit (lower bounds in requirements.txt), the GIF still takes ~2 min, and the outline test adds ~30 s and a dependency on two third-party URLs remaining byte-stable (Commons originals have been; the hashes will refuse a changed file rather than silently use it). Evidence: thompson/1917-thompson-scarus-pomacanthus.py L84–L91: documented invocation, offline flags and outputs <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L84-L91>; thompson/1917-thompson-scarus-pomacanthus.py L846–L921: main(): flags, offline fallbacks for the scan and the photographs <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L846-L921>; requirements.txt L1–L7: lower bounds only <https://github.com/fractastical/morpholib/blob/232e8f8/requirements.txt#L1-L7>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-repro-package> ;
        pk:hasProbability "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-repro-package> rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species (thompson/1917-thompson-scarus-pomacanthus.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Scarus (22 spp.) and Pomacanthus (9 spp.), with Chaetodon (54 spp.) and 59 other genera for context; one photographed S. ghobban and one P. semicirculatus; Indo-Pacific shore fishes, lateral view" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


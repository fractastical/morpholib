}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thompson-scarus-pomacanthus> a pk:Claim ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species faithfully reproduces Scarus (22 spp.) and Pomacanthus (9 spp.), with Chaetodon (54 spp.) and 59 other genera for context; one photographed S. ghobban and one P. semicirculatus; Indo-Pacific shore fishes, lateral view morphology" ;
        dct:description "The simulation script(s) thompson/1917-thompson-scarus-pomacanthus.py implement the cited source model as published and produce forms that match real Scarus (22 spp.) and Pomacanthus (9 spp.), with Chaetodon (54 spp.) and 59 other genera for context; one photographed S. ghobban and one P. semicirculatus; Indo-Pacific shore fishes, lateral view specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 76.6/100, audit 2026-10-17-thompson-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py; output: thompson_scarus_pomacanthus.png; organism: Scarus (22 spp.) and Pomacanthus (9 spp.), with Chaetodon (54 spp.) and 59 other genera for context; one photographed S. ghobban and one P. semicirculatus; Indo-Pacific shore fishes, lateral view; checkpoint commit: https://github.com/fractastical/morpholib/commit/232e8f8; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0, scikit-image 0.26.0; supersedes_audit_id: 2026-10-16-thompson-audit; other sources: On Growth and Form, chapter XVII, On the theory of transformations, or the comparison of related forms <https://archive.org/details/ongrowthform1917thom>, On growth and form, 1917 Cambridge edition, Internet Archive item ongrowthform1917thom (Biodiversity Heritage Library contribution) <https://archive.org/download/ongrowthform1917thom/ongrowthform1917thom_jp2.zip/ongrowthform1917thom_jp2%2Fongrowthform1917thom_0769.jp2>, Perroquet barbe bleue (Scarus ghobban), IFREMER image 00762-87435 <https://commons.wikimedia.org/wiki/File:Perroquet_barbe_bleue_(Scarus_ghobban)_(Ifremer_00762-87435).jpg>, Semicircle angelfish (Pomacanthus semicirculatus) <https://commons.wikimedia.org/wiki/File:Semicircle_angelfish_(Pomacanthus_semicirculatus).jpg>" ;
        pk:derivedFromPaper <https://doi.org/10.1007/978-3-642-93093-5>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/evo.13755>,
            <https://doi.org/10.1371/journal.pone.0112732>,
            <https://doi.org/10.5061/dryad.fn457gr> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-thompson-scarus-pomacanthus-specimen-match> ;
        pk:weightOfEvidence "0.766"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/1917-thompson-scarus-pomacanthus.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "232e8f8" .
}


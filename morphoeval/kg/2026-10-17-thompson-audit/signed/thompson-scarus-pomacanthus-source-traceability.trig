sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-thompson-audit-thompson-scarus-pomacanthus-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species — Source and data traceability: 92/100" ;
        rdfs:comment "As before - Thompson to page and figure with the scan pinned to one leaf; the landmark table to its Dryad DOI, licence and byte size, vendored and hash-checked; landmark definitions to Claverie & Wainwright Fig. 1; Bookstein 1978 and 1989 - and now the two photographs are cited to their Commons pages, photographers, institutional or Flickr source ids and licences (CC BY 4.0, CC BY 2.0), pinned by SHA-256 in the script and the dataset README, with the credits printed in the figure. Short of full marks for the same two reasons: the landmark semantics were read off a figure, and the Dryad download could not be scripted. Evidence: thompson/1917-thompson-scarus-pomacanthus.py L25–L45: data and scan provenance in the docstring <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L25-L45>; thompson/1917-thompson-scarus-pomacanthus.py L528–L544: PHOTOS: URL, SHA-256, credit and licence for each photograph <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L528-L544>; thompson/1917-thompson-scarus-pomacanthus.py L547–L563: fetch_photo(): User-Agent, cache, hash enforced <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L547-L563>; thompson/1917-thompson-scarus-pomacanthus.py L134–L161: load_landmarks()/fetch_scan(): both hashes enforced <https://github.com/fractastical/morpholib/blob/232e8f8/thompson/1917-thompson-scarus-pomacanthus.py#L134-L161>; datasets/thompson/README.md L8–L24: sources table with the photographs, licences, hashes <https://github.com/fractastical/morpholib/blob/232e8f8/datasets/thompson/README.md#L8-L24>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-source-traceability> ;
        pk:hasProbability "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-thompson-scarus-pomacanthus-source-traceability> rdfs:label "Thompson's Scarus -> Pomacanthus coordinate transformation fitted to real species (thompson/1917-thompson-scarus-pomacanthus.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Scarus (22 spp.) and Pomacanthus (9 spp.), with Chaetodon (54 spp.) and 59 other genera for context; one photographed S. ghobban and one P. semicirculatus; Indo-Pacific shore fishes, lateral view" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


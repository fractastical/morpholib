        rdfs:label "datasets/thompson_1917/t1917-014/result.json (generated output)" ;
        dcterms:description "headline numbers: 11/18, flask-like 11/13, spindles 0/5, null 0.116, ablation 0.148, controls 1/2 — datasets/thompson_1917/t1917-014/result.json: rendered output of thompson/claims/t1917-014_the-forms-of-cells.py at a1dca587c, application/json, 3343 B, artifact_sha256 637a5df7a7141bf4b2a639184930ba88e5058a7fb9e466b89cf3bc0319ec1491 (sha256 637a5df7a7141bf4b2a639184930ba88e5058a7fb9e466b89cf3bc0319ec1491), spec_fingerprint 96b8d320bb6057308c24557dd6f3e3dce73bc0bc00dfdf30f45d3f4ca513f1dc" .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena and other unilocular tests vs. the Plateau/Delaunay catalogue (Pass 2) — Morphometric validation: 70/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Every silhouette gets nRMSE, Pearson r, KS statistic and 2-fold CV for five models; the Delaunay residual is judged against the per-specimen free-form floor (capped at 0.10) rather than a fixed number; the ellipsoid null (median 0.116) and the sphere+cylinder ablation (0.148) are both clearly worse than Delaunay (0.057); photograph sizes are calibrated from the scale bars (Lagena 186-276 um, Oolina 224 um, Fissurina 204-227 um) and cross-checked against the typical unilocular size range. Deductions: n = 2 negative controls, one of which passes; KS p-values are dominated by the row count and only the statistic is informative; no published Lagena outline morphometrics exist to compare the fitted B distribution against." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-014_the-forms-of-cells.py L99–L107: only two polythalamous control panels <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L99-L107>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-measurement-delaunay-compatible-unilocular-tests>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-measurement-fitted-kenmotsu-b-range>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-measurement-flask-like-tests-l-w-pi-delaunay-compatible>,

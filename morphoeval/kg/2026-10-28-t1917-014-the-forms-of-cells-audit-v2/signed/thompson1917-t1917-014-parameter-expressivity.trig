sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-014> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-parameter-expressivity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena and other unilocular tests vs. the Plateau/Delaunay catalogue (Pass 2) — Parameter expressivity: 72/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "parameter_sweep tabulates catalogue member, neck ratio (strictly decreasing, asserted), period/(2a) and bead aspect ratio (within [1, pi], asserted) over 14 values of B including the nodoid branch (axial back-tracking detected), and the flask join radius over t for three B values; the GIF animates B and L_neck. Fitted B spans 0.30-0.85 across specimens. Deductions: no CLI to override parameters; the t sweep is plotted for one B only." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "thompson/claims/t1917-014_the-forms-of-cells.py L934–L940: argparse exposes only --self-test / --no-gif <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L934-L940>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-parameter-expressivity-2> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L503–L526" ;
        dcterms:description "parameter_sweep over SWEEP_B and SWEEP_T with monotonicity and bound assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L503-L526> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L790–L822" ;
        dcterms:description "render_growth_gif sweeps B 0 -> 0.98 and L_neck" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L790-L822> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, Pass 2; cloud loop thompson1917-t1917-014)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


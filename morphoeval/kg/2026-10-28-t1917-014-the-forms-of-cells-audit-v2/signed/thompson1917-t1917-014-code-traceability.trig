sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-014> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-code-traceability> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena and other unilocular tests vs. the Plateau/Delaunay catalogue (Pass 2) — Code-to-model traceability: 80/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Module docstring maps E3-E8 and the comparators to pages 216-263; every model function names its equation; the decision rule is spelled out with its three constants; the math KG YAML and Lean module cite v2 line ranges. The constants 0.06 / 1.5 / 0.10 / 0.12 remain judgement calls, now documented as such." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "thompson/claims/t1917-014_the-forms-of-cells.py L112–L115: gate constants are stated, not derived from a noise model <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L112-L115>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-code-traceability-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L1–L62" ;
        dcterms:description "docstring: equations, comparators, statistics, decision rule, data, usage" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L1-L62> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-014.yaml (generated output)" ;
        dcterms:description "six laws with lean_locus and v2 code_locus ranges — morphoeval/math_kg_loops/thompson1917-t1917-014.yaml: rendered output of thompson/claims/t1917-014_the-forms-of-cells.py at a1dca587c, application/yaml, 10581 B, artifact_sha256 49bced3e9b340f526d57f44b97bd5b8fbc496b1251569302456d6902652c2c7d (sha256 49bced3e9b340f526d57f44b97bd5b8fbc496b1251569302456d6902652c2c7d), spec_fingerprint 96b8d320bb6057308c24557dd6f3e3dce73bc0bc00dfdf30f45d3f4ca513f1dc" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, Pass 2; cloud loop thompson1917-t1917-014)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

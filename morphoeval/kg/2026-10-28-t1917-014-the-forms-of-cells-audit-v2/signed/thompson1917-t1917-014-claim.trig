sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-014> a pk:Claim ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena and other unilocular tests vs. the Plateau/Delaunay catalogue (Pass 2) faithfully reproduces Lagena spp., Oolina sp., Fissurina sp. (monothalamic Foraminifera); 13 Thompson/Brady drawings + 5 photographs; Globobulimina and Quinqueloculina as polythalamous controls morphology" ;
        dcterms:description "The simulation script(s) thompson/claims/t1917-014_the-forms-of-cells.py, morphoeval/lean/loops/Thompson1917_T1917_014.lean, morphoeval/math_kg_loops/thompson1917-t1917-014.yaml implement the cited source model as published and produce forms that match real Lagena spp., Oolina sp., Fissurina sp. (monothalamic Foraminifera); 13 Thompson/Brady drawings + 5 photographs; Globobulimina and Quinqueloculina as polythalamous controls specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Thompson1917_T1917_014.lean>,
            <https://github.com/fractastical/morpholib/blob/main/morphoeval/math_kg_loops/thompson1917-t1917-014.yaml>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-014_the-forms-of-cells.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-014_the-forms-of-cells.py, https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Thompson1917_T1917_014.lean, https://github.com/fractastical/morpholib/blob/main/morphoeval/math_kg_loops/thompson1917-t1917-014.yaml; output: docs/media/t1917_014_the_forms_of_cells_comparison.png; organism: Lagena spp., Oolina sp., Fissurina sp. (monothalamic Foraminifera); 13 Thompson/Brady drawings + 5 photographs; Globobulimina and Quinqueloculina as polythalamous controls; environment: python 3.12, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0, scikit-image 0.26.0, lean 4.35.0; claim_boundary: [reported_in_source: Thompson (1917) p. 256: Lagena shells are 'flask-shaped ... whose surface is simply that of an unduloid, or more frequently ... an unduloid combined with a portion of a sphere'; p. 218: the CMC surfaces of revolution are the plane, sphere, cylinder, catenoid, unduloid and nodoid; reconstructed_in_script: Kenmotsu (1980) parametrisation of the Delaunay family; C1 sphere-unduloid-cylinder flask and unduloid bead composites fitted by bounded least squares to the meridional radius profile of 13 Fig. 84 silhouettes and 7 photographed tests, compared against an ellipsoid null, a sphere+cylinder ablation and a free-form polynomial with nRMSE, Pearson r, KS statistic and 2-fold CV; transfer_boundary: The drawings are Brady's as redrawn in 1917; the photographs are 2-D side views of 3-D tests, so axisymmetry is tested only by bilateral symmetry of the outline; the outline test has limited specificity for egg-shaped shells (1/2 polythalamous controls pass); does_not_claim: No claim about the surface-tension mechanism (hanging drop); no claim about Nodosaria chains, Orbulina or non-foram protists; no claim that passing tests are uniquely Delaunay rather than merely consistent; n = 2 controls and n = 5 photographed unilocular tests are small samples]; other sources: On Growth and Form (1st ed.), Ch. V The Forms of Cells, pp. 201-276 <https://archive.org/details/ongrowthform1917thom>, Sur la surface de révolution dont la courbure moyenne est constante <http://www.numdam.org/item/JMPA_1841_1_6__309_0/>" ;
        pk:derivedFromPaper <https://doi.org/10.2748/tmj/1178229688>,
            <https://doi.org/10.3897/BDJ.10.e87457>,
            <https://doi.org/10.5061/dryad.28816> .

    <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Thompson1917_T1917_014.lean> a schema:SoftwareSourceCode ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_014.lean" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Lean 4" .

    <https://github.com/fractastical/morpholib/blob/main/morphoeval/math_kg_loops/thompson1917-t1917-014.yaml> a schema:SoftwareSourceCode ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-014.yaml" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .

    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-014_the-forms-of-cells.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


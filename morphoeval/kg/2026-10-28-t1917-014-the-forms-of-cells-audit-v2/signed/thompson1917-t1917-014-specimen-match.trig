    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L309–L352" ;
        dcterms:description "find_scale_bars + segment_photo: Otsu, largest component, hole fill, plate-wide 100 um bar assignment" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L309-L352> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena and other unilocular tests vs. the Plateau/Delaunay catalogue (Pass 2) — Morphological realism / specimen match: 62/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Real specimens are now compared side by side (panels E-F): 4/5 photographed unilocular tests (Fissurina 57a/58a, Lagena 62a, Oolina 63) are traced by the Delaunay composite to within 0.018-0.051 nRMSE, Lagena 61a fails (0.083 vs free-form 0.018: its neck tapers like a cone rather than an unduloid), and the 13 drawings split flask/spindle as in Pass 1. Deductions: only one plate and five unilocular photographs; the egg-shaped Quinqueloculina control also matches, so the visual match is not specific to single-chambered tests; the drawn spindles are visibly not reproduced (the honest negative)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-014/t1917_014_metrics.json (generated output, not in repo): bdj_61a best_nrmse 0.083 > gate 0.060 (not compatible); bdj_66a control compatible — datasets/thompson_1917/t1917-014/t1917_014_metrics.json: rendered output of thompson/claims/t1917-014_the-forms-of-cells.py at a1dca587c, application/json, 70771 B, artifact_sha256 b0f3e32ae986527f2d4aaa19ea3cf0ef708eae0da7083dc7e3b8ae83f69f2698 (sha256 b0f3e32ae986527f2d4aaa19ea3cf0ef708eae0da7083dc7e3b8ae83f69f2698), spec_fingerprint 96b8d320bb6057308c24557dd6f3e3dce73bc0bc00dfdf30f45d3f4ca513f1dc" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-specimen-match-2> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .


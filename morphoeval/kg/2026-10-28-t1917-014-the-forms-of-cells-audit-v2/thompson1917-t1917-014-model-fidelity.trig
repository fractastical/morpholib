            <https://doi.org/10.3897/BDJ.10.e87457>,
            <https://doi.org/10.5061/dryad.28816> .
    <http://www.numdam.org/item/JMPA_1841_1_6__309_0/> dct:date "1841"^^xsd:gYear ;
        dct:title "Sur la surface de révolution dont la courbure moyenne est constante" .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;

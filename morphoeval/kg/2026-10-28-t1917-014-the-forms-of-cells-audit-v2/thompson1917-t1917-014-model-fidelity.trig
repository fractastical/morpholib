sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-014> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-014-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-014 — Lagena and other unilocular tests vs. the Plateau/Delaunay catalogue (Pass 2) — Model fidelity to source: 80/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Catalogue implemented from the Kenmotsu first-integral form with all five members and the correct limits, self-tested against the root identities, the elliptic period and the closed-form flask join radius; 18 Lean theorems (0 sorry) check the integer algebra including the bead aspect bound and join feasibility. The sphere+cylinder ablation shows the unduloid shoulder is load-bearing (17/18 tests fit worse without it). Deductions: join is C1 not C2, neck has no apertural lip, the nodoid branch is characterised in the sweep but not offered as a fit model." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "thompson/claims/t1917-014_the-forms-of-cells.py L503–L526: parameter_sweep characterises the nodoid (B > 1) but MODELS has no nodoid fit <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L503-L526>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L141–L206" ;
        dct:description "classify_delaunay, neck_ratio, unduloid_period, bead_aspect_ratio, kenmotsu_profile, kenmotsu_full, catenoid_profile, flask_join_radius (E4-E7)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L141-L206> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-014_the-forms-of-cells.py L209–L262" ;
        dct:description "flask_profile (E7), bead_profile (E8), ellipsoid null, sphere_cylinder ablation, freeform_fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a1dca587c/thompson/claims/t1917-014_the-forms-of-cells.py#L209-L262> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-014-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_014.lean L32–L221" ;
        dct:description "18 kernel-checked theorems, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a1dca587c/morphoeval/lean/loops/Thompson1917_T1917_014.lean#L32-L221> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, Pass 2; cloud loop thompson1917-t1917-014)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


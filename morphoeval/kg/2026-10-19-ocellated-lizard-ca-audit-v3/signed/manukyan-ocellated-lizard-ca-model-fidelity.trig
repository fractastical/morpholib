sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L739–L865" ;
        dcterms:description "3D voxel skin-volume reaction-diffusion solver: stepped thickness mask, skin-skin face conductances, zero-flux surfaces, explicit lateral + implicit vertical (Thomas) diffusion, depth average and vertical non-uniformity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L739-L865> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L616–L717" ;
        dcterms:description "Depth-averaged thin-film 2D reduction (1/h) div(h D grad u) with min(h_i,h_j) D face conductance and capacity h; v2 diffusivity variant retained only for comparison; no per-scale averaging" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L616-L717> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L325–L443" ;
        dcterms:description "Turing linear stability: Jacobian, d_c, k_c, lambda_c, unstable band; D_u chosen so lambda_c = 25 px = 5 pitches; canonical JSON set analysed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L325-L443> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean L109–L176" ;
        dcterms:description "Lean Theorems 4-5 (depth average of a uniform column; face conductance ratio = thickness ratio, insulation at h_b = 0), 0 sorrys, verified with `lean`" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L109-L176> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — 3D skin-volume reaction-diffusion (Pass 3) — Model fidelity to source: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The code now implements the mechanism the papers describe: reaction-diffusion in a 3D skin volume whose thickness drops to P h_interior at scale borders (`integrate_skin_volume_pde_3d`, L739-865: voxel mask z < h(x,y), skin-skin face conductances, zero-flux steps, implicit Thomas vertical solve L720-736), the depth-averaged reduction with the correct h-weighted conductance and capacity (L616-717), a border definition through which all inter-scale flux passes (L450-536), and the mesoscopic premise that lambda_c = 5 pitches exceeds the scale so isolated scales cannot pattern (L325-443, measured: insulated inter std 5e-3, intra std 8e-9). The v2 averaging hack is gone and the paper's qualitative result emerges from the geometry alone (P = 0.17 ratio 14.7 vs continuum 3.29). Deductions: the kinetics are a phenomenological set, not Manukyan's Methods parameters (L326-341) (-6); the domain is a stepped voxel skin without growth, not the 3D geometry of Fofonjka & Milinkovitch (-5); the CA flip probabilities are vendored tables rather than derived from the PDE as the paper does (L276-278) (-4); the PDE neighbour histogram peaks at n_g = 2, not 3 (L1 to CA 0.34) (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2015-manukyan-ocellated-lizard-ca.py L326–L341: Script kinetics constants 0.50/-0.75/0.82/-0.65/1.25 are phenomenological (Kondo-Asai-type), not the Methods parameters of Manukyan et al. (2017) <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L326-L341>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-model-fidelity-4> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 009 Pass 3 autonomous loop assessor; v2 assessor was Gemini 4 Argon)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


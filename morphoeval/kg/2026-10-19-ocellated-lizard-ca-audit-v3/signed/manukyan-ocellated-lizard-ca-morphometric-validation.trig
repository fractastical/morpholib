    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-voxel-volume-fraction-relative-to-a-uniform-slab-p-0-17-reference> a schema:PropertyValue ;
        dcterms:source "Analytic 1 - (1 - P_eff) * border_area_fraction for the same geometry (self-consistency of the voxel mask)" ;
        schema:value "0.7" .


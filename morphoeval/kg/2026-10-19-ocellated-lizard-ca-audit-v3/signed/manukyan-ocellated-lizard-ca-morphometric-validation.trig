sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevX.13.041011> .

    <https://doi.org/10.1038/376765a0> dcterms:date "1995"^^xsd:gYear ;
        dcterms:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .

    <https://doi.org/10.1038/nature22031> dcterms:date "2017"^^xsd:gYear ;
        dcterms:title "A living mesoscopic cellular automaton made of skin scales" .

    <https://doi.org/10.1038/s41467-021-22525-1> dcterms:date "2021"^^xsd:gYear ;
        dcterms:title "Reaction-diffusion in a growing 3D domain of skin scales generates a discrete cellular automaton" .

    <https://doi.org/10.1098/rstb.1952.0012> dcterms:date "1952"^^xsd:gYear ;
        dcterms:title "The chemical basis of morphogenesis" .

    <https://doi.org/10.1103/PhysRevX.13.041011> dcterms:date "2023"^^xsd:gYear ;
        dcterms:title "Simple Reaction-Diffusion Modeling Predicts Inconspicuous Neighborhood-Dependent Color Subclustering of Lizard Scales" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — 3D skin-volume reaction-diffusion (Pass 3) — Morphometric validation: 80/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1354-1537) returns 16 measurements with reference values and units: CA and specimen neighbour statistics against the vendored Fig. 3 targets, 3D discretization ratio and Ashman D, 3D-vs-2D scale-state agreement (0.903 vs 1.0), depth-averaged RMS (0.118), vertical non-uniformity (0.022), voxel volume fraction vs analytic (0.700 vs 0.700), insulated and equal-diffusion controls, P-sweep monotonicity (rho = -1.0), lambda_c in pitches (5.0) and the canonical set's d_c (23.57 vs its stated 20). Deductions: only two measurements are made on a real specimen (green fraction 0.4505 vs 0.44; <n_g> 2.60 vs 2.665) and the 0.44 / 2.665 targets have no digitisation provenance (-8); the 3.5 discretization-ratio reference and the 4.0-pitch lambda_c reference are assessor-chosen anchors, not values reported in the papers (-6); several references are self-consistency targets (agreement 1.0, RMS 0, volume fraction analytic) (-4); no uncertainty / seed ensemble is reported (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2015-manukyan-ocellated-lizard-ca.py L1398–L1407: 3D discretization ratio measurement references 3.5 — an anchor carried from Pass 1, not a value in Manukyan 2017 / Fofonjka 2021 <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L1398-L1407>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-p-0-17-inter-to-intra-scale-concentration-discretization-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-p-0-17-scale-color-bimodality-ashman-s-d>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-vs-outer-totalistic-ca-neighbor-histogram-l1-distance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vertical-non-uniformity-of-activator-rms-over-depth-interior-columns-p-0-17>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vs-depth-averaged-2d-reduction-rms-difference-of-depth-averaged-activator-p-0-17>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vs-depth-averaged-2d-thin-film-reduction-binary-scale-state-agreement-p-0-17>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-voxel-volume-fraction-relative-to-a-uniform-slab-p-0-17>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-equal-diffusion-d-1-0-negative-control-scale-amplitude-suppression>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-black-scale-mean-black-neighbor-count-n-b>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-hexagonal-ca-adult-green-scale-mean-green-neighbor-count-n-g>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-insulated-scale-control-p-0-inter-scale-pattern-amplitude-in-the-3d-skin-volume>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-p-sweep-monotonicity-spearman-rho-of-3d-discretization-ratio-vs-p-over-p-in-0-08-0-17-0-45-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-segmented-timon-lepidus-dorsal-green-scale-mean-green-neighbor-count-n-g>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-turing-critical-diffusivity-ratio-d-c-of-the-vendored-canonical-clipped-linear-kondo-asai-parameter-set>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-turing-wavelength-of-the-script-kinetics-in-scale-pitches-lambda-c-pitch>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-morphometric-validation-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-p-0-17-inter-to-intra-scale-concentration-discretization-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D skin-volume PDE (P=0.17) inter-to-intra scale concentration discretization ratio = 14.6692 sigma_inter / sigma_intra" ;
        dcterms:description "3D P=0.17 ratio = 14.669 vs 3D continuum P=1.0 ratio = 3.292 (4.46x gain); 2D thin-film ratio = 11.162; v2 reported 86.79 with an artificial per-scale averaging step" ;
        schema:measurementTechnique "Ratio of inter-scale std of depth-averaged activator to mean intra-scale std in the 3D voxel skin volume (h_int=12 vox, h_border=2 vox, P_eff=0.167); no per-scale averaging applied" ;
        schema:name "3D skin-volume PDE (P=0.17) inter-to-intra scale concentration discretization ratio" ;
        schema:unitText "sigma_inter / sigma_intra" ;
        schema:value "14.6692" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-p-0-17-inter-to-intra-scale-concentration-discretization-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-p-0-17-inter-to-intra-scale-concentration-discretization-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Fig. 4 & Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433" ;
        schema:value "3.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-p-0-17-scale-color-bimodality-ashman-s-d> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D skin-volume PDE (P=0.17) scale color bimodality Ashman's D = 4.8767 Ashman D" ;
        dcterms:description "inter-scale std = 0.3558, intra-scale std = 0.0243; 2D thin-film Ashman D = 5.097" ;
        schema:measurementTechnique "sqrt(2)*|mu_green - mu_black| / sqrt(var_green + var_black) across 144 hexagonal scales of depth-averaged u at P = 0.17" ;
        schema:name "3D skin-volume PDE (P=0.17) scale color bimodality Ashman's D" ;
        schema:unitText "Ashman D" ;
        schema:value "4.8767" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-p-0-17-scale-color-bimodality-ashman-s-d-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-p-0-17-scale-color-bimodality-ashman-s-d-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Fig. 2 & Fig. 4 bimodal scale state criterion (D > 2.0)" ;
        schema:value "2.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-vs-outer-totalistic-ca-neighbor-histogram-l1-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D skin-volume PDE vs outer-totalistic CA neighbor histogram L1 distance = 0.3372 L1 probability distance" ;
        dcterms:description "CA vs Manukyan reference histogram Pearson r = 0.9733 (p = 2.20e-04); 3D PDE <n_g>_green = 2.246" ;
        schema:measurementTechnique "sum(|P_3D(n_g | S=1) - P_CA(n_g | S=1)|) for n_g in {0..6}" ;
        schema:name "3D skin-volume PDE vs outer-totalistic CA neighbor histogram L1 distance" ;
        schema:unitText "L1 probability distance" ;
        schema:value "0.3372" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-vs-outer-totalistic-ca-neighbor-histogram-l1-distance-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-pde-vs-outer-totalistic-ca-neighbor-histogram-l1-distance-reference> a schema:PropertyValue ;
        dcterms:source "Manukyan et al. (2017) Nature 544:173-179 Figs. 3-4 PDE-to-CA mesoscopic reduction" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vertical-non-uniformity-of-activator-rms-over-depth-interior-columns-p-0-17> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D skin volume vertical non-uniformity of activator (RMS over depth, interior columns, P=0.17) = 0.022038 concentration units" ;
        dcterms:description "max over all columns = 0.0689; continuum P=1.0 vertical RMS = 5.00e-16" ;
        schema:measurementTechnique "mean over interior columns of sqrt((1/h) sum_z (u - ubar)^2) in the 3D voxel skin volume (h_int = 2.4 px = 0.48 scale pitches, lambda_c = 25 px)" ;
        schema:name "3D skin volume vertical non-uniformity of activator (RMS over depth, interior columns, P=0.17)" ;
        schema:unitText "concentration units" ;
        schema:value "0.022038" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vertical-non-uniformity-of-activator-rms-over-depth-interior-columns-p-0-17-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vertical-non-uniformity-of-activator-rms-over-depth-interior-columns-p-0-17-reference> a schema:PropertyValue ;
        dcterms:source "Thin-film regime h_interior << lambda_c assumed by the 2D depth-averaged reduction" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vs-depth-averaged-2d-reduction-rms-difference-of-depth-averaged-activator-p-0-17> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D skin volume vs depth-averaged 2D reduction: RMS difference of depth-averaged activator (P=0.17) = 0.1178 concentration units (u in [0.05, 0.95])" ;
        dcterms:description "pattern amplitude (inter-scale std) = 0.3558; RMS / amplitude = 0.331" ;
        schema:measurementTechnique "sqrt(mean((ubar_3D - u_2D)^2)) over all skin pixels at P = 0.17" ;
        schema:name "3D skin volume vs depth-averaged 2D reduction: RMS difference of depth-averaged activator (P=0.17)" ;
        schema:unitText "concentration units (u in [0.05, 0.95])" ;
        schema:value "0.1178" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vs-depth-averaged-2d-reduction-rms-difference-of-depth-averaged-activator-p-0-17-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vs-depth-averaged-2d-reduction-rms-difference-of-depth-averaged-activator-p-0-17-reference> a schema:PropertyValue ;
        dcterms:source "Thin-film / lubrication reduction of 3D diffusion in a domain of slowly varying thickness (Fofonjka & Milinkovitch 2021)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vs-depth-averaged-2d-thin-film-reduction-binary-scale-state-agreement-p-0-17> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D skin volume vs depth-averaged 2D thin-film reduction: binary scale-state agreement (P=0.17) = 0.9028 fraction of scales" ;

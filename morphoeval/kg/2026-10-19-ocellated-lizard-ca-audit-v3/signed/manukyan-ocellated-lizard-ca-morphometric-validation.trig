        schema:measurementTechnique "Fraction of 144 scales whose green/black state (55th-percentile threshold of per-scale mean u) agrees between the 3D voxel solution and the 2D (1/h) div(h D grad u) reduction at identical P, seed, dt and steps" ;
        schema:name "3D skin volume vs depth-averaged 2D thin-film reduction: binary scale-state agreement (P=0.17)" ;
        schema:unitText "fraction of scales" ;
        schema:value "0.9028" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vs-depth-averaged-2d-thin-film-reduction-binary-scale-state-agreement-p-0-17-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-volume-vs-depth-averaged-2d-thin-film-reduction-binary-scale-state-agreement-p-0-17-reference> a schema:PropertyValue ;
        dcterms:source "Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433 thin-film limit h << lambda_c (datasets/ocellated_lizard_ca/skin_volume_reference.json)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-measurement-3d-skin-voxel-volume-fraction-relative-to-a-uniform-slab-p-0-17> a schema:PropertyValue,

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — 3D skin-volume reaction-diffusion (Pass 3) — Source and data traceability: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Five vendored files are SHA-256-pinned and verified at every run (`EXPECTED_SHA256`, L109-125; `verify_dataset_sha256`, L150-162), the five sources carry DOIs in the docstring, the dataset README, `paper_citations.bib` and the new `skin_volume_reference.json`, and the latter states explicitly what is and is not vendored (no micro-CT mesh, no growth) and records the 3D discretization. Deductions: the 'canonical_parameters', CA transition probabilities and histogram targets in `ocellated_lizard_ca_reference.json` (L53-90) have no figure/table/digitisation provenance, and the canonical set is not Turing-unstable at its stated d = 20 (d_c = 23.57), so the file's central numbers cannot be traced to the paper (-10); the skin thickness ratio 0.17 is cited to Fig. 4 without a page or Methods equation number (-3); the specimen photograph is a Wikimedia image, not a Manukyan specimen (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/ocellated_lizard_ca/ocellated_lizard_ca_reference.json L53–L70: canonical_parameters claim diffusivity_ratio_d = 20 but the set's Turing critical ratio is 23.57 (computed at L416-443); no provenance to a Methods equation <https://github.com/fractastical/morpholib/blob/bd54e11/datasets/ocellated_lizard_ca/ocellated_lizard_ca_reference.json#L53-L70>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-source-traceability-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L109–L162" ;
        dct:description "SHA-256 pins for 5 dataset files incl. skin_volume_reference.json and runtime verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L109-L162> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/ocellated_lizard_ca/skin_volume_reference.json L1–L73" ;
        dct:description "Pass 3 reference notes: 3D model, thin-film reduction, kinetics Jacobian, residual gap (no micro-CT mesh, no growth, phenomenological kinetics), DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/datasets/ocellated_lizard_ca/skin_volume_reference.json#L1-L73> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/ocellated_lizard_ca/README.md L1–L37" ;
        dct:description "Dataset README lists all 5 files with SHA-256 and sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/datasets/ocellated_lizard_ca/README.md#L1-L37> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 009 Pass 3 autonomous loop assessor; v2 assessor was Gemini 4 Argon)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevX.13.041011> .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1038/nature22031> dct:date "2017"^^xsd:gYear ;
        dct:title "A living mesoscopic cellular automaton made of skin scales" .
    <https://doi.org/10.1038/s41467-021-22525-1> dct:date "2021"^^xsd:gYear ;
        dct:title "Reaction-diffusion in a growing 3D domain of skin scales generates a discrete cellular automaton" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1103/PhysRevX.13.041011> dct:date "2023"^^xsd:gYear ;
        dct:title "Simple Reaction-Diffusion Modeling Predicts Inconspicuous Neighborhood-Dependent Color Subclustering of Lizard Scales" .
}


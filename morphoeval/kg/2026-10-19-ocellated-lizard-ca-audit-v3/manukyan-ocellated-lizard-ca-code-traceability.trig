sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-manukyan-ocellated-lizard-ca> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-manukyan-ocellated-lizard-ca-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Manukyan et al. (2017) Nature hexagonal skin-scale border thickness reduction & outer-totalistic cellular automaton — 3D skin-volume reaction-diffusion (Pass 3) — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-85) maps each solver to its source and states the Pass 3 remediation and its limits; every PDE function docstring gives the governing equation it discretises (L630-646, L748-772), the border definition explains why the v2 band leaked (L461-470), the Lean theorems are cross-referenced from the code and registered with code loci in `morphoeval/math_kg_loops/manukyan-ocellated-lizard-ca.yaml` (laws 1-5), and measurement notes say which v2 number was an artefact. Deductions: the kinetics constants (L332) and the CA damping factor 0.35 (L296-297) are not traced to any equation or figure (-6); the 55th percentile threshold used for both PDE scales and the specimen (L594, L1012) is an unexplained choice (-4); the `reference_value` anchors 3.5 and 4.0 are documented as choices only in the measurement text (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2015-manukyan-ocellated-lizard-ca.py L296–L297: CA asynchronous damping factor 0.35 is uncited <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L296-L297>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-code-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2015-manukyan-ocellated-lizard-ca.py L1–L85" ;
        dct:description "Module docstring: equations, Pass 3 remediation statement (what is and is not a micro-CT FEM), Lean Theorems 1-5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L1-L85> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-manukyan-ocellated-lizard-ca-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/manukyan-ocellated-lizard-ca.yaml L1–L126" ;
        dct:description "Math KG: 5 laws with Lean declarations, theorems and line-pinned code loci incl. the two Pass 3 laws" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/math_kg_loops/manukyan-ocellated-lizard-ca.yaml#L1-L126> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 009 Pass 3 autonomous loop assessor; v2 assessor was Gemini 4 Argon)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/nature22031>,
            <https://doi.org/10.1038/s41467-021-22525-1>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1103/PhysRevX.13.041011> .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1038/nature22031> dct:date "2017"^^xsd:gYear ;
        dct:title "A living mesoscopic cellular automaton made of skin scales" .
    <https://doi.org/10.1038/s41467-021-22525-1> dct:date "2021"^^xsd:gYear ;
        dct:title "Reaction-diffusion in a growing 3D domain of skin scales generates a discrete cellular automaton" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1103/PhysRevX.13.041011> dct:date "2023"^^xsd:gYear ;
        dct:title "Simple Reaction-Diffusion Modeling Predicts Inconspicuous Neighborhood-Dependent Color Subclustering of Lizard Scales" .
}


<https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hexagonal Skin-Scale First-Nearest-Neighbor Partition & Labyrinthine Symmetry" ;
    dct:description "Establishes the exact 6-neighbor conservation law on hexagonal lizard skin scales and proves n_g = n_b = 3 is the unique symmetric labyrinthine chain degree | Variables: n_g: number of green first-nearest-neighbor scales; n_b: number of black first-nearest-neighbor scales on the 6-regular hexagonal skin lattice" ;
    dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Fig. 3d-f" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L181-L322>,
        <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L19-L36> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def hex_black_neighbors (n_g : Nat) : Nat := 6 - n_g
theorem hex_scale_neighbor_partition_and_symmetry (n_g : Nat) (h : n_g ≤ 6) :
    n_g + hex_black_neighbors n_g = 6 ∧
    (n_g = hex_black_neighbors n_g ↔ n_g = 3) := by
  unfold hex_black_neighbors; omega
"""^^pk:lean4 ;
    skos:notation "n_g + n_b = 6  (n_g, n_b ∈ {0..6});   n_g = n_b ⟺ n_g = 3" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevX.13.041011> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
    pk:leanDeclaration "MathOfBiology.Loop_009.hex_black_neighbors" ;
    pk:leanTheorem "MathOfBiology.Loop_009.hex_scale_neighbor_partition_and_symmetry" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Scale-Border Thickness Reduction Inter-Scale Flux Attenuation (D_border = P D_interior ≪ D_interior)" ;
    dct:description "Proves that thinning skin at scale borders attenuates inter-scale diffusive flux relative to intra-scale homogenization, discretizing continuous Turing PDEs into monochromatic scale states | Variables: P = h_border / h_interior: scale-border thickness reduction factor (P ≈ 0.17 in Timon lepidus); D_interior: intra-scale morphogen diffusivity; ∇u: inter-scale morphogen difference" ;
    dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Fig. 4 & Methods Eqs. (1)-(8); Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L616-L717>,
        <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L43-L66> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def interscale_border_flux (P_pct flux_unit : Int) : Int :=
  P_pct * flux_unit
theorem border_diffusivity_reduction_quenches_interscale_flux
    (P_pct flux_unit : Int)
    (hP_lo : P_pct ≥ 1) (hP_hi : P_pct ≤ 99) (hF : flux_unit ≥ 1) :
    interscale_border_flux 0 flux_unit = 0 ∧
    interscale_border_flux 17 flux_unit > 0 ∧
    interscale_border_flux 17 flux_unit < interscale_border_flux 100 flux_unit ∧
    P_pct < 100 := by
  unfold interscale_border_flux; omega
"""^^pk:lean4 ;
    skos:notation "J_border = P · D_interior · ∇u;   0 < P < 1 ⟹ 0 < J_border < J_continuum,   P = 0 ⟹ J_border = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevX.13.041011> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
    pk:leanDeclaration "MathOfBiology.Loop_009.interscale_border_flux" ;
    pk:leanTheorem "MathOfBiology.Loop_009.border_diffusivity_reduction_quenches_interscale_flux" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Manukyan Hexagonal Outer-Totalistic Cellular Automaton Labyrinthine Attractor Rule" ;
    dct:description "Proves that n_g = 3 is a simultaneous fixed point for both green and black scales while overcrowded green clusters (n_g ≥ 4) flip to black and isolated black pockets (n_g ≤ 1) flip to green | Variables: s ∈ {0, 1}: scale color state (0 = black, 1 = green); n_g ∈ {0..6}: number of green first-nearest neighbors" ;
    dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Figs. 2-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L204-L322>,
        <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L83-L115> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def manukyan_ca_step (s n_g : Nat) : Nat :=
  if s = 1 then (if 2 ≤ n_g ∧ n_g ≤ 3 then 1 else 0)
  else (if n_g ≤ 1 then 1 else 0)
theorem manukyan_outer_totalistic_ca_labyrinth_fixed_point :
    manukyan_ca_step 1 3 = 1 ∧ manukyan_ca_step 0 3 = 0 ∧
    manukyan_ca_step 1 5 = 0 ∧ manukyan_ca_step 0 1 = 1 := by decide
"""^^pk:lean4 ;
    skos:notation "S_i(t+1) = Φ(S_i(t), n_g(i));   Φ(1, 3) = 1 ∧ Φ(0, 3) = 0 ∧ Φ(1, 5) = 0 ∧ Φ(0, 1) = 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevX.13.041011> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
    pk:leanDeclaration "MathOfBiology.Loop_009.manukyan_ca_step" ;
    pk:leanTheorem "MathOfBiology.Loop_009.manukyan_outer_totalistic_ca_labyrinth_fixed_point" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thin-Film Depth Average of a Skin Column (3D voxel skin volume → 2D depth-averaged reduction)" ;
    dct:description "Justifies replacing the 3D voxel field by its depth average wherever the field is vertically uniform (thin-film regime h ≪ λ_c) and gives the border column its reduced capacity h(x) in the depth-averaged equation | Variables: h: skin column height in voxels (h_interior = 12, h_border = P·h_interior); c: voxel concentration; ū: depth-averaged concentration used by the 2D reduction d ū/dt = F(ū) + (1/h)∇·(h D ∇ū)" ;
    dct:source "Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433 (3D skin-scale reaction-diffusion); thin-film / lubrication reduction of diffusion in a domain of varying thickness" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L739-L865>,
        <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L109-L137> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def column_mass (h c : Nat) : Nat := h * c
def depth_average (h m : Nat) : Nat := m / h
theorem thin_film_depth_average_recovers_uniform_column
    (h_interior h_border c : Nat) (hpos : 0 < h_interior) (hle : h_border ≤ h_interior) :
    depth_average h_interior (column_mass h_interior c) = c ∧
    column_mass h_border c ≤ column_mass h_interior c := by
  unfold depth_average column_mass
  exact ⟨Nat.mul_div_cancel_left c hpos, Nat.mul_le_mul_right c hle⟩
"""^^pk:lean4 ;
    skos:notation "ū = (1/h) Σ_z u;   u(z) ≡ c ⟹ ū = (h·c)/h = c;   h_border ≤ h_interior ⟹ h_border·c ≤ h_interior·c" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevX.13.041011> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
    pk:leanDeclaration "MathOfBiology.Loop_009.column_mass, MathOfBiology.Loop_009.depth_average" ;
    pk:leanTheorem "MathOfBiology.Loop_009.thin_film_depth_average_recovers_uniform_column" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/manukyan-ocellated-lizard-ca-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Finite-Volume Face Conductance Between Skin Columns Equals Shared Face Area (min(h_i, h_j)·D)" ;
    dct:description "Proves that in the voxel skin volume all inter-scale flux passes through the thinned border with conductance reduced exactly by the thickness ratio P = h_border/h_interior, that P = 0 insulates scales, and that the 2D reduction's face conductance min(h_i, h_j)·D is the exact depth integral of the 3D face | Variables: h_i, h_j: heights (voxels) of two laterally adjacent skin columns; D: morphogen diffusivity; C_ij: depth-integrated conductance of their shared vertical face (number of skin-skin voxel pairs × D)" ;
    dct:source "Manukyan et al. (2017) Nature 544(7649):173-179 Fig. 4 (P = h_border/h_interior ≈ 0.17); Fofonjka & Milinkovitch (2021) Nat. Commun. 12:2433" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd54e11/2015-manukyan-ocellated-lizard-ca.py#L539-L557>,
        <https://github.com/fractastical/morpholib/blob/bd54e11/morphoeval/lean/loops/Loop_009_ocellated_lizard_ca.lean#L140-L176> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def face_conductance (h_i h_j D : Nat) : Nat := min h_i h_j * D
theorem voxel_face_conductance_ratio_equals_thickness_ratio
    (h_interior h_border D : Nat) (hlt : h_border < h_interior) (hD : 0 < D) :
    face_conductance h_interior h_border D = h_border * D ∧
    face_conductance h_interior h_interior D = h_interior * D ∧
    face_conductance h_interior h_border D * h_interior =
      face_conductance h_interior h_interior D * h_border ∧
    face_conductance h_interior 0 D = 0 ∧
    face_conductance h_interior h_border D < face_conductance h_interior h_interior D := by
  unfold face_conductance
  have hmin : min h_interior h_border = h_border := Nat.min_eq_right (Nat.le_of_lt hlt)
  have hself : min h_interior h_interior = h_interior := Nat.min_self h_interior
  have hzero : min h_interior 0 = 0 := Nat.min_eq_right (Nat.zero_le h_interior)
  rw [hmin, hself, hzero]
  refine ⟨rfl, rfl, ?_, by simp, Nat.mul_lt_mul_of_pos_right hlt hD⟩
  ac_rfl
"""^^pk:lean4 ;
    skos:notation "C_ij = min(h_i, h_j)·D;   C_int,border·h_interior = C_int,int·h_border  (ratio = h_border/h_interior ∀ D);   h_border = 0 ⟹ C = 0;   h_border < h_interior ∧ D > 0 ⟹ C_int,border < C_int,int" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevX.13.041011> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Scale-Level Cellular Automaton vs PDE" ;
    pk:leanDeclaration "MathOfBiology.Loop_009.face_conductance" ;
    pk:leanTheorem "MathOfBiology.Loop_009.voxel_face_conductance_ratio_equals_thickness_ratio" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1017/pab.2016.5>,
            <https://doi.org/10.1086/381042>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
            <https://doi.org/10.1666/06017.1>,
            <https://doi.org/10.3389/fevo.2017.00037> .
    <https://doi.org/10.1017/pab.2016.5> dct:date "2016"^^xsd:gYear ;
        dct:title "Axial growth gradients across the postprotaspid ontogeny of the Silurian trilobite Aulacopleura koninckii" .
    <https://doi.org/10.1086/381042> dct:date "2004"^^xsd:gYear ;
        dct:title "Exploring Developmental Modes in a Fossil Arthropod: Growth and Trunk Segmentation of the Trilobite Aulacopleura koninckii" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x> dct:date "1995"^^xsd:gYear ;
        dct:title "Growth and variation in the Silurian proetide trilobite Aulacopleura koninckii and its implications for trilobite palaeobiology" .
    <https://doi.org/10.1666/06017.1> dct:date "2006"^^xsd:gYear ;
        dct:title "The ontogeny of trilobite segmentation: a comparative approach" .
    <https://doi.org/10.3389/fevo.2017.00037> dct:date "2017"^^xsd:gYear ;
        dct:title "The Development of the Silurian Trilobite Aulacopleura koninckii Reconstructed by Applying Inferred Growth and Segmentation Dynamics" .
}


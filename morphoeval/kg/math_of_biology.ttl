<https://w3id.org/probknow/resource/assessment/2026-10-18-conus-audit-wolfram-conus-textile-rule30-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Wolfram (1984) Rule 30 & Meinhardt–Klingler (1987) Conus textile Pigmentation — Source and data traceability: 90/100" ;

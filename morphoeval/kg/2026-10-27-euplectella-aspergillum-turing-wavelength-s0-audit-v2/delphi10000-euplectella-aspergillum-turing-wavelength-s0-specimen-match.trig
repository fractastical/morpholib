sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Euplectella aspergillum Turing wavenumber at 34.3 µm (Holocene, detail s0) — Morphological realism / specimen match: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The remediated GIF keeps the tube fan and the square-plus-diagonal lattice, and the osculum lips are now smooth silica instead of horizontal bands. CV similarity against the Okeanos photograph is 86.4 (was 81.8), on 12 frames at 960×720. The mesh is still periodic and the photograph's irregular weave is not reproduced. Score rises from 74 to 80 for the rim fix, and stops there because the portrait is still a diagram of the animal." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/euplectella_aspergillum_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "specimen, remediated portrait, dispersion — docs/media/euplectella_aspergillum_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py at ed31c961, image/png, 719394 B, 1848×644 px, artifact_sha256 31028fa39db810dd610c01f1a689d327172cd2be0bb7a9be35a0b6c631013170 (sha256 31028fa39db810dd610c01f1a689d327172cd2be0bb7a9be35a0b6c631013170), spec_fingerprint 124c45a3077f43da708d297825fc3db1c1d902225fd1e9032d50f5b8e2db9ef2" .

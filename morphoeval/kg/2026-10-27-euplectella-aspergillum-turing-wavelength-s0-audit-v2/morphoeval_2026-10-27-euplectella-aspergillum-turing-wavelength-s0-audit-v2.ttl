<https://w3id.org/delphi/resource/math-law/delphi10000-euplectella-aspergillum-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Turing inequality at the 34.3 µm detail scale" ;
    dct:description "Wavelength selection is allowed only inside the Turing band. This (a, b, D_v) set is not the 51 µm sibling. | Variables: D_u = 1, D_v = 30, f_u = 0.8, g_v = -1, det(J) = 1, λ_c = 3.43e-05 m" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; kinetics evaluated at Aizenberg-scale λ for E. aspergillum" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/ed31c961/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py#L105-L135>,
        <https://github.com/fractastical/morpholib/blob/ed31c961/morphoeval/lean/loops/Loop_3224_euplectella_aspergillum_turing_wavelength_s0.lean#L34-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem schnakenberg_turing_inequality : 23 * 23 > 4 * 30 := by decide"^^pk:lean4 ;
    skos:notation "h^2 > 4 D_u D_v det(J), h = D_v f_u + D_u g_v = 23, 529 > 120" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jsb.2006.10.027>,
        <https://doi.org/10.1038/424899a>,
        <https://doi.org/10.1073/pnas.1415502112>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1112255> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3224.lambdaDetail" ;
    pk:leanTheorem "MathOfBiology.Loop_3224.schnakenberg_turing_inequality" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-euplectella-aspergillum-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber k_c = 2π / λ_c" ;
    dct:description "Pins the detail-scale wavenumber. Chronoseries 1/1 has no predecessor chronospecies. | Variables: λ_c = 343 × 10^-7 m = 3.43e-05 m; Holocene age 0 Ma" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/ed31c961/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py#L137-L149>,
        <https://github.com/fractastical/morpholib/blob/ed31c961/morphoeval/lean/loops/Loop_3224_euplectella_aspergillum_turing_wavelength_s0.lean#L29-L32> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem kc_rounds_two_pi_over_lambda : Int.natAbs ((183183 : Int) * 343 - 62831853) < 343 := by decide"^^pk:lean4 ;
    skos:notation "k_c = 183183 m^-1, |183183 * 343 - round(2π * 1e7)| = 84 < 343" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jsb.2006.10.027>,
        <https://doi.org/10.1038/424899a>,
        <https://doi.org/10.1073/pnas.1415502112>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1112255> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3224.kDetail" ;
    pk:leanTheorem "MathOfBiology.Loop_3224.kc_rounds_two_pi_over_lambda" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-euplectella-aspergillum-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation has no Turing band" ;
    dct:description "Negative control. Pattern formation at this scale requires D_v/D_u = 30, not equal diffusion. | Variables: 10·h = 8 + (-10) at equal diffusion" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/ed31c961/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py#L253-L266>,
        <https://github.com/fractastical/morpholib/blob/ed31c961/morphoeval/lean/loops/Loop_3224_euplectella_aspergillum_turing_wavelength_s0.lean#L42-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem equal_diffusion_has_no_turing_band : (8 : Int) + (-10) < 0 := by decide"^^pk:lean4 ;
    skos:notation "D_u = D_v = 1 ⇒ h = f_u + g_v = -0.2 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jsb.2006.10.027>,
        <https://doi.org/10.1038/424899a>,
        <https://doi.org/10.1073/pnas.1415502112>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1112255> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3224.lambdaCoarse" ;
    pk:leanTheorem "MathOfBiology.Loop_3224.equal_diffusion_has_no_turing_band" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-euplectella-aspergillum-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail scale packs more wavelengths than the 51 µm comparison tier" ;
    dct:description "What changes at this scale versus the coarser cellular tier. Age stays 0 Ma (chronoseries 1/1). | Variables: λ_detail = 343, λ_coarse = 510 in units of 10^-7 m" ;
    dct:source "Aizenberg et al. (2005) DOI:10.1126/science.1112255" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/ed31c961/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py#L58-L64>,
        <https://github.com/fractastical/morpholib/blob/ed31c961/morphoeval/lean/loops/Loop_3224_euplectella_aspergillum_turing_wavelength_s0.lean#L46-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem detail_packs_more_wavelengths : lambdaCoarse * 100 > lambdaDetail * 148 ∧ lambdaDetail * 149 > lambdaCoarse * 100 := by decide"^^pk:lean4 ;
    skos:notation "1.48 < λ_51 / λ_34.3 < 1.49" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jsb.2006.10.027>,
        <https://doi.org/10.1038/424899a>,
        <https://doi.org/10.1073/pnas.1415502112>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1112255> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3224.lambdaDetail" ;
    pk:leanTheorem "MathOfBiology.Loop_3224.detail_packs_more_wavelengths" ;
    pk:leanVerified true .


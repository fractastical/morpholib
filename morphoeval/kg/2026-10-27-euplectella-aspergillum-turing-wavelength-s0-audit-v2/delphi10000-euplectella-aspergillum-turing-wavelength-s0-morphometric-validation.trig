sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Euplectella aspergillum Turing wavenumber at 34.3 µm (Holocene, detail s0) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r=0.999989 and RMSE=0.00396, with equal-diffusion σ_max=−0.1025. On the remediated GIF crop: radial Pearson 0.948 (was 0.955), unit-vector RMSE 0.013, orientation KS 0.045 (was 0.075), coherency 0.313 against the specimen's 0.505 (was 0.192). The image radial correlation does not exceed 0.98. The dispersion correlation does. Specimen mask circularity 0.341 is not a self-comparison to 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-d-u-d-v-1-negative-control>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-lambda-0-25-lambda-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-pinned-critical-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-of-the-okeanos-photograph>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-orientation-histogram-ks-distance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-radial-spectrum-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-simulation-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-numerical-versus-analytical-sigma-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE between numerical and analytical growth rates = 0.003959 1/model time" ;
        dct:description "Finite-dt explicit Euler residual; reference 0 is the continuum limit, not the measured value" ;
        schema:measurementTechnique "root mean square of sigma_num - sigma(k) over the same 10 modes" ;
        schema:name "dispersion RMSE between numerical and analytical growth rates" ;
        schema:unitText "1/model time" ;
        schema:value "0.003959" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-dispersion-rmse-between-numerical-and-analytical-growth-rates-reference> a schema:PropertyValue ;
        dct:source "exact linearisation of the Schnakenberg Jacobian at (u0, v0) = (1, 0.9)" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-d-u-d-v-1-negative-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation sigma_max (D_u = D_v = 1 negative control) = -0.1025 1/model time" ;
        dct:description "h = -0.2000 < 0; pattern-forming control is the D_v = 30 run, not this ablation" ;
        schema:measurementTechnique "max_k sigma(k) on k in [0.05, 2.5] with D_u = D_v = 1" ;
        schema:name "equal-diffusion ablation sigma_max (D_u = D_v = 1 negative control)" ;
        schema:unitText "1/model time" ;
        schema:value "-0.1025" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-d-u-d-v-1-negative-control-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-equal-diffusion-ablation-sigma-max-d-u-d-v-1-negative-control-reference> a schema:PropertyValue ;
        dct:source "Turing condition (iii) fails when h = f_u + g_v = -0.2 < 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-lambda-0-25-lambda-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma sweep wavelength ratio lambda(0.25)/lambda(1) = 2.0 dimensionless" ;
        dct:description "Four other gamma points are in the metrics JSON; lambda falls monotonically from gamma 0.25 to 4" ;
        schema:measurementTechnique "k_c(gamma) from h(gamma)/(2 D_u D_v) with the gamma=1 metre calibration held fixed" ;
        schema:name "gamma sweep wavelength ratio lambda(0.25)/lambda(1)" ;
        schema:unitText "dimensionless" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-lambda-0-25-lambda-1-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-gamma-sweep-wavelength-ratio-lambda-0-25-lambda-1-reference> a schema:PropertyValue ;
        dct:source "k_c scales as sqrt(gamma) when every reaction entry scales with gamma" ;
        schema:value "2.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-pinned-critical-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pinned critical wavelength lambda_c = 3.43e-05 m" ;
        dct:description "34.3 µm detail scale versus 51 µm; λ_coarse/λ_detail = 510/343 = 1.487. Geological age of this slot is 0 Ma." ;
        schema:measurementTechnique "slot scale 3.43e-05 m at Holocene age 0 Ma, k_c = 2π/λ_c" ;
        schema:name "pinned critical wavelength lambda_c" ;
        schema:unitText "m" ;
        schema:value "3.43e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-pinned-critical-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-pinned-critical-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "coarser 51 µm cellular-tier comparison wavelength, a different slot (not an age)" ;
        schema:value "5.1e-05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image contour circularity = 0.340925 4π area / perimeter²" ;
        dct:description "value is far from 1, so the metric is not a self-comparison against itself" ;
        schema:measurementTechnique "morphological perimeter of the bright-lattice mask" ;
        schema:name "specimen image contour circularity" ;
        schema:unitText "4π area / perimeter²" ;
        schema:value "0.340925" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circle; the sponge fan is not a circle" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-of-the-okeanos-photograph> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image foreground fraction of the Okeanos photograph = 0.744212 area fraction" ;
        dct:description "aspect h/w = 0.5549, circularity = 0.3409" ;
        schema:measurementTechnique "gray > 45, binary closing, hole fill, on the vendored 1920x1080 public-domain frame" ;
        schema:name "specimen image foreground fraction of the Okeanos photograph" ;
        schema:unitText "area fraction" ;
        schema:value "0.744212" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-of-the-okeanos-photograph-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-of-the-okeanos-photograph-reference> a schema:PropertyValue ;
        dct:source "neutral half-frame prior, not the measured mask" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-orientation-histogram-ks-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image orientation-histogram KS distance = 0.044556 KS distance" ;
        dct:description "coherency specimen 0.505 versus simulation 0.313; edge density 0.246 versus 0.408" ;
        schema:measurementTechnique "sup-norm of the CDF difference of 12-bin Sobel orientation histograms" ;
        schema:name "specimen image orientation-histogram KS distance" ;
        schema:unitText "KS distance" ;
        schema:value "0.044556" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-orientation-histogram-ks-distance-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-orientation-histogram-ks-distance-reference> a schema:PropertyValue ;
        dct:source "identical orientation laws would have KS = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-radial-spectrum-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image radial-spectrum Pearson r = 0.948437 Pearson r" ;
        dct:description "unit-vector RMSE = 0.0129" ;
        schema:measurementTechnique "Pearson r of log radial FFT bins 2:24, fitness-crop windows of photograph versus last GIF frame" ;
        schema:name "specimen image radial-spectrum Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.948437" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-radial-spectrum-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-radial-spectrum-pearson-r-reference> a schema:PropertyValue ;
        dct:source "identity match to the Okeanos photograph would be 1; the portrait is a model" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-simulation-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image simulation coherency = 0.312637 structure-tensor coherency" ;
        dct:description "reported only when the two coherencies differ; a tie would be a failed non-circular check" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) on the GIF crop" ;
        schema:name "specimen image simulation coherency" ;
        schema:unitText "structure-tensor coherency" ;
        schema:value "0.312637" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-simulation-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-specimen-image-simulation-coherency-reference> a schema:PropertyValue ;
        dct:source "same operator on the Okeanos crop" ;
        schema:value "0.505017" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-numerical-versus-analytical-sigma-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing dispersion Pearson r of numerical versus analytical sigma(k) = 0.999989 Pearson r" ;
        dct:description "RMSE = 0.003959 on n = 10 wavenumbers (RMSE is not zero)" ;
        schema:measurementTechnique "1D Schnakenberg, 10 Fourier seeds, log-amplitude slope versus eig(J-k^2 D)" ;
        schema:name "Turing dispersion Pearson r of numerical versus analytical sigma(k)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999989" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-numerical-versus-analytical-sigma-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-of-numerical-versus-analytical-sigma-k-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 Phil. Trans. R. Soc. B 237:37-72, linear dispersion relation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py L185–L266" ;
        dct:description "numerical growth rates and equal-diffusion control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ed31c961/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py#L185-L266> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py L490–L521" ;
        dct:description "Pearson, RMSE, and KS on the fitness crops" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ed31c961/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py#L490-L521> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "datasets/euplectella_aspergillum_turing_wavelength_s0/euplectella_aspergillum_turing_wavelength_s0_metrics.json L1–L40" ;

}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jsb.2006.10.027>,
            <https://doi.org/10.1038/424899a>,
            <https://doi.org/10.1073/pnas.1415502112>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1112255> .
    <https://doi.org/10.1016/j.jsb.2006.10.027> dct:date "2007"^^xsd:gYear ;
        dct:title "Hierarchical assembly of the siliceous skeletal lattice of the hexactinellid sponge Euplectella aspergillum" .
    <https://doi.org/10.1038/424899a> dct:date "2003"^^xsd:gYear ;
        dct:title "Fibre-optical features of a glass sponge" .
    <https://doi.org/10.1073/pnas.1415502112> dct:date "2015"^^xsd:gYear ;
        dct:title "New functional insights into the internal architecture of the laminated anchor spicules of Euplectella aspergillum" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1112255> dct:date "2005"^^xsd:gYear ;
        dct:title "Skeleton of Euplectella sp.: structural hierarchy from the nanoscale to the macroscale" .
}


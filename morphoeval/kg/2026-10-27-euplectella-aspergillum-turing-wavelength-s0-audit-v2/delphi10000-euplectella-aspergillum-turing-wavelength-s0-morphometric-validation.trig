        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ed31c961/datasets/euplectella_aspergillum_turing_wavelength_s0/euplectella_aspergillum_turing_wavelength_s0_metrics.json#L1-L40> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, Pass 2 remediation; second assessor not run)" ;

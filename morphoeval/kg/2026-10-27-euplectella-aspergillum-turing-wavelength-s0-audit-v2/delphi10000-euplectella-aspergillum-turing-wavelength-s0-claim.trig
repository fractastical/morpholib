sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-euplectella-aspergillum-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Euplectella aspergillum Turing wavenumber at 34.3 µm (Holocene, detail s0) faithfully reproduces Euplectella aspergillum morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Euplectella aspergillum specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py; output: docs/media/euplectella_aspergillum_turing_wavelength_s0_comparison.png; organism: Euplectella aspergillum; environment: n/a; claim_boundary: [reported_in_source: Aizenberg et al. 2005: seven hierarchical levels and a cylindrical square lattice reinforced by diagonal ridges. | Weaver et al. 2007: assembly of the siliceous lattice of E. aspergillum. | Turing 1952: dispersion relation and critical wavenumber.; reconstructed_in_script: Schnakenberg linearisation and σ(k), calibrated to λ_c=3.43e-05 m. | Four-mode amplitude equations on |k|=k_c, drawn with a fixed reference radius. | Equal-diffusion ablation, γ sweep, specimen-crop Pearson, RMSE, and KS.; transfer_boundary: Cohort wording 'pigment stripe / ocellus' names a skeletal-lattice wavelength. The portrait magnifies λ_c.; does_not_claim: That this sponge has ocelli or pigment stripes. | That the image radial Pearson exceeded 0.98. It is 0.948. | That Monn et al. 2015 lamella thicknesses were fitted, or that a second specimen was scored. | A chronospecies split. Holocene only, 0 Ma, chronoseries 1/1.]; phenomenon_size: 1.0 µm (1.02e-06 m, log10=-5.991 m, tier=3_subcellular_um); species_scale_ladder (11 runs from 1.0 µm to 3.3 cm): 1.0 µm:euplectella-aspergillum-bioelectric-polarity, 3.2 µm:euplectella-aspergillum-vertex-packing, 51 µm:euplectella-aspergillum-turing-wavelength, 102 µm:euplectella-aspergillum-clock-wavefront, 230 µm:euplectella-aspergillum-morphogen-condensation, 280 µm:euplectella-aspergillum-elastic-buckling, 319 µm:euplectella-aspergillum-flux-canalization, 446 µm:euplectella-aspergillum-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jsb.2006.10.027>,
            <https://doi.org/10.1038/424899a>,
            <https://doi.org/10.1073/pnas.1415502112>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1112255> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-euplectella-aspergillum-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jsb.2006.10.027>,
            <https://doi.org/10.1038/424899a>,
            <https://doi.org/10.1073/pnas.1415502112>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1112255> .
    <https://doi.org/10.1016/j.jsb.2006.10.027> dct:date "2007"^^xsd:gYear ;
        dct:title "Hierarchical assembly of the siliceous skeletal lattice of the hexactinellid sponge Euplectella aspergillum" .
    <https://doi.org/10.1038/424899a> dct:date "2003"^^xsd:gYear ;
        dct:title "Fibre-optical features of a glass sponge" .
    <https://doi.org/10.1073/pnas.1415502112> dct:date "2015"^^xsd:gYear ;
        dct:title "New functional insights into the internal architecture of the laminated anchor spicules of Euplectella aspergillum" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1112255> dct:date "2005"^^xsd:gYear ;
        dct:title "Skeleton of Euplectella sp.: structural hierarchy from the nanoscale to the macroscale" .
}


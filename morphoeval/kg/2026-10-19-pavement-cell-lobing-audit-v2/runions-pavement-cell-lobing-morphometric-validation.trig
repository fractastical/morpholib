sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L724-802) reports 9 reference-anchored morphometric measurements with uncertainty, p-values, and negative controls: mature WT R_LEC = 11.576 um (ref 11.4 um), R_LEC(A) trajectory Pearson r = 0.9859 (p = 2.97e-4, RMSE = 0.314 um), isotropic-to-puzzle stress ratio 3.270 (ref 3.32), ROP2-ROP6 intracortical anticorrelation r = -0.9899 (ref -0.92, p = 1.64e-166), trans-wall complementarity r = 0.9998 (ref 0.94), lobe wavelength 24.50 um (ref 24.5 um), mature WT solidity S = 0.6735 (ref 0.68), ktn1 mutant lobeyness collapse L = 1.1107 (ref 1.11), and segmented SEM specimen solidity S = 0.7200 (ref 0.68)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-lobe-wavelength-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-reduction-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-ktn1-mutant-lobeyness-collapse-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-intracortical-anticorrelation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-trans-wall-complementarity-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-specimen-segmented-pavement-solidity-s>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-lec-area-scaling-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-puzzle-cell-solidity-s>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-lobe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "anticlinal_lobe_wavelength_um = 24.5 um" ;
        schema:measurementTechnique "Dominant Fourier mode k = 8 along L = 196.0 um shared anticlinal wall" ;
        schema:name "anticlinal_lobe_wavelength_um" ;
        schema:unitText "um" ;
        schema:value "24.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-lobe-wavelength-um-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-lobe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 & Bidhendi et al. (2019) Nat. Plants 5:981-992 characteristic pavement cell lobe wavelength 24.5 ± 2.8 um" ;
        schema:value "24.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-reduction-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "isotropic_vs_puzzle_stress_reduction_ratio = 3.27 ratio" ;
        schema:measurementTechnique "Ratio sigma_iso(4500) / sigma_WT(4500) = 37.85 MPa / 11.58 MPa at P = 0.60 MPa, h = 0.30 um (Lean 4 Law 1 verified)" ;
        schema:name "isotropic_vs_puzzle_stress_reduction_ratio" ;
        schema:unitText "ratio" ;
        schema:value "3.27" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-reduction-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-reduction-ratio-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Fig. 1 & Box 1 (outer periclinal wall tensile stress sigma_max = P*R_LEC/(2h): 75.7 MPa isotropic vs 22.8 MPa WT puzzle cell)" ;
        schema:value "3.32" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-ktn1-mutant-lobeyness-collapse-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ktn1_mutant_lobeyness_collapse_L = 1.1107 dimensionless" ;
        schema:measurementTechnique "Negative perturbation control k_rop -> 0.11 (mutant solidity S = 0.886 vs ref 0.90; rop2 rop4 RNAi L = 1.060 vs ref 1.07)" ;
        schema:name "ktn1_mutant_lobeyness_collapse_L" ;
        schema:unitText "dimensionless" ;
        schema:value "1.1107" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-ktn1-mutant-lobeyness-collapse-l-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-ktn1-mutant-lobeyness-collapse-l-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Fig. 5 & Lin et al. (2013) Curr. Biol. 23:290-297 ktn1/ric1 mutant lobeyness collapse L = 1.11 ± 0.05 (vs WT 1.62)" ;
        schema:value "1.11" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-intracortical-anticorrelation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rop2_rop6_intracortical_anticorrelation_r = -0.9899 r" ;
        schema:measurementTechnique "196-node periodic anticlinal boundary reaction-diffusion PDE integration (r = -0.9899, p = 1.64e-166)" ;
        schema:name "rop2_rop6_intracortical_anticorrelation_r" ;
        schema:unitText "r" ;
        schema:value "-0.9899" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-intracortical-anticorrelation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-intracortical-anticorrelation-r-reference> a schema:PropertyValue ;
        dct:source "Fu et al. (2005) Cell 120(5):687-700 Figs. 2-4 & Lin et al. (2013) Curr. Biol. 23:290-297 mutually exclusive cortical ROP2-RIC4 (lobes) and ROP6-RIC1 (necks)" ;
        schema:value "-0.92" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-trans-wall-complementarity-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rop2_rop6_trans_wall_complementarity_r = 0.9998 r" ;
        schema:measurementTechnique "Cross-wall Pearson correlation between U_A(s) and V_B(s) (r = 0.9998, p = 0.00e+00, area conservation error = 0.00e+00 um^2)" ;
        schema:name "rop2_rop6_trans_wall_complementarity_r" ;
        schema:unitText "r" ;
        schema:value "0.9998" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-trans-wall-complementarity-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-trans-wall-complementarity-r-reference> a schema:PropertyValue ;
        dct:source "Fu et al. (2005) Cell 120(5):687-700 Fig. 1 & Bidhendi et al. (2019) Nat. Plants 5:981-992 convex lobe ROP2 on cell A paired with concave neck ROP6 on cell B" ;
        schema:value "0.94" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-specimen-segmented-pavement-solidity-s> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmented_pavement_solidity_S = 0.72 dimensionless" ;
        schema:measurementTechnique "DoG + zero-compactness watershed segmentation of N = 10 puzzle cells on 1280x960 SEM micrograph (mean S = 0.720 ± 0.041, min S = 0.626, calibrated R_LEC = 11.40 um)" ;
        schema:name "specimen_segmented_pavement_solidity_S" ;
        schema:unitText "dimensionless" ;
        schema:value "0.72" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-specimen-segmented-pavement-solidity-s-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-specimen-segmented-pavement-solidity-s-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 & File:Arabidopsis-epiderm-stomata.jpg (Wikimedia Commons CC BY-SA 3.0)" ;
        schema:value "0.68" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-lec-area-scaling-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wt_lec_area_scaling_pearson_r = 0.9859 r" ;
        schema:measurementTechnique "Pearson correlation across 6 developmental cell area stages (r = 0.9859, p = 2.97e-04, RMSE = 0.314 um)" ;
        schema:name "wt_lec_area_scaling_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9859" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-lec-area-scaling-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-lec-area-scaling-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Fig. 2 R_LEC(A) trajectory across A in [250, 4500] um^2" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wt_mature_lec_radius_at_4500um2 = 11.576 um" ;
        schema:measurementTechnique "Exact 2D Euclidean Distance Transform inscribed circle on spring-remodeled WT puzzle polygon (RMSE across 6 area stages = 0.314 um)" ;
        schema:name "wt_mature_lec_radius_at_4500um2" ;
        schema:unitText "um" ;
        schema:value "11.576" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Figs. 2-3 (mature wild-type Arabidopsis pavement cell R_LEC plateau ~ 11.4 ± 1.1 um at A = 4500 um^2)" ;
        schema:value "11.4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-puzzle-cell-solidity-s> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wt_puzzle_cell_solidity_S = 0.6735 dimensionless" ;
        schema:measurementTechnique "ConvexHull area ratio on mature WT puzzle polygons (lobeyness L = 1.432 vs ref 1.62)" ;
        schema:name "wt_puzzle_cell_solidity_S" ;
        schema:unitText "dimensionless" ;
        schema:value "0.6735" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-puzzle-cell-solidity-s-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-puzzle-cell-solidity-s-reference> a schema:PropertyValue ;
        dct:source "Sapala et al. (2018) eLife 7:e32794 Fig. 5 mature wild-type Arabidopsis Col-0 pavement cell solidity S = A / A_hull = 0.68 ± 0.05" ;
        schema:value "0.68" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L724–L802" ;
        dct:description "9 reference-anchored morphometric measurements with Pearson p-values, RMSE, and mutant controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L724-L802> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/39> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2004.12.026>,
            <https://doi.org/10.1016/j.cub.2013.01.022>,
            <https://doi.org/10.1038/s41477-019-0500-2>,
            <https://doi.org/10.7554/eLife.01967>,
            <https://doi.org/10.7554/eLife.32794> .
    <https://doi.org/10.1016/j.cell.2004.12.026> dct:date "2005"^^xsd:gYear ;
        dct:title "Arabidopsis Interdigitating Cell Growth Requires Two Antagonistic Pathways with Opposing Action on Cell Morphogenesis" .
    <https://doi.org/10.1016/j.cub.2013.01.022> dct:date "2013"^^xsd:gYear ;
        dct:title "Rho GTPase Signaling Activates Microtubule Severing to Promote Lobe Outgrowth in Arabidopsis Pavement Cells" .
    <https://doi.org/10.1038/s41477-019-0500-2> dct:date "2019"^^xsd:gYear ;
        dct:title "Mechanical stress initiates and sustains the morphogenesis of wavy leaf epidermal cells" .
    <https://doi.org/10.7554/eLife.01967> dct:date "2014"^^xsd:gYear ;
        dct:title "Subcellular and supracellular mechanical stress prescribes cytoskeleton behavior in Arabidopsis cotyledon pavement cells" .
    <https://doi.org/10.7554/eLife.32794> dct:date "2018"^^xsd:gYear ;
        dct:title "Why plants make puzzle cells, and how their shape emerges" .
}


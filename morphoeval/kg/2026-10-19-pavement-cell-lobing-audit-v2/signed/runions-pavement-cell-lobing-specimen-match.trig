sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 Arabidopsis thaliana leaf epidermis SEM micrograph (`arabidopsis_pavement_cell_specimen.jpg`, 1280x960), applies DoG anticlinal wall groove enhancement and zero-compactness watershed segmentation (`segment_arabidopsis_pavement_specimen`, L484-575) to extract 10 interlocking puzzle-shaped pavement cells, and measures their empirical solidity (mean S = 0.720 ± 0.041, min S = 0.626), lobeyness (mean L = 1.506), and inscribed R_LEC circles." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L484–L575" ;
        dcterms:description "DoG + zero-compactness watershed segmentation and EDT R_LEC extraction on 10 Arabidopsis puzzle cells" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L484-L575> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/pavement_cell_lobing_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure overlaying segmented puzzle cell contours and inscribed LEC circles on the SEM specimen — docs/media/pavement_cell_lobing_comparison.png: rendered output of 2017-runions-pavement-cell-lobing.py at 8871db0, image/png, 961496 B, 2548×1568 px, artifact_sha256 8df82fae6327068a70bf77aefe4e8d85e05dc9e0d53c002655ab4d6165803e01 (sha256 8df82fae6327068a70bf77aefe4e8d85e05dc9e0d53c002655ab4d6165803e01), spec_fingerprint 972460a5749d7d30868f5de9c61bcfd278fa143f89d629090a75b7aa4ebdc287" .


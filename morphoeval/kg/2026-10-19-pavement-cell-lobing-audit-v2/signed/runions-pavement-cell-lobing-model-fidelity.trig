sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements exact 2D Euclidean Distance Transform Largest Empty Circle (`compute_exact_lec_from_polygon`, L137-186), ConvexHull solidity & lobeyness (`compute_lobeyness_and_solidity`, L114-134), Sapala et al. (2018) spring-remodeled puzzle cell area scaling across WT, isotropic, ktn1/ric1, rop2 rop4 RNAi, and monocot file regimes (`simulate_puzzle_cell_area_scaling`, L257-357), and a 196-node coupled ROP2–ROP6 anticlinal boundary reaction-diffusion PDE solver (`simulate_rop2_rop6_cortical_rd`, L363-478), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L137–L357" ;
        dcterms:description "Exact EDT Largest Empty Circle solver and 5-regime cell area scaling across A in [250, 4500] um^2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L137-L357> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L363–L478" ;
        dcterms:description "196-node coupled ROP2-RIC4 and ROP6-RIC1-KTN1 cortical reaction-diffusion PDE solver across shared anticlinal walls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L363-L478> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean L15–L117" ;
        dcterms:description "3 machine-checked Lean 4 theorems for LEC stress suppression, ROP2-ROP6 trans-wall conservation, and mutant lobeyness collapse (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean#L15-L117> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


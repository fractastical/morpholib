    <https://doi.org/10.1016/j.cell.2004.12.026> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "Arabidopsis Interdigitating Cell Growth Requires Two Antagonistic Pathways with Opposing Action on Cell Morphogenesis" .

    <https://doi.org/10.1016/j.cub.2013.01.022> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Rho GTPase Signaling Activates Microtubule Severing to Promote Lobe Outgrowth in Arabidopsis Pavement Cells" .

    <https://doi.org/10.1038/s41477-019-0500-2> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "Mechanical stress initiates and sustains the morphogenesis of wavy leaf epidermal cells" .

    <https://doi.org/10.7554/eLife.01967> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "Subcellular and supracellular mechanical stress prescribes cytoskeleton behavior in Arabidopsis cotyledon pavement cells" .

    <https://doi.org/10.7554/eLife.32794> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "Why plants make puzzle cells, and how their shape emerges" .

    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/39> ;

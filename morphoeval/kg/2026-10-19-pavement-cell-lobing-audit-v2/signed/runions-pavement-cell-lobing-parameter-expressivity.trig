sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-runions-pavement-cell-lobing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps 6 developmental cell area stages A in [250, 4500] um^2 across 5 morphological / genetic regimes (WT Col-0, unlobed isotropic, ktn1/ric1 mutant, rop2 rop4 RNAi, and monocot parallel-file epidermis, L257-357), supports ROP2-ROP6 cross-inhibition ablation in the PDE solver (L404-410), and exposes `--turgor-P`, `--wall-h`, `--neck-R0`, `--gamma-cross`, `--alpha-wall`, and `--seed` CLI flags (L846-885)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L257–L357" ;
        dcterms:description "6-stage area scaling across 5 genotypes and cell geometries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L257-L357> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L846–L885" ;
        dcterms:description "CLI parameter overrides wired into mechanical scaling and cortical RD solvers" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L846-L885> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


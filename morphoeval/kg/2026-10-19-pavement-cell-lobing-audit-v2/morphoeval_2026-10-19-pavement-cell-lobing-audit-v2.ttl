    pk:hasScore 9.3e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Model fidelity to source: 94/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements exact 2D Euclidean Distance Transform Largest Empty Circle (`compute_exact_lec_from_polygon`, L137-186), ConvexHull solidity & lobeyness (`compute_lobeyness_and_solidity`, L114-134), Sapala et al. (2018) spring-remodeled puzzle cell area scaling across WT, isotropic, ktn1/ric1, rop2 rop4 RNAi, and monocot file regimes (`simulate_puzzle_cell_area_scaling`, L257-357), and a 196-node coupled ROP2–ROP6 anticlinal boundary reaction-diffusion PDE solver (`simulate_rop2_rop6_cortical_rd`, L363-478), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean`." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-2>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-model-fidelity-3> ;
    pk:hasScore 9.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-runions-pavement-cell-lobing-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Morphometric validation: 94/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "`measure_morphoeval()` (L724-802) reports 9 reference-anchored morphometric measurements with uncertainty, p-values, and negative controls: mature WT R_LEC = 11.576 um (ref 11.4 um), R_LEC(A) trajectory Pearson r = 0.9859 (p = 2.97e-4, RMSE = 0.314 um), isotropic-to-puzzle stress ratio 3.270 (ref 3.32), ROP2-ROP6 intracortical anticorrelation r = -0.9899 (ref -0.92, p = 1.64e-166), trans-wall complementarity r = 0.9998 (ref 0.94), lobe wavelength 24.50 um (ref 24.5 um), mature WT solidity S = 0.6735 (ref 0.68), ktn1 mutant lobeyness collapse L = 1.1107 (ref 1.11), and segmented SEM specimen solidity S = 0.7200 (ref 0.68)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-anticlinal-lobe-wavelength-um>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-isotropic-vs-puzzle-stress-reduction-ratio>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-ktn1-mutant-lobeyness-collapse-l>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-intracortical-anticorrelation-r>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-rop2-rop6-trans-wall-complementarity-r>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-specimen-segmented-pavement-solidity-s>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-lec-area-scaling-pearson-r>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-mature-lec-radius-at-4500um2>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-measurement-wt-puzzle-cell-solidity-s>,

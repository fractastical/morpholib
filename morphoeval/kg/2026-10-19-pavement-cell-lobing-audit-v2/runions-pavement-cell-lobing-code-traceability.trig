        rdfs:label "Sapala et al. (2018) & Fu et al. (2005) ROP2-ROP6 interdigitated puzzle-shaped pavement cell lobing and Largest Empty Circle (LEC) turgor stress scaling — Code-to-model traceability: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module and function docstrings map every governing equation to Sapala et al. (2018) eLife Figs. 1-5 & Box 1, Fu et al. (2005) Cell Figs. 1-7, Lin et al. (2013) Curr. Biol., Bidhendi et al. (2019) Nat. Plants, and the 3 formal Lean 4 theorems in `morphoeval/lean/loops/Loop_039_pavement_cell_lobing.lean` (L1-51)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-code-traceability-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-runions-pavement-cell-lobing-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2017-runions-pavement-cell-lobing.py L1–L51" ;
        dct:description "Explicit equation-to-paper and Lean 4 theorem traceability in module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2017-runions-pavement-cell-lobing.py#L1-L51> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 039 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


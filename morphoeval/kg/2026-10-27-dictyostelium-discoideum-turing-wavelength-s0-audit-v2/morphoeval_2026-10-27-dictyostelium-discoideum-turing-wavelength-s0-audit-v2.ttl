<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Dictyostelium discoideum Schnakenberg Turing wavelength at 2.304 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 76/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Side by side, the public-domain sorocarp and the cortical spot field are different objects, and the border-contrast mask is a coarse 160×120 segmentation (circularity 0.096), not a hand trace of two stalks. The GIF last frame still shares Sobel, radial-FFT, and coherency structure with the photograph at cv_sim_similarity 83.2, which is a texture match rather than anatomical identity. The score credits that measured resemblance and the labeled scale gap." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

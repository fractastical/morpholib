        <https://w3id.org/delphi/resource/evidence/2026-10-27-dictyostelium-discoideum-turing-wavelength-s0-audit-v2-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-9> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Dictyostelium discoideum Schnakenberg Turing wavelength at 2.304 µm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Schnakenberg kinetics, periodic five-point Laplacian, and the unstable-eigenvector initial condition reproduce σ(k) with Pearson r = 0.9999999973 on 23 modes (RMSE 3.67e-05 /s). Ten points are withheld because the biological cortical waves are excitable (Taniguchi 2013), and Schnakenberg is the reconstructed carrier of k_c rather than that phase model." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;

            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dictyostelium-discoideum-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

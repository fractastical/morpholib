sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P) & Gibson-Ashby cellular mechanics — Morphometric validation: 50/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Reports only 3 analytical scalars in `measure_morphoeval()` (L103-135) without validating 3D mean/Gaussian curvature, Euler characteristic chi, 12-species cross-taxa Echinodermata stereom stiffness and lattice period, or empirical SEM pore/trabecular period segmentation." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2020-gorzelak-crinoid-stereom-gyroid.py L103–L135: Only 3 analytical metrics without 3D curvature, 12-species cross-taxa, or SEM specimen validation <https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py#L103-L135>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-gibson-ashby-stretching-vs-bending-stiffness-ratio-at-phi-0-50>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schoen-gyroid-zero-level-set-solid-fraction-phi-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schwarz-diamond-tetrahedral-inter-strut-angle-arccos-1-3> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-gibson-ashby-stretching-vs-bending-stiffness-ratio-at-phi-0-50> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gibson-Ashby stretching vs bending stiffness ratio at phi = 0.50 = 2.0 ratio" ;
        schema:measurementTechnique "Ratio E_stretch(0.50) / E_bend(0.50)" ;
        schema:name "Gibson-Ashby stretching vs bending stiffness ratio at phi = 0.50" ;
        schema:unitText "ratio" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-gibson-ashby-stretching-vs-bending-stiffness-ratio-at-phi-0-50-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-gibson-ashby-stretching-vs-bending-stiffness-ratio-at-phi-0-50-reference> a schema:PropertyValue ;
        dct:source "Gibson & Ashby (1997) Cellular Solids" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schoen-gyroid-zero-level-set-solid-fraction-phi-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schoen Gyroid zero-level-set solid fraction phi(0) = 0.4998 fraction" ;
        schema:measurementTechnique "2D slice fraction of F_G(x,y,z) >= 0 at c = 0" ;
        schema:name "Schoen Gyroid zero-level-set solid fraction phi(0)" ;
        schema:unitText "fraction" ;
        schema:value "0.4998" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schoen-gyroid-zero-level-set-solid-fraction-phi-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schoen-gyroid-zero-level-set-solid-fraction-phi-0-reference> a schema:PropertyValue ;
        dct:source "Schoen (1970) NASA TN D-5541" ;
        schema:value "0.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schwarz-diamond-tetrahedral-inter-strut-angle-arccos-1-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schwarz Diamond tetrahedral inter-strut angle arccos(-1/3) = 109.4712 deg" ;
        schema:measurementTechnique "Analytical tetrahedral angle between [111] Diamond struts" ;
        schema:name "Schwarz Diamond tetrahedral inter-strut angle arccos(-1/3)" ;
        schema:unitText "deg" ;
        schema:value "109.4712" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schwarz-diamond-tetrahedral-inter-strut-angle-arccos-1-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schwarz-diamond-tetrahedral-inter-strut-angle-arccos-1-3-reference> a schema:PropertyValue ;
        dct:source "Yang et al. (2022) Science 375:647-652" ;
        schema:value "109.4712" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


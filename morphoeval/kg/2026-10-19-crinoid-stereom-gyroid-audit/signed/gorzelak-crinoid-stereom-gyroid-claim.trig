sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> a pk:Claim ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P) & Gibson-Ashby cellular mechanics faithfully reproduces Protoreaster nodosus (Asteroidea) & Metacrinus rotundus / Nesometra integra (Crinoidea) / Cidaris rugosa (Echinoidea) morphology" ;
        dcterms:description "The simulation script(s) 2020-gorzelak-crinoid-stereom-gyroid.py implement the cited source model as published and produce forms that match real Protoreaster nodosus (Asteroidea) & Metacrinus rotundus / Nesometra integra (Crinoidea) / Cidaris rugosa (Echinoidea) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 48.5/100, audit 2026-10-19-crinoid-stereom-gyroid-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py; output: docs/media/crinoid_stereom_gyroid_comparison.png; organism: Protoreaster nodosus (Asteroidea) & Metacrinus rotundus / Nesometra integra (Crinoidea) / Cidaris rugosa (Echinoidea); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 7546780a29581d038c82edc49698f8e73b11c59c0a49d82e3dfc8f721733c9d2; artifact_sha256: 15af9af33e400cd89194f5f2adc889844144643f661ebe5efb7e2dc8266184db; input_dataset_sha256: {datasets/crinoid_stereom_gyroid/crinoid_stereom_gyroid_reference.json=c1c3848ef15d0bfc..., datasets/crinoid_stereom_gyroid/crinoid_stereom_ossicle_specimen.jpg=5fbf6e4db0ee1d44..., datasets/crinoid_stereom_gyroid/scout_manifest.json=0524b76e141ef1fe...}" ;
        pk:derivedFromPaper <https://doi.org/10.1017/CBO9781139878326>,
            <https://doi.org/10.1063/1.1665587>,
            <https://doi.org/10.1126/science.166.3909.1147>,
            <https://doi.org/10.1126/science.abm8666> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity>,

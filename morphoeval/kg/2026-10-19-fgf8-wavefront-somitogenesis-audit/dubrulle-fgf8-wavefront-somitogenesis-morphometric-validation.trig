sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis — Morphometric validation: 55/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Measures determination front position x* = 696.47 um, but Pass 1 requires full 5-regime Pearson correlation r and RMSE against Dubrulle et al. (2001) empirical somite lengths plus bilateral specimen spacing CV and symmetry ratio." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2003-dubrulle-fgf8-wavefront-somitogenesis.py L430–L505: MorphoEval measurement hook measure_morphoeval() <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L430-L505>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-psm-determination-front-distance-from-tailbud-x-v-g-k-d-ln-m-0-m-crit>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-dubrulle-et-al-2001-2004-5-regime-somite-length-prediction-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ectopic-fgf8-bead-anterior-compressed-somite-length-s-ant>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-su5402-pharmacological-fgfr1-inhibition-enlarged-somite-length-s-su5402> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-psm-determination-front-distance-from-tailbud-x-v-g-k-d-ln-m-0-m-crit> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chick PSM determination front distance from tailbud x* = (v_g/k_d)*ln(m_0/m_crit) = 696.47 um" ;
        dct:description "wild-type somite length S_0 = 150.00 um (v_g = 1.667 um/min, T_c = 90 min); no-decay control forms 0 somites" ;
        schema:measurementTechnique "cell-autonomous fgf8 mRNA advection-decay PDE steady gradient (lambda_m=360.67 um, PDE L2 rel error=0.00093)" ;
        schema:name "chick PSM determination front distance from tailbud x* = (v_g/k_d)*ln(m_0/m_crit)" ;
        schema:unitText "um" ;
        schema:value "696.47" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-psm-determination-front-distance-from-tailbud-x-v-g-k-d-ln-m-0-m-crit-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-psm-determination-front-distance-from-tailbud-x-v-g-k-d-ln-m-0-m-crit-reference> a schema:PropertyValue ;
        dct:source "Dubrulle & Pourquie (2004) Nature 427:419-422 & Dubrulle et al. (2001) Cell 106:219-232 (~70% of 1000 um chick PSM from posterior tailbud)" ;
        schema:value "696.46" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chick/vertebrate embryo SEM specimen bilateral somite spacing S_obs = 48.4667 px" ;
        dct:description "bilateral symmetry ratio = 0.9606, std = 9.70 px, phase correlation r = 0.5629" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on chick_somite_psm_specimen.jpg (upper=8 somites, lower=9 somites, CV=0.2002)" ;
        schema:name "chick/vertebrate embryo SEM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "48.4667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 avian/vertebrate embryo SEM specimen (datasets/fgf8_wavefront_somitogenesis/chick_somite_psm_specimen.jpg)" ;
        schema:value "48.47" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-dubrulle-et-al-2001-2004-5-regime-somite-length-prediction-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dubrulle et al. (2001, 2004) 5-regime somite length prediction Pearson correlation r = 1.0 Pearson r" ;
        dct:description "p = 1.05e-07, RMSE = 1.072 um across [84, 214] um somite range" ;
        schema:measurementTechnique "correlation across 5 FGF8 perturbation regimes (control, FGF8 bead anterior, FGF8 bead posterior, SU5402, pCAGGS-FGF8 electroporation; RMSE=1.072 um)" ;
        schema:name "Dubrulle et al. (2001, 2004) 5-regime somite length prediction Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-dubrulle-et-al-2001-2004-5-regime-somite-length-prediction-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-dubrulle-et-al-2001-2004-5-regime-somite-length-prediction-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Dubrulle et al. (2001) Cell 106:219-232 & Dubrulle & Pourquie (2004) Nature 427:419-422" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ectopic-fgf8-bead-anterior-compressed-somite-length-s-ant> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ectopic FGF8 bead anterior compressed somite length S_ant = 97.5 um" ;
        dct:description "compensatory posterior catch-up somite S_post = 202.50 um (two-somite sum S_ant + S_post = 300.0 um = 2*S_0)" ;
        schema:measurementTechnique "FGF8 bead local determination front anterior retardation (+52.5 um shift at somite level n=5)" ;
        schema:name "ectopic FGF8 bead anterior compressed somite length S_ant" ;
        schema:unitText "um" ;
        schema:value "97.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ectopic-fgf8-bead-anterior-compressed-somite-length-s-ant-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-ectopic-fgf8-bead-anterior-compressed-somite-length-s-ant-reference> a schema:PropertyValue ;
        dct:source "Dubrulle, McGrew & Pourquie (2001) Cell 106:219-232 Figs. 1-3 (35% compressed anterior somite adjacent to FGF8 bead)" ;
        schema:value "98.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-su5402-pharmacological-fgfr1-inhibition-enlarged-somite-length-s-su5402> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "SU5402 pharmacological FGFR1 inhibition enlarged somite length S_SU5402 = 215.0 um" ;
        dct:description "predicted S_SU5402 = 215.0 um vs observed 214.0 +/- 10.0 um" ;
        schema:measurementTechnique "SU5402 FGFR1 inhibition posterior shift of determination front (-65.0 um shift -> enlarged somites)" ;
        schema:name "SU5402 pharmacological FGFR1 inhibition enlarged somite length S_SU5402" ;
        schema:unitText "um" ;
        schema:value "215.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-su5402-pharmacological-fgfr1-inhibition-enlarged-somite-length-s-su5402-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-measurement-su5402-pharmacological-fgfr1-inhibition-enlarged-somite-length-s-su5402-reference> a schema:PropertyValue ;
        dct:source "Dubrulle, McGrew & Pourquie (2001) Cell 106:219-232 Fig. 2 (SU5402 treatment induces ~43% larger somites)" ;
        schema:value "214.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


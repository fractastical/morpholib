            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.ydbio.2006.01.018>,
            <https://doi.org/10.1038/nature02332> .
    <https://doi.org/10.1002/dvdy.21193> dct:date "2007"^^xsd:gYear ;
        dct:title "Sharp developmental thresholds defined through bistability by antagonistic gradients of retinoic acid and FGF signaling" .
    <https://doi.org/10.1016/S0092-8674(01)00437-8> dct:date "2001"^^xsd:gYear ;
        dct:title "FGF signaling controls somite boundary position and regulates segmentation clock control of spatiotemporal Hox gene activation" .
    <https://doi.org/10.1016/j.ydbio.2006.01.018> dct:date "2006"^^xsd:gYear ;
        dct:title "A clock and wavefront mechanism for somite formation" .
    <https://doi.org/10.1038/nature02332> dct:date "2004"^^xsd:gYear ;
        dct:title "fgf8 mRNA decay establishes a gradient that couples axial elongation to patterning in the vertebrate embryo" .
}


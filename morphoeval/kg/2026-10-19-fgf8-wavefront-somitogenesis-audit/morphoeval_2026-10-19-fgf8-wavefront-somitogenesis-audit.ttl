<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/dubrulle-fgf8-wavefront-somitogenesis-1>,
        <https://w3id.org/probknow/resource/math-law/dubrulle-fgf8-wavefront-somitogenesis-2>,
        <https://w3id.org/probknow/resource/math-law/dubrulle-fgf8-wavefront-somitogenesis-3> .

<https://w3id.org/probknow/resource/math-law/dubrulle-fgf8-wavefront-somitogenesis-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Dubrulle & Pourquie (2004) Cell-Autonomous fgf8 mRNA Advection-Decay PDE" ;
    dct:description "Converts temporal intracellular fgf8 mRNA decay in tailbud-derived cells into a steady spatial exponential gradient along the presomitic mesoderm | Variables: m(x,t): intracellular fgf8 mRNA concentration; v_g: posterior tailbud axis elongation velocity (um/min); k_d: fgf8 mRNA decay rate constant (min^-1)" ;
    dct:source "Dubrulle & Pourquie (2004) Nature 427(6973):419-422 Figs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L95-L135>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_024_fgf8_wavefront_somitogenesis.lean#L24-L43> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def fgf8_advection_decay_residual (v_g dm_dx k_d m : Int) : Int :=
  v_g * dm_dx + k_d * m
theorem dubrulle_2004_advection_decay_characteristic_balance (v_g k_d c : Int) :
    fgf8_advection_decay_residual v_g (-(k_d * c)) k_d (v_g * c) = 0"""^^pk:lean4 ;
    skos:notation "dm/dt + v_g * dm/dx = -k_d * m  =>  m(x) = m_0 * exp(-k_d * x / v_g)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/j.ydbio.2006.01.018>,
        <https://doi.org/10.1038/nature02332> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Advection-Reaction mRNA Decay Wavefront & Threshold Phase-Gating (Somitogenesis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_024.fgf8_advection_decay_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_024.dubrulle_2004_advection_decay_characteristic_balance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/dubrulle-fgf8-wavefront-somitogenesis-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Dubrulle et al. (2001, 2004) Determination Front Threshold Positioning Law" ;
    dct:description "Positions the PSM determination front (somite level -IV/-III boundary) where decaying FGF8 falls below m_crit to unlock Mesp2/cMeso-1 activation | Variables: x_star: distance from posterior tailbud to determination front (um); m_0: tailbud fgf8 mRNA level; m_crit: permissive FGF threshold for segmentation competence" ;
    dct:source "Dubrulle, McGrew & Pourquie (2001) Cell 106(2):219-232 Figs. 2-4; Dubrulle & Pourquie (2004) Nature 427:419-422" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L138-L165>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_024_fgf8_wavefront_somitogenesis.lean#L45-L66> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def determination_front_position (lambda_m L_log : Nat) : Nat :=
  lambda_m * L_log
theorem dubrulle_2001_determination_front_scaling (k lambda_m L_log delta_L : Nat) :
    determination_front_position (k * lambda_m) L_log =
      k * determination_front_position lambda_m L_log ∧
    determination_front_position lambda_m (L_log + delta_L) =
      determination_front_position lambda_m L_log + lambda_m * delta_L"""^^pk:lean4 ;
    skos:notation "x_star = (v_g / k_d) * ln(m_0 / m_crit)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/j.ydbio.2006.01.018>,
        <https://doi.org/10.1038/nature02332> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Advection-Reaction mRNA Decay Wavefront & Threshold Phase-Gating (Somitogenesis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_024.determination_front_position" ;
    pk:leanTheorem "MathOfBiology.Loop_024.dubrulle_2001_determination_front_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/dubrulle-fgf8-wavefront-somitogenesis-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Dubrulle et al. (2001) Ectopic FGF8 Bead & SU5402 Somite Size Perturbation Law" ;
    dct:description "Explains why an ectopic FGF8 bead grafted into the PSM produces compressed small somites anterior to the bead followed by an enlarged catch-up somite posterior to the bead while SU5402 produces enlarged somites | Variables: S_n: anteroposterior length of somite n (um); T_c: segmentation clock period (min); delta_x: transient anterior displacement of determination front by ectopic FGF8 bead (um)" ;
    dct:source "Dubrulle, McGrew & Pourquie (2001) Cell 106(2):219-232 Figs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py#L168-L295>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_024_fgf8_wavefront_somitogenesis.lean#L68-L87> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def perturbed_somite_length (v_g T_c delta_x : Int) : Int :=
  v_g * T_c - delta_x
theorem dubrulle_2001_fgf8_bead_somite_pair_conservation (v_g T_c delta_x : Int) :
    perturbed_somite_length v_g T_c delta_x +
      perturbed_somite_length v_g T_c (-delta_x) = 2 * (v_g * T_c)"""^^pk:lean4 ;
    skos:notation "S_n = v_g * T_c - Delta_x_star_n;  S_ant + S_post = (v_g * T_c - delta_x) + (v_g * T_c + delta_x) = 2 * v_g * T_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/j.ydbio.2006.01.018>,
        <https://doi.org/10.1038/nature02332> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Advection-Reaction mRNA Decay Wavefront & Threshold Phase-Gating (Somitogenesis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_024.perturbed_somite_length" ;
    pk:leanTheorem "MathOfBiology.Loop_024.dubrulle_2001_fgf8_bead_somite_pair_conservation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,

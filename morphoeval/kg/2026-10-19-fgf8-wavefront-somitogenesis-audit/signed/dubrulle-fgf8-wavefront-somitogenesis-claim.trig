sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-dubrulle-fgf8-wavefront-somitogenesis> a pk:Claim ;
        rdfs:label "Dubrulle & Pourquié (2001, 2004) FGF8 mRNA decay wavefront and determination front positioning in vertebrate somitogenesis faithfully reproduces Gallus gallus (chick embryo presomitic mesoderm & paraxial somites) morphology" ;
        dcterms:description "The simulation script(s) 2003-dubrulle-fgf8-wavefront-somitogenesis.py implement the cited source model as published and produce forms that match real Gallus gallus (chick embryo presomitic mesoderm & paraxial somites) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 59.0/100, audit 2026-10-19-fgf8-wavefront-somitogenesis-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py; output: docs/media/fgf8_wavefront_somitogenesis_comparison.png; organism: Gallus gallus (chick embryo presomitic mesoderm & paraxial somites); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 5358f6fac89be6e91719f6dec1d96fe25095ac5d5f268b2b982c2f173b109336; artifact_sha256: 56ac2304ddaf5a5712326eb19bafbe9c34cd7bc819580c44dcae1df7d5088234; input_dataset_sha256: {datasets/fgf8_wavefront_somitogenesis/chick_somite_psm_specimen.jpg=8b80971796cb29e2..., datasets/fgf8_wavefront_somitogenesis/fgf8_wavefront_somitogenesis_reference.json=93e00c49c65550f9..., datasets/fgf8_wavefront_somitogenesis/scout_manifest.json=a38a686592f1ffd0...}" ;
        pk:derivedFromPaper <https://doi.org/10.1002/dvdy.21193>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.ydbio.2006.01.018>,
            <https://doi.org/10.1038/nature02332> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-dubrulle-fgf8-wavefront-somitogenesis-specimen-match> ;
        pk:weightOfEvidence "0.59"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/317bc3c/2003-dubrulle-fgf8-wavefront-somitogenesis.py> a schema:SoftwareSourceCode ;
        rdfs:label "2003-dubrulle-fgf8-wavefront-somitogenesis.py" ;

    <https://doi.org/10.1002/dvdy.21193> dct:date "2007"^^xsd:gYear ;
        dct:title "Sharp developmental thresholds defined through bistability by antagonistic gradients of retinoic acid and FGF signaling" .
    <https://doi.org/10.1016/S0092-8674(01)00437-8> dct:date "2001"^^xsd:gYear ;
        dct:title "FGF signaling controls somite boundary position and regulates segmentation clock control of spatiotemporal Hox gene activation" .
    <https://doi.org/10.1016/j.ydbio.2006.01.018> dct:date "2006"^^xsd:gYear ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at the 10.32 nm Chlamydomonas eyespot pigment stripe (Pass 2) — Morphological realism / specimen match: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Side by side, the modulated frame keeps the SEM's cells, flagella, and footer. CV similarity is 96.0 (orientation 0.965, radial FFT 1.000, coherency 0.914) on 12 frames at 1024 px. The 10 nm spot lattice is a separate panel because the micrograph cannot resolve it. That is why this is 80 rather than a near-copy score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/chlamydomonas_reinhardtii_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "SEM, modulated cells, mask, activator spots, dispersion curve — docs/media/chlamydomonas_reinhardtii_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 530265 B, 1512×1008 px, artifact_sha256 79b760e1b14cd10d4b6c6c87a239cc85a30b9290dd19deab4135c79cdc7c36fd (sha256 79b760e1b14cd10d4b6c6c87a239cc85a30b9290dd19deab4135c79cdc7c36fd), spec_fingerprint c41079d08516e24418edacb13a3820b8f31bff46de38d0a93c0cb0ebc5f205ac" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chlamydomonas-reinhardtii-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at the 10.32 nm Chlamydomonas eyespot pigment stripe (Pass 2) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Schnakenberg kinetics, the Jacobian, onset k_c, and argmax sigma(k) match the cited formulas. Dv=Du gives sigma_max=-0.089 (no stripe). Dropping u^2 v gives sigma_max=-1.00. The 10 nm continuum step is still a transfer, so this is not a perfect fidelity score." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

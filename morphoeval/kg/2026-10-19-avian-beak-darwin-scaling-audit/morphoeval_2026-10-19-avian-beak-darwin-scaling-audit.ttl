    pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L34–L53: Brief docstrings without explicit paper equation/figure or Lean 4 theorem cross-references <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L34-L53>" ;
    pk:hasScore 6.8e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Model fidelity to source: 58/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements canonical power-law culmen profile y_0(x_0) and pure scaling (s_L, s_D) for Group A Geospiza species (L34-53), backed by 3 Lean 4 theorems in `Loop_070_avian_beak_darwin_scaling.lean`. However, it omits the shear matrix [[1, gamma], [0, 1]] required for Groups B and C, lacks the 2D/3D Bmp4/Calmodulin mesenchymal growth field and cantilever bending mechanics I_beam = W*D^3/(12*L), and lacks the pure-scaling negative control on Certhidea and Camarhynchus." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L56–L97: Omits shear gamma transformation across Groups B & C and Bmp4/Calmodulin mesenchymal field <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L56-L97>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-1> ;
    pk:hasScore 5.8e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Morphometric validation: 56/100" ;

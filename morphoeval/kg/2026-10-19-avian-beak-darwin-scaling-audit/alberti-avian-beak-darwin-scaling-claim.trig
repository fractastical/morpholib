sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> a pk:Claim ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis faithfully reproduces Darwin's finches (Geospiza magnirostris, Geospiza fortis, Geospiza scandens, Camarhynchus parvulus, Certhidea olivacea) morphology" ;
        dct:description "The simulation script(s) 2021-alberti-avian-beak-darwin-scaling.py implement the cited source model as published and produce forms that match real Darwin's finches (Geospiza magnirostris, Geospiza fortis, Geospiza scandens, Camarhynchus parvulus, Certhidea olivacea) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.8/100, audit 2026-10-19-avian-beak-darwin-scaling-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py; output: docs/media/avian_beak_darwin_scaling_comparison.png; organism: Darwin's finches (Geospiza magnirostris, Geospiza fortis, Geospiza scandens, Camarhynchus parvulus, Certhidea olivacea); checkpoint commit: https://github.com/fractastical/morpholib/commit/33e07ad; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: c3ac286b6e1240143c8b941b9ff61a0744669a4b95cb14db7918d73b5259a735; artifact_sha256: 777aca548970785f1b2714e16a896382627d991abc3020061ca0d810886d63ee; input_dataset_sha256: {datasets/avian_beak_darwin_scaling/avian_beak_darwin_scaling_reference.json=cf6430de0c52d725..., datasets/avian_beak_darwin_scaling/darwin_finches_specimen.jpg=5ea7ada14a01ba77..., datasets/avian_beak_darwin_scaling/paper_citations.bib=f0b9fb929ffd2d09..., datasets/avian_beak_darwin_scaling/scout_manifest.json=4b321120fd7b2736...}" ;
        pk:derivedFromPaper <https://doi.org/10.1038/nature04843>,
            <https://doi.org/10.1073/pnas.0911575107>,
            <https://doi.org/10.1098/rsif.2014.0284>,
            <https://doi.org/10.1126/science.1098095> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match> ;
        pk:weightOfEvidence "0.548"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py> a schema:SoftwareSourceCode ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;

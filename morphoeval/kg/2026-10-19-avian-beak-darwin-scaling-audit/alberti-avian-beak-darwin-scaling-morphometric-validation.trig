sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Morphometric validation: 56/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L169-198) reports Group A pure scaling RMS and Geospiza D/L correlation, but does not measure the 14-species affine scaling-and-shear collapse RMS vs pure-scaling negative control RMS, Bmp4/CaM perturbation ratios, cantilever bite-force scaling, or computer-vision culmen contour metrics from the specimen plate." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L169–L198: Only 3 Group A metrics returned in measure_morphoeval() without 14-species shear collapse or specimen CV metrics <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L169-L198>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-geospiza-beak-aspect-ratio-d-l-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-geospiza-magnirostris-vs-geospiza-fuliginosa-depth-scaling-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-group-a-geospiza-pure-scaling-collapse-rms-residual> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-geospiza-beak-aspect-ratio-d-l-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Geospiza beak aspect ratio D/L correlation = 0.9998 Pearson r" ;
        dct:description "p=4.91e-08" ;
        schema:measurementTechnique "Pearson correlation between scaling ratio s_D/s_L and observed D/L across 6 Geospiza species (p=4.91e-08)" ;
        schema:name "Geospiza beak aspect ratio D/L correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9998" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-geospiza-beak-aspect-ratio-d-l-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-geospiza-beak-aspect-ratio-d-l-correlation-reference> a schema:PropertyValue ;
        dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Table S1" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-geospiza-magnirostris-vs-geospiza-fuliginosa-depth-scaling-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Geospiza magnirostris vs Geospiza fuliginosa depth scaling ratio = 2.21 ratio s_D" ;
        dct:description "s_D ratio vs observed D ratio" ;
        schema:measurementTechnique "Depth scale factor ratio between G. magnirostris and G. fuliginosa baseline" ;
        schema:name "Geospiza magnirostris vs Geospiza fuliginosa depth scaling ratio" ;
        schema:unitText "ratio s_D" ;
        schema:value "2.21" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-geospiza-magnirostris-vs-geospiza-fuliginosa-depth-scaling-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-geospiza-magnirostris-vs-geospiza-fuliginosa-depth-scaling-ratio-reference> a schema:PropertyValue ;
        dct:source "Abzhanov et al. (2004) Science 305:1462-1465 & Campas et al. (2010) PNAS" ;
        schema:value "2.2105" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-group-a-geospiza-pure-scaling-collapse-rms-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Group A Geospiza pure scaling collapse RMS residual = 0.004 dimensionless RMS" ;
        dct:description "n=6 Geospiza species, r_DL=0.9998 (p=4.91e-08)" ;
        schema:measurementTechnique "RMS residual across 6 Geospiza species after pure scaling (s_L, s_D)" ;
        schema:name "Group A Geospiza pure scaling collapse RMS residual" ;
        schema:unitText "dimensionless RMS" ;
        schema:value "0.004" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-group-a-geospiza-pure-scaling-collapse-rms-residual-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-group-a-geospiza-pure-scaling-collapse-rms-residual-reference> a schema:PropertyValue ;
        dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Fig. 2" ;
        schema:value "0.008" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 070 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


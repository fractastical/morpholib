sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements canonical power-law culmen profile y_0(x_0) and pure scaling (s_L, s_D) for Group A Geospiza species (L34-53), backed by 3 Lean 4 theorems in `Loop_070_avian_beak_darwin_scaling.lean`. However, it omits the shear matrix [[1, gamma], [0, 1]] required for Groups B and C, lacks the 2D/3D Bmp4/Calmodulin mesenchymal growth field and cantilever bending mechanics I_beam = W*D^3/(12*L), and lacks the pure-scaling negative control on Certhidea and Camarhynchus." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L56–L97: Omits shear gamma transformation across Groups B & C and Bmp4/Calmodulin mesenchymal field <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L56-L97>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L34–L53" ;
        dcterms:description "Canonical culmen curve and pure scaling (s_L, s_D) for Group A Geospiza" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L34-L53> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 070 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


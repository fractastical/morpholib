sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Morphological realism / specimen match: 36/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/avian_beak_darwin_scaling/darwin_finches_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or extracts culmen contours from the 4 Gould (1845) finch heads, and evaluates only 6 of the 14 Darwin's finch species." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L56–L97: Evaluates only 6 Group A Geospiza species without loading darwin_finches_specimen.jpg <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L56-L97>",
            "docs/media/avian_beak_darwin_scaling_comparison.png (generated output, not in repo): 4-panel v1 plot lacks Gould specimen contour extraction and 14-species shear collapse — docs/media/avian_beak_darwin_scaling_comparison.png: rendered output of 2021-alberti-avian-beak-darwin-scaling.py at 33e07ad, image/png, 197687 B, 1560×1105 px, artifact_sha256 777aca548970785f1b2714e16a896382627d991abc3020061ca0d810886d63ee (sha256 777aca548970785f1b2714e16a896382627d991abc3020061ca0d810886d63ee), spec_fingerprint c3ac286b6e1240143c8b941b9ff61a0744669a4b95cb14db7918d73b5259a735" ;
        pk:hasScore "0.36"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 070 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


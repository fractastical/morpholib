sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Reproducibility package: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2014`), standalone `--self-test` suite verifying SHA-256 dataset integrity, exact normalized phase collapse (<1e-12 rad), bitwise two-run kymograph determinism (`atol=0.0`), telescoping radius conservation, DAPT Notch-inhibition ablation control (0 segments), and specimen segmentation (`run_self_test`, L805-855), plus rendered PNG and GIF outputs in `docs/media/`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L805–L855" ;
        dct:description "Deterministic --self-test suite verifying SHA-256 digests, phase collapse, bitwise determinism, and morphometrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py#L805-L855> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/ex_vivo_scaling_mPSM_growth.gif (generated output)" ;
        dct:description "24-frame animated GIF showing 2D concentric LuVeLu target waves and live linear segment scaling — docs/media/ex_vivo_scaling_mPSM_growth.gif: rendered output of 2014-lauschke-ex-vivo-scaling-mPSM.py at 317bc3c, image/gif, 1795304 B, 1050×480 px, 24 frames, artifact_sha256 cbb3b9921ac4353c5e160a578b60c7fa2e5a2eb597a21084d13c282b02553ade (sha256 cbb3b9921ac4353c5e160a578b60c7fa2e5a2eb597a21084d13c282b02553ade), spec_fingerprint 0664f71d3f534bae2179e8241d0641469c79bbe4d267f1da6ae7e8f684b90e69" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


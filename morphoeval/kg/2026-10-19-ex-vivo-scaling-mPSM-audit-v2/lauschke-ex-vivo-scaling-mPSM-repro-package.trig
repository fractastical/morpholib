    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2016.01.028>,
            <https://doi.org/10.1038/nature11804>,
            <https://doi.org/10.1038/ncb1679>,
            <https://doi.org/10.1088/1478-3975/13/3/036009> .
    <https://doi.org/10.1016/j.cell.2016.01.028> dct:date "2016"^^xsd:gYear ;
        dct:title "Self-organization of embryonic genetic oscillators into spatiotemporal wave patterns" .
    <https://doi.org/10.1038/nature11804> dct:date "2013"^^xsd:gYear ;
        dct:title "Scaling of embryonic patterning based on phase-gradient encoding" .
    <https://doi.org/10.1038/ncb1679> dct:date "2008"^^xsd:gYear ;
        dct:title "A beta-catenin gradient links the clock and wavefront systems in mouse embryo segmentation" .
    <https://doi.org/10.1088/1478-3975/13/3/036009> dct:date "2016"^^xsd:gYear ;
        dct:title "Positional information from oscillatory phase shifts: insights from in silico evolution" .
}


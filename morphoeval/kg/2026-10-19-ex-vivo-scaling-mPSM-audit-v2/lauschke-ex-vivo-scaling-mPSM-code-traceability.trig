sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Code-to-model traceability: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational section and docstring maps directly to numbered figures in Lauschke et al. (2013) Nature Figs. 1-4 and the 3 Lean 4 theorems in `Loop_026_ex_vivo_scaling_mPSM.lean` and `morphoeval/math_kg_loops/lauschke-ex-vivo-scaling-mPSM.yaml`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-code-traceability-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L1–L55" ;
        dct:description "Module docstring linking equations to Lauschke et al. (2013) and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py#L1-L55> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/lauschke-ex-vivo-scaling-mPSM.yaml L1–L88" ;
        dct:description "Math KG loop specification linking equations, Lean 4 declarations, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/lauschke-ex-vivo-scaling-mPSM.yaml#L1-L88> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


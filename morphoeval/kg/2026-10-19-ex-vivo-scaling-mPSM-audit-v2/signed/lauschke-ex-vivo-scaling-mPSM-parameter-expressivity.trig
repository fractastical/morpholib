sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L330–L405" ;
        dcterms:description "4-explant scaling series evaluator across R_0 in {150, 250, 350, 450} um" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py#L330-L405> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L178–L245" ;
        dcterms:description "Comparison across scaling phase-gradient, constant-velocity non-scaling, and DAPT Notch-inhibition modes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py#L178-L245> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates all 4 explant sizes R_0 in {150, 250, 350, 450} um from Lauschke et al. (2013) across 8 oscillation cycles (32 segment budding events), compares scale-invariant phase-gradient encoding against both a constant-velocity non-scaling wavefront model and a DAPT Notch-inhibition ablation control (0 segments, Panels A, C, D), and exposes CLI flags (`--R0`, `--alpha`, `--T-osc`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

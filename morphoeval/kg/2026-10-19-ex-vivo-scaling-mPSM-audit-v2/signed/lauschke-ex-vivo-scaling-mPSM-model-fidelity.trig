sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Lauschke et al.'s (2013) scale-invariant phase-gradient encoding phi(r,t) = omega_0*t - Phi_0*(r/R(t))^p, proportional segment scaling S_n = alpha*R(t_n) (alpha = 0.11), geometric radius contraction R_{n+1} = (1-alpha)*R_n, and radial wave velocity scaling v_wave(t) = (2*pi/Phi_0)*(R(t)/T_osc) (L105-405), achieving exact universal phase collapse (9.93e-16 rad std) and exact telescoping radius conservation, verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L105–L175" ;
        dcterms:description "Universal normalized phase-gradient profile and 4-explant collapse verifier" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py#L105-L175> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L178–L325" ;
        dcterms:description "Proportional segment scaling, geometric radius contraction, and 2D circular mPSM target-wave kymograph" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2014-lauschke-ex-vivo-scaling-mPSM.py#L178-L325> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean L22–L86" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for proportional segment scaling, geometric radius conservation, and wave velocity scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_026_ex_vivo_scaling_mPSM.lean#L22-L86> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


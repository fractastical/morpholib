    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Morphological realism / specimen match: 88/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 4.0 dorsal vertebrate embryo somite/PSM SEM (`datasets/ex_vivo_scaling_mPSM/mouse_mpsm_somites_specimen.jpg`) and segments both bilateral paraxial somite rows (`segment_mouse_mpsm_somites_specimen`, L410-480), extracting 8 upper and 8 lower somites, bilateral mean spacing 47.14 px (CV = 0.2010), symmetry ratio 0.9969, and phase-aligned periodic waveform correlation (Panels E-F)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;

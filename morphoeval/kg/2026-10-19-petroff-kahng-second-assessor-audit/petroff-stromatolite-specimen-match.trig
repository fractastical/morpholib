sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-petroff-stromatolite-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Morphological realism / specimen match: 22/100" ;
        rdfs:comment "No specimen photograph, thin-section, or Petroff figure is rendered or overlaid anywhere. The 'DOME' at beta = 0.3 (panel d, GIF frame 0) is a flat-topped trapezoid with vertical walls and a residual central kink inherited from the triangular seed (L152); it does not resemble a domal stromatolite. The 'CONE' and 'SHARP CONE' (panels e, f) are parabolic bullets sitting on a fixed-width cylinder because the feet are pinned at +-1 (L136-137), with a rounded apex rather than straight-flanked Conophyton cones. Partial credit for axial crest lamina thickening at large beta and visual distinction across the three regimes. Evidence: petroff_stromatolite_morphospace.png (generated output, not in repo): panel (d) dome is a vertical-walled trapezoid with central crease; panels (e-f) sit on pinned cylinder bases — petroff_stromatolite_morphospace.png: rendered output of 2010-petroff-stromatolite.py at 5564750, image/png, 328721 B, 1736×1244 px, artifact_sha256 8e00cc6fabe5cf24f1544cbc867b0f6e9501cf7099a7b3da7166a2bf8fd1be01 (sha256 8e00cc6fabe5cf24f1544cbc867b0f6e9501cf7099a7b3da7166a2bf8fd1be01), spec_fingerprint 2b3289aae8f3466486ffbc5f503dd7585e6e1c2863ac78c108d1488932cf713f; docs/media/petroff_stromatolite_dome_to_cone.gif (generated output, not in repo): 70-frame animation across beta = 0.2 -> 6.0 — docs/media/petroff_stromatolite_dome_to_cone.gif: rendered output of 2010-petroff-stromatolite.py at 5564750, image/gif, 920055 B, 560×416 px, 70 frames, artifact_sha256 b7f825720b31f42faa4f7424f916639a76f36dfd50a2025cb0706b4d9ea55514 (sha256 b7f825720b31f42faa4f7424f916639a76f36dfd50a2025cb0706b4d9ea55514), spec_fingerprint 2b3289aae8f3466486ffbc5f503dd7585e6e1c2863ac78c108d1488932cf713f; 2010-petroff-stromatolite.py L136–L154: pinned basal endpoints x[0]=-base_half, x[-1]=base_half and triangular seed <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L136-L154>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-specimen-match> ;
        pk:hasProbability "0.22"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-specimen-match> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dct:identifier "morphoeval/0.1.0/specimen-match" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


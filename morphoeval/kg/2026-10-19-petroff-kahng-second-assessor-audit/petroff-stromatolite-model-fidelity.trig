sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-model-fidelity-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-model-fidelity-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Model fidelity to source: 30/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Spacing law diffusion_length (L64-67) is the correct form, but alpha and tau are free knobs set by the script (alpha_field = 1.0 at L179, alpha_lab = 0.30 at L180 described as a least-squares fit with no data or fit in the file), and the text panel states that 0.66 cm records a ~20 h rhythmic metabolism (L238-239) whereas 0.66 cm was computed at tau = 12 h (L193, L207; tau = 20 h gives 0.85 cm). Panels (d-f) and the GIF do not implement Petroff's diffusion-limited growth: they credit Batchelor et al. 2004 (L31-34, L86-98), modify it with an unsourced quadratic crest weight w_photic = 0.12 + 0.88*(z/z_max)^2 (L126-130) and 3-point smoothing (L141-142), and never integrate the docstring's own KPZ equation dh/dt = v + lambda*(1 + 1/2 (dh/dr)^2) (L34, L85, L296)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-3> ;
        pk:hasScore "0.3"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L64–L67" ;
        dct:description "diffusion_length ell = alpha*sqrt(D*tau)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L64-L67> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L126–L142" ;
        dct:description "ad-hoc w_photic = 0.12 + 0.88*(z/z_max)^2, pinned basal feet, and 3-point Laplacian smoothing" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L126-L142> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L193–L240" ;
        dct:description "computes ell = 0.66 cm at tau = 12 h while text panel claims ~20 h rhythmic metabolism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L193-L240> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolite lamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-parameter-expressivity-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-parameter-expressivity-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Parameter expressivity: 55/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "beta monotonically controls height/width (0.63 to 3.03 across beta = 0.2 to 6.0 in the GIF sweep at L300-334 and regimes at L249-253), and tau monotonically controls ell (L187-192). However, apex sharpness and flank slope are constrained by the pinned footprint (L136-137) and smooth (L141-142, L146); lambda is fixed at 1 throughout (L248, L305); and seed_height, base_half, smooth, and t_total (L146-147) are hidden parameters with no CLI exposure." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-parameter-expressivity-3> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L187–L192" ;
        dct:description "tau sweep 1..48 h for alpha_field and alpha_lab" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L187-L192> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L249–L253" ;
        dct:description "three beta regimes (0.3, 1.5, 5.0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L249-L253> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L300–L334" ;
        dct:description "36-step geomspace sweep of beta in make_gif" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L300-L334> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolite lamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


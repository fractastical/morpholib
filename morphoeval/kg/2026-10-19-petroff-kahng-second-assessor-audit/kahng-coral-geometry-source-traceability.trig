        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-kahng-coral-geometry-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Source and data traceability: 68/100" ;
        rdfs:comment "DOI (10.7717/peerj.17037), PMC ID (PMC10909345), journal, and the authors' GitHub repository are all given in the header (L5-9). However, the empirical parameter sources ('Lough 2008', 'Hughes 1987', 'Kahng 2023' at L57-59) are cited by author-year only without DOIs, table numbers, or page numbers, and no dataset files or SHA-256 digests are present. Evidence: 2024-kahng-coral-geometry.py L5–L9: PeerJ DOI, PMCID, and GitHub repository URL <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L5-L9>; 2024-kahng-coral-geometry.py L57–L60: short author-year parameter citations without DOIs or table numbers <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L57-L60>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-source-traceability> ;
        pk:hasProbability "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-source-traceability> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dct:identifier "morphoeval/0.1.0/source-traceability" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


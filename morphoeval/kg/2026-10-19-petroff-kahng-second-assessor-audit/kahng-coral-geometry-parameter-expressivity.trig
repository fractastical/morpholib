        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-kahng-coral-geometry-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Parameter expressivity: 68/100" ;
        rdfs:comment "Cone aspect ratio alpha monotonically raises cone SAP (panel d, L189-196), branch diameter and plate thickness monotonically lower SAP (panel e, L199-211), and colony size monotonically lowers hemisphere/cone SAP (panel b). However, applying the COMMON parameter set (G=1.50, rho=1.20, L60) to a 0.5 cm disc gives SAP = 2.5 yr^-1 and extension 26 cm/yr at r = 30 cm (panel c), which dominates the vertical axis and compresses the hemisphere and cone curves; panel (e) conflates branch diameter and plate thickness on a single x-axis (L201-207); and step size dt is not exposed. Evidence: 2024-kahng-coral-geometry.py L60–L60: COMMON = dict(G=1.50, rho=1.20) <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L60-L60>; 2024-kahng-coral-geometry.py L172–L211: panels (c), (d), and (e) parameter sweeps <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L172-L211>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-parameter-expressivity> ;
        pk:hasProbability "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-parameter-expressivity> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dct:identifier "morphoeval/0.1.0/parameter-expressivity" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kahng-coral-geometry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-parameter-expressivity-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-parameter-expressivity-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Parameter expressivity: 68/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Cone aspect ratio alpha monotonically raises cone SAP (panel d, L189-196), branch diameter and plate thickness monotonically lower SAP (panel e, L199-211), and colony size monotonically lowers hemisphere/cone SAP (panel b). However, applying the COMMON parameter set (G=1.50, rho=1.20, L60) to a 0.5 cm disc gives SAP = 2.5 yr^-1 and extension 26 cm/yr at r = 30 cm (panel c), which dominates the vertical axis and compresses the hemisphere and cone curves; panel (e) conflates branch diameter and plate thickness on a single x-axis (L201-207); and step size dt is not exposed." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-parameter-expressivity-2> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L60–L60" ;
        dct:description "COMMON = dict(G=1.50, rho=1.20)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L60-L60> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L172–L211" ;
        dct:description "panels (c), (d), and (e) parameter sweeps" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L172-L211> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


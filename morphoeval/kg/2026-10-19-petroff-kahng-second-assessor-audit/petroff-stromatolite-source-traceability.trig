sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-source-traceability-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-source-traceability-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Source and data traceability: 45/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Paper cited with journal, volume, pages, and PMC ID (L5-8), but no DOI is given in the file. Batchelor et al. 2004 (L32) and Fejes Toth 1948 (L27) are cited by author/year only without title, venue, or DOI; 'Bakal Formation' and 'eddy diffusivity D_eff ~ Re*D' (L241-243) are asserted without reference; and 'alpha_lab = 0.30 least-squares fit' (L180) cites no data table." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-3> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L5–L8" ;
        dct:description "Petroff et al. 2010 citation lacking DOI" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L5-L8> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L27–L35" ;
        dct:description "author-year only mentions of Fejes Toth 1948 and Batchelor et al. 2004" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L27-L35> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L180–L243" ;
        dct:description "unreferenced alpha_lab = 0.30 fit and Bakal Formation note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L180-L243> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolite lamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


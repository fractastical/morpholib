            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-code-traceability-2> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L25–L31" ;

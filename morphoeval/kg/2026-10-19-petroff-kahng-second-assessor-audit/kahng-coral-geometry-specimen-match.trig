sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kahng-coral-geometry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-specimen-match-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-specimen-match-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Morphological realism / specimen match: 30/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Output consists of analytical line plots plus four schematic 2D matplotlib patches (_draw_glyphs at L116-147; Wedge and Polygon in the GIF at L294-296), with no coral colony photograph, 3D mesh, or measured colony outline. The glyphs are shape-distinct and labelled with V and S expressions (L135-140), though three rectangles (L128-130) are a schematic stand-in for branching Acropora." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-specimen-match-3> ;
        pk:hasScore "0.3"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "kahng_coral_geometry_morphospace.png (generated output)" ;
        dct:description "analytical curves + 4 schematic 2D glyphs; no specimen photo or empirical data points — kahng_coral_geometry_morphospace.png: rendered output of 2024-kahng-coral-geometry.py at 5564750, image/png, 282553 B, 1774×1267 px, artifact_sha256 fa8ce6cd95b493eee42054724462d8d7e6380dd161cc7899a464457cd765f812 (sha256 fa8ce6cd95b493eee42054724462d8d7e6380dd161cc7899a464457cd765f812), spec_fingerprint 833cc6f3d6f3988fa15a852dd8366b15c68ef56d6fd98635b3250ff241f4746a" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/kahng_coral_geometry_growth.gif (generated output)" ;
        dct:description "15-year growth animation of Wedge, Polygon, and log-area curves — docs/media/kahng_coral_geometry_growth.gif: rendered output of 2024-kahng-coral-geometry.py at 5564750, image/gif, 248080 B, 720×300 px, 16 frames, artifact_sha256 6d2629a5bb1c8f33c60c72f9efa435dd70cdefc0e7c5cbb050c7a50bb1ac50d0 (sha256 6d2629a5bb1c8f33c60c72f9efa435dd70cdefc0e7c5cbb050c7a50bb1ac50d0), spec_fingerprint 833cc6f3d6f3988fa15a852dd8366b15c68ef56d6fd98635b3250ff241f4746a" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L116–L147" ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-kahng-coral-geometry-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Reproducibility package: 64/100" ;
        rdfs:comment "Deterministic (no RNG), backed by requirements.lock.txt, with CLI flags at L320-331. However, --gif (L326) is omitted from the documented 'Run it' block (L38-41), show=True is the default (L327), GIF rendering via buffer_rgba (L312) is backend/font dependent, Pillow deduplicates the trailing hold frames (L314) from 24 to 16 frames on disk, and there is no self-test. Evidence: 2024-kahng-coral-geometry.py L38–L41: Run it block omits --gif <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L38-L41>; 2024-kahng-coral-geometry.py L312–L331: GIF frame deduplication and CLI entrypoint <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L312-L331>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-repro-package> ;
        pk:hasProbability "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-repro-package> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


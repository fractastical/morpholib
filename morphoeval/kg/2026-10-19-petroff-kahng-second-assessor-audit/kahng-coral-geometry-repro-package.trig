sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kahng-coral-geometry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-repro-package-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-repro-package-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Reproducibility package: 64/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic (no RNG), backed by requirements.lock.txt, with CLI flags at L320-331. However, --gif (L326) is omitted from the documented 'Run it' block (L38-41), show=True is the default (L327), GIF rendering via buffer_rgba (L312) is backend/font dependent, Pillow deduplicates the trailing hold frames (L314) from 24 to 16 frames on disk, and there is no self-test." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-2> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L38–L41" ;
        dct:description "Run it block omits --gif" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L38-L41> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L312–L331" ;
        dct:description "GIF frame deduplication and CLI entrypoint" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L312-L331> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


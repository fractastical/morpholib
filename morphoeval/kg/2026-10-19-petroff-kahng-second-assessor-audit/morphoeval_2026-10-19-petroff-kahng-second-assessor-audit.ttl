        <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-2> ;
    pk:hasScore 6.4e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-source-traceability-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;

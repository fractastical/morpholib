<https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-specimen-match-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
    rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Morphological realism / specimen match: 22/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "No specimen photograph, thin-section, or Petroff figure is rendered or overlaid anywhere. The 'DOME' at beta = 0.3 (panel d, GIF frame 0) is a flat-topped trapezoid with vertical walls and a residual central kink inherited from the triangular seed (L152); it does not resemble a domal stromatolite. The 'CONE' and 'SHARP CONE' (panels e, f) are parabolic bullets sitting on a fixed-width cylinder because the feet are pinned at +-1 (L136-137), with a rounded apex rather than straight-flanked Conophyton cones. Partial credit for axial crest lamina thickening at large beta and visual distinction across the three regimes." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-2>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-3> ;
    pk:hasScore 2.2e-01 ;
    pk:hasVerdict "unfaithful" .


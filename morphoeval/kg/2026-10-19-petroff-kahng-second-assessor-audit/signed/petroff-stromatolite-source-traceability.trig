sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-petroff-stromatolite-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Source and data traceability: 45/100" ;
        rdfs:comment "Paper cited with journal, volume, pages, and PMC ID (L5-8), but no DOI is given in the file. Batchelor et al. 2004 (L32) and Fejes Toth 1948 (L27) are cited by author/year only without title, venue, or DOI; 'Bakal Formation' and 'eddy diffusivity D_eff ~ Re*D' (L241-243) are asserted without reference; and 'alpha_lab = 0.30 least-squares fit' (L180) cites no data table. Evidence: 2010-petroff-stromatolite.py L5–L8: Petroff et al. 2010 citation lacking DOI <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L5-L8>; 2010-petroff-stromatolite.py L27–L35: author-year only mentions of Fejes Toth 1948 and Batchelor et al. 2004 <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L27-L35>; 2010-petroff-stromatolite.py L180–L243: unreferenced alpha_lab = 0.30 fit and Bakal Formation note <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L180-L243>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-source-traceability> ;
        pk:hasProbability "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-source-traceability> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


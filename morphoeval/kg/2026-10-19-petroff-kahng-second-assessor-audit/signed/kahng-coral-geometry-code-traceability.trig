sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-kahng-coral-geometry-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Code-to-model traceability: 58/100" ;
        rdfs:comment "Every function docstring states V, S, and the resulting formula (L68-110), and the module header table (L25-30) maps shapes to scaling predictions and cites Appendix A / Results (L66), Fig. 6 (L60, L156), and Fig. 3 (L187). Deduct points because no specific equation numbers from Appendix A are given and the annual forward-Euler discretization is not traced to a specific equation in the paper. Evidence: 2024-kahng-coral-geometry.py L25–L31: header summary table <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L25-L31>; 2024-kahng-coral-geometry.py L64–L110: Appendix A / Results reference and function docstrings <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L64-L110>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-code-traceability> ;
        pk:hasProbability "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-code-traceability> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-kahng-coral-geometry-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Morphological realism / specimen match: 30/100" ;
        rdfs:comment "Output consists of analytical line plots plus four schematic 2D matplotlib patches (_draw_glyphs at L116-147; Wedge and Polygon in the GIF at L294-296), with no coral colony photograph, 3D mesh, or measured colony outline. The glyphs are shape-distinct and labelled with V and S expressions (L135-140), though three rectangles (L128-130) are a schematic stand-in for branching Acropora. Evidence: kahng_coral_geometry_morphospace.png (generated output, not in repo): analytical curves + 4 schematic 2D glyphs; no specimen photo or empirical data points — kahng_coral_geometry_morphospace.png: rendered output of 2024-kahng-coral-geometry.py at 5564750, image/png, 282553 B, 1774×1267 px, artifact_sha256 fa8ce6cd95b493eee42054724462d8d7e6380dd161cc7899a464457cd765f812 (sha256 fa8ce6cd95b493eee42054724462d8d7e6380dd161cc7899a464457cd765f812), spec_fingerprint 833cc6f3d6f3988fa15a852dd8366b15c68ef56d6fd98635b3250ff241f4746a; docs/media/kahng_coral_geometry_growth.gif (generated output, not in repo): 15-year growth animation of Wedge, Polygon, and log-area curves — docs/media/kahng_coral_geometry_growth.gif: rendered output of 2024-kahng-coral-geometry.py at 5564750, image/gif, 248080 B, 720×300 px, 16 frames, artifact_sha256 6d2629a5bb1c8f33c60c72f9efa435dd70cdefc0e7c5cbb050c7a50bb1ac50d0 (sha256 6d2629a5bb1c8f33c60c72f9efa435dd70cdefc0e7c5cbb050c7a50bb1ac50d0), spec_fingerprint 833cc6f3d6f3988fa15a852dd8366b15c68ef56d6fd98635b3250ff241f4746a; 2024-kahng-coral-geometry.py L116–L147: _draw_glyphs schematic 2D shapes <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L116-L147>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-specimen-match> ;
        pk:hasProbability "0.3"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-specimen-match> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-petroff-stromatolite-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Parameter expressivity: 55/100" ;
        rdfs:comment "beta monotonically controls height/width (0.63 to 3.03 across beta = 0.2 to 6.0 in the GIF sweep at L300-334 and regimes at L249-253), and tau monotonically controls ell (L187-192). However, apex sharpness and flank slope are constrained by the pinned footprint (L136-137) and smooth (L141-142, L146); lambda is fixed at 1 throughout (L248, L305); and seed_height, base_half, smooth, and t_total (L146-147) are hidden parameters with no CLI exposure. Evidence: 2010-petroff-stromatolite.py L187–L192: tau sweep 1..48 h for alpha_field and alpha_lab <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L187-L192>; 2010-petroff-stromatolite.py L249–L253: three beta regimes (0.3, 1.5, 5.0) <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L249-L253>; 2010-petroff-stromatolite.py L300–L334: 36-step geomspace sweep of beta in make_gif <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L300-L334>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-parameter-expressivity> ;
        pk:hasProbability "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-parameter-expressivity> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.7717/peerj.17037> .

    <https://doi.org/10.7717/peerj.17037> dcterms:date "2024"^^xsd:gYear ;
        dcterms:title "Coral geometry and why it matters" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-kahng-coral-geometry-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Model fidelity to source: 62/100" ;
        rdfs:comment "The master rule V(t+1) = V(t) + G*S(t)/rho (L15-16, L64-67) and the four shape derivations (hemisphere L68-78, disc L81-89, cone L92-104, cylinder L107-110) are algebraically exact for a 1-year discrete step. However, the discrete annual step introduces a time-step artifact presented as geometry: hemisphere_extension (L70) and panel (c) (L173-182) show C rising from 0.52 cm/yr at r = 0.5 cm toward a plateau G/rho = 1.25 cm/yr, whereas in the continuous model dV/dt = 2*pi*r^2*dr/dt = G*(2*pi*r^2)/rho implies dr/dt = G/rho identically for all r (and the discrete disc extension is ~30% below continuum at G/(rho*h) = 2.5). In addition, upper-surface-only disc S (L82), baseless cone S (L93-94), and single-cylinder branching (L107-110) are not explicitly stated as simplifying assumptions. Evidence: 2024-kahng-coral-geometry.py L68–L110: discrete 1-yr volume-step extension and SAP functions for the 4 shapes <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L68-L110>; 2024-kahng-coral-geometry.py L172–L185: panel (c) plots discrete 1-yr hemisphere/cone extension curve rising to G/rho plateau <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L172-L185>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-model-fidelity> ;
        pk:hasProbability "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-model-fidelity> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}


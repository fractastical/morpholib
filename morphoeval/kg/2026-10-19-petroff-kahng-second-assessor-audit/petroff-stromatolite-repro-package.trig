sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-second-assessor-audit-petroff-stromatolite-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Reproducibility package: 62/100" ;
        rdfs:comment "Deterministic (no RNG), backed by requirements.txt and requirements.lock.txt, with CLI flags documented at L336-348. However, --gif is omitted from the 'Run it' docstring block (L45-48), show=True is the default (L344), GIF capture via fig.canvas.buffer_rgba() (L329) is font/backend dependent, and there is no self-test. Evidence: 2010-petroff-stromatolite.py L45–L48: Run it block omits --gif <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L45-L48>; 2010-petroff-stromatolite.py L328–L348: canvas buffer_rgba GIF capture and show=True default <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L328-L348>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-repro-package> ;
        pk:hasProbability "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-repro-package> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolite lamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


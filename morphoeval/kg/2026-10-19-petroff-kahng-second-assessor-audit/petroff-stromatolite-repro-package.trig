sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-repro-package-second-assessor-claude-fable-5-1> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-repro-package-second-assessor-claude-fable-5-1> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Reproducibility package: 62/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic (no RNG), backed by requirements.txt and requirements.lock.txt, with CLI flags documented at L336-348. However, --gif is omitted from the 'Run it' docstring block (L45-48), show=True is the default (L344), GIF capture via fig.canvas.buffer_rgba() (L329) is font/backend dependent, and there is no self-test." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-2> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L45–L48" ;
        dct:description "Run it block omits --gif" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L45-L48> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L328–L348" ;
        dct:description "canvas buffer_rgba GIF capture and show=True default" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L328-L348> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor subagent e65a3d81-92b5-4bb2-941f-4566032cb3cd, blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


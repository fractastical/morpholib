sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, Tokyo rail Pareto trade-off, and (Pass 3) peristaltic shuttle-streaming coupling — Model fidelity to source: 78/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The core Tero model is implemented faithfully: graph-Laplacian Kirchhoff solve with grounded sink (`solve_kirchhoff_potentials`, L238-L295), sigmoidal reinforcement dD/dt = f(<|Q|>) - mu D on a multi-source network (L501-L583), two-path competition (L786-L836) and Murray's law at gamma = 4/3 (L866-L911), and the Pass 3 peristalsis layer is a coherent reduced model (wave geometry L349-L368, cycle solve with mean-corrected volume closure L371-L447, slow coupling through <|Q|> L550-L562) with Lean Theorems 4-5. Deductions: the prescribed closed-form TL/MD/FT curves that the v2 score of 95 relied on have been removed, and the genuine model does not reproduce the reference TL curve (RMSE 1.61, lattice saturates at TL ~ 6.8 for gamma = 0.8 vs 3.42) (-6); the contraction wave is imposed, not generated — no cortex / calcium oscillator or hydrodynamic feedback, fixed 20 deg plane wave (-4); feeding <|Q|> into f(.) swamps pruning for eps >~ 0.005 (FT -> 1, no shortest-path selection), so the biological regime where shuttle flow >> net flow AND pruning still happens is not reproduced (-4); source-sink pairs cycle by deterministic arithmetic (L541-L549) rather than Tero's random pair switching (-2); the \"Kanto\" graph is a jittered 8x8 lattice with a sinusoidal food-source selector (L163-L185), not geography (-2); MD_MST is normalised by a metric-closure MST (L221-L223) so MD_MST < 1 everywhere (0.43-0.80 vs ref 0.84-0.98), a definition mismatch with Tero (-2); volume closure is a uniform mean correction, not a compliance model (L416) (-1); Pass 3 credits (graph-computed statistics, honest ablations) prevent a larger fall." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2010-tero-physarum-transport-network.py L158–L235: 'Kanto' graph is a jittered 8x8 lattice; food sources chosen by distance to (3.5, 3.5) plus 0.15 sin(1.7x + 1.3y); no geographic data <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L158-L235>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-5> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L238–L295" ;
        dct:description "Kirchhoff Laplacian solver with grounded sink, Pass 3 zero-sum extra_sources, conservation and antisymmetry checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L238-L295> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L371–L447" ;
        dct:description "peristaltic_kirchhoff_cycle: rho_e = 1 - eps cos(omega t - psi_e), D rho^4, nodal volume source -(1/2) dV/dt mean-corrected to zero sum, 48-phase quasi-static solve, reversal count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L371-L447> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L501–L583" ;
        dct:description "Slow Tero adaptation; when eps > 0 the reinforcement uses the cycle-averaged <|Q|> (L550-L556); eps = 0 reproduces the steady Pass 2 path; deterministic pairing schedule L541-L549" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L501-L583> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L450–L498" ;
        dct:description "Graph-computed TL_MST / MD_MST / FT / Betti-1 replacing the v2 prescribed sigmoids; MD normalised by the metric-closure MST base; FT conditioned on currently connected pairs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L450-L498> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_057_physarum_transport_network.lean L163–L227" ;
        dct:description "Theorems 4 (zero-sum closed source, half-period reversal, |Q| blind to reversal) and 5 (two-sample net flux = 2 d dp; zero for frozen conductance); file has 5 theorems, 0 sorrys, lean exits 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L163-L227> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 057 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


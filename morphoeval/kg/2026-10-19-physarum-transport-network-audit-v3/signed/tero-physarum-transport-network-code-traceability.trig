sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L1–L63" ;
        dcterms:description "Module docstring: equation-to-paper and Lean theorem traceability for Laws 1-4/5, Pass 3 honesty changes stated" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1-L63> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L299–L346" ;
        dcterms:description "Section 2b banner: reduced two-timescale model, volume-closure assumption, calibration disclosure, constants with inline provenance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L299-L346> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/tero-physarum-transport-network.yaml L88–L121" ;
        dcterms:description "Laws 4-5 registered with lean_decl / lean_theorem / lean_locus and single-range code_locus pins" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/math_kg_loops/tero-physarum-transport-network.yaml#L88-L121> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 057 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, Tokyo rail Pareto trade-off, and (Pass 3) peristaltic shuttle-streaming coupling — Code-to-model traceability: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-L63) maps each of the four law groups to its equations, papers and Lean theorem with file#line pins; the Section 2b banner (L299-L336) states the reduced model, its assumptions and the calibration disclosure; every new function docstring names the quantity it returns; the math-KG YAML registers Laws 4-5 with single-range `code_locus` pins and `lean_locus`. Deductions: the Lean theorems are algebraic identities on Int (zero-sum of three mean-corrected sources, (g+d)dp + (g-d)(-dp) = 2 d dp) and do not formalise the Kirchhoff solvability or the O(eps) half-period antisymmetry that the comments attribute to them (-5); the \"Kamiya 1959\" / \"Kamiya 1981\" inconsistency (L301 vs the bib) (-1); measurement 1's note states a D1*/D2* that the code does not produce (L1556) (-3); the fixed PRUNING_THRESHOLD (L586) and the 0.55 initial conductivity (L530) carry no source (-2); the handoff-era inline comments documenting the v2 -> v3 change are credited (-3 net less)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "morphoeval/lean/loops/Loop_057_physarum_transport_network.lean L179–L227: Theorems 4-5 are Int identities (zero-sum, two-sample net flux); the half-period antisymmetry of the network flux is asserted only to O(eps) in Suite 8, not formalised <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_057_physarum_transport_network.lean#L179-L227>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-code-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


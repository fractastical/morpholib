sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L1697–L1806" ;
        dcterms:description "11-suite self_test: Suites 8-11 cover closure, reversal, linear null, eps monotonicity and 14-metric bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1697-L1806> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L1032–L1085" ;
        dcterms:description "compute_all_results shared bundle used by the renderer and measure_morphoeval (no duplicated computation at default parameters)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1032-L1085> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "datasets/physarum_transport_network/README.md L32–L44" ;
        dcterms:description "Pass 3 section documenting the new reference JSON, its SHA-256 pin and the offline-provenance caveats" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/datasets/physarum_transport_network/README.md#L32-L44> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L1793–L1797" ;
        dcterms:description "Suite 11 calls measure_morphoeval() without the bundle, recomputing the full pipeline for the determinism check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1793-L1797> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 057 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, Tokyo rail Pareto trade-off, and (Pass 3) peristaltic shuttle-streaming coupling — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`--self-test` runs 11 suites in ~7 s (SHA-256 of 3 files, Kirchhoff conservation, two-path transition, gamma = 0 ablation, graph-computed sweep with bitwise eps = 0 determinism, Murray, specimen CV, peristaltic closure < 1e-12 / reversal / exact 2-per-cycle at eps = 0.05 / O(eps) antisymmetry, second-order transport with a linear null < 1e-12, eps monotonicity, 14-metric bitwise determinism); the default render takes ~6.5 s and writes the PNG and both GIFs; `measure_morphoeval()` accepts a shared results bundle so nothing is computed twice. Deductions: the PNG is gitignored (`*.png`) so the audited figure is not in the repository and must be regenerated (-3); Suite 5 thresholds were loosened to admit the honest values rather than tightened (-2); no requirements lock pins the environment (versions recorded only in this audit) (-3); the self-test's compute_all_results() call is repeated by measure_morphoeval() in Suite 11, so the suite runs the full pipeline twice (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-repro-package-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


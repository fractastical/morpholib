sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, Tokyo rail Pareto trade-off, and (Pass 3) peristaltic shuttle-streaming coupling — Parameter expressivity: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Sweeps: 8 gamma values on the multi-source network (L597-L678), 19 gamma values plus gamma = 0 ablation on the two-path circuit (L839-L858), 7 flux splits for Murray (L866-L911), and new in Pass 3 a 9-point wavelength sweep lambda/L in [0.25, 8] (L718-L729) and a 6-point eps sweep of the coupled pruning (L731-L750); CLI exposes --gamma, --i0, --mu, --seed and the new --peristalsis-eps (L1813-L1822), and the dead --gamma flag now actually changes the rendered network (L1055-L1067). Deductions: wave direction (20 deg), T_c, lambda/L and the phase-sample counts are module constants with no CLI (L340-L346) (-5); --i0 / --mu reach only the shown network and the Murray check while the gamma sweep and all measurements always run at defaults (L1046, L1517-L1522 area) (-4); `seed` only jitters node coordinates because pairing is deterministic (-2); the eps sweep stops at 0.01 so the regime where every tube reverses (eps >= 0.05, Suite 8) is tested but not shown in Panel I (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2010-tero-physarum-transport-network.py L338–L346: DEFAULT_PERISTALSIS_EPS, sweeps, wavelength ratio, T_c, ADAPTATION_TIME_S, wave direction and phase counts are constants without CLI exposure <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L338-L346>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-4> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L597–L678" ;
        dcterms:description "8-point gamma phase-transition sweep in [0.8, 2.4] with graph-computed statistics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L597-L678> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L718–L750" ;
        dcterms:description "Wavelength-ratio sweep (9 values, I0 = 0) and eps sweep (6 values) of the coupled slow adaptation at gamma = 1.8" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L718-L750> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L1809–L1838" ;
        dcterms:description "CLI: --self-test, --skip-gif, --gamma, --i0, --mu, --seed, --peristalsis-eps wired through render_outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1809-L1838> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L1055–L1067" ;
        dcterms:description "Panel A / GIF network honours --gamma, --i0, --mu (Pass 2 dead flag fixed); the sweep itself still runs at defaults" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1055-L1067> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 057 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


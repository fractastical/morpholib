sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, Tokyo rail Pareto trade-off, and (Pass 3) peristaltic shuttle-streaming coupling — Morphometric validation: 70/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1529-L1690) now reports 14 metrics with method strings, RMSE / p-values and ablation controls, and the Pass 3 metrics each carry an eps = 0 null (reversals 0, fraction 0, net transport < 1e-12). Deductions: the v2 headline fits were against prescribed curves; the honest graph-computed TL has RMSE 1.61 against the reference table and FT r = 0.848 (RMSE 0.178), with a non-monotone FT tail at gamma = 2.4 caused by conditioning on connected pairs (L488-L497) (-8); the gamma = 1.8 TL_MST = 1.703 \"match\" to 1.75 depends on the eps = 0.0025 calibration (eps = 0 gives 1.149), disclosed at L333-L338 but still a calibration landing on the target (-6); specimen reference values 0.8926 (L1634) and 33 (L1624) are the script's own earlier outputs (circular) (-4); measurement 1 compares the sigmoid-kernel run (L853) with the power-law analytical reference 0.7401 and its note still claims D1*/D2* = 2.83 while the run gives 1.367 (L1556) (-3); peristalsis references are definitional (2 reversals), qualitative (1.0) or recalled (lambda/L = 1, T_c = 100 s), and two metrics have reference_value None (-5); MD_MST (0.796 vs 0.85) is reported only inside a method string, not as a scored metric (-2); self-test thresholds were relaxed to r_TL > 0.90 / r_FT > 0.75 to admit the honest values (L1731-L1732) (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2010-tero-physarum-transport-network.py L1549–L1558: Measurement 1: sigmoid-kernel run (sublinear_06, power_law_kernel=False at L853) compared with the power-law analytical 0.7401; note claims D1*/D2* = 2.8284 while the run reports 1.367 <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1549-L1558>",
            "2010-tero-physarum-transport-network.py L1619–L1638: Specimen Betti-1 reference 33 and Murray reference 0.8926 are the script's own prior outputs — circular reference_value <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1619-L1638>",
            "2010-tero-physarum-transport-network.py L1728–L1740: Suite 5 thresholds relaxed to r_TL > 0.90, r_FT > 0.75 and monotone TL to admit the graph-computed values <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L1728-L1740>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-fraction-of-active-tubes-exhibiting-shuttle-streaming-flow-reversal-peristalsis-on-vs-eps-0-ablation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-oscillatory-to-steady-flux-rms-ratio-of-shuttle-streaming-at-the-calibrated-contraction-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-peristalsis-pruning-coupling-spearman-rho-of-betti-1-loop-count-vs-contraction-amplitude-eps-gamma-1-8>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-peristaltic-net-transport-optimum-wavelength-lambda-l-organism-pure-peristalsis-i0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-enclosed-anastomosing-loop-count-betti-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-y-junction-murray-cubic-radius-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-shuttle-streaming-flow-reversals-per-actomyosin-contraction-cycle-active-tubes-gamma-1-8-network>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-fault-tolerance-ft>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-tokyo-rail-pareto-regime-gamma-1-8-normalized-total-length-tl-mst>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-sublinear-gamma-0-6-short-path-flux-share-q1-i0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-two-path-superlinear-gamma-1-8-winner-takes-all-shortest-path-flux-share-q1-i0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-morphometric-validation-2> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-fraction-of-active-tubes-exhibiting-shuttle-streaming-flow-reversal-peristalsis-on-vs-eps-0-ablation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fraction of active tubes exhibiting shuttle-streaming flow reversal (peristalsis on vs eps = 0 ablation) = 0.8511 fraction of active tubes with >= 2 sign changes per cycle" ;
        dcterms:description "tubes on the direct source-sink trunk keep a steady bias and need larger eps to reverse; oscillatory/steady flux rms ratio = 0.697" ;
        schema:measurementTechnique "Same cycle as above; ablation (eps = 0, steady source-sink Kirchhoff flow) fraction = 0.00" ;
        schema:name "Fraction of active tubes exhibiting shuttle-streaming flow reversal (peristalsis on vs eps = 0 ablation)" ;
        schema:unitText "fraction of active tubes with >= 2 sign changes per cycle" ;
        schema:value "0.8511" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-fraction-of-active-tubes-exhibiting-shuttle-streaming-flow-reversal-peristalsis-on-vs-eps-0-ablation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-fraction-of-active-tubes-exhibiting-shuttle-streaming-flow-reversal-peristalsis-on-vs-eps-0-ablation-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Multi-source gamma phase transition Fault Tolerance FT correlation = 0.84783 Pearson r" ;
        dcterms:description "Pass 3: prescribed closed-form FT curve removed; graph-computed FT(gamma) = [1.0, 1.0, 1.0, 0.97, 0.94, 0.74, 0.53, 0.6] vs ref [0.96, 0.92, 0.88, 0.85, 0.83, 0.84, 0.48, 0.16]; Betti-1(gamma) = [122, 69, 40, 24, 19, 8, 3, 3]" ;
        schema:measurementTechnique "8-point gamma sweep in [0.8, 2.4]; FT = fraction of active tubes whose single removal disconnects no food-source pair, computed by bridge enumeration on the pruned graph (RMSE = 0.1776, p = 7.83e-03)" ;
        schema:name "Multi-source gamma phase transition Fault Tolerance FT correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.84783" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-fault-tolerance-ft-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Multi-source gamma phase transition normalized Total Length TL_MST correlation = 0.98663 Pearson r" ;
        dcterms:description "Pass 3: prescribed closed-form TL curve removed; graph-computed values TL_MST(gamma) = [6.84, 4.86, 3.76, 3.09, 2.39, 1.7, 1.35, 1.06] vs ref [3.42, 2.68, 2.18, 1.92, 1.8, 1.75, 1.38, 1.12] (RMSE = 1.6066; dense 8x8 lattice saturates at low gamma)" ;
        schema:measurementTechnique "8-point gamma sweep in [0.8, 2.4]; TL_MST computed from the pruned graph (sum of active tube lengths / food-source MST length, threshold D >= 0.10 max D, peristalsis eps = 0.0025) vs the vendored Fig. 3 table (RMSE = 1.6066, p = 5.91e-06)" ;
        schema:name "Multi-source gamma phase transition normalized Total Length TL_MST correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.98663" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-multi-source-gamma-phase-transition-normalized-total-length-tl-mst-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Murray's cube law cubic radius ratio (r1^3 + r2^3)/r0^3 at gamma = 4/3 = 1.0 (r_1^3 + r_2^3) / r_0^3" ;
        dcterms:description "exact Hagen-Poiseuille D propto r^4 & Q propto D^(3/4) = r^3 identity (RMSE = 3.88e-09)" ;
        schema:measurementTechnique "7-split Y-junction bifurcation sweep at critical vascular exponent gamma = 4/3 (RMSE = 3.88e-09)" ;
        schema:name "Murray's cube law cubic radius ratio (r1^3 + r2^3)/r0^3 at gamma = 4/3" ;
        schema:unitText "(r_1^3 + r_2^3) / r_0^3" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-murray-s-cube-law-cubic-radius-ratio-r1-3-r2-3-r0-3-at-gamma-4-3-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-oscillatory-to-steady-flux-rms-ratio-of-shuttle-streaming-at-the-calibrated-contraction-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Oscillatory-to-steady flux rms ratio of shuttle streaming at the calibrated contraction amplitude = 0.6967 rms(Q_osc) / rms(Q_steady)" ;
        dcterms:description "eps is a disclosed model-scale calibration; the ratio scales linearly with eps (Panel I inset values)" ;
        schema:measurementTechnique "rms of (Q_e(t) - <Q_e>) over the cycle divided by rms of the eps = 0 steady flux, gamma=1.8 network, eps = 0.0025; eps sweep ratios = [0.0, 0.301, 0.697, 3.139, 7.436, 16.71]" ;
        schema:name "Oscillatory-to-steady flux rms ratio of shuttle streaming at the calibrated contraction amplitude" ;
        schema:unitText "rms(Q_osc) / rms(Q_steady)" ;
        schema:value "0.6967" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-peristalsis-pruning-coupling-spearman-rho-of-betti-1-loop-count-vs-contraction-amplitude-eps-gamma-1-8> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Peristalsis-pruning coupling: Spearman rho of Betti-1 loop count vs contraction amplitude eps (gamma = 1.8) = 1.0 Spearman rho" ;
        dcterms:description "shows the fast peristaltic wave feeding back on long-timescale pruning: larger contraction amplitude -> more loops, higher FT, higher TL_MST; eps = 0 recovers the Pass 2 steady model" ;
        schema:measurementTechnique "6-point eps sweep [0.0, 0.00125, 0.0025, 0.005, 0.0075, 0.01] of the coupled slow adaptation (cycle-averaged <|Q|> feeds dD/dt): Betti-1 = [4, 5, 8, 27, 34, 71], FT = [0.75, 0.8, 0.745, 0.967, 0.99, 1.0], TL_MST = [1.149, 1.357, 1.703, 3.302, 3.61, 4.984] (p = 0.00e+00)" ;
        schema:name "Peristalsis-pruning coupling: Spearman rho of Betti-1 loop count vs contraction amplitude eps (gamma = 1.8)" ;
        schema:unitText "Spearman rho" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-peristaltic-net-transport-optimum-wavelength-lambda-l-organism-pure-peristalsis-i0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Peristaltic net-transport optimum wavelength lambda* / L_organism (pure peristalsis, I0 = 0) = 1.5 lambda / L_organism" ;
        dcterms:description "net transport is second order in eps and requires joint modulation of conductance and pressure (Lean 4 Theorem 5); order-of-magnitude agreement only, not fitted" ;
        schema:measurementTechnique "Sweep lambda / L in [0.25, 0.5, 0.75, 1.0, 1.5, 2.0, 3.0, 4.0, 8.0] of the cycle-averaged net transport sum_e |<Q_e>| L_e with I0 = 0 (values = [0.013, 0.008, 0.006, 0.009, 0.014, 0.014, 0.011, 0.009, 0.005]); eps = 0 null = 0.0e+00" ;
        schema:name "Peristaltic net-transport optimum wavelength lambda* / L_organism (pure peristalsis, I0 = 0)" ;
        schema:unitText "lambda / L_organism" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-peristaltic-net-transport-optimum-wavelength-lambda-l-organism-pure-peristalsis-i0-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-peristaltic-net-transport-optimum-wavelength-lambda-l-organism-pure-peristalsis-i0-0-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-enclosed-anastomosing-loop-count-betti-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Physarum polycephalum specimen enclosed anastomosing loop count (Betti-1) = 33 closed loops" ;
        dcterms:description "primary trunk fraction = 0.5196, secondary = 0.3644, tertiary = 0.1159" ;
        schema:measurementTechnique "Chromatic yellow vein segmentation + interior hole topology on physarum_polycephalum_specimen.jpg (vein area fraction = 0.1647)" ;

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-enclosed-anastomosing-loop-count-betti-1-reference> a schema:PropertyValue ;
        schema:value "33" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-measurement-physarum-polycephalum-specimen-y-junction-murray-cubic-radius-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-source-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L112–L150" ;
        dcterms:description "Runtime SHA-256 verification of the Fig. 3 reference JSON, the specimen JPEG and the Pass 3 peristalsis JSON (fail-closed)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L112-L150> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/physarum_transport_network/peristaltic_shuttle_streaming_reference.json L1–L75" ;
        dcterms:description "Pass 3 reference table with provenance_note, value_provenance per entry (recalled / definitional / qualitative) and the eps calibration_disclosure (L73)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/datasets/physarum_transport_network/peristaltic_shuttle_streaming_reference.json#L1-L75> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/physarum_transport_network/paper_citations.bib L66–L75" ;
        dcterms:description "kamiya1981physical added with note 'DOI not re-verified offline'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/datasets/physarum_transport_network/paper_citations.bib#L66-L75> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, Tokyo rail Pareto trade-off, and (Pass 3) peristaltic shuttle-streaming coupling — Source and data traceability: 80/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Three vendored inputs are SHA-256-verified at every run (`verify_dataset_integrity`, L112-L150, including the new `peristaltic_shuttle_streaming_reference.json`), the bib has 7 entries, the dataset README has a Pass 3 section (L32-L44) and the new JSON carries explicit `value_provenance` and a `provenance_note`. Deductions: the Kamiya (1981) DOI and the Alim (2013) DOI could not be verified offline and the JSON values T_c = 100 s and lambda*/L = 1 are `recalled` (L6, L30-L36, L52-L58) (-6); `ADAPTATION_TIME_S = 1800 s` (L343), which fixes omega and therefore the absolute shuttle-flux scale, is marked \"unsourced\" (-5); the pre-existing Fig. 3 reference table (8 gamma points with TL/MD/FT/Betti-1) and the Tokyo / Physarum benchmark numbers are not traceable to a specific digitisation — Tero 2010 Fig. 3 plots statistics against I0 for several gamma, not an 8-point gamma scan — so measurements 3-6 are against a reconstruction (-6); the Section 2b banner cites \"Kamiya 1959\" (L301) while the bib and JSON cite Kamiya 1981 (-1); the eps calibration disclosure is credited (+2 net against a larger deduction)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2010-tero-physarum-transport-network.py L343–L343: ADAPTATION_TIME_S = 1800 s labelled 'model-scale anchor, unsourced' — sets omega and the osc/steady flux ratio <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L343-L343>",
            "datasets/physarum_transport_network/physarum_transport_network_reference.json L1–L186: Pre-existing gamma_phase_transition_sweep_tero2010_fig3 table and Tokyo/Physarum benchmarks without digitisation provenance (Pass 1 reconstruction) <https://github.com/fractastical/morpholib/blob/171769b9/datasets/physarum_transport_network/physarum_transport_network_reference.json#L1-L186>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-source-traceability-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 057 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

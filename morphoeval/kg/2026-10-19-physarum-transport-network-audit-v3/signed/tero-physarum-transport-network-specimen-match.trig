sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tero-physarum-transport-network> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tero-physarum-transport-network-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Tero et al. (2010) Science & Tero, Kobayashi & Nakagaki (2007) J. Theor. Biol. adaptive Physarum tube conductivity network, shortest-path phase transition, Murray's cube law, Tokyo rail Pareto trade-off, and (Pass 3) peristaltic shuttle-streaming coupling — Morphological realism / specimen match: 80/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-pinned specimen photograph is still segmented into 33 loops with a 3-tier vein hierarchy and Y-junction Murray ratios (`segment_physarum_specimen`, L919-L1025), and the figure now adds the shuttle-streaming time series with ablation (Panel G), net transport vs lambda/L with the Alim line (H), and the eps sweep against the Physarum TL band (I) plus a 24-frame signed-flux GIF. Deductions: the simulated network is a jittered lattice yet Panel A labels its axis \"Kanto West-East coordinate\" and calls the central node Tokyo (L158-L185) (-5); the specimen Betti-1 = 33 and Murray 0.8926 references are the script's own earlier outputs, so \"match\" here is self-agreement (-5); the shuttle-streaming comparison is to definitional / qualitative anchors (2 reversals, \"all tubes oscillate\"), not to a vendored flow-velocity trace or to Alim et al. kymographs (-5); 15 % of trunk tubes keep a steady bias at the default eps, which is reported honestly (-2); the Panel H optimum is shallow and non-unique (1.5 and 2.0 tie at 0.014; 0.25 gives 0.013) and should not be read as confirming lambda ~ L (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/physarum_transport_network/peristaltic_shuttle_streaming_reference.json L30–L63: Reference anchors are value_provenance 'recalled' (T_c, lambda/L), 'definitional' (2 reversals) and 'qualitative' (fraction reversing) — weak specimen anchors <https://github.com/fractastical/morpholib/blob/171769b9/datasets/physarum_transport_network/peristaltic_shuttle_streaming_reference.json#L30-L63>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-5> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L919–L1025" ;
        dcterms:description "Chromatic yellow vein segmentation, EDT radius hierarchy, Betti-1 hole count, Y-junction Murray ratio extraction (unchanged from Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L919-L1025> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2010-tero-physarum-transport-network.py L681–L778" ;
        dcterms:description "evaluate_peristaltic_shuttle_streaming: reversal statistics with eps = 0 ablation, wavelength sweep (net transport), eps sweep of coupled pruning" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2010-tero-physarum-transport-network.py#L681-L778> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/physarum_transport_network_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: Kanto-labelled lattice network (A), two-path transition, graph-computed Fig. 3 curves vs reference table (C), benchmarks (D), Murray (E), specimen segmentation (F), shuttle streaming + ablation (G), net transport vs lambda/L (H), eps sweep with Physarum TL band (I) — docs/media/physarum_transport_network_comparison.png: rendered output of 2010-tero-physarum-transport-network.py at 171769b9, image/png, 1759411 B, 2610×2340 px, artifact_sha256 62ea6f63e161d275493b770aecf64e1191174f3c35bd7a93b7884d4d1a900657 (sha256 62ea6f63e161d275493b770aecf64e1191174f3c35bd7a93b7884d4d1a900657), spec_fingerprint 9d2ad477cfb2fd69b34482f7554563764e14b823bf3616cc6b81b255bf0d40eb" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/physarum_transport_network_shuttle_streaming.gif (generated output)" ;
        dcterms:description "24 frames over one contraction cycle, signed flux colouring with direction arrows; reversal visible on most tubes, trunk tubes keep bias — docs/media/physarum_transport_network_shuttle_streaming.gif: rendered output of 2010-tero-physarum-transport-network.py at 171769b9, image/gif, 583396 B, 912×408 px, 24 frames, artifact_sha256 d62c624f77ad3bbc2695a6ac9a8c917dac5fd0dff66550db2901a03ba8adc5e5 (sha256 d62c624f77ad3bbc2695a6ac9a8c917dac5fd0dff66550db2901a03ba8adc5e5), spec_fingerprint 9d2ad477cfb2fd69b34482f7554563764e14b823bf3616cc6b81b255bf0d40eb" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tero-physarum-transport-network-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/physarum_transport_network_growth.gif (generated output)" ;
        dcterms:description "10-frame growth GIF of the gamma = 1.8 network pruning plus two-path curves; content unchanged from Pass 2 apart from the title and the --gamma-driven network choice — docs/media/physarum_transport_network_growth.gif: rendered output of 2010-tero-physarum-transport-network.py at 171769b9, image/gif, 381727 B, 893×408 px, 10 frames, artifact_sha256 303789546b7e540fdc7da49306174eaa67a0b831e50cf6cb7dc1b593a9654e08 (sha256 303789546b7e540fdc7da49306174eaa67a0b831e50cf6cb7dc1b593a9654e08), spec_fingerprint 9d2ad477cfb2fd69b34482f7554563764e14b823bf3616cc6b81b255bf0d40eb" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 057 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


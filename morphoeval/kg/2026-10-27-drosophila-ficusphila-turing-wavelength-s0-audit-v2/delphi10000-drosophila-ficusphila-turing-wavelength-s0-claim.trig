sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila ficusphila longitudinal sex-comb Turing wavelength at 2.1 µm faithfully reproduces Drosophila ficusphila morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila ficusphila specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py; output: docs/media/drosophila_ficusphila_turing_wavelength_s0_comparison.png; organism: Drosophila ficusphila; environment: n/a; claim_boundary: [reported_in_source: Turing (1952): instability at a finite critical wavenumber. | Schnakenberg (1979): kinetics R_u = a - u + u^2 v, R_v = b - u^2 v. | Tanaka, Barmina & Kopp (2009): longitudinal sex combs form by rotation or by bristles born longitudinal. | Tanaka et al. (2011) and Kopp (2011): sex combs are a doublesex/Scr innovation.; reconstructed_in_script: λ_c = 2.072 µm (2.072e-6 m, log10 = -5.684) is the assigned detail tier, obtained by setting D_u at r = 20. | At 0 Ma, density 2/3 for D. eugracilis and 1/2 for D. grimshawi give λ = 3.108 µm and 4.144 µm. | Nine-point D_u sweep, equal-diffusion integration, mask coherency and the KS statistic are script measurements.; transfer_boundary: No cited paper measures a 2.072 µm sex-comb ridge or gives these Schnakenberg numbers. | The chronoseries is a project order of extant species, not a stratigraphic sequence.; does_not_claim: That the gallery plate is an SEM of a tooth. | That the power-weighted FFT centroid (1.9175 µm) is the analytic λ_c (2.072 µm). | That a second assessor scored this pass.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1073/pnas.0807875106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
            <https://doi.org/10.1371/journal.pbio.1001131> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://github.com/fractastical/morpholib> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1073/pnas.0807875106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
            <https://doi.org/10.1371/journal.pbio.1001131> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1073/pnas.0807875106> dct:date "2009"^^xsd:gYear ;
        dct:title "Distinct developmental mechanisms underlie the evolutionary diversification of Drosophila sex combs" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.1525-142X.2011.00507.x> dct:date "2011"^^xsd:gYear ;
        dct:title "Drosophila sex combs as a model of evolutionary innovations" .
    <https://doi.org/10.1371/journal.pbio.1001131> dct:date "2011"^^xsd:gYear ;
        dct:title "Evolution of sex-specific traits through changes in HOX-dependent doublesex expression" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ficusphila longitudinal sex-comb Turing wavelength at 2.1 µm — Model fidelity to source: 92/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Unchanged closed-form dispersion, now accompanied by an integrated equal-diffusion control whose std ratio is 0.018, consistent with the analytic σ_c = -0.1 and with the Lean theorem that r = 1 is stable. The spiral charge remains a render choice." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L230–L245: m=2 is a render choice, not a published topological charge <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L230-L245>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L81–L89" ;
        dct:description "dispersion_sigma eigenvalue" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L81-L89> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L499–L539" ;
        dct:description "ablation_equal_diffusion integrates D_u = D_v from the same spiral seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L499-L539> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3185_drosophila_ficusphila_turing_wavelength_s0.lean L32–L38" ;
        dct:description "r=20 unstable and r=1 stable, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3185_drosophila_ficusphila_turing_wavelength_s0.lean#L32-L38> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-ficusphila-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian trace is negative" ;
    dct:description "Homogeneous state of the 2.072 µm ficusphila ridge field is stable to uniform perturbations | Variables: f_u = 0.8, g_v = -1 at the homogeneous steady state u0 = 1, v0 = 0.9" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L81-L89>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3185_drosophila_ficusphila_turing_wavelength_s0.lean#L14-L17> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v = -0.2 < 0 at (a, b) = (0.1, 0.9)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
        <https://doi.org/10.1371/journal.pbio.1001131> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3185.trace_milli" ;
    pk:leanTheorem "MathOfBiology.Loop_3185.trace_is_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-ficusphila-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber at diffusion ratio 20" ;
    dct:description "Selects the 2.1 µm detail-scale wavelength of the longitudinal sex-comb tooth array | Variables: r = 20, milli-Jacobian f_u = 800, g_v = -1000, det scale = 1000" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L72-L78>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3185_drosophila_ficusphila_turing_wavelength_s0.lean#L29-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 2.072 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
        <https://doi.org/10.1371/journal.pbio.1001131> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3185.turing_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3185.focal_ratio_is_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-ficusphila-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal diffusion does not select a wavelength" ;
    dct:description "Negative control for the 2.072 µm instability | Variables: r = 1 versus r = 20" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L91-L133>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3185_drosophila_ficusphila_turing_wavelength_s0.lean#L36-L38> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "at r = 1, (f_u + g_v)^2 < 4 det, so sigma_max < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
        <https://doi.org/10.1371/journal.pbio.1001131> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3185.turing_margin" ;
    pk:leanTheorem "MathOfBiology.Loop_3185.equal_diffusion_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-ficusphila-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Packed comb is the short-wavelength state at 0 Ma" ;
    dct:description "What changes at 2.072 µm relative to the predecessor and the successor | Variables: density 1 versus 2/3 (eugracilis) and 1/2 (grimshawi); same Jacobian" ;
    dct:source "Tanaka, Barmina & Kopp (2009) DOI:10.1073/pnas.0807875106" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py#L136-L165>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3185_drosophila_ficusphila_turing_wavelength_s0.lean#L42-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_fic = 2072 nm < lambda_eug = 3108 nm and lambda_fic < lambda_grim = 4144 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142X.2011.00507.x>,
        <https://doi.org/10.1371/journal.pbio.1001131> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3185.lam_fic_nm" ;
    pk:leanTheorem "MathOfBiology.Loop_3185.focal_wavelength_is_shortest" ;
    pk:leanVerified true .


    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-ficusphila-turing-wavelength-s0.py L619–L717" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila ficusphila longitudinal sex-comb Turing wavelength at 2.1 µm — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.99999994 (24-point grid rounds to 1.0 at five decimals) against a gate reference of 0.98, RMSE = 5.2e-4 against a tolerance of 0.05. Plate-versus-frame KS = 0.1879 (reference 0, which would be an identical histogram). Mask coherency, foreground fraction and circularity differ between plate and frame. The radial-FFT centroid is 1.9175 µm against analytic 2.072 µm. None of these measured values is copied onto its reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r-fine>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-du-sweep-lambda-max-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-du-sweep-lambda-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-equal-diffusion-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-predecessor-wavelength-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-fft-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 1.0 1" ;
        schema:measurementTechnique "Pearson r between analytic σ(k) and late-time Euler growth rates" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r-fine> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r_fine = 1.0 1" ;
        schema:measurementTechnique "Pearson r of analytic vs Euler σ(k) on a 24-point wavenumber grid" ;
        schema:name "dispersion_pearson_r_fine" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r-fine-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r-fine-reference> a schema:PropertyValue ;
        dct:source "loop gate, not the measured correlation" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate for this loop (threshold, not the measured r)" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.00052 1/time" ;
        schema:measurementTechnique "RMSE of Euler σ(k) against the closed-form eigenvalue" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.00052" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "pre-registered tolerance, not the measured RMSE" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-du-sweep-lambda-max-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "du_sweep_lambda_max_um = 3.0733 µm" ;
        schema:measurementTechnique "longest λ_c on the nine-point D_u sweep (factor 2.20)" ;
        schema:name "du_sweep_lambda_max_um" ;
        schema:unitText "µm" ;
        schema:value "3.0733" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-du-sweep-lambda-max-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-du-sweep-lambda-max-um-reference> a schema:PropertyValue ;
        dct:source "focal wavelength 2.072 µm, which is interior to the sweep" ;
        schema:value "2.072" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-du-sweep-lambda-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "du_sweep_lambda_ratio = 2.0 1" ;
        schema:measurementTechnique "λ(D_u factor 2.20) / λ(D_u factor 0.55); monotone sweep, nine points, r=20" ;
        schema:name "du_sweep_lambda_ratio" ;
        schema:unitText "1" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-du-sweep-lambda-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-du-sweep-lambda-ratio-reference> a schema:PropertyValue ;
        dct:source "a ratio of 1 would mean λ did not respond to D_u" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-equal-diffusion-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_std_ratio = 0.018 1" ;
        schema:measurementTechnique "final/initial std of u after 700 steps with D_u = D_v (negative control)" ;
        schema:name "equal_diffusion_std_ratio" ;
        schema:unitText "1" ;
        schema:value "0.018" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-equal-diffusion-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-equal-diffusion-std-ratio-reference> a schema:PropertyValue ;
        dct:source "a ratio of 1 would mean the control failed to change the seed" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-predecessor-wavelength-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor_wavelength_ratio = 1.5 1" ;
        schema:measurementTechnique "λ(eugracilis)/λ(ficusphila) at density 2/3, same Jacobian, 0 Ma" ;
        schema:name "predecessor_wavelength_ratio" ;
        schema:unitText "1" ;
        schema:value "1.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-predecessor-wavelength-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-predecessor-wavelength-ratio-reference> a schema:PropertyValue ;
        dct:source "focal species ratio against itself would be 1; predecessor is longer" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_luminance_ks_statistic = 0.1879 1" ;
        schema:measurementTechnique "two-sample Kolmogorov-Smirnov statistic, plate vs simulation interior luminance" ;
        schema:name "specimen_luminance_ks_statistic" ;
        schema:unitText "1" ;
        schema:value "0.1879" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-luminance-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean identical luminance distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_mask_circularity = 0.0683 1" ;
        schema:measurementTechnique "4π area/perimeter² of the plate mask" ;
        schema:name "specimen_mask_circularity" ;
        schema:unitText "1" ;
        schema:value "0.0683" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-circularity-reference> a schema:PropertyValue ;
        dct:source "circularity of the simulated-frame mask" ;
        schema:value "0.0118" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_mask_coherency = 0.8279 1" ;
        schema:measurementTechnique "structure-tensor coherency inside the border-contrast mask of the gallery plate" ;
        schema:name "specimen_mask_coherency" ;
        schema:unitText "1" ;
        schema:value "0.8279" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-coherency-reference> a schema:PropertyValue ;
        dct:source "same mask measurement on the Schnakenberg last frame (not a copy of the plate)" ;
        schema:value "0.9494" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_mask_foreground_fraction = 0.3646 1" ;
        schema:measurementTechnique "foreground fraction of the gallery plate after border-contrast segmentation" ;
        schema:name "specimen_mask_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.3646" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-mask-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "foreground fraction of the simulated last frame" ;
        schema:value "0.5381" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-fft-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_stripe_fft_wavelength_um = 1.9175 µm" ;
        schema:measurementTechnique "power-weighted radial-FFT centroid wavelength of the final activator field" ;
        schema:name "specimen_stripe_fft_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "1.9175" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-fft-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-fft-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "analytic λ_c = 2.072 µm" ;
        schema:value "2.072" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_stripe_wavelength_um = 2.4508 µm" ;
        dct:description "Numeric argmax on a 12-point k grid; not identical to the analytic λ_c." ;
        schema:measurementTechnique "2π/k at the wavenumber that maximises the Euler growth-rate sample" ;
        schema:name "specimen_stripe_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "2.4508" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-measurement-specimen-stripe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "assigned detail-tier wavelength 2.072 µm (2.072e-6 m)" ;
        schema:value "2.072" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;

            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-ficusphila-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;

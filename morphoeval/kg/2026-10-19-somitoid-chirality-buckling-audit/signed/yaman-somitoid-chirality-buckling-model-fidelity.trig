sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics and mesenchymal-to-epithelial transition (MET) model — Model fidelity to source: 62/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates the 1D radial wedge-rosette interfacial energy E(R_in, N) (L55-84), but Pass 1 lacks explicit 2D apico-basal vertex coordinate relaxation, EphA4/ephrinB2 inter-somite cleft mechanics, and Y-27632 / Minus-Matrigel negative controls." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2021-yaman-somitoid-chirality-buckling.py L87–L102: Single WT metric without 2D vertex polygon relaxation or cleft separation <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L87-L102>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-1> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L55–L84" ;
        dcterms:description "1D radial rosette energy curve E(R_in, N)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L55-L84> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


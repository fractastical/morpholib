sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-radius-ratio-r-in-r-out> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type somite rosette equilibrium apical-to-basal radius ratio R_in / R_out = 0.3001 dimensionless ratio" ;
        dcterms:description "R_in* = 7.61 um, R_out* = 25.37 um" ;
        schema:measurementTechnique "1D radial energy minimization of E(R_in, N) for N=16 wedge cells" ;
        schema:name "wild-type somite rosette equilibrium apical-to-basal radius ratio R_in / R_out" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.3001" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-radius-ratio-r-in-r-out-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-radius-ratio-r-in-r-out-reference> a schema:PropertyValue ;
        dcterms:source "Yamanaka et al. (2023) Nature 614:509-520; Adhyapok et al. (2021) Dev. Cell 56:1312-1324" ;
        schema:value "0.2992" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics and mesenchymal-to-epithelial transition (MET) model — Morphometric validation: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes the wild-type apical-to-basal radius ratio, but Pass 1 requires 5 quantitative measurements including 2D vertex vs analytical lumen ratio agreement, 6-regime empirical correlation r, EphA4/ephrinB2 cleft separation index, and empirical specimen rosette spacing and annular cortex/core contrast." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2021-yaman-somitoid-chirality-buckling.py L87–L102: Baseline measure_morphoeval() returning 1 metric <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L87-L102>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-radius-ratio-r-in-r-out> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


<https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics and mesenchymal-to-epithelial transition (MET) model — Morphometric validation: 56/100" ;
    dct:date "2026-10-19"^^xsd:date ;

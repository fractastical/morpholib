sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics and mesenchymal-to-epithelial transition (MET) model — Reproducibility package: 64/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Provides `--self-test` and baseline PNG/GIF rendering, requiring full verification of 2D vertex relaxation, negative controls (Y-27632 & Minus-Matrigel), Eph/ephrin clefting, and specimen segmentation in Pass 2." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-1> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L143–L165" ;
        dct:description "Pass 1 self-test and CLI entrypoint" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L143-L165> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


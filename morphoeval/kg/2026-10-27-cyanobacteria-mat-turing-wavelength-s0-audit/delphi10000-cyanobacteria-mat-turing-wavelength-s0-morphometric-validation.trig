sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cyanobacteria mat Turing ocellus wavelength at 64.19 µm (Holocene, 0 Ma) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1: saturated dominant shell is 64.19 µm; the linear k_* wavelength is 66.617 µm. Eigenvector probe versus analytical sigma(k): Pearson r = 0.999986, RMSE = 0.00558 (11 modes). The rejected bin-mean estimator scores r = 0.529 on the same diffusivities. Plate segmentation finds 137 colonies (area CV 1.642) against 65 spots (area CV 0.295); two-sample KS = 0.453. Those specimen numbers are not copies of the simulation. n = 1 plate, and the plate is not at 64 µm." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-diffusivity-sweep-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-rejected-bin-mean-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-segmented-spot-equivalent-diameter-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-selected-pigment-ocellus-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-specimen-colony-area-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-specimen-colony-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-morphometric-validation-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-morphometric-validation-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-diffusivity-sweep-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-sweep wavelength pearson r = 0.999475 Pearson r" ;
        dct:description "reference 0.9 is the expressivity floor, not the measured correlation" ;
        schema:measurementTechnique "measured λ(γ) versus λ_* √γ for γ in {0.5, 1, 1.5, 2}" ;
        schema:name "diffusivity-sweep wavelength pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999475" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-diffusivity-sweep-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-diffusivity-sweep-wavelength-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion pearson r = 0.999986 Pearson r" ;
        dct:description "RMSE of σ is 0.0056; reference 0.95 is an acceptance floor, not the measured r" ;
        schema:measurementTechnique "eigenvector-initialised cosine modes n=4..14 versus analytical σ(k)" ;
        schema:name "dispersion pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.999986" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.95" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.0056 1/time" ;
        dct:description "reference 0 would be a perfect linear match" ;
        schema:measurementTechnique "root mean square of σ_measured(k) - σ_analytic(k)" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.0056" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control sigma_max = -0.0588 1/time" ;
        dct:description "RMS ratio final/initial = 0.047314456136288555" ;
        schema:measurementTechnique "max_k σ(k) with D_u = D_v = D_u(Turing); negative means the control decays" ;
        schema:name "equal-diffusion control sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.0588" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-rejected-bin-mean-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rejected bin-mean dispersion pearson r = 0.5288 Pearson r" ;
        dct:description "this estimator is biased; the eigenvector probe is the reported goodness-of-fit" ;
        schema:measurementTechnique "radial bin-mean of a broadband initial condition; a negative methodological control" ;
        schema:name "rejected bin-mean dispersion pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.5288" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-rejected-bin-mean-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-rejected-bin-mean-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-segmented-spot-equivalent-diameter-ks> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented spot equivalent-diameter KS = 0.4526 KS D" ;
        dct:description "p = 1.0608521524716083e-08; reference 0 would mean identical distributions" ;
        schema:measurementTechnique "two-sample KS on median-normalised equivalent diameters, specimen colonies vs activator peaks" ;
        schema:name "segmented spot equivalent-diameter KS" ;
        schema:unitText "KS D" ;
        schema:value "0.4526" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-segmented-spot-equivalent-diameter-ks-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-segmented-spot-equivalent-diameter-ks-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-selected-pigment-ocellus-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected pigment-ocellus wavelength = 64.19 µm" ;
        dct:description "reference is the linear k_* wavelength; the slot assignment is 64.19 µm" ;
        schema:measurementTechnique "integer Fourier shell of the saturated activator with the most power" ;
        schema:name "selected pigment-ocellus wavelength" ;
        schema:unitText "µm" ;
        schema:value "64.19" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-selected-pigment-ocellus-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-selected-pigment-ocellus-wavelength-reference> a schema:PropertyValue ;
        schema:value "66.617" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-specimen-colony-area-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen colony area CV = 1.6418 CV" ;
        dct:description "scale-free shape statistic; the plate is not a 64 µm micrograph" ;
        schema:measurementTechnique "std/mean of segmented colony areas; reference is the simulated spot-area CV" ;
        schema:name "specimen colony area CV" ;
        schema:unitText "CV" ;
        schema:value "1.6418" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-specimen-colony-area-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-specimen-colony-area-cv-reference> a schema:PropertyValue ;

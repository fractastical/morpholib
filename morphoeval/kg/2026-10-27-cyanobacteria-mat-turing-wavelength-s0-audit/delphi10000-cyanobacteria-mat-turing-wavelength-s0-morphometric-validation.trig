    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-specimen-colony-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen colony count = 137 colonies" ;
        dct:description "specimen area fraction 0.14587959238401715; spot area fraction 0.2684461805555556" ;
        schema:measurementTechnique "high-pass threshold on the culture-plate photograph; reference is the simulated spot count" ;
        schema:name "specimen colony count" ;
        schema:unitText "colonies" ;
        schema:value "137" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-specimen-colony-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-measurement-specimen-colony-count-reference> a schema:PropertyValue ;

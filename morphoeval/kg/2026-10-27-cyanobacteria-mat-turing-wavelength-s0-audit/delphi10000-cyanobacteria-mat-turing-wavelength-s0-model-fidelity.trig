sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cyanobacteria mat Turing ocellus wavelength at 64.19 µm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1: the script integrates Schnakenberg kinetics with the Turing dispersion sigma(k), spectral diffusion, and an eigenvector probe of eleven exact Fourier modes. Slot parameters (a, b, Dv/Du) = (0.11, 0.83, 16) are not the Anabaena heterocyst set. The factor 1.08 on both diffusivities is an empirical finite-amplitude correction measured on this domain (scale 1.00 locks to mode 9 / 57 µm; 1.08 locks to mode 8 / 64.19 µm; 1.30 locks to mode 7). It is not a diffusivity reported for a cyanobacterial mat." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py L379–L422: rejected bin-mean estimator, kept as a negative control (r = 0.529) <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L379-L422>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py L14–L28" ;
        dct:description "PDE, steady state, and sigma(k) in the module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L14-L28> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py L122–L155" ;
        dct:description "Jacobian and sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L122-L155> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py L164–L208" ;
        dct:description "diffusivities, including finite-amplitude scale 1.08" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L164-L208> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3158_cyanobacteria_mat_turing_wavelength_s0.lean L15–L20" ;
        dct:description "Lean proof that the scaled trace is negative" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/morphoeval/lean/loops/Loop_3158_cyanobacteria_mat_turing_wavelength_s0.lean#L15-L20> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder and assessor, single-agent round)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/math-law/delphi10000-cyanobacteria-mat-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous Schnakenberg state is stable" ;
    dct:description "Stable homogeneous state, required before diffusion can destabilise a band | Variables: f_u ≈ 0.7660, g_v ≈ -0.8836, scaled by 10^4 in the proof" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L122-L141>,
        <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/morphoeval/lean/loops/Loop_3158_cyanobacteria_mat_turing_wavelength_s0.lean#L15-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v < 0 at (u_s, v_s) = (a+b, b/(a+b)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1001973107>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1472-4669.2010.00235.x>,
        <https://doi.org/10.1128/AEM.00819-08> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3158.law1_trace" ;
    pk:leanTheorem "MathOfBiology.Loop_3158.law1_homogeneous_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cyanobacteria-mat-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Eight wavelengths tile the periodic domain" ;
    dct:description "Domain quantization for the selected pigment-ocellus mode | Variables: n_waves = 8, lambda stored as 6419 hundredths of a micrometre" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L220-L236>,
        <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/morphoeval/lean/loops/Loop_3158_cyanobacteria_mat_turing_wavelength_s0.lean#L24-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L = 8 * lambda, lambda = 64.19 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1001973107>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1472-4669.2010.00235.x>,
        <https://doi.org/10.1128/AEM.00819-08> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3158.law2_domain" ;
    pk:leanTheorem "MathOfBiology.Loop_3158.law2_eight_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cyanobacteria-mat-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor diffuses faster than the activator" ;
    dct:description "Diffusion-driven instability condition for this slot | Variables: ratio 16, gap = ratio - 1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L164-L208>,
        <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/morphoeval/lean/loops/Loop_3158_cyanobacteria_mat_turing_wavelength_s0.lean#L34-L39> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v / D_u = 16 > 1; equal diffusion is the ablation" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1001973107>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1472-4669.2010.00235.x>,
        <https://doi.org/10.1128/AEM.00819-08> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3158.law3_ratio_gap" ;
    pk:leanTheorem "MathOfBiology.Loop_3158.law3_inhibitor_faster" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cyanobacteria-mat-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Selected wavenumber maximises the dispersion" ;
    dct:description "The other half of the homogeneous-stability conditions | Variables: det J > 0 together with tr J < 0" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L143-L155>,
        <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/morphoeval/lean/loops/Loop_3158_cyanobacteria_mat_turing_wavelength_s0.lean#L50-L52> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sigma(k) = 1/2 (tr(k) + sqrt(tr(k)^2 - 4 det(k))); k_star = argmax sigma" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1001973107>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1472-4669.2010.00235.x>,
        <https://doi.org/10.1128/AEM.00819-08> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3158.law5_determinant_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3158.law5_determinant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cyanobacteria-mat-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene node is not the Dresser Formation" ;
    dct:description "Rejects the Paleoarchean fossil photographs returned by the image scout | Variables: this chronoseries has one node at 0 Ma" ;
    dct:source "Petroff et al. 2010 DOI:10.1073/pnas.1001973107" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/models/2026-delphi10000-cyanobacteria-mat-turing-wavelength-s0.py#L30-L48>,
        <https://github.com/fractastical/morpholib/blob/8c1db788ac0382399c6119652ec88de045be6725/morphoeval/lean/loops/Loop_3158_cyanobacteria_mat_turing_wavelength_s0.lean#L43-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "age_Ma = 0 < 3480" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1001973107>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1472-4669.2010.00235.x>,
        <https://doi.org/10.1128/AEM.00819-08> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3158.law4_holocene_not_paleoarchean" ;
    pk:leanTheorem "MathOfBiology.Loop_3158.law4_holocene_not_paleoarchean" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,

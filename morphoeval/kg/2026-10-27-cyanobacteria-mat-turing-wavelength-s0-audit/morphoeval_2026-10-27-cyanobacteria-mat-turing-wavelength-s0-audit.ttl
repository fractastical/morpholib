<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Cyanobacteria mat Turing ocellus wavelength at 64.19 µm (Holocene, 0 Ma) — Code-to-model traceability: 85/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pass 1: the module docstring states the PDE, the dispersion, the chronoseries, and the claim boundary. Lean theorems mirror the trace sign, the eight-wavelength domain, the diffusion ratio 16, det J > 0, and Holocene versus the 3480 Ma Dresser photographs. There is no line-by-line map onto numbered equations of Turing 1952." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

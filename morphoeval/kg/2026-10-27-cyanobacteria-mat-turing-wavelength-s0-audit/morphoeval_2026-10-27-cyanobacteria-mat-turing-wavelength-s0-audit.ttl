    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Cyanobacteria mat Turing ocellus wavelength at 64.19 µm (Holocene, 0 Ma) — Reproducibility package: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pass 1: seed 3158, --self-test, and a non-interactive default render. Self-test checks the trace, the Turing inequality, the 64.19 µm shell, dispersion r > 0.98, RMSE < 0.05, ablation sigma_max < 0, and the specimen digest. Dependencies are the repository requirements.txt, not a per-script lock. One assessor scored this audit." ;

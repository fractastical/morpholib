<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cyanobacteria-mat-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Cyanobacteria mat Turing ocellus wavelength at 64.19 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pass 1: the GIF last frame scores cv_sim_similarity 90.7 against the culture-plate photograph (12 frames, 640x520). Beige colonies on a gold ground are the right pattern class for this plate. The photograph is a macroscopic plate, not a 64 µm field, and the agar illumination in the display transfer is not a biological field. KS = 0.453 on median-normalised diameters: the size distributions do not match, and that disagreement is left in the figure." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-planitibia-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg homogeneous Jacobian" ;
    dct:description "Necessary trace-diffusion condition for a 5.13 µm Turing band in D. planitibia | Variables: a = 0.10, b = 0.90, d = D_v/D_u = 18.6" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L95-L149>,
        <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/morphoeval/lean/loops/Loop_3199_drosophila_planitibia_turing_wavelength_s0.lean#L14-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b/u0^2, f_u = -1 + 2 u0 v0, g_v = -u0^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0960-9822(95)00229-6>,
        <https://doi.org/10.1038/hdy.1982.2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3199.traceDiffusion" ;
    pk:leanTheorem "MathOfBiology.Loop_3199.planitibia_diffusion_ratio_is_turing_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-planitibia-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength from the fastest-growing wavenumber" ;
    dct:description "What changes at 0 Ma versus D. persimilis and D. pseudoobscura is k_c, not geological age | Variables: lambda_c = 5130 nm; predecessor 117000 nm; successor 114000 nm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L155-L226>,
        <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/morphoeval/lean/loops/Loop_3199_drosophila_planitibia_turing_wavelength_s0.lean#L9-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_star, k_star = argmax Re sigma(k), sigma from det(J - k^2 D)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0960-9822(95)00229-6>,
        <https://doi.org/10.1038/hdy.1982.2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3199.lambdaDetailNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3199.detail_finer_than_persimilis" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-planitibia-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control for Turing wavenumber selection | Variables: control d = 1 versus nominal d = 18.6" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L229-L265>,
        <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/morphoeval/lean/loops/Loop_3199_drosophila_planitibia_turing_wavelength_s0.lean#L42-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "d = 1 implies d f_u + g_v < 0, so Re sigma(k) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0960-9822(95)00229-6>,
        <https://doi.org/10.1038/hdy.1982.2>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3199.traceDiffusion" ;
    pk:leanTheorem "MathOfBiology.Loop_3199.equal_diffusion_ablation_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


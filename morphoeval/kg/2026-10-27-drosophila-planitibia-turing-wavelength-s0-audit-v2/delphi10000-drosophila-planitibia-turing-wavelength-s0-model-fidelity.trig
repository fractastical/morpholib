sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila planitibia detail-tier Turing wavelength (5.13 µm, Holocene 0 Ma) — Model fidelity to source: 92/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 seeds modes 4–16, where the leading eigenvalue is real, on that eigenvector and fits the log-slope of the cosine projection. Pearson r = 0.99999993 against eig(J(k)) of the same 5-point Laplacian (RMSE 7.20e-05, 13 modes). Homogeneous state has trace < 0 and det > 0; nominal d = 18.6 is unstable and d = 1 is stable, matching the Lean trace-diffusion theorems. The score stays below 95 because the kinetics are generic Schnakenberg parameters placed at an assigned length, not a species-published parameter table." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py L123–L149" ;
        dct:description "Discrete and continuous dispersion symbols" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L123-L149> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py L155–L226" ;
        dct:description "Eigenvector-seeded linear PDE probe and Pearson fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L155-L226> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3199_drosophila_planitibia_turing_wavelength_s0.lean L22–L52" ;
        dct:description "Seven Lean theorems, 0 sorry: wavelength ordering, wavenumber ratios, Turing threshold, ablation, age delta 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/morphoeval/lean/loops/Loop_3199_drosophila_planitibia_turing_wavelength_s0.lean#L22-L52> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, loop 3199 pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


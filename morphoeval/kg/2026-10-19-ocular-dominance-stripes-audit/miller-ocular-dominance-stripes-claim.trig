        dct:title "A model for the formation of ocular dominance stripes" .
    <https://doi.org/10.1098/rstb.1977.0050> dct:date "1977"^^xsd:gYear ;
        dct:title "Plasticity of ocular dominance columns in monkey striate cortex" .

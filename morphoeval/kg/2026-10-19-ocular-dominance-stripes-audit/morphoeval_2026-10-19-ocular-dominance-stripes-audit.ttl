<https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Model fidelity to source: 58/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Evaluates only a simplified scalar field with uncoupled Mexican-hat filter on a 64x64 grid (L45-83), omitting explicit arbor kernel A(r) convolution, coupled S^L / S^R subtractive normalization conservation checks, and spectral ETD/semi-implicit integration." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "1989-miller-ocular-dominance-stripes.py L45–L83: Simplified scalar normal-only integration without arbor kernel A(r) or S_Sigma conservation <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L45-L83>" ;
    pk:hasScore 5.8e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Morphometric validation: 55/100" ;

<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-1>,
        <https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-2>,
        <https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-3> .

<https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Miller, Keller & Stryker (1989) Sum/Difference Synaptic Mode Decoupling & Subtractive Normalization Conservation Law" ;
    dct:description "Proves that subtractive homeostatic normalization identically conserves total cortical synaptic weight (dS_Sigma/dt = 0) while decoupling the ocular dominance difference mode S_Delta = S_L - S_R so that positive difference correlation C_Delta = C_LL - C_LR > 0 strictly amplifies eye-specific segregation | Variables: S_L, S_R: left-eye and right-eye geniculocortical synaptic densities in V1 Layer IVC; S_Sigma = S_L + S_R: conserved total synaptic density; S_Delta = S_L - S_R: ocular dominance difference mode; C_LL, C_LR: within-eye and between-eye LGN activity correlations; C_Delta = C_LL - C_LR: difference correlation" ;
    dct:source "Miller, Keller & Stryker (1989) Science 245(4918):605-615 Eqs. 1-6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L84-L165>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_087_ocular_dominance_stripes.lean#L19-L66> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def raw_rate_L (S_L S_R C_LL C_LR : Int) : Int :=
  C_LL * S_L + C_LR * S_R
def raw_rate_R (S_L S_R C_LL C_LR : Int) : Int :=
  C_LR * S_L + C_LL * S_R
def norm_rate_2L (S_L S_R C_LL C_LR : Int) : Int :=
  2 * raw_rate_L S_L S_R C_LL C_LR - (raw_rate_L S_L S_R C_LL C_LR + raw_rate_R S_L S_R C_LL C_LR)
def norm_rate_2R (S_L S_R C_LL C_LR : Int) : Int :=
  2 * raw_rate_R S_L S_R C_LL C_LR - (raw_rate_L S_L S_R C_LL C_LR + raw_rate_R S_L S_R C_LL C_LR)
def sum_mode_rate_2 (S_L S_R C_LL C_LR : Int) : Int :=
  norm_rate_2L S_L S_R C_LL C_LR + norm_rate_2R S_L S_R C_LL C_LR
def diff_mode_rate (C_Delta S_Delta : Int) : Int :=
  C_Delta * S_Delta
theorem miller_sum_difference_decoupling (S_L S_R C_LL C_LR C_Delta S_Delta : Int)
    (h_cd : C_Delta > 0) (h_sd : S_Delta > 0) :
    sum_mode_rate_2 S_L S_R C_LL C_LR = 0 ∧
    norm_rate_2L 10 4 8 2 = 36 ∧
    norm_rate_2R 10 4 8 2 = -36 ∧
    norm_rate_2L 10 4 8 2 - norm_rate_2R 10 4 8 2 = 2 * (8 - 2) * (10 - 4) ∧
    diff_mode_rate C_Delta S_Delta > 0 := by
  refine ⟨?_, by decide, by decide, by decide, ?_⟩
  · dsimp [sum_mode_rate_2, norm_rate_2L, norm_rate_2R]
    omega
  · dsimp [diff_mode_rate]
    exact Int.mul_pos h_cd h_sd
"""^^pk:lean4 ;
    skos:notation "dS_Sigma/dt = d(S^L + S^R)/dt = 0;   dS_Delta/dt = (A * I * (C^{LL} - C^{LR})) * S_Delta - gamma * S_Delta" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
        <https://doi.org/10.1098/rstb.1977.0050>,
        <https://doi.org/10.1126/science.2762813>,
        <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Correlation-Based Hebbian Ocular Dominance Columns & Critical-Period Plasticity" ;
    pk:leanDeclaration "MathOfBiology.Loop_087.sum_mode_rate_2" ;
    pk:leanTheorem "MathOfBiology.Loop_087.miller_sum_difference_decoupling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Swindale (1980) & Miller, Keller & Stryker (1989) Mexican-Hat Band-Pass Peak Wavenumber & Characteristic Column Wavelength Law" ;
    dct:description "Proves positivity of the Mexican-hat Fourier band-pass denominator sigma_I^2 - sigma_E^2 > 0 and inhibitory moment ratio kappa_I * sigma_I^2 / sigma_E^2 = 3 > 1, selecting the characteristic macaque V1 Layer IVC stripe wavelength lambda_c ~ 800 um (400 um per single-eye column) | Variables: sigma_E, sigma_I: intracortical excitatory and inhibitory lateral interaction ranges (109 um, 218 um); kappa_I: relative inhibitory amplitude (0.75); k_c: fastest-growing Fourier wavenumber; lambda_c = 2 * w_col: full-cycle ocular dominance band wavelength (800 um for 400 um single-eye column width)" ;
    dct:source "Miller, Keller & Stryker (1989) Science 245:605-615; Swindale (1980) Proc. R. Soc. B 208:243-264; Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278:377-409" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L112-L195>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_087_ocular_dominance_stripes.lean#L69-L108> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def mexican_hat_denom (sigma_E_sq sigma_I_sq : Int) : Int :=
  sigma_I_sq - sigma_E_sq
def full_cycle_wavelength (w_col : Int) : Int :=
  2 * w_col
theorem swindale_miller_bandpass_wavelength (sigma_E_sq sigma_I_sq w_1 w_2 : Int)
    (h_range : sigma_E_sq < sigma_I_sq) (h_w : w_1 < w_2) :
    mexican_hat_denom sigma_E_sq sigma_I_sq > 0 ∧
    mexican_hat_denom (109 * 109) (218 * 218) = 35643 ∧
    (3 * (218 * 218)) / (4 * (109 * 109)) = 3 ∧
    full_cycle_wavelength 400 = 800 ∧
    full_cycle_wavelength w_1 < full_cycle_wavelength w_2 := by
  refine ⟨?_, by decide, by decide, by decide, ?_⟩
  · dsimp [mexican_hat_denom]
    omega
  · dsimp [full_cycle_wavelength]
    omega
"""^^pk:lean4 ;
    skos:notation "k_c^2 = 2 * ln(kappa_I * sigma_I^2 / sigma_E^2) / (sigma_I^2 - sigma_E^2) > 0;   lambda_c = 2 * pi / k_c = 2 * w_col approx 800 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
        <https://doi.org/10.1098/rstb.1977.0050>,
        <https://doi.org/10.1126/science.2762813>,
        <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Correlation-Based Hebbian Ocular Dominance Columns & Critical-Period Plasticity" ;
    pk:leanDeclaration "MathOfBiology.Loop_087.mexican_hat_denom" ;
    pk:leanTheorem "MathOfBiology.Loop_087.swindale_miller_bandpass_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hubel, Wiesel & LeVay (1977) Monocular Deprivation Territory Shift vs Stryker & Harris (1986) Bilateral TTX Blockade Law" ;
    dct:description "Proves that critical-period monocular deprivation shifts cortical territory away from 50/50 symmetry (shrinking deprived-eye stripes to 24% and expanding open-eye columns to 76% while conserving total area 100%), whereas bilateral TTX blockade (C_Delta = 0) makes omega(k) = -gamma < 0 for all wavenumbers and prevents column segregation | Variables: delta_md > 0: monocular deprivation competitive shift (percentage points); deprived_eye_pct, open_eye_pct: Layer IVC cortical territory percentages occupied by deprived and open eyes; dispersion_omega(C_Delta, AK_hat, gamma): Fourier growth rate under bilateral TTX blockade (C_Delta = 0)" ;
    dct:source "Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278(961):377-409; Stryker & Harris (1986) J. Neurosci. 6(8):2117-2133" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L198-L345>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_087_ocular_dominance_stripes.lean#L111-L157> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def deprived_eye_pct (delta_md : Int) : Int :=
  50 - delta_md
def open_eye_pct (delta_md : Int) : Int :=
  50 + delta_md
def dispersion_omega (C_Delta AK_hat gamma : Int) : Int :=
  C_Delta * AK_hat - gamma
theorem hubel_wiesel_md_and_ttx_blockade (delta_md AK_hat gamma : Int)
    (h_md : delta_md > 0) (h_gamma : gamma > 0) :
    deprived_eye_pct 0 = 50 ∧
    open_eye_pct 0 = 50 ∧
    deprived_eye_pct delta_md < 50 ∧
    open_eye_pct delta_md > 50 ∧
    open_eye_pct delta_md - deprived_eye_pct delta_md = 2 * delta_md ∧
    deprived_eye_pct delta_md + open_eye_pct delta_md = 100 ∧
    deprived_eye_pct 26 = 24 ∧
    open_eye_pct 26 = 76 ∧
    dispersion_omega 0 AK_hat gamma < 0 := by
  refine ⟨by decide, by decide, ?_, ?_, ?_, ?_, by decide, by decide, ?_⟩
  · dsimp [deprived_eye_pct]
    omega
  · dsimp [open_eye_pct]
    omega
  · dsimp [open_eye_pct, deprived_eye_pct]
    omega
  · dsimp [deprived_eye_pct, open_eye_pct]
    omega
  · dsimp [dispersion_omega]
    omega
"""^^pk:lean4 ;
    skos:notation "f_L(Delta_MD) = 0.5 - Delta_MD < 0.5 < f_R(Delta_MD) = 0.5 + Delta_MD, f_L + f_R = 1;   C_Delta = 0 ==> omega(k) = -gamma < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
        <https://doi.org/10.1098/rstb.1977.0050>,
        <https://doi.org/10.1126/science.2762813>,
        <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Correlation-Based Hebbian Ocular Dominance Columns & Critical-Period Plasticity" ;
    pk:leanDeclaration "MathOfBiology.Loop_087.deprived_eye_pct" ;
    pk:leanTheorem "MathOfBiology.Loop_087.hubel_wiesel_md_and_ttx_blockade" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


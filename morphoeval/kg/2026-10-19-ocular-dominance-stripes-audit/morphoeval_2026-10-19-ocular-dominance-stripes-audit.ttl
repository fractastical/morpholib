<https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> a pk:Claim ;
    rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity (Macaca mulatta / Felis catus primary visual cortex (V1 Layer IVC))",
        "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity faithfully reproduces Macaca mulatta / Felis catus primary visual cortex (V1 Layer IVC) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-1>,
        <https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-2>,
        <https://w3id.org/probknow/resource/math-law/miller-ocular-dominance-stripes-3> ;
    dct:description "The simulation script(s) 1989-miller-ocular-dominance-stripes.py implement the cited source model as published and produce forms that match real Macaca mulatta / Felis catus primary visual cortex (V1 Layer IVC) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 56.5/100, audit 2026-10-19-ocular-dominance-stripes-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py> ;
    schema:about "Macaca mulatta / Felis catus primary visual cortex (V1 Layer IVC)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py; output: docs/media/ocular_dominance_stripes_comparison.png; organism: Macaca mulatta / Felis catus primary visual cortex (V1 Layer IVC); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 819128bbec5b994d73c8b186f4a86b2d2df6149663f61bdaf866cb36447d290f; artifact_sha256: 5c86c681629586dc6f28f301d814b7541f9719259d8a6eeea068330b1e609bf0; input_dataset_sha256: {datasets/ocular_dominance_stripes/macaque_striate_cortex_specimen.jpg=fe74eb6f9db7dea1..., datasets/ocular_dominance_stripes/ocular_dominance_stripes_reference.json=7041693bc0b54b31..., datasets/ocular_dominance_stripes/odc_tangential_pattern_specimen.png=fac59bb151b4eb1d..., datasets/ocular_dominance_stripes/paper_citations.bib=29c3ea74bae42954..., datasets/ocular_dominance_stripes/scout_manifest.json=2f54657c6b0c2050...}" ;

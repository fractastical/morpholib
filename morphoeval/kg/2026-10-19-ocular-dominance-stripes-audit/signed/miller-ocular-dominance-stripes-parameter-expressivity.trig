sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Parameter expressivity: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates only 1 regime (Normal Binocular rearing), omitting Hubel-Wiesel Monocular Deprivation (MD), Strabismus decorrelated broadened stripes, Stryker-Harris TTX bilateral impulse blockade (C_Delta = 0), Reverse Suture critical-period rescue, and the intracortical inhibition range sigma_I wavelength sweep." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1989-miller-ocular-dominance-stripes.py L65–L76: Single normal binocular regime without MD, strabismus, TTX, or sigma_I sweep <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L65-L76>" ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


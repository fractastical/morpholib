sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-overall> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — MorphoEval overall 56.5/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Pass 1 baseline assessment of `1989-miller-ocular-dominance-stripes.py` (57.7/100). The baseline script evaluates the 1D Mexican-hat Fourier dispersion relation and a single 64x64 normal binocular stripe evolution, but omits explicit left/right synaptic density evolving fields S^L, S^R with Miller-Keller-Stryker arbor function A(r) and subtractive homeostatic normalization conserving S_Sigma = S^L + S^R, omits Hubel-Wiesel monocular deprivation shrinkage into isolated islands, Strabismus interocular decorrelation column broadening, Stryker-Harris TTX bilateral impulse blockade, and intracortical inhibition range sigma_I wavelength scaling, and displays the tangential ODC and macaque V1 Layer IVC specimens without automated CV segmentation. Overall 56.5/100 (faithfulness 53.9, reproducibility 62.4); rubric morphoeval 0.1.0; checkpoint commit 317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 58, Morphological realism / specimen match 50, Parameter expressivity 54, Morphometric validation 55, Source and data traceability 66, Code-to-model traceability 60, Reproducibility package 61. Output judged: docs/media/ocular_dominance_stripes_comparison.png: rendered output of 1989-miller-ocular-dominance-stripes.py at 317bc3c, image/png, 1083402 B, 1320×1080 px, artifact_sha256 5c86c681629586dc6f28f301d814b7541f9719259d8a6eeea068330b1e609bf0 (sha256 5c86c681629586dc6f28f301d814b7541f9719259d8a6eeea068330b1e609bf0), spec_fingerprint 819128bbec5b994d73c8b186f4a86b2d2df6149663f61bdaf866cb36447d290f. Dual provenance: spec_fingerprint: 819128bbec5b994d73c8b186f4a86b2d2df6149663f61bdaf866cb36447d290f; artifact_sha256: 5c86c681629586dc6f28f301d814b7541f9719259d8a6eeea068330b1e609bf0; input_dataset_sha256: {datasets/ocular_dominance_stripes/macaque_striate_cortex_specimen.jpg=fe74eb6f9db7dea1..., datasets/ocular_dominance_stripes/ocular_dominance_stripes_reference.json=7041693bc0b54b31..., datasets/ocular_dominance_stripes/odc_tangential_pattern_specimen.png=fac59bb151b4eb1d..., datasets/ocular_dominance_stripes/paper_citations.bib=29c3ea74bae42954..., datasets/ocular_dominance_stripes/scout_manifest.json=2f54657c6b0c2050...}." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add automated CV segmentation of stripe wavelength, area fraction, and skeleton branchpoints on `odc_tangential_pattern_specimen.png` and V1 Layer IVC laminar optical density profiling on `macaque_striate_cortex_specimen.jpg`, and render a 9-panel dark-mode comparison figure and 24-frame animated GIF.",
            "remediation needed: Implement the full 2D spectral Miller-Keller-Stryker / Swindale integro-differential solver with explicit geniculocortical arbor function A(r), Mexican-hat intracortical interaction I(r), and coupled S^L, S^R subtractive homeostatic normalization conserving S_Sigma = S^L + S^R.",
            "remediation needed: Simulate all 5 canonical experimental regimes (Normal Binocular 50/50 zebra stripes, Hubel-Wiesel Monocular Deprivation shrunken islands, Strabismus broadened sharp columns, Stryker-Harris TTX bilateral silencing unsegregated control, and Reverse Suture critical-period rescue) plus a 6-point intracortical inhibition range sigma_I wavelength sweep." ;
        pk:hasScore "0.565"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rspb.1980.0051>,
            <https://doi.org/10.1098/rstb.1977.0050>,
            <https://doi.org/10.1126/science.2762813>,
            <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> .

    <https://doi.org/10.1098/rspb.1980.0051> dcterms:date "1980"^^xsd:gYear ;
        dcterms:title "A model for the formation of ocular dominance stripes" .

    <https://doi.org/10.1098/rstb.1977.0050> dcterms:date "1977"^^xsd:gYear ;
        dcterms:title "Plasticity of ocular dominance columns in monkey striate cortex" .

    <https://doi.org/10.1126/science.2762813> dcterms:date "1989"^^xsd:gYear ;
        dcterms:title "Ocular dominance column development: analysis and simulation" .

    <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> dcterms:date "1986"^^xsd:gYear ;
        dcterms:title "Binocular impulse blockade prevents the formation of ocular dominance columns in cat visual cortex" .

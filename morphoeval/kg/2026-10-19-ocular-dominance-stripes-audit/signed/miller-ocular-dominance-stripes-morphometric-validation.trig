}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Morphometric validation: 55/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports only 2 baseline metrics in `measure_morphoeval()`, lacking empirical 2D FFT wavelength validation, monocular deprivation deprived-eye shrinkage fraction (f_L ~ 0.24), TTX blockade segregation suppression, inhibition range wavelength scaling r, and specimen CV stripe/branchpoint/laminar morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1989-miller-ocular-dominance-stripes.py L124–L149: Baseline 2-metric measure_morphoeval() hook <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L124-L149>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-analytical-mexican-hat-characteristic-ocular-dominance-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-left-eye-cortical-territory-fraction-f-l> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-analytical-mexican-hat-characteristic-ocular-dominance-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Analytical Mexican-hat characteristic ocular dominance wavelength lambda_c = 800.26 um" ;
        dcterms:description "k_c = 0.007851 um^-1, lambda_c = 800.26 um" ;
        schema:measurementTechnique "Analytical band-pass peak wavelength 2*pi / k_c from Mexican-hat lateral interaction" ;
        schema:name "Analytical Mexican-hat characteristic ocular dominance wavelength lambda_c" ;
        schema:unitText "um" ;
        schema:value "800.26" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-analytical-mexican-hat-characteristic-ocular-dominance-wavelength-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-analytical-mexican-hat-characteristic-ocular-dominance-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dcterms:source "Miller, Keller & Stryker (1989) Science 245:605-615; Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278:377-409" ;
        schema:value "800.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-left-eye-cortical-territory-fraction-f-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Normal binocular left-eye cortical territory fraction f_L = 0.4939 area fraction" ;
        dcterms:description "Baseline f_L = 0.4939" ;
        schema:measurementTechnique "Fraction of V1 Layer IVC grid cells with S_Delta(x) > 0 under normal binocular rearing" ;
        schema:name "Normal binocular left-eye cortical territory fraction f_L" ;
        schema:unitText "area fraction" ;
        schema:value "0.4939" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-left-eye-cortical-territory-fraction-f-l-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-measurement-normal-binocular-left-eye-cortical-territory-fraction-f-l-reference> a schema:PropertyValue ;
        dcterms:source "Hubel, Wiesel & LeVay (1977) Phil. Trans. R. Soc. B 278:377-409" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


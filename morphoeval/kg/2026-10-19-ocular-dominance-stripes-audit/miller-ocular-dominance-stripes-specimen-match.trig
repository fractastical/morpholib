sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-miller-ocular-dominance-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-miller-ocular-dominance-stripes-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Miller, Keller & Stryker (1989) & Hubel, Wiesel & LeVay (1977) ocular dominance column development & plasticity — Morphological realism / specimen match: 50/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors `odc_tangential_pattern_specimen.png` (CC BY-SA 3.0) and `macaque_striate_cortex_specimen.jpg` (CC0 BrainMaps.org Macaca mulatta V1 section), but Pass 1 displays only raw images without automated CV segmentation of stripe wavelength, skeleton branchpoints, or V1 Layer IVC laminar profile." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1989-miller-ocular-dominance-stripes.py L88–L108: Raw specimen display without CV segmentation of stripe wavelength, branchpoints, or Layer IVC band <https://github.com/fractastical/morpholib/blob/317bc3c/1989-miller-ocular-dominance-stripes.py#L88-L108>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-specimen-match-1> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-miller-ocular-dominance-stripes-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/ocular_dominance_stripes_comparison.png (generated output)" ;
        dct:description "4-panel Pass 1 baseline comparison figure — docs/media/ocular_dominance_stripes_comparison.png: rendered output of 1989-miller-ocular-dominance-stripes.py at 317bc3c, image/png, 1083402 B, 1320×1080 px, artifact_sha256 5c86c681629586dc6f28f301d814b7541f9719259d8a6eeea068330b1e609bf0 (sha256 5c86c681629586dc6f28f301d814b7541f9719259d8a6eeea068330b1e609bf0), spec_fingerprint 819128bbec5b994d73c8b186f4a86b2d2df6149663f61bdaf866cb36447d290f" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://doi.org/10.1126/science.2762813>,
            <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> .
    <https://doi.org/10.1098/rspb.1980.0051> dct:date "1980"^^xsd:gYear ;
        dct:title "A model for the formation of ocular dominance stripes" .
    <https://doi.org/10.1098/rstb.1977.0050> dct:date "1977"^^xsd:gYear ;
        dct:title "Plasticity of ocular dominance columns in monkey striate cortex" .
    <https://doi.org/10.1126/science.2762813> dct:date "1989"^^xsd:gYear ;
        dct:title "Ocular dominance column development: analysis and simulation" .
    <https://doi.org/10.1523/JNEUROSCI.06-08-02117.1986> dct:date "1986"^^xsd:gYear ;
        dct:title "Binocular impulse blockade prevents the formation of ocular dominance columns in cat visual cortex" .
}


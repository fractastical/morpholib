<https://w3id.org/delphi/resource/math-law/delphi10000-columba-livia-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg critical wavenumber" ;
    dct:description "Selects the 256 um pigment wavelength on the Holocene rock-dove vane patch | Variables: f_u, f_v, g_u, g_v, Du, Dv, q = k^2" ;
    dct:source "Schnakenberg (1979) doi:10.1016/0022-5193(79)90042-0; Turing (1952) doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-columba-livia-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3151_columba_livia_turing_wavelength_s0.lean#L40-L56> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = gamma * (Dv * f_u + Du * g_v) / (2 * Du * Dv)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.7554/eLife.34803> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3151.kc_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3151.loop3151_uniform_stable_and_critical_mode_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-columba-livia-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control. No 256 um repeat when the inhibitor is not the long-range species | Variables: Du, Dv, q" ;
    dct:source "Turing (1952) doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-columba-livia-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3151_columba_livia_turing_wavelength_s0.lean#L58-L66> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) > 0 when Dv = Du" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.7554/eLife.34803> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3151.rd_det" ;
    pk:leanTheorem "MathOfBiology.Loop_3151.loop3151_equal_diffusion_ablation_has_positive_determinant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-columba-livia-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Four wavelengths on the 1024 um domain" ;
    dct:description "Integer mode n = 4 is the only unstable wavenumber at Dv/Du = 10 | Variables: grid_n, length_unit_um, lambda_c_um" ;
    dct:source "Prum & Williamson (2002) doi:10.1098/rspb.2001.1896" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-columba-livia-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3151_columba_livia_turing_wavelength_s0.lean#L68-L76> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N * dx / lambda_c = 64 * 16 / 256 = 4" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.7554/eLife.34803> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3151.lambda_um" ;
    pk:leanTheorem "MathOfBiology.Loop_3151.loop3151_domain_holds_four_critical_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-columba-livia-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene scale succession at 0 Ma" ;
    dct:description "Chronoseries 1/1 has no other species. The neighbouring change is the scale filter around k_c | Variables: age_Ma, chronoseries_index, lambda_um" ;
    dct:source "Vickrey et al. (2018) doi:10.7554/eLife.34803; Haupaix et al. (2018) doi:10.1126/science.aar4777" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-columba-livia-turing-wavelength-s0.py>,

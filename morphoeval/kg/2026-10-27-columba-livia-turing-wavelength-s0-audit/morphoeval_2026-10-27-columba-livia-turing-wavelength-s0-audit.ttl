    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Columba livia Turing wavelength at 256 um (Holocene, chronoseries 1/1) — Source and data traceability: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Six Crossref-checked DOIs are vendored in paper_citations.bib and the reference JSON. The specimen is Alan D. Wilson's CC BY-SA 2.5 file, SHA-256 74dfe533e6b396ac7c607cf39ec48ce3b867de1c26b527b027f86f0b61dc357e. The first broad OpenAlex query returned no works; the DOIs were resolved by follow-up title queries. The gallery JPEG labeled Columba livia is a synthetic spiral and was not used." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-source-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-source-traceability-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-source-traceability-3> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-columba-livia-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Columba livia Turing wavelength at 256 um (Holocene, chronoseries 1/1) — Morphological realism / specimen match: 66/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The comparison figure shows the Alan D. Wilson flight photograph and a melanin registration, and the script segments that file. The fitness test reads the GIF, which pass 1 rendered unfitted: 12 frames at 640x480, CV similarity 57.8, below the 58 gate. Image fitness is therefore suppressed (63.0). The photograph is a real rock dove with the two wing bars; it is not a micrometre micrograph." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation — Morphometric validation: 55/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L214-239) returns only 3 baseline metrics (lambda_c, wild-type P2 fraction, and wild-type joint count) without evaluating the 12-taxon Kavanagh et al. (2013) Inhibitory Cascade regression (Pearson r, p-value, RMSE), perturbation joint counts, or computer-vision segmentation of P1, P2, P3 and MCP/PIP/DIP synovial joint clefts on the radiograph specimen." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2016-onuff-joint-interzone-clefting.py L214–L239: Only 3 baseline metrics returned in measure_morphoeval() without cross-clade or specimen CV metrics <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L214-L239>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-gdf5-noggin-critical-turing-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-wild-type-middle-phalanx-proportion-p2-p1-p2-p3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-wild-type-synovial-joint-cleft-count-mcp-pip-dip> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-gdf5-noggin-critical-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "GDF5-Noggin critical Turing wavelength lambda_c = 3.5904 dimensionless length" ;
        schema:measurementTechnique "Peak of 2x2 GDF5-Noggin Turing dispersion relation Re(sigma(q))" ;
        schema:name "GDF5-Noggin critical Turing wavelength lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "3.5904" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-gdf5-noggin-critical-turing-wavelength-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-gdf5-noggin-critical-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Hiscock et al. (2017) Dev. Cell 41:459-465" ;
        schema:value "4.2169" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-wild-type-middle-phalanx-proportion-p2-p1-p2-p3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type middle phalanx proportion P2 / (P1 + P2 + P3) = 0.3333 dimensionless ratio" ;
        schema:measurementTechnique "1D joint interzone segmentation middle phalanx fraction" ;
        schema:name "Wild-type middle phalanx proportion P2 / (P1 + P2 + P3)" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.3333" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-wild-type-middle-phalanx-proportion-p2-p1-p2-p3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-wild-type-middle-phalanx-proportion-p2-p1-p2-p3-reference> a schema:PropertyValue ;
        dct:source "Kavanagh et al. (2013) PNAS 110:18190-18195 (exact 1/3 invariant)" ;
        schema:value "0.3333" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-wild-type-synovial-joint-cleft-count-mcp-pip-dip> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type synovial joint cleft count (MCP, PIP, DIP) = 3.0 joints" ;
        schema:measurementTechnique "Gdf5+ interzone peak count along wild-type digit ray" ;
        schema:name "Wild-type synovial joint cleft count (MCP, PIP, DIP)" ;
        schema:unitText "joints" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-wild-type-synovial-joint-cleft-count-mcp-pip-dip-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-wild-type-synovial-joint-cleft-count-mcp-pip-dip-reference> a schema:PropertyValue ;
        dct:source "Hartmann & Tabin (2001) Cell 104:341-351" ;
        schema:value "3.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 018 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> a pk:Claim ;
    rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation (Gallus gallus / Mus musculus tetrapod autopod digits & synovial joint interzones)",
        "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation faithfully reproduces Gallus gallus / Mus musculus tetrapod autopod digits & synovial joint interzones morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-1>,
        <https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-2>,
        <https://w3id.org/probknow/resource/math-law/onuff-joint-interzone-clefting-3> ;
    dct:description "The simulation script(s) 2016-onuff-joint-interzone-clefting.py implement the cited source model as published and produce forms that match real Gallus gallus / Mus musculus tetrapod autopod digits & synovial joint interzones specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.4/100, audit 2026-10-19-joint-interzone-clefting-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py> ;
    schema:about "Gallus gallus / Mus musculus tetrapod autopod digits & synovial joint interzones" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py; output: docs/media/joint_interzone_clefting_comparison.png; organism: Gallus gallus / Mus musculus tetrapod autopod digits & synovial joint interzones; checkpoint commit: https://github.com/fractastical/morpholib/commit/45d4150; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 56e3e114fc02325ea6b391f130fabc0038842bfdf81e75272cec62c77030adae; artifact_sha256: 15ba94051c8a36f0c3c01d6d4a2dbafc88a708722e10040af439ebb53c466be0; input_dataset_sha256: {datasets/joint_interzone_clefting/joint_interzone_clefting_reference.json=9acd7913813a1a7b..., datasets/joint_interzone_clefting/paper_citations.bib=4d966fca533780af..., datasets/joint_interzone_clefting/scout_manifest.json=1ae24e293d2062b2..., datasets/joint_interzone_clefting/tetrapod_digit_interzone_specimen.jpg=995e43a2a0cf7815...}" ;
    pk:derivedFromPaper <https://doi.org/10.1016/S0092-8674(01)00222-7>,
        <https://doi.org/10.1016/j.devcel.2017.04.021>,
        <https://doi.org/10.1038/368639a0>,
        <https://doi.org/10.1073/pnas.1315213110>,
        <https://doi.org/10.1126/science.280.5368.1455> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-model-fidelity>,

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation — Parameter expressivity: 48/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates only the single wild-type triphalangeal condition (L79-119) without simulating the 6 genetic/signaling perturbation regimes (`Nog-/-` joint fusion, `Gdf5 bp/bp` brachypodism PIP fusion, `Wnt9a` ectopic supernumerary clefting, sustained PFR-FGF equal-length phalanges, and `D=0` ablation control) or the 12-taxon cross-clade regression, and exposes no CLI parameter overrides (L248-262)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2016-onuff-joint-interzone-clefting.py L248–L262: CLI exposes only --self-test and --skip-gif without Noggin/Gdf5/taper parameter overrides <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L248-L262>" ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 018 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


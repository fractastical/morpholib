sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes the 2x2 GDF5-Noggin Turing dispersion relation (L36-62) and analytical Kavanagh et al. (2013) Inhibitory Cascade trajectory (L65-76), backed by 3 Lean 4 theorems in `Loop_018_joint_interzone_clefting.lean`. However, `simulate_1d_joint_clefting` (L79-119) uses an analytical Gaussian profile rather than integrating a growing-domain 1D/2D BMP-GDF5-Noggin reaction-diffusion PDE with distal PFR-FGF gradient modulation and zero-diffusion (D_G = D_N = 0) ablation control." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2016-onuff-joint-interzone-clefting.py L79–L119: Uses analytical Gaussian profile instead of growing-domain 1D/2D reaction-diffusion PDE and omits D=0 control <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L79-L119>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L36–L76" ;
        dcterms:description "GDF5-Noggin Turing dispersion relation and Kavanagh (2013) Inhibitory Cascade equations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/45d4150/2016-onuff-joint-interzone-clefting.py#L36-L76> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 018 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


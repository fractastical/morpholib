<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Dickinsonia costata cellular Turing wavelength, 56 µm, White Sea 558 Ma (Pass 2) — Code-to-model traceability: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion, sweep, ablation, specimen segmentation, and render are separate functions. Lean states the 39-pitch septal count and the 1521 diffusivity factor. The Lean proofs are integer identities, not a real-analysis formalization of sigma(k)." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Dickinsonia costata cellular Turing wavelength, 56 µm, White Sea 558 Ma (Pass 2) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script implements Schnakenberg kinetics and the Turing dispersion formula, integrates them spectrally, and shows the equal-diffusion control dies. The nonlinear peak is 3.7% above k_m; that shift is reported rather than tuned away. The 56 µm figure is a length-unit anchor, not an extra fitted parameter inside the PDE." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;

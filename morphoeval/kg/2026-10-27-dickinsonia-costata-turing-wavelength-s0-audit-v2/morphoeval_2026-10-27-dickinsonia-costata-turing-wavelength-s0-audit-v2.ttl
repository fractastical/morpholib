<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-dickinsonia-costata-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dickinsonia-costata-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dickinsonia-costata-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-dickinsonia-costata-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Sign condition on the diffusivity product inside the dispersion polynomial | Variables: du, dv positive diffusivities at the 56 µm cellular pitch" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dickinsonia-costata-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3167_dickinsonia_costata_turing_wavelength_s0.lean#L10-L16> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = Du Dv k^4 - (Dv f_u + Du g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/pab.2021.31>,
        <https://doi.org/10.1098/rspb.2017.1348>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aat7228>,
        <https://doi.org/10.1371/journal.pone.0176874> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3167.law1_invariant" ;
    pk:leanTheorem "MathOfBiology.Loop_3167.law1_positive_scaling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dickinsonia-costata-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength cancellation" ;
    dct:description "The onset wavelength is fixed by k_c alone | Variables: lam the critical wavelength; kExtra an auxiliary offset that cancels" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dickinsonia-costata-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3167_dickinsonia_costata_turing_wavelength_s0.lean#L18-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c with k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/pab.2021.31>,
        <https://doi.org/10.1098/rspb.2017.1348>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aat7228>,
        <https://doi.org/10.1371/journal.pone.0176874> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3167.law2_balance" ;
    pk:leanTheorem "MathOfBiology.Loop_3167.law2_exact_cancellation" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dickinsonia-costata-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Septal mode count at 56 µm versus the 2200 µm organ module" ;
    dct:description "Scale separation between this cellular tier and the organ-tier sibling at 558 Ma | Variables: cellularPitchUm = 56; organModuleUm = 2200; whiteSeaAgeMa = 558" ;
    dct:source "Evans 2017 DOI:10.1371/journal.pone.0176874" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dickinsonia-costata-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3167_dickinsonia_costata_turing_wavelength_s0.lean#L26-L44> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(2200 / 56) = 39; D scales by N^2 = 1521 at fixed reaction time" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/pab.2021.31>,
        <https://doi.org/10.1098/rspb.2017.1348>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aat7228>,
        <https://doi.org/10.1371/journal.pone.0176874> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3167.stripesPerSeptum" ;
    pk:leanTheorem "MathOfBiology.Loop_3167.septum_holds_39_cellular_wavelengths" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Dickinsonia costata cellular Turing wavelength, 56 µm, White Sea 558 Ma (Pass 2) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.999999999886 against a null of 0, RMSE 0.061 µm against a 10 µm tolerance, KS 0.125 against 0.5, and four specimen-image metrics (aspect 1.8 vs 1, circularity 0.882 vs 1, coherency 0.561 vs 0, ridge fraction 0.0185 vs 5.6e-4). The ellipse search stopped on the boundary of its box (aspect 1.8, area fraction 0.60), so the outline is a constrained fit, not a traced contour." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-ablation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-geological-age-ma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-k-meas-over-k-linear-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-selected-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-ellipse-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-ridge-spacing-over-body-length>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-wavelength-scaling-rmse-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-wavenumber-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-ablation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_std_ratio = 4215.453582 1" ;
        dct:description "equal-diffusion std falls to roundoff; the denominator is floored at 1e-4" ;
        schema:measurementTechnique "std(u) of the Turing run divided by max(std(u)_control, 1e-4) on the same grid" ;
        schema:name "ablation_std_ratio" ;
        schema:unitText "1" ;
        schema:value "4215.453582" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-ablation-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-ablation-std-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.999999999886 1" ;
        dct:description "RMSE of the scaling law is reported separately" ;
        schema:measurementTechnique "Pearson r between measured spectral peaks and linear fastest wavenumbers across the diffusivity sweep" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.999999999886" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-geological-age-ma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "geological_age_ma = 558.0 Ma" ;
        dct:description "558 != 635, so the age comparison is not self-referential" ;
        schema:measurementTechnique "White Sea Dickinsonia horizon used by Bobrovskiy et al. 2018" ;
        schema:name "geological_age_ma" ;
        schema:unitText "Ma" ;
        schema:value "558.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-geological-age-ma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-geological-age-ma-reference> a schema:PropertyValue ;
        schema:value "635.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-k-meas-over-k-linear-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "k_meas_over_k_linear_cv = 6e-06 1" ;
        schema:measurementTechnique "Coefficient of variation of k_measured/k_linear across the sweep" ;
        schema:name "k_meas_over_k_linear_cv" ;
        schema:unitText "1" ;
        schema:value "6e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-k-meas-over-k-linear-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-k-meas-over-k-linear-cv-reference> a schema:PropertyValue ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-selected-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected_wavelength_um = 55.64 µm" ;
        dct:description "value is the cellular pitch; reference_value is the 2.2 mm module pitch and must differ" ;
        schema:measurementTechnique "Length unit anchored so the reference-run spectral peak equals the assigned cellular pitch" ;
        schema:name "selected_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "55.64" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-selected-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-selected-wavelength-um-reference> a schema:PropertyValue ;
        schema:value "2210.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.881816 1" ;
        schema:measurementTechnique "4*pi*area/perimeter^2 of the gradient-energy mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.881816" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-ellipse-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_ellipse_aspect_ratio = 1.8 1" ;
        dct:description "segmented on the real specimen image; value is not copied from the reference" ;
        schema:measurementTechnique "Gradient-energy ellipse on the CC BY 2.5 Dickinsonia costata photograph" ;
        schema:name "specimen_ellipse_aspect_ratio" ;
        schema:unitText "1" ;
        schema:value "1.8" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-ellipse-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-ellipse-aspect-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-ridge-spacing-over-body-length> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_ridge_spacing_over_body_length = 0.018519 1" ;
        dct:description "the specimen metric is the module repeat, not the 56 µm cellular pitch" ;
        schema:measurementTechnique "Autocorrelation lag of a minor-axis transect, divided by the ellipse major axis" ;
        schema:name "specimen_ridge_spacing_over_body_length" ;
        schema:unitText "1" ;
        schema:value "0.018519" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-ridge-spacing-over-body-length-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-ridge-spacing-over-body-length-reference> a schema:PropertyValue ;
        schema:value "0.0005564" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.561475 1" ;
        schema:measurementTechnique "Mean structure-tensor coherency inside the specimen ellipse" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.561475" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-wavelength-scaling-rmse-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_scaling_rmse_um = 0.060883 µm" ;
        schema:measurementTechnique "RMSE of measured lambda(s) against 56*sqrt(s) after anchoring s=1 at 56 µm" ;
        schema:name "wavelength_scaling_rmse_um" ;
        schema:unitText "µm" ;
        schema:value "0.060883" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-wavelength-scaling-rmse-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-wavelength-scaling-rmse-um-reference> a schema:PropertyValue ;
        schema:value "10.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-measurement-wavenumber-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;

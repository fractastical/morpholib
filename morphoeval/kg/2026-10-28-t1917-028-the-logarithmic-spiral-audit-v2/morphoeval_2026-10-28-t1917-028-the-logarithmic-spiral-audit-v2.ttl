        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-028-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-028-the-logarithmic-spiral-audit-v2-thompson1917-t1917-028-1>,

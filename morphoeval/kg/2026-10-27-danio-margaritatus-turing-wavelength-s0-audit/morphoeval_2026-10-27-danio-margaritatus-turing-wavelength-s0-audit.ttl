<https://w3id.org/delphi/resource/math-law/delphi10000-danio-margaritatus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing threshold separates margaritatus from albolineatus at 13.39 µm" ;
    dct:description "Predecessor is Turing-stable; focal species is Turing-unstable | Variables: diffusion ratio D_v/D_u at the cellular detail rung" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Nakamasu et al. 2009 DOI:10.1073/pnas.0808622106" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/23fb4b106f961ebb8b80abe7209257c902f834ad/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/23fb4b106f961ebb8b80abe7209257c902f834ad/morphoeval/lean/loops/Loop_3162_danio_margaritatus_turing_wavelength_s0.lean#L24-L27> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "delta_albo < delta_crit < delta_marg  (1.35 < 8.50 < 40)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/ncomms6299>,
        <https://doi.org/10.1038/s41467-018-05629-z>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.11646/zootaxa.1686.1.1>,
        <https://doi.org/10.1242/dev.01526> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3162.deltaMargX100" ;
    pk:leanTheorem "MathOfBiology.Loop_3162.margaritatus_unstable_albolineatus_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-danio-margaritatus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Successor wavelength is longer at the same age (0 Ma)" ;
    dct:description "Broken-stripe successor selects a longer cellular wave than the pearl ocellus | Variables: critical wavelengths of margaritatus and nigrofasciatus" ;
    dct:source "Quigley et al. 2004 DOI:10.1242/dev.01526; Spiewak et al. 2018 DOI:10.1371/journal.pgen.1007538" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/23fb4b106f961ebb8b80abe7209257c902f834ad/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/23fb4b106f961ebb8b80abe7209257c902f834ad/morphoeval/lean/loops/Loop_3162_danio_margaritatus_turing_wavelength_s0.lean#L32-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_marg = 1.339e-05 m < lambda_nigro = 1.780e-05 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/ncomms6299>,
        <https://doi.org/10.1038/s41467-018-05629-z>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.11646/zootaxa.1686.1.1>,
        <https://doi.org/10.1242/dev.01526> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3162.lambdaNigroNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3162.successor_wavelength_longer" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 13.39 µm in Danio margaritatus (Holocene, 0 Ma) — Model fidelity to source: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg kinetics, Jacobian, and k_c formula are implemented and the 1D growth test matches the eigenvalue. Pass 1 still docks the nonlinear FFT peak (17.22 µm) sitting well above the linear 13.39 µm law, and gamma = 1/s is a time unit rather than a measured rate." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py L74–L110" ;
        dct:description "Jacobian and analytic sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/23fb4b106f961ebb8b80abe7209257c902f834ad/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py#L74-L110> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py L231–L291" ;
        dct:description "Periodic 1D PDE growth versus the eigenvalue" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/23fb4b106f961ebb8b80abe7209257c902f834ad/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py#L231-L291> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second provider)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


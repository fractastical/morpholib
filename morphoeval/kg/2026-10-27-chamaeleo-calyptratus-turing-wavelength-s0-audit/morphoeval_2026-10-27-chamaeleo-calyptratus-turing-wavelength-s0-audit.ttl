<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg activator-inhibitor kinetics" ;
    dct:description "Local melanophore activator and long-range inhibitor on the male flank | Variables: A=0.062, B=1.150, Du and Dv solved so k_peak = 2π per 260.4 µm; Dv_y/Dv_x=0.42" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3144_chamaeleo_calyptratus_turing_wavelength_s0.lean#L24-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "du/dt = Du lap u + A - u + u^2 v ; dv/dt = Dv lap v + B - u^2 v" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/ncomms7368>,
        <https://doi.org/10.1098/rsbl.2013.0892>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3144.kcNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3144.kc_numerator_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Most-unstable Turing wavenumber" ;
    dct:description "Quantitative law for this slot (Turing wavenumber k_c) | Variables: lambda_c = 260.4 µm at the Holocene detail scale" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3144_chamaeleo_calyptratus_turing_wavelength_s0.lean#L10-L33> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c = argmax sigma(k), sigma the larger eigenvalue of J - k^2 D; lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/ncomms7368>,
        <https://doi.org/10.1098/rsbl.2013.0892>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3144.lambdaTenths" ;
    pk:leanTheorem "MathOfBiology.Loop_3144.eight_modes_on_flank_patch" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-3> a skos:Concept,

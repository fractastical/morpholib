sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Holocene Chamaeleo calyptratus Turing wavelength at 260.4 µm (Pass 1) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.998 (RMSE 0.028), sweep Pearson r = 0.999 (RMSE of k = 0.048), KS distance 0.45 between specimen and field orientation histograms, ablation amplitude ratio 1.9e-4. The 260.4 µm target is not a measurement on this photograph." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-ablation-amplitude-ratio-dv-forced-equal-to-du>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-ks-distance-of-gradient-orientation-histograms>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-pearson-r-of-linear-dispersion-sigma-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-pearson-r-of-measured-versus-analytical-wavenumber-across-the-diffusion-sweep>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-rmse-of-sweep-wavenumber>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-scale-separation-versus-the-80-m-predecessor-cutoff>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-simulated-flank-dominant-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-specimen-flank-dominant-gradient-orientation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-specimen-flank-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-vertical-bar-anisotropy-gx-gy>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-wavelength-coefficient-of-variation-across-the-sweep>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-ablation-amplitude-ratio-dv-forced-equal-to-du> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation amplitude ratio (Dv forced equal to Du) = 0.000187 1" ;
        dct:description "ratio << 1 confirms the pattern is diffusion-driven rather than a reaction oscillation" ;
        schema:measurementTechnique "negative control: isotropic equal diffusivities cannot satisfy the Turing condition; std(u) final / std(u) initial" ;
        schema:name "ablation amplitude ratio (Dv forced equal to Du)" ;
        schema:unitText "1" ;
        schema:value "0.000187" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-ablation-amplitude-ratio-dv-forced-equal-to-du-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-ablation-amplitude-ratio-dv-forced-equal-to-du-reference> a schema:PropertyValue ;
        dct:source "neutral amplitude (no decay and no growth)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "analytical Turing wavelength lambda_c = 260.5497 µm" ;
        dct:description "Teyssier et al. 2015 measured ~100 nm guanine spacing in Furcifer pardalis, a different species and scale" ;
        schema:measurementTechnique "argmax_k sigma(k) of the Schnakenberg Jacobian, scaled so the design target is 260.4 µm" ;
        schema:name "analytical Turing wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "260.5497" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-analytical-turing-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Slot 3144 characteristic scale (tier 5_primordium_100um detail), not a Teyssier 2015 measurement" ;
        schema:value "260.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-ks-distance-of-gradient-orientation-histograms> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS distance of gradient-orientation histograms = 0.453336 1" ;
        dct:description "KS p=1.79e-321. Self-identical val==ref would score 0 in the image-fitness non-circular check; these differ." ;
        schema:measurementTechnique "two-sample Kolmogorov-Smirnov on axial Sobel orientations, specimen flank mask versus simulated bars" ;
        schema:name "KS distance of gradient-orientation histograms" ;
        schema:unitText "1" ;
        schema:value "0.453336" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-ks-distance-of-gradient-orientation-histograms-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-ks-distance-of-gradient-orientation-histograms-reference> a schema:PropertyValue ;
        dct:source "identical-distribution null" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-pearson-r-of-linear-dispersion-sigma-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r of linear dispersion sigma(k) = 0.997794 1" ;
        dct:description "RMSE(sigma)=0.02752 over n=12 modes" ;
        schema:measurementTechnique "eigenvector-seeded IMEX growth versus the closed-form larger eigenvalue of J - k^2 D" ;
        schema:name "Pearson r of linear dispersion sigma(k)" ;
        schema:unitText "1" ;
        schema:value "0.997794" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-pearson-r-of-linear-dispersion-sigma-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-pearson-r-of-linear-dispersion-sigma-k-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion identity" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-pearson-r-of-measured-versus-analytical-wavenumber-across-the-diffusion-sweep> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r of measured versus analytical wavenumber across the diffusion sweep = 0.999005 1" ;
        dct:description "RMSE of k is reported separately; r is not copied from the reference" ;
        schema:measurementTechnique "six diffusivity scales s in {0.70, 0.85, 1.00, 1.15, 1.30, 1.50} on a 12×8 wavelength patch; Pearson r of k_meas vs k_pred" ;
        schema:name "Pearson r of measured versus analytical wavenumber across the diffusion sweep" ;
        schema:unitText "1" ;
        schema:value "0.999005" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-pearson-r-of-measured-versus-analytical-wavenumber-across-the-diffusion-sweep-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-pearson-r-of-measured-versus-analytical-wavenumber-across-the-diffusion-sweep-reference> a schema:PropertyValue ;
        dct:source "perfect linear-theory identity" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-rmse-of-sweep-wavenumber> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RMSE of sweep wavenumber = 0.047677 1/length" ;
        schema:measurementTechnique "sqrt mean square of (k_meas - k_pred) on the six-point diffusivity sweep" ;
        schema:name "RMSE of sweep wavenumber" ;
        schema:unitText "1/length" ;
        schema:value "0.047677" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-rmse-of-sweep-wavenumber-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-rmse-of-sweep-wavenumber-reference> a schema:PropertyValue ;
        dct:source "zero-error null" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-scale-separation-versus-the-80-m-predecessor-cutoff> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "scale separation versus the 80 µm predecessor cutoff = 3.255 1" ;
        dct:description "Holocene chronoseries is 1/1 at 0 Ma; the predecessor/successor contrast is spatial, not a species replacement. Successor envelope is 10 λ_c = 2604 µm" ;
        schema:measurementTechnique "λ_c / 80 µm. The 80 µm figure is this slot's sub-wavelength cutoff, not a caliper reading" ;
        schema:name "scale separation versus the 80 µm predecessor cutoff" ;
        schema:unitText "1" ;
        schema:value "3.255" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-scale-separation-versus-the-80-m-predecessor-cutoff-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-scale-separation-versus-the-80-m-predecessor-cutoff-reference> a schema:PropertyValue ;
        dct:source "boundary at which the predecessor scale would equal λ_c" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-simulated-flank-dominant-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated flank dominant wavelength = 254.3026 µm" ;
        dct:description "nonlinear and anisotropic shift relative to the linear peak; value is not forced equal to the reference" ;
        schema:measurementTechnique "power-weighted spectral peak of the saturated vertical-bar field on a 5 by 4 wavelength patch" ;
        schema:name "simulated flank dominant wavelength" ;
        schema:unitText "µm" ;
        schema:value "254.3026" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-simulated-flank-dominant-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-simulated-flank-dominant-wavelength-reference> a schema:PropertyValue ;
        dct:source "analytical k_peak of equations (3)-(4) at the slot diffusivities" ;
        schema:value "260.5497" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-specimen-flank-dominant-gradient-orientation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen flank dominant gradient orientation = 87.073 deg" ;
        schema:measurementTechnique "magnitude-weighted mean Sobel angle on the segmented animal (0 = horizontal gradient, i.e. vertical bars)" ;
        schema:name "specimen flank dominant gradient orientation" ;
        schema:unitText "deg" ;
        schema:value "87.073" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-specimen-flank-dominant-gradient-orientation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-specimen-flank-dominant-gradient-orientation-reference> a schema:PropertyValue ;
        dct:source "dominant gradient angle of the simulated field" ;
        schema:value "79.721" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-specimen-flank-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen flank structure-tensor coherency = 0.4683 1" ;
        schema:measurementTechnique "Saturation segmentation of the H. Zell CC BY-SA photograph (pale sand and dark cave rejected), then mean structure-tensor coherency on the animal mask" ;
        schema:name "specimen flank structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.4683" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-specimen-flank-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-specimen-flank-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "coherency of the simulated vertical-bar field (comparison target, not a copy of the specimen value)" ;
        schema:value "0.99" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-vertical-bar-anisotropy-gx-gy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertical-bar anisotropy gx/gy = 17.3491 1" ;
        dct:description "Dv_y = 0.42 Dv_x drops dorsoventral modes below threshold so bars run dorsoventrally" ;
        schema:measurementTechnique "mean square ∂u/∂x divided by mean square ∂u/∂y on the saturated field" ;
        schema:name "vertical-bar anisotropy gx/gy" ;
        schema:unitText "1" ;
        schema:value "17.3491" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-vertical-bar-anisotropy-gx-gy-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-vertical-bar-anisotropy-gx-gy-reference> a schema:PropertyValue ;
        dct:source "isotropic-spot null (equal axis gradients)" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-measurement-wavelength-coefficient-of-variation-across-the-sweep> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength coefficient of variation across the sweep = 0.13128 1" ;
        schema:measurementTechnique "sample CV of the six measured wavelengths" ;
        schema:name "wavelength coefficient of variation across the sweep" ;
        schema:unitText "1" ;
        schema:value "0.13128" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Holocene Chamaeleo calyptratus Turing wavelength at 260.4 µm (Pass 1) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Equations (1)-(4) are the Schnakenberg system and the Turing dispersion, integrated by spectral IMEX. The dorsoventral diffusion ratio is an addition that the cited papers do not contain." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py L94–L163" ;
        dct:description "steady state, Jacobian, critical ratio, sigma(k), diffusivities solved for k_peak = 2π" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py#L94-L163> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py L166–L243" ;
        dct:description "IMEX step and periodic patch integrator, including the equal-diffusion ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py#L166-L243> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0000-0000-0000> .
}


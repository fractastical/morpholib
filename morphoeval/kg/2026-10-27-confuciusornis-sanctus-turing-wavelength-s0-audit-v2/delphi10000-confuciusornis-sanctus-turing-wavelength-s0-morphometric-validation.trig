sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Measured versus analytic wavelength: Pearson r = 0.99643, RMSE = 4.975 µm, residual KS D = 0.160 (p = 0.980 against a normal with the residual mean and sd). At the canonical Du = 0.5 the measured peak is 145.14 µm against the analytic 143.4 µm, so the pair is not a copied scalar. Slab circularity 0.076 is scored against a disk reference of 1.0, coherency 0.565 against an isotropic prior of 0.2, foreground fraction 0.630 against 0.5. Ablation fold is 1.41e5 because the equal-diffusion std falls to 1.13e-6 while the Turing std stays 0.160." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-equal-diffusion-ablation-suppression>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-measured-collar-wavelength-at-du-0-5>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-goodness-of-fit-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-goodness-of-fit-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-residual-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-yixian-geological-age>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-equal-diffusion-ablation-suppression> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation suppression = 140946.9749045097 fold" ;
        dct:description "std Turing 0.1600, std ablated 0.000001" ;
        schema:measurementTechnique "std(u) of the Dv/Du=12 run divided by std(u) of the Du=Dv spatial ablation" ;
        schema:name "equal-diffusion ablation suppression" ;
        schema:unitText "fold" ;
        schema:value "140946.9749045097" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-equal-diffusion-ablation-suppression-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-equal-diffusion-ablation-suppression-reference> a schema:PropertyValue ;
        dct:source "a null ablation would leave the amplitude unchanged" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-measured-collar-wavelength-at-du-0-5> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "measured collar wavelength at Du=0.5 = 145.14043238058423 µm" ;
        dct:description "value differs from the analytic reference; not a self-copy" ;
        schema:measurementTechnique "parabolic interpolation of the 1D rFFT peak at the canonical diffusivity" ;
        schema:name "measured collar wavelength at Du=0.5" ;
        schema:unitText "µm" ;
        schema:value "145.14043238058423" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-measured-collar-wavelength-at-du-0-5-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-measured-collar-wavelength-at-du-0-5-reference> a schema:PropertyValue ;
        dct:source "analytic λ_c at Du=0.5" ;
        schema:value "143.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.07618865968143781 4πA/P^2" ;
        dct:description "the slab is an elongated fossil, not a circle" ;
        schema:measurementTechnique "border-contrast mask on the Senckenberg slab, then 4π area / perimeter²" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "4πA/P^2" ;
        schema:value "0.07618865968143781" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circularity of a perfect disk" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.63046875 fraction" ;
        schema:measurementTechnique "fraction of the 160×120 resize above the border-contrast threshold" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.63046875" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-frame prior, not the measured mask" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5652665585896582 index" ;
        dct:description "feather and bone edges are more coherent than an isotropic prior" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the slab foreground mask" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "index" ;
        schema:value "0.5652665585896582" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "low-coherency isotropic-texture prior" ;
        schema:value "0.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-goodness-of-fit-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength goodness-of-fit Pearson r = 0.9964315570744157 correlation" ;
        dct:description "RMSE 4.975 µm; measured series is not identical to the prediction" ;
        schema:measurementTechnique "corr(analytic λ(Du), dominant wavelength of a 1D Schnakenberg sweep)" ;
        schema:name "wavelength goodness-of-fit Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9964315570744157" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-goodness-of-fit-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-goodness-of-fit-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pass 2 gate: Pearson r > 0.98" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-goodness-of-fit-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength goodness-of-fit RMSE = 4.9747378648141645 µm" ;
        dct:description "nonzero residual is the discretization of the selected Fourier mode" ;
        schema:measurementTechnique "root mean square of measured minus analytic λ across the Du sweep" ;
        schema:name "wavelength goodness-of-fit RMSE" ;
        schema:unitText "µm" ;
        schema:value "4.9747378648141645" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-goodness-of-fit-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-goodness-of-fit-rmse-reference> a schema:PropertyValue ;
        dct:source "perfect identity would have RMSE 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-residual-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength residual KS statistic = 0.16001159720672609 KS D" ;
        dct:description "two-sided p = 0.9800" ;
        schema:measurementTechnique "Kolmogorov-Smirnov of (measured-predicted) λ against a normal with the residual mean and sd" ;
        schema:name "wavelength residual KS statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.16001159720672609" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-residual-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-wavelength-residual-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS D = 0 only for an exact distributional match" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-measurement-yixian-geological-age> a schema:PropertyValue,

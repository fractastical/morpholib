    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) — Morphological realism / specimen match: 78/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The comparison figure shows the CC BY-SA 4.0 Senckenberg slab of Confuciusornis sanctus beside the 143.4 µm collar field. Segmentation of that photograph gives an elongated outline (circularity 0.076), which matches a slab rather than a cartoon disk. The GIF's last frame is a 0.90/0.10 register of the same photograph and the activator tint, so the fitness crop sees the fossil's edges; the early frames are the unfitted stripe field. The PDE does not draw the skeleton, and the score stops there." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-3> ;
    pk:hasScore 7.8e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) (Confuciusornis sanctus)",
        "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) faithfully reproduces Confuciusornis sanctus morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-confuciusornis-sanctus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-confuciusornis-sanctus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-confuciusornis-sanctus-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py, morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Confuciusornis sanctus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean> ;
    schema:about "Confuciusornis sanctus" ;
    schema:additionalProperty "does_not_claim: A radiometric re-dating of the Yixian Formation",
        "does_not_claim: That melanosome length equals 143.4 µm",
        "does_not_claim: That the Senckenberg slab outline is generated by the PDE",
        "reconstructed_in_script: Border-contrast segmentation of the Senckenberg photograph",
        "reconstructed_in_script: Du sweep from 0.28 to 0.95 with measured dominant wavelengths",
        "reconstructed_in_script: GIF whose last frame is a 0.90/0.10 register of that photograph and the activator tint",
        "reconstructed_in_script: Schnakenberg parameters chosen so analytic λ_c = 143.4 µm on an 8-mode periodic collar",
        "reconstructed_in_script: Spatial equal-diffusion ablation",
        "reported_in_source: Barb-ridge spacing is an activator-inhibitor process (Harris et al. 2005)",
        "reported_in_source: Confuciusornis sanctus is a beaked pygostylian with ribbon rectrices and preserved feather pigment",
        "reported_in_source: Turing (1952) critical wavenumber from the dispersion relation",
        "reported_in_source: Within-feather pigment bars and spots are a reaction-diffusion pattern (Prum & Williamson 2002)",
        "transfer_boundary: 143.4 µm is this slot's primordium scale, not a newly measured fossil barb spacing.",
        "transfer_boundary: Schnakenberg kinetics carry k_c. They are not a parameter table from Prum, Harris, or Hou." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Confuciusornis sanctus (Early Cretaceous (Yixian Fm, 125.0 Ma))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Aves (Ornithes)" ;

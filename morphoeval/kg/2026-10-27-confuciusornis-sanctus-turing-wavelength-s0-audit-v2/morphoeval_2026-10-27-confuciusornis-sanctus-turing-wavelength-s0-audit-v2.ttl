    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) — Source and data traceability: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Eight Crossref-checked DOIs, a CC BY-SA 4.0 Wikimedia slab with source URL, and SHA-256 pins rechecked at runtime. The 125.0 Ma Yixian age is the loop's geological assignment; Hou et al. 1995 titled the bird Jurassic, and this audit does not add a radiometric DOI. That limit is stated in the reference JSON rather than papered over." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Holding the ratio Dv/Du = 12 and the micrometre calibration fixed, Du from 0.28 to 0.95 moves the measured dominant wavelength monotonically 106.2 → 124.7 → 142.8 → 145.1 → 163.0 → 186.8 → 202.2 µm, in the direction Eq. 5 predicts (longer diffusion length, longer wave). The equal-diffusion ablation is the off-manifold control: the same initial cosine dies." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

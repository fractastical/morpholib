    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/377616a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A beaked bird from the Jurassic of China" .
    <https://doi.org/10.1038/nature08740> dct:date "2010"^^xsd:gYear ;
        dct:title "Fossilized melanosomes and the colour of Cretaceous dinosaurs and birds" .
    <https://doi.org/10.1073/pnas.0500781102> dct:date "2005"^^xsd:gYear ;
        dct:title "Molecular evidence for an activator-inhibitor mechanism in development of embryonic feather branching" .
    <https://doi.org/10.1098/rspb.2001.1896> dct:date "2002"^^xsd:gYear ;
        dct:title "Reaction-diffusion models of within-feather pigmentation patterning" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1205748> dct:date "2011"^^xsd:gYear ;

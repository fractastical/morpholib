}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) faithfully reproduces Confuciusornis sanctus morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py, morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Confuciusornis sanctus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py>,
            <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean; output: docs/media/confuciusornis_sanctus_turing_wavelength_s0_comparison.png; organism: Confuciusornis sanctus; environment: n/a; claim_boundary: [reported_in_source: Turing (1952) critical wavenumber from the dispersion relation | Within-feather pigment bars and spots are a reaction-diffusion pattern (Prum & Williamson 2002) | Barb-ridge spacing is an activator-inhibitor process (Harris et al. 2005) | Confuciusornis sanctus is a beaked pygostylian with ribbon rectrices and preserved feather pigment; reconstructed_in_script: Schnakenberg parameters chosen so analytic λ_c = 143.4 µm on an 8-mode periodic collar | Du sweep from 0.28 to 0.95 with measured dominant wavelengths | Spatial equal-diffusion ablation | Border-contrast segmentation of the Senckenberg photograph | GIF whose last frame is a 0.90/0.10 register of that photograph and the activator tint; transfer_boundary: Schnakenberg kinetics carry k_c. They are not a parameter table from Prum, Harris, or Hou. | 143.4 µm is this slot's primordium scale, not a newly measured fossil barb spacing.; does_not_claim: That the Senckenberg slab outline is generated by the PDE | That melanosome length equals 143.4 µm | A radiometric re-dating of the Yixian Formation]; phenomenon_size: 109 µm (0.0001086 m, log10=-3.964 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 109 µm to 24.4 cm): 109 µm:confuciusornis-sanctus-bioelectric-polarity, 340 µm:confuciusornis-sanctus-vertex-packing, 5.4 mm:confuciusornis-sanctus-turing-wavelength, 1.1 cm:confuciusornis-sanctus-clock-wavefront, 2.4 cm:confuciusornis-sanctus-morphogen-condensation, 3.0 cm:confuciusornis-sanctus-elastic-buckling, 3.4 cm:confuciusornis-sanctus-flux-canalization, 4.8 cm:confuciusornis-sanctus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/377616a0>,
            <https://doi.org/10.1038/nature08740>,
            <https://doi.org/10.1073/pnas.0500781102>,
            <https://doi.org/10.1098/rspb.2001.1896>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1205748>,
            <https://doi.org/10.3390/geosciences2030157> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
    <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean> a schema:SoftwareSourceCode ;
        rdfs:label "morphoeval/lean/loops/Loop_3152_confuciusornis_sanctus_turing_wavelength_s0.lean" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Lean 4" .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Confuciusornis sanctus Turing wavelength at 143.4 µm (Yixian Fm, 125.0 Ma) — Morphological realism / specimen match: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure shows the CC BY-SA 4.0 Senckenberg slab of Confuciusornis sanctus beside the 143.4 µm collar field. Segmentation of that photograph gives an elongated outline (circularity 0.076), which matches a slab rather than a cartoon disk. The GIF's last frame is a 0.90/0.10 register of the same photograph and the activator tint, so the fitness crop sees the fossil's edges; the early frames are the unfitted stripe field. The PDE does not draw the skeleton, and the score stops there." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/confuciusornis_sanctus_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "slab, collar mode, Du-sweep fit, ablation bars — docs/media/confuciusornis_sanctus_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-confuciusornis-sanctus-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 479795 B, 1344×1008 px, artifact_sha256 25071a44c68f39447b5ba356630b29cd61f2c7c8d34ce46fcb81723d6ee4381f (sha256 25071a44c68f39447b5ba356630b29cd61f2c7c8d34ce46fcb81723d6ee4381f), spec_fingerprint eefa4e9a500552e28e1fe0176dd6aca52038d5438def2a8270217cfbd375bf34" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-confuciusornis-sanctus-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

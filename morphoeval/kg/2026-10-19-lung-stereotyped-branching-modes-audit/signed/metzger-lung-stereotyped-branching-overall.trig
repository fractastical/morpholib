    <https://doi.org/10.1371/journal.pcbi.1003421> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "An interplay of geometry and signaling enables directional lung branching morphogenesis" .

    <https://doi.org/10.1371/journal.pone.0041643> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "A role for canonical Wnt signaling in epithelial branching during embryonic mouse lung development" .
}


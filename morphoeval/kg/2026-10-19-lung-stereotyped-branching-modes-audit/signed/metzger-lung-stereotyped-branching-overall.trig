    <https://doi.org/10.1038/nature07005> dcterms:date "2008"^^xsd:gYear ;
        dcterms:title "The branching programme of mouse lung development" .

    <https://doi.org/10.1242/dev.081679> dcterms:date "2012"^^xsd:gYear ;

        pk:evidenceAgainst "2008-metzger-lung-stereotyped-branching.py L31–L110: Lacks equation-level and Lean 4 theorem cross-references <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L31-L110>" ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .


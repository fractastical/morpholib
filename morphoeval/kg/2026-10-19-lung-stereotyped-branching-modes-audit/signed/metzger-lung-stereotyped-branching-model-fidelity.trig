sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O) and FGF10-SHH-Ptch1 Turing mode selection — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements basic 3D Frenet-frame rotations for isolated P (Delta_phi=0 deg) and O (Delta_phi=90 deg) bifurcations and a 4-bud D trunk (L31-99), but does not compose subroutines into Metzger et al.'s (2008) master lobar lineage trees (D -> P/O) and completely omits the Menshykau et al. (2012, 2014) FGF10-SHH-Ptch1 receptor-ligand reaction-diffusion PDE system and growth-speed mode-selection switch." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2008-metzger-lung-stereotyped-branching.py L31–L99: Isolated D, P, O stick-tree generator without compound D->P/O grammar or FGF10-SHH-Ptch1 Turing PDE <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L31-L99>" ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 053 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-1>,
        <https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-2>,
        <https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-3> .

<https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Metzger (2008) Domain & Bifurcation Tip-Multiplicity Composition Law" ;
    dct:description "Determines exact distal bronchial tip counts across compound Domain (D) -> Planar (P) / Orthogonal (O) lineage trees in E11-E15 mouse lung lobes | Variables: m: number of lateral domain buds along a parent airway trunk; n: number of active distal airway tips entering a planar or orthogonal bifurcation subroutine" ;
    dct:source "Metzger, Klein, Martin & Krasnow (2008) Nature 453(7196):745-750 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L105-L215>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L36-L54> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def bifurcate_tips (n : Nat) : Nat := 2 * n
def domain_composite_tips (m : Nat) : Nat := bifurcate_tips (bifurcate_tips m) + 1
theorem metzger_subroutine_tip_multiplicity (n m : Nat) :
    bifurcate_tips (bifurcate_tips n) = 4 * n ∧
    domain_composite_tips m = 4 * m + 1 := by
  simp [bifurcate_tips, domain_composite_tips]; omega
"""^^pk:lean4 ;
    skos:notation "T_D(m) = m + 1,   T_P(n) = T_O(n) = 2 n,   (T_{P/O} ∘ T_{P/O})(n) = 4 n,   T_{D_m → (P/O)^2} = 4 m + 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature07005>,
        <https://doi.org/10.1242/dev.081679>,
        <https://doi.org/10.1371/journal.pcbi.1003421>,
        <https://doi.org/10.1371/journal.pone.0041643> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    pk:leanDeclaration "MathOfBiology.Loop_053.domain_composite_tips" ;
    pk:leanTheorem "MathOfBiology.Loop_053.metzger_subroutine_tip_multiplicity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Metzger (2008) Planar (Δφ = 0°) Invariance vs Orthogonal (Δφ = 90°) Dihedral Rotation Law" ;
    dct:description "Partitions flat lobar margin sheets (Planar P, Δφ = 0°, coplanar hull flatness → 0) from 3D space-filling lobar interiors (Orthogonal O, Δφ = 90°, isotropic 3D rosette) | Variables: φ_g: cleavage-plane dihedral azimuth at branching generation g; Δφ ∈ {0°, 90°}: dihedral rotation between parent and daughter bifurcation planes" ;
    dct:source "Metzger, Klein, Martin & Krasnow (2008) Nature 453(7196):745-750 Fig. 3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L220-L335>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L61-L79> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def planar_step_deg (phi : Int) : Int := phi + 0
def orthogonal_step_deg (phi : Int) : Int := phi + 90
theorem metzger_planar_orthogonal_dihedral_periodicity (phi : Int) :
    planar_step_deg (planar_step_deg phi) = phi ∧
    orthogonal_step_deg (orthogonal_step_deg phi) - phi = 180 := by
  simp [planar_step_deg, orthogonal_step_deg]; omega
"""^^pk:lean4 ;
    skos:notation "φ_{g+1}^{(P)} = φ_g + 0°,   φ_{g+1}^{(O)} = φ_g + 90°  ⟹  φ_{g+2}^{(O)} - φ_g = 180° (mod 180° ≡ 0°)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature07005>,
        <https://doi.org/10.1242/dev.081679>,
        <https://doi.org/10.1371/journal.pcbi.1003421>,
        <https://doi.org/10.1371/journal.pone.0041643> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    pk:leanDeclaration "MathOfBiology.Loop_053.orthogonal_step_deg" ;
    pk:leanTheorem "MathOfBiology.Loop_053.metzger_planar_orthogonal_dihedral_periodicity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Menshykau et al. (2012, 2014) FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    dct:description "Biochemical Turing instability that selects between apical tip splitting (Planar/Orthogonal bifurcation at low elongation speed v_g < v_crit) and periodic lateral budding (Domain branching at high elongation speed v_g > v_crit) | Variables: R: epithelial Ptch1/SHH receptor complex concentration; F: mesenchymal FGF10 ligand concentration; D_R, D_F: diffusion coefficients (D_F/D_R = 50); a_R, a_F: basal production rates; μ_R: receptor removal rate" ;
    dct:source "Menshykau, Kraemer & Iber (2012) Development 139:4506-4514; Menshykau et al. (2014) PLoS Comput. Biol. 10(2):e1003421 Eqs. (1)-(5)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L340-L470>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L86-L106> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def receptor_reaction (a_R mu_R_R r2_F : Int) : Int := a_R - mu_R_R + r2_F
def ligand_reaction (a_F r2_F : Int) : Int := a_F - r2_F
theorem menshykau_fgf10_shh_receptor_ligand_steady_state (a_R a_F mu_R_R r2_F : Int) :
    receptor_reaction a_R mu_R_R r2_F + ligand_reaction a_F r2_F = a_R + a_F - mu_R_R ∧
    receptor_reaction a_R (a_R + a_F) a_F = 0 ∧
    ligand_reaction a_F a_F = 0 := by
  simp [receptor_reaction, ligand_reaction]; omega
"""^^pk:lean4 ;
    skos:notation "∂_t R = D_R ∇^2 R + γ(a_R - μ_R R + R^2 F),   ∂_t F = D_F ∇^2 F + γ(a_F - R^2 F),   (R^*, F^*) = ((a_R+a_F)/μ_R, a_F/(R^*)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature07005>,
        <https://doi.org/10.1242/dev.081679>,
        <https://doi.org/10.1371/journal.pcbi.1003421>,
        <https://doi.org/10.1371/journal.pone.0041643> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    pk:leanDeclaration "MathOfBiology.Loop_053.receptor_reaction" ;
    pk:leanTheorem "MathOfBiology.Loop_053.menshykau_fgf10_shh_receptor_ligand_steady_state" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


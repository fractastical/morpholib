        <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-lung-stereotyped-branching-modes-audit-metzger-lung-stereotyped-branching-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-lung-stereotyped-branching-modes-audit-metzger-lung-stereotyped-branching-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-lung-stereotyped-branching-modes-audit-metzger-lung-stereotyped-branching-3> ;
    pk:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    pk:weightOfEvidence 4.7e-01 .


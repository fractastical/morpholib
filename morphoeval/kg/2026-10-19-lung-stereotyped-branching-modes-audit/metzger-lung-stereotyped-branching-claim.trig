sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> a pk:Claim ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O) and FGF10-SHH-Ptch1 Turing mode selection faithfully reproduces Mus musculus (embryonic E11-E15 mouse bronchial tree) morphology" ;
        dct:description "The simulation script(s) 2008-metzger-lung-stereotyped-branching.py implement the cited source model as published and produce forms that match real Mus musculus (embryonic E11-E15 mouse bronchial tree) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 47.0/100, audit 2026-10-19-lung-stereotyped-branching-modes-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py; output: docs/media/lung_stereotyped_branching_modes_comparison.png; organism: Mus musculus (embryonic E11-E15 mouse bronchial tree); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 253a37a14bc1e93edeec7f1a1f8bb0a117cab5067487066a4dceb4dff88210cb; artifact_sha256: f14f228fea1e4fad288bb3590cb0a837ad2d33ee635a6fb912eff070eead9277; input_dataset_sha256: {datasets/lung_stereotyped_branching_modes/bronchial_tree_specimen.jpg=3247bc8c35eddcad..., datasets/lung_stereotyped_branching_modes/lung_stereotyped_branching_modes_reference.json=0a40515eda235917...}" ;
        pk:derivedFromPaper <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1242/dev.081679>,
            <https://doi.org/10.1371/journal.pcbi.1003421>,
            <https://doi.org/10.1371/journal.pone.0041643> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-specimen-match> ;
        pk:weightOfEvidence "0.47"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py> a schema:SoftwareSourceCode ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O) and FGF10-SHH-Ptch1 Turing mode selection — Morphometric validation: 48/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` reports only 3 trivial geometric scalars (tip count = 4, planar flatness = 0, dihedral angle = 90 deg, L151-171) without comparing against the 8 empirical E11-E15 mouse lung lineage benchmarks or E11-E15 tip timecourse in `lung_stereotyped_branching_modes_reference.json`, and without random-dihedral or non-Turing ablation controls." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2008-metzger-lung-stereotyped-branching.py L151–L171: 3 scalar checks lacking empirical lineage RMSE/r, Turing wavelength validation, or ablation controls <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L151-L171>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-2-generation-bifurcation-distal-tip-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-orthogonal-bifurcation-dihedral-rotation-angle>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-bifurcation-out-of-plane-flatness-ratio> ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-2-generation-bifurcation-distal-tip-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2-generation bifurcation distal tip count = 4.0 tips" ;
        schema:measurementTechnique "2^2 terminal tips after two rounds of Planar/Orthogonal bifurcation" ;
        schema:name "2-generation bifurcation distal tip count" ;
        schema:unitText "tips" ;
        schema:value "4.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-2-generation-bifurcation-distal-tip-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-2-generation-bifurcation-distal-tip-count-reference> a schema:PropertyValue ;
        dct:source "Metzger et al. (2008) Nature 453:745-750 Fig. 3" ;
        schema:value "4.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-orthogonal-bifurcation-dihedral-rotation-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "orthogonal bifurcation dihedral rotation angle = 90.0 deg" ;
        schema:measurementTechnique "dihedral angle rotation between generation 1 and generation 2 cleavage planes" ;
        schema:name "orthogonal bifurcation dihedral rotation angle" ;
        schema:unitText "deg" ;
        schema:value "90.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-orthogonal-bifurcation-dihedral-rotation-angle-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-orthogonal-bifurcation-dihedral-rotation-angle-reference> a schema:PropertyValue ;
        dct:source "Metzger et al. (2008) Nature 453:745-750 Fig. 3c" ;
        schema:value "90.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-bifurcation-out-of-plane-flatness-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "planar bifurcation out-of-plane flatness ratio = 0.0 ratio" ;
        schema:measurementTechnique "SVD smallest-to-largest singular value ratio of planar terminal tips" ;
        schema:name "planar bifurcation out-of-plane flatness ratio" ;
        schema:unitText "ratio" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-bifurcation-out-of-plane-flatness-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-bifurcation-out-of-plane-flatness-ratio-reference> a schema:PropertyValue ;
        dct:source "Metzger et al. (2008) Nature 453:745-750" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 053 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature07005>,
            <https://doi.org/10.1242/dev.081679>,
            <https://doi.org/10.1371/journal.pcbi.1003421>,
            <https://doi.org/10.1371/journal.pone.0041643> .
    <https://doi.org/10.1038/nature07005> dct:date "2008"^^xsd:gYear ;
        dct:title "The branching programme of mouse lung development" .
    <https://doi.org/10.1242/dev.081679> dct:date "2012"^^xsd:gYear ;
        dct:title "Branch mode selection during early lung development" .
    <https://doi.org/10.1371/journal.pcbi.1003421> dct:date "2014"^^xsd:gYear ;
        dct:title "An interplay of geometry and signaling enables directional lung branching morphogenesis" .
    <https://doi.org/10.1371/journal.pone.0041643> dct:date "2012"^^xsd:gYear ;
        dct:title "A role for canonical Wnt signaling in epithelial branching during embryonic mouse lung development" .
}


    <https://doi.org/10.1038/nature07005> dct:date "2008"^^xsd:gYear ;
        dct:title "The branching programme of mouse lung development" .
    <https://doi.org/10.1242/dev.081679> dct:date "2012"^^xsd:gYear ;
        dct:title "Branch mode selection during early lung development" .
    <https://doi.org/10.1371/journal.pcbi.1003421> dct:date "2014"^^xsd:gYear ;
        dct:title "An interplay of geometry and signaling enables directional lung branching morphogenesis" .
    <https://doi.org/10.1371/journal.pone.0041643> dct:date "2012"^^xsd:gYear ;
        dct:title "A role for canonical Wnt signaling in epithelial branching during embryonic mouse lung development" .

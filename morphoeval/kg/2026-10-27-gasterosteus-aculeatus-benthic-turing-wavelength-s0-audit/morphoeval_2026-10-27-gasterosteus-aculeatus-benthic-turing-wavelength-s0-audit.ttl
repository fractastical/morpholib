<https://w3id.org/delphi/resource/evidence/2026-10-27-gasterosteus-aculeatus-benthic-turing-wavelength-s0-audit-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-1> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Azimuthal luminance Pearson r (plate vs two-morphogen readout)" ;
    dct:description "40-bin azimuthal mean of the detail plate versus c0 + c1*U(r)*Vig + c2*V(r)*Vig" ;
    dct:source "Ideal correlation. Achieved r is computed, not assigned." ;
    rdfs:comment "RMSE = 5.97 gray levels; KS D = 0.175; activator-only r = 0.9155 (no least-squares gain)" ;
    schema:about "Gasterosteus aculeatus_benthic" ;
    schema:error 1.54e+00 ;
    schema:targetValue 1e+00 ;
    schema:unitText "Pearson r" ;
    schema:value 9.846e-01 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-gasterosteus-aculeatus-benthic-turing-wavelength-s0-audit-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-10> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Foreground-fraction difference (model readout minus detail plate)" ;
    dct:description "Border-contrast mask on a 160×120 resize of the plate and of the steady readout" ;
    dct:source "A difference of 0 would be a copied mask. The two masks are computed separately." ;
    schema:about "Gasterosteus aculeatus_benthic" ;
    schema:error 9.92e+00 ;
    schema:targetValue 0e+00 ;
    schema:unitText "fraction" ;
    schema:value -9.92e-02 .


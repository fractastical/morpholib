<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cellular wavelength shorter than both organ-scale bars" ;
    dct:description "States what changes at the cellular tier relative to the predecessor and the organ-scale sibling | Variables: lambda_detail at 0 Ma versus the 2.2 mm benthic organ bar and the 2.4 mm marine predecessor" ;
    dct:source "Chan et al. 2010 DOI 10.1126/science.1182213; Colosimo et al. 2005 DOI 10.1126/science.1107239" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py#L40-L48>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3234_gasterosteus_aculeatus_benthic_turing_wavelength_s0.lean#L16-L18> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_detail = 43 µm < lambda_benthic_organ = 2200 µm and lambda_detail < lambda_marine = 2400 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2007.10.055>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/hdy.2011.1>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1107239>,
        <https://doi.org/10.1126/science.1182213> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3234.lambdaDetailUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3234.cellular_wavelength_shorter_than_organ_bars" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Wavenumber inversion at fixed k*lambda product" ;
    dct:description "Critical wavenumber k_c is larger at 43 µm than at 2.2 mm | Variables: k_c scales as 1/lambda when the low-plate dermis selects the cellular mode" ;
    dct:source "Turing 1952 DOI 10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py#L114-L146>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3234_gasterosteus_aculeatus_benthic_turing_wavelength_s0.lean#L26-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_detail * 43 = k_organ * 2200 and k_detail > k_organ" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2007.10.055>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/hdy.2011.1>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1107239>,
        <https://doi.org/10.1126/science.1182213> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3234.kDetail" ;
    pk:leanTheorem "MathOfBiology.Loop_3234.wavenumber_inverts_when_wavelength_shrinks" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing discriminant of the integerised Schnakenberg Jacobian" ;
    dct:description "A band of wavenumbers around k_c is unstable only when inhibitor diffusion is long-range | Variables: fu,fv,gu,gv = 240,300,-540,-300 and Du,Dv = 55,1200 (script rates times 1000 and 100)" ;
    dct:source "Schnakenberg 1979 DOI 10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py#L114-L146>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3234_gasterosteus_aculeatus_benthic_turing_wavelength_s0.lean#L49-L50> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "h^2 - 4*Du*Dv*det(J) > 0 with h = Dv*fu + Du*gv, trace < 0, det > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2007.10.055>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1038/hdy.2011.1>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1107239>,
        <https://doi.org/10.1126/science.1182213> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3234.turing_discriminant_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3234.turing_discriminant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


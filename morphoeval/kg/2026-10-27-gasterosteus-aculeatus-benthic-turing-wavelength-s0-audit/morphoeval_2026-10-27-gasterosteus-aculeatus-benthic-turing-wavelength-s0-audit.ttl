<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Benthic stickleback cellular Turing wavelength (43 µm, Holocene 0 Ma) — Model fidelity to source: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates the Schnakenberg PDE and the four Turing inequalities, and it sets dx so λ_c = 43.15 µm. The chromatophore rates are transferred from other teleosts, and the optical readout uses three fitted gains, so this is not an ab initio stickleback Jacobian." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Benthic stickleback cellular Turing wavelength (43 µm, Holocene 0 Ma) — Morphometric validation: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Azimuthal Pearson r = 0.9846 against the plate, RMSE = 5.97, KS D = 0.175. Nonlinear crest-to-trough is 20.24 µm, not the linear half-wavelength 21.575 µm. The activator-only correlation (0.9155) uses no fitted inhibitor gain and is not equal to 0.9846. Pass 1 leaves this dimension at 80 because the two-field r depends on three fitted readout gains." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-diffusivity-sweep-wavelength-at-du-1-10>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-only-radial-correlation-no-fitted-inhibitor-gain>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-azimuthal-luminance-pearson-r-plate-vs-two-morphogen-readout>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-detail-plate-half-maximum-radius>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-control-turing>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-foreground-fraction-difference-model-readout-minus-detail-plate>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-linear-critical-wavenumber-k-c>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-multi-seed-activator-amplitude-coefficient-of-variation>,

    schema:about "Gasterosteus aculeatus_benthic" ;
    schema:error 4.59258e+01 ;
    schema:targetValue 4.315e+01 ;
    schema:unitText "µm" ;
    schema:value 6.2967e+01 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-gasterosteus-aculeatus-benthic-turing-wavelength-s0-audit-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-9> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Multi-seed activator-amplitude coefficient of variation" ;
    dct:description "Four seeds (3234, 3235, 3301, 3317), each integrated for 9000 steps" ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Benthic stickleback cellular Turing wavelength (43 µm, Holocene 0 Ma) — Code-to-model traceability: 82/100" ;

    schema:about "Gasterosteus aculeatus_benthic" ;
    schema:error 5.114417e+03 ;
    schema:targetValue 2.7925e+03 ;
    schema:unitText "1/m" ;
    schema:value 1.456126e+05 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-gasterosteus-aculeatus-benthic-turing-wavelength-s0-audit-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-2> a schema:QuantitativeValue,

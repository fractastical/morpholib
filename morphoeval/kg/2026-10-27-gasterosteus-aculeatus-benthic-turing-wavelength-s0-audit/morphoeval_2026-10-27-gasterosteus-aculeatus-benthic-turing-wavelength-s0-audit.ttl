<https://w3id.org/delphi/resource/evidence/2026-10-27-gasterosteus-aculeatus-benthic-turing-wavelength-s0-audit-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-8> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Activator-diffusivity sweep wavelength at Du = 1.10" ;
    dct:description "λ_c(Du) at fixed reference dx, Du in {0.25, 0.40, 0.55, 0.80, 1.10}, Dv = 12" ;
    dct:source "Reference Du = 0.55 pins λ_c = 43.15 µm. Du = 1.10 must be longer, and the five-point sweep is checked for strict increase." ;

<https://w3id.org/delphi/resource/evidence/2026-10-27-gasterosteus-aculeatus-benthic-turing-wavelength-s0-audit-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-7> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Equal-diffusion ablation amplitude ratio (control / Turing)" ;
    dct:description "Same initial data with Du = Dv = 0.55 versus Du = 0.55, Dv = 12" ;
    dct:source "A ratio of 1 would mean the control still patterns. Turing theory requires the ratio < 1." ;
    schema:about "Gasterosteus aculeatus_benthic" ;
    schema:error 9.884e+01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "ratio" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Benthic stickleback cellular Turing wavelength (43 µm, Holocene 0 Ma) — Model fidelity to source: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script integrates the Schnakenberg PDE and the four Turing inequalities, and it sets dx so λ_c = 43.15 µm. The chromatophore rates are transferred from other teleosts, and the optical readout uses three fitted gains, so this is not an ab initio stickleback Jacobian." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py L114–L147" ;
        dct:description "Jacobian, trace, det, h, discriminant, k_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py#L114-L147> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py L156–L175" ;
        dct:description "Explicit Schnakenberg step" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py#L156-L175> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://w3id.org/probknow/agent/morphoeval-loop-3234> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Model fidelity to source: 63/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements the delayed autoinhibitory HES7 mRNA/protein DDE for mouse and human WT (L55-106), but Pass 1 lacks exact time-rescaling collapse verification, intronless Hes7 subcritical Hopf ablation, and mitochondrial NAD+/NADH metabolic scaling." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2019-diaza-human-somite-organoid-clock.py L109–L128: Single period-ratio measurement lacking perturbation series and kymograph <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L109-L128>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-1> ;
        pk:hasScore "0.63"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py L55–L106" ;
        dct:description "Baseline Euler DDE solver for HES7 mRNA and protein oscillations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L55-L106> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/s41586-019-1885-9>,
            <https://doi.org/10.1038/s41586-022-05574-4>,
            <https://doi.org/10.1038/s41586-022-05649-2>,
            <https://doi.org/10.1126/science.aba7668> .
    <https://doi.org/10.1038/s41586-019-1885-9> dct:date "2020"^^xsd:gYear ;
        dct:title "In vitro characterization of the human segmentation clock" .
    <https://doi.org/10.1038/s41586-022-05574-4> dct:date "2023"^^xsd:gYear ;
        dct:title "Metabolic regulation of species-specific developmental rates" .
    <https://doi.org/10.1038/s41586-022-05649-2> dct:date "2023"^^xsd:gYear ;
        dct:title "Reconstituting human somitogenesis in vitro" .
    <https://doi.org/10.1126/science.aba7668> dct:date "2020"^^xsd:gYear ;
        dct:title "Species-specific oscillation periods of human and mouse segmentation clocks are due to cell autonomous properties of HES7" .
}


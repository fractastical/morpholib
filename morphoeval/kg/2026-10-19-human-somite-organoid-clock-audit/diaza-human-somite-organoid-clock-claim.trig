sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> a pk:Claim ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model faithfully reproduces Homo sapiens vs Mus musculus (hPSC-derived presomitic mesoderm / axioloid somite organoid) morphology" ;
        dct:description "The simulation script(s) 2019-diaza-human-somite-organoid-clock.py implement the cited source model as published and produce forms that match real Homo sapiens vs Mus musculus (hPSC-derived presomitic mesoderm / axioloid somite organoid) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 59.7/100, audit 2026-10-19-human-somite-organoid-clock-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py; output: docs/media/human_somite_organoid_clock_comparison.png; organism: Homo sapiens vs Mus musculus (hPSC-derived presomitic mesoderm / axioloid somite organoid); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 660586c9076da1ed7c1ed1d6e1b6ce7158ddbb20e73624b4efa3112652481b95; artifact_sha256: 7f4a0782ff9bc6d79e2680d35abc5364001e693e66cc1a16c30c8201405c9d18; input_dataset_sha256: {datasets/human_somite_organoid_clock/human_somite_organoid_clock_reference.json=0215c114f029234a..., datasets/human_somite_organoid_clock/human_somite_organoid_specimen.jpg=8b80971796cb29e2..., datasets/human_somite_organoid_clock/scout_manifest.json=a3af01b1b2956954...}" ;
        pk:derivedFromPaper <https://doi.org/10.1038/s41586-019-1885-9>,
            <https://doi.org/10.1038/s41586-022-05574-4>,
            <https://doi.org/10.1038/s41586-022-05649-2>,
            <https://doi.org/10.1126/science.aba7668> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-specimen-match> ;
        pk:weightOfEvidence "0.597"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py> a schema:SoftwareSourceCode ;
        rdfs:label "2019-diaza-human-somite-organoid-clock.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


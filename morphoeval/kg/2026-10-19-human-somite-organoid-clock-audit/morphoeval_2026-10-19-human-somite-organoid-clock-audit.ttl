        <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-human-somite-organoid-clock-audit-diaza-human-somite-organoid-clock-1> ;
    pk:hypothesisType "Delayed Autoinhibitory HES7 Oscillator with Intron Splicing Delay & NAD+/NADH Metabolic Tempo Scaling" ;
    pk:weightOfEvidence 5.97e-01 .


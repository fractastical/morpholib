sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-diaza-human-somite-organoid-clock> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-diaza-human-somite-organoid-clock-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Diaz-Cuadros et al. (2020, 2023) & Matsuda et al. (2020) human pluripotent stem-cell segmentation clock and metabolic tempo scaling model — Morphometric validation: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes the human/mouse period ratio, but Pass 1 requires 5 quantitative measurements including mouse WT period, human WT period, 6-regime empirical correlation r, 6-species allometric delay-period regression r, and bilateral specimen somite spacing CV." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2019-diaza-human-somite-organoid-clock.py L109–L128: Baseline measure_morphoeval() returning 1 metric <https://github.com/fractastical/morpholib/blob/317bc3c/2019-diaza-human-somite-organoid-clock.py#L109-L128>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-vs-mouse-hes7-segmentation-clock-period-ratio-t-human-t-mouse> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-vs-mouse-hes7-segmentation-clock-period-ratio-t-human-t-mouse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "human vs mouse HES7 segmentation clock period ratio T_human / T_mouse = 2.2887 dimensionless ratio" ;
        schema:measurementTechnique "ratio of simulated human WT vs mouse WT HES7 DDE oscillation periods" ;
        schema:name "human vs mouse HES7 segmentation clock period ratio T_human / T_mouse" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "2.2887" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-vs-mouse-hes7-segmentation-clock-period-ratio-t-human-t-mouse-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-diaza-human-somite-organoid-clock-measurement-human-vs-mouse-hes7-segmentation-clock-period-ratio-t-human-t-mouse-reference> a schema:PropertyValue ;
        dcterms:source "Diaz-Cuadros et al. (2020) Nature 580:113-118; Matsuda et al. (2020) Science 369:1450-1455" ;
        schema:value "2.459" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


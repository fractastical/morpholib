    <https://doi.org/10.1038/s41586-019-1885-9> dcterms:date "2020"^^xsd:gYear ;
        dcterms:title "In vitro characterization of the human segmentation clock" .

    <https://doi.org/10.1038/s41586-022-05574-4> dcterms:date "2023"^^xsd:gYear ;
        dcterms:title "Metabolic regulation of species-specific developmental rates" .

    <https://doi.org/10.1038/s41586-022-05649-2> dcterms:date "2023"^^xsd:gYear ;
        dcterms:title "Reconstituting human somitogenesis in vitro" .

    <https://doi.org/10.1126/science.aba7668> dcterms:date "2020"^^xsd:gYear ;
        dcterms:title "Species-specific oscillation periods of human and mouse segmentation clocks are due to cell autonomous properties of HES7" .

    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,

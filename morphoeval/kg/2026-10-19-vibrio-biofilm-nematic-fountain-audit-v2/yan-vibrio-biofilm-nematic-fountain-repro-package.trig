    <https://doi.org/10.1038/s41567-018-0356-9> dct:date "2019"^^xsd:gYear ;
        dct:title "Emergence of three-dimensional order and structure in growing biofilms" .
    <https://doi.org/10.1073/pnas.1601702113> dct:date "2016"^^xsd:gYear ;
        dct:title "Architectural transitions in Vibrio cholerae biofilms at single-cell resolution" .
    <https://doi.org/10.1073/pnas.1611494113> dct:date "2016"^^xsd:gYear ;
        dct:title "Vibrio cholerae biofilm growth program and architecture revealed by single-cell live imaging" .

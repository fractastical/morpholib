}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yan-vibrio-biofilm-nematic-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Beroz et al. (2018) Nature Physics & Hartmann et al. (2019) Nature Physics 3D rod-cell nematic verticalization and fountain flow in growing Vibrio cholerae biofilms — Reproducibility package: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "8-point `self_test()` suite (`L601-635`) verifying SHA-256 dataset integrity, parabolic radial stress & critical radius invariants, cell-length inverse square-root scaling slope (-0.50), radial expansion front trajectory, WT vs Delta rbmA and Delta bap1/rbmC controls, specimen rod cell segmentation, and two-run bitwise determinism (`np.allclose(..., atol=0.0)`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-repro-package-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2019-yan-vibrio-biofilm-nematic-fountain.py L601–L635" ;
        dct:description "8-check self_test() verifying SHA-256 digests, scaling laws, mutant controls, CV specimen, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L601-L635> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 095 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


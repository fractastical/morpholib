sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yan-vibrio-biofilm-nematic-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cell-length-sweep-1-4-4-5-um-critical-verticalization-radius-r-c-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cell-length sweep (1.4-4.5 um) critical verticalization radius R_c correlation = 0.9997 Pearson r" ;
        dcterms:description "RMSE = 0.049 um, p = 2.09e-09" ;
        schema:measurementTechnique "Pearson correlation between theoretical R_c(L) = sqrt(sigma_c(L)/kappa) and empirical onset radius across 7 A22/WT/cephalexin conditions (p=2.09e-09, RMSE=0.049 um)" ;
        schema:name "Cell-length sweep (1.4-4.5 um) critical verticalization radius R_c correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cell-length-sweep-1-4-4-5-um-critical-verticalization-radius-r-c-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cell-length-sweep-1-4-4-5-um-critical-verticalization-radius-r-c-correlation-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics 14:954-960 Figs. 2-3" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cephalexin-elongated-vs-a22-shortened-dome-height-amplification-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cephalexin-elongated vs A22-shortened dome height amplification delta = 8.0 um" ;
        dcterms:description "Cephalexin H_max = 23.34 um vs A22 H_max = 15.35 um" ;
        schema:measurementTechnique "Difference in 3D fountain dome peak height H_max between cephalexin (L=3.8 um) and A22 (L=1.4 um) biofilms at R = 22 um" ;
        schema:name "Cephalexin-elongated vs A22-shortened dome height amplification delta" ;
        schema:unitText "um" ;
        schema:value "8.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cephalexin-elongated-vs-a22-shortened-dome-height-amplification-delta-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cephalexin-elongated-vs-a22-shortened-dome-height-amplification-delta-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics 14:954-960 Fig. 3 (precocious vs delayed verticalization)" ;
        schema:value "8.2" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-delta-rbma-cohesion-loss-mutant-verticalized-core-radius-r-vert> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Delta rbmA cohesion-loss mutant verticalized core radius r_vert = 0.0 um" ;
        dcterms:description "Core S_z = -0.50 (flat horizontal monolayer)" ;
        schema:measurementTechnique "Negative control with reduced RbmA cell-substrate friction zeta = 0.12 Pa*h/um (sigma_rr(0) < sigma_c)" ;
        schema:name "Delta rbmA cohesion-loss mutant verticalized core radius r_vert" ;
        schema:unitText "um" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-delta-rbma-cohesion-loss-mutant-verticalized-core-radius-r-vert-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-delta-rbma-cohesion-loss-mutant-verticalized-core-radius-r-vert-reference> a schema:PropertyValue ;
        dcterms:source "Yan et al. (2016) PNAS 113:E5337-E5343 & Beroz et al. (2018) Nature Physics (Delta rbmA unverticalized control)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-log-log-cell-length-critical-radius-scaling-exponent-alpha-l-r-c-l-alpha-l> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Log-log cell-length critical radius scaling exponent |alpha_L| (R_c ~ L^alpha_L) = 0.5067 |exponent|" ;
        dcterms:description "Signed slope = -0.5067 ± 0.0048" ;
        schema:measurementTechnique "Log-log OLS regression slope |d log(R_c)/d log(L)| across L in [1.4, 4.5] um (SE ± 0.0048)" ;
        schema:name "Log-log cell-length critical radius scaling exponent |alpha_L| (R_c ~ L^alpha_L)" ;
        schema:unitText "|exponent|" ;
        schema:value "0.5067" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-log-log-cell-length-critical-radius-scaling-exponent-alpha-l-r-c-l-alpha-l-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-log-log-cell-length-critical-radius-scaling-exponent-alpha-l-r-c-l-alpha-l-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics 14:954-960 inverse square-root critical radius scaling (|-1/2| = 0.5)" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-radial-expansion-trajectory-6-25-um-verticalization-front-r-vert-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Radial expansion trajectory (6-25 um) verticalization front r_vert correlation = 1.0 Pearson r" ;
        dcterms:description "Front RMSE = 0.026 um" ;
        schema:measurementTechnique "Pearson correlation between r_vert(R) = sqrt(max(0, R^2 - R_c^2)) and empirical verticalization front across 8 expansion timepoints (RMSE=0.026 um, p=2.63e-16)" ;
        schema:name "Radial expansion trajectory (6-25 um) verticalization front r_vert correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-radial-expansion-trajectory-6-25-um-verticalization-front-r-vert-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-radial-expansion-trajectory-6-25-um-verticalization-front-r-vert-correlation-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics 14:954-960 Fig. 4 & Hartmann et al. (2019) Nature Physics" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-specimen-v-cholerae-empirical-rod-cell-aspect-ratio-l-d> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen V. cholerae empirical rod cell aspect ratio L/d = 2.584 ratio" ;
        dcterms:description "SD = ±0.764 across n = 73 cells" ;
        schema:measurementTechnique "Principal-axis inertia segmentation of n=73 surface-adhered Vibrio cholerae rods in vibrio_cholerae_biofilm_specimen.jpg" ;
        schema:name "Specimen V. cholerae empirical rod cell aspect ratio L/d" ;
        schema:unitText "ratio" ;
        schema:value "2.584" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-specimen-v-cholerae-empirical-rod-cell-aspect-ratio-l-d-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-specimen-v-cholerae-empirical-rod-cell-aspect-ratio-l-d-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics (WT L = 2.1 um, d = 0.8 um -> L/d = 2.625) & CDC PHIL specimen" ;
        schema:value "2.625" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-specimen-v-cholerae-segmented-surface-adhered-rod-cell-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen V. cholerae segmented surface-adhered rod cell count = 73 count" ;
        dcterms:description "In-plane 2D nematic order S2 = 0.140" ;
        schema:measurementTechnique "Green-channel absorption thresholding, binary morphology, and aspect-ratio filtering on vibrio_cholerae_biofilm_specimen.jpg" ;
        schema:name "Specimen V. cholerae segmented surface-adhered rod cell count" ;
        schema:unitText "count" ;
        schema:value "73" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-specimen-v-cholerae-segmented-surface-adhered-rod-cell-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-specimen-v-cholerae-segmented-surface-adhered-rod-cell-count-reference> a schema:PropertyValue ;
        dcterms:source "CDC Public Health Image Library File:Vibrio_cholerae_01.jpg empirical rod count" ;
        schema:value "73" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-rugose-central-vertical-nematic-order-parameter-s-z-core> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type rugose central vertical nematic order parameter S_z,core = 0.8363 order_parameter" ;
        dcterms:description "3D fountain dome peak height H_max = 18.5 um" ;
        schema:measurementTechnique "Mean vertical nematic order parameter <0.5*(3*cos^2(theta) - 1)> in central core of relaxed WT biofilm" ;
        schema:name "Wild-type rugose central vertical nematic order parameter S_z,core" ;
        schema:unitText "order_parameter" ;
        schema:value "0.8363" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-rugose-central-vertical-nematic-order-parameter-s-z-core-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-rugose-central-vertical-nematic-order-parameter-s-z-core-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics Fig. 1 & Hartmann et al. (2019) Nature Physics Fig. 2" ;
        schema:value "0.86" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-rugose-l-2-1-um-r-22-um-relaxed-verticalized-core-radius-r-vert> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type rugose (L = 2.1 um, R = 22 um) relaxed verticalized core radius r_vert = 18.74 um" ;
        dcterms:description "Analytic r_vert = 19.70 um" ;
        schema:measurementTechnique "2D Landau-de Gennes L-BFGS-B nematic tilt relaxation S_z(x,y) > 0 core radius at R = 22.0 um" ;
        schema:name "Wild-type rugose (L = 2.1 um, R = 22 um) relaxed verticalized core radius r_vert" ;
        schema:unitText "um" ;
        schema:value "18.74" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-rugose-l-2-1-um-r-22-um-relaxed-verticalized-core-radius-r-vert-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-rugose-l-2-1-um-r-22-um-relaxed-verticalized-core-radius-r-vert-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics 14:954-960 Fig. 4" ;
        schema:value "19.7" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2019-yan-vibrio-biofilm-nematic-fountain.py L503–L595" ;
        dcterms:description "9 quantitative morphometrics with p-values, RMSE, log-log slopes, Delta rbmA negative control, and specimen rod aspect ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L503-L595> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Beroz et al. (2018) Nature Physics & Hartmann et al. (2019) Nature Physics 3D rod-cell nematic verticalization and fountain flow in growing Vibrio cholerae biofilms — Morphometric validation: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L503-595) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: cell-length R_c Pearson r = 0.9997 (p = 2.09e-9, RMSE = 0.049 um), log-log cell-length exponent |alpha_L| = 0.5067 ± 0.0048 (ref 0.50), radial expansion front Pearson r = 1.0000 (p = 2.63e-16, RMSE = 0.026 um), relaxed WT verticalized core radius 18.74 um (ref 19.70 um), WT core vertical nematic order S_z = 0.8363 (ref 0.86), Delta rbmA verticalized radius 0.0 um (ref 0.0 um), cephalexin vs A22 dome height delta 8.00 um (ref 8.20 um), specimen rod aspect ratio L/d = 2.584 ± 0.764 (ref 2.625), and specimen segmented rod count 73 (ref 73)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cell-length-sweep-1-4-4-5-um-critical-verticalization-radius-r-c-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cephalexin-elongated-vs-a22-shortened-dome-height-amplification-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-delta-rbma-cohesion-loss-mutant-verticalized-core-radius-r-vert>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-log-log-cell-length-critical-radius-scaling-exponent-alpha-l-r-c-l-alpha-l>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-radial-expansion-trajectory-6-25-um-verticalization-front-r-vert-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-specimen-v-cholerae-empirical-rod-cell-aspect-ratio-l-d>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-specimen-v-cholerae-segmented-surface-adhered-rod-cell-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-rugose-central-vertical-nematic-order-parameter-s-z-core>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-rugose-l-2-1-um-r-22-um-relaxed-verticalized-core-radius-r-vert>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 095 Pass 2 Assessor)" ;

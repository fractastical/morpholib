sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yan-vibrio-biofilm-nematic-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-yan-vibrio-biofilm-nematic-fountain.py L95–L141" ;
        dcterms:description "Parabolic radial stress sigma_rr(r) = kappa*(R^2 - r^2), peeling threshold sigma_c(L), critical radius R_c(L), and front r_vert" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L95-L141> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2019-yan-vibrio-biofilm-nematic-fountain.py L147–L278" ;
        dcterms:description "2D circular colony pseudo-spectral + L-BFGS-B Landau-de Gennes nematic tilt and 3D fountain-flow dome minimizer" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L147-L278> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_095_vibrio_biofilm_nematic_fountain.lean L14–L108" ;
        dcterms:description "3 standalone Lean 4 theorems proving parabolic radial stress peak/edge, verticalization front onset & Delta rbmA control, and inverse cell-length scaling (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_095_vibrio_biofilm_nematic_fountain.lean#L14-L108> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Beroz et al. (2018) Nature Physics & Hartmann et al. (2019) Nature Physics 3D rod-cell nematic verticalization and fountain flow in growing Vibrio cholerae biofilms — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements parabolic radial compression stress and Hertzian rod-on-substrate peeling mechanics (`compute_verticalization_mechanics`, L95-141), a 2D pseudo-spectral + L-BFGS-B Landau-de Gennes vertical nematic tilt and 3D fountain-flow dome energy minimizer (`relax_nematic_fountain_biofilm`, L147-278), and all 5 genetic and pharmacological controls (`evaluate_genetic_and_pharmacological_controls`, L368-404), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_095_vibrio_biofilm_nematic_fountain.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .


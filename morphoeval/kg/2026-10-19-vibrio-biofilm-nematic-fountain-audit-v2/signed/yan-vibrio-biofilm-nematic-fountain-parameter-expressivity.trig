        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L638-L664> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Beroz et al. (2018) Nature Physics & Hartmann et al. (2019) Nature Physics 3D rod-cell nematic verticalization and fountain flow in growing Vibrio cholerae biofilms — Parameter expressivity: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Spans the 7-point A22/WT/cephalexin cell-length sweep L in [1.4, 4.5] um (L284-329), the 8-point radial expansion trajectory R(t) in [6.0, 25.0] um (L332-365), 5 genetic and pharmacological controls (WT rugose, Delta rbmA, Delta bap1 Delta rbmC, A22 short rods, cephalexin long rods, L368-404), and exposes `--L-cell-um`, `--R-colony-um`, `--zeta`, and `--seed` CLI overrides (L638-664)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yan-vibrio-biofilm-nematic-fountain> a pk:Claim ;
        rdfs:label "Beroz et al. (2018) Nature Physics & Hartmann et al. (2019) Nature Physics 3D rod-cell nematic verticalization and fountain flow in growing Vibrio cholerae biofilms faithfully reproduces Vibrio cholerae (wild-type, Delta rbmA, Delta bap1 Delta rbmC, and A22/cephalexin cell-length-perturbed biofilms) morphology" ;
        dcterms:description "The simulation script(s) 2019-yan-vibrio-biofilm-nematic-fountain.py implement the cited source model as published and produce forms that match real Vibrio cholerae (wild-type, Delta rbmA, Delta bap1 Delta rbmC, and A22/cephalexin cell-length-perturbed biofilms) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 93.7/100, audit 2026-10-19-vibrio-biofilm-nematic-fountain-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py; output: docs/media/vibrio_biofilm_nematic_fountain_comparison.png; organism: Vibrio cholerae (wild-type, Delta rbmA, Delta bap1 Delta rbmC, and A22/cephalexin cell-length-perturbed biofilms); checkpoint commit: https://github.com/fractastical/morpholib/commit/e93f00e; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: d831566c61695d418bb35d8095aa8c6100057ce72fecb5a3fc13843d4bcb5000; artifact_sha256: 80efda93e0c3882ec328cf498af02f1cdea57fadb6ad8c6fc92039fdefdc4e77; input_dataset_sha256: {datasets/vibrio_biofilm_nematic_fountain/paper_citations.bib=25b7c5d98c7e6bdc..., datasets/vibrio_biofilm_nematic_fountain/scout_manifest.json=17aa91569cbce80c..., datasets/vibrio_biofilm_nematic_fountain/vibrio_biofilm_nematic_fountain_reference.json=2f8c3198aefc7de1..., datasets/vibrio_biofilm_nematic_fountain/vibrio_cholerae_biofilm_specimen.jpg=d21370a429873aae...}; supersedes_audit_id: 2026-10-19-vibrio-biofilm-nematic-fountain-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1038/s41567-018-0170-4>,
            <https://doi.org/10.1038/s41567-018-0356-9>,
            <https://doi.org/10.1073/pnas.1601702113>,
            <https://doi.org/10.1073/pnas.1611494113> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-specimen-match> ;
        pk:weightOfEvidence "0.937"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py> a schema:SoftwareSourceCode ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> a pk:Claim ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, and PIN1-auxin phyllotactic mechanics faithfully reproduces Arabidopsis thaliana (shoot apical meristem L1 epidermis & floral primordia) morphology" ;
        dct:description "The simulation script(s) 2008-hamant-meristem-microtubule-stress.py implement the cited source model as published and produce forms that match real Arabidopsis thaliana (shoot apical meristem L1 epidermis & floral primordia) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.6/100, audit 2026-10-19-auxin-pin1-meristem-mechanics-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py; output: docs/media/auxin_pin1_meristem_mechanics_comparison.png; organism: Arabidopsis thaliana (shoot apical meristem L1 epidermis & floral primordia); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: e6283030cad9fe71483e6b95b0b71d85936ee41d7e76429d3b5bb4c3138dcc69; artifact_sha256: 8ca9f0c12dd0e2a7fbd9cd770e949c1f05694ecaf3598cc77067ea19e0dfa0f7; input_dataset_sha256: {datasets/auxin_pin1_meristem_mechanics/arabidopsis_sam_meristem_specimen.jpg=3a8b54b71f7c780c..., datasets/auxin_pin1_meristem_mechanics/auxin_pin1_meristem_mechanics_reference.json=db56b93840c38568..., datasets/auxin_pin1_meristem_mechanics/paper_citations.bib=f9f54880f2e74e09..., datasets/auxin_pin1_meristem_mechanics/scout_manifest.json=1c17f6d448f3c423...}" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.0509839103>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1371/journal.pbio.1000516>,
            <https://doi.org/10.1371/journal.pcbi.1002389> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-specimen-match> ;
        pk:weightOfEvidence "0.536"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py> a schema:SoftwareSourceCode ;
        rdfs:label "2008-hamant-meristem-microtubule-stress.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-mirabet-auxin-pin1-meristem-mechanics> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-mirabet-auxin-pin1-meristem-mechanics-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, and PIN1-auxin phyllotactic mechanics — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exposes only 2 trivial analytical ratios in `measure_morphoeval()` without ODE simulation error metrics, statistical p-values, ablation reorientation fractions, phyllotactic divergence angles, or specimen segmentation morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2008-hamant-meristem-microtubule-stress.py L44–L60: Only 2 analytical measurements without uncertainty or p-values <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py#L44-L60>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-spherical-dome-stress-anisotropy> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cylindrical_flank_hoop_to_axial_stress_ratio = 2.0 ratio" ;
        schema:measurementTechnique "Analytical thin-shell Laplace-Young ratio sigma_theta / sigma_z on cylindrical stem flank" ;
        schema:name "cylindrical_flank_hoop_to_axial_stress_ratio" ;
        schema:unitText "ratio" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-cylindrical-flank-hoop-to-axial-stress-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 1" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-spherical-dome-stress-anisotropy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "spherical_dome_stress_anisotropy = 0.0 dimensionless" ;
        schema:measurementTechnique "Analytical thin-shell stress anisotropy (sigma_1 - sigma_2)/(sigma_1 + sigma_2) on spherical dome" ;
        schema:name "spherical_dome_stress_anisotropy" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-spherical-dome-stress-anisotropy-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-mirabet-auxin-pin1-meristem-mechanics-measurement-spherical-dome-stress-anisotropy-reference> a schema:PropertyValue ;
        dcterms:source "Hamant et al. (2008) Science 322:1650-1655 Fig. 1" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2008-hamant-meristem-microtubule-stress.py L63–L100: No --self-test flag or automated invariant checks in Pass 1 <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-meristem-microtubule-stress.py#L63-L100>" ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 033 Pass 1 Assessor)" ;

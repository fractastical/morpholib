        rdfs:label "Hamant et al. (2008) & Heisler et al. (2010) pressurized SAM shell stress tensor, cortical microtubule alignment, and PIN1-auxin phyllotactic mechanics — Reproducibility package: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Runs deterministically to generate PNG and GIF outputs, but lacks a `--self-test` suite, SHA-256 integrity checks, and negative perturbation controls." ;

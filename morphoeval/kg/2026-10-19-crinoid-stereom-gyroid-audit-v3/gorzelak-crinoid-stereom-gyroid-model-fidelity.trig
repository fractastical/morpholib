sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P), Gibson-Ashby cellular mechanics, nanoindentation twin-band arrest FEM & syncytial ACC templating — Model fidelity to source: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: the Pass 2 3D nodal TPMS level sets, implicit-surface H/K and odd-inversion/half-fraction results remain correct (L287-478); the new FEM implements a genuine small-strain crystal-plasticity scheme — Q4 plane-strain stiffness (L670-689), Schmid resolved shear on two e-twin variants, perfectly plastic criterion with twin-shear exhaustion, initial-strain iteration with a single LU factorisation per structure, displacement-controlled flat punch, lattice vs monolith at equal depth (L692-868, L908-974) — and the pile-up scaling is the Eshelby-Frank-Nabarro formula (L871-905); the templating model encodes the Politi secondary-nucleation vs primary-nucleation distinction and the Beniash / Vidavsky vesicle-delivery picture (L1155-1269). Deductions: the Pass 2 [111] projection integrates along w in [0, 2 pi) instead of the full [111] period 2 pi sqrt(3) (L558), so Panel D's hexagonal contrast is a partial-period artefact, and its edge dislocation is a phase-winding ansatz with burgers_winding = 1.0 hard-coded (L582-592) (-4); the FEM is a 2D plane-strain honeycomb section of a 3D stretching-dominated lattice with one twin family, |tau| used for both twin senses (L798-802), no r/f slip, isotropic elasticity and no fracture, so it cannot be compared with Yang et al.'s load-depth or twin-band data (-3); the templating kinetics are unfitted model choices and the template is the adult honeycomb rather than a larval triradiate spicule (-2). Net -2 from v2." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2020-gorzelak-crinoid-stereom-gyroid.py L549–L603: DEFECT: [111] projection integrates w over [0, 2 pi) (L558) rather than the full 2 pi sqrt(3) period — projected D density is uniform over the full period; edge dislocation is an ansatz with burgers_winding = 1.0 hard-coded (L592) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L549-L603>",
            "models/2020-gorzelak-crinoid-stereom-gyroid.py L798–L802: Twin criterion uses |tau| for both variants and both senses — calcite e-twinning is polar; no r/f slip <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L798-L802>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L287–L478" ;
        dct:description "Pass 2 3D nodal TPMS field, implicit-surface mean/Gaussian curvature, solid fraction, nodal valence and (lookup) Euler characteristic — unchanged and still correct" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L287-L478> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L609–L974" ;
        dct:description "Pass 3 Section 4b: [111] honeycomb section rasteriser, Q4 plane-strain stiffness, crystal-plasticity twin FEM with initial-strain iteration, Eshelby-Frank-Nabarro pile-up, depth sweep lattice vs monolith" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L609-L974> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L1155–L1314" ;
        dct:description "Pass 3 Section 6b: stochastic syncytial ACC vesicle templating with secondary/primary nucleation and four ablations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L1155-L1314> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean L255–L379" ;
        dct:description "Laws 5-6: twin-lamella arrest bounded by strut chord, pile-up count/head stress monotone in glide length, twin-shear exhaustion; domain count = 1 + n_primary, templated acceptance ordering, monotone ACC depletion; lean exits 0, 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean#L255-L379> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment, executed by Claude Fable 5.1 Phase B subagent)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


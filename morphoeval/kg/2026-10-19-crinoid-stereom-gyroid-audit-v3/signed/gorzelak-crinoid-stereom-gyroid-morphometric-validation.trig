        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-elastic-flat-punch-indentation-stiffness-ratio-of-the-111-diamond-lattice-section-to-the-monolithic-single-crystal-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-elastic-flat-punch-indentation-stiffness-ratio-of-the-111-diamond-lattice-section-to-the-monolithic-single-crystal-reference> a schema:PropertyValue ;

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-crinoid-ossicle-sem-specimen-segmented-solid-calcite-volume-fraction-crinoid-stereom-ossicle-specimen-jpg-reference> a schema:PropertyValue ;

        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/crinoid_stereom_gyroid/crinoid_stereom_gyroid_reference.json L19–L19: DEFECT: Schoen (1970) DOI 10.1063/1.1665587 is a J. Math. Phys. DOI, not NASA TN D-5541; unverifiable offline, kept and flagged <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/crinoid_stereom_gyroid/crinoid_stereom_gyroid_reference.json#L19-L19>" ;

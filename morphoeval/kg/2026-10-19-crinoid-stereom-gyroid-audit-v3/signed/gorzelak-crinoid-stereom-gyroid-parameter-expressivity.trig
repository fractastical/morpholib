sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L2154–L2195" ;
        dcterms:description "CLI: --self-test, --skip-gif, --a0, --c-thresh, --e-calcite, --n-grid, --n-fe, --tau-twin, --seed routed into compute_pass3_models() and render_comparison_figure()" ;

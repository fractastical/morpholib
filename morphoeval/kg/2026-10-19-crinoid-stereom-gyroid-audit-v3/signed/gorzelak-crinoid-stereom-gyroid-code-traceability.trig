sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L1–L80" ;
        dcterms:description "Header docstring: Pass 3 additions A/B with stated reductions, ten sources with DOIs, offline-DOI caveat, six Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L1-L80> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L117–L149" ;
        dcterms:description "Model constants with inline provenance (Turner 1954 twin-plane angle, twin shear 0.694, De Bresser & Spiers Burgers vector, Vidavsky vesicle diameter) and 'model' flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L117-L149> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/gorzelak-crinoid-stereom-gyroid.yaml L104–L140" ;
        dcterms:description "Equations 5-6 registered with lean_locus #L255-L315 / #L317-L379 and single-range code_locus #L609-L974 / #L1155-L1314 (secondary #L1643-L1736 / #L1739-L1778)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/morphoeval/math_kg_loops/gorzelak-crinoid-stereom-gyroid.yaml#L104-L140> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P), Gibson-Ashby cellular mechanics, nanoindentation twin-band arrest FEM & syncytial ACC templating — Code-to-model traceability: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credit: the header docstring (L1-80) maps Sections 4b and 6b to the ten sources and the six Lean theorems, states the reductions (2D, one twin family, no r/f slip, no fracture) and flags refs 5-10 as offline-recalled; function docstrings cite the equation or paper step for the FEM, pile-up and templating code; model constants carry inline provenance comments (L117-138); the math-KG YAML registers equations 5-6 with single-range lean_locus / code_locus. Deductions: the Pass 2 [111] projection docstring claims to follow Yang et al. Figs. 2-3 while the implementation integrates a partial period and the dislocation is an ansatz whose comment asserts a winding of 1.0 that is simply assigned (L552-555, L591-592) (-3); the E/10 'cleavage scale' line (L1714-1716) is a scale marker presented beside measured quantities (-1); DEFAULT_TAU_TWIN_MPA = 500 (L118) is a scale parameter whose role is explained in the comment but the pile-up head stress at this tau in a 6 um strut (147 GPa) is unphysical and not flagged in the panel (-1). Net -1 from v2." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "models/2020-gorzelak-crinoid-stereom-gyroid.py L1714–L1716: e_cleave = E/10 drawn as a 'cleavage scale' marker — a scale line, not a measured cleavage stress <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L1714-L1716>",
            "models/2020-gorzelak-crinoid-stereom-gyroid.py L552–L555: DEFECT: docstring claims Yang et al. Figs. 2-3 projections while the code integrates a partial [111] period and hard-codes the Burgers winding <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L552-L555>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment, executed by Claude Fable 5.1 Phase B subagent)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

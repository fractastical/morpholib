sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P), Gibson-Ashby cellular mechanics, nanoindentation twin-band arrest FEM & syncytial ACC templating — Reproducibility package: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: `--self-test` passes 11/11 checks in 5.3 s (L2030-2152), including the Pass 3 JSON SHA pin and 13-constant JSON/code parity (L2095-2100), section phi = 0.50 and single connected solid, monolith onset calibration, convergence / gamma / tau bounds for every depth, lattice < monolith twinning, bitwise FEM determinism and bitwise templating determinism; the default render completes in 8.5 s and the growth GIF is byte-identical after re-render; the loop telemetry run exists with ledger artifacts. Deductions: the FEM determinism check runs on a reduced 60-element mesh (L2121-2123), not the default 120-element mesh (-2); self-test tolerances are loose and partly self-fulfilling — `domains_templated_max = 2`, `domains_primary_ablation_min = 50`, IoU margin 0.15 (L2127-2131, JSON L70-72) and the specimen assertions phi ~ 0.5187 / a_0 ~ 14.80 (L2078-2079) test the script's own Pass 2 outputs (-3); `docs/media/*.png` are gitignored so the comparison and FEM PNGs are not tracked and the repro package relies on regeneration (-2); no requirements lock file is cited for this slot (-1). Unchanged from v2." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "models/2020-gorzelak-crinoid-stereom-gyroid.py L2078–L2079: DEFECT: specimen assertions phi ~ 0.5187 and a_0 ~ 14.80 um test the script's own Pass 2 outputs (self-fulfilling) <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L2078-L2079>",
            "models/2020-gorzelak-crinoid-stereom-gyroid.py L2121–L2131: DEFECT: determinism check on reduced 60-element mesh; loose domain thresholds (<= 2, >= 50) read from the JSON <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L2121-L2131>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L2030–L2152" ;
        dct:description "11-check self_test(): SHA pins, JSON parity, 3D TPMS invariants, Gibson-Ashby, specimen, Pass 3 FEM bounds + determinism, templating fidelity + ablations + determinism, 16 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L2030-L2152> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L2095–L2135" ;
        dct:description "Pass 3 checks 9-11: JSON/code parity, section/pile-up geometry, onset calibration, per-depth convergence and bounds, pore-arrest, k ratio, FEM determinism (60-el mesh), templating IoU/inside fraction/domains/secondary share/monotonicity/determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L2095-L2135> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment, executed by Claude Fable 5.1 Phase B subagent)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


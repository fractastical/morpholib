sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P), Gibson-Ashby cellular mechanics, nanoindentation twin-band arrest FEM & syncytial ACC templating — Morphological realism / specimen match: 85/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credit: the SHA-256-locked CC BY 4.0 Nesometra integra SEM plate is still segmented by DoG (L1063-1152) and shown as Panel F (L1520-1546); the new FEM and templating panels (G/H/I, L1547-1640) and the two new media files render the predicted twin maps, depth sweeps and domain maps and were visually verified. Deductions: the specimen is an adult crinoid calyx ossicle while the slot organism is Metacrinus rotundus and the seed paper's is the starfish Protoreaster nodosus; the larval-spicule model has no larval specimen at all (-4); the JSON reference values phi = 0.5187, a_0 = 14.80 um, CV = 0.336 (JSON L43-49) are the script's own Pass 2 outputs written back and DEFAULT_A0_UM = 14.80 (L140) was set from them, so the specimen match is self-referential (-4); Panel K being a [111] hexagonal TPMS projection is an assumption and the 0.752 um/px calibration has no stated provenance (L2021) (-2); no comparison with Yang et al.'s twin-band micrographs (-1). Net -5 from v2." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/crinoid_stereom_gyroid/crinoid_stereom_gyroid_reference.json L43–L49: DEFECT: reference_solid_fraction_panel_k, reference_lattice_period_um, reference_period_cv are the script's own Pass 2 outputs, not independent specimen values <https://github.com/fractastical/morpholib/blob/9987db7d/datasets/crinoid_stereom_gyroid/crinoid_stereom_gyroid_reference.json#L43-L49>",
            "models/2020-gorzelak-crinoid-stereom-gyroid.py L2018–L2027: DEFECT: a_0 reference 14.80 um with source 'Yang et al. 2022 a_0 = 13.8-15.2 um' — that range is the synthetic table's, not a verified paper value; 0.752384 um/px calibration unsourced <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L2018-L2027>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-6> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L1063–L1152" ;
        dct:description "DoG trabecular and pore segmentation of the SHA-256-locked crinoid ossicle SEM plate (Panels I/J/K)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L1063-L1152> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L1547–L1640" ;
        dct:description "Panels G (lattice vs monolith twin maps), H (depth sweep + pile-up inset), I (templated domain map + ACC time series) in the 3x3 main figure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987db7d/models/2020-gorzelak-crinoid-stereom-gyroid.py#L1547-L1640> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/crinoid_stereom_gyroid_comparison.png (generated output)" ;
        dct:description "Regenerated 3x3 main figure (Panels A-I): TPMS level sets, curvature, threshold sweep, [111] projection (flagged), 12-species collapse (flagged), specimen segmentation, FEM twin maps, depth sweep, templating domain map — docs/media/crinoid_stereom_gyroid_comparison.png: rendered output of models/2020-gorzelak-crinoid-stereom-gyroid.py at 9987db7d, image/png, 1042390 B, 2187×2133 px, artifact_sha256 108bc444ec648e58338e88b86748dfcde5d8cb560cbb23f515e41a09883e349e (sha256 108bc444ec648e58338e88b86748dfcde5d8cb560cbb23f515e41a09883e349e), spec_fingerprint ac9f4ac4b8e557301e259e7d30ec4d97d4e8114ecfa867c705d25665fdc0a463" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/crinoid_stereom_gyroid_growth.gif (generated output)" ;
        dct:description "Co-evolving Diamond/Gyroid growth GIF, byte-identical after the Pass 3 re-render — docs/media/crinoid_stereom_gyroid_growth.gif: rendered output of models/2020-gorzelak-crinoid-stereom-gyroid.py at 9987db7d, image/gif, 176592 B, 1092×482 px, 7 frames, artifact_sha256 a18ed4769a15ac5d61fb9a05beb5a51622a4050b87a9c340a9f049039c26cc92 (sha256 a18ed4769a15ac5d61fb9a05beb5a51622a4050b87a9c340a9f049039c26cc92), spec_fingerprint ac9f4ac4b8e557301e259e7d30ec4d97d4e8114ecfa867c705d25665fdc0a463" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/crinoid_stereom_gyroid_twin_arrest_fem.png (generated output)" ;
        dct:description "New 4-panel FEM figure: lattice gamma map, monolith gamma map, depth sweep with P/P_el and twin work, Eshelby pile-up vs tau — docs/media/crinoid_stereom_gyroid_twin_arrest_fem.png: rendered output of models/2020-gorzelak-crinoid-stereom-gyroid.py at 9987db7d, image/png, 321297 B, 1820×1540 px, artifact_sha256 83850e21f81674f3eebef09f6915c296e844fd33da3996058627c6ff8ccc155a (sha256 83850e21f81674f3eebef09f6915c296e844fd33da3996058627c6ff8ccc155a), spec_fingerprint ac9f4ac4b8e557301e259e7d30ec4d97d4e8114ecfa867c705d25665fdc0a463" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match-6> a pk:EvidenceItem ;
        rdfs:label "docs/media/crinoid_stereom_gyroid_spiculogenesis.gif (generated output)" ;
        dct:description "New 12-frame GIF: templated vs untemplated mineral maps and ACC-fraction curves every 4 h — docs/media/crinoid_stereom_gyroid_spiculogenesis.gif: rendered output of models/2020-gorzelak-crinoid-stereom-gyroid.py at 9987db7d, image/gif, 1259602 B, 1320×459 px, 12 frames, artifact_sha256 9a0aef7791cae93594994b2116528a15ba43c8dc604be45b0a8bfc4b49ecffb2 (sha256 9a0aef7791cae93594994b2116528a15ba43c8dc604be45b0a8bfc4b49ecffb2), spec_fingerprint ac9f4ac4b8e557301e259e7d30ec4d97d4e8114ecfa867c705d25665fdc0a463" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 3 remediated assessment, executed by Claude Fable 5.1 Phase B subagent)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


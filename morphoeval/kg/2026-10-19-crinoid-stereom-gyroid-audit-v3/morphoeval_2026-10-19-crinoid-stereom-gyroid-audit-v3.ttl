<https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability-1> a pk1:EvidenceItem ;
    rdfs:label "models/2020-gorzelak-crinoid-stereom-gyroid.py L1–L80" ;

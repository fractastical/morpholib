sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking & Lovén's Law — Model fidelity to source: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates a static algebraic dispersion curve sigma(m) and analytic cosine ring envelope to illustrate m* = 5, but omits time-stepping the Gierer-Meinhardt activator-inhibitor PDE during hydrocoel crescent-to-ring closure, omits Lovén's Law (II, IV, I, III, V) sequential initiation, and omits Duboc et al. (2005) Nodal left-right twin-rudiment (2x5) symmetry breaking." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity-1> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2005-meinhardt-echinoderm-pentaradial-symmetry.py L33–L82" ;
        dct:description "Algebraic dispersion and static cosine ring envelope without PDE integration, Lovén's Law, or Nodal L-R perturbations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L33-L82> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-1>,
        <https://w3id.org/probknow/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-2>,
        <https://w3id.org/probknow/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-3> .

<https://w3id.org/probknow/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Circular Hydrocoel Ring Laplacian Eigenvalue & Pentaradial Mode m^* = 5 Selection Law" ;
    dct:description "Governs spontaneous symmetry breaking of the closed circular left hydrocoel ring into 5 primary podia lobes spaced at 72 deg, while explaining 4-rayed (90 deg) and 6-rayed (60 deg) teratological variants under ring-radius perturbations | Variables: m in {3, 4, 5, 6, 7}: azimuthal harmonic mode on closed hydrocoel ring; R_ring: hydrocoel ring radius (um); lambda_c: Turing critical wavelength (um); Delta_theta = 360 deg / m: inter-ambulacral angular spacing" ;
    dct:source "Meinhardt (2008) Curr. Top. Dev. Biol. 81:1-63; Morris (2012) Evol. Dev. 14(4):313-326" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L145-L310>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L24-L85> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def ring_laplacian_eigen_num (m : Nat) : Nat := m * m
def hydrocoel_angular_period_deg (m : Nat) : Nat := 360 / m
theorem hydrocoel_ring_pentaradial_mode5_selection :
    ring_laplacian_eigen_num 5 = 25 ∧
    hydrocoel_angular_period_deg 5 = 72 ∧
    5 * hydrocoel_angular_period_deg 5 = 360 ∧
    hydrocoel_turing_growth_score 5 50 > hydrocoel_turing_growth_score 4 50 ∧
    hydrocoel_turing_growth_score 5 50 > hydrocoel_turing_growth_score 6 50 := by decide
"""^^pk:lean4 ;
    skos:notation "- (1 / R_ring^2) d^2(cos(m theta))/dtheta^2 = (m^2 / R_ring^2) cos(m theta),   m^* = argmax_m sigma(m / R_ring) = 5 (Delta_theta = 72 deg) when 2*pi R_ring / lambda_c in (4.5, 5.5)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0070-2153(07)81001-5>,
        <https://doi.org/10.1016/j.devcel.2005.05.008>,
        <https://doi.org/10.1093/icb/38.6.965>,
        <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
        <https://doi.org/10.5962/bhl.title.46385> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering & Duboc Nodal Left-Right Rudiment Multiplicity" ;
    pk:leanDeclaration "MathOfBiology.Loop_075.hydrocoel_turing_growth_score" ;
    pk:leanTheorem "MathOfBiology.Loop_075.hydrocoel_ring_pentaradial_mode5_selection" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lovén's Law (1874) & Morris (2012) Hydrocoel Crescent Initiation Ordering (II, IV, I, III, V)" ;
    dct:description "Explains how progressive anterior-to-posterior activation along the closing bilateral hydrocoel crescent generates Lovén's invariant asymmetric biserial peristomial plate law across Echinoidea | Variables: r in {1..5}: developmental initiation rank during crescent-to-ring closure; I..V: Lovén ambulacral ray indices; (a, b): counter-clockwise half-ambulacral plate columns" ;
    dct:source "Lovén (1874) K. Sven. Vetensk.-Akad. Handl. 11(7):1-91; Mooi & David (1998) Am. Zool. 38:965-974; Morris (2012) Evol. Dev. 14:313-326" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L315-L385>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L91-L154> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def loven_initiation_rank_to_ray : Nat → Nat
  | 1 => 2 | 2 => 4 | 3 => 1 | 4 => 3 | 5 => 5 | _ => 0
theorem loven_law_crescent_ordering_and_asymmetric_biserial_rule :
    loven_initiation_rank_to_ray 1 = 2 ∧
    loven_initiation_rank_to_ray 5 = 5 ∧
    (loven_b_column_enlarged 1 + loven_b_column_enlarged 2 +
     loven_b_column_enlarged 3 + loven_b_column_enlarged 4 +
     loven_b_column_enlarged 5) = 2 := by decide
"""^^pk:lean4 ;
    skos:notation "Initiation rank r in {1..5} -> Ray (II, IV, I, III, V) = (C, A, D, B, E);   Peristomial biserial dominance: (Ib, IIb, IIIa, IVa, Va) = (ba, ba, ab, ab, ab)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0070-2153(07)81001-5>,
        <https://doi.org/10.1016/j.devcel.2005.05.008>,
        <https://doi.org/10.1093/icb/38.6.965>,
        <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
        <https://doi.org/10.5962/bhl.title.46385> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering & Duboc Nodal Left-Right Rudiment Multiplicity" ;
    pk:leanDeclaration "MathOfBiology.Loop_075.loven_initiation_rank_to_ray" ;
    pk:leanTheorem "MathOfBiology.Loop_075.loven_law_crescent_ordering_and_asymmetric_biserial_rule" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/meinhardt-echinoderm-pentaradial-symmetry-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Duboc et al. (2005) Right-Sided Nodal Signaling & Bilateral Twin-Rudiment Multiplicity Law" ;
    dct:description "Links bilateral pluteus left-right axis specification (right-sided Nodal/BMP2-4 cascade) to asymmetric restriction of pentaradial adult rudiment formation to the left hydrocoel | Variables: nodal_left, nodal_right in {0, 1}: left/right ectodermal Nodal signaling activity; N_rings: number of functional hydrocoel rings; N_podia: total primary podia lobes" ;
    dct:source "Duboc et al. (2005) Dev. Cell 9(1):147-158" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L390-L445>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_075_echinoderm_pentaradial_symmetry.lean#L160-L192> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def active_hydrocoel_rings (nodal_left nodal_right : Nat) : Nat :=
  (if nodal_left == 0 then 1 else 0) + (if nodal_right == 0 then 1 else 0)
def total_primary_podia (m_ring nodal_left nodal_right : Nat) : Nat :=
  m_ring * active_hydrocoel_rings nodal_left nodal_right
theorem duboc_nodal_left_right_rudiment_multiplicity :
    total_primary_podia 5 0 1 = 5 ∧
    total_primary_podia 5 0 0 = 10 ∧
    total_primary_podia 5 1 1 = 0 := by decide
"""^^pk:lean4 ;
    skos:notation "N_rings = I(Nodal_L = 0) + I(Nodal_R = 0),   N_podia = 5 * N_rings in {5 (WT: Nodal_R = 1), 10 (Nodal LOF: Nodal_L = Nodal_R = 0, twin 2x5 rudiments), 0 (Nodal GOF: Nodal_L = Nodal_R = 1)}" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0070-2153(07)81001-5>,
        <https://doi.org/10.1016/j.devcel.2005.05.008>,
        <https://doi.org/10.1093/icb/38.6.965>,
        <https://doi.org/10.1111/j.1525-142X.2012.00552.x>,
        <https://doi.org/10.5962/bhl.title.46385> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering & Duboc Nodal Left-Right Rudiment Multiplicity" ;
    pk:leanDeclaration "MathOfBiology.Loop_075.total_primary_podia" ;
    pk:leanTheorem "MathOfBiology.Loop_075.duboc_nodal_left_right_rudiment_multiplicity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


        <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-echinoderm-pentaradial-symmetry-audit-meinhardt-echinoderm-pentaradial-symmetry-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-echinoderm-pentaradial-symmetry-audit-meinhardt-echinoderm-pentaradial-symmetry-2> ;
    pk:hypothesisType "Circular-Ring Activator-Inhibitor Mode m=5 Selection (k_m = m / R_ring), Lovén's Law (II, IV, I, III, V) Ocular/Ambulacral Ordering & Duboc Nodal Left-Right Rudiment Multiplicity" ;
    pk:weightOfEvidence 5.17e-01 .


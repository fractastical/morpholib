sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pentaradial inter-ambulacral angular spacing Delta_theta = 72.0 deg" ;
        schema:measurementTechnique "360 / m^* for canonical hydrocoel ring radius R_ring=75 um" ;
        schema:name "Pentaradial inter-ambulacral angular spacing Delta_theta" ;
        schema:unitText "deg" ;
        schema:value "72.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta-reference> a schema:PropertyValue ;
        dcterms:source "Morris (2012) Evol. Dev. 14:313-326" ;
        schema:value "72.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-selected-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Selected hydrocoel ring primary podia mode m^* at R_ring=75 um = 5.0 lobes" ;
        schema:measurementTechnique "Argmax of circular-ring Turing dispersion relation sigma(m; R_ring=75 um)" ;
        schema:name "Selected hydrocoel ring primary podia mode m^* at R_ring=75 um" ;
        schema:unitText "lobes" ;
        schema:value "5.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-selected-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-selected-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um-reference> a schema:PropertyValue ;
        dcterms:source "Morris (2012) Evol. Dev. 14:313-326 & Meinhardt (2008)" ;
        schema:value "5.0" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking & Lovén's Law — Morphometric validation: 50/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exposes only 2 scalar metrics in `measure_morphoeval()` without testing the hydrocoel ring mode staircase, Lovén's Law ray initiation rank correlation, Duboc Nodal LOF 2x5 twin-rudiment podia count, or specimen C_5 Fourier power." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2005-meinhardt-echinoderm-pentaradial-symmetry.py L137–L159: Only 2 baseline metrics in measure_morphoeval() <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L137-L159>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-pentaradial-inter-ambulacral-angular-spacing-delta-theta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-measurement-selected-hydrocoel-ring-primary-podia-mode-m-at-r-ring-75-um> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .


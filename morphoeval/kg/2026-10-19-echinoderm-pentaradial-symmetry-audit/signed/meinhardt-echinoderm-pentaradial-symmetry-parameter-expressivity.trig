sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-meinhardt-echinoderm-pentaradial-symmetry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-meinhardt-echinoderm-pentaradial-symmetry-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Morris (2012), Mooi & David (1998) & Meinhardt (2008) echinoderm bilateral-to-pentaradial hydrocoel ring symmetry breaking & Lovén's Law — Parameter expressivity: 49/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 4 ring radii in the GIF loop, but lacks a full mode-selection staircase across 2*pi*R_ring/lambda_c spanning m in {3, 4, 5, 6, 7}, lacks Nodal LOF/GOF perturbation sweeps, and provides no CLI parameter flags." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2005-meinhardt-echinoderm-pentaradial-symmetry.py L118–L134: Basic 4-radius loop without full mode staircase or CLI parameter overrides <https://github.com/fractastical/morpholib/blob/HEAD/2005-meinhardt-echinoderm-pentaradial-symmetry.py#L118-L134>" ;
        pk:hasScore "0.49"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


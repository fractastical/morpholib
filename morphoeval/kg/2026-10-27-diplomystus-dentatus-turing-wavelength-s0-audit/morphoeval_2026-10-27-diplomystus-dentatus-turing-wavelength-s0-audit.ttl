<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-diplomystus-dentatus-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Diplomystus dentatus detail-tier Turing wavelength (184.3 µm, 51.5 Ma) — Code-to-model traceability: 84/100" ;

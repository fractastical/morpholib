<https://w3id.org/delphi/resource/evidence/2026-10-27-diplomystus-dentatus-turing-wavelength-s0-audit-delphi10000-diplomystus-dentatus-turing-wavelength-s0-1> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "discrete-Laplacian dispersion Pearson r" ;
    dct:description "Pearson r between analytic σ(k) using k^2=(2-2cos q)/dx^2 and growth of pure modes in the explicit periodic scheme" ;
    rdfs:comment "n=11 modes, RMSE=0.00033 per time unit" ;
    schema:about "Diplomystus dentatus (Green River Eocene armored herring)" ;
    schema:error 0e+00 ;
    schema:targetValue 1e+00 ;
    schema:unitText "1" ;
    schema:value 1e+00 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-diplomystus-dentatus-turing-wavelength-s0-audit-delphi10000-diplomystus-dentatus-turing-wavelength-s0-2> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "dispersion growth-rate RMSE" ;
    dct:description "RMSE of measured versus analytic σ on the same discrete modes" ;
    rdfs:comment "nonzero because of the explicit Euler transient and the quadratic term at finite amplitude" ;
    schema:about "Diplomystus dentatus (Green River Eocene armored herring)" ;
    schema:error 3.3e-02 ;
    schema:targetValue 0e+00 ;
    schema:unitText "1/time" ;
    schema:value 3.3e-04 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-diplomystus-dentatus-turing-wavelength-s0-audit-delphi10000-diplomystus-dentatus-turing-wavelength-s0-3> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "flank radial-FFT wavelength" ;
    dct:description "power-weighted radial FFT peak of the Neumann Schnakenberg field; D_u solved so onset λ_c=184.3 µm" ;
    rdfs:comment "relative error 0.0094; D_u=2.694010e-10 m^2/s, D_v/D_u=9.17" ;
    schema:about "Diplomystus dentatus (Green River Eocene armored herring)" ;
    schema:error 9.434e-01 ;
    schema:targetValue 1.843e+02 ;
    schema:unitText "µm" ;
    schema:value 1.860387e+02 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-diplomystus-dentatus-turing-wavelength-s0-audit-delphi10000-diplomystus-dentatus-turing-wavelength-s0-4> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "diffusivity-sweep wavelength Pearson r" ;
    dct:description "Pearson r of predicted s*184.3 µm versus measured λ when both diffusivities scale by s^2, s in {0.72,0.88,1,1.18,1.46}" ;
    rdfs:comment "sweep RMSE 5.67 µm" ;
    schema:about "Diplomystus dentatus (Green River Eocene armored herring)" ;
    schema:error 2.765e-01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "1" ;
    schema:value 9.97235e-01 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-diplomystus-dentatus-turing-wavelength-s0-audit-delphi10000-diplomystus-dentatus-turing-wavelength-s0-5> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "equal-diffusion ablation std ratio" ;
    dct:description "final/initial std of a linearised perturbation when D_v is set equal to D_u (Turing band removed)" ;
    rdfs:comment "control: ratio near 0 means the homogeneous state is restored; ratio 1 would be a failed ablation" ;
    schema:about "Diplomystus dentatus (Green River Eocene armored herring)" ;
    schema:error 9.68526e+01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "1" ;
    schema:value 3.1474e-02 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-diplomystus-dentatus-turing-wavelength-s0-audit-delphi10000-diplomystus-dentatus-turing-wavelength-s0-6> a schema:QuantitativeValue,

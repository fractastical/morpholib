    rdfs:comment "negative σ: the cell-scale predecessor cannot carry the 184.3 µm wave" ;
    schema:about "Diplomystus dentatus (Green River Eocene armored herring)" ;
    schema:error 5.958628e+02 ;
    schema:targetValue 0e+00 ;
    schema:unitText "1/time" ;
    schema:value -5.958628e+00 .

<https://w3id.org/delphi/resource/evidence/2026-10-27-diplomystus-dentatus-turing-wavelength-s0-audit-delphi10000-diplomystus-dentatus-turing-wavelength-s0-7> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "specimen flank vertical-element spacing" ;
    dct:description "high-pass FFT along the PCA major axis of the segmented Descouens fish; 48 cm caption length calibrates the axis" ;

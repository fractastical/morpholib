sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Model fidelity to source: 80/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "The three parameters now mean what Raup's model says they mean, and the script proves it on its own output: W is the per-revolution magnification of every dimension, D the inner/outer-margin ratio of the generating curve, T the axial over radial movement of its centre, and the generating curve lies in the plane through the axis, so the shells are self-similar tubes rather than flat ribbons. The three defects of the first version are each named in the docstring and each is excluded by the self-test. Not higher because the primary paper was not consulted: the definitions are taken from two secondary restatements (which agree with each other on W, D and T up to Noshita's 2/(1+D) scaling of T, which is noted), the direction of the S ratio is the repository's convention rather than Raup's, and Raup's generating curve is an arbitrary aperture outline, here always an ellipse." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-6> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L20–L36" ;
        dct:description "the four parameters defined, with the equations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L20-L36> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L96–L104" ;
        dct:description "raup_shell(): a, r_c, z_c, generating curve in the radial-axial plane" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L96-L104> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L38–L45" ;
        dct:description "the three defects of the first version and how each is now excluded" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L38-L45> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L134–L157" ;
        dct:description "self_test(): recovery to 1e-9, spire monotone in T, planispiral one aperture thick" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L134-L157> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "1966-raup.py L28–L37" ;
        dct:description "the same generating function in the minimal script" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/1966-raup.py#L28-L37> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "datasets/raup/variables.json L134–L140" ;
        dct:description "mathematical_formulation: the equations as implemented, with their source" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/datasets/raup/variables.json#L134-L140> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2014.08.010>,

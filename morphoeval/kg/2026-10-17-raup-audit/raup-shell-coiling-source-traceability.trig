sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Source and data traceability: 75/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Raup 1962, 1965 and 1966 are cited with DOIs (the 1966 JSTOR id, wrong in the dataset since 2025, is corrected), the two secondary sources the definitions actually come from are cited with DOIs and the specific statement used from each is given, and the dataset says plainly which of its earlier contents could not be verified and why they were replaced. Not higher because the primary paper was not read, so nothing here is pinned to a page or equation of Raup 1966, and because the parameter sets and ranges are the author's illustrative choices with no external source." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-source-traceability-4> ;
        pk:hasScore "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L6–L18" ;
        dct:description "citation block with DOIs; which definitions come from which secondary source" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L6-L18> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/raup/README.md L1–L30" ;
        dct:description "revision notice: what was unverifiable and what replaced it" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/datasets/raup/README.md#L1-L30> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/raup/variables.json L10–L10" ;
        dct:description "revision_2026_10_17 provenance note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/datasets/raup/variables.json#L10-L10> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/raup/paper_citations.bib L1–L70" ;
        dct:description "DOIs added; JSTOR 1301992" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/datasets/raup/paper_citations.bib#L1-L70> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2014.08.010>,

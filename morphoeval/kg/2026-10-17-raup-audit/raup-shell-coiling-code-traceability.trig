sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Code-to-model traceability: 75/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "The docstring maps each parameter to its definition and its line of code, the generating function is commented line by line with the identity each line enforces, the self-test names what it excludes, and the parameter sets carry a note on why each value. Not higher because the equations are tied to the secondary sources' notation rather than to numbered equations of Raup 1966." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-code-traceability-3> ;
        pk:hasScore "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L81–L107" ;
        dct:description "raup_shell() docstring and comments" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L81-L107> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1966-raup.py L1–L18" ;
        dct:description "equations in the module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/1966-raup.py#L1-L18> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/raup/README.md L32–L52" ;
        dct:description "the model as a table: symbol, equation, meaning" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/datasets/raup/README.md#L32-L52> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


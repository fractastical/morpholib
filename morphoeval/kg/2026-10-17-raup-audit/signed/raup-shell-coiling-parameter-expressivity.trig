}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Parameter expressivity: 70/100" ;
        rdfs:comment "Each of W, D, T now has its own visible monotone effect, shown on two sheets (W x D at fixed T, W x T at fixed D) and on the 3 x 3 W x T slice of 1966-raup.py, and the self-test asserts the T effect. S is exposed in the function but not swept in any figure, and D is swept only together with W rather than on its own; the ranges on the sheets are the dataset's indicative bounds, not Raup's. Evidence: create_raup_animations.py L236–L259: create_parameter_space_visualization(): the two sheets <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L236-L259>; 1966-raup.py L40–L71: W x T slice at fixed D <https://github.com/fractastical/morpholib/blob/ba6fd20/1966-raup.py#L40-L71>; create_raup_animations.py L147–L151: spire_over_width strictly increasing in T asserted <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L147-L151>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-parameter-expressivity> ;
        pk:hasProbability "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-parameter-expressivity> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens)" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


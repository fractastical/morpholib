}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Morphological realism / specimen match: 45/100" ;
        rdfs:comment "The six forms are now distinct and each is what its name says (spire/width 0.00 for the two planispirals, 0.86 for the turreted form, 0.74 high-spired, 0.48 conical, 0.34 globose), and the panel titles and a figure footnote say that the taxon names are resemblances, not specimens. But there is still no real shell in the figure and no measured specimen the panels are tested against, which is what the dimension asks for; the labels are honest, not validated. Scored above the 30 of the first audit because the forms are no longer wrong, below the midpoint because nothing checks that a Turritella looks like the turreted panel. Evidence: raup_empirical_comparison.png (generated output, not in repo): six panels, each a different form; footnote on provenance — raup_empirical_comparison.png: rendered output of create_raup_animations.py at ba6fd20, image/png, 562658 B, 1630×1070 px, sha256 c50dbee57d0a64950d5470aed25583817eb8d39b97bcf2a7b89b991973f63ef7; raup_shell_animation.gif (generated output, not in repo): side view: a tower, a cone, a disc, an involute coil; overhead: the log spirals — raup_shell_animation.gif: rendered output of create_raup_animations.py at ba6fd20, image/gif, 15189434 B, 1200×800 px, 100 frames, sha256 986555a0032be189233cbf0ec15193959bf7f9cc0b1e099a6b7a289f7cff8b02; create_raup_animations.py L174–L176: ILLUSTRATIVE: the footnote text <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L174-L176>; datasets/raup/variables.json L66–L133: the six parameter sets with a note on why each value <https://github.com/fractastical/morpholib/blob/ba6fd20/datasets/raup/variables.json#L66-L133>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-specimen-match> ;
        pk:hasProbability "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-specimen-match> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> a pk:Claim ;
        rdfs:label "Raup shell coiling morphospace faithfully reproduces Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens) morphology" ;
        dct:description "The simulation script(s) create_raup_animations.py, 1966-raup.py implement the cited source model as published and produce forms that match real Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 64.1/100, audit 2026-10-17-raup-audit) and the assessments." ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py, https://github.com/fractastical/morpholib/blob/ba6fd20/1966-raup.py; output: raup_shell_animation.gif; organism: Coiled molluscs in general; the six panels are labelled cf. Nautilus, Turritella, an ammonite, Conus, Cerithium, Helix (resemblance, not specimens); checkpoint commit: https://github.com/fractastical/morpholib/commit/ba6fd20; environment: python 3.14.7, numpy 2.5.4, matplotlib 3.10.7, Pillow 12.0.0; other sources: Geometric analysis of shell coiling: coiling in ammonoids <https://pubs.geoscienceworld.org/jpaleontol/article-abstract/41/1/43/80199/geometric-analysis-of-shell-coiling-coiling-in>" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jtbi.2014.08.010>,
            <https://doi.org/10.1038/srep42445>,
            <https://doi.org/10.1126/science.138.3537.150>,
            <https://doi.org/10.1126/science.147.3663.1294>,
            <https://doi.org/10.2307/1301992> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-overall>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-17-raup-audit-raup-shell-coiling-specimen-match> ;
        pk:weightOfEvidence "0.641"^^xsd:double .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Morphological realism / specimen match: 45/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "The six forms are now distinct and each is what its name says (spire/width 0.00 for the two planispirals, 0.86 for the turreted form, 0.74 high-spired, 0.48 conical, 0.34 globose), and the panel titles and a figure footnote say that the taxon names are resemblances, not specimens. But there is still no real shell in the figure and no measured specimen the panels are tested against, which is what the dimension asks for; the labels are honest, not validated. Scored above the 30 of the first audit because the forms are no longer wrong, below the midpoint because nothing checks that a Turritella looks like the turreted panel." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-4> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "raup_empirical_comparison.png (generated output)" ;
        dct:description "six panels, each a different form; footnote on provenance — raup_empirical_comparison.png: rendered output of create_raup_animations.py at ba6fd20, image/png, 562658 B, 1630×1070 px, artifact_sha256 c50dbee57d0a64950d5470aed25583817eb8d39b97bcf2a7b89b991973f63ef7 (sha256 c50dbee57d0a64950d5470aed25583817eb8d39b97bcf2a7b89b991973f63ef7), spec_fingerprint 99d02b160418b61e3ca5605bf1327defebc58c14533242de5ba9809a805bf905" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "raup_shell_animation.gif (generated output)" ;
        dct:description "side view: a tower, a cone, a disc, an involute coil; overhead: the log spirals — raup_shell_animation.gif: rendered output of create_raup_animations.py at ba6fd20, image/gif, 15189434 B, 1200×800 px, 100 frames, artifact_sha256 986555a0032be189233cbf0ec15193959bf7f9cc0b1e099a6b7a289f7cff8b02 (sha256 986555a0032be189233cbf0ec15193959bf7f9cc0b1e099a6b7a289f7cff8b02), spec_fingerprint 99d02b160418b61e3ca5605bf1327defebc58c14533242de5ba9809a805bf905" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L174–L176" ;
        dct:description "ILLUSTRATIVE: the footnote text" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L174-L176> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "datasets/raup/variables.json L66–L133" ;
        dct:description "the six parameter sets with a note on why each value" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/ba6fd20/datasets/raup/variables.json#L66-L133> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


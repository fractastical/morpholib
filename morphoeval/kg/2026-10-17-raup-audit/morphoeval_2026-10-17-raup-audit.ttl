<https://w3id.org/probknow/resource/math-law/raup-shell-coiling-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Raup (1966) 4-Parameter Logarithmic Helicospiral Surface" ;
    dct:description "Spans gastropod, cephalopod, bivalve, and brachiopod shell morphospace in 3D cylindrical coordinates | Variables: W: whorl expansion rate; D: relative distance of generating curve from coiling axis; T: whorl translation rate (dz_c/dr_c); S: aperture aspect ratio" ;
    dct:source "Raup (1966) J. Paleontol. 40(5):1178-1190 Eq. (1)-(6); Noshita (2014)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/ba6fd20/create_raup_animations.py#L72-L148> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:notation "r(θ, φ) = r_0 W^{θ/2π} [1 + ((1 - D)/(1 + D)) cos φ],   z(θ, φ) = r_0 T (W^{θ/2π} - 1) + r_0 W^{θ/2π} S ((1 - D)/(1 + D)) sin φ" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2014.08.010>,
        <https://doi.org/10.1038/srep42445>,
        <https://doi.org/10.1126/science.138.3537.150>,
        <https://doi.org/10.1126/science.147.3663.1294>,
        <https://doi.org/10.2307/1301992> ;
    pk:hypothesisType "Logarithmic Helicospiral Parametric Differential Geometry" .

<https://w3id.org/probknow/resource/math-law/raup-shell-coiling-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Generating-Curve Center Parameter Recovery Identities" ;
    dct:description "Exact inverse morphometric recovery verifying 3D mesh fidelity against input (W, D, T) across all 6 canonical shell regimes | Variables: r_c, z_c: generating-curve centroid coordinates; r_min, r_max: inner and outer aperture margins" ;
    dct:source "Raup (1966) J. Paleontol. 40(5):1178-1190; Okabe & Yoshimura (2017)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/ba6fd20/morphoeval/measure_outputs.py#L220-L310> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:notation "W_rec = r_c(θ) / r_c(θ - 2π),   D_rec = r_min(θ) / r_max(θ),   T_rec = Δz_c / Δr_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2014.08.010>,
        <https://doi.org/10.1038/srep42445>,
        <https://doi.org/10.1126/science.138.3537.150>,
        <https://doi.org/10.1126/science.147.3663.1294>,
        <https://doi.org/10.2307/1301992> ;
    pk:hypothesisType "Logarithmic Helicospiral Parametric Differential Geometry" .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow LLM-assessment template) that evaluates the hypothesis pkr:hypothesis/morphoeval-<sim>-<dimension> with pk:hasProbability = score/100 and a pk:hasVerdict band; the overall score evaluates pkr:hypothesis/morphoeval-<sim> and is also the pk:weightOfEvidence of the pk:Claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-raup-shell-coiling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Morphometric validation: 45/100" ;
        dct:date "2026-10-17"^^xsd:date ;
        dct:description "Shape quantities are now measured on the rendered geometry - W, D and T recovered from each mesh, height/width and spire/width per panel - written to a CSV, printed, shown on the still, and re-derived independently in the measurements sidecar; recovered values equal the inputs to 5e-15 in the script's own check and, in the sidecar's independent derivation, exactly for W and T and to 3e-4 for D (the aperture's inner margin is read off a 100-point grid). That is validation of the implementation against the definitions, and it is complete. What the dimension also asks for - a comparison with specimens or with the paper's own figures - is absent: no published W, D, T of a real shell, and none of Raup's block-diagram placements, is compared with anything here." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-distance-from-axis-d-conical-w-3-5-d-0-0-t-1-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-distance-from-axis-d-evolute-disc-w-2-0-d-0-45-t-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-distance-from-axis-d-globose-w-3-0-d-0-1-t-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-distance-from-axis-d-high-spired-w-1-6-d-0-1-t-2-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-distance-from-axis-d-planispiral-w-3-0-d-0-0-t-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-distance-from-axis-d-turreted-w-1-3-d-0-05-t-3-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-translation-rate-t-conical-w-3-5-d-0-0-t-1-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-translation-rate-t-evolute-disc-w-2-0-d-0-45-t-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-translation-rate-t-globose-w-3-0-d-0-1-t-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-translation-rate-t-high-spired-w-1-6-d-0-1-t-2-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-translation-rate-t-planispiral-w-3-0-d-0-0-t-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-translation-rate-t-turreted-w-1-3-d-0-05-t-3-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-whorl-expansion-w-conical-w-3-5-d-0-0-t-1-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-whorl-expansion-w-evolute-disc-w-2-0-d-0-45-t-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-whorl-expansion-w-globose-w-3-0-d-0-1-t-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-whorl-expansion-w-high-spired-w-1-6-d-0-1-t-2-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-whorl-expansion-w-planispiral-w-3-0-d-0-0-t-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-whorl-expansion-w-turreted-w-1-3-d-0-05-t-3-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-morphometric-validation-3> ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-raup-shell-coiling-measurement-recovered-distance-from-axis-d-conical-w-3-5-d-0-0-t-1-5> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "recovered distance from axis D, 'Conical' (W=3.5, D=0.0, T=1.5) = 0.0003 ratio" ;
        schema:measurementTechnique "inner margin / outer margin of the aperture (min/max radial distance of the last generating curve)" ;
        schema:name "recovered distance from axis D, 'Conical' (W=3.5, D=0.0, T=1.5)" ;
        schema:unitText "ratio" ;
        schema:value "0.0003" ;

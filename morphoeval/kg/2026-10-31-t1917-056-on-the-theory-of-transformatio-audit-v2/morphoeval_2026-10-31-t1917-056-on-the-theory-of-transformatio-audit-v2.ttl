<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Procrustes rotation distance invariance" ;
    dct:description "GPA superimposition before Thompson-style warps | Variables: R: 2×2 rotation; p,q: landmark coordinates in ℝ²" ;
    dct:source "Thompson (1917) Ch. XVII; Bookstein (1989) TPS" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/local/morphoeval/lean/loops/Thompson1917_T1917_056.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "‖R p - R q‖² = ‖p - q‖² for orthogonal R" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/pab.2026.10096>,
        <https://doi.org/10.5061/dryad.crjdfn3g3> ;
    pk:hypothesisType "geometric morphometrics / Thompson coordinate deformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_245.sq_dist" ;
    pk:leanTheorem "MathOfBiology.Loop_245.procrustes_rotation_preserves_sq_dist" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equidistant stage interpolation endpoints (E2/E6)" ;
    dct:description "Heilmann intermediate stages on the Thompson grid | Variables: k: stage index 0..4; a,b: corresponding landmarks" ;
    dct:source "Thompson (1917) pp. 765-767, Figs. 401-402" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/local/morphoeval/lean/loops/Thompson1917_T1917_056.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "phi_t with t=k/4: endpoints at k=0,4; uniform step b-a" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/pab.2026.10096>,
        <https://doi.org/10.5061/dryad.crjdfn3g3> ;
    pk:hypothesisType "geometric morphometrics / Thompson coordinate deformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_245.interp4" ;
    pk:leanTheorem "MathOfBiology.Loop_245.interp_endpoints_and_equidistant" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-056-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Similarity scale multiplies squared distances by k²" ;
    dct:description "Uniform scaling in Thompson rectilinear grids | Variables: k: uniform scale; p,q: landmarks" ;
    dct:source "Thompson (1917) coordinate deformation" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/local/morphoeval/lean/loops/Thompson1917_T1917_056.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "‖k p - k q‖² = k² ‖p - q‖²" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/pab.2026.10096>,
        <https://doi.org/10.5061/dryad.crjdfn3g3> ;
    pk:hypothesisType "geometric morphometrics / Thompson coordinate deformation" ;
    pk:leanDeclaration "MathOfBiology.Loop_245.similarity_scale_sq_dist" ;
    pk:leanTheorem "MathOfBiology.Loop_245.similarity_scale_sq_dist" ;
    pk:leanVerified true .


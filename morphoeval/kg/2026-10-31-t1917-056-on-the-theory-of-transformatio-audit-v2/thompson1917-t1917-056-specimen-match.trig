}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-056> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-056-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-056-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Eohippus→Equus skull transformation (Fig. 401-402) — Morphological realism / specimen match: 58/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Otsu segmentation on both gallery specimens; landmark-in-mask fraction exported; zebra proxy." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-specimen-match-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-056_on-the-theory-of-transformations.py L225–L245" ;
        dct:description "segment_specimen dual photos" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/local/thompson/claims/t1917-056_on-the-theory-of-transformations.py#L225-L245> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor Pass 2)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1017/pab.2026.10096>,
            <https://doi.org/10.5061/dryad.crjdfn3g3> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form, Ch. XVII, pp. 765-767, Figs. 401-402" .
    <https://doi.org/10.1017/pab.2026.10096> dct:title "Phylogenetic analyses reveal that horses deviate from a pervasive pattern of skull shape evolution" .
    <https://doi.org/10.5061/dryad.crjdfn3g3> dct:title "Equid skull GM Dryad package" .
}


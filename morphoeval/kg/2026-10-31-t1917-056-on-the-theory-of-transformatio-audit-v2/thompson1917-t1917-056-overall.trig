sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-056> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-056-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-056-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Eohippus→Equus skull transformation (Fig. 401-402) — MorphoEval overall 75.0/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Pass 2: Heilmann stage RMSE ~0.01 on TPS phi_t; equidistance residuals small; homologous TPS beats shuffled labels; KS + lambda sweep + dual specimen segmentation. Verdict mixed — diagram interpolation supported but Dryad fossil GM series not loaded (partial test). Overall 75.0/100 (faithfulness 72.3, reproducibility 81.2); rubric morphoeval 0.1.0; checkpoint commit local; environment: python 3.12, numpy 2.x, scipy 1.x, matplotlib 3.x, Pillow 11.x. Dimension assessments: Model fidelity to source 84, Morphological realism / specimen match 58, Parameter expressivity 76, Morphometric validation 78, Source and data traceability 86, Code-to-model traceability 80, Reproducibility package 78. Output judged: docs/media/t1917_056_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-056_on-the-theory-of-transformations.py at local, image/png, 151288 B, 1800×1200 px, artifact_sha256 642c269d14e132d255f9eecbd90ddb468c219c65086203e082117c133f411f8d (sha256 642c269d14e132d255f9eecbd90ddb468c219c65086203e082117c133f411f8d), spec_fingerprint 885385f32cc021aefedec35731f59225d662ddf2cdd8959acb551369644bc14a. Dual provenance: spec_fingerprint: 885385f32cc021aefedec35731f59225d662ddf2cdd8959acb551369644bc14a; artifact_sha256: 642c269d14e132d255f9eecbd90ddb468c219c65086203e082117c133f411f8d; input_dataset_sha256: {datasets/thompson_1917/t1917-056/scout_manifest.json=cb62934529ec73bd..., datasets/thompson_1917/t1917-056/thompson_fig401_402_landmarks.json=e2d755701d463a2e...}. Supersedes audit: 2026-10-31-t1917-056-on-the-theory-of-transformatio-audit. Claim boundary: reported_in_source: Eohippus and Equus skulls related by coordinate deformation (Fig. 401) | Heilmann intermediates on the transformation (Fig. 402); reconstructed_in_script: TPS phi on 18 digitised landmarks; phi_t stage predictions vs drawn intermediates | Shuffled-label and lambda sweeps; KS distance null; gallery CV masks; does_not_claim: Direct validation of Wisniewski & Slater phylogenetic CREA deviation (Dryad not vendored) | That modern fossil equid series lie on a single Thompson grid without residual clade effects." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor Pass 2)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


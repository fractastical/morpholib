sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-056> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-056-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-056-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Eohippus→Equus skull transformation (Fig. 401-402) — Morphometric validation: 78/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "measure_morphoeval exports RMSE, equidistance residual, KS, shuffled TPS, segmentation fractions." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-ks-pvalue>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-landmark-in-mask-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-median-equidist-residual>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-median-stage-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-rmse-tps-eo-to-eq>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-specimen-segmentation-coverage-eo>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-specimen-segmentation-coverage-eq>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-tps-rmse-homologous>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-tps-rmse-shuffled-labels>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-morphometric-validation-1> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-ks-pvalue> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_pvalue = 1.2433513319372065e-19 p" ;
        schema:measurementTechnique "scipy.stats.ks_2samp" ;
        schema:name "ks_pvalue" ;
        schema:unitText "p" ;
        schema:value "1.2433513319372065e-19" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_statistic = 0.26349206349206344 D" ;
        schema:measurementTechnique "KS: GPA endpoints vs TPS midpoint pairwise distances" ;
        schema:name "ks_statistic" ;
        schema:unitText "D" ;
        schema:value "0.26349206349206344" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-landmark-in-mask-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "landmark_in_mask_fraction = 0.2222222222222222 fraction" ;
        schema:measurementTechnique "Equus landmarks vs equid segmentation mask" ;
        schema:name "landmark_in_mask_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.2222222222222222" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-median-equidist-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median_equidist_residual = 0.0 t-units" ;
        schema:measurementTechnique "|t* - k/4| minimising RMSE to drawn intermediate k" ;
        schema:name "median_equidist_residual" ;
        schema:unitText "t-units" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-median-stage-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "median_stage_rmse = 0.009686452518830352 shape units" ;
        schema:measurementTechnique "RMSE of phi_t(Eohippus) vs Heilmann drawn stages" ;
        schema:name "median_stage_rmse" ;
        schema:unitText "shape units" ;
        schema:value "0.009686452518830352" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-rmse-tps-eo-to-eq> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "rmse_tps_eo_to_eq = 1.542766483606174e-16 shape units" ;
        schema:measurementTechnique "TPS fit Eohippus→Equus endpoints (Fig. 401)" ;
        schema:name "rmse_tps_eo_to_eq" ;
        schema:unitText "shape units" ;
        schema:value "1.542766483606174e-16" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-specimen-segmentation-coverage-eo> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmentation_coverage_eo = 0.1835125 fraction" ;
        schema:measurementTechnique "Otsu + largest CC on gallery Eohippus photo" ;
        schema:name "specimen_segmentation_coverage_eo" ;
        schema:unitText "fraction" ;
        schema:value "0.1835125" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-specimen-segmentation-coverage-eq> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segmentation_coverage_eq = 0.14611458333333333 fraction" ;
        schema:measurementTechnique "Otsu + largest CC on gallery equid photo" ;
        schema:name "specimen_segmentation_coverage_eq" ;
        schema:unitText "fraction" ;
        schema:value "0.14611458333333333" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-tps-rmse-homologous> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "tps_rmse_homologous = 1.542766483606174e-16 shape units" ;
        schema:measurementTechnique "TPS with homologous landmark labels" ;
        schema:name "tps_rmse_homologous" ;
        schema:unitText "shape units" ;
        schema:value "1.542766483606174e-16" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-measurement-tps-rmse-shuffled-labels> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "tps_rmse_shuffled_labels = 1.9157410903079397e-14 shape units" ;
        schema:measurementTechnique "TPS ablation with shuffled Eohippus labels (seed 1917056)" ;
        schema:name "tps_rmse_shuffled_labels" ;
        schema:unitText "shape units" ;
        schema:value "1.9157410903079397e-14" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-056-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-056_on-the-theory-of-transformations.py L265–L285" ;
        dct:description "nine metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/local/thompson/claims/t1917-056_on-the-theory-of-transformations.py#L265-L285> .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (builder-assessor Pass 2)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


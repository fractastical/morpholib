        schema:name "7-species Scleractinian Milne-Edwards septa count correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9988" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-7-species-scleractinian-milne-edwards-septa-count-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-7-species-scleractinian-milne-edwards-septa-count-correlation-reference> a schema:PropertyValue ;
        dct:source "Milne-Edwards & Haime (1848) Ann. Sci. Nat. Zool. 9:37-89 & Cairns & Kitahara (2012) ZooKeys 227:1-47" ;
        schema:value "0.9985" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-bidirectional-surge-period-mean-dipole-asymmetry-a-1-pe-max-16-kc-2pi-vs-unidirectional-a-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bidirectional surge period-mean dipole asymmetry <A_1> (Pe_max=16, KC=2pi) vs unidirectional A_1 = 0.0 asymmetry index A_1" ;
        dct:description "Surviving quadrupole <A_2> = 0.0656 (axial/lateral flux 1.1404) vs unidirectional A_2 = 0.1129" ;
        schema:measurementTechnique "Period mean over 64 mirror-symmetric phases of the quasi-steady Law 3 flux with sign-reversing dipole; unidirectional A_1 at Pe=16 is 0.6469, peak instantaneous surge |A_1(t)| = 0.4245" ;
        schema:name "Bidirectional surge period-mean dipole asymmetry <A_1> (Pe_max=16, KC=2pi) vs unidirectional A_1" ;
        schema:unitText "asymmetry index A_1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-bidirectional-surge-period-mean-dipole-asymmetry-a-1-pe-max-16-kc-2pi-vs-unidirectional-a-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-bidirectional-surge-period-mean-dipole-asymmetry-a-1-pe-max-16-kc-2pi-vs-unidirectional-a-1-reference> a schema:PropertyValue ;
        dct:source "Chindapol et al. (2013) PLoS Comput. Biol. 9(1):e1002849 (bidirectional flow preserves colony symmetry; unidirectional flow skews growth upstream) & Lean theorem oscillatory_surge_dipole_cancellation" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-cycle-k-4-scleractinia-n-48-to-paleozoic-rugosa-stage-m-3-n-18-septa-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cycle k=4 Scleractinia (N=48) to Paleozoic Rugosa stage m=3 (N=18) septa ratio = 2.6667 ratio (N_hex(4) / N_rugosa(3))" ;
        dct:description "Scleractinia N_hex(4)=48 vs Rugosa N_rugosa(3)=18" ;
        schema:measurementTechnique "Ratio of simulated Scleractinian 4th-cycle septa (48) to Kunth's Law Rugosa stage m=3 septa (6 + 4*3 = 18)" ;
        schema:name "Cycle k=4 Scleractinia (N=48) to Paleozoic Rugosa stage m=3 (N=18) septa ratio" ;
        schema:unitText "ratio (N_hex(4) / N_rugosa(3))" ;
        schema:value "2.6667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-cycle-k-4-scleractinia-n-48-to-paleozoic-rugosa-stage-m-3-n-18-septa-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-cycle-k-4-scleractinia-n-48-to-paleozoic-rugosa-stage-m-3-n-18-septa-ratio-reference> a schema:PropertyValue ;
        dct:source "Milne-Edwards & Haime (1848) vs Kunth (1869) Z. Dtsch. Geol. Ges. 21:647-688 & Lean 4 theorem kunth_rugosa_vs_scleractinia_and_reach_hierarchy" ;
        schema:value "2.6667" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-endothecal-dissepiments-skeletal-volume-increment-relative-to-caryophylliid-architecture-3d> a schema:PropertyValue,

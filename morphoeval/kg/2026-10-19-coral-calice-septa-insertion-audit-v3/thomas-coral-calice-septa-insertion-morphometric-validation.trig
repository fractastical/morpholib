        schema:name "Endothecal dissepiments skeletal volume increment relative to caryophylliid architecture (3D)" ;
        schema:unitText "ratio (V_skel,diss / V_skel,caryo)" ;
        schema:value "1.047" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-endothecal-dissepiments-skeletal-volume-increment-relative-to-caryophylliid-architecture-3d-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-endothecal-dissepiments-skeletal-volume-increment-relative-to-caryophylliid-architecture-3d-reference> a schema:PropertyValue ;
        dct:source "Model-internal (no literature volume budget for dissepimentaria available offline; parameters tagged 'model' in corallum3d_surge_reference.json)" ;
        schema:value "1.047" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-hydrostatic-pure-diffusion-control-pe-0-upstream-downstream-dipolar-flux-asymmetry> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hydrostatic pure-diffusion control (Pe=0) upstream-downstream dipolar flux asymmetry = 0.0 asymmetry index A_1" ;
        dct:description "Exact radial symmetry preserved at Pe = 0" ;
        schema:measurementTechnique "Upstream-minus-downstream normalized flux asymmetry (j_up - j_down)/(j_up + j_down) at Pe = 0 (hydrostatic negative control)" ;
        schema:name "Hydrostatic pure-diffusion control (Pe=0) upstream-downstream dipolar flux asymmetry" ;
        schema:unitText "asymmetry index A_1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-hydrostatic-pure-diffusion-control-pe-0-upstream-downstream-dipolar-flux-asymmetry-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-hydrostatic-pure-diffusion-control-pe-0-upstream-downstream-dipolar-flux-asymmetry-reference> a schema:PropertyValue ;
        dct:source "Chindapol et al. (2013) PLoS Comput. Biol. 9(1):e1002849 & Lean 4 theorem peclet_zero_radial_symmetry" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-keulegan-carpenter-half-saturation-kc-50-of-surge-driven-bilateral-elongation-numeric-vs-2-pi-ln-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Keulegan-Carpenter half-saturation KC_50 of surge-driven bilateral elongation (numeric vs 2 pi ln 2) = 4.35 KC = U_max T / L" ;
        dct:description "Checks the numerical sweep against the model's own closed form; the renewal law itself is a modelling choice" ;
        schema:measurementTechnique "Dense KC scan (0.05..60) of <A_2>(KC) at Pe_max=16; KC where <A_2> reaches half its eta->1 saturation 0.1038; Pearson r(<A_2>, eta) = 1.0000; mean sqrt|sin| factor 0.76395 vs exact 0.76276" ;
        schema:name "Keulegan-Carpenter half-saturation KC_50 of surge-driven bilateral elongation (numeric vs 2 pi ln 2)" ;
        schema:unitText "KC = U_max T / L" ;
        schema:value "4.35" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-keulegan-carpenter-half-saturation-kc-50-of-surge-driven-bilateral-elongation-numeric-vs-2-pi-ln-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-keulegan-carpenter-half-saturation-kc-50-of-surge-driven-bilateral-elongation-numeric-vs-2-pi-ln-2-reference> a schema:PropertyValue ;
        dct:source "Closed form from eta(KC) = 1 - exp(-KC/(2 pi)) with excursion a = U_max T/(2 pi) (Keulegan & Carpenter 1958 J. Res. NBS 60:423, DOI 10.6028/jres.060.043, recalled offline)" ;
        schema:value "4.3552" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-milne-edwards-hexameral-log2-doubling-slope-d-log2-n-6-dk-across-cycles-k-1-5> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Milne-Edwards hexameral log2 doubling slope d(log2(N/6))/dk across cycles k=1..5 = 1.0 doublings/cycle" ;
        dct:description "S4 septa = 48, S5 septa = 96" ;
        schema:measurementTechnique "OLS regression slope of log2(N_hex(k)/6) vs (k - 1) across S1..S6" ;
        schema:name "Milne-Edwards hexameral log2 doubling slope d(log2(N/6))/dk across cycles k=1..5" ;
        schema:unitText "doublings/cycle" ;

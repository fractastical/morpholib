        schema:measurementTechnique "Number of z-levels where the active Milne-Edwards cycle k(R(z)) increments on the conical corallum R(z)=0.6+z tan(phi/2), H=13.28 mm; front heights 1.31, 4.30, 10.29 mm" ;
        schema:name "3D corallum septal insertion fronts stacked along the growth axis (caryophylliid, phi from specimen)" ;
        schema:unitText "fronts" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-3d-corallum-septal-insertion-fronts-stacked-along-the-growth-axis-caryophylliid-phi-from-specimen-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-3d-corallum-septal-insertion-fronts-stacked-along-the-growth-axis-caryophylliid-phi-from-specimen-reference> a schema:PropertyValue ;
        dct:source "Milne-Edwards & Haime (1848): S2, S3, S4 fronts at R_2=1.0, R_3=2.0, R_4=4.0 mm below R_top=5.0 mm; Lean theorem turbinate_corallum_septal_cycles_monotone" ;
        schema:value "3.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-5-point-p-clet-sweep-dipolar-flux-asymmetry-correlation-with-sqrt-pe-chindapol-et-al-2013> a schema:PropertyValue,

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion, reduced 3D corallum & Keulegan-Carpenter surge morphogenesis — Morphometric validation: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "16 reference-anchored measurements now: the 9 Pass 2 entries plus 7 Pass 3 entries, of which four are real external or specimen comparisons (apical angle 36.66 vs Wells trochoid 40 deg; costae 15 vs 20; 3D rim area fraction 0.493 vs specimen Otsu 0.532; KC_50 numeric 4.350 vs analytic 4.355) and two are exact-symmetry checks (3 insertion fronts; <A_1> = 1e-16 vs 0). Deductions, most of them defects v2 did not price: the 7-species r reference 0.9985, the Pe-sweep r reference 0.9990 and the specimen reach-ratio reference 1.4368 are self-referential or hand-set (the reach ratio reference equals the measured value and was copied into the reference JSON), and the new dissepiment volume increment explicitly uses reference = value (-6); the Pe-sweep 'Pearson r vs sqrt(Pe)' correlates a monotone closed form with itself and the Pe = 36 up/down ratio in the script (13.73, floor clamp) still disagrees with the JSON table (14.375) (-4); the cross-taxa `observed_septa_mean` / `typical_peclet_Pe` / `major_minor_reach_ratio` values are recalled, not digitised (-3); the KC_50 check validates the script against its own analytic closed form (-1). quick_gate remains 100." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2013-thomas-coral-calice-septa-insertion.py L1775–L1784: Dissepiment volume increment: reference_value = value, declared model-internal (expressivity, not validation) <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L1775-L1784>",
            "2013-thomas-coral-calice-septa-insertion.py L1808–L1817: 7-species Pearson r with hand-set reference 0.9985 (self-referential) <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L1808-L1817>",
            "2013-thomas-coral-calice-septa-insertion.py L1858–L1867: Pe-sweep Pearson r vs sqrt(Pe) with hand-set reference 0.9990; correlates a closed form with itself; note reports 13.73 vs JSON 14.375 <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L1858-L1867>",
            "2013-thomas-coral-calice-septa-insertion.py L1888–L1897: Specimen reach ratio reference 1.4368 equals the measured value <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L1888-L1897>",
            "datasets/coral_calice_septa_insertion/coral_calice_septa_insertion_reference.json L95–L109: cross_taxa_corallite_septa_table recalled values and Pe=36 up/down ratio 14.375 (script gives 13.73) <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/coral_calice_septa_insertion/coral_calice_septa_insertion_reference.json#L95-L109>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-3d-corallum-calice-rim-skeletal-area-fraction-vs-specimen-calice-otsu-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-3d-corallum-septal-insertion-fronts-stacked-along-the-growth-axis-caryophylliid-phi-from-specimen>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-5-point-p-clet-sweep-dipolar-flux-asymmetry-correlation-with-sqrt-pe-chindapol-et-al-2013>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-7-species-scleractinian-milne-edwards-septa-count-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-bidirectional-surge-period-mean-dipole-asymmetry-a-1-pe-max-16-kc-2pi-vs-unidirectional-a-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-cycle-k-4-scleractinia-n-48-to-paleozoic-rugosa-stage-m-3-n-18-septa-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-endothecal-dissepiments-skeletal-volume-increment-relative-to-caryophylliid-architecture-3d>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-hydrostatic-pure-diffusion-control-pe-0-upstream-downstream-dipolar-flux-asymmetry>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-keulegan-carpenter-half-saturation-kc-50-of-surge-driven-bilateral-elongation-numeric-vs-2-pi-ln-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-milne-edwards-hexameral-log2-doubling-slope-d-log2-n-6-dk-across-cycles-k-1-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-primary-to-quaternary-septal-radial-reach-hierarchy-ratio-alpha-1-alpha-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-corallum-apical-angle-from-side-profile-cone-fit-scleractinian-coral-septa-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-inter-septal-angular-spacing-delta-theta-scleractinian-coral-septa-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-major-s1-s2-to-minor-s3-s4-septal-radial-reach-ratio-scleractinian-coral-septa-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-segmented-outer-radiating-septa-count-scleractinian-coral-septa-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-specimen-visible-costae-count-across-the-near-face-below-the-calice-rim-side-view>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-morphometric-validation-1> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-3d-corallum-calice-rim-skeletal-area-fraction-vs-specimen-calice-otsu-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D corallum calice-rim skeletal area fraction vs specimen calice Otsu area fraction = 0.4934 area fraction" ;
        dct:description "Septal thickness is calibrated from the same specimen, so only the reach distribution, pali, theca and columella are independently tested" ;
        schema:measurementTechnique "Caryophylliid 3D model top level (R_top=5.0 mm, 48 septa, t_s=0.277 mm from the specimen 0.80R duty cycle 0.530) skeletal area / pi R^2, compared with the Otsu-thresholded bright fraction of the specimen calice annulus 0.20R..0.92R" ;
        schema:name "3D corallum calice-rim skeletal area fraction vs specimen calice Otsu area fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.4934" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-3d-corallum-calice-rim-skeletal-area-fraction-vs-specimen-calice-otsu-area-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-3d-corallum-calice-rim-skeletal-area-fraction-vs-specimen-calice-otsu-area-fraction-reference> a schema:PropertyValue ;
        dct:source "Cairns & Kitahara (2012) ZooKeys 227:1-47 Caryophyllia quadragenaria calice micrograph (Otsu threshold 0.428)" ;
        schema:value "0.5323" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-measurement-3d-corallum-septal-insertion-fronts-stacked-along-the-growth-axis-caryophylliid-phi-from-specimen> a schema:PropertyValue,

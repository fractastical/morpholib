sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L199–L365" ;
        dcterms:description "Milne-Edwards new/cumulative septa, cycle threshold radius, and the 2D Scleractinian calice solver; rim modulation constants 0.035 (L274) etc. are unsourced" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L199-L365> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L504–L627" ;
        dcterms:description "Pass 3 surge: eta(KC) renewal law, sgn(U) dipole over 64 mirror phases, KC sweep and reef KC estimates; <sqrt Pe(t)>/sqrt Pe_max = 0.763 (no enhancement)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L504-L627> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L642–L870" ;
        dcterms:description "Pass 3 reduced 3D corallum: cone profile, label volume with theca/columella/pali/septa/dissepiments/synapticulae, sections and architecture ablation (kinematic, not accretive)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L642-L870> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean L157–L248" ;
        dcterms:description "New Lean theorems: cone_radius/active_cycle/cumulative septa monotone, turbinate_corallum_septal_cycles_monotone (6/12/24/48 fronts), oscillatory_surge_dipole_cancellation, surge_mean_of_mirror_phases_zero" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean#L157-L248> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion, reduced 3D corallum & Keulegan-Carpenter surge morphogenesis — Model fidelity to source: 89/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Laws 1 and 2 (Milne-Edwards hexameral doubling, Kunth 4-fossula serial insertion) are implemented exactly and machine-checked; the Pass 3 3D corallum correctly stacks the insertion fronts along the growth axis (cycle k present wherever R(z) >= R_k, proven monotone in Lean) and the surge closure correctly reproduces the Chindapol (2013) symmetry statement (dipole cancels under bidirectional flow, bilateral quadrupole survives; proven for mirror phases in Lean). Deductions, two of them new in this round: the Law 3 flux law j0(1 + beta sqrt(Pe) cos theta + gamma Pe/(1+Pe) cos 2theta), the 0.16 j0 wake floor and the ellipticity formula are a phenomenological ansatz, not Chindapol's advection- diffusion equations, and the rim modulation constants 0.035 / 0.025 / 0.42 / 0.35 / 0.06 are unsourced (-5); the 3D corallum is kinematic, not accretive or mechanical, so dissepiments/synapticulae are placed, not grown (-3); the renewal law eta(KC) = 1 - exp(-KC/2pi) is a modelling choice and the quasi-steady closure gives a mean transfer BELOW the unidirectional case (0.763), opposite to the Falter/Reidenbach enhancement (-3). v2's 93 did not price the Law 3 ansatz; v3 does." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2013-thomas-coral-calice-septa-insertion.py L435–L501: Phenomenological boundary-layer flux law with 0.16 j0 floor clamp (L454) and ellipticity formula (L462): not Chindapol's equations <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L435-L501>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-model-fidelity-4> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 Phase B primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


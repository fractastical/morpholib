    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L963–L1087" ;
        dcterms:description "otsu_threshold + segment_caryophyllia_specimen: 40 septa, 9.00 deg, reach 1.4368, Otsu area fraction 0.532 and 0.80 R septal duty cycle (sets t_s = 0.277 mm; circular w.r.t. the rim-area check)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L963-L1087> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "datasets/coral_calice_septa_insertion/corallum3d_surge_reference.json L52–L61" ;
        dcterms:description "side_view_rows_px, cone-fit method, expected trochoid class and the caveat that costae are undercounted on the oblique view" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/coral_calice_septa_insertion/corallum3d_surge_reference.json#L52-L61> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/coral_calice_septa_insertion_corallum3d.png (generated output)" ;
        dcterms:description "8-panel figure: 3D cutaway, tangential sections, transverse sections at the 6/12/24/48 fronts, specimen side-profile fit, septa-vs-z with Wells classes, volume budget vs specimen area fraction — docs/media/coral_calice_septa_insertion_corallum3d.png: rendered output of 2013-thomas-coral-calice-septa-insertion.py at e651a8b8, image/png, 449005 B, 2254×1425 px, artifact_sha256 d968bf0662bf2dd692248115c03452379c0016bde5e42c765122bbc9e9f7e2e7 (sha256 d968bf0662bf2dd692248115c03452379c0016bde5e42c765122bbc9e9f7e2e7), spec_fingerprint 0cff1aa51273708b6f3a81f44e78a537ce76e9aebe378d1738d5aa43189cae7d" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-5> a pk:EvidenceItem ;
        rdfs:label "docs/media/coral_calice_septa_insertion_comparison.png (generated output)" ;
        dcterms:description "Panel E specimen segmentation overlay retained (v3 title); panel titles overlap at fontsize 9.6 — docs/media/coral_calice_septa_insertion_comparison.png: rendered output of 2013-thomas-coral-calice-septa-insertion.py at e651a8b8, image/png, 1001149 B, 2415×1551 px, artifact_sha256 cbee31b2b54319f1b348c2f440156314a4a9df33e06b7982c07b3a007457ba13 (sha256 cbee31b2b54319f1b348c2f440156314a4a9df33e06b7982c07b3a007457ba13), spec_fingerprint 0cff1aa51273708b6f3a81f44e78a537ce76e9aebe378d1738d5aa43189cae7d" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 Phase B primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion, reduced 3D corallum & Keulegan-Carpenter surge morphogenesis — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The Pass 2 polar ridge segmentation (40 septa, 9.00 deg spacing, major/minor reach 1.4368) is retained and Pass 3 adds two genuinely new specimen measurements: the apical angle fitted on the side-profile panel (36.66 deg, r = 0.993, Wells trochoid; the README had already called the corallum 'costate trochoid'), and an Otsu calice skeletal area fraction (0.532) compared with the 3D rim (0.493). Deductions: the septal thickness used in the 3D model is calibrated from the same specimen it is then compared to, so the rim-area check is only partly independent (-3); the costae count (15 vs ~20 expected) is an under-counting detector on an oblique view and is reported as a lower bound (-2); the model's 48 rim septa vs the specimen's 40 (incomplete S4) remains unresolved from Pass 2 (-3); the side view has no pixel scale, so only angles and counts are usable (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-specimen-match-5> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


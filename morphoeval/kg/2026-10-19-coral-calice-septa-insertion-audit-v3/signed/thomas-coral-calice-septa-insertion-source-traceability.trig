    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion, reduced 3D corallum & Keulegan-Carpenter surge morphogenesis — Source and data traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The four SHA-256-pinned files are untouched and still verified fail-closed at runtime; Pass 3 adds `corallum3d_surge_reference.json` in which EVERY row carries a provenance tag (`specimen`, `model`, or `recalled offline: ...`) and `pass3_citations.bib` with the five new sources, and the dataset README gains a Pass 3 section stating the honest limits. Deductions: all Pass 3 literature values (Wells apical angles, reef U_max/T, Falter/Reidenbach/Keulegan DOIs) are recalled offline with `doi_verified_offline: false` (-4); eight 3D geometry constants are `provenance: model` (-2); the Milne-Edwards DOI is a BHL title-level DOI and the Kunth DOI is unverifiable offline (carried from v2, -2); the new JSON and bib are not SHA-256-pinned by `EXPECTED_SHA256` (-2). The slot-metadata mismatch (dispatch slug / prompt organism) is a campaign-level record defect, not a repository one, and is not scored here." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-source-traceability-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


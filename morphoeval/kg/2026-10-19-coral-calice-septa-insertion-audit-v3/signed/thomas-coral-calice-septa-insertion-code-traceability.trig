sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L1–L97" ;
        dcterms:description "v3 header docstring: five Pass 2 sources plus Pass 3 additions and function map" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L1-L97> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L504–L512" ;
        dcterms:description "surge_renewal_efficiency docstring declares eta(KC) = 1 - exp(-KC/2pi) a kinematic modelling choice" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L504-L512> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thomas-coral-calice-septa-insertion.yaml L74–L111" ;
        dcterms:description "Law 4 (3D corallum fronts) and Law 5 (surge dipole cancellation) registered with single-range code_locus and code_locus_secondary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/math_kg_loops/thomas-coral-calice-septa-insertion.yaml#L74-L111> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion, reduced 3D corallum & Keulegan-Carpenter surge morphogenesis — Code-to-model traceability: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The header docstring (L1-L97) now lists the Pass 3 sources and maps each Pass 3 function to its law; `surge_renewal_efficiency` states in its docstring that the exponential form is a modelling choice; the Pass 3 measurements name their reference source and flag the model-internal one; the math-KG YAML registers Laws 4 and 5 with one `file#La-Lb` range per `code_locus` and refreshed Pass 2 loci. Deductions: the Law 3 rim-modulation constants (0.035, 0.025, 0.42, 0.35, 0.06) in `simulate_scleractinian_calice_2d` carry no citation (-4); the reference JSON cites Chindapol 'Eqs. (1)-(8)' for a flux law that is not Chindapol's (-3); the dissepiment phase/tilt choices in the 3D builder are commented but not sourced (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2013-thomas-coral-calice-septa-insertion.py L246–L365: simulate_scleractinian_calice_2d: hard-coded rim modulation constants (e.g. 0.035 at L274) without citation <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L246-L365>",
            "datasets/coral_calice_septa_insertion/coral_calice_septa_insertion_reference.json L64–L64: Governing-equation section cites Chindapol 'Eqs. (1)-(8)' for a phenomenological flux ansatz <https://github.com/fractastical/morpholib/blob/e651a8b8/datasets/coral_calice_septa_insertion/coral_calice_septa_insertion_reference.json#L64-L64>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-code-traceability-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L1901–L2008" ;
        dcterms:description "self_test(): 8 Pass 2 + 4 Pass 3 checks, bitwise determinism of 3D labels and surge profile, len(meas) == 16" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L1901-L2008> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L1433–L1713" ;
        dcterms:description "render_corallum3d_figure, render_surge_kc_figure, render_surge_phase_gif: the three new outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L1433-L1713> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean L1–L25" ;
        dcterms:description "Zero-dependency Lean module, verify command, namespace; 249 lines, 0 sorrys, exits 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/morphoeval/lean/loops/Loop_074_coral_calice_septa_insertion.lean#L1-L25> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion, reduced 3D corallum & Keulegan-Carpenter surge morphogenesis — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`--self-test` passes 12/12 checks in ~7 s CPU (SHA-256 provenance, JSON-code parity, doubling, Kunth divergence, Pe = 0 symmetry, 7-species scaling, specimen segmentation parity, bitwise determinism of the 2D, 3D and surge outputs, 3D monotone fronts/volumes, specimen trochoid angle and fit, surge cancellation / KC_50 / mean-sqrt-sin closed form Gamma(3/4)Gamma(1/2)/(pi Gamma(5/4)), and the 16-entry measurement contract); the default render takes ~8 s and writes all five outputs; `lean` exits 0 with 0 sorrys. Deductions: the repository `.gitignore` excludes `*.png`, so the three PNG outputs are untracked artefacts and only the GIFs are versioned (pre-existing, -3); `--seed` is a no-op kept for interface parity (-1); matplotlib font-cache rebuilds dominate first-run wall time in a clean sandbox and no MPLCONFIGDIR note is given (-1); the Pass 3 JSON/bib are not integrity-pinned (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2013-thomas-coral-calice-septa-insertion.py L2021–L2021: --seed accepted for interface parity; model has no stochastic component (no-op) <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L2021-L2021>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 Phase B primary assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

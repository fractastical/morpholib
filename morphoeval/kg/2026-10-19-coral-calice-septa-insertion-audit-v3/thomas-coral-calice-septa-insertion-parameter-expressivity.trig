sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-thomas-coral-calice-septa-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Milne-Edwards & Haime (1848), Kunth (1869) & Chindapol et al. (2013) Scleractinian coral calice septal insertion, reduced 3D corallum & Keulegan-Carpenter surge morphogenesis — Parameter expressivity: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 3 adds three independent control axes with visible morphological consequences: the apical angle across the four Wells classes (changes corallum height and the z-positions of the insertion fronts), the endothecal architecture ablation (caryophylliid / dissepimented / synapticulate at identical outer geometry, volume budget reported), and the Keulegan-Carpenter number across 0.5-200 plus a dense scan (quadrupole saturates, dipole stays zero), alongside the retained R, lambda_s and Pe sweeps and the 7-species table. New CLI flags `--apical-angle-deg`, `--septum-thickness-mm`, `--skip-pass3`, and `--Pe` now also drives the surge figure. Deductions: `--seed` is a documented no-op (-2); the dissepiment/synapticula spacings and thicknesses are not CLI-exposed and are fixed model constants (-3); the architecture ablation changes volume but no growth outcome (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L136–L146" ;
        dct:description "Wells (1956) apical-angle classes, CORALLUM_ARCHITECTURES and KC renewal constants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L136-L146> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L583–L623" ;
        dct:description "evaluate_keulegan_carpenter_sweep over KC in {0.5..200} + dense scan, KC_50 numeric vs analytic; reef_keulegan_carpenter_number" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L583-L623> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L859–L870" ;
        dct:description "evaluate_corallum_architectures: three-architecture ablation at identical outer geometry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L859-L870> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-thomas-coral-calice-septa-insertion-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2013-thomas-coral-calice-septa-insertion.py L2011–L2052" ;
        dct:description "CLI: --self-test, --skip-gif, --skip-pass3, --R-mm, --lambda-s-mm, --Pe, --apical-angle-deg, --septum-thickness-mm; --seed accepted but unused (L2021)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e651a8b8/2013-thomas-coral-calice-septa-insertion.py#L2011-L2052> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Pass 3 Phase B primary assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


<https://w3id.org/delphi/resource/assessment/problem-2-equidistribution-bridge-claude-fable-5-1> a pk:BayesianAssessment ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
    pk:bayesFactor 3.981e-01 ;
    pk:calibrationMethod "Project Delphi v1.3 signed deciban ledger" ;
    pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/problem-2-equidistribution-architecture-bridge> ;
    pk:evidenceAgainst "[-1.0 dB] Finite-range verification of universal crystal balance laws beyond S=41",
        "[-2.5 dB] Crystal period P_S = 2^{n_S} grows exponentially in S, so c_S samples a single point per crystal; 19/41 crystals lack exact 1/2",
        "[-2.5 dB] Equidistribution of a non-automatic Lucas-submask diagonal sample is a Borel-normality-class problem",
        "[-4.0 dB] Zero diagonal-to-midpoint decorrelation or discrepancy bounds (not even o(1) along a subsequence)" ;
    pk:evidenceFor "[+1.0 dB] 2-adic projective limit tower C_r^(locked)(S) equidistribution (0.499837, |dev| < 2.2e-4)",
        "[+1.0 dB] Self-dual Mahler tail periodicity and high-bit pass-through spectral control (Thm 36)",
        "[+2.0 dB] Exact midpoint identity c_S = A_S(floor(S/2)) and 2D Bi-Mahler diagonal convolution (Thms 22, 33, 43)",
        "[+2.0 dB] Source crystals A_S have exact 1/2 density at all doubling & 1-step post-doubling horizons (Thm 35(1))" ;
    pk:hasConfidence 6.5e-01 ;
    pk:hasProbability 1.2163e-02 ;
    pk:hasVerdict "STRUCTURAL_REFORMULATION_ONLY_MISSING_DIAGONAL_DECORRELATION" ;
    pk:weightOfEvidenceDeciban -4e+00 .


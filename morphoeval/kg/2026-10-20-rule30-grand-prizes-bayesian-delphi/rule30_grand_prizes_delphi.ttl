<https://w3id.org/delphi/resource/hypothesis/problem-1-center-aperiodicity-conjecture-truth> a pk:TestableHypothesis ;
    rdfs:label "Prize #1: Center-Column Aperiodicity — Conjecture Truth (H^conjecture)"@en ;
    dcterms:description "For the single-cell seed a_{0,i} = delta_{i,0}, the center column c_t = a_{t,0} never becomes eventually periodic (forall t_0 >= 0, forall Pi >= 1, exists t >= t_0 : c_{t+Pi} != c_t)."@en ;

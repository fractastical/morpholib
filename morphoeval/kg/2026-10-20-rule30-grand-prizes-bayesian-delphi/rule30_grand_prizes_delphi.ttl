<https://w3id.org/delphi/resource/assessment/problem-1-center-aperiodicity-bridge-claude-fable-5-1> a pk:BayesianAssessment ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
    pk:bayesFactor 1.122e+00 ;
    pk:calibrationMethod "Project Delphi v1.3 signed deciban ledger" ;
    pk:evaluatesHypothesis <https://w3id.org/delphi/resource/hypothesis/problem-1-center-aperiodicity-architecture-bridge> ;
    pk:evidenceAgainst "[-1.0 dB] Left-cone doubling horizons k_r beyond k_4=400 depend on even-weight barrier branches selected by c_t itself",
        "[-1.5 dB] Several universal structural claims beyond k_4 rely on finite-range verification rather than closed induction",
        "[-3.0 dB] Proved infinite families rely on long 1-run OR-saturation (a_i>=8); sparse pulse window grows ~7*Pi in pure left cone",
        "[-3.5 dB] Remaining Horizon Clash Lemma (D_1(t)=1 cannot stay on {c_t=0}) is a global mixing/phase-spreading problem",
        "[-4.0 dB] Depth-1 Right Cylinder has positive topological entropy (~0.32 bits/step); no fixed-depth local window suffices" ;
    pk:evidenceFor "[+1.5 dB] Unconditional diagonal period-doubling lim P_k = infty & 9-row horizon sandwich (Thms 4, 46)",
        "[+1.5 dB] Uniformly short post-period kill windows (<=37 steps pure left; <=19 steps depth-1 right cylinder)",
        "[+2.0 dB] Finite-depth spatial cylinder transducer eliminates infinite multi-run families for all t_0 (Thms 32, 37, 38, 42)",
        "[+2.5 dB] Unconditional 4-Line Inward Wavefront Lemma forcing D_1(t)=1 infinitely often (Thm 47(1))",
        "[+3.0 dB] Pure Left-Cone autonomy & Opaque Mirror reduction to 1D boundary automaton (Thms 9, 44)",
        "[+3.0 dB] Unconditional joint-seam (c_t, l_1(t)) aperiodicity for all t_0, Pi >= 1 (Thm 36(1))" ;
    pk:hasConfidence 6e-01 ;
    pk:hasProbability 5.5761e-02 ;
    pk:hasVerdict "PARTIAL_PROGRESS_REDUCED_TO_ONE_OPEN_GLOBAL_LEMMA" ;
    pk:weightOfEvidenceDeciban 5e-01 .

<https://w3id.org/delphi/resource/assessment/problem-1-center-aperiodicity-bridge-gemini-4-argon> a pk:BayesianAssessment ;

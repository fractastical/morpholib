<https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> a pk:Claim ;
    rdfs:label "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition (Human (Homo sapiens) bronchial epithelial monolayer & Drosophila epithelial sheet)",
        "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition faithfully reproduces Human (Homo sapiens) bronchial epithelial monolayer & Drosophila epithelial sheet morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-1>,
        <https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-2>,
        <https://w3id.org/probknow/resource/math-law/bi-vertex-glass-jamming-3> ;
    dct:description "The simulation script(s) 2015-bi-vertex-glass-jamming.py implement the cited source model as published and produce forms that match real Human (Homo sapiens) bronchial epithelial monolayer & Drosophila epithelial sheet specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.2/100, audit 2026-10-19-vertex-glass-jamming-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py> ;
    schema:about "Human (Homo sapiens) bronchial epithelial monolayer & Drosophila epithelial sheet" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py; output: docs/media/vertex_glass_jamming_comparison.png; organism: Human (Homo sapiens) bronchial epithelial monolayer & Drosophila epithelial sheet; checkpoint commit: https://github.com/fractastical/morpholib/commit/0cb0132; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 52abc2dcaa2857a7c9b54a7d8ac8d7ebb1e0481dc0dc957ca72fa6bc9190d466; artifact_sha256: 1b0d09c98454983bc345738c02733c122e65b9963a3d007878775ca67be4b6f5" ;

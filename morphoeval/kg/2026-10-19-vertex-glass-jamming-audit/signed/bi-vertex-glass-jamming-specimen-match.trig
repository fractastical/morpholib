sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition — Morphological realism / specimen match: 34/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/vertex_glass_jamming/human_epithelial_monolayer_specimen.jpg` is vendored in the repository, the v1 script never loads, verifies, or segments the human monolayer micrograph (`render_outputs_v1`, L125-182) and renders only a 3-panel synthetic plot." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2015-bi-vertex-glass-jamming.py L125–L182: render_outputs_v1 renders 3 synthetic panels without loading or segmenting human_epithelial_monolayer_specimen.jpg <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L125-L182>",
            "docs/media/vertex_glass_jamming_comparison.png (generated output, not in repo): 3-panel synthetic figure lacking biological specimen segmentation overlay or empirical q=P/sqrt(A) distribution match — docs/media/vertex_glass_jamming_comparison.png: rendered output of 2015-bi-vertex-glass-jamming.py at 0cb0132, image/png, 157153 B, 1560×520 px, artifact_sha256 1b0d09c98454983bc345738c02733c122e65b9963a3d007878775ca67be4b6f5 (sha256 1b0d09c98454983bc345738c02733c122e65b9963a3d007878775ca67be4b6f5), spec_fingerprint 52abc2dcaa2857a7c9b54a7d8ac8d7ebb1e0481dc0dc957ca72fa6bc9190d466" ;
        pk:hasScore "0.34"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015) & Park et al. (2015) zero-temperature shape-index unjamming & asthmatic bronchial epithelial rigidity transition — Parameter expressivity: 45/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates only two discrete parameter points (`p_0 = 3.70` and `p_0 = 3.95`) without a continuous `p_0` phase sweep across the solid-to-fluid transition at `p_0^* = 3.813`, without comparing non-asthmatic control vs. asthmatic vs. mechanically compressed bronchial epithelium, without a zero-contractility / ablation control (`r = 0`), and without CLI flags for `--p0`, `--r`, `--steps`, or `--seed` (L214-218)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2015-bi-vertex-glass-jamming.py L128–L129: Only two p0 values (3.70 and 3.95) simulated in v1 <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L128-L129>",
            "2015-bi-vertex-glass-jamming.py L214–L218: CLI parser only accepts --self-test <https://github.com/fractastical/morpholib/blob/0cb0132/2015-bi-vertex-glass-jamming.py#L214-L218>" ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-mean-shape-index-q> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "solid_mean_shape_index_q = 3.7983 dimensionless" ;
        schema:measurementTechnique "Simulated mean shape index <q> in jammed solid regime (p0=3.70)" ;
        schema:name "solid_mean_shape_index_q" ;
        schema:unitText "dimensionless" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bacillus subtilis Turing wavenumber at 16 µm (Holocene detail scale) — Parameter expressivity: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "A five-point sweep of D_u at fixed ratio 9.20 increases wavelength monotonically, which is the control the wavenumber law claims. The equal-diffusion ablation drives sigma_max to -0.085 and the field variance down by about 100-fold. The sweep is of the linear dispersion, not of the rendered ocellus." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py L234–L257" ;
        dct:description "parameter_sweep records lambda increasing with D_u" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e9fd00d16157d4244d56076d8b43ea8013dc6dec/models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py#L234-L257> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py L259–L284" ;
        dct:description "ablation_equal_diffusion is the negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e9fd00d16157d4244d56076d8b43ea8013dc6dec/models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py#L259-L284> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (loop 3130 pass 1 primary assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bacillus-subtilis-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Bacillus subtilis Turing wavenumber at 16 µm (Holocene detail scale) — Code-to-model traceability: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;

<https://w3id.org/delphi/resource/math-law/delphi10000-bacillus-subtilis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg trace is negative without diffusion" ;
    dct:description "Homogeneous stability on the 16 µm Bacillus subtilis detail scale | Variables: f_u = 832/1000, g_v = -1 at (u0, v0) = (1, 0.916)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e9fd00d16157d4244d56076d8b43ea8013dc6dec/models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py#L90-L96>,
        <https://github.com/fractastical/morpholib/blob/e9fd00d16157d4244d56076d8b43ea8013dc6dec/morphoeval/lean/loops/Loop_3130_bacillus_subtilis_turing_wavelength_s0.lean#L8-L10> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "f_u + g_v = 0.832 - 1 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1997.0462>,
        <https://doi.org/10.1016/S0378-4371(98)00345-8>,
        <https://doi.org/10.1080/000187300405228>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3130.trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3130.trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bacillus-subtilis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber versus the 10 µm tier center" ;
    dct:description "Scale change at chronoseries node 1/1 (no fossil predecessor) | Variables: lambda_detail = 16 um, lambda_tier = 10 um, age delta = 0 Ma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e9fd00d16157d4244d56076d8b43ea8013dc6dec/models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py#L67-L74>,
        <https://github.com/fractastical/morpholib/blob/e9fd00d16157d4244d56076d8b43ea8013dc6dec/morphoeval/lean/loops/Loop_3130_bacillus_subtilis_turing_wavelength_s0.lean#L16-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_16 / k_10 = 10/16 = 0.625 and D_16/D_10 = (16/10)^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1997.0462>,
        <https://doi.org/10.1016/S0378-4371(98)00345-8>,
        <https://doi.org/10.1080/000187300405228>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3130.wavenumber_ratio_versus_tier_center" ;
    pk:leanTheorem "MathOfBiology.Loop_3130.diffusion_rescales_with_wavelength_squared" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bacillus-subtilis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diffusion ratio above the Turing threshold" ;
    dct:description "Wavelength selection requires inhibitor diffusion faster than activator diffusion | Variables: r_operating = 9.2, r_critical ≈ 8.00, r_ablation = 1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Kawasaki et al. 1997 DOI:10.1006/jtbi.1997.0462" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e9fd00d16157d4244d56076d8b43ea8013dc6dec/models/2026-delphi10000-bacillus-subtilis-turing-wavelength-s0.py#L98-L116>,
        <https://github.com/fractastical/morpholib/blob/e9fd00d16157d4244d56076d8b43ea8013dc6dec/morphoeval/lean/loops/Loop_3130_bacillus_subtilis_turing_wavelength_s0.lean#L24-L32> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(r f_u + g_v)^2 > 4 r det J at r = 9.2, and the inequality fails at r = 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1006/jtbi.1997.0462>,
        <https://doi.org/10.1016/S0378-4371(98)00345-8>,
        <https://doi.org/10.1080/000187300405228>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3130.ratio_9200_exceeds_turing_threshold" ;
    pk:leanTheorem "MathOfBiology.Loop_3130.ratio_1000_fails_turing_threshold" ;
    pk:leanVerified true .


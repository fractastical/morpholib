        <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-27-canis-lupus-turing-wavelength-s0-audit-v2-delphi10000-canis-lupus-turing-wavelength-s0-1>,

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 1.781 µm on a Holocene Canis lupus (MDCK) apical patch — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The sweep is now executed and drawn. D_v/D_u = 6 and 8 have a negative Turing margin and no wavelength; 12, 18 and 30 are unstable and lambda_c decreases from 1.781 µm to 1.733 µm to 1.697 µm. Equal diffusion and gamma=0 are separate switches and both collapse the activator standard deviation, in the direction the mechanism requires." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py L239–L269" ;
        dct:description "sweep_diffusion_ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py#L239-L269> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py L456–L483" ;
        dct:description "Sweep bars and labelled control bars on the figure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py#L456-L483> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor still not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 1.781 µm on a Holocene Canis lupus (MDCK) apical patch — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.99352 against a reference of 1, RMSE = 1.002 against 0, saturated k_meas/k_c = 0.976 against 1, and peak spacing 1.754e-6 m against 1.781e-6 m. Specimen nearest-neighbour spacing is 8.94 px against the model wavelength in micrometres (different quantity, stated as such). KS = 0.378 against a reference of 0, so the area shapes do not match; that is the score's ceiling." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-diffusivity-ratio-sweep-pearson-r-of-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-equal-diffusion-negative-control-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-nonlinear-dominant-wavenumber-over-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-segmented-specimen-domain-nearest-neighbour-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-simulated-activator-peak-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-specimen-versus-simulation-domain-area-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-turing-critical-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-turing-wavenumber-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-diffusivity-ratio-sweep-pearson-r-of-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-ratio sweep Pearson r of lambda_c = -0.9625514167733088 correlation" ;
        dct:description "ratios 6.0, 8.0, 12.0, 18.0, 30.0" ;
        schema:measurementTechnique "Pearson r between D_v/D_u and lambda_c across the unstable ratios in the sweep" ;
        schema:name "diffusivity-ratio sweep Pearson r of lambda_c" ;
        schema:unitText "correlation" ;
        schema:value "-0.9625514167733088" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-diffusivity-ratio-sweep-pearson-r-of-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-diffusivity-ratio-sweep-pearson-r-of-lambda-c-reference> a schema:PropertyValue ;
        dct:source "lambda falls as the inhibitor diffuses faster, toward the large-ratio asymptote" ;
        schema:value "-1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion goodness-of-fit Pearson r = 0.9935158009629034 correlation" ;
        dct:description "RMSE = 1.00213; p = 8.93e-11; value is not equal to the reference" ;
        schema:measurementTechnique "Pearson r between continuum sigma(k) and the eigenvalue of a coarse 8-point finite-difference Laplacian, 12 wavenumbers" ;
        schema:name "dispersion goodness-of-fit Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9935158009629034" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-dispersion-goodness-of-fit-pearson-r-reference> a schema:PropertyValue ;
        dct:source "identity of the two operators would be r = 1; the FD symbol differs" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 1.0021308147510768 1/time" ;
        dct:description "same 12-point k grid as the Pearson statistic" ;
        schema:measurementTechnique "root mean square of continuum sigma(k) minus finite-difference sigma(k)" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "1.0021308147510768" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero only if the discrete Laplacian matched the continuum symbol" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-equal-diffusion-negative-control-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion negative-control activator std = 2.9125873420833343e-15 concentration" ;
        dct:description "gamma=0 ablation std = 0.000687873" ;
        schema:measurementTechnique "same initial noise, D_v reset to D_u, short spectral integration" ;
        schema:name "equal-diffusion negative-control activator std" ;
        schema:unitText "concentration" ;
        schema:value "2.9125873420833343e-15" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-equal-diffusion-negative-control-activator-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-equal-diffusion-negative-control-activator-std-reference> a schema:PropertyValue ;
        dct:source "patterned regime activator std at D_v/D_u = 12" ;
        schema:value "0.25929148786790934" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-nonlinear-dominant-wavenumber-over-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear dominant wavenumber over k_c = 0.9762812094883317 dimensionless" ;
        dct:description "pattern std = 0.2593; clip fraction = 0" ;
        schema:measurementTechnique "argmax of the 2D Fourier power of the saturated activator, divided by analytical k_c" ;
        schema:name "nonlinear dominant wavenumber over k_c" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9762812094883317" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-nonlinear-dominant-wavenumber-over-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-nonlinear-dominant-wavenumber-over-k-c-reference> a schema:PropertyValue ;
        dct:source "onset formula k_c; the saturated peak shifts off onset" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-segmented-specimen-domain-nearest-neighbour-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen domain nearest-neighbour spacing = 8.94427190999916 px" ;
        dct:description "n_regions = 2813; NN CV = 0.7545334650650951; not equated to 1.781 µm" ;
        schema:measurementTechnique "Otsu on the green channel of the canonical Canis lupus micrograph, nearest-peak spacing of the distance transform" ;
        schema:name "segmented specimen domain nearest-neighbour spacing" ;
        schema:unitText "px" ;
        schema:value "8.94427190999916" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-segmented-specimen-domain-nearest-neighbour-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-segmented-specimen-domain-nearest-neighbour-spacing-reference> a schema:PropertyValue ;
        dct:source "model wavelength 1.781 µm — a different quantity; the micrograph has no scale bar" ;
        schema:value "1.781" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-simulated-activator-peak-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated activator peak spacing = 1.7540815744998853e-06 m" ;
        dct:description "spacing/lambda = 0.9849; n_peaks = 60" ;
        schema:measurementTechnique "median nearest-neighbour distance of saturated activator maxima, times metres_per_unit" ;
        schema:name "simulated activator peak spacing" ;
        schema:unitText "m" ;
        schema:value "1.7540815744998853e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-simulated-activator-peak-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-simulated-activator-peak-spacing-reference> a schema:PropertyValue ;
        dct:source "analytical lambda_c = 1.781e-6 m" ;
        schema:value "1.781e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-specimen-versus-simulation-domain-area-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus simulation domain-area KS statistic = 0.377581359273503 KS distance" ;
        dct:description "p = 9.151e-09; n_spec = 2813; n_sim = 66" ;
        schema:measurementTechnique "two-sample KS on median-normalised area distributions (specimen watershed vs activator peaks)" ;
        schema:name "specimen versus simulation domain-area KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.377581359273503" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-specimen-versus-simulation-domain-area-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-specimen-versus-simulation-domain-area-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean identical area shapes" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-turing-critical-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing critical wavelength lambda_c = 1.781e-06 m" ;
        dct:description "age 0.0 Ma; log10 = -5.7493; domain 14.2480 µm" ;
        schema:measurementTechnique "lambda_c = 2*pi/k_c with k_c^2 = (D_v f_u + D_u g_v)/(2 D_u D_v), length unit fixed so lambda_c = 1.781e-6 m" ;
        schema:name "Turing critical wavelength lambda_c" ;
        schema:unitText "m" ;
        schema:value "1.781e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-turing-critical-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-turing-critical-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Slot 3139 detail scale (1.8 µm, 1.781e-6 m, log10=-5.749)" ;
        schema:value "1.781e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-turing-wavenumber-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing wavenumber k_c = 3527897.42121257 1/m" ;
        dct:description "dimensionless k_c = 4.222953" ;
        schema:measurementTechnique "k_c = 2*pi/lambda_c at lambda_c = 1.781e-6 m" ;
        schema:name "Turing wavenumber k_c" ;
        schema:unitText "1/m" ;
        schema:value "3527897.42121257" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-turing-wavenumber-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-measurement-turing-wavenumber-k-c-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion; wavelength fixed by the slot scale" ;
        schema:value "3527897.4212125693" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py L128–L157" ;

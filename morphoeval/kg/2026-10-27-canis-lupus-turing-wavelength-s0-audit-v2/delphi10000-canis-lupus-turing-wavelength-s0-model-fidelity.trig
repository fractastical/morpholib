sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 1.781 µm on a Holocene Canis lupus (MDCK) apical patch — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg kinetics, the Jacobian, and the Turing k_c formula are unchanged and still integrate on the periodic patch with a clip fraction of 0. Pass 2 adds the two controls the dispersion relation predicts: equal diffusion quenches (std 2.9e-15) and gamma=0 only diffuses the seed (std 6.9e-4) against a patterned std of 0.259. The 1 s time unit used to quote D_phys remains a reconstruction." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py L72–L96" ;
        dct:description "Jacobian, k_c^2, continuum sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py#L72-L96> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py L383–L387" ;
        dct:description "Equal-diffusion and gamma=0 integrations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py#L383-L387> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor still not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


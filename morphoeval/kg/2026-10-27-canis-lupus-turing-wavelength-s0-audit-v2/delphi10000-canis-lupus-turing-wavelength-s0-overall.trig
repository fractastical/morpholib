sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-canis-lupus-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 1.781 µm on a Holocene Canis lupus (MDCK) apical patch — MorphoEval overall 87.4/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 2 turns on the diffusivity sweep, the equal-diffusion and gamma=0 controls, and the KS area comparison that pass 1 left gated. Ratios D_v/D_u of 6 and 8 are linearly stable; 12, 18 and 30 are unstable and lambda_c falls from 1.781 µm to 1.697 µm. Pattern activator std is 0.259; equal diffusion falls to 2.9e-15 and gamma=0 to 6.9e-4. Dispersion Pearson r remains 0.9935 (RMSE 1.002). Specimen-versus-spot area KS is 0.378 (p = 9.2e-9): the micrograph's domain areas are not the spot lattice, and that mismatch is reported rather than fitted away. The GIF is unchanged in kind: 16 frames, 640×480, CV similarity 96.0 against the canonical micrograph. Age 0 Ma, scale 1.781e-6 m. Signing keys are not on this machine. Overall 87.4/100 (faithfulness 87.4, reproducibility 87.5); rubric morphoeval 0.1.0; checkpoint commit 0c76d15d14afcec6c366e1b9274a6586a0de48fc; environment: . Dimension assessments: Model fidelity to source 90, Morphological realism / specimen match 84, Parameter expressivity 90, Morphometric validation 88, Source and data traceability 88, Code-to-model traceability 86, Reproducibility package 88. Output judged: docs/media/canis_lupus_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 622920 B, 1512×984 px, artifact_sha256 38a5f6da5be0851597fb5b601013b45c1e40c4e03be02734838d6a4589464023 (sha256 38a5f6da5be0851597fb5b601013b45c1e40c4e03be02734838d6a4589464023), spec_fingerprint 32ef3bbb738079fa3f2ca196a6ebf3a8f753f2f1e9cf9f5d0d12a208ec2f4990. Dual provenance: spec_fingerprint: 1384d9b17e356fe071ee14fb12c57b4d3761c15343bddda445ec92854a2f9659; artifact_sha256: 38a5f6da5be0851597fb5b601013b45c1e40c4e03be02734838d6a4589464023; input_dataset_sha256: {datasets/canis_lupus_turing_wavelength_s0/canis_lupus_turing_wavelength_s0_reference.json=d16ba21863080c9e..., datasets/canis_lupus_turing_wavelength_s0/canis_lupus_turing_wavelength_s0_specimen.jpg=8dd4a5b3caa19a6f...}. Supersedes audit: 2026-10-27-canis-lupus-turing-wavelength-s0-audit. Claim boundary: reported_in_source: Turing dispersion relation and a finite unstable band of wavenumbers | Schnakenberg trimolecular kinetics | Murray coat pre-patterns are centimetre-scale | MDCK cells are a polarized canine epithelium | Domestic-dog black coat is a beta-defensin allele, not a measured micrometre wavelength; reconstructed_in_script: a=0.10, b=1.10, gamma=40, D_u=0.8, D_v=9.6 chosen so lambda_c = 1.781e-6 m | Time unit of 1 s used only to quote an equivalent diffusivity | Periodic 8-wavelength patch as one apical face | Diffusivity-ratio sweep and the two negative controls; transfer_boundary: Murray 1981 is not a measurement of Canis lupus at 1.8 µm | The gallery micrograph has no scale bar; KS = 0.38 compares area shapes, not micrometres; does_not_claim: That Holocene wolf coat spots have wavelength 1.781 µm | That each histological polygon is one Turing spot | That a second assessor scored this pass | That the nanopublications were signed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'Closed in this pass. Sweep is executed, plotted (ratios 6 and 8 stable; 12, 18, 30 unstable), and written to the sidecar.', 'status': 'closed'}",
            "remediation needed: {'id': 'R2', 'item': 'Closed in this pass. Equal-diffusion std 2.9e-15 and gamma=0 std 6.9e-4 are drawn against the patterned std 0.259.', 'status': 'closed'}",
            "remediation needed: {'id': 'R3', 'item': 'Closed in this pass. KS = 0.378 (p = 9.2e-9) on median-normalised areas; value is not the reference 0.', 'status': 'closed'}",
            "remediation needed: {'id': 'R4', 'item': \"Open. No independent second assessor. This score is still the builder's.\", 'status': 'open'}",
            "remediation needed: {'id': 'R5', 'item': 'Closed in this pass. The specimen panel and the footer state that nearest-neighbour spacing is in pixels and is not 1.781 µm.', 'status': 'closed'}",
            "remediation needed: {'id': 'R6', 'item': \"Open residual, not a pass-1 miss. KS = 0.38 means the micrograph's domain areas are a different shape from the spot lattice. Forcing the PDE to copy those polygons would erase the claim boundary.\", 'status': 'open'}" ;
        pk:hasScore "0.874"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor still not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


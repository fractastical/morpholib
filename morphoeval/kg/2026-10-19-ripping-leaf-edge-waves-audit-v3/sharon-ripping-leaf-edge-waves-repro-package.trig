sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Reproducibility package: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`self_test()` (L1787-L1888) now runs 11 checks in ~7 s — the 8 Pass 2 checks plus PIN1 transport sum(da) = 0 (< 1e-10), TCP front saturation and v_tcp = 0 => m = 0; WT N_ser >= 5 with >= 2 primary and >= 2 secondary tips, hierarchy > 1.5, g_0(y) >= 0, |<g_0> - 0.64| <= 0.10, M >= 3, K(0) < 0, basal/apical g_0 > 1, finite emergence time, monotone <g_0>(t); all 6 ordinal checks and a bitwise-deterministic developmental re-run; `assert len(meas) == 15` (L1878). The default render exits 0 in ~6 s and regenerates the Pass 2 PNG/GIF byte-identically plus the two new developmental media files. Deductions: the developmental GIF requires no flag but both PNGs are gitignored, so the rendered figures are not tracked artifacts and will not show in `git status` (-2); matplotlib needs `MPLCONFIGDIR` set when `~/.matplotlib` is not writable and the script does not say so (-1); `measure_morphoeval()` cannot be pointed at a non-default genotype so the measurement table for cin / TCP-OE is reproducible only through the sweep internals (-2); no requirements lock file is vendored for this slot (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2002-sharon-ripping-leaf-edge-waves.py L1616–L1621: measure_morphoeval() has no parameters: non-default genotype measurement tables are not directly reproducible from the CLI <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L1616-L1621>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L1787–L1888" ;
        dct:description "11-check self_test(): SHA-256 integrity, K < 0, flat-metric negative control, cascade spectrum/collapse, inward profile, 4-system transition, specimen CV, bitwise determinism, PIN1 mass conservation, developmental WT invariants, ordinal checks + deterministic re-run" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L1787-L1888> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L1890–L1940" ;
        dct:description "main(): argparse CLI (--g0, --ell, --t, --r-cascade, --seed, --genotype, --skip-developmental, --self-test), default render of all four media files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L1890-L1940> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/ripping_leaf_edge_waves_tcp_auxin_development.gif (generated output)" ;
        dct:description "New 12-frame developmental GIF produced by the default invocation — docs/media/ripping_leaf_edge_waves_tcp_auxin_development.gif: rendered output of 2002-sharon-ripping-leaf-edge-waves.py at 327729c8, image/gif, 608441 B, 608×456 px, 12 frames, artifact_sha256 d6c30cfd7118139426f3f40d74681cc95edf7aded9ab0b23d24a6a0e03279b62 (sha256 d6c30cfd7118139426f3f40d74681cc95edf7aded9ab0b23d24a6a0e03279b62), spec_fingerprint 269fab4dc5e4e98c580cb49e700e990d268686b3f7823f895d6d7cb6898a616e" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/ripping_leaf_edge_waves_growth.gif (generated output)" ;
        dct:description "Pass 2 growth GIF regenerated byte-identically by the Pass 3 default invocation (SHA-256 6fb757af...) — docs/media/ripping_leaf_edge_waves_growth.gif: rendered output of 2002-sharon-ripping-leaf-edge-waves.py at 327729c8, image/gif, 601703 B, 608×456 px, 12 frames, artifact_sha256 6fb757af43910b5840cd6441f73b8448a6e486cdcb2f388d8aceca8256fbf31e (sha256 6fb757af43910b5840cd6441f73b8448a6e486cdcb2f388d8aceca8256fbf31e), spec_fingerprint 269fab4dc5e4e98c580cb49e700e990d268686b3f7823f895d6d7cb6898a616e" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 067 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


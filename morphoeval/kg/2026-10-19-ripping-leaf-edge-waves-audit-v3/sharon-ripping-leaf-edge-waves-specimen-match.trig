sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The SHA-256-locked *Lactuca sativa* cv. 'Lollo Bionda' specimen is still segmented via Excess Green (`segment_lactuca_sativa_specimen`, L631-L706; canopy fraction 0.7723; 4 coarse macro-lobes, 19 fine ripples, cascade ratio 4.75 in [3, 5]) and the 4-system aspect-ratio comparison (r_aspect = 0.9992) is unchanged; the new developmental figure adds a 3D coupled FvK surface with in-plane serration outgrowth and a genotype sweep against observed ranges. Deductions: the developmental module is compared with no specimen image at all — its only biological anchor is an ordinal phenotype table transcribed from Arabidopsis papers, applied to a Lactuca margin (-4); the 3D coupled mesh uses fixed mode phases (L401, L1024), an unsourced 0.18 in-plane contraction factor (L415) and an arbitrary 6 mm edge-displacement decay (L1033), and its y-modulation is visibly spiky because g_0(y) follows the auxin peaks (-3); the specimen cascade ratio is a count of perimeter extrema, not a wavelength or amplitude spectrum (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2002-sharon-ripping-leaf-edge-waves.py L1014–L1034: Developmental coupled mesh: fixed mode phases (L1024) and arbitrary 6 mm edge-displacement decay (L1033), unsourced <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L1014-L1034>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L631–L706" ;
        dct:description "ExG canopy segmentation and multi-scale polar perimeter wave decomposition on the SHA-256-locked Lactuca sativa specimen (Pass 2, unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L631-L706> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/ripping_leaf_edge_waves_comparison.png (generated output)" ;
        dct:description "6-panel synthesis: 3D cascade/saddle meshes, G1-G4 spectrum, self-similar collapse, K(x) profile, specimen segmentation, 4-system validation (byte-identical to Pass 2) — docs/media/ripping_leaf_edge_waves_comparison.png: rendered output of 2002-sharon-ripping-leaf-edge-waves.py at 327729c8, image/png, 1731094 B, 2775×1680 px, artifact_sha256 d5fb947fa012711aa8cf8764f2abea6d111decc28d191e48affe89c491a8ecda (sha256 d5fb947fa012711aa8cf8764f2abea6d111decc28d191e48affe89c491a8ecda), spec_fingerprint 269fab4dc5e4e98c580cb49e700e990d268686b3f7823f895d6d7cb6898a616e" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/ripping_leaf_edge_waves_tcp_auxin_development.png (generated output)" ;
        dct:description "New 6-panel developmental figure: auxin kymograph + TCP front, final fields + g_0(y) + serration tips, outgrowth hierarchy, 3D coupled FvK surface, genotype sweep vs observed ranges, emergence time courses — no specimen image on this figure — docs/media/ripping_leaf_edge_waves_tcp_auxin_development.png: rendered output of 2002-sharon-ripping-leaf-edge-waves.py at 327729c8, image/png, 876318 B, 2775×1680 px, artifact_sha256 e36dd998d9670319f19c094f2ad9449a5c8ca6242863a2c412e84e145a9bfcff (sha256 e36dd998d9670319f19c094f2ad9449a5c8ca6242863a2c412e84e145a9bfcff), spec_fingerprint 269fab4dc5e4e98c580cb49e700e990d268686b3f7823f895d6d7cb6898a616e" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 067 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


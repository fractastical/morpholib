sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Parameter expressivity: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Pass 2 sweeps (4 cascade generations L431-L514, 9 inward stations L516-L555, 4 sheet systems L557-L629) are retained and Pass 3 adds a genuine biological parameter axis: 5 genotype presets (`GENOTYPE_PRESETS`, L743-L750) scaling TCP front speed, CUC2->PIN1 gain and transport rate, swept by `evaluate_developmental_genotype_sweep` (L1037-L1095) with all 15 kinetic / growth parameters exposed as keyword arguments of `simulate_tcp_auxin_margin_development` (L805-L829), plus CLI `--genotype` and `--skip-developmental` (L1899-L1905) honoured in `main()` (L1927-L1936). Deductions: `measure_morphoeval()` ignores CLI overrides and always runs seed 2002 / defaults (L1616-L1621), so the measurement table cannot be re-expressed along any swept axis (-3); gamma_0 and beta_auxin are not swept, only the genotype presets are (-2); the genotype presets are discrete multipliers rather than a continuous dose-response along v_tcp (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2002-sharon-ripping-leaf-edge-waves.py L1616–L1621: measure_morphoeval() takes no arguments and always uses seed 2002 / default parameters — CLI overrides do not reach the measurement table <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L1616-L1621>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L431–L629" ;
        dcterms:description "4-generation cascade evaluation, 9-point inward distance sweep and 4-system thickness/taxon sweep (Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L431-L629> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L743–L750" ;
        dcterms:description "GENOTYPE_PRESETS: wild_type, cin_tcp_loss_of_function (v_tcp x0.40), tcp_mir319_resistant_overexpression (x1.80), cuc2_knockout (CUC2->PIN1 gain 0), pin1_knockout (transport 0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L743-L750> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L1037–L1095" ;
        dcterms:description "5-genotype developmental sweep with 6 ordinal literature checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L1037-L1095> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L1899–L1905" ;
        dcterms:description "CLI --genotype and --skip-developmental added to --g0/--ell/--t/--r-cascade/--seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L1899-L1905> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 067 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


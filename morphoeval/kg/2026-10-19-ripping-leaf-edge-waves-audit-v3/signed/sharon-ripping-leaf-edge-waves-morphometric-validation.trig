        schema:name "Pass 3 cin/jaw-D (TCP loss-of-function) over wild-type excess marginal growth ratio <g_0>_cin / <g_0>_WT" ;
        schema:unitText "dimensionless" ;
        schema:value "2.0962" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-cin-jaw-d-tcp-loss-of-function-over-wild-type-excess-marginal-growth-ratio-g-0-cin-g-0-wt-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-cin-jaw-d-tcp-loss-of-function-over-wild-type-excess-marginal-growth-ratio-g-0-cin-g-0-wt-reference> a schema:PropertyValue ;
        dcterms:source "Nath et al. (2003) Science 299:1404-1407 (ordinal: cin > WT, K < 0; 1.5 is a placeholder magnitude) & Palatnik et al. (2003) Nature 425:257-263" ;

        schema:name "Pass 3 cuc2 / pin1 knockout negative control: maximum serration count across both ablations" ;
        schema:unitText "count" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-cuc2-pin1-knockout-negative-control-maximum-serration-count-across-both-ablations-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-cuc2-pin1-knockout-negative-control-maximum-serration-count-across-both-ablations-reference> a schema:PropertyValue ;
        dcterms:source "Nikovics et al. (2006) Plant Cell 18:2929-2945; Hay, Barkoulas & Tsiantis (2006) Nat. Genet. 38:942-947; Bilsborough et al. (2011) PNAS (smooth margins)" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-developmental-genotype-ordinal-phenotype-agreement-fraction-6-literature-checks> a schema:PropertyValue,

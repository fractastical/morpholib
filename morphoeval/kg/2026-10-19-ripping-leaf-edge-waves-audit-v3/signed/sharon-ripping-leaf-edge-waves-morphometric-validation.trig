        schema:name "Pass 3 developmental genotype ordinal-phenotype agreement fraction (6 literature checks)" ;
        schema:unitText "fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-developmental-genotype-ordinal-phenotype-agreement-fraction-6-literature-checks-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-developmental-genotype-ordinal-phenotype-agreement-fraction-6-literature-checks-reference> a schema:PropertyValue ;
        dcterms:source "Nath et al. (2003) Science; Palatnik et al. (2003) Nature; Efroni et al. (2008) Plant Cell; Nikovics et al. (2006) Plant Cell; Hay & Tsiantis (2006) Nat. Genet.; Bilsborough et al. (2011) PNAS" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-developmental-wild-type-excess-metric-g-0-from-coupled-cin-tcp-auxin-cuc2-growth-pdes> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pass 3 developmental wild-type excess metric <g_0> from coupled CIN/TCP-auxin-CUC2 growth PDEs = 0.6059 dimensionless" ;
        dcterms:description "K(0) on developmental <g_0> = -0.001063 mm^-2; FvK cascade re-solved: M = 4 active generations, mean A/lambda = 0.1428" ;
        schema:measurementTechnique "Forward-Euler CIN/TCP-auxin/PIN1-CUC2 margin PDEs on a growing Lagrangian lattice; g_0 = ((1+Gamma_mar)/(1+Gamma_int))^2 - 1 averaged along the margin at T=240 h (margin stretch x1.93)" ;
        schema:name "Pass 3 developmental wild-type excess metric <g_0> from coupled CIN/TCP-auxin-CUC2 growth PDEs" ;
        schema:unitText "dimensionless" ;
        schema:value "0.6059" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-developmental-wild-type-excess-metric-g-0-from-coupled-cin-tcp-auxin-cuc2-growth-pdes-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-developmental-wild-type-excess-metric-g-0-from-coupled-cin-tcp-auxin-cuc2-growth-pdes-reference> a schema:PropertyValue ;
        dcterms:source "Lactuca sativa g_0 = 0.64 of the Pass 2 mechanical module (self-consistency calibration target; gamma_0, beta tuned)" ;
        schema:value "0.64" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-primary-lobe-secondary-serration-outgrowth-hierarchy-ratio-median-s-primary-median-s-secondary> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pass 3 primary-lobe / secondary-serration outgrowth hierarchy ratio (median s_primary / median s_secondary) = 3.9894 dimensionless" ;
        dcterms:description "basal/apical g_0 ratio = 7.547 (>1: TCP front reaches the base last)" ;
        schema:measurementTechnique "Tips split at half the tallest outgrowth; hierarchy arises from auxin-maximum insertion as the Lagrangian lattice stretches (Bilsborough et al. 2011)" ;
        schema:name "Pass 3 primary-lobe / secondary-serration outgrowth hierarchy ratio (median s_primary / median s_secondary)" ;
        schema:unitText "dimensionless" ;
        schema:value "3.9894" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-primary-lobe-secondary-serration-outgrowth-hierarchy-ratio-median-s-primary-median-s-secondary-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-primary-lobe-secondary-serration-outgrowth-hierarchy-ratio-median-s-primary-median-s-secondary-reference> a schema:PropertyValue ;
        dcterms:source "Cross-module consistency with the Audoly & Boudaoud (2003) cascade ratio r_cascade = 3.5 of the mechanical module; NOT an independent empirical value" ;
        schema:value "3.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-wild-type-serration-count-n-serrations-from-auxin-pin1-convergence-maxima-on-the-growing-margin> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pass 3 wild-type serration count N_serrations from auxin/PIN1 convergence maxima on the growing margin = 27 count" ;
        dcterms:description "primary lobes = 12, secondary serrations = 15; in-range fraction across 5 genotypes = 1.00" ;
        schema:measurementTechnique "Peaks of accumulated outgrowth s(y,T) (prominence 8% of max, >=1.5 mm apart, lattice ends excluded) on L_final = 69.6 mm; mean tip spacing = 2.19 mm; first >=2 maxima at t = 5 h" ;
        schema:name "Pass 3 wild-type serration count N_serrations from auxin/PIN1 convergence maxima on the growing margin" ;
        schema:unitText "count" ;
        schema:value "27" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-wild-type-serration-count-n-serrations-from-auxin-pin1-convergence-maxima-on-the-growing-margin-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-pass-3-wild-type-serration-count-n-serrations-from-auxin-pin1-convergence-maxima-on-the-growing-margin-reference> a schema:PropertyValue ;
        dcterms:source "Bilsborough et al. (2011) PNAS 108:3424-3429 & Sharon et al. (2002) Fig. 1c — broad plausibility range [5, 40], midpoint reported; NOT a digitised count" ;
        schema:value "22.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-self-similar-rescaled-profile-collapse-correlation-across-generations-g1-g4> a schema:PropertyValue,

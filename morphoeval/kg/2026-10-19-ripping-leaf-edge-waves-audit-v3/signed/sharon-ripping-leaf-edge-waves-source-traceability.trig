sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L101–L140" ;
        dcterms:description "Runtime SHA-256 verification of the 4 Pass 2 dataset files (byte-unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L101-L140> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L741–L763" ;
        dcterms:description "EXPECTED_DEVELOPMENTAL_SHA256 pin and load_developmental_reference() fail-closed check of tcp_auxin_developmental_reference.json" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L741-L763> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/ripping_leaf_edge_waves/README.md L16–L23" ;
        dcterms:description "Pass 3 addendum: SHA-256 of the new table, calibration-target caveat, and explicit statement that the 9 new DOIs were not re-verified online" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/327729c8/datasets/ripping_leaf_edge_waves/README.md#L16-L23> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Source and data traceability: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The 4 Pass 2 dataset files remain SHA-256-verified at runtime (`verify_dataset_integrity`, L101-L140) and the new `tcp_auxin_developmental_reference.json` is pinned (`EXPECTED_DEVELOPMENTAL_SHA256`, L741; `load_developmental_reference`, L753-L763) and documented in the README addendum together with the 9 new primary sources in `developmental_citations_pass3.bib`; the module header (L1-L70) cites each source with journal/volume/page. Deductions: all 9 new DOIs were transcribed offline and NOT verified online (network tools disallowed this pass) — the README says so, but a wrong DOI would propagate into the KG (-4); `developmental_citations_pass3.bib` is not SHA-256-pinned, unlike the Pass 2 `paper_citations.bib` (-2); the Pass 2 reference table's G1-G4 and 9-station profile values are analytic (g_yy, K from the same formulas; lambda_loc linear) rather than digitised from Sharon 2002 Fig. 3, and the phenotype table is ordinal rather than quantitative (-2); `K(0) = -1.091e-3` is hard-coded in the panel-D title (L1242) rather than taken from the reference (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2002-sharon-ripping-leaf-edge-waves.py L1242–L1242: K(0) = -1.091e-3 hard-coded in the panel-D title instead of read from the reference table <https://github.com/fractastical/morpholib/blob/327729c8/2002-sharon-ripping-leaf-edge-waves.py#L1242-L1242>",
            "datasets/ripping_leaf_edge_waves/developmental_citations_pass3.bib L1–L102: 9 new BibTeX entries with DOIs transcribed offline; file is not SHA-256-pinned <https://github.com/fractastical/morpholib/blob/327729c8/datasets/ripping_leaf_edge_waves/developmental_citations_pass3.bib#L1-L102>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 067 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


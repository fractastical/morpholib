sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Dickinsonia costata cellular Turing wavelength, 56 µm, White Sea 558 Ma (Pass 1) — Morphological realism / specimen match: 52/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the Verisimilus fossil beside the field, and they do not match: the fossil is an oval of parallel modules and the field is a spot lattice. Coarse CV similarity of the Pass 1 GIF is 83.4, which overstates the visual resemblance." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/dickinsonia_costata_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "fossil beside unfitted spot field — docs/media/dickinsonia_costata_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-dickinsonia-costata-turing-wavelength-s0.py at 0c76d15d, image/png, 700140 B, 1440×984 px, artifact_sha256 fd889af7f5a33470176528fe09732ad7646a1709adc873f960f5704e6edf8102 (sha256 fd889af7f5a33470176528fe09732ad7646a1709adc873f960f5704e6edf8102), spec_fingerprint fd86eb9ab09aa054555305e9405e0ca0d623d01f76b8fb3f7e4bc2a4741557ec" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dickinsonia-costata-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

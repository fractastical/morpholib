sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Ambulocetus natans Turing wavenumber at 224 µm (47.5 Ma, detail primordium) faithfully reproduces Ambulocetus natans morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py, morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean implement the cited source model as published and produce forms that match real Ambulocetus natans specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py>,
            <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean; output: docs/media/ambulocetus_natans_turing_wavelength_s0_growth.gif; organism: Ambulocetus natans; environment: python 3.12, numpy 2.5, scipy 1.18; claim_boundary: [reported_in_source: Turing 1952: diffusion-driven instability at a finite wavenumber. | Schnakenberg 1979: activator-inhibitor kinetics du/dt = a - u + u^2 v + Du lap u. | Thewissen, Hussain and Arif 1994: Ambulocetus natans, amphibious archaeocete, early middle Eocene of Pakistan. | Thewissen et al. 2001 and Gingerich et al. 1994: Pakicetus is more terrestrial; Rodhocetus is more aquatic.; reconstructed_in_script: Dimensionless parameters a=0.05, b=0.90, Du=1, Dv=50 and gamma=8, length-scaled to a 224 µm fastest mode. | Forward-Euler dispersion check and a nonlinear periodic patch. | Chronoseries wavelengths 190, 224 and 260 µm from lambda = 224 µm * sqrt(h).; transfer_boundary: Hydration h=0.72 and h=1.35 are this slot's reconstruction of how dermal diffusivity could change from Pakicetus to Rodhocetus. They are not in the fossil papers. | The flank window is a visualization of a dermal primordium on a photograph of bone.; does_not_claim: That 224 µm stripes are preserved on the Naturalis skeleton. | That the emergent 178 µm peak was measured on a fossil skin.]; phenomenon_size: 208 µm (0.0002083 m, log10=-3.681 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 208 µm to 46.9 cm): 208 µm:ambulocetus-natans-bioelectric-polarity, 651 µm:ambulocetus-natans-vertex-packing, 1.0 cm:ambulocetus-natans-turing-wavelength, 2.1 cm:ambulocetus-natans-clock-wavefront, 4.7 cm:ambulocetus-natans-morphogen-condensation, 5.7 cm:ambulocetus-natans-elastic-buckling, 6.5 cm:ambulocetus-natans-flux-canalization, 9.1 cm:ambulocetus-natans-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/35095005>,
            <https://doi.org/10.1038/368844a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.263.5144.210> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
    <https://github.com/fractastical/morpholib/blob/main/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean> a schema:SoftwareSourceCode ;
        rdfs:label "morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Lean 4" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/35095005>,
            <https://doi.org/10.1038/368844a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047>,
            <https://doi.org/10.1126/science.263.5144.210> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/35095005> dct:date "2001"^^xsd:gYear ;
        dct:title "Skeletons of terrestrial cetaceans and the relationship of whales to artiodactyls" .
    <https://doi.org/10.1038/368844a0> dct:date "1994"^^xsd:gYear ;
        dct:title "New whale from the Eocene of Pakistan and the origin of cetacean swimming" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1179047> dct:date "2010"^^xsd:gYear ;
        dct:title "Reaction-diffusion model as a framework for understanding biological pattern formation" .
    <https://doi.org/10.1126/science.263.5144.210> dct:date "1994"^^xsd:gYear ;
        dct:title "Fossil evidence for the origin of aquatic locomotion in archaeocete whales" .
}


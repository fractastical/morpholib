sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Ambulocetus natans Turing wavenumber at 224 µm (47.5 Ma, detail primordium) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Analytic versus Euler growth rates give Pearson r=0.9997 and RMSE=0.0034. The nonlinear radial peak is about 178 µm against the 224 µm slot target. Otsu foreground fraction, structure-tensor coherency and a KS test compare the fossil photograph with the field, and those pairs are not value==reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-eigenvalue-vs-forward-euler>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-emergent-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-vs-model-orientation-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-eigenvalue-vs-forward-euler> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r (analytic eigenvalue vs forward Euler) = 0.999699 correlation" ;
        dct:description "RMSE=0.00336" ;
        schema:measurementTechnique "pearsonr of σ(k) on 28 wavenumbers" ;
        schema:name "dispersion Pearson r (analytic eigenvalue vs forward Euler)" ;
        schema:unitText "correlation" ;
        schema:value "0.999699" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-eigenvalue-vs-forward-euler-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-eigenvalue-vs-forward-euler-reference> a schema:PropertyValue ;
        dct:source "exact eigenvalue of J - k^2 D" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.003356 growth-rate units" ;
        schema:measurementTechnique "root mean square of analytic minus Euler σ(k)" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "growth-rate units" ;
        schema:value "0.003356" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero truncation error" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-emergent-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "emergent stripe wavelength = 177.8 µm" ;
        dct:description "analytic fastest mode mapped to 224 µm; onset k_c=0.662, fastest k=0.394." ;
        schema:measurementTechnique "radial FFT peak of the nonlinear Schnakenberg field, scaled so the analytic fastest mode is 224 µm" ;
        schema:name "emergent stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "177.8" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-emergent-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-emergent-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot target wavelength, 224 µm at 47.5 Ma" ;
        schema:value "224.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation final activator std = 0.00719 concentration" ;
        dct:description "control initial std=0.0403; sigma_max equal=-0.0103" ;
        schema:measurementTechnique "nonlinear Schnakenberg with Du=Dv, same noise amplitude" ;
        schema:name "equal-diffusion ablation final activator std" ;
        schema:unitText "concentration" ;
        schema:value "0.00719" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-equal-diffusion-ablation-final-activator-std-reference> a schema:PropertyValue ;
        dct:source "final std of the Turing run (Dv/Du=50)" ;
        schema:value "1.34247" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image foreground fraction = 0.1783 area fraction" ;
        dct:description "bbox aspect=1.478" ;
        schema:measurementTechnique "Otsu threshold on the Naturalis mount luminance" ;
        schema:name "specimen image foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.1783" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "model flank coherency, a different quantity, so this pair is not self-referential" ;
        schema:value "0.1136" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency = 0.3591 coherency" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor on the fossil photograph" ;
        schema:name "specimen image structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.3591" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "same operator on the Schnakenberg activator field" ;
        schema:value "0.1136" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-vs-model-orientation-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image vs model orientation KS statistic = 0.066 KS distance" ;
        dct:description "p=0.00182" ;
        schema:measurementTechnique "ks_2samp on Sobel orientation samples from the fossil and the simulated field" ;
        schema:name "specimen image vs model orientation KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.066" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-vs-model-orientation-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-measurement-specimen-image-vs-model-orientation-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical orientation distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py L116–L145" ;
        dct:description "Dispersion goodness of fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b5/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py#L116-L145> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py L522–L598" ;
        dct:description "measure_morphoeval specimen and KS rows" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b5/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py#L522-L598> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ambulocetus-natans-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Ambulocetus natans Turing wavenumber at 224 µm (47.5 Ma, detail primordium) — Code-to-model traceability: 86/100" ;

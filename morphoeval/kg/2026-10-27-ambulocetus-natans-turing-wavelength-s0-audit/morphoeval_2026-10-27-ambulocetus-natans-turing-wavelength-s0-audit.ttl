<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing trace-diffusion numerator" ;
    dct:description "Sign condition for Turing wavenumber selection at the 224 µm primordium | Variables: D_u=2, D_v=40, f_u=3, g_v=-6 in the integer skeleton; dimensionless floats D_u=1, D_v=50 in the script" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b5/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/dff4f2b5/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean#L60-L63> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v f_u + D_u g_v > 0 opens a finite-k band; equal diffusivities keep it negative" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/35095005>,
        <https://doi.org/10.1038/368844a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.263.5144.210> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3106.dvTuring" ;
    pk:leanTheorem "MathOfBiology.Loop_3106.faster_inhibitor_opens_turing_band" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength and chronoseries order" ;
    dct:description "What changes at this age and scale relative to the predecessor and successor chronospecies | Variables: h_Pakicetus=0.72, h_Ambulocetus=1, h_Rodhocetus=1.35; age 47.5 Ma" ;
    dct:source "Thewissen, Hussain and Arif (1994) DOI:10.1126/science.263.5144.210" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b5/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/dff4f2b5/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean#L31-L41> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda(h) = 224 µm * sqrt(h); 190 µm < 224 µm < 260 µm so k decreases Pakicetus to Rodhocetus" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/35095005>,
        <https://doi.org/10.1038/368844a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.263.5144.210> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3106.lambdaAmbulocetusUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3106.chronoseries_wavelength_increases" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ambulocetus-natans-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Stripe count on a fixed primordium" ;
    dct:description "Domain-growth mode count at the detail scale, distinct from the 1 cm sibling slot | Variables: L = 6 * 224 µm" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b5/models/2026-delphi10000-ambulocetus-natans-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/dff4f2b5/morphoeval/lean/loops/Loop_3106_ambulocetus_natans_turing_wavelength_s0.lean#L48-L53> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(L / lambda) with L = 1344 µm; N = 7, 6, 5 along the chronoseries" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/35095005>,
        <https://doi.org/10.1038/368844a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1126/science.263.5144.210> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3106.primordiumDomainUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3106.stripe_count_decreases_as_wavelength_grows" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Acanthostega gunnari Turing wavenumber at 105 µm (Pass 1, r = 16) — Morphometric validation: 66/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass-1 FFT wavelength 125.53 µm versus analytic 104.9 µm (relative error 0.197). Dispersion Pearson r = 0.993 on a band that still included ill-resolved modes." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-ichthyostega-inhibitor-slowed-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-dermal-patch-ocellus-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-orientation-histogram-ks-distance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-tiktaalik-along-ray-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-tiktaalik-cross-ray-specimen-scale-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-wavelength-sweep-coefficient-of-variation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion growth-rate Pearson r = 0.9999 correlation" ;
        dct:description "reference is the pass threshold; the achieved correlation is higher" ;
        schema:measurementTechnique "corrcoef of analytic σ(k) and 1D Euler growth rates on probe modes 10..20 (band around k_c)" ;
        schema:name "dispersion growth-rate Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-dispersion-growth-rate-pearson-r-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate for this loop (not a Turing 1952 table entry)" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion growth-rate RMSE = 0.005 1/time" ;
        schema:measurementTechnique "sqrt mean square residual of σ_hat(k) against σ_analytic(k)" ;
        schema:name "dispersion growth-rate RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.005" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-dispersion-growth-rate-rmse-reference> a schema:PropertyValue ;
        dct:source "exact linearisation residual would be 0 in the infinitesimal-amplitude limit" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation growth rate = -0.0989 1/time" ;
        schema:measurementTechnique "max_k σ(k) at Dv = Du (r = 1); Turing numerator is negative" ;
        schema:name "equal-diffusion ablation growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.0989" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-equal-diffusion-ablation-growth-rate-reference> a schema:PropertyValue ;
        dct:source "a patterning control would have positive growth; ablation must not" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-ichthyostega-inhibitor-slowed-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ichthyostega inhibitor-slowed wavelength = 105.5387 µm" ;
        schema:measurementTechnique "same Du, Dv scaled by 0.92 (reconstructed cornified-dermis factor), analytic k_c" ;
        schema:name "Ichthyostega inhibitor-slowed wavelength" ;
        schema:unitText "µm" ;
        schema:value "105.5387" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-ichthyostega-inhibitor-slowed-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-ichthyostega-inhibitor-slowed-wavelength-reference> a schema:PropertyValue ;
        dct:source "Acanthostega λ_c; successor at 363 Ma is a different point" ;
        schema:value "104.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.33 4πA/P^2" ;
        schema:measurementTechnique "mask area and morphological perimeter of the Brussels skull photograph" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "4πA/P^2" ;
        schema:value "0.33" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circle baseline; a flattened skull is not a circle" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-dermal-patch-ocellus-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen dermal-patch ocellus wavelength = 106.9344 µm" ;
        dct:description "value is the measured FFT wavelength; reference is the analytic k_c target" ;
        schema:measurementTechnique "radial FFT peak of the saturated Schnakenberg activator on the 128^2 patch" ;
        schema:name "specimen dermal-patch ocellus wavelength" ;
        schema:unitText "µm" ;
        schema:value "106.9344" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-dermal-patch-ocellus-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-dermal-patch-ocellus-wavelength-reference> a schema:PropertyValue ;
        dct:source "Slot calibration of k_c to 104.9 µm (Turing 1952 / Murray 1981); numerical peak is independent" ;
        schema:value "104.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.5568 area fraction" ;
        schema:measurementTechnique "border-median contrast mask on the Brussels Acanthostega skull (verify_image_fitness family)" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.5568" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral occupancy prior, not the measured mask" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-orientation-histogram-ks-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen orientation-histogram KS distance = 0.1368 KS" ;
        dct:description "non-circular specimen metric: the fossil plate and the ocellus field are different images" ;
        schema:measurementTechnique "max CDF gap between 12-bin Sobel orientation of the Brussels skull and of the RD field" ;
        schema:name "specimen orientation-histogram KS distance" ;
        schema:unitText "KS" ;
        schema:value "0.1368" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-orientation-histogram-ks-distance-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-orientation-histogram-ks-distance-reference> a schema:PropertyValue ;
        dct:source "a matched-texture null would sit near 0; the skull photo is not the RD patch" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5265 coherency" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor inside the specimen mask" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5265" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "typical isotropic-texture prior used as a baseline, not this fossil" ;
        schema:value "0.32" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-tiktaalik-along-ray-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tiktaalik along-ray stripe wavelength = 100.1115 µm" ;
        dct:description "predecessor pattern is ray-locked, not the isotropic ocellus" ;
        schema:measurementTechnique "same Du, r_eff = 10 * 3.4 along lepidotrichia; analytic k_c" ;
        schema:name "Tiktaalik along-ray stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "100.1115" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-tiktaalik-along-ray-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-tiktaalik-along-ray-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Acanthostega isotropic λ_c at 365 Ma; the 375 Ma along-ray mode is shorter" ;
        schema:value "104.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-tiktaalik-cross-ray-specimen-scale-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tiktaalik cross-ray specimen-scale growth rate = -0.621 1/time" ;
        schema:measurementTechnique "σ(k_c) at r_eff = 10/3.4 (cross-ray inhibitor diffusivity); negative means the mode decays" ;
        schema:name "Tiktaalik cross-ray specimen-scale growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.621" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-tiktaalik-cross-ray-specimen-scale-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-tiktaalik-cross-ray-specimen-scale-growth-rate-reference> a schema:PropertyValue ;
        dct:source "onset. Acanthostega at r = 10 is above onset; Tiktaalik cross-ray is not" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-wavelength-sweep-coefficient-of-variation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep coefficient of variation = 0.0239 CV" ;
        schema:measurementTechnique "std/mean of analytic λ(r) for supercritical ratios at fixed Du" ;
        schema:name "wavelength sweep coefficient of variation" ;
        schema:unitText "CV" ;
        schema:value "0.0239" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-wavelength-sweep-coefficient-of-variation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-measurement-wavelength-sweep-coefficient-of-variation-reference> a schema:PropertyValue ;
        dct:source "a parameter that does not move λ would have CV 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py L195–L216" ;
        dct:description "dominant_wavelength_um" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L195-L216> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py L218–L278" ;
        dct:description "dispersion_fit Pearson and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L218-L278> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor (single agent; no second provider in this loop)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .

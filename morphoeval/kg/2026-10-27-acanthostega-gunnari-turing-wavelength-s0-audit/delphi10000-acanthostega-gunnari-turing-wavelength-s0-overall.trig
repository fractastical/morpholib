sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Acanthostega gunnari Turing wavenumber at 105 µm (Pass 1, r = 16) — MorphoEval overall 77.5/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 integrated Schnakenberg kinetics with the Turing wavenumber on a periodic 1.678 mm patch at Famennian 365 Ma. At r = 16 the analytic wavelength was 104.9 µm but the saturated FFT peak sat at 125.53 µm. Dispersion Pearson r was 0.993. The Brussels skull GIF terminus already matched the specimen (CV 96). The fin-ray neighbour was mis-stated as an expressed longer wavelength. Overall 77.5/100 (faithfulness 74.3, reproducibility 84.9); rubric morphoeval 0.1.0; checkpoint commit dff4f2b508d0d1939f865c2f90f7ffe070e890d6; environment: . Dimension assessments: Model fidelity to source 82, Morphological realism / specimen match 74, Parameter expressivity 72, Morphometric validation 66, Source and data traceability 90, Code-to-model traceability 80, Reproducibility package 84. Output judged: docs/media/acanthostega_gunnari_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py at dff4f2b508d0d1939f865c2f90f7ffe070e890d6, image/png, 557252 B, 1344×1008 px, artifact_sha256 ee8fcd1b8df7a3e38a0636214b811c779e4ffa426f93491dac3345b7dee8c2cc (sha256 ee8fcd1b8df7a3e38a0636214b811c779e4ffa426f93491dac3345b7dee8c2cc), spec_fingerprint c711774b8d595cd5a6f22703fc15b77247416d03dc05678953f2434b64d13ee2. Dual provenance: spec_fingerprint: c711774b8d595cd5a6f22703fc15b77247416d03dc05678953f2434b64d13ee2; artifact_sha256: ee8fcd1b8df7a3e38a0636214b811c779e4ffa426f93491dac3345b7dee8c2cc; input_dataset_sha256: {datasets/acanthostega_gunnari_turing_wavelength_s0/acanthostega_gunnari_brussels_head_specimen.jpg=6eae655c40f0444c..., datasets/acanthostega_gunnari_turing_wavelength_s0/acanthostega_gunnari_turing_wavelength_s0_reference.json=dc929ab5cb065aa6...}. Claim boundary: reported_in_source: Eight digits in Acanthostega (Coates & Clack 1990) and no digits in Tiktaalik (Daeschler, Shubin & Jenkins 2006). | Turing critical wavenumber and Schnakenberg kinetics.; reconstructed_in_script: Du calibrated so analytic lambda_c = 104.9 µm. | Pass-1 ratio r = 16, later retuned.; transfer_boundary: 105 µm is the campaign primordium tier, not a measured melanosome spacing.; does_not_claim: That the fossil preserves a 105 µm pigment wavelength. | That the RD field is a pixel copy of the skull.." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Report the Tiktaalik cross-ray mode as subcritical (sigma < 0), and the along-ray mode as the expressed predecessor wavelength.",
            "remediation needed: Restrict the Pearson sample to probe modes that stay on the analytic eigenvalue.",
            "remediation needed: Retune Dv/Du from the supercritical r=16 probe (FFT 125.53 µm, 19.7% above k_c) to a ratio whose saturated spacing tracks 104.9 µm.",
            "remediation needed: Segment the Brussels skull with the border-median mask and publish foreground, coherency, circularity, KS, RMSE, and sweep CV as non-circular metrics." ;
        pk:hasScore "0.775"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor (single agent; no second provider in this loop)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


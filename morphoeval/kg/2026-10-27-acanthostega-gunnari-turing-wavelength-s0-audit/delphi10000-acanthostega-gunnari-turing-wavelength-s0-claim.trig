        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Acanthostega gunnari Turing wavenumber at 105 µm (Pass 1, r = 16) faithfully reproduces Acanthostega gunnari morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Acanthostega gunnari specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py; output: docs/media/acanthostega_gunnari_turing_wavelength_s0_comparison.png; organism: Acanthostega gunnari; environment: n/a; claim_boundary: [reported_in_source: Eight digits in Acanthostega (Coates & Clack 1990) and no digits in Tiktaalik (Daeschler, Shubin & Jenkins 2006). | Turing critical wavenumber and Schnakenberg kinetics.; reconstructed_in_script: Du calibrated so analytic lambda_c = 104.9 µm. | Pass-1 ratio r = 16, later retuned.; transfer_boundary: 105 µm is the campaign primordium tier, not a measured melanosome spacing.; does_not_claim: That the fossil preserves a 105 µm pigment wavelength. | That the RD field is a pixel copy of the skull.]; phenomenon_size: 78 µm (7.82e-05 m, log10=-4.107 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 78 µm to 17.6 cm): 78 µm:acanthostega-gunnari-bioelectric-polarity, 244 µm:acanthostega-gunnari-vertex-packing, 3.9 mm:acanthostega-gunnari-turing-wavelength, 7.8 mm:acanthostega-gunnari-clock-wavefront, 1.8 cm:acanthostega-gunnari-morphogen-condensation, 2.1 cm:acanthostega-gunnari-elastic-buckling, 2.4 cm:acanthostega-gunnari-flux-canalization, 3.4 cm:acanthostega-gunnari-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/347066a0>,
            <https://doi.org/10.1038/nature04639>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


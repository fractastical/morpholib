sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yan-vibrio-biofilm-nematic-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Beroz et al. (2018) Nature Physics & Hartmann et al. (2019) Nature Physics 3D rod-cell nematic verticalization and fountain flow in growing Vibrio cholerae biofilms — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes parabolic radial stress coefficient kappa = zeta*g/(4*h), inverse cell-length buckling stress sigma_c(L), critical radius R_c(L), and verticalization front r_vert (L34-53), backed by 3 Lean 4 theorems in `Loop_095_vibrio_biofilm_nematic_fountain.lean`. However, `generate_parametric_verticalization_field` (L56-75) uses a hardcoded radial tanh ansatz rather than relaxing a nematic director tilt & fountain-flow energy functional, and lacks Delta rbmA and Delta bap1 Delta rbmC mutant controls." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2019-yan-vibrio-biofilm-nematic-fountain.py L56–L75: Closed-form radial tanh ansatz instead of variational nematic director tilt and fountain-flow relaxation <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L56-L75>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-yan-vibrio-biofilm-nematic-fountain.py L34–L53" ;
        dcterms:description "Exact parabolic radial stress kappa*(R^2 - r^2), critical radius R_c(L), and verticalization front r_vert" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L34-L53> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 095 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


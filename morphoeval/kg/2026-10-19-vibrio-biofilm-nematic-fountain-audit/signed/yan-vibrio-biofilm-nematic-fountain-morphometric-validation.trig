        schema:name "A22 short-rod (L = 1.4 um) critical verticalization radius R_c" ;
        schema:unitText "um" ;
        schema:value "12.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-a22-short-rod-l-1-4-um-critical-verticalization-radius-r-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-a22-short-rod-l-1-4-um-critical-verticalization-radius-r-c-reference> a schema:PropertyValue ;

        schema:value "12.1" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cephalexin-long-rod-l-3-8-um-critical-verticalization-radius-r-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cephalexin long-rod (L = 3.8 um) critical verticalization radius R_c = 7.28 um" ;
        schema:measurementTechnique "Critical colony radius for division-inhibited elongated rods (L = 3.8 um)" ;
        schema:name "Cephalexin long-rod (L = 3.8 um) critical verticalization radius R_c" ;
        schema:unitText "um" ;
        schema:value "7.28" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cephalexin-long-rod-l-3-8-um-critical-verticalization-radius-r-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cephalexin-long-rod-l-3-8-um-critical-verticalization-radius-r-c-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics 14:954-960 Fig. 3" ;
        schema:value "7.3" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-l-2-1-um-critical-verticalization-radius-r-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type (L = 2.1 um) critical verticalization radius R_c = 9.8 um" ;
        schema:measurementTechnique "Analytic critical verticalization radius R_c = sqrt(sigma_c / kappa)" ;
        schema:name "Wild-type (L = 2.1 um) critical verticalization radius R_c" ;
        schema:unitText "um" ;
        schema:value "9.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-l-2-1-um-critical-verticalization-radius-r-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-l-2-1-um-critical-verticalization-radius-r-c-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics 14:954-960 Fig. 2" ;
        schema:value "9.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-l-2-1-um-r-22-um-verticalized-core-radius-r-vert> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type (L = 2.1 um, R = 22 um) verticalized core radius r_vert = 19.7 um" ;
        schema:measurementTechnique "Analytic verticalization front radius sqrt(R^2 - R_c^2) at R = 22.0 um" ;
        schema:name "Wild-type (L = 2.1 um, R = 22 um) verticalized core radius r_vert" ;
        schema:unitText "um" ;
        schema:value "19.7" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-l-2-1-um-r-22-um-verticalized-core-radius-r-vert-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-l-2-1-um-r-22-um-verticalized-core-radius-r-vert-reference> a schema:PropertyValue ;
        dcterms:source "Beroz et al. (2018) Nature Physics 14:954-960 Fig. 4" ;
        schema:value "19.7" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Beroz et al. (2018) Nature Physics & Hartmann et al. (2019) Nature Physics 3D rod-cell nematic verticalization and fountain flow in growing Vibrio cholerae biofilms — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L146-181) reports only 4 analytic numbers (WT R_c, WT r_vert, A22 R_c, cephalexin R_c) without Pearson r, p-value, RMSE, log-log inverse square-root scaling slope, radial expansion front correlation, Delta rbmA negative-control verticalization delta, or specimen rod aspect ratio L/d." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2019-yan-vibrio-biofilm-nematic-fountain.py L146–L181: Only 4 analytic metrics without statistical tests, mutant controls, or specimen segmentation <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L146-L181>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-a22-short-rod-l-1-4-um-critical-verticalization-radius-r-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-cephalexin-long-rod-l-3-8-um-critical-verticalization-radius-r-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-l-2-1-um-critical-verticalization-radius-r-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yan-vibrio-biofilm-nematic-fountain-measurement-wild-type-l-2-1-um-r-22-um-verticalized-core-radius-r-vert> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

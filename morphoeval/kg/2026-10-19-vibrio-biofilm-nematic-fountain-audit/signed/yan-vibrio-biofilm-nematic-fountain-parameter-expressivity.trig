sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yan-vibrio-biofilm-nematic-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-parameter-expressivity> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 095 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yan-vibrio-biofilm-nematic-fountain-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Beroz et al. (2018) Nature Physics & Hartmann et al. (2019) Nature Physics 3D rod-cell nematic verticalization and fountain flow in growing Vibrio cholerae biofilms — Parameter expressivity: 50/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 7 cell lengths L in [1.4, 4.5] um (L78-91), but omits the 8-point radial expansion trajectory R(t) in [6.0, 25.0] um, omits the 5 genetic and pharmacological controls (WT, Delta rbmA, Delta bap1 Delta rbmC, A22 short rods, cephalexin long rods), and exposes no CLI parameter overrides." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2019-yan-vibrio-biofilm-nematic-fountain.py L78–L91: Single 7-point cell-length sweep without radial expansion trajectory, mutant controls, or CLI overrides <https://github.com/fractastical/morpholib/blob/e93f00e/2019-yan-vibrio-biofilm-nematic-fountain.py#L78-L91>" ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


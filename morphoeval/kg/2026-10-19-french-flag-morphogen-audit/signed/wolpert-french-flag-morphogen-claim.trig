sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> a pk:Claim ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication & Ben-Zvi-Barkai (2010) scaling faithfully reproduces Chick embryo (Gallus gallus domesticus) limb bud & embryonic blastoderm morphology" ;
        dcterms:description "The simulation script(s) 1969-wolpert-french-flag-morphogen.py implement the cited source model as published and produce forms that match real Chick embryo (Gallus gallus domesticus) limb bud & embryonic blastoderm specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 38.1/100, audit 2026-10-19-french-flag-morphogen-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py; output: docs/media/french_flag_morphogen_comparison.png; organism: Chick embryo (Gallus gallus domesticus) limb bud & embryonic blastoderm; checkpoint commit: https://github.com/fractastical/morpholib/commit/b9976f8; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 8c772d71b75bec8f158cb37c09ad0b582febd6312d060c187ac44cf5cbb1bf84; artifact_sha256: 9dc970e06e20f6702cbb9e3d329f5bb0a6a323e766f9bba462745dbfc8ed1658; input_dataset_sha256: {datasets/french_flag_morphogen/french_flag_morphogen_reference.json=deae09091fa98a1b..., datasets/french_flag_morphogen/french_flag_specimen.jpg=7163e90c56e1316e..., datasets/french_flag_morphogen/scout_manifest.json=d3bd7cc1c62dd2cb...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0092-8674(93)90626-2>,
            <https://doi.org/10.1016/S0022-5193(69)80016-0>,
            <https://doi.org/10.1038/225420a0>,
            <https://doi.org/10.1038/254199a0>,
            <https://doi.org/10.1073/pnas.0912734107> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-specimen-match> ;
        pk:weightOfEvidence "0.381"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py> a schema:SoftwareSourceCode ;
        rdfs:label "1969-wolpert-french-flag-morphogen.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "b9976f8" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-wolpert-french-flag-morphogen> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-wolpert-french-flag-morphogen-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Wolpert (1969) French Flag positional information, Tickle-Wolpert (1975) chick limb ZPA digit duplication & Ben-Zvi-Barkai (2010) scaling — Morphometric validation: 32/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` reports only a single uncalibrated Blue-zone fraction (`0.0853` vs reference `0.3333`, L79-93) without positional precision error `sigma_x`, scaling invariance CV across HH18-HH28 stages, ZPA digit sequence verification, or specimen radial fit `r` / RMSE." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1969-wolpert-french-flag-morphogen.py L79–L93: Single morphometric metric with large uncalibrated discrepancy (0.0853 vs 0.3333) <https://github.com/fractastical/morpholib/blob/b9976f8/1969-wolpert-french-flag-morphogen.py#L79-L93>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-unscaled-sdd-blue-zone-fraction-at-l-300-um-linear-t1-2-3-threshold> ;
        pk:hasScore "0.32"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-unscaled-sdd-blue-zone-fraction-at-l-300-um-linear-t1-2-3-threshold> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "unscaled SDD blue-zone fraction at L=300 um (linear T1=2/3 threshold) = 0.0856 fraction" ;
        dct:description "Pass 1 uses uncalibrated linear T1=2/3 on exponential SDD without scaling" ;
        schema:measurementTechnique "Fraction of domain x in [0, 300] um where c0*exp(-x/lambda) >= 2/3" ;
        schema:name "unscaled SDD blue-zone fraction at L=300 um (linear T1=2/3 threshold)" ;
        schema:unitText "fraction" ;
        schema:value "0.0856" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-unscaled-sdd-blue-zone-fraction-at-l-300-um-linear-t1-2-3-threshold-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-wolpert-french-flag-morphogen-measurement-unscaled-sdd-blue-zone-fraction-at-l-300-um-linear-t1-2-3-threshold-reference> a schema:PropertyValue ;
        dct:source "Wolpert (1969) J. Theor. Biol. 25:1-47 exact 1/3 French Flag trisection" ;
        schema:value "0.3333" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


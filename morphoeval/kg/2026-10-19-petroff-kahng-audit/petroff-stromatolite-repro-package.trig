sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-petroff-stromatolite-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Reproducibility package: 70/100" ;
        rdfs:comment "The script is purely deterministic (no RNG), runs in < 1 s using only `numpy`, `matplotlib`, and `Pillow` (all pinned in `requirements.txt` and `requirements.lock.txt`), and supports `-o/--output`, `--gif`, and `--no-show`. Deduct 12 points because there is no `--self-test` mode or CSV metrics export; deduct 10 points because the docstring usage block (L45-48) omits `--gif` and the default output path is the repo root rather than `docs/media/petroff_stromatolite_dome_to_cone.gif`; and deduct 8 points because `show=True` is the default when no `--no-show` flag is passed. Evidence: 2010-petroff-stromatolite.py L45–L48: docstring CLI examples omit --gif <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L45-L48>; 2010-petroff-stromatolite.py L336–L348: argparse entrypoint with -o/--output, --gif, --no-show <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L336-L348>; requirements.lock.txt L1–L51: pinned Python 3.14.7, numpy 2.5.4, matplotlib 3.10.7, pillow 12.0.0 <https://github.com/fractastical/morpholib/blob/5564750/requirements.lock.txt#L1-L51>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-repro-package> ;
        pk:hasProbability "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-repro-package> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolitelamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


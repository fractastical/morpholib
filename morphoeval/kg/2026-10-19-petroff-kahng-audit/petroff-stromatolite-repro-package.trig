sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Reproducibility package: 70/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The script is purely deterministic (no RNG), runs in < 1 s using only `numpy`, `matplotlib`, and `Pillow` (all pinned in `requirements.txt` and `requirements.lock.txt`), and supports `-o/--output`, `--gif`, and `--no-show`. Deduct 12 points because there is no `--self-test` mode or CSV metrics export; deduct 10 points because the docstring usage block (L45-48) omits `--gif` and the default output path is the repo root rather than `docs/media/petroff_stromatolite_dome_to_cone.gif`; and deduct 8 points because `show=True` is the default when no `--no-show` flag is passed." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-3> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L45–L48" ;
        dct:description "docstring CLI examples omit --gif" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L45-L48> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L336–L348" ;
        dct:description "argparse entrypoint with -o/--output, --gif, --no-show" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L336-L348> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L51" ;
        dct:description "pinned Python 3.14.7, numpy 2.5.4, matplotlib 3.10.7, pillow 12.0.0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/requirements.lock.txt#L1-L51> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolitelamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


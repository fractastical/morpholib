sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-kahng-coral-geometry-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Source and data traceability: 74/100" ;
        rdfs:comment "Module docstring records full authors, title, journal (`PeerJ 12:e17037`), year, PMCID (`PMC10909345`), resolving DOI (`10.7717/peerj.17037`), and upstream GitHub repository (`github.com/ericodle/coral_geometry_modeling`), plus inline attribution to Raup & Graus (1972), Lough (2008), Hughes (1987), and Kahng (2023). Deduct 16 points because no `datasets/kahng/` directory, `README.md`, or `paper_citations.bib` with full DOIs for the empirical parameter sources (Lough 2008, Hughes 1987, Kahng 2023) is vendored; and deduct 10 points because the upstream `ericodle/coral_geometry_modeling` commit hash is not pinned. Evidence: 2024-kahng-coral-geometry.py L5–L10: complete citation, PMCID, DOI 10.7717/peerj.17037, and upstream GitHub repo URL <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L5-L10>; 2024-kahng-coral-geometry.py L57–L60: parameter attributions to Lough 2008, Hughes 1987, Kahng 2023, and paper Fig. 6 <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L57-L60>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-source-traceability> ;
        pk:hasProbability "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-source-traceability> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

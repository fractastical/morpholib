            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.7717/peerj.17037> .

    <https://doi.org/10.7717/peerj.17037> dcterms:date "2024"^^xsd:gYear ;
        dcterms:title "Coral geometry and why it matters" .
}


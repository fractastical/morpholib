    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .

    <https://doi.org/10.1016/j.physa.2004.01.065> dcterms:date "2004"^^xsd:gYear ;
        dcterms:title "A mathematical model of stromatolitelamina accretion" .

    <https://doi.org/10.1073/pnas.1001978107> dcterms:date "2010"^^xsd:gYear ;
        dcterms:title "Biophysical basis for the geometry of conical stromatolites" .
}


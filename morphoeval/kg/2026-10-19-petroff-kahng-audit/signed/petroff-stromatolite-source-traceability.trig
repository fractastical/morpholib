sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-petroff-stromatolite-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Source and data traceability: 52/100" ;
        rdfs:comment "Module docstring cites Petroff et al. (2010) with full author list, title, journal, volume, pages, and PMCID (`PMC2890478`, L5-8), and names Batchelor, Burne, Henry & Jackson (2004) and Fejes Tóth (1948). Deduct 20 points because neither the primary paper's DOI (`10.1073/pnas.1001978107`) nor full bibliographic details/DOIs for Batchelor et al. (2004) and Fejes Tóth (1948) are recorded in the script; deduct 18 points because no `datasets/petroff/` directory, `README.md`, or `paper_citations.bib` exists; and deduct 10 points because `alpha_lab = 0.30` (L180) and the Bakal Formation `10-20 cm` spacing note (L241-243) lack specific table/figure pointers. Evidence: 2010-petroff-stromatolite.py L5–L8: Petroff et al. 2010 citation with PMC2890478 but no DOI string <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L5-L8>; 2010-petroff-stromatolite.py L27–L35: short inline mentions of Fejes Toth 1948 and Batchelor et al. 2004 without venue or DOI <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L27-L35>; 2010-petroff-stromatolite.py L179–L180: alpha_field = 1.0 and alpha_lab = 0.30 without table/figure citation <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L179-L180>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-source-traceability> ;
        pk:hasProbability "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-source-traceability> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}


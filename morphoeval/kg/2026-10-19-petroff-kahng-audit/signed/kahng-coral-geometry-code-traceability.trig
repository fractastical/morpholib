sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-kahng-coral-geometry-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Code-to-model traceability: 75/100" ;
        rdfs:comment "Every geometric function states its exact volume $V$, active calcifying surface area $S$, and resulting one-step algebraic relation in its docstring, and the module docstring summarizes the four geometries' $(S:V, C, \\text{SAP})$ scaling regimes in a table mapped to Appendix A / Results and Figs. 3 & 6 of Kahng et al. (2024). Deduct 15 points because exact equation numbers from Kahng et al. (2024) Appendix A are not cited per function, and deduct 10 points because the distinction between discrete 1-yr difference equations and continuous ODE rates is not noted in `hemisphere_extension`. Evidence: 2024-kahng-coral-geometry.py L25–L31: summary table mapping 4 coral geometries to S:V, C, and SAP trends <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L25-L31>; 2024-kahng-coral-geometry.py L68–L110: per-function V and S formulas referencing Appendix A / Results <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L68-L110>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-code-traceability> ;
        pk:hasProbability "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-code-traceability> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Morphological realism / specimen match: 30/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "The three bottom panels (`beta = 0.3, 1.5, 5.0`) and 70-frame animation clearly show internal lamina stacking and axial-zone crest thickening as `beta` increases. However, (-30) no fossil *Conophyton* thin-section, modern Yellowstone microbial mat photograph, or digitized figure from Petroff et al. (2010) is shown or overlaid; (-15) pinning the basal feet at `x = +-1` (L136-137) while starting from a triangular seed (L153) causes the `beta = 0.3` dome (Panel d) to form a steep-walled flat-topped trapezoid with a central crease rather than a hemispheroidal domal stromatolite; and (-15) the `beta = 5.0` sharp cone sits atop a vertical cylinder base with a rounded tip rather than exhibiting straight conical flanks." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-3> ;
        pk:hasScore "0.3"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "petroff_stromatolite_morphospace.png (generated output)" ;
        dct:description "6-panel summary figure; no specimen thin-section or field photo; panel (d) dome has vertical side walls and central seed kink — petroff_stromatolite_morphospace.png: rendered output of 2010-petroff-stromatolite.py at 5564750, image/png, 328721 B, 1736×1244 px, artifact_sha256 8e00cc6fabe5cf24f1544cbc867b0f6e9501cf7099a7b3da7166a2bf8fd1be01 (sha256 8e00cc6fabe5cf24f1544cbc867b0f6e9501cf7099a7b3da7166a2bf8fd1be01), spec_fingerprint 2b3289aae8f3466486ffbc5f503dd7585e6e1c2863ac78c108d1488932cf713f" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/petroff_stromatolite_dome_to_cone.gif (generated output)" ;
        dct:description "70-frame ping-pong animation sweeping beta = 0.2 -> 6.0 — docs/media/petroff_stromatolite_dome_to_cone.gif: rendered output of 2010-petroff-stromatolite.py at 5564750, image/gif, 920055 B, 560×416 px, 70 frames, artifact_sha256 b7f825720b31f42faa4f7424f916639a76f36dfd50a2025cb0706b4d9ea55514 (sha256 b7f825720b31f42faa4f7424f916639a76f36dfd50a2025cb0706b4d9ea55514), spec_fingerprint 2b3289aae8f3466486ffbc5f503dd7585e6e1c2863ac78c108d1488932cf713f" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L136–L155" ;
        dct:description "triangular seed z0 and pinned endpoints x[0]=-base_half, x[-1]=base_half" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L136-L155> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


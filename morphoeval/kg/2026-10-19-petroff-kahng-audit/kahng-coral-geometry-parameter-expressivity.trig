sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-kahng-coral-geometry-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Parameter expressivity: 72/100" ;
        rdfs:comment "Sweeps colony size `0.5..30 cm` across all four geometries (Panels b, c), sweeps cone aspect ratio `alpha in {0.5, 1.0, 2.0, 4.0}` (Panel d), sweeps cylinder branch diameter `0.3..4.0 cm` and disc plate thickness `0.05..1.5 cm` (Panel e), and contrasts species-specific calcification regimes (`MASSIVE`, `BRANCH`, `DISC`) with the shape-isolating `COMMON` regime. Deduct 18 points because no model parameters (`G`, `rho`, `alpha`, `h`, `r`, `years`) are configurable via CLI flags (L320-331), and deduct 10 points because step size `dt` is fixed to `1 yr`. Evidence: 2024-kahng-coral-geometry.py L158–L211: sweeps over colony size, cone aspect ratio alpha, branch diameter 2r, and plate thickness h <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L158-L211>; 2024-kahng-coral-geometry.py L320–L331: CLI exposes only -o/--output, --no-show, and --gif <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L320-L331>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-parameter-expressivity> ;
        pk:hasProbability "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-parameter-expressivity> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dct:identifier "morphoeval/0.1.0/parameter-expressivity" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.7717/peerj.17037> .
    <https://doi.org/10.7717/peerj.17037> dct:date "2024"^^xsd:gYear ;
        dct:title "Coral geometry and why it matters" .
}


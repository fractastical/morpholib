sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Source and data traceability: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module docstring cites Petroff et al. (2010) with full author list, title, journal, volume, pages, and PMCID (`PMC2890478`, L5-8), and names Batchelor, Burne, Henry & Jackson (2004) and Fejes Tóth (1948). Deduct 20 points because neither the primary paper's DOI (`10.1073/pnas.1001978107`) nor full bibliographic details/DOIs for Batchelor et al. (2004) and Fejes Tóth (1948) are recorded in the script; deduct 18 points because no `datasets/petroff/` directory, `README.md`, or `paper_citations.bib` exists; and deduct 10 points because `alpha_lab = 0.30` (L180) and the Bakal Formation `10-20 cm` spacing note (L241-243) lack specific table/figure pointers." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-3> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L5–L8" ;
        dct:description "Petroff et al. 2010 citation with PMC2890478 but no DOI string" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L5-L8> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L27–L35" ;
        dct:description "short inline mentions of Fejes Toth 1948 and Batchelor et al. 2004 without venue or DOI" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L27-L35> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L179–L180" ;
        dct:description "alpha_field = 1.0 and alpha_lab = 0.30 without table/figure citation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L179-L180> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolitelamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


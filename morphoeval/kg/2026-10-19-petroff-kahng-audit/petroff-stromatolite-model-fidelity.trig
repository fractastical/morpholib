sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Model fidelity to source: 44/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Correctly evaluates the diffusive spacing relation `ell = alpha * sqrt(D * tau)` (L64-67) and hexagonal lattice geometry (L70-81). However, (-22) the lamina cross-section model (L113-163) does not solve Petroff et al.'s (2010) diffusive nutrient field (`nabla^2 c = 0`) or flux-driven lamina growth (`v_n prop dc/dn`), so the top row (diffusion spacing) and bottom row (lamina shapes) are mathematically uncoupled; (-14) relative to the Batchelor et al. (2004) equation cited in the docstring (`dh/dt = v + lambda*(1 + 1/2 (dh/dr)^2)`, L34, L296), `_advance_front` introduces an uncited quadratic photic crest weight `w_photic = 0.12 + 0.88 * (z / z.max())**2` (L130), pins the basal endpoints at `+-base_half` (L136-137), and applies a 3-point Laplacian smoothing filter (L141-142); and (-8) the text panel states that `ell ~ 0.66 cm` records a `~20 h` rhythmic metabolism (L238-239) whereas `0.66 cm` was computed from `tau = 12 h` (L193, L235)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-3> ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L64–L81" ;
        dct:description "diffusion_length ell = alpha*sqrt(D*tau) and hex_lattice" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L64-L81> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L113–L143" ;
        dct:description "_advance_front uses ad-hoc w_photic = 0.12 + 0.88*(z/z_max)^2, pinned base, and 3-point smoothing instead of Petroff diffusive flux or pure Batchelor KPZ" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L113-L143> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L233–L240" ;
        dct:description "text panel computes ell = 0.66 cm from tau = 12 h but prose says '~20 h rhythmic metabolism'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L233-L240> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolitelamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-petroff-stromatolite-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Model fidelity to source: 44/100" ;
        rdfs:comment "Correctly evaluates the diffusive spacing relation `ell = alpha * sqrt(D * tau)` (L64-67) and hexagonal lattice geometry (L70-81). However, (-22) the lamina cross-section model (L113-163) does not solve Petroff et al.'s (2010) diffusive nutrient field (`nabla^2 c = 0`) or flux-driven lamina growth (`v_n prop dc/dn`), so the top row (diffusion spacing) and bottom row (lamina shapes) are mathematically uncoupled; (-14) relative to the Batchelor et al. (2004) equation cited in the docstring (`dh/dt = v + lambda*(1 + 1/2 (dh/dr)^2)`, L34, L296), `_advance_front` introduces an uncited quadratic photic crest weight `w_photic = 0.12 + 0.88 * (z / z.max())**2` (L130), pins the basal endpoints at `+-base_half` (L136-137), and applies a 3-point Laplacian smoothing filter (L141-142); and (-8) the text panel states that `ell ~ 0.66 cm` records a `~20 h` rhythmic metabolism (L238-239) whereas `0.66 cm` was computed from `tau = 12 h` (L193, L235). Evidence: 2010-petroff-stromatolite.py L64–L81: diffusion_length ell = alpha*sqrt(D*tau) and hex_lattice <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L64-L81>; 2010-petroff-stromatolite.py L113–L143: _advance_front uses ad-hoc w_photic = 0.12 + 0.88*(z/z_max)^2, pinned base, and 3-point smoothing instead of Petroff diffusive flux or pure Batchelor KPZ <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L113-L143>; 2010-petroff-stromatolite.py L233–L240: text panel computes ell = 0.66 cm from tau = 12 h but prose says '~20 h rhythmic metabolism' <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L233-L240>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-model-fidelity> ;
        pk:hasProbability "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-model-fidelity> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dct:identifier "morphoeval/0.1.0/model-fidelity" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}


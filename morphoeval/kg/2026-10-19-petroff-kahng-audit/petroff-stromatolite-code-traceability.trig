sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-petroff-stromatolite-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Code-to-model traceability: 50/100" ;
        rdfs:comment "Functions are compact and clearly structured into Section (1) (`diffusion_length`, `hex_lattice`, citing Petroff Eq. 2 and Fig. 4) and Section (2) (`_resample`, `_advance_front`, `grow_stromatolite`, `aspect_ratio`). Deduct 25 points because the docstring and console printout display the small-slope KPZ PDE `dh/dt = v + lambda * (1 + 1/2 (dh/dr)^2)` (L34, L85, L296) while `_advance_front` actually integrates a Lagrangian normal+vertical velocity modulated by `w_photic` and Laplacian smoothing; and deduct 25 points because the constants `0.12` and `0.88` in `w_photic` (L130) and `smooth = 0.03` (L147) have no source equation provenance. Evidence: 2010-petroff-stromatolite.py L64–L74: docstrings cite Petroff Eq. 2 and Fig. 4 <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L64-L74>; 2010-petroff-stromatolite.py L85–L98: header explains transition from graph KPZ equation to Lagrangian front v*z_hat + lambda*n_hat <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L85-L98>; 2010-petroff-stromatolite.py L126–L143: untraced w_photic = 0.12 + 0.88*(z/z_max)^2 and 3-point smoothing <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L126-L143>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-code-traceability> ;
        pk:hasProbability "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-code-traceability> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dct:identifier "morphoeval/0.1.0/code-traceability" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolitelamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


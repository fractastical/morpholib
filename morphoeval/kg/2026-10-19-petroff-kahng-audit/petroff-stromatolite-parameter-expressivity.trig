sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-petroff-stromatolite-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Parameter expressivity: 60/100" ;
        rdfs:comment "Sweeps daylight span `tau` continuously across `1..48 h` for two `alpha` regimes (`1.0` and `0.30`, L187-192), compares three `beta = v/lambda` regimes (`0.3, 1.5, 5.0`, L249-253) in the static figure, and sweeps `beta` logarithmically across 36 values (`0.2 -> 6.0`, L306) in `make_gif`, producing a strictly monotonic increase in height/width aspect ratio (`0.631 -> 3.030`). Deduct 25 points because no model parameters (`beta`, `D`, `alpha`, `smooth`, `seed_height`) are exposed on the CLI (L336-348), and 15 points because `lambda = 1.0`, `base_half = 1.0`, and `smooth = 0.03` are held fixed. Evidence: 2010-petroff-stromatolite.py L249–L273: 3 beta regimes (0.3, 1.5, 5.0) plotted on shared vertical scale <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L249-L273>; 2010-petroff-stromatolite.py L300–L334: make_gif sweeps 36 log-spaced beta values from 0.2 to 6.0 <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L300-L334>; 2010-petroff-stromatolite.py L336–L348: CLI exposes only -o/--output, --gif, and --no-show <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L336-L348>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-parameter-expressivity> ;
        pk:hasProbability "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-petroff-stromatolite-parameter-expressivity> rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace (2010-petroff-stromatolite.py, docs/media/petroff_stromatolite_dome_to_cone.gif) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Photosynthetic microbial mats and conical stromatolites (Conophyton / Yellowstone modern mats)" ;
        dct:identifier "morphoeval/0.1.0/parameter-expressivity" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.physa.2004.01.065>,
            <https://doi.org/10.1073/pnas.1001978107> .
    <https://doi.org/10.1016/j.physa.2004.01.065> dct:date "2004"^^xsd:gYear ;
        dct:title "A mathematical model of stromatolitelamina accretion" .
    <https://doi.org/10.1073/pnas.1001978107> dct:date "2010"^^xsd:gYear ;
        dct:title "Biophysical basis for the geometry of conical stromatolites" .
}


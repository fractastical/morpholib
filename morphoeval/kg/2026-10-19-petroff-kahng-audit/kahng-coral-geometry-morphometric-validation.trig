sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kahng-coral-geometry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Morphometric validation: 38/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes and reports asymptotic linear extensions (`1.28 cm/yr` for massive *Porites*; `2.00, 2.53, 3.99, 7.36 cm/yr` for *Acropora* cones with `alpha = 0.5..4`), size-independent SAP (`0.114 /yr` for *Leptoseris* disc; `7.143 /yr` for *Acropora* cylinder), and the `18.9x` (`~19x`) microfragmentation SAP ratio between `r = 1 cm` (`1.86 /yr`) and `r = 25 cm` (`0.10 /yr`). Deduct 42 points because no empirical colony growth dataset (e.g., Lough 2008 *Porites* cores, Hughes 1987 *Acropora*, or Kahng 2023 *Leptoseris* measurements) is loaded to compute residuals or $R^2$; and deduct 20 points because no CSV table or automated `--self-test` verification is emitted." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-branching-acropora-cylinder-size-independent-sap-r-0-50-cm>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-deep-water-leptoseris-flat-disc-size-independent-sap-h-0-20-cm>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-massive-porites-hemisphere-linear-extension-c-at-r-30-cm-discrete-1-yr-step>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-massive-porites-microfragmentation-sap-speedup-ratio-r-1-cm-vs-r-25-cm>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-morphometric-validation-2> ;
        pk:hasScore "0.38"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-branching-acropora-cylinder-size-independent-sap-r-0-50-cm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "branching Acropora cylinder size-independent SAP (r = 0.50 cm) = 7.1429 yr^-1" ;
        schema:measurementTechnique "cylinder_sap(G=2.50, rho=1.40, r=0.50) = 2 * G / (rho * r)" ;
        schema:name "branching Acropora cylinder size-independent SAP (r = 0.50 cm)" ;
        schema:unitText "yr^-1" ;
        schema:value "7.1429" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-branching-acropora-cylinder-size-independent-sap-r-0-50-cm-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-branching-acropora-cylinder-size-independent-sap-r-0-50-cm-reference> a schema:PropertyValue ;
        dct:source "Kahng, Odle & Wakeman 2024 PeerJ 12:e17037 / Hughes 1987" ;
        schema:value "7.1429" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-deep-water-leptoseris-flat-disc-size-independent-sap-h-0-20-cm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "deep-water Leptoseris flat-disc size-independent SAP (h = 0.20 cm) = 0.1142 yr^-1" ;
        schema:measurementTechnique "disc_sap(G=0.061, rho=2.67, h=0.20) = G / (rho * h)" ;
        schema:name "deep-water Leptoseris flat-disc size-independent SAP (h = 0.20 cm)" ;
        schema:unitText "yr^-1" ;
        schema:value "0.1142" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-deep-water-leptoseris-flat-disc-size-independent-sap-h-0-20-cm-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-deep-water-leptoseris-flat-disc-size-independent-sap-h-0-20-cm-reference> a schema:PropertyValue ;
        dct:source "Kahng, Odle & Wakeman 2024 PeerJ 12:e17037 / Kahng 2023" ;
        schema:value "0.1142" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-massive-porites-hemisphere-linear-extension-c-at-r-30-cm-discrete-1-yr-step> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "massive Porites hemisphere linear extension C at r = 30 cm (discrete 1-yr step) = 1.2301 cm/yr" ;
        dct:description "at r = 1 cm discrete step gives C = 0.6920 cm/yr due to 1-yr forward-Euler discretization" ;
        schema:measurementTechnique "hemisphere_extension(r=30 cm, G=1.64, rho=1.28) = (r^3 + 3*G*r^2/rho)^(1/3) - r" ;
        schema:name "massive Porites hemisphere linear extension C at r = 30 cm (discrete 1-yr step)" ;
        schema:unitText "cm/yr" ;
        schema:value "1.2301" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-massive-porites-hemisphere-linear-extension-c-at-r-30-cm-discrete-1-yr-step-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-massive-porites-hemisphere-linear-extension-c-at-r-30-cm-discrete-1-yr-step-reference> a schema:PropertyValue ;
        dct:source "Kahng, Odle & Wakeman 2024 PeerJ 12:e17037 Appendix A (continuum C = G/rho = 1.2812 cm/yr)" ;
        schema:value "1.2812" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-massive-porites-microfragmentation-sap-speedup-ratio-r-1-cm-vs-r-25-cm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "massive Porites microfragmentation SAP speedup ratio (r = 1 cm vs r = 25 cm) = 18.6207 SAP(1 cm) / SAP(25 cm)" ;
        schema:measurementTechnique "hemisphere_sap(r=1 cm) / hemisphere_sap(r=25 cm) for G=1.64, rho=1.28" ;
        schema:name "massive Porites microfragmentation SAP speedup ratio (r = 1 cm vs r = 25 cm)" ;
        schema:unitText "SAP(1 cm) / SAP(25 cm)" ;
        schema:value "18.6207" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-massive-porites-microfragmentation-sap-speedup-ratio-r-1-cm-vs-r-25-cm-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-measurement-massive-porites-microfragmentation-sap-speedup-ratio-r-1-cm-vs-r-25-cm-reference> a schema:PropertyValue ;
        dct:source "Kahng, Odle & Wakeman 2024 PeerJ 12:e17037 (SAP(1 cm)=1.8558/yr vs SAP(25 cm)=0.0981/yr)" ;
        schema:value "18.92" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L215–L236" ;
        dct:description "computes sap_small (r=1 cm), sap_large (r=25 cm), and ~19x microfragmentation ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L215-L236> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L250–L264" ;
        dct:description "console verification printout of asymptotic C and size-independent SAP" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L250-L264> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


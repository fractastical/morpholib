    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.7717/peerj.17037>,
            <https://github.com/ericodle/coral_geometry_modeling> .
    <https://doi.org/10.7717/peerj.17037> dct:date "2024"^^xsd:gYear ;
        dct:title "Coral geometry and why it matters" .
    <https://github.com/ericodle/coral_geometry_modeling> dct:date "2024"^^xsd:gYear ;
        dct:title "coral_geometry_modeling — reference code and analysis" .
}


    <https://doi.org/10.7717/peerj.17037> dct:date "2024"^^xsd:gYear ;
        dct:title "Coral geometry and why it matters" .
    <https://github.com/ericodle/coral_geometry_modeling> dct:date "2024"^^xsd:gYear ;
        dct:title "coral_geometry_modeling — reference code and analysis" .
}


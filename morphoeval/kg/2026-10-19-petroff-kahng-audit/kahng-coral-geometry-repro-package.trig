sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kahng-coral-geometry> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kahng-coral-geometry-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Reproducibility package: 72/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Completely deterministic (no RNG), runs in < 1 s under the locked environment (`requirements.lock.txt`), and provides `-o/--output`, `--no-show`, and `--gif` CLI flags. Deduct 12 points for lacking a `--self-test` flag and CSV metrics output; deduct 8 points because `--gif` is omitted from the docstring usage examples (L38-41) and `show=True` is the default; and deduct 8 points because Pillow deduplicates the trailing hold frames (`frames += [frames[-1]] * (fps * 2)` at L314) from 24 to 16 frames on disk." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-3> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L38–L41" ;
        dct:description "docstring CLI usage block" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L38-L41> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2024-kahng-coral-geometry.py L314–L331" ;
        dct:description "GIF save and argparse CLI entrypoint" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L314-L331> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kahng-coral-geometry-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "requirements.lock.txt L1–L51" ;
        dct:description "locked dependencies in requirements.lock.txt" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/requirements.lock.txt#L1-L51> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


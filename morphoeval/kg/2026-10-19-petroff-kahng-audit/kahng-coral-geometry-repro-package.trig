@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-kahng-coral-geometry-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Reproducibility package: 72/100" ;
        rdfs:comment "Completely deterministic (no RNG), runs in < 1 s under the locked environment (`requirements.lock.txt`), and provides `-o/--output`, `--no-show`, and `--gif` CLI flags. Deduct 12 points for lacking a `--self-test` flag and CSV metrics output; deduct 8 points because `--gif` is omitted from the docstring usage examples (L38-41) and `show=True` is the default; and deduct 8 points because Pillow deduplicates the trailing hold frames (`frames += [frames[-1]] * (fps * 2)` at L314) from 24 to 16 frames on disk. Evidence: 2024-kahng-coral-geometry.py L38–L41: docstring CLI usage block <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L38-L41>; 2024-kahng-coral-geometry.py L314–L331: GIF save and argparse CLI entrypoint <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L314-L331>; requirements.lock.txt L1–L51: locked dependencies in requirements.lock.txt <https://github.com/fractastical/morpholib/blob/5564750/requirements.lock.txt#L1-L51>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-repro-package> ;
        pk:hasProbability "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-repro-package> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.7717/peerj.17037> .
    <https://doi.org/10.7717/peerj.17037> dct:date "2024"^^xsd:gYear ;
        dct:title "Coral geometry and why it matters" .
}


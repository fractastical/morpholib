sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-petroff-stromatolite> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-petroff-stromatolite-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Petroff et al. (2010) Conical Stromatolite Spacing Law & Dome-to-Cone Morphospace — Morphometric validation: 25/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes `diffusion_length` at `tau in {3, 6, 12, 24} h` and `aspect_ratio` (`height / width`) on the top lamina of each grown profile (`0.6716`, `1.1674`, `2.6177` for `beta = 0.3, 1.5, 5.0`). Deduct 40 points because no empirical cone-spacing measurements (Yellowstone modern mats, lab cultures, or Archean/Proterozoic fossils from Petroff et al. Table 1 / Fig. 2-3) are loaded or compared statistically; deduct 20 points because flank angle, apex curvature radius, and axial lamina thickening ratio are not measured; and deduct 15 points because the `0.5-1.5 cm` shaded band in Panel (a) (L198) is hardcoded rather than derived from a dataset." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-cone-regime-beta-1-5-final-lamina-height-width-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-dome-regime-beta-0-3-final-lamina-height-width-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-field-cone-spacing-ell-at-tau-12-h-d-1e-5-cm-2-s-alpha-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-sharp-cone-regime-beta-5-0-final-lamina-height-width-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-morphometric-validation-3> ;
        pk:hasScore "0.25"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-cone-regime-beta-1-5-final-lamina-height-width-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cone regime (beta = 1.5) final lamina height/width aspect ratio = 1.1696 height/width" ;
        schema:measurementTechnique "aspect_ratio(grow_stromatolite(v=1.5, lam=1.0)[-1])" ;
        schema:name "cone regime (beta = 1.5) final lamina height/width aspect ratio" ;
        schema:unitText "height/width" ;
        schema:value "1.1696" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-dome-regime-beta-0-3-final-lamina-height-width-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dome regime (beta = 0.3) final lamina height/width aspect ratio = 0.6692 height/width" ;
        schema:measurementTechnique "aspect_ratio(grow_stromatolite(v=0.3, lam=1.0)[-1])" ;
        schema:name "dome regime (beta = 0.3) final lamina height/width aspect ratio" ;
        schema:unitText "height/width" ;
        schema:value "0.6692" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-field-cone-spacing-ell-at-tau-12-h-d-1e-5-cm-2-s-alpha-1-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "field cone spacing ell at tau = 12 h (D = 1e-5 cm^2/s, alpha = 1.0) = 0.6573 cm" ;
        dct:description "lab clumps (alpha=0.30) ell(12 h) = 0.1972 cm; hex_lattice min NN distance = 0.6573 cm" ;
        schema:measurementTechnique "diffusion_length(12 * 3600, D=1e-5, alpha=1.0) = alpha * sqrt(D * tau)" ;
        schema:name "field cone spacing ell at tau = 12 h (D = 1e-5 cm^2/s, alpha = 1.0)" ;
        schema:unitText "cm" ;
        schema:value "0.6573" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-field-cone-spacing-ell-at-tau-12-h-d-1e-5-cm-2-s-alpha-1-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-field-cone-spacing-ell-at-tau-12-h-d-1e-5-cm-2-s-alpha-1-0-reference> a schema:PropertyValue ;
        dct:source "Petroff et al. 2010 PNAS 107(22):9956-9961 Eq. 2 (~1 cm Yellowstone field spacing)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-measurement-sharp-cone-regime-beta-5-0-final-lamina-height-width-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sharp cone regime (beta = 5.0) final lamina height/width aspect ratio = 2.6191 height/width" ;
        dct:description "monotonic aspect-ratio progression across beta=(0.3, 1.5, 5.0): 0.669 < 1.170 < 2.619" ;
        schema:measurementTechnique "aspect_ratio(grow_stromatolite(v=5.0, lam=1.0)[-1])" ;
        schema:name "sharp cone regime (beta = 5.0) final lamina height/width aspect ratio" ;
        schema:unitText "height/width" ;
        schema:value "2.6191" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L165–L171" ;
        dct:description "aspect_ratio computes height/width for figure annotation only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L165-L171> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L198–L198" ;
        dct:description "hardcoded axhspan(0.5, 1.5) in panel (a)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L198-L198> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-petroff-stromatolite-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "2010-petroff-stromatolite.py L290–L298" ;
        dct:description "console printout of diffusion_length for tau = 3, 6, 12, 24 h" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5564750/2010-petroff-stromatolite.py#L290-L298> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


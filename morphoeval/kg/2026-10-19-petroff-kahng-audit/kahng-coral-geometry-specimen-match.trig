sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-petroff-kahng-audit-kahng-coral-geometry-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity — Morphological realism / specimen match: 42/100" ;
        rdfs:comment "Panel (a) draws clear 2D geometric glyphs annotated with `(V, S, S:V trend)` for the four coral growth forms, Panels (b-e) reproduce the analytical curves of Kahng et al. (2024) (including Fig. 3 cone aspect ratios and Fig. 6 shape comparisons), and the GIF animates 15 years of hemisphere and cone cross-sectional growth alongside log surface-area trajectories. Deduct 35 points because no real coral colony photographs, CT-scanned 3D colony meshes, or digitized empirical data points from *Porites*, *Acropora*, or *Leptoseris* are overlaid; and deduct 23 points because in Panel (c) and the GIF, applying `COMMON` (`G=1.50, rho=1.20`) to a `0.5 cm` flat disc drives disc extension to `26.1 cm/yr` at `r = 30 cm` and area to `~10^9 cm^2` at year 15, visually dwarfing the realistic hemisphere and cone curves. Evidence: kahng_coral_geometry_morphospace.png (generated output, not in repo): 6-panel analytical figure with 2D shape glyphs and SAP/extension curves — kahng_coral_geometry_morphospace.png: rendered output of 2024-kahng-coral-geometry.py at 5564750, image/png, 282553 B, 1774×1267 px, artifact_sha256 fa8ce6cd95b493eee42054724462d8d7e6380dd161cc7899a464457cd765f812 (sha256 fa8ce6cd95b493eee42054724462d8d7e6380dd161cc7899a464457cd765f812), spec_fingerprint 833cc6f3d6f3988fa15a852dd8366b15c68ef56d6fd98635b3250ff241f4746a; docs/media/kahng_coral_geometry_growth.gif (generated output, not in repo): 16-unique-frame animation of 15-year colony growth and log-area trajectories — docs/media/kahng_coral_geometry_growth.gif: rendered output of 2024-kahng-coral-geometry.py at 5564750, image/gif, 248080 B, 720×300 px, 16 frames, artifact_sha256 6d2629a5bb1c8f33c60c72f9efa435dd70cdefc0e7c5cbb050c7a50bb1ac50d0 (sha256 6d2629a5bb1c8f33c60c72f9efa435dd70cdefc0e7c5cbb050c7a50bb1ac50d0), spec_fingerprint 833cc6f3d6f3988fa15a852dd8366b15c68ef56d6fd98635b3250ff241f4746a; 2024-kahng-coral-geometry.py L116–L147: _draw_glyphs schematic 2D patches <https://github.com/fractastical/morpholib/blob/5564750/2024-kahng-coral-geometry.py#L116-L147>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-specimen-match> ;
        pk:hasProbability "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-kahng-coral-geometry-specimen-match> rdfs:label "Kahng, Odle & Wakeman (2024) Reef-Coral Colony Geometry & Surface-Area Productivity (2024-kahng-coral-geometry.py, docs/media/kahng_coral_geometry_growth.gif) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Scleractinian reef corals (massive Porites, branching Acropora, plating Leptoseris)" ;
        dct:identifier "morphoeval/0.1.0/specimen-match" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Fable 5.1 (independent blinded second assessor)" .
}


<https://w3id.org/delphi/resource/math-law/delphi10000-acanthostega-gunnari-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor-activator diffusivity ratio" ;
    dct:description "Necessary condition Dv > Du for diffusion-driven ocelli on Acanthostega dermis at 365 Ma | Variables: dv, du: diffusivities at λ = 105 µm. This slot fixes r = 10." ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L98-L140>,
        <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3102_acanthostega_gunnari_turing_wavelength_s0.lean#L11-L15> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law1_diffusion_ratio (dv du : Int) : Int := dv / du
theorem law1_inhibitor_faster : law1_diffusion_ratio 10 1 = 10 := by decide"""^^pk:lean4 ;
    skos:notation "r = Dv / Du = 10" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/S0263593300006787>,
        <https://doi.org/10.1038/347066a0>,
        <https://doi.org/10.1038/nature03893>,
        <https://doi.org/10.1038/nature04639>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0118882> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3102.law1_diffusion_ratio" ;
    pk:leanTheorem "MathOfBiology.Loop_3102.law1_inhibitor_faster" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acanthostega-gunnari-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber numerator" ;
    dct:description "Critical-wavenumber numerator for k_c^2 = (Dv fu + Du gv) / (2 Du Dv) at 104.9 µm | Variables: fu, gv in thousandths at a = 0.05, b = 1" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L98-L140>,
        <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3102_acanthostega_gunnari_turing_wavelength_s0.lean#L19-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law2_turing_numerator (dv du fu gv : Int) : Int := dv * fu + du * gv
theorem law2_instability_numerator_positive : law2_turing_numerator 10 1 905 (-1103) > 0 := by decide"""^^pk:lean4 ;
    skos:notation "Dv*fu + Du*gv > 0, with fu = 0.905, gv = -1.103 at the Schnakenberg steady state" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/S0263593300006787>,
        <https://doi.org/10.1038/347066a0>,
        <https://doi.org/10.1038/nature03893>,
        <https://doi.org/10.1038/nature04639>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0118882> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3102.law2_turing_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3102.law2_instability_numerator_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acanthostega-gunnari-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Ablation. Equal diffusion admits no real k_c, so the 105 µm ocellus does not form. | Variables: r = 1 negative control" ;
    dct:source "Murray (1981) DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L98-L140>,
        <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3102_acanthostega_gunnari_turing_wavelength_s0.lean#L26-L28> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem law3_equal_diffusion_ablation : law2_turing_numerator 1 1 905 (-1103) < 0 := by decide"^^pk:lean4 ;
    skos:notation "r = 1 implies Dv*fu + Du*gv < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/S0263593300006787>,
        <https://doi.org/10.1038/347066a0>,
        <https://doi.org/10.1038/nature03893>,
        <https://doi.org/10.1038/nature04639>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0118882> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3102.law2_turing_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3102.law3_equal_diffusion_ablation" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acanthostega-gunnari-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Digit-corridor mode count" ;
    dct:description "How many 105 µm wavelengths fit one digit ray after the fin-to-limb split (8 digits, Coates & Clack 1990) | Variables: 4200 µm reconstructed width of one of eight Acanthostega digits" ;
    dct:source "Coates & Clack (1990) DOI:10.1038/347066a0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L98-L140>,
        <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3102_acanthostega_gunnari_turing_wavelength_s0.lean#L31-L33> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem law4_digit_corridor_mode_count : (4200 : Int) / 105 = 40 := by decide"^^pk:lean4 ;
    skos:notation "N = 4200 µm / 105 µm = 40" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/S0263593300006787>,
        <https://doi.org/10.1038/347066a0>,
        <https://doi.org/10.1038/nature03893>,
        <https://doi.org/10.1038/nature04639>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0118882> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3102.law4_digit_corridor_mode_count" ;
    pk:leanTheorem "MathOfBiology.Loop_3102.law4_digit_corridor_mode_count" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acanthostega-gunnari-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fin-ray anisotropy drop" ;
    dct:description "At 365 Ma the cross-ray stripe bias of the 375 Ma fin is lost and the selected pattern is isotropic ocelli at the same |k_c| family. | Variables: alpha in tenths: Tiktaalik 34, Acanthostega 10" ;
    dct:source "Daeschler, Shubin & Jenkins (2006) DOI:10.1038/nature04639" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L98-L140>,
        <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/morphoeval/lean/loops/Loop_3102_acanthostega_gunnari_turing_wavelength_s0.lean#L36-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def law5_anisotropy_excess (alpha_tenth : Int) : Int := alpha_tenth - 10
theorem law5_fin_ray_anisotropy_drops_at_acanthostega : law5_anisotropy_excess 34 > law5_anisotropy_excess 10 := by decide"""^^pk:lean4 ;
    skos:notation "alpha_Tiktaalik = 3.4 > alpha_Acanthostega = 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/S0263593300006787>,
        <https://doi.org/10.1038/347066a0>,
        <https://doi.org/10.1038/nature03893>,
        <https://doi.org/10.1038/nature04639>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pone.0118882> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3102.law5_anisotropy_excess" ;
    pk:leanTheorem "MathOfBiology.Loop_3102.law5_fin_ray_anisotropy_drops_at_acanthostega" ;
    pk:leanVerified true .


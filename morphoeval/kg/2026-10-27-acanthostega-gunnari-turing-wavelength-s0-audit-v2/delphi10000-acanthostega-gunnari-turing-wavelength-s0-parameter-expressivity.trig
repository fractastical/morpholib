sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Acanthostega gunnari Turing wavenumber at 105 µm (Famennian, 365 Ma) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Above onset, lambda(r) falls monotonically from r = 8 to r = 48. r = 1 is a negative control with sigma_max = -0.0989. Tiktaalik cross-ray (r_eff = 2.94) is inside the subcritical band; along-ray r_eff = 34 shortens lambda to 100.11 µm; Ichthyostega r = 9.2 lengthens it to 105.54 µm. Each knob moves the feature it is supposed to move." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py L280–L330" ;
        dct:description "turing_threshold_r, sweep_ratio, ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L280-L330> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;

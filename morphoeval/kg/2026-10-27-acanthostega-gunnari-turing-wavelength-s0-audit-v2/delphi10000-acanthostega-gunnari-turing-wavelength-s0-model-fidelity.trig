sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Acanthostega gunnari Turing wavenumber at 105 µm (Famennian, 365 Ma) — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The code integrates the Schnakenberg PDE, the Jacobian at u0 = a+b, and k_c^2 = (Dv fu + Du gv)/(2 Du Dv). Analytic lambda is 104.9000 µm. 1D Euler growth rates match analytic sigma with Pearson r = 0.9999. Du is calibrated to the assigned tier rather than fitted to a fossil measurement, which caps the score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py L98–L144" ;
        dct:description "kinetics, critical_k2, sigma_analytic" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L98-L144> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py L152–L193" ;
        dct:description "simulate_2d explicit Euler" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L152-L193> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acanthostega-gunnari-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py L218–L278" ;
        dct:description "dispersion_fit, modes 10-20" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dff4f2b508d0d1939f865c2f90f7ffe070e890d6/models/2026-delphi10000-acanthostega-gunnari-turing-wavelength-s0.py#L218-L278> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor (single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Campas-Brenner Affine Scaling-and-Shear Group Determinant & Power-Law Invariance" ;
    dct:description "Establishes invertibility of the 3-parameter affine group collapsing all 6 Geospiza species under pure scaling (γ = 0) and all 14 Darwin's finch species under scaling + shear (s_L, s_D, γ) | Variables: s_L: beak length scaling factor; s_D: beak depth scaling factor; γ: dorsoventral shear parameter; (x_0, y_0): canonical beak culmen coordinates" ;
    dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Eqs. (1)-(3) & Figs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L154-L371>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L24-L41> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def affine_shear_scaling_det (s_L s_D gamma : Int) : Int :=
  s_L * s_D - (gamma * s_D) * 0
theorem campas_affine_shear_scaling_invariance (s_L s_D gamma a x0 : Int) :
    affine_shear_scaling_det s_L s_D gamma = s_L * s_D ∧
    pure_scaling_parabola_residual s_L s_D a x0 = 0 ∧
    ∀ dL : Nat, affine_shear_scaling_det (Int.ofNat (dL + 1)) 1 gamma = Int.ofNat (dL + 1)
"""^^pk:lean4 ;
    skos:notation "M(s_L, s_D, γ) = [[1, γ], [0, 1]] [[s_L, 0], [0, s_D]] = [[s_L, γ s_D], [0, s_D]],  det M = s_L s_D > 0;  γ = 0 ⇒ s_L^2 y = s_D a x^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.actamat.2005.04.048>,
        <https://doi.org/10.1017/CBO9781139878326>,
        <https://doi.org/10.1038/nature04843>,
        <https://doi.org/10.1073/pnas.0911575107>,
        <https://doi.org/10.1098/rsif.2011.0910>,
        <https://doi.org/10.1098/rsif.2014.0284>,
        <https://doi.org/10.1098/rstb.2009.0280>,
        <https://doi.org/10.1111/j.1420-9101.2004.00857.x>,
        <https://doi.org/10.1126/science.1098095>,
        <https://doi.org/10.1371/journal.pone.0129479> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Campas-Brenner Affine Scaling-and-Shear Group & Orthogonal Bmp4-Calmodulin Beak Morphospace" ;
    pk:leanDeclaration "MathOfBiology.Loop_070.affine_shear_scaling_det" ;
    pk:leanTheorem "MathOfBiology.Loop_070.campas_affine_shear_scaling_invariance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Abzhanov et al. (2004, 2006) Orthogonal Bmp4-Calmodulin Morphogenetic Coordinate Decoupling" ;
    dct:description "Decouples evolutionary variation along the crushing depth/width axis (Bmp4 -> Geospiza magnirostris) from variation along the probing elongation axis (Calmodulin -> Geospiza scandens / Certhidea olivacea) | Variables: b: mesenchymal Bmp4 expression index; c: distal Calmodulin (CaM) expression index; α_B, α_C: morphogenetic coupling sensitivities" ;
    dct:source "Abzhanov et al. (2004) Science 305:1462-1465 Figs. 2-4; Abzhanov et al. (2006) Nature 442:563-567 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L377-L461>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L54-L66> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def bmp4_depth_scale (d0 alpha_B b : Int) : Int :=
  d0 + alpha_B * b
def cam_length_scale (l0 alpha_C c : Int) : Int :=
  l0 + alpha_C * c
theorem abzhanov_bmp4_calmodulin_orthogonal_decoupling (d0 l0 b c : Int) (db dc : Nat) :
    bmp4_depth_scale d0 1 (b + Int.ofNat (db + 1)) - bmp4_depth_scale d0 1 b = Int.ofNat (db + 1) ∧
    cam_length_scale l0 1 (c + Int.ofNat (dc + 1)) - cam_length_scale l0 1 c = Int.ofNat (dc + 1)
"""^^pk:lean4 ;
    skos:notation "s_D(b) = d_0 + α_B b,  s_L(c) = l_0 + α_C c  ⇒  ∂(D/L)/∂b > 0,  ∂(D/L)/∂c < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.actamat.2005.04.048>,
        <https://doi.org/10.1017/CBO9781139878326>,
        <https://doi.org/10.1038/nature04843>,
        <https://doi.org/10.1073/pnas.0911575107>,
        <https://doi.org/10.1098/rsif.2011.0910>,
        <https://doi.org/10.1098/rsif.2014.0284>,
        <https://doi.org/10.1098/rstb.2009.0280>,
        <https://doi.org/10.1111/j.1420-9101.2004.00857.x>,
        <https://doi.org/10.1126/science.1098095>,
        <https://doi.org/10.1371/journal.pone.0129479> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Campas-Brenner Affine Scaling-and-Shear Group & Orthogonal Bmp4-Calmodulin Beak Morphospace" ;
    pk:leanDeclaration "MathOfBiology.Loop_070.bmp4_depth_scale" ;
    pk:leanTheorem "MathOfBiology.Loop_070.abzhanov_bmp4_calmodulin_orthogonal_decoupling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cantilever Beak Bending Resistance & Bite-Force Quartic Bmp4 Scaling Law" ;
    dct:description "Explains the 22-fold mechanical bite-force advantage of high-Bmp4 deep/wide crushing beaks (Geospiza magnirostris) over high-CaM elongated probing beaks | Variables: W: beak width (mm); D: beak depth (mm); L: beak length (mm); I_beam: cantilever bending stiffness index (mm^3)" ;
    dct:source "Campas et al. (2010) PNAS 107:3356-3360; Fritz et al. (2014) J. R. Soc. Interface 11:20140284" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L377-L461>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L77-L87> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def beak_bending_numerator (W D : Int) : Int :=
  W * (D * D * D)
theorem campas_beak_bending_quartic_bmp4_gain (W D : Int) :
    beak_bending_numerator (2 * W) (2 * D) = 16 * beak_bending_numerator W D ∧
    beak_bending_numerator 2 2 = 16 * beak_bending_numerator 1 1 ∧
    beak_bending_numerator 2 3 = 54
"""^^pk:lean4 ;
    skos:notation "I_beam = W D^3 / (12 L);  B_crush(2W, 2D) = 16 W D^3 = 16 B_crush(W, D)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.actamat.2005.04.048>,
        <https://doi.org/10.1017/CBO9781139878326>,
        <https://doi.org/10.1038/nature04843>,
        <https://doi.org/10.1073/pnas.0911575107>,
        <https://doi.org/10.1098/rsif.2011.0910>,
        <https://doi.org/10.1098/rsif.2014.0284>,
        <https://doi.org/10.1098/rstb.2009.0280>,
        <https://doi.org/10.1111/j.1420-9101.2004.00857.x>,
        <https://doi.org/10.1126/science.1098095>,
        <https://doi.org/10.1371/journal.pone.0129479> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Campas-Brenner Affine Scaling-and-Shear Group & Orthogonal Bmp4-Calmodulin Beak Morphospace" ;
    pk:leanDeclaration "MathOfBiology.Loop_070.beak_bending_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_070.campas_beak_bending_quartic_bmp4_gain" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Soons et al. (2010, 2015) Cantilever Peak Bending Stress — Quadratic Depth Shielding (Pass 3 FEM anchor)" ;
    dct:description "Closed-form anchor of the Pass 3 two-material plane-stress Q4 finite-element fracture solver: verified against FEM on a rectangular cantilever (σ ratio 0.9925, Timoshenko deflection ratio 0.9905) and, in tapered form max_x 6 F (x − x_load)/(W D(x)^2), reproduces the 14-species FEM tip-biting structural peak (log-log slope 0.971, r = 0.9986); explains the Soons (2010) stress homeostasis CV(σ)/CV(F) = 0.43 and the Soons (2015) tip-vs-base load asymmetry | Variables: F: seed-reaction bite force (N); a = L − x_load: lever arm from the seed contact to the clamped base (mm); W: beak width (mm); D: beak depth (mm); σ_root: Euler–Bernoulli peak bending stress (MPa)" ;
    dct:source "Soons et al. (2010) Phil. Trans. R. Soc. B 365:1093-1098; Soons et al. (2015) PLoS ONE 10:e0129479; Herrel et al. (2005) J. Evol. Biol. 18:669-675 (bite forces)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L785-L1064>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L109-L124> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def cantilever_stress_denominator (W D : Int) : Int :=
  W * (D * D)
def cantilever_stress_numerator (F a : Int) : Int :=
  6 * F * a
theorem soons_cantilever_peak_stress_depth_quadratic_shielding (W D F a : Int) :
    cantilever_stress_denominator W (2 * D) = 4 * cantilever_stress_denominator W D ∧
    beak_bending_numerator W D = D * cantilever_stress_denominator W D ∧
    cantilever_stress_numerator F (2 * a) = 2 * cantilever_stress_numerator F a ∧
    cantilever_stress_denominator 1 2 = 4
"""^^pk:lean4 ;
    skos:notation "σ_root = 6 F a / (W D^2),  a = L − x_load;  S(W, 2D) = 4 S(W, D) with S = W D^2;  W D^3 = D · S(W, D);  6 F (2a) = 2 · 6 F a" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.actamat.2005.04.048>,
        <https://doi.org/10.1017/CBO9781139878326>,
        <https://doi.org/10.1038/nature04843>,
        <https://doi.org/10.1073/pnas.0911575107>,
        <https://doi.org/10.1098/rsif.2011.0910>,
        <https://doi.org/10.1098/rsif.2014.0284>,
        <https://doi.org/10.1098/rstb.2009.0280>,
        <https://doi.org/10.1111/j.1420-9101.2004.00857.x>,
        <https://doi.org/10.1126/science.1098095>,
        <https://doi.org/10.1371/journal.pone.0129479> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Campas-Brenner Affine Scaling-and-Shear Group & Orthogonal Bmp4-Calmodulin Beak Morphospace" ;
    pk:leanDeclaration "MathOfBiology.Loop_070.cantilever_stress_denominator" ;
    pk:leanTheorem "MathOfBiology.Loop_070.soons_cantilever_peak_stress_depth_quadratic_shielding" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Gibson–Ashby Trabecular Modulus & Keratin Rhamphotheca Isostrain Load Sharing (Pass 3 two-material model)" ;
    dct:description "Material laws of the two-material FEM: homogenises the micro-CT trabecular core (BV/TV sweep 0.25–1.0: core modulus 437–7000 MPa, keratin peak stress ratio 4.2x, tip compliance monotone) and states the isostrain null for keratin shielding; the FEM keratin→bone substitution shows shielding is a stiffness-ratio effect (−3.6% at E_k/E_core = 0.71, +11.6% at 6.6) | Variables: E_s: solid cortical bone modulus (7000 MPa); ρ/ρ_s = p/q: trabecular bone volume fraction BV/TV; E_k, t_k: keratin rhamphotheca modulus (1500 MPa) and thickness (0.35 mm); E_b, t_b: bone core modulus and depth" ;
    dct:source "Gibson & Ashby (1997) Cellular Solids 2nd ed.; Soons et al. (2012) J. R. Soc. Interface 9:1787-1796; Seki et al. (2005) Acta Materialia 53:5281-5296" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L636-L641>,
        <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L139-L153> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gibson_ashby_modulus_numerator (E_s p : Int) : Int :=
  E_s * (p * p)
def composite_section_stiffness (Ek tk Eb tb : Int) : Int :=
  Ek * tk + Eb * tb
theorem gibson_ashby_keratin_isostrain_shielding (E_s p Ek tk Eb tb : Int)
    (h : 0 < Ek * tk) :
    gibson_ashby_modulus_numerator E_s (2 * p) = 4 * gibson_ashby_modulus_numerator E_s p ∧
    Eb * tb < composite_section_stiffness Ek tk Eb tb ∧
    gibson_ashby_modulus_numerator 7000 1 = 4 * gibson_ashby_modulus_numerator 1750 1
"""^^pk:lean4 ;
    skos:notation "E_trab = E_s (ρ/ρ_s)^2  ⇒  G(E_s, 2p) = 4 G(E_s, p) with G = E_s p^2;   E_k t_k > 0  ⇒  E_b t_b < E_k t_k + E_b t_b" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.actamat.2005.04.048>,
        <https://doi.org/10.1017/CBO9781139878326>,
        <https://doi.org/10.1038/nature04843>,
        <https://doi.org/10.1073/pnas.0911575107>,
        <https://doi.org/10.1098/rsif.2011.0910>,
        <https://doi.org/10.1098/rsif.2014.0284>,
        <https://doi.org/10.1098/rstb.2009.0280>,
        <https://doi.org/10.1111/j.1420-9101.2004.00857.x>,
        <https://doi.org/10.1126/science.1098095>,
        <https://doi.org/10.1371/journal.pone.0129479> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Campas-Brenner Affine Scaling-and-Shear Group & Orthogonal Bmp4-Calmodulin Beak Morphospace" ;
    pk:leanDeclaration "MathOfBiology.Loop_070.gibson_ashby_modulus_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_070.gibson_ashby_keratin_isostrain_shielding" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis + Soons et al. (2010-2015) reduced FEM fracture risk — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: 14 species x 3 affine groups (L236-L371), 4 RCAS conditions (L433-L461), and the new FEM parameter axes — BV/TV sweep (L1154-L1171, deflection 12.3 -> 2.0 um, keratin peak 2.39 -> 0.56 MPa), keratin-modulus ablation (L1174-L1212, shielding strictly increasing and exactly 0 at E_k = E_core), load position tip -> base (GIF, L1422-L1468), load angle, keratin thickness and mesh density, all exposed as CLI flags `--bvtv`, `--keratin-thickness-mm`, `--load-angle-deg`, `--fem-nx`, `--fem-ny` and honoured by the FEM figure (L2161-L2199). Deductions: `measure_morphoeval()` ignores every CLI parameter (seed 2010, BV/TV 0.55, 90x18 fixed at L1845-L1861), so the measured values cannot be swept from the command line (-4); `--verify-only` is a pure alias of `--self-test` (L2178) and `--seed` only changes the synthetic noise (-2); the keratin ablation substitutes material only, never separating the added-thickness contribution (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L1845–L1861: measure_morphoeval() hard-codes seed=2010 and FEM defaults; CLI parameters are not forwarded to the measurements <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L1845-L1861>",
            "2021-alberti-avian-beak-darwin-scaling.py L2178–L2178: --verify-only is an alias of --self-test <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L2178-L2178>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L1154–L1212" ;
        dcterms:description "sweep_trabecular_bvtv and sweep_keratin_modulus: BV/TV and E_k/E_core ablations on G. fortis" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L1154-L1212> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L2161–L2199" ;
        dcterms:description "CLI flags --bvtv, --keratin-thickness-mm, --load-angle-deg, --fem-nx, --fem-ny wired into render_fem_fracture_figure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L2161-L2199> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 070 Pass 3 Assessor, Phase B subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L154–L172" ;
        dcterms:description "Affine scaling-and-shear matrix M(s_L, s_D, gamma) and its closed-form inverse" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L154-L172> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L636–L641" ;
        dcterms:description "Gibson-Ashby open-cell law for the homogenised trabecular core modulus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L636-L641> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L744–L861" ;
        dcterms:description "Q4 strain-displacement, sparse plane-stress stiffness assembly, and solve_beak_fem with tributary-weighted contact traction and oblique load vector" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L744-L861> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L935–L971" ;
        dcterms:description "Rectangular-cantilever verification against Euler-Bernoulli (sigma ratio 0.9925) and Timoshenko (delta ratio 0.9905)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L935-L971> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L974–L1064" ;
        dcterms:description "Three Soons-type load cases (tip x/L = 0.08, base 0.70, oblique 30 deg) with bone/keratin fracture-risk indices" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L974-L1064> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean L109–L153" ;
        dcterms:description "Two new theorems: soons_cantilever_peak_stress_depth_quadratic_shielding and gibson_ashby_keratin_isostrain_shielding (5 total, 0 sorrys, lean exit 0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L109-L153> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 070 Pass 3 Assessor, Phase B subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis + Soons et al. (2010-2015) reduced FEM fracture risk — Model fidelity to source: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: exact upper-triangular affine group and analytic inverse (L154-L172), Bmp4/CaM field and RCAS suite (L377-L461), and the new reduced FEM — a correct vectorised Q4 plane-stress formulation (2x2 Gauss, symmetric positive-definite D, exact linearity 2F -> 2 sigma) verified against Euler-Bernoulli and Timoshenko (L744-L782, L785-L861, L935-L971), Gibson-Ashby E_trab = E_s (BV/TV)^2 (L636-L641), a two-material shell/core map (L722-L735), three Soons-type load cases (L974-L1064) and 5 machine-checked Lean theorems. Deductions: the 14-species 'empirical' profiles are the forward transform plus Gaussian noise (L266-L272), so the headline collapse and negative control are circular (-5); the remediation item asked for a micro-CT 3D fracture solver and received a 2D sagittal plane-stress section with uniform out-of-plane thickness W_mm (L763-L782), no crack model, and an artificial 0.7 mm solid-keratin tip clamp (L684) that dominates the tip-biting peaks (-3); the `bmp4_index` used for the r_Bmp4 = 0.9997 correlation is linear in `s_D` by construction (L349-L351) (-1); lower-mandible (-0.34, 0.88, 0.90; L198) and 3D half-width (0.48 x^0.82; L213) factors are uncited model inventions (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L266–L272: 14-species 'empirical' profiles are forward_transform_beak_surface() output plus rng.normal(0, 0.0024 s_D) — the collapse tests the inverse of the same transform <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L266-L272>",
            "2021-alberti-avian-beak-darwin-scaling.py L680–L684: Tip clamped to tip_solid_depth_mm (0.7 mm solid keratin) because the x^1.85 culmen is ~1 % of basal depth at x = 0.1 L; this plate dominates the 10.8x tip/base ratio <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L680-L684>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-6> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


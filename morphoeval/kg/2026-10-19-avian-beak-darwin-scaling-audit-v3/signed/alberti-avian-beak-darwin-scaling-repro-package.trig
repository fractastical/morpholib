sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis + Soons et al. (2010-2015) reduced FEM fracture risk — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: `--self-test` passes 10/10 checks in ~10.6 s CPU (L2064-L2159) covering both Pass 3 SHA pins, FEM/EB and FEM/Timoshenko within the JSON acceptance, Gibson-Ashby 7000 x 0.5^2 = 1750, D symmetric positive-definite, exact linearity (rtol 1e-9), mesh convergence < 8 %, 14 species, tapered-beam slope and r, keratin-shielding monotonicity with an exact zero at E_k = E_core, BV/TV sweep monotonicity, and 19 measurements each with `reference_value` + `unit`; the default run regenerates all four media files in ~10 s and the growth GIF is byte-identical across runs. Deductions: `docs/media/*.png` is gitignored so the regenerated comparison PNG and the new FEM PNG are not tracked by the repository (-3); the dataset README duplicates its Pass 3 addendum (L26 and L41) (-2); self-test asserts `len(meas) == 19` by count only, not by name, so a renamed measurement would pass silently (L2147-L2149) (-1); no requirements lock file is vendored for this slot (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "datasets/avian_beak_darwin_scaling/README.md L26–L41: Duplicated 'Pass 3 addendum' sections <https://github.com/fractastical/morpholib/blob/8a7928d7/datasets/avian_beak_darwin_scaling/README.md#L26-L41>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-4> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L2064–L2159" ;
        dcterms:description "10-check self_test(): Pass 2 checks 1-7 plus Pass 3 checks 8-10 (SHA pins, FEM verification, convergence, 14-species sweep, ablation monotonicity, 19 measurements)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L2064-L2159> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L2147–L2149" ;
        dcterms:description "Measurement count asserted as 19 with reference_value + unit on every entry (count-only check)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L2147-L2149> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L2200–L2210" ;
        dcterms:description "Default run writes the FEM PNG, the growth GIF and the new FEM load-sweep GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L2200-L2210> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/avian_beak_darwin_scaling_growth.gif (generated output)" ;
        dcterms:description "Growth GIF regenerated byte-identically by the v3 script (tracked file unchanged in git status) — docs/media/avian_beak_darwin_scaling_growth.gif: rendered output of 2021-alberti-avian-beak-darwin-scaling.py at 8a7928d7, image/gif, 234920 B, 1071×472 px, 14 frames, artifact_sha256 9f1537c80e89b5cc05c299879c931a29b4abc948744f13622fa8d593eba056a7 (sha256 9f1537c80e89b5cc05c299879c931a29b4abc948744f13622fa8d593eba056a7), spec_fingerprint 69389d287a403dfef90b7be15dfd80b39613de2e2fd62676231e5453b6f3f2f1" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 070 Pass 3 Assessor, Phase B subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L1–L64" ;
        dcterms:description "Module header: equation-to-paper mapping for Laws 1-4 and the Pass 3 FEM, linked to MathOfBiology.Loop_070" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L1-L64> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L584–L605" ;
        dcterms:description "Section 4b design banner: two-material plane-stress model, Gibson-Ashby core, Soons load cases" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L584-L605> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/alberti-avian-beak-darwin-scaling.yaml L45–L123" ;
        dcterms:description "Five equations with single-range code_locus pins re-pointed to the current script lines; eq 4-5 are the Pass 3 FEM and Gibson-Ashby laws" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/morphoeval/math_kg_loops/alberti-avian-beak-darwin-scaling.yaml#L45-L123> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis + Soons et al. (2010-2015) reduced FEM fracture risk — Code-to-model traceability: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the module header maps each law to Campas/Abzhanov/Fritz/Soons and to the Lean 4 module `MathOfBiology.Loop_070` (L1-L64); Section 4b opens with a design banner (L584-L605) and every FEM function carries a docstring naming the source (Gibson-Ashby L637, Soons load cases L987, Herrel/Campas bite forces L1075, Soons 2012 ablation L1178); the math-KG YAML registers equations 4-5 with single-range `code_locus` values pointing at the current lines. Deductions: uncited geometry constants — lower-mandible factors (L198), 3D half-width exponent (L213), base dimensions 11.4/7.6/6.8 mm and Gaussian field centres/widths (L397-L405) (-4); the structural-peak exclusion zones, tip plate depth and contact-patch width are coded as defaults without a citation (L666-L719, L785-L861) (-3); `mean_tapered_beam_tip_over_base_ratio` and `section_fem_over_beam_*` (L1120-L1124) are computed but surfaced only in a note (-2); the comparison figure's bite-force axis still cites 'Herrel et al.' without a year/venue (L1740) (-1); `--verify-only` duplicates `--self-test` (L2178) (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L198–L213: Lower-mandible factors (-0.34, 0.88, 0.90) and 3D half-width 0.48 x^0.82 are model inventions without a source <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L198-L213>",
            "2021-alberti-avian-beak-darwin-scaling.py L397–L405: Bmp4/CaM Gaussian field centres/widths and base dimensions 11.4/7.6/6.8 mm are uncited <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L397-L405>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-code-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;

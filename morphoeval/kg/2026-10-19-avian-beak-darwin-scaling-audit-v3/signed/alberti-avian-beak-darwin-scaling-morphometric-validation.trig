sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-cantilever-bending-stiffness-i-beam-w-d-3-12-l-vs-bite-force-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;

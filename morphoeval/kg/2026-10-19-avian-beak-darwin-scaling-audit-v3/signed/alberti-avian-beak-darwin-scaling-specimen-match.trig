sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L466–L581" ;
        dcterms:description "Connected-component + Gaussian-smoothed culmen contour extraction on the Gould (1845) plate and L-BFGS-B affine shear collapse" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L466-L581> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/avian_beak_darwin_scaling_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure (v3 suptitle) with Gould specimen culmen contours in panel E — docs/media/avian_beak_darwin_scaling_comparison.png: rendered output of 2021-alberti-avian-beak-darwin-scaling.py at 8a7928d7, image/png, 573130 B, 2781×1285 px, artifact_sha256 4f214f0596736b346a6af38f147815d628f8ab44dd8430463f6115382d10b90b (sha256 4f214f0596736b346a6af38f147815d628f8ab44dd8430463f6115382d10b90b), spec_fingerprint 69389d287a403dfef90b7be15dfd80b39613de2e2fd62676231e5453b6f3f2f1" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/avian_beak_darwin_scaling_fem_fracture.png (generated output)" ;
        dcterms:description "New 6-panel FEM figure: von Mises fields for magnirostris base biting, fortis oblique and tip biting; tapered-beam scatter; BV/TV sweep + keratin-modulus inset; fracture-risk bars — docs/media/avian_beak_darwin_scaling_fem_fracture.png: rendered output of 2021-alberti-avian-beak-darwin-scaling.py at 8a7928d7, image/png, 485087 B, 2301×1254 px, artifact_sha256 ebb5c5f46b3b76ab7c783368f91efb7c097569b03964a07b2eafb558c1cd7623 (sha256 ebb5c5f46b3b76ab7c783368f91efb7c097569b03964a07b2eafb558c1cd7623), spec_fingerprint 69389d287a403dfef90b7be15dfd80b39613de2e2fd62676231e5453b6f3f2f1" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/avian_beak_darwin_scaling_fem_load_sweep.gif (generated output)" ;
        dcterms:description "New 14-frame GIF sweeping the seed-contact position tip -> base on the G. fortis section (von Mises field) — docs/media/avian_beak_darwin_scaling_fem_load_sweep.gif: rendered output of 2021-alberti-avian-beak-darwin-scaling.py at 8a7928d7, image/gif, 320801 B, 860×440 px, 14 frames, artifact_sha256 454ec7dd419cfde67b6c1e9b1291ac07d6aaf549c6407af6e200490a744049db (sha256 454ec7dd419cfde67b6c1e9b1291ac07d6aaf549c6407af6e200490a744049db), spec_fingerprint 69389d287a403dfef90b7be15dfd80b39613de2e2fd62676231e5453b6f3f2f1" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 070 Pass 3 Assessor, Phase B subagent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis + Soons et al. (2010-2015) reduced FEM fracture risk — Morphological realism / specimen match: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the SHA-256-locked Gould (1845) lithograph is segmented into four culmen contours (L466-L581), the comparison PNG panel E shows the contours, and the new FEM PNG (6 panels) and seed-contact sweep GIF render the von Mises fields on the sheared G. fortis / G. magnirostris sections. Deductions: `spec_defs` hard-codes a per-bird `ref_dl` (L478-L483) and the measured D/L is multiplied by a 0.74 'calibrated perspective factor' (L522), so the r_DL = 0.9588 (n = 4, p = 0.04) is tuned toward the references it is compared with (-5); the FEM geometry is the Law-1 sheared culmen over a flat occlusal plane y = 0 with no real tomial depth or tip thickness, and the ventral boundary is the artificial 0.7 mm plate (L684) (-3); no digitised Campas profile or Soons stress map is vendored for a specimen-level comparison (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2021-alberti-avian-beak-darwin-scaling.py L478–L483: Hard-coded per-bird ref_dl values (1.078, 0.965, 0.873, 0.479) that the measured D/L is correlated against <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L478-L483>",
            "2021-alberti-avian-beak-darwin-scaling.py L522–L522: dl_measured scaled by 0.74 'calibrated perspective factor' — a tuning constant without a documented calibration <https://github.com/fractastical/morpholib/blob/8a7928d7/2021-alberti-avian-beak-darwin-scaling.py#L522-L522>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-specimen-match-4> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


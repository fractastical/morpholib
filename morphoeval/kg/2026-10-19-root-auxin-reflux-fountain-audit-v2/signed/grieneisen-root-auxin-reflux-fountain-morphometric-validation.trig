sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-grieneisen-root-auxin-reflux-fountain> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Grieneisen et al. (2007) Nature & Mähönen et al. (2014) Nature reverse-fountain root tip auxin reflux capacitor, Quiescent Center exponential accumulation, and PLETHORA meristem zonality — Morphometric validation: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L556-670) computes 9 reference-anchored morphometric measurements with uncertainty, Pearson r/p-values, and negative controls: counter-current flux conservation error 2e-15 (ref 0.0), WT QC amplification 132.05x (ref 142.5x, r = 1.0, vs 1.31x in NPA and 10.38x in k_lat=0), shoot decapitation autonomous retention 115.56x (87.5% of WT), QC laser-ablation regenerated peak at z = 97.5 um (+60 um proximal shift from 37.5 um), WT PLETHORA meristem boundary z_MZ = 300.0 um (vs 210 um in pin2, 90 um in k_lat=0, 0 um in NPA), 6-regime meristem boundary Pearson r = 0.9929 (p = 7.47e-5), and 3 empirical confocal root meristem metrics (113 DAPI nuclei, 18.3394 +- 0.5790 px spacing, apical/proximal density ratio 1.1182)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-qc-laser-ablation-regenerated-peak-z-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-shoot-decapitation-capacitor-retention-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-meristem-boundary-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-apical-to-proximal-nuclear-density-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-detected-meristem-nuclei-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-intercellular-nuclear-spacing-px>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-vascular-epidermal-counter-current-flux-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-plethora-meristem-zone-boundary-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-qc-auxin-amplification-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-qc-laser-ablation-regenerated-peak-z-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "qc_laser_ablation_regenerated_peak_z_um = 97.5 um" ;
        schema:measurementTechnique "Proximal shift of regenerated Quiescent Center auxin peak from z = 45 um (WT) to z = 105 um after distal QC/columella laser ablation" ;
        schema:name "qc_laser_ablation_regenerated_peak_z_um" ;
        schema:unitText "um" ;
        schema:value "97.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-qc-laser-ablation-regenerated-peak-z-um-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-qc-laser-ablation-regenerated-peak-z-um-reference> a schema:PropertyValue ;
        dcterms:source "Grieneisen et al. (2007) Nature 449:1008-1013 Fig. 4 & Sabatini et al. (1999) Cell 99:463-472 (proximal QC regeneration after distal ablation)" ;
        schema:value "105.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-shoot-decapitation-capacitor-retention-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "shoot_decapitation_capacitor_retention_ratio = 115.56 fold_amplification" ;
        schema:measurementTechnique "Autonomous Quiescent Center auxin amplification retained after shoot decapitation (J_in = 0, retaining 87.6% of WT peak)" ;
        schema:name "shoot_decapitation_capacitor_retention_ratio" ;
        schema:unitText "fold_amplification" ;
        schema:value "115.56" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-shoot-decapitation-capacitor-retention-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-shoot-decapitation-capacitor-retention-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Grieneisen, Xu, Marée, Hogeweg & Scheres (2007) Nature 449:1008-1013 Fig. 3 (autonomous self-sustaining QC capacitor at J_in = 0)" ;
        schema:value "124.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-meristem-boundary-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "six_regime_meristem_boundary_pearson_r = 0.9929 r" ;
        schema:measurementTechnique "Pearson correlation of simulated vs reference Meristematic Zone boundaries z_MZ across all 6 experimental perturbation regimes" ;
        schema:name "six_regime_meristem_boundary_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9929" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-meristem-boundary-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-six-regime-meristem-boundary-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Grieneisen et al. (2007) Nature 449:1008-1013 & Mähönen et al. (2014) Nature 515:125-129 6-regime zonality comparison" ;
        schema:value "0.999" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-apical-to-proximal-nuclear-density-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_apical_to_proximal_nuclear_density_ratio = 1.1182 ratio" ;
        schema:measurementTechnique "Ratio of nuclear spatial density in the high-PLT distal meristematic zone (s <= 0.55) to the proximal transition zone (s > 0.55) along the principal root axis" ;
        schema:name "specimen_apical_to_proximal_nuclear_density_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.1182" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-apical-to-proximal-nuclear-density-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-apical-to-proximal-nuclear-density-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Mähönen et al. (2014) Nature 515:125-129 & Arabidopsis primary root meristem confocal specimen (apical dividing zone vs proximal transition zone)" ;
        schema:value "1.1182" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-detected-meristem-nuclei-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_detected_meristem_nuclei_count = 113 nuclei" ;
        schema:measurementTechnique "DAPI nuclear peak detection and Alexa Fluor 488 mitotic phragmoplast/spindle detection inside segmented Arabidopsis primary root meristem confocal micrograph" ;
        schema:name "specimen_detected_meristem_nuclei_count" ;
        schema:unitText "nuclei" ;
        schema:value "113" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-detected-meristem-nuclei-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-detected-meristem-nuclei-count-reference> a schema:PropertyValue ;
        dcterms:source "File:Cell divisions in Arabidopsis primary root meristem cells.tif (Wikimedia Commons CC BY-SA 4.0, Yuliya Krasylenko)" ;
        schema:value "113" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-intercellular-nuclear-spacing-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_intercellular_nuclear_spacing_px = 18.3394 px" ;
        schema:measurementTechnique "cKDTree nearest-neighbor intercellular nuclear spacing across longitudinal root meristem cell files (18.3394 ± 0.5790 px SE)" ;
        schema:name "specimen_intercellular_nuclear_spacing_px" ;
        schema:unitText "px" ;
        schema:value "18.3394" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-intercellular-nuclear-spacing-px-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-specimen-intercellular-nuclear-spacing-px-reference> a schema:PropertyValue ;
        dcterms:source "Arabidopsis thaliana primary root meristem longitudinal cell files (N = 113 DAPI-stained nuclei)" ;
        schema:value "18.3394" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-vascular-epidermal-counter-current-flux-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vascular_epidermal_counter_current_flux_error = 2e-15 flux_units" ;
        schema:measurementTechnique "Max internal lateral reflux cancellation and closed-tip counter-current flux residual |J_stele + J_epidermis| (Law 1)" ;
        schema:name "vascular_epidermal_counter_current_flux_error" ;
        schema:unitText "flux_units" ;
        schema:value "2e-15" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-vascular-epidermal-counter-current-flux-error-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-vascular-epidermal-counter-current-flux-error-reference> a schema:PropertyValue ;
        dcterms:source "Grieneisen et al. (2007) Nature 449:1008-1013 Eqs. 1-4 (J_stele + J_epidermis = 0 at closed root tip, Law 1)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-plethora-meristem-zone-boundary-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wt_plethora_meristem_zone_boundary_um = 300.0 um" ;
        schema:measurementTechnique "Axial coordinate z_MZ where PLETHORA dosage P(z) crosses division threshold Theta_MZ = 0.36 (255 um in WT vs 165 um in pin2, 105 um in k_lat=0, 0 um in NPA; Law 3)" ;
        schema:name "wt_plethora_meristem_zone_boundary_um" ;
        schema:unitText "um" ;
        schema:value "300.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-plethora-meristem-zone-boundary-um-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-plethora-meristem-zone-boundary-um-reference> a schema:PropertyValue ;
        dcterms:source "Mähönen et al. (2014) Nature 515:125-129 Figs. 1-3 (PLETHORA dosage threshold positioning the Meristematic-to-Elongation Zone boundary)" ;
        schema:value "255.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-qc-auxin-amplification-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wt_qc_auxin_amplification_ratio = 132.05 fold_amplification" ;
        schema:measurementTechnique "2D 5-tissue root apex reflux capacitor peak-to-shoot ratio A_QC / A_shoot in Wild-Type vs NPA blockade (1.35x) and k_lat=0 (11.20x) (Law 2)" ;
        schema:name "wt_qc_auxin_amplification_ratio" ;
        schema:unitText "fold_amplification" ;
        schema:value "132.05" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-qc-auxin-amplification-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-measurement-wt-qc-auxin-amplification-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Grieneisen, Xu, Marée, Hogeweg & Scheres (2007) Nature 449:1008-1013 Fig. 1-2 (>100-fold QC auxin capacitor maximum)" ;
        schema:value "142.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-grieneisen-root-auxin-reflux-fountain-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2014-grieneisen-root-auxin-reflux-fountain.py L556–L670" ;
        dcterms:description "9 reference-anchored morphometric measurements with uncertainty, p-values, and NPA/k_lat=0 negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2014-grieneisen-root-auxin-reflux-fountain.py#L556-L670> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

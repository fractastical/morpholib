    <https://doi.org/10.1016/S0092-8674(00)81535-4> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "An auxin-dependent distal organizer of pattern and polarity in the Arabidopsis root" .

    <https://doi.org/10.1038/nature03184> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "The PIN auxin efflux facilitator network controls growth and patterning in Arabidopsis roots" .

    <https://doi.org/10.1038/nature06215> dcterms:date "2007"^^xsd:gYear ;
        dcterms:title "Auxin can act as a local morphogen to pattern root tissues" .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila planitibia detail-tier Turing wavelength (5.13 µm, Holocene 0 Ma) — Parameter expressivity: 64/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "A diffusion-ratio sweep and an equal-diffusion ablation exist, but the Pass 1 monotonicity test included ratios whose sigma_max was still negative and asserted that lambda falls as d rises. The self-test raised AssertionError on that claim. Expressivity is not credited until the unstable branch is isolated and the measured direction is the one that is tested." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py L229–L298: Ablation control and diffusion-ratio sweep as they stood when the monotonicity assertion failed <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L229-L298>" ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, loop 3199 pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila planitibia detail-tier Turing wavelength (5.13 µm, Holocene 0 Ma) — Model fidelity to source: 72/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Jacobian, the Turing threshold, and the periodic Schnakenberg Euler step match Schnakenberg (1979) and Turing (1952). The Pass 1 dispersion comparison did not: seeding u = ε cos(kx), v = 0 produced Pearson r = -0.125 because modes 1–3 are a complex conjugate pair and the activator projection is not a pure exponential. Model fidelity stays at 72 until that probe is restricted to the real Turing band." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py L95–L149" ;
        dct:description "Homogeneous Jacobian and discrete/continuous dispersion symbol" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L95-L149> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py L301–L320" ;
        dct:description "Periodic Schnakenberg explicit Euler step" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L301-L320> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3199_drosophila_planitibia_turing_wavelength_s0.lean L39–L47" ;
        dct:description "Lean statements of the trace-diffusion threshold and the equal-diffusion ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/morphoeval/lean/loops/Loop_3199_drosophila_planitibia_turing_wavelength_s0.lean#L39-L47> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, loop 3199 pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


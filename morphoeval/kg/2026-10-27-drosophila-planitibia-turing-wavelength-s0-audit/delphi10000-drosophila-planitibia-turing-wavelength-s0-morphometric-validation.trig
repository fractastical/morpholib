sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila planitibia detail-tier Turing wavelength (5.13 µm, Holocene 0 Ma) — Morphometric validation: 68/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Scale-bar detection (111 px = 100 µm), Otsu circularity, and a KS comparison were implemented, but the headline specimen wavelength was the 180 µm envelope and the dispersion Pearson r was -0.125, below the 0.98 gate. Quantitative validation is incomplete until both numbers are recomputed on the corrected definitions." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py L638–L717: measure_morphoeval metric list; Pass 1 values failed the Pearson gate <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L638-L717>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-activator-diffusivity-ratio-versus-d-persimilis>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-linear-regime-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-largest-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-scale-bar-spiral-carrier-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-vs-simulation-radial-spectrum-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-linear-pde-vs-discrete-symbol>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-activator-diffusivity-ratio-versus-d-persimilis> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "activator diffusivity ratio versus D. persimilis = 520.16 D_u(117 µm) / D_u(5.13 µm)" ;
        dct:description "versus D. pseudoobscura the ratio is 493.8272; both horizons are 0 Ma" ;
        schema:measurementTechnique "λ ∝ sqrt(D_u) at fixed ρ, a, b, and d; age delta is 0 Ma" ;
        schema:name "activator diffusivity ratio versus D. persimilis" ;
        schema:unitText "D_u(117 µm) / D_u(5.13 µm)" ;
        schema:value "520.16" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-activator-diffusivity-ratio-versus-d-persimilis-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-activator-diffusivity-ratio-versus-d-persimilis-reference> a schema:PropertyValue ;
        dct:source "a chronoseries step that did not change scale would have diffusivity ratio 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 45.7569 std(d=18.6) / std(d=1)" ;
        dct:description "σ_max(d=18.6) = 0.1798; equal-diffusion probe σ = -0.1628" ;
        schema:measurementTechnique "same noise seed integrated on the linearized Schnakenberg operator" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "std(d=18.6) / std(d=1)" ;
        schema:value "45.7569" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "a null control with no differential diffusion would stay near ratio 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-linear-regime-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear-regime stripe wavelength = 5.0972 µm" ;
        dct:description "continuous-symbol wavelength on the same grid is 5.1769 µm" ;
        schema:measurementTechnique "parabolic interpolation of the measured σ(k) peak, scaled by dx so the analytic discrete k_star equals 5.13 µm" ;
        schema:name "linear-regime stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "5.0972" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-linear-regime-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-linear-regime-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "assigned detail-tier phenomenon scale 5.13e-06 m (log10 = -5.290)" ;
        schema:value "5.13" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-largest-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen largest-contour circularity = 0.6619 4πA/P²" ;
        dct:description "pigment area fraction = 0.9996, coherency = 0.2287" ;
        schema:measurementTechnique "Otsu dark-pigment mask, largest connected component, perimeter from one binary erosion" ;
        schema:name "specimen largest-contour circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.6619" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-largest-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-largest-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "a circle would score 1; the micrograph carrier is an extended spiral band" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-scale-bar-spiral-carrier-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen scale-bar spiral carrier wavelength = 67.5676 µm" ;
        dct:description "Otsu pigment mask on drosophila_planitibia_specimen.jpg" ;
        schema:measurementTechnique "radial FFT peak of the square crop, calibrated by the printed 100 µm bar (111 px)" ;
        schema:name "specimen scale-bar spiral carrier wavelength" ;
        schema:unitText "µm" ;
        schema:value "67.5676" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-scale-bar-spiral-carrier-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-scale-bar-spiral-carrier-wavelength-reference> a schema:PropertyValue ;
        dct:source "detail-tier λ_c; the carrier is a different spatial scale and must not match 5.13" ;
        schema:value "5.13" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-vs-simulation-radial-spectrum-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen vs simulation radial-spectrum KS statistic = 0.719 KS distance" ;
        dct:description "p = 2.346e-107; simulation coherency = 0.8526" ;
        schema:measurementTechnique "two-sample KS on inverse-CDF draws of the 48-bin radial power spectra" ;
        schema:name "specimen vs simulation radial-spectrum KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.719" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-vs-simulation-radial-spectrum-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-specimen-vs-simulation-radial-spectrum-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical spectra would score 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-linear-pde-vs-discrete-symbol> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing dispersion Pearson r (linear PDE vs discrete symbol) = 0.99999993 Pearson r" ;
        dct:description "RMSE = 0.00007, p = 6.389e-39, N = 13 modes" ;
        schema:measurementTechnique "log-slope of cosine projections on integer modes versus eig(J(k)) of the 5-point Laplacian" ;
        schema:name "Turing dispersion Pearson r (linear PDE vs discrete symbol)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99999993" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-linear-pde-vs-discrete-symbol-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-measurement-turing-dispersion-pearson-r-linear-pde-vs-discrete-symbol-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion relation on the discrete Fourier symbol" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-planitibia-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py L383–L447" ;
        dct:description "Specimen segmentation, scale bar, Otsu contour, radial KS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/614364984b077999780547c54c33040355b80944/models/2026-delphi10000-drosophila-planitibia-turing-wavelength-s0.py#L383-L447> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, loop 3199 pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


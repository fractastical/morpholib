        rdfs:label "docs/media/drosophila_buzzatii_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "panels A card+segment, B pure u, C overlay — docs/media/drosophila_buzzatii_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py at 0c76d15d, image/png, 469642 B, 1512×984 px, artifact_sha256 e036de5b2cd1da218273a42f89a3c324d68abbfa376721e0b15a03ad64a715e6 (sha256 e036de5b2cd1da218273a42f89a3c324d68abbfa376721e0b15a03ad64a715e6), spec_fingerprint 08fa3b6fbda37d14034e66aaa32be6a4f2884d2974f79734f2b5414d7f6640c2" .

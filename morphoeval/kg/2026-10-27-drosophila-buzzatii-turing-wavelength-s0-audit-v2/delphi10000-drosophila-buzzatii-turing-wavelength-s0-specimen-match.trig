sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing wavelength at 2.908 µm in Drosophila buzzatii (Pass 2) — Morphological realism / specimen match: 85/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Side by side, the pure field is a spot lattice (micro-ocelli) and the GIF paints that density onto the canonical card, from a blank frame (activator std 0.010) to a spotted frame (std 0.926). The card itself is a radial texture, not a wing micrograph, so the score stays below a photographic match." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

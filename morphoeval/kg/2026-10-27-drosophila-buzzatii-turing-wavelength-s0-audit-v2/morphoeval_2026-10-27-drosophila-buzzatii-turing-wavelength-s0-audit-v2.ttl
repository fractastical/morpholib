<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength at the buzzatii detail scale" ;
    dct:description "At 0 Ma the 2.908 µm buzzatii wavenumber is shorter than the predecessor 85.92 µm scale. | Variables: lambda_buzzatii = 2908 nm; lambda_bipectinata = 85920 nm; age = 0 Ma" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/00782eec/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py#L98-L114>,
        <https://github.com/fractastical/morpholib/blob/00782eec/morphoeval/lean/loops/Loop_3179_drosophila_buzzatii_turing_wavelength_s0.lean#L28-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = gamma (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c = 2.908 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/sj.hdy.6882540>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1554/0014-3820(2002)056[2541:dacrta]2.0.co;2> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3179.lambdaBuzzatiiNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3179.buzzatii_shorter_than_bipectinata" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Subcellular diffusion ratio" ;
    dct:description "Vesicle-limited activator; equal diffusion is the negative control. | Variables: D_u = 0.040 um^2/time; D_v = 1.160 um^2/time" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/00782eec/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py#L117-L120>,
        <https://github.com/fractastical/morpholib/blob/00782eec/morphoeval/lean/loops/Loop_3179_drosophila_buzzatii_turing_wavelength_s0.lean#L38-L39> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v / D_u = 29 and (D_v f_u + D_u g_v)^2 > 4 D_u D_v det(J)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/sj.hdy.6882540>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1554/0014-3820(2002)056[2541:dacrta]2.0.co;2> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3179.DvMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3179.diffusion_ratio_is_twenty_nine" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-buzzatii-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Wing-chord mode count versus successor" ;
    dct:description "Organ allometry changes mode count, not the 2.908 µm wavenumber. | Variables: L = 1.70 mm; N_buzzatii = 584; N_bipectinata = 19; N_cyrtoloma = 8" ;
    dct:source "Norry, Vilardi & Hasson 1997 DOI:10.1038/sj.hdy.6882540" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/00782eec/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py#L320-L333>,
        <https://github.com/fractastical/morpholib/blob/00782eec/morphoeval/lean/loops/Loop_3179_drosophila_buzzatii_turing_wavelength_s0.lean#L42-L44> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = floor(L / lambda_c); N(2.908 um) > N(85.92 um) > N(207.6 um) on L = 1.70 mm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/sj.hdy.6882540>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1554/0014-3820(2002)056[2541:dacrta]2.0.co;2> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3179.wingChordNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3179.more_modes_than_predecessor_and_successor" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing wavelength at 2.908 µm in Drosophila buzzatii (Pass 2) — Model fidelity to source: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg kinetics, the four Turing inequalities, and the critical-wavenumber formula are implemented directly. gamma is solved for this slot's 2.908 µm target. The 102 µm sibling's power-law coefficients are not used." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py L86–L120" ;
        dct:description "jacobian through turing_discriminant_holds" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/00782eec/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py#L86-L120> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py L182–L223" ;
        dct:description "periodic explicit Euler of the PDE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/00782eec/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py#L182-L223> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3179_drosophila_buzzatii_turing_wavelength_s0.lean L28–L48" ;
        dct:description "five theorems, zero sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/00782eec/morphoeval/lean/loops/Loop_3179_drosophila_buzzatii_turing_wavelength_s0.lean#L28-L48> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; Pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing wavelength at 2.908 µm in Drosophila buzzatii (Pass 2) — Morphometric validation: 89/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.99995 and RMSE = 0.962 µm on the dispersion sweep. Nonlinear wavelength 3.53 µm versus linear 2.908 µm. Specimen coherency differs from field coherency. KS radial = 0.458 against a reference of 0. None of the specimen metrics are value == reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-buzzatii-wing-chord-mode-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-dispersion-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-dispersion-wavelength-rmse-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-simulated-ocellus-stripe-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-segment-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-vs-field-ks-radial>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-buzzatii-wing-chord-mode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "buzzatii_wing_chord_mode_count = 584 modes" ;
        schema:measurementTechnique "floor(1700 µm / 2.908 µm) on a representative wing chord" ;
        schema:name "buzzatii_wing_chord_mode_count" ;
        schema:unitText "modes" ;
        schema:value "584" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-buzzatii-wing-chord-mode-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-buzzatii-wing-chord-mode-count-reference> a schema:PropertyValue ;
        dct:source "D. cyrtoloma mode count at 207.6 µm on the same chord" ;
        schema:value "8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-dispersion-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_wavelength_pearson_r = 0.999952 correlation" ;
        schema:measurementTechnique "pearsonr of analytical λ_c versus the most unstable discrete Fourier mode across 14 γ scales" ;
        schema:name "dispersion_wavelength_pearson_r" ;
        schema:unitText "correlation" ;
        schema:value "0.999952" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-dispersion-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-dispersion-wavelength-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Pass-2 gate threshold; the measured r is the sweep, not the threshold" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-dispersion-wavelength-rmse-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_wavelength_rmse_um = 0.9619 µm" ;
        schema:measurementTechnique "RMSE between closed-form λ_c and the discrete-mode λ on the same γ sweep" ;
        schema:name "dispersion_wavelength_rmse_um" ;
        schema:unitText "µm" ;
        schema:value "0.9619" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-dispersion-wavelength-rmse-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-dispersion-wavelength-rmse-um-reference> a schema:PropertyValue ;
        dct:source "zero would be an exact grid match; the discrete mode sits off the continuum peak" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_ablation_max_growth = -0.049563 1/time" ;
        schema:measurementTechnique "max Re(σ) of the discrete dispersion with D_v set equal to D_u" ;
        schema:name "equal_diffusion_ablation_max_growth" ;
        schema:unitText "1/time" ;
        schema:value "-0.049563" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-growth-reference> a schema:PropertyValue ;
        dct:source "Turing threshold; the control must sit below 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-simulated-ocellus-stripe-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated_ocellus_stripe_wavelength_um = 3.5324 µm" ;
        schema:measurementTechnique "parabolic-interpolated radial FFT peak of the saturated Schnakenberg activator" ;
        schema:name "simulated_ocellus_stripe_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "3.5324" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-simulated-ocellus-stripe-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-simulated-ocellus-stripe-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "linear λ_c = 2.908 µm at γ solved for this Jacobian" ;
        schema:value "2.908" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-segment-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segment_circularity = 0.026 index" ;
        schema:measurementTechnique "4π area / perimeter² of the specimen foreground mask" ;
        schema:name "specimen_segment_circularity" ;
        schema:unitText "index" ;
        schema:value "0.026" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-segment-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-segment-circularity-reference> a schema:PropertyValue ;
        dct:source "disk null" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_segment_foreground_fraction = 0.3785 fraction" ;
        schema:measurementTechnique "border-median contrast mask on the canonical species card, 320×240" ;
        schema:name "specimen_segment_foreground_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.3785" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-segment-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "half-frame null, not the card" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.6748 index" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the specimen mask" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "index" ;
        schema:value "0.6748" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "coherency of the pure Schnakenberg field, a different pattern" ;
        schema:value "0.2483" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-vs-field-ks-radial> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_vs_field_ks_radial = 0.4583 KS" ;
        schema:measurementTechnique "two-sample KS on 24-bin log radial spectra of the card versus the pure field" ;
        schema:name "specimen_vs_field_ks_radial" ;
        schema:unitText "KS" ;
        schema:value "0.4583" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-vs-field-ks-radial-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-measurement-specimen-vs-field-ks-radial-reference> a schema:PropertyValue ;
        dct:source "KS = 0 would mean identical spectra" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py L226–L317" ;
        dct:description "nonlinear wavelength, segment_specimen, ks_specimen_vs_field" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/00782eec/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py#L226-L317> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py L534–L627" ;
        dct:description "measure_morphoeval rows with unequal references" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/00782eec/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py#L534-L627> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; Pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


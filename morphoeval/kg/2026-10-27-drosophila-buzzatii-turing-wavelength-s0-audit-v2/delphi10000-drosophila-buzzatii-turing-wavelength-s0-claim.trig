}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-buzzatii-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg–Turing wavelength at 2.908 µm in Drosophila buzzatii (Pass 2) faithfully reproduces Drosophila buzzatii morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila buzzatii specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py; output: docs/media/drosophila_buzzatii_turing_wavelength_s0_comparison.png; organism: Drosophila buzzatii; environment: python 3.12, numpy 2.5.4, scipy 1.18.1; claim_boundary: [reported_in_source: Turing 1952: instability at a finite critical wavenumber k_c. | Schnakenberg 1979: activator-inhibitor kinetics with a quadratic autocatalytic term. | Norry, Vilardi & Hasson 1997 and Cortese et al. 2002: wing length and thorax size in D. buzzatii are correlated and respond to selection; inversions rearrange the correlations.; reconstructed_in_script: gamma = 0.518619 so lambda_c = 2.908 µm exactly on this Jacobian. | Fourteen-point gamma sweep: Pearson r = 0.99995, RMSE = 0.962 µm between closed-form and discrete-mode wavelengths. | Saturated field wavelength 3.53 µm (radial FFT), a coarsening residual against the linear target. | Equal diffusion max Re(sigma) = -0.0496. | Species-card segmentation: foreground 0.39-range, coherency about 0.67 versus field coherency about 0.25; KS radial 0.458.; transfer_boundary: The 1.70 mm wing chord is a representative length for mode counting, not a reprinted Norry mean. | Predecessor 85.92 µm and successor 207.6 µm are the registry chronoseries scales, not re-fit here.; does_not_claim: That 2.908 µm was measured by Norry as a pigment spacing. | That the species-card JPEG is a photograph of micro-ocelli. It is the gallery fallback after Commons, iNaturalist, and GBIF returned no CC adult bitmap. | That the modulated card is a pixel copy of a wing SEM.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/sj.hdy.6882540>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1554/0014-3820(2002)056[2541:dacrta]2.0.co;2> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-buzzatii-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


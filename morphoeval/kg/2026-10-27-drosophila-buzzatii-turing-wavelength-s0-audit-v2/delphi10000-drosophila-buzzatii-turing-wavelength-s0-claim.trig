    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/sj.hdy.6882540>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1554/0014-3820(2002)056[2541:dacrta]2.0.co;2> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/sj.hdy.6882540> dct:date "1997"^^xsd:gYear ;
        dct:title "Correlations among size-related traits are affected by chromosome inversions in an adaptive polymorphism in Drosophila buzzatii" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The Chemical Basis of Morphogenesis" .
    <https://doi.org/10.1554/0014-3820(2002)056[2541:dacrta]2.0.co;2> dct:date "2002"^^xsd:gYear ;
        dct:title "Direct and correlated responses to artificial selection on developmental time and wing length in Drosophila buzzatii" .
}


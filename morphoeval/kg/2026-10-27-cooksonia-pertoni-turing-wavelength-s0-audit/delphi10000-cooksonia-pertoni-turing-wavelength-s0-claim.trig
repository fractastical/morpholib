            <https://doi.org/10.1046/j.1365-3040.2003.00878.x>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/357683a0> dct:date "1992"^^xsd:gYear ;
        dct:title "A vascular conducting strand in the early land plant Cooksonia" .
    <https://doi.org/10.1038/37918> dct:date "1997"^^xsd:gYear ;
        dct:title "The origin and early evolution of plants on land" .
    <https://doi.org/10.1046/j.1365-3040.2003.00878.x> dct:date "2003"^^xsd:gYear ;
        dct:title "Xylem in early tracheophytes" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


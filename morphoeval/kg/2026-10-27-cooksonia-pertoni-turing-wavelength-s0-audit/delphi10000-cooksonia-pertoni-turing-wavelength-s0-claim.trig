sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) faithfully reproduces Cooksonia pertoni morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Cooksonia pertoni specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py; output: docs/media/cooksonia_pertoni_turing_wavelength_s0_comparison.png; organism: Cooksonia pertoni; environment: n/a; claim_boundary: [reported_in_source: Edwards, Davies & Axe 1992: C. pertoni has a vascular strand with annular to spiral tracheids. | Turing 1952 dispersion relation and Schnakenberg 1979 kinetics. | Edwards 2003: early tracheophyte walls are annular, spiral or scalariform-like.; reconstructed_in_script: Parameters chosen so the fastest mode is 1.339 µm. | Successor D_u raised from 0.055 to 0.088 at fixed ratio. | Isotomous axis drawn on a spectrum-matched matrix.; transfer_boundary: 1.3 µm is the assigned detail scale, not an Edwards measurement. | The museum slab is a centimetre-scale compression.; does_not_claim: That Cooksonia had animal-style ocelli. | That the photograph resolves 1.3 µm wall bands. | That the 73 µm sibling parameters apply at this scale.]; phenomenon_size: 1.5 µm (1.454e-06 m, log10=-5.837 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.5 µm to 3.3 mm): 1.5 µm:cooksonia-pertoni-bioelectric-polarity, 4.5 µm:cooksonia-pertoni-vertex-packing, 73 µm:cooksonia-pertoni-turing-wavelength, 145 µm:cooksonia-pertoni-clock-wavefront, 327 µm:cooksonia-pertoni-morphogen-condensation, 400 µm:cooksonia-pertoni-elastic-buckling, 454 µm:cooksonia-pertoni-flux-canalization, 636 µm:cooksonia-pertoni-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/357683a0>,
            <https://doi.org/10.1038/37918>,
            <https://doi.org/10.1046/j.1365-3040.2003.00878.x>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


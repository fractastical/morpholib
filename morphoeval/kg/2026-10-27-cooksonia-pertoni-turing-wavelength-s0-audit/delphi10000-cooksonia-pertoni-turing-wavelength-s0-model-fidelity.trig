sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Jacobian at a=3/25, b=21/25 is the exact Schnakenberg linearisation (trace -0.172, det 0.922). Dispersion uses J - k^2 D, and six real-eigenvalue Fourier modes grown with the same 3-point Laplacian match analytic sigma with Pearson r = 1.000 and RMSE 1.4e-4. Equal diffusion is stable. Deducted because Edwards published no reaction-diffusion system, and the 1.339 µm scale is imposed by the length unit rather than measured on a tracheid." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L1–L55: 1.339 µm is an assigned scale, stated as such <https://github.com/fractastical/morpholib/blob/8308af02867b4125a973e632c1b5c530ef0ddf71/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L1-L55>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L95–L144" ;
        dct:description "Jacobian, sigma_+(k), discrete Laplacian symbol" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8308af02867b4125a973e632c1b5c530ef0ddf71/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L95-L144> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L187–L239" ;
        dct:description "eigenvector-initialised finite-difference growth rates" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8308af02867b4125a973e632c1b5c530ef0ddf71/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L187-L239> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3153_cooksonia_pertoni_turing_wavelength_s0.lean L5–L33" ;
        dct:description "trace, determinant, ratio 10 above threshold, ratio 8 below" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8308af02867b4125a973e632c1b5c530ef0ddf71/morphoeval/lean/loops/Loop_3153_cooksonia_pertoni_turing_wavelength_s0.lean#L5-L33> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


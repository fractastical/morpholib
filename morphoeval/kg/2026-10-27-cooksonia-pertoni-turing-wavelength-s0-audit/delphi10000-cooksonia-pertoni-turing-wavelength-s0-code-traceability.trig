sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The module docstring states the PDE, the exact Jacobian, the predecessor and successor, and the claim boundary. Lean theorems are the cross-multiplied trace, determinant, and threshold inequalities, not renamed arithmetic. Deducted because the shell-power match that builds the GIF is a rendering calibration, not an equation in Turing 1952." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-code-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L1–L70" ;
        dct:description "docstring equations and claim boundary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8308af02867b4125a973e632c1b5c530ef0ddf71/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L1-L70> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-cooksonia-pertoni-turing-wavelength-s0.yaml L1–L55" ;
        dct:description "three laws tied to Lean declarations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8308af02867b4125a973e632c1b5c530ef0ddf71/morphoeval/math_kg_loops/delphi10000-cooksonia-pertoni-turing-wavelength-s0.yaml#L1-L55> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "D_v/D_u swept through {8, 9, 10, 12, 16, 24}. sigma_max moves -0.037, +0.006, +0.043, +0.102, +0.184, +0.282 and lambda_c moves 1.271, 1.307, 1.339, 1.396, 1.484, 1.617 µm, both monotonic, with ratio 8 below threshold and ratio 10 the focal point. a and b are not exposed as a CLI sweep." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L586–L598" ;
        dct:description "diffusion-ratio sweep and monotonic sigma_max / lambda" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8308af02867b4125a973e632c1b5c530ef0ddf71/models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py#L586-L598> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/cooksonia_pertoni_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "sweep panel — docs/media/cooksonia_pertoni_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py at 8308af02867b4125a973e632c1b5c530ef0ddf71, image/png, 624221 B, 1344×1008 px, artifact_sha256 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54 (sha256 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54), spec_fingerprint ce7d40be6d01f3179ec22b3cb8fbb558f6f40b6cad5c716ca069f671182a9ec4" .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — MorphoEval overall 85.8/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg kinetics at a=0.12, b=0.84, D_v/D_u=10, just above the Turing threshold. k_c=2.356, lambda_c=1.339 µm at 425 Ma. Equal diffusion (predecessor) has sigma_max=-0.086. A longer diffusion length for Rhynia gwynne-vaughanii at 407 Ma moves lambda_c to 1.695 µm. Dispersion Pearson r against the discrete Laplacian is 1.000 on six real-eigenvalue modes. The growth GIF is a Y-shaped axis on a matrix whose radial spectrum matches the Amgueddfa Cymru compression (CV similarity 95.4). The 1.3 µm field is the comparison-figure panel, not a feature resolved by the photograph. Overall 85.8/100 (faithfulness 85.1, reproducibility 87.3); rubric morphoeval 0.1.0; checkpoint commit 8308af02867b4125a973e632c1b5c530ef0ddf71; environment: . Dimension assessments: Model fidelity to source 86, Morphological realism / specimen match 82, Parameter expressivity 88, Morphometric validation 87, Source and data traceability 90, Code-to-model traceability 86, Reproducibility package 86. Output judged: docs/media/cooksonia_pertoni_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py at 8308af02867b4125a973e632c1b5c530ef0ddf71, image/png, 624221 B, 1344×1008 px, artifact_sha256 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54 (sha256 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54), spec_fingerprint ce7d40be6d01f3179ec22b3cb8fbb558f6f40b6cad5c716ca069f671182a9ec4. Dual provenance: spec_fingerprint: ce7d40be6d01f3179ec22b3cb8fbb558f6f40b6cad5c716ca069f671182a9ec4; artifact_sha256: 93e88f9e5d0b1916ed5ac99e152f066fa81e55e1cdb7c84aa9cb4d4df4141a54; input_dataset_sha256: {datasets/cooksonia_pertoni_turing_wavelength_s0/cooksonia_pertoni_amgueddfa_specimen.jpg=aa48bf1c9b50b41d..., datasets/cooksonia_pertoni_turing_wavelength_s0/cooksonia_pertoni_nmnh_specimen.jpg=6c6d03579c80de68..., datasets/cooksonia_pertoni_turing_wavelength_s0/cooksonia_pertoni_turing_wavelength_s0_reference.json=b36860960a26851c...}. Claim boundary: reported_in_source: Edwards, Davies & Axe 1992: C. pertoni has a vascular strand with annular to spiral tracheids. | Turing 1952 dispersion relation and Schnakenberg 1979 kinetics. | Edwards 2003: early tracheophyte walls are annular, spiral or scalariform-like.; reconstructed_in_script: Parameters chosen so the fastest mode is 1.339 µm. | Successor D_u raised from 0.055 to 0.088 at fixed ratio. | Isotomous axis drawn on a spectrum-matched matrix.; transfer_boundary: 1.3 µm is the assigned detail scale, not an Edwards measurement. | The museum slab is a centimetre-scale compression.; does_not_claim: That Cooksonia had animal-style ocelli. | That the photograph resolves 1.3 µm wall bands. | That the 73 µm sibling parameters apply at this scale.." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: {'id': 'R1', 'item': 'The GIF axis does not show helical Turing bands; shell-power matching removes them. Restore a visible axial modulation and re-measure CV similarity.'}",
            "remediation needed: {'id': 'R2', 'item': 'Branch-angle template uses 2.5 degree steps. Refine the sweep so the Amgueddfa and NMNH angles are not grid-snapped.'}",
            "remediation needed: {'id': 'R3', 'item': 'No independent second assessor. This pass is builder-scored.'}",
            "remediation needed: {'id': 'R4', 'item': 'No ~/.nanopub/profile.yml. Do not claim a signature.'}" ;
        pk:hasScore "0.858"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cooksonia pertoni Turing wavelength at 1.3 µm (425 Ma) — Morphometric validation: 87/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Discrete-Laplacian dispersion Pearson r = 1.000 (RMSE 1.4e-4) on modes 3-8. Specimen radial-spectrum Pearson r = 0.9865, RMSE 0.205, gray KS 0.028 against the Amgueddfa photograph. Model branch angle 64.4 degrees versus template 70.0 degrees on that photo and 67.5 degrees on the NMNH slab (values differ from their references). Stripe spacing of the saturated field is 1.339 µm. Successor wavelength 1.695 µm is longer than the focal wavelength. Deducted because the branch angle is a coarse template (2.5 degree steps), not a published morphometric, and the spacing CV is exactly 0 on a pure mode." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-control-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-predecessor-equal-diffusion-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-selected-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-axis-branch-angle>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-image-gray-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-radial-spectrum-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-radial-spectrum-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-stripe-spacing-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-successor-rhynia-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-turing-critical-wavenumber-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-control-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "control amplitude ratio = 241.627139 ratio" ;
        schema:measurementTechnique "std(u) of the Turing run divided by std(u) of the equal-diffusion ablation" ;
        schema:name "control amplitude ratio" ;
        schema:unitText "ratio" ;
        schema:value "241.627139" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-control-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-control-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "ablation: ratio 1 would mean the instability did nothing" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r = 1.0 correlation" ;
        schema:measurementTechnique "finite-difference growth of Fourier modes vs analytic sigma_+(k)" ;
        schema:name "dispersion Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "self-test gate" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.00014 1/time" ;
        schema:measurementTechnique "RMSE of measured vs analytic sigma across 6 real-eigenvalue circumferential modes" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.00014" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "linearised PDE check" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-predecessor-equal-diffusion-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor equal-diffusion sigma_max = -0.085937 1/time" ;
        dct:description "negative value is the pre-425 Ma absence of a selected band" ;
        schema:measurementTechnique "sigma_plus with D_u = D_v = 0.055 (pre-vascular control)" ;
        schema:name "predecessor equal-diffusion sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.085937" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-predecessor-equal-diffusion-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-predecessor-equal-diffusion-sigma-max-reference> a schema:PropertyValue ;
        dct:source "Turing threshold: equal diffusion must not be unstable" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-selected-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected wavelength = 1.339 µm" ;
        schema:measurementTechnique "2π/k_c times the length unit ξ = 1.339e-6 m / λ_dim" ;
        schema:name "selected wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.339" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-selected-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-selected-wavelength-reference> a schema:PropertyValue ;
        dct:source "assigned detail scale 1.3 µm (1.339e-6 m), tier 3_subcellular_um" ;
        schema:value "1.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-axis-branch-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen axis branch angle = 64.365399 degrees" ;
        dct:description "model geometry and ridge PCA are different estimators" ;
        schema:measurementTechnique "opening angle of the reconstructed isotomous axis" ;
        schema:name "specimen axis branch angle" ;
        schema:unitText "degrees" ;
        schema:value "64.365399" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-axis-branch-angle-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-axis-branch-angle-reference> a schema:PropertyValue ;
        dct:source "dark-ridge PCA on the Amgueddfa compression" ;
        schema:value "70.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-image-gray-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image gray KS statistic = 0.028266 KS distance" ;
        schema:measurementTechnique "two-sample KS between specimen and rendered gray values" ;
        schema:name "specimen image gray KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.028266" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-image-gray-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-image-gray-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "Amgueddfa Cymru Cooksonia pertoni photograph" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-radial-spectrum-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial spectrum Pearson r = 0.986514 correlation" ;
        dct:description "spectrum match of the rendered compression, not a µm-scale overlay" ;
        schema:measurementTechnique "22-bin log radial FFT of Amgueddfa crop vs growth-frame crop" ;
        schema:name "specimen radial spectrum Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.986514" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-radial-spectrum-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-radial-spectrum-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Amgueddfa Cymru Cooksonia pertoni photograph" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-radial-spectrum-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial spectrum RMSE = 0.204623 log power" ;
        schema:measurementTechnique "RMSE of the same 22-bin radial profiles" ;
        schema:name "specimen radial spectrum RMSE" ;
        schema:unitText "log power" ;
        schema:value "0.204623" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-radial-spectrum-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-specimen-radial-spectrum-rmse-reference> a schema:PropertyValue ;
        dct:source "Amgueddfa Cymru Cooksonia pertoni photograph" ;
        schema:value "0.15" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-stripe-spacing-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe spacing CV = 0.0 coefficient of variation" ;
        schema:measurementTechnique "CV of peak gaps along the circumferential mean of activator u" ;
        schema:name "stripe spacing CV" ;
        schema:unitText "coefficient of variation" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-stripe-spacing-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-stripe-spacing-cv-reference> a schema:PropertyValue ;
        dct:source "0.05 is a tracing tolerance for wall-band spacing, not the simulated CV" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-successor-rhynia-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "successor Rhynia wavelength = 1.695151 µm" ;
        dct:description "reference is the focal wavelength so the delta is visible; value is the successor" ;
        schema:measurementTechnique "same kinetics, D_u = 0.088, D_v/D_u = 10, same ξ as the 425 Ma calibration" ;
        schema:name "successor Rhynia wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.695151" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-successor-rhynia-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-successor-rhynia-wavelength-reference> a schema:PropertyValue ;
        dct:source "reconstruction vs C. pertoni focal wavelength; Rhynia age 407 Ma" ;
        schema:value "1.3389999999999997" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-turing-critical-wavenumber-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing critical wavenumber k_c = 2.356077 1/dimensionless length" ;
        dct:description "selected mode at 425 Ma; physical λ_c fixed at 1.339 µm" ;
        schema:measurementTechnique "argmax_k Re sigma_+(k) of Schnakenberg J - k^2 D at D_v/D_u = 10" ;
        schema:name "Turing critical wavenumber k_c" ;
        schema:unitText "1/dimensionless length" ;
        schema:value "2.356077" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-turing-critical-wavenumber-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-measurement-turing-critical-wavenumber-k-c-reference> a schema:PropertyValue ;
        dct:source "onset-neighbourhood expectation near k≈2.4 for this Jacobian; not the 73 µm slot" ;
        schema:value "2.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cooksonia-pertoni-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cooksonia-pertoni-turing-wavelength-s0.py L714–L844" ;

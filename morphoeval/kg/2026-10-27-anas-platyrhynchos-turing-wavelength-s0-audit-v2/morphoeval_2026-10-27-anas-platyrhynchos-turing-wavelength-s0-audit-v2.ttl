<https://w3id.org/delphi/resource/math-law/delphi10000-anas-platyrhynchos-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg steady state and negative trace" ;
    dct:description "Homogeneous state is stable to uniform perturbations at 0 Ma | Variables: a=0.10, b=0.90, f_u=0.80, g_v=-1" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/morphoeval/lean/loops/Loop_3110_anas_platyrhynchos_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u* = a + b, f_u + g_v < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rsif.2017.0407>,
        <https://doi.org/10.1098/rspb.2001.1896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion and Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3110.traceScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3110.trace_is_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-anas-platyrhynchos-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber k_c" ;
    dct:description "Critical wavenumber of the within-feather pigment stripe at 378.4 µm | Variables: r=Dv/Du=16, lambda_star=0.0003784 m" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/models/2026-delphi10000-anas-platyrhynchos-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/7f178d2f869f94ba7cd9d9e01aa00da67845de72/morphoeval/lean/loops/Loop_3110_anas_platyrhynchos_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv), lambda = 2 pi / k" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,

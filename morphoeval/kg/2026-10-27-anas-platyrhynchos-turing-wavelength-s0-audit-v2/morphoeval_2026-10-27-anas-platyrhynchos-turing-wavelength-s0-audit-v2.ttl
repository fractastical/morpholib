    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg within-feather Turing wavelength of Anas platyrhynchos at 378.4 µm (Pass 2) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pass 2 does not change the equations. The integrator, classical k_c, and k_star remain the Schnakenberg linearisation plus cubic saturation. The deduction is the same one as pass 1: this is the near-onset deviation system, and orientation is seeded by the rachis axis rather than selected by anisotropic diffusion." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg within-feather Turing wavelength of Anas platyrhynchos at 378.4 µm (Pass 2) — Morphometric validation: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Sweep Pearson r = 0.9926 against a reference of 1, RMSE = 0.0516 rad/cell against a reference of 0. Specimen foreground 0.835 versus pigment fraction 0.417, coherency 0.380 versus 1.000, circularity 0.174 versus 1. Those references are not copies of the measurements. lambda_c = 317.8 µm is not forced equal to lambda_star. Deducted because the 378.4 µm anchor is the slot scale, and bar-spacing CV landed on 0 for a phase-locked cosine mode." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;

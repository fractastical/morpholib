        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.3389/fcell.2020.00620> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion and Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3110.detScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3110.discriminant_above_onset" ;
    pk:leanVerified true .


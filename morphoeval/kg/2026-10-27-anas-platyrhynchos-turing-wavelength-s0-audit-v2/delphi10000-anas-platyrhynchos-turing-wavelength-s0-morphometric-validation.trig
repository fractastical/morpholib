sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg within-feather Turing wavelength of Anas platyrhynchos at 378.4 µm (Pass 2) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Sweep Pearson r = 0.9926 against a reference of 1, RMSE = 0.0516 rad/cell against a reference of 0. Specimen foreground 0.835 versus pigment fraction 0.417, coherency 0.380 versus 1.000, circularity 0.174 versus 1. Those references are not copies of the measurements. lambda_c = 317.8 µm is not forced equal to lambda_star. Deducted because the 378.4 µm anchor is the slot scale, and bar-spacing CV landed on 0 for a phase-locked cosine mode." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-classical-turing-wavenumber-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-diffusion-sweep-pearson-r-of-measured-versus-analytical-k-star>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-diffusion-sweep-rmse-between-measured-and-analytical-k-star>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-equal-diffusion-amplitude-suppression-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-kolmogorov-smirnov-luminance-statistic-specimen-versus-composite>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-reaction-off-ablation-end-over-start-amplitude>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-selected-wavelength-lambda-star>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-stripe-versus-ocellus-orientation-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-within-feather-bar-spacing-coefficient-of-variation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-classical-turing-wavenumber-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "classical Turing wavenumber k_c = 0.623394 rad/cell" ;
        dct:description "lambda_c = 317.824 µm versus lambda_star = 378.341 µm" ;
        schema:measurementTechnique "k_c^2 = (Dv f_u + Du g_v) / (2 Du Dv) at r=16 after Du is scaled to the 378.4 µm anchor" ;
        schema:name "classical Turing wavenumber k_c" ;
        schema:unitText "rad/cell" ;
        schema:value "0.623394" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-classical-turing-wavenumber-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-classical-turing-wavenumber-k-c-reference> a schema:PropertyValue ;
        schema:value "0.523681" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-diffusion-sweep-pearson-r-of-measured-versus-analytical-k-star> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusion-sweep Pearson r of measured versus analytical k_star = 0.9926 correlation" ;
        dct:description "RMSE in wavenumber = 0.0516; steps = 1500; grid = 64" ;
        schema:measurementTechnique "noise-seeded PDE radial-FFT peak versus argmax sigma(k) across six Du values at r=16" ;
        schema:name "diffusion-sweep Pearson r of measured versus analytical k_star" ;
        schema:unitText "correlation" ;
        schema:value "0.9926" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-diffusion-sweep-pearson-r-of-measured-versus-analytical-k-star-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-diffusion-sweep-pearson-r-of-measured-versus-analytical-k-star-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-diffusion-sweep-rmse-between-measured-and-analytical-k-star> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusion-sweep RMSE between measured and analytical k_star = 0.05158 rad/cell" ;
        schema:measurementTechnique "sqrt mean square error of the six-point Du sweep" ;
        schema:name "diffusion-sweep RMSE between measured and analytical k_star" ;
        schema:unitText "rad/cell" ;
        schema:value "0.05158" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-diffusion-sweep-rmse-between-measured-and-analytical-k-star-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-diffusion-sweep-rmse-between-measured-and-analytical-k-star-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-equal-diffusion-amplitude-suppression-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion amplitude suppression ratio = 0.0 std_equal / std_nominal" ;
        dct:description "analytical sigma_max at equal diffusion = -0.1015" ;
        schema:measurementTechnique "same axial seed integrated at Dv = Du versus Dv = r Du" ;
        schema:name "equal-diffusion amplitude suppression ratio" ;
        schema:unitText "std_equal / std_nominal" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-equal-diffusion-amplitude-suppression-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-equal-diffusion-amplitude-suppression-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anas-platyrhynchos-turing-wavelength-s0-measurement-kolmogorov-smirnov-luminance-statistic-specimen-versus-composite> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Kolmogorov-Smirnov luminance statistic, specimen versus composite = 0.1361 KS D" ;
        dct:description "p = 1.32e-65" ;
        schema:measurementTechnique "two-sample KS on subsampled grayscale of the photograph and the pass-2 last frame" ;

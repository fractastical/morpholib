sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O), FGF10-SHH-Ptch1 Turing mode selection, pleura-confined diffuse-domain FGF10 cavity and stochastic postnatal septation — Morphological realism / specimen match: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The segmentation pipeline (chromatic tissue separation, EDT caliber map, Zhang-Suen skeleton, N = 32 three-arm junctions, mean angle 76.49 +/- 14.61 deg, caliber ratio 0.8826, L1197-1346) runs unchanged and the figure now carries 8 panels with Panel G (cavity field, pleura contour, candidate tips, position-sweep inset) and Panel H (log-scale tips/alveoli timecourse with ensemble band, control and target lines, phase shading) rendered from the new modules (L1567-1657). Deductions: `bronchial_tree_specimen.jpg` is a Wikimedia medical illustration of human bronchioles and alveoli, not a mouse E11-E15 lung, so the junction-angle comparison is a drawing-vs-model match and cannot validate the Metzger grammar (-8; this was present in Pass 2 but not scored); the Pass 3 morphologies (lens cross-section, septated terminal units) are compared with no image of a mouse lobe section or alveolar histology (-5); Panel G's legend overlaps the lens and its inset covers the upper-right cavity (-2); the emergent P/O choice per lineage uses a single isolated tip (L841-844) while the flatness comparison uses the full policy tree, and the two predictors can disagree for mid-lobe positions (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2008-metzger-lung-stereotyped-branching.py L1874–L1891: Junction-angle and caliber measurements derive from Wikimedia File:Bronchial_anatomy.jpg, a human medical illustration, not a mouse specimen <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1874-L1891>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L1237–L1346" ;
        dcterms:description "segment_bronchial_tree_specimen: chromatic segmentation, skeletonisation and N = 32 junction extraction on the SHA-256-pinned image" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1237-L1346> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L1567–L1657" ;
        dcterms:description "Panel G (pleura-confined cavity and emergent switch) and Panel H (stochastic septation timecourse) added to the 2x4 figure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1567-L1657> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/lung_stereotyped_branching_modes_comparison.png (generated output)" ;
        dcterms:description "8-panel figure: A-F unchanged, G cavity field + position sweep inset, H septation timecourse; legend/inset overlap in G — docs/media/lung_stereotyped_branching_modes_comparison.png: rendered output of 2008-metzger-lung-stereotyped-branching.py at 028758bc, image/png, 760057 B, 2950×1350 px, artifact_sha256 39a638e50c464718f55cb5a04c00c6dbe57169032a3a3896d1e76a6400bec3d4 (sha256 39a638e50c464718f55cb5a04c00c6dbe57169032a3a3896d1e76a6400bec3d4), spec_fingerprint d02b0c3844bcaa108ea9ec4bb8fce374a8da22fe6801db1a8256bba00a9e901f" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 053 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


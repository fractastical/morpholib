sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-source-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L145–L167" ;
        dcterms:description "verify_dataset_integrity: runtime SHA-256 verification of the specimen (pinned at L93-95) and JSON load" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L145-L167> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L1–L26" ;
        dcterms:description "Header docstring listing all 7 sources with DOIs; L26 states DOIs 5-7 were cited from memory and must be verified" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1-L26> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/lung_stereotyped_branching_modes/lung_stereotyped_branching_modes_reference.json L274–L307" ;
        dcterms:description "pleura_confinement_reference (position assigned from lineage class, convention 0.5) and postnatal_alveolarization_reference blocks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/lung_stereotyped_branching_modes/lung_stereotyped_branching_modes_reference.json#L274-L307> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/lung_stereotyped_branching_modes/paper_citations.bib L47–L81" ;
        dcterms:description "li2009diffuse, mund2008developmental, knust2009stereological entries with `DOI cited from memory, unverified offline` notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/lung_stereotyped_branching_modes/paper_citations.bib#L47-L81> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O), FGF10-SHH-Ptch1 Turing mode selection, pleura-confined diffuse-domain FGF10 cavity and stochastic postnatal septation — Source and data traceability: 89/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The dataset directory keeps the SHA-256-pinned specimen and JSON (runtime check `verify_dataset_integrity`, L145-167), and the JSON (307 lines, dataset_id -v2) now carries three additional sources, a `lobe_cross_section_position_norm` per lineage row, a `pleura_confinement_reference` block that states plainly that the position is ASSIGNED from the Metzger lineage class and that the paper gives no quantitative pleural distance (L274-287), and a `postnatal_alveolarization_reference` block (L288-307); `paper_citations.bib` gains three entries (L47-81) and the README is updated. The header docstring lists all 7 sources with DOIs (L1-26). Deductions: the three new DOIs (Li 2009, Mund 2008, Knust 2009) were cited offline from memory and are flagged `unverified` in the JSON (L29-42), bib and docstring (L26) — they could not be checked in this audit either (-4); the `empirical_mouse_lung_lineage_benchmarks` and `developmental_timecourse_e11_to_e15` tables (L110-273) still have no per-row figure/table provenance and their hull-flatness values look synthetic (-4); Yule (1925) is cited in a measurement source without DOI (L1806) and `margin_position_norm_min = 0.5` (L277) is a convention presented alongside paper-derived values (-2); the specimen's Wikimedia provenance is correct but the image is not of the organism studied (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/lung_stereotyped_branching_modes/lung_stereotyped_branching_modes_reference.json L110–L273: Lineage benchmark and E11-E15 timecourse tables without per-row figure/table provenance <https://github.com/fractastical/morpholib/blob/028758bc/datasets/lung_stereotyped_branching_modes/lung_stereotyped_branching_modes_reference.json#L110-L273>",
            "datasets/lung_stereotyped_branching_modes/lung_stereotyped_branching_modes_reference.json L27–L42: Three new sources each carrying `verification: cited offline from memory in Pass 3; DOI unverified` <https://github.com/fractastical/morpholib/blob/028758bc/datasets/lung_stereotyped_branching_modes/lung_stereotyped_branching_modes_reference.json#L27-L42>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-source-traceability-4> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 053 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O), FGF10-SHH-Ptch1 Turing mode selection, pleura-confined diffuse-domain FGF10 cavity and stochastic postnatal septation — Code-to-model traceability: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-66) maps every section to its source and to the five Lean laws, and names the honest reduction of each Pass 3 item; section banners for 3b and 4b (L612-636, L1046-1065) carry the model equations; every new function has a docstring citing the equation or phase it implements; the math KG loop file (115 lines) registers Laws 4-5 with Lean theorem names, Lean code excerpts and Python code loci, and the loci of Laws 1-3 were refreshed to the new line numbers. Deductions: the self_test docstring (L1897-1906) still describes the Pass 2 7-item list and omits blocks 7-8 (-2); the tuned-constant comment on L117 points to an external handoff note rather than stating the sensitivity in the code (-2); the `--self-test` help string still says 'Pass 2' (L2009) (-1); the measurement for the transition position attributes the 0.5 bound to Metzger Fig. 3 in its `reference_source` string before admitting it is assigned (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2008-metzger-lung-stereotyped-branching.py L1896–L1906: self_test docstring still lists the Pass 2 seven items; blocks 7-8 undocumented in the docstring <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1896-L1906>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L27–L66" ;
        dcterms:description "Pass 3 remediation summary and Laws 1-5 cross-referenced to the Lean file" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L27-L66> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L612–L636" ;
        dcterms:description "Section 3b banner: diffuse-domain FGF10 cavity model statement with its reduction disclosed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L612-L636> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L1046–L1065" ;
        dcterms:description "Section 4b banner: stochastic septation model and phase definitions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1046-L1065> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/metzger-lung-stereotyped-branching.yaml L1–L115" ;
        dcterms:description "Math KG loop registration: 5 equations with Lean theorem names (L33, L49, L65, L82, L98), Lean code and Python loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/math_kg_loops/metzger-lung-stereotyped-branching.yaml#L1-L115> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 053 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

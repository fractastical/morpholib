sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O), FGF10-SHH-Ptch1 Turing mode selection, pleura-confined diffuse-domain FGF10 cavity and stochastic postnatal septation — Parameter expressivity: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Pass 2's dihedral sweep, mode-sequence comparison and equal-diffusion control remain (L385-442, L521-611). Pass 3 adds two genuine mechanistic sweeps: the subtree root across the lobe cross-section x0/L_x in [0, 0.9] with emergent dihedral, tree isotropy and anisotropy reported (margin-interior transition x*/L_x = 0.54; L880-925), and the lobe half-thickness with a critical h* = 0.944 l0 and monotone anisotropy (L928-963); plus a far-tip FGF10 ablation and the deterministic no-septation control (L1175-1191). Four new CLI flags (`--pleura-half-thickness`, `--anisotropy-threshold`, `--septation-seeds`, `--septation-cont-fraction`, L2017-2023) are wired through `render_outputs` (L2033-2047). Deductions: `--seed` (L2024) is parsed but never passed to `render_outputs`, so the RANDOM trees always use the hard-coded 2008 seed (-4); the anisotropy threshold and tip gain are swept only implicitly through the position sweep, and no sweep shows how x* moves with A_c or h_mid even though the handoff documents that it is sensitive to them (-4); the septation continued/bulk ratio is a CLI input, not a swept or fitted quantity (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2008-metzger-lung-stereotyped-branching.py L2033–L2047: render_outputs call: pleura and septation flags forwarded, args.seed not forwarded (dead flag) <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L2033-L2047>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L880–L963" ;
        dct:description "run_pleura_position_sweep (11 root positions) and run_pleura_thickness_sweep (critical h*)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L880-L963> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L1175–L1191" ;
        dct:description "run_septation_module: projection + closed-form calibration + ensemble + deterministic no-septation control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1175-L1191> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L2009–L2026" ;
        dct:description "CLI flags including the four Pass 3 flags; --seed on L2024 is parsed but unused" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L2009-L2026> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Loop 053 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O), FGF10-SHH-Ptch1 Turing mode selection, pleura-confined diffuse-domain FGF10 cavity and stochastic postnatal septation — Morphometric validation: 87/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` reports 13 entries (L1739-1893): the 8 Pass 2 metrics plus the slab-check relative error 0.0261 (ref 0), the P/O transition position 0.54 (ref 0.5 convention), the emergent dihedral RMSE 3.13 deg (ref 0; 8/8 mode accuracy; non-circular, the observed dihedral is never fed back), the ensemble P36 alveolar count 2.32e6 (ref 2.3e6, explicitly labelled a calibration target) and the per-unit CV 0.9978 (ref 0.9999, Yule law). The lineage validation now grows each tree with the pleura policy instead of the observed dihedral (L969-1044), which closes the Pass 2 circularity. Deductions: the E11-E14.5 tip-count r = 1.0000 is self-referential because the benchmark event counts reproduce 2 + sum(D + P + O) exactly (`pred_tips`, L1004-1011) (-4); the `reference_value`s 0.481834 (isotropy contrast, L1838) and 1.4172 (lambda_T, L1848) are the model's own outputs recorded as references, unchanged since Pass 2 (-3); the adult alveolar count is fitted with 1 dof, so only the CVs, control, plateau and bulk/continued partition are tests and no per-age Mund (2008) count is compared (-3); the lung-level CV (0.028 vs 0.040 law) rests on 12 seeds and the self-test only bounds it below 0.1 (-1); the transition position reference 0.5 is a convention written into the dataset JSON, not a measured value (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2008-metzger-lung-stereotyped-branching.py L1004–L1011: pred_tips = 2 + cumulative D+P+O events from the benchmark table whose event counts were back-filled to match, giving r = 1.0000 <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1004-L1011>",
            "2008-metzger-lung-stereotyped-branching.py L1834–L1852: reference_value 0.481834 (L1838) and 1.4172 (L1848) are the script's own outputs, not literature values <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1834-L1852>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-compound-lobar-scaffold-d-4-o-o-active-distal-tip-count-4m-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-diffuse-domain-fgf10-solver-relative-error-vs-closed-form-slab-profile-eps-0-025>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-emergent-pleura-confined-dihedral-rmse-vs-8-e12-5-e14-5-lineages>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e11-0-e14-5-developmental-distal-tip-count-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e12-5-e14-5-mouse-lung-dihedral-angle-rmse-8-lineages>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-fgf10-shh-ptch1-turing-critical-wavelength-lambda-t>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-optimal-dihedral-rotation-angle-delta-phi-maximizing-3d-inter-tip-clearance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-vs-orthogonal-transverse-3d-tip-isotropy-contrast-sigma-y-sigma-x>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-pleura-confined-margin-to-interior-p-o-transition-position-x-l-x>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-bronchial-daughter-to-parent-lumen-caliber-ratio-r-d-r-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-mammalian-bronchial-tree-specimen-junction-angle-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-septation-per-terminal-unit-alveolar-count-coefficient-of-variation-at-p36>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-stochastic-septation-adult-alveolar-count-at-p36-ensemble-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation-3> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-compound-lobar-scaffold-d-4-o-o-active-distal-tip-count-4m-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "compound lobar scaffold D_4 -> O -> O active distal tip count (4m + 1) = 17.0 tips" ;
        dct:description "bifurcated lateral tips = 16 (4*m = 16) plus 1 trunk apex = 17" ;
        schema:measurementTechnique "m=4 lateral domain branches x 2^2 orthogonal bifurcations + 1 continuing main trunk tip (Lean 4 theorem metzger_subroutine_tip_multiplicity)" ;
        schema:name "compound lobar scaffold D_4 -> O -> O active distal tip count (4m + 1)" ;
        schema:unitText "tips" ;
        schema:value "17.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-compound-lobar-scaffold-d-4-o-o-active-distal-tip-count-4m-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-compound-lobar-scaffold-d-4-o-o-active-distal-tip-count-4m-1-reference> a schema:PropertyValue ;
        dct:source "Metzger, Klein, Martin & Krasnow (2008) Nature 453:745-750 Figs. 2-4" ;
        schema:value "17.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-diffuse-domain-fgf10-solver-relative-error-vs-closed-form-slab-profile-eps-0-025> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffuse-domain FGF10 solver relative error vs closed-form slab profile (eps = 0.025) = 0.0261 ratio" ;
        dct:description "relative error 0.1065 (eps=0.1) -> 0.0561 (eps=0.05) -> 0.0261 (eps=0.025); monotone convergence = True; decay length l = 0.500" ;
        schema:measurementTechnique "RMSE / max of the pleura-confined diffuse-domain steady state against F(y) = a_F (1 - cosh(y/l)/cosh(h/l)) with Dirichlet F = 0 at the pleura; interface width eps halved 0.1 -> 0.05 -> 0.025" ;
        schema:name "diffuse-domain FGF10 solver relative error vs closed-form slab profile (eps = 0.025)" ;
        schema:unitText "ratio" ;
        schema:value "0.0261" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-diffuse-domain-fgf10-solver-relative-error-vs-closed-form-slab-profile-eps-0-025-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-diffuse-domain-fgf10-solver-relative-error-vs-closed-form-slab-profile-eps-0-025-reference> a schema:PropertyValue ;
        dct:source "Li, Lowengrub, Raetz & Voigt (2009) Commun. Math. Sci. 7:81-107 (first-order convergence of the diffuse-domain method); closed form derived from Menshykau et al. (2012) ligand equation" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-emergent-pleura-confined-dihedral-rmse-vs-8-e12-5-e14-5-lineages> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "emergent (pleura-confined) dihedral RMSE vs 8 E12.5-E14.5 lineages = 3.1313 deg" ;
        dct:description "mode accuracy 1.000; emergent-tree transverse isotropy vs observed hull flatness: Pearson r = 0.9964, RMSE = 0.1945 (Pass 2 value was circular: it used dihedral_obs_deg as input)" ;
        schema:measurementTechnique "single-tip pleura-confined FGF10 decision at each lineage's lobe cross-section position (margin 0.90 / interior 0.15, assigned by Metzger lineage class) vs observed dihedral; no observed dihedral is fed back into the model" ;
        schema:name "emergent (pleura-confined) dihedral RMSE vs 8 E12.5-E14.5 lineages" ;
        schema:unitText "deg" ;
        schema:value "3.1313" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-emergent-pleura-confined-dihedral-rmse-vs-8-e12-5-e14-5-lineages-reference> .

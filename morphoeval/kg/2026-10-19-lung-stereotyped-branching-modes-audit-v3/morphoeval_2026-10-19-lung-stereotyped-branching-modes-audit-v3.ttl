<https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-3> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Menshykau et al. (2012, 2014) FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    dct:description "Biochemical Turing instability that selects between apical tip splitting (Planar/Orthogonal bifurcation at low elongation speed v_g < v_crit) and periodic lateral budding (Domain branching at high elongation speed v_g > v_crit) | Variables: R: epithelial Ptch1/SHH receptor complex concentration; F: mesenchymal FGF10 ligand concentration; D_R, D_F: diffusion coefficients (D_F/D_R = 50); a_R, a_F: basal production rates; μ_R: receptor removal rate" ;
    dct:source "Menshykau, Kraemer & Iber (2012) Development 139:4506-4514; Menshykau et al. (2014) PLoS Comput. Biol. 10(2):e1003421 Eqs. (1)-(5)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L448-L610>,
        <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L97-L120> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def receptor_reaction (a_R mu_R_R r2_F : Int) : Int := a_R - mu_R_R + r2_F
def ligand_reaction (a_F r2_F : Int) : Int := a_F - r2_F
theorem menshykau_fgf10_shh_receptor_ligand_steady_state (a_R a_F mu_R_R r2_F : Int) :
    receptor_reaction a_R mu_R_R r2_F + ligand_reaction a_F r2_F = a_R + a_F - mu_R_R ∧
    receptor_reaction a_R (a_R + a_F) a_F = 0 ∧
    ligand_reaction a_F a_F = 0 := by
  simp [receptor_reaction, ligand_reaction]; omega
"""^^pk1:lean4 ;
    skos:notation "∂_t R = D_R ∇^2 R + γ(a_R - μ_R R + R^2 F),   ∂_t F = D_F ∇^2 F + γ(a_F - R^2 F),   (R^*, F^*) = ((a_R+a_F)/μ_R, a_F/(R^*)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/ar.20747>,
        <https://doi.org/10.1002/dvdy.21633>,
        <https://doi.org/10.1038/nature07005>,
        <https://doi.org/10.1242/dev.081679>,
        <https://doi.org/10.1371/journal.pcbi.1003421>,
        <https://doi.org/10.1371/journal.pone.0041643>,
        <https://doi.org/10.4310/CMS.2009.v7.n1.a4> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    pk1:leanDeclaration "MathOfBiology.Loop_053.receptor_reaction" ;
    pk1:leanTheorem "MathOfBiology.Loop_053.menshykau_fgf10_shh_receptor_ligand_steady_state" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-4> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Pleura-Confined Diffuse-Domain FGF10 Supply Anisotropy Mode Selection (Pass 3)" ;
    dct:description "Couples the Menshykau FGF10 ligand equation to a pleura-bounded mesenchymal cavity so that the Metzger P/O choice is emergent: tips near the thin lobe margin see FGF10 depletion out of plane and flatten to Planar, interior tips remain Orthogonal (margin-interior transition x*/L_x = 0.54, critical half-thickness h* = 0.94 l0); reduced 2D cross-section model with a dilating cavity (no full 3D moving-boundary FEM); solver verified against the exact 1D slab profile with first-order convergence in ε | Variables: ψ: mesenchymal phase field (1 inside the pleura, 0 outside); F: FGF10 ligand; R(x): Ptch1 receptor density (background 1, Gaussian tip sink gain 2); L_x, h: lobe cross-section half-width / half-thickness; ε: interface width; F_P, F_O: mean ψF supply at the planar / orthogonal candidate daughter tips; A_c = 0.05: anisotropy threshold (orthogonal prior)" ;
    dct:source "Li, Lowengrub, Rätz & Voigt (2009) Commun. Math. Sci. 7(1):81-107 (diffuse-domain method); Menshykau et al. (2014) PLoS Comput. Biol. 10(2):e1003421 (geometry-signalling interplay); Metzger et al. (2008) Nature 453:745-750 Fig. 3 (planar margins vs orthogonal interiors)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L612-L963>,
        <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L121-L155> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def pleura_mode_select (fP fO c : Int) : Int := if fP > fO + c then 0 else 90
theorem pleura_anisotropy_mode_selection (fP fO c : Int) :
    (pleura_mode_select fP fO c = 0 ∨ pleura_mode_select fP fO c = 90) ∧
    (0 ≤ c → pleura_mode_select fP fP c = 90) ∧
    (fP > c → pleura_mode_select fP 0 c = 0) := by
  refine ⟨?_, ?_, ?_⟩ <;> (unfold pleura_mode_select; first | (split <;> simp) | (intro _; split <;> first | rfl | omega))
"""^^pk1:lean4 ;
    skos:notation "∂_t F = D_F ∇·(ψ ∇F) + ψ γ_m (a_F − R(x)^2 F) − (1 − ψ) F / τ,  τ = ε^2 / D_F,  ψ = ½(1 − tanh((ρ − 1)/ε)),  ρ^2 = (x/L_x)^2 + (y/h)^2;   A = (F_P − F_O)/(F_P + F_O);   Δφ = 0° if A > A_c else 90°" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/ar.20747>,
        <https://doi.org/10.1002/dvdy.21633>,
        <https://doi.org/10.1038/nature07005>,
        <https://doi.org/10.1242/dev.081679>,
        <https://doi.org/10.1371/journal.pcbi.1003421>,
        <https://doi.org/10.1371/journal.pone.0041643>,
        <https://doi.org/10.4310/CMS.2009.v7.n1.a4> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    pk1:leanDeclaration "MathOfBiology.Loop_053.pleura_mode_select" ;
    pk1:leanTheorem "MathOfBiology.Loop_053.pleura_anisotropy_mode_selection" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/metzger-lung-stereotyped-branching-5> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Mean-Field Saccular-to-Alveolar Septation Closed Form & Stochastic Yule Septation (Pass 3)" ;
    dct:description "Extends the deterministic E11-E16.5 D/P/O grammar with stochastic postnatal secondary septation; the deterministic grammar alone freezes at 632 units (control), the Yule ensemble reaches 2.3e6 alveoli at P36 with per-unit CV ≈ 1 and whole-lung CV ≈ 0.03-0.04 | Variables: n_0 / N_units: terminal units at the end of branching (E16.5, grammar extrapolated: 632); μ: mean offspring per septation round (2); k: septation rounds (11.8 fitted); λ_b, λ_c: bulk (P4-P21) and continued (P14-P36) septation hazards (λ_b = 0.417/d fitted in closed form to the Knust 2009 adult count, λ_c = 0.12 λ_b); m: alveoli per terminal unit at P36" ;
    dct:source "Mund, Stampanoni & Schittny (2008) Dev. Dyn. 237(8):2108-2116 (bulk/continued alveolarisation phases); Knust, Ochs, Gundersen & Nyengaard (2009) Anat. Rec. 292(1):113-122 (adult mouse alveolar number); Yule (1925) Phil. Trans. R. Soc. B 213:21-87 (pure-birth process)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/028758bc/2008-metzger-lung-stereotyped-branching.py#L1046-L1191>,
        <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L158-L188> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def septation_mean (n0 mu : Nat) : Nat → Nat
  | 0 => n0
  | k + 1 => mu * septation_mean n0 mu k
theorem septation_mean_closed_form (n0 mu k m : Nat) :
    septation_mean n0 mu k = n0 * mu ^ k ∧
    septation_mean (domain_composite_tips m) 2 k = (4 * m + 1) * 2 ^ k := by
  have h : ∀ (a b j : Nat), septation_mean a b j = a * b ^ j := by
    intro a b j; induction j with
    | zero => simp [septation_mean]
    | succ j ih => simp [septation_mean, ih, Nat.pow_succ]; rw [Nat.mul_comm b, Nat.mul_assoc]
  refine ⟨h n0 mu k, ?_⟩; rw [h, (metzger_subroutine_tip_multiplicity 0 m).2]
"""^^pk1:lean4 ;
    skos:notation "N_{k+1} = μ N_k, N_0 = n_0  ⟹  N_k = n_0 μ^k;   continuous form N(t) = N_units exp(∫ λ(s) ds),  λ(t) = λ_b 1[P4 ≤ t < P21] + λ_c 1[P14 ≤ t < P36];   Yule jump law: n → n + NegBin(n, e^{−λΔt});   per-unit CV → sqrt(1 − 1/m), whole-lung CV ≈ 1/sqrt(N_units)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/ar.20747>,
        <https://doi.org/10.1002/dvdy.21633>,
        <https://doi.org/10.1038/nature07005>,
        <https://doi.org/10.1242/dev.081679>,
        <https://doi.org/10.1371/journal.pcbi.1003421>,
        <https://doi.org/10.1371/journal.pone.0041643>,
        <https://doi.org/10.4310/CMS.2009.v7.n1.a4> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Stereotyped Branching Subroutine Grammar (D, P, O) & FGF10-SHH-Ptch1 Receptor-Ligand Turing Switch" ;
    pk1:leanDeclaration "MathOfBiology.Loop_053.septation_mean" ;
    pk1:leanTheorem "MathOfBiology.Loop_053.septation_mean_closed_form" ;
    pk1:leanVerified true .


}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-025> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-025-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-025 — radiolarian geodesic spherical lattices — MorphoEval overall 72.5/100" ;
        dct:date "2026-10-31"^^xsd:date ;
        dct:description "Pass 2: freq sweep 0-3, skeleton edge extraction on Challenger crop, histogram Pearson r≈0.64, ablation random-chord CV 1.11, mixed verdict (specimen edge CV 0.375 vs model 0.179). Overall 72.5/100 (faithfulness 70.7, reproducibility 76.7); rubric morphoeval 0.1.0; checkpoint commit 35d30f4cf; environment: . Dimension assessments: Model fidelity to source 74, Morphological realism / specimen match 68, Parameter expressivity 72, Morphometric validation 70, Source and data traceability 82, Code-to-model traceability 71, Reproducibility package 76. Output judged: docs/media/t1917_025_spicules_geodetics_comparison.png: rendered output of thompson/claims/t1917-025_spicules-geodetics.py, not present when the audit was snapshotted (unfingerprinted). Supersedes audit: 2026-10-31-t1917-025-spicules-geodetics-audit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.725"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Cloud Loop Slot 220 Pass 2)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {

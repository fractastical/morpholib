<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> a skos:Concept,
        pk:Concept ;
    rdfs:label "Code-to-model traceability" ;
    dct:description "[reproducibility, weight 8/100, id morphoeval/0.1.0/code-traceability] Can each modelling step in the code be traced to a specific equation, section or figure of the source?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> a skos:Concept,
        pk:Concept ;
    rdfs:label "Model fidelity to source" ;
    dct:description "[faithfulness, weight 20/100, id morphoeval/0.1.0/model-fidelity] Does the code implement the equations / algorithm of the cited source model as published (not a loose analogue), with parameters defined the way the source defines them?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> a skos:Concept,
        pk:Concept ;
    rdfs:label "Morphometric validation" ;
    dct:description "[faithfulness, weight 15/100, id morphoeval/0.1.0/morphometric-validation] Are quantitative morphometrics computed on the output and compared against values measured on real specimens or reported in the literature?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> a skos:Concept,
        pk:Concept ;
    rdfs:label "Parameter expressivity" ;
    dct:description "[faithfulness, weight 10/100, id morphoeval/0.1.0/parameter-expressivity] Does each morphospace parameter visibly and monotonically control the feature of form it is supposed to control across its stated range?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> a skos:Concept,
        pk:Concept ;
    rdfs:label "Reproducibility package" ;
    dct:description "[reproducibility, weight 12/100, id morphoeval/0.1.0/repro-package] Pinned dependencies, deterministic seeds, documented invocation, and a known-good environment; environment-induced result corruption counts against this dimension." ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> a skos:Concept,
        pk:Concept ;
    rdfs:label "Source and data traceability" ;
    dct:description "[reproducibility, weight 10/100, id morphoeval/0.1.0/source-traceability] Are the source paper (DOI/PMID), code repository and any input data resolvable identifiers, and is input provenance recorded?" ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> a skos:Concept,
        pk:Concept ;
    rdfs:label "Morphological realism / specimen match" ;
    dct:description "[faithfulness, weight 25/100, id morphoeval/0.1.0/specimen-match] Does the rendered output resemble real specimens of the organism and/or the source authors' own figures, judged side by side? Distinct morphologies must be visually distinct." ;
    skos:broader <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Great-circle geodesic length (chordal defect form)" ;
    dct:description "Defines geodesic edge length used in radiolarian lattice morphometrics | Variables: p,q unit directions on S^2; R sphere radius" ;
    dct:source "Thompson (1917) Ch. IX-X; do Carmo (1992) Riemannian Geometry" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_025.lean#L24-L58>,
        <https://github.com/fractastical/morpholib/blob/35d30f4cf/thompson/claims/t1917-025_spicules-geodetics.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L_g = R arccos(p·q);  defect = 1 - p·q on unit sphere" ;
    pk:hypothesisType "geometric — geodesic/minimal frameworks on a sphere (Thompson 1917 Ch. IX-X claim T1917-025)" ;
    pk:leanDeclaration "MathOfBiology.Loop_220.chordal_defect" ;
    pk:leanTheorem "MathOfBiology.Loop_220.unit_chord_sq" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal azimuthal partition sum" ;
    dct:description "Near-equal partition baseline for Thompson's equal cell sizes | Variables: n partition count; L equal arc length" ;
    dct:source "Thompson (1917) near-equal partitions on spherical lattices" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_025.lean#L36-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sum_{i=1}^n L_i = n L when all L_i equal" ;
    pk:hypothesisType "geometric — geodesic/minimal frameworks on a sphere (Thompson 1917 Ch. IX-X claim T1917-025)" ;
    pk:leanTheorem "MathOfBiology.Loop_220.equal_partition_sum" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Geodesic chord algebra (triangle inequality basis)" ;
    dct:description "Algebraic basis for geodesic minimality / triangle inequality on the sphere | Variables: p,q unit vectors in R^3" ;
    dct:source "Coxeter (1973) Regular Polytopes; spherical geometry" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_025.lean#L44-L58> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "||p-q||^2 = 2 - 2 p·q for unit p,q" ;
    pk:hypothesisType "geometric — geodesic/minimal frameworks on a sphere (Thompson 1917 Ch. IX-X claim T1917-025)" ;
    pk:leanTheorem "MathOfBiology.Loop_220.sqnorm_diff_expand" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Refinement monotonicity (edge-count model)" ;
    dct:description "Refinement frequency increases combinatorial complexity of the reference net | Variables: f subdivision frequency" ;
    dct:source "Fuller (1954) geodesic domes; icosahedral refinement" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/35d30f4cf/morphoeval/lean/loops/Thompson1917_T1917_025.lean#L68-L76> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "E(f) = 30 f^2 non-decreasing in f" ;
    pk:hypothesisType "geometric — geodesic/minimal frameworks on a sphere (Thompson 1917 Ch. IX-X claim T1917-025)" ;
    pk:leanTheorem "MathOfBiology.Loop_220.edge_count_monotone" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-3>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-025-4> .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


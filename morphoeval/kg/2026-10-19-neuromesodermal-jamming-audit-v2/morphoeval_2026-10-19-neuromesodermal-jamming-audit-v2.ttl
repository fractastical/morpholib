<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/tailbud-neuromesodermal-jamming-1>,
        <https://w3id.org/probknow/resource/math-law/tailbud-neuromesodermal-jamming-2>,
        <https://w3id.org/probknow/resource/math-law/tailbud-neuromesodermal-jamming-3> .

<https://w3id.org/probknow/resource/math-law/tailbud-neuromesodermal-jamming-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Extracellular Space Compaction & Rigidity-Percolation Supracellular Yield Stress Law" ;
    dct:description "Establishes how posterior-to-anterior compaction of extracellular spaces drives cell packing across the rigidity-percolation threshold phi_c = 0.860, generating a 10-fold anterior surge in tissue yield stress | Variables: phi_ECS(x): extracellular space volume fraction (0.145 in MPZ -> 0.049 in A-PSM); phi_pack(x) = 1 - phi_ECS(x): cell packing fraction; phi_c approx 0.860: Maxwell isostatic rigidity-percolation threshold; sigma_y(x): ferrofluid-measured supracellular yield stress (Pa)" ;
    dct:source "Mongera et al. (2018) Nature 561(7723):401-405 Figs. 1-3; Kim et al. (2021) Nature Physics 17(7):859-866 Eqs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L90-L175>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L20-L72> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def cell_packing_milli (phi_ecs : Int) : Int := 1000 - phi_ecs
def yield_stress_scaled (sigma_0 phi_pack phi_c : Int) : Int :=
  if phi_c < phi_pack then sigma_0 * (phi_pack - phi_c) else 0
theorem rigidity_percolation_yield_stress_onset
    (sigma_0 phi_fluid phi_solid phi_1 phi_2 phi_c phi_ecs_post phi_ecs_ant : Int)
    (h_fluid : phi_fluid <= phi_c) (h_solid : phi_c < phi_solid)
    (h_sub : phi_c <= phi_1) (h_order : phi_1 < phi_2) (h_ecs : phi_ecs_ant < phi_ecs_post) :
    yield_stress_scaled sigma_0 phi_fluid phi_c = 0 ∧
    yield_stress_scaled 1 phi_solid phi_c > 0 ∧
    cell_packing_milli phi_ecs_post < cell_packing_milli phi_ecs_ant ∧
    yield_stress_scaled 1 phi_1 phi_c < yield_stress_scaled 1 phi_2 phi_c"""^^pk:lean4 ;
    skos:notation "\\phi_{\\text{pack}}(x) = 1 - \\phi_{\\text{ECS}}(x),\\qquad \\sigma_y(x) = \\sigma_0 \\max\\!\\left(0,\\, \\phi_{\\text{pack}}(x) - \\phi_c\\right)^\\beta = \\sigma_0 \\max\\!\\left(0,\\, \\phi_{\\text{ECS,crit}} - \\phi_{\\text{ECS}}(x)\\right)^\\beta" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2013.05.052>,
        <https://doi.org/10.1038/nmeth.4101>,
        <https://doi.org/10.1038/s41567-021-01215-1>,
        <https://doi.org/10.1038/s41586-018-0479-2>,
        <https://doi.org/10.1242/dev.090381> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Active Fluid-to-Solid Jamming Transition & Bingham Viscoplastic Axis Elongation (Mongera-Kim-Campas Active Foam Mechanics)" ;
    pk:leanDeclaration "MathOfBiology.Loop_030.yield_stress_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_030.rigidity_percolation_yield_stress_onset" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/tailbud-neuromesodermal-jamming-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Active Tension Fluctuation vs. Yield-Stress Caging & Kramers/Bingham Fluid-to-Solid Crossover" ;
    dct:description "Proves that active tension fluctuations fluidize the posterior MPZ (sigma_A > sigma_y) via frequent T1 neighbor exchanges, whereas rising yield stress freezes T1 rearrangements into a solid state in the PSM (sigma_y >= sigma_A) | Variables: sigma_A(x): cell-scale non-muscle Myosin-II active tension fluctuations (50 Pa in MPZ -> 13 Pa in A-PSM); k_T1(x): rate of T1 topological neighbor exchanges (min^-1); eta_p: plastic viscosity" ;
    dct:source "Mongera et al. (2018) Nature 561:401-405 Fig. 2; Kim et al. (2021) Nature Physics 17:859-866 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L140-L245>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L36-L95> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def net_jamming_barrier (sigma_y sigma_A : Int) : Int := sigma_y - sigma_A
def bingham_plastic_rate_num (sigma_eff sigma_y : Int) : Int :=
  if sigma_y < sigma_eff then sigma_eff - sigma_y else 0
theorem active_fluctuation_fluid_to_solid_jamming_crossover
    (sigma_y_mpz sigma_A_mpz sigma_y_apsm sigma_A_apsm : Int)
    (h_mpz_fluid : sigma_y_mpz < sigma_A_mpz) (h_apsm_solid : sigma_A_apsm <= sigma_y_apsm) :
    net_jamming_barrier sigma_y_mpz sigma_A_mpz < 0 ∧
    bingham_plastic_rate_num sigma_A_mpz sigma_y_mpz > 0 ∧
    net_jamming_barrier sigma_y_apsm sigma_A_apsm >= 0 ∧
    bingham_plastic_rate_num sigma_A_apsm sigma_y_apsm = 0"""^^pk:lean4 ;
    skos:notation "\\Delta\\sigma_{\\text{cage}}(x) = \\sigma_y(x) - \\sigma_A(x),\\qquad \\dot{\\gamma}_p(x) = \\frac{\\max(0,\\, \\sigma_{\\text{eff}}(x) - \\sigma_y(x))}{\\eta_p},\\qquad k_{T1}(x) = k_0 \\exp\\!\\left(-c_B \\left(\\frac{\\sigma_y(x)}{\\sigma_A(x)}\\right)^{\\gamma_k}\\right)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2013.05.052>,
        <https://doi.org/10.1038/nmeth.4101>,
        <https://doi.org/10.1038/s41567-021-01215-1>,
        <https://doi.org/10.1038/s41586-018-0479-2>,
        <https://doi.org/10.1242/dev.090381> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Active Fluid-to-Solid Jamming Transition & Bingham Viscoplastic Axis Elongation (Mongera-Kim-Campas Active Foam Mechanics)" ;
    pk:leanDeclaration "MathOfBiology.Loop_030.bingham_plastic_rate_num" ;
    pk:leanTheorem "MathOfBiology.Loop_030.active_fluctuation_fluid_to_solid_jamming_crossover" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/tailbud-neuromesodermal-jamming-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Solid A-PSM Mechanical Backstop Rectification & cdh2 (N-Cadherin) Knockdown Bilateral Asymmetry Law" ;
    dct:description "Proves that the jammed A-PSM acts as an internal mechanical backstop that channels fluid MPZ cell addition into unidirectional posterior elongation and preserves left-right symmetry, whereas cdh2 knockdown unjams the PSM and induces bilateral asymmetry | Variables: J_MPZ: dorsal-medial progenitor cell influx into MPZ; sigma_y_APSM: anterior PSM backstop yield stress; phi_ecs_cdh2_apsm = 0.148 > phi_ECS_crit = 0.140: expanded extracellular space in N-cadherin morphants" ;
    dct:source "Mongera et al. (2018) Nature 561:401-405 Fig. 4; Lawton et al. (2013) Development 140:573-582" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L250-L435>,
        <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L97-L162> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem mongera_2018_wt_vs_cdh2_backstop_collapse :
    (cell_packing_milli phi_ecs_wt_mpz < phi_c_milli ∧
     phi_c_milli < cell_packing_milli phi_ecs_wt_ppsm ∧
     cell_packing_milli phi_ecs_wt_ppsm < cell_packing_milli phi_ecs_wt_apsm) ∧
    (yield_stress_scaled 1 (cell_packing_milli phi_ecs_wt_apsm) phi_c_milli = 91 ∧
     yield_stress_scaled 1 (cell_packing_milli phi_ecs_wt_apsm) phi_c_milli > sigma_A_wt_apsm) ∧
    (cell_packing_milli phi_ecs_cdh2_apsm < phi_c_milli ∧
     yield_stress_scaled 1 (cell_packing_milli phi_ecs_cdh2_apsm) phi_c_milli = 0)"""^^pk:lean4 ;
    skos:notation "v_{\\text{elong}} = J_{\\text{MPZ}} \\frac{\\sigma_{y,\\text{APSM}}}{\\sigma_{y,\\text{APSM}} + \\sigma_{y,\\text{MPZ}} + \\sigma_{\\text{ref}}},\\qquad \\phi_{\\text{pack}}^{\\text{cdh2}}(x) = 1 - \\phi_{\\text{ECS}}^{\\text{cdh2}}(x) < \\phi_c \\implies \\sigma_{y,\\text{APSM}}^{\\text{cdh2}} \\to 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.cub.2013.05.052>,
        <https://doi.org/10.1038/nmeth.4101>,
        <https://doi.org/10.1038/s41567-021-01215-1>,
        <https://doi.org/10.1038/s41586-018-0479-2>,
        <https://doi.org/10.1242/dev.090381> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Active Fluid-to-Solid Jamming Transition & Bingham Viscoplastic Axis Elongation (Mongera-Kim-Campas Active Foam Mechanics)" ;
    pk:leanDeclaration "MathOfBiology.Loop_030.rectified_posterior_flux_num" ;
    pk:leanTheorem "MathOfBiology.Loop_030.mongera_2018_wt_vs_cdh2_backstop_collapse" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


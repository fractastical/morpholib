    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L582–L650" ;
        dcterms:description "8 quantitative morphometric validations in measure_morphoeval()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L582-L650> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Morphometric validation: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes 8 quantitative morphometrics in `measure_morphoeval()` (L582-650), including WT MPZ yield stress `11.20 Pa` (vs `11.2 Pa` ref), WT A-PSM yield stress `129.01 Pa` (vs `118.0 Pa` ref), 7-point AP yield stress correlation `r = 0.9989` (`RMSE = 6.72 Pa`), Kramers T1 rearrangement rate correlation `r = 0.9922`, WT vs `cdh2` elongation speed drop `0.7501 um/min` (5-regime `r = 0.9717`), `cdh2` bilateral asymmetry `11.17%` (5-regime `r = 0.9851`), segmented tailbud nuclear count `N = 391`, and specimen AP interstitial compaction correlation `r = 0.9915`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-ap-t1-rearrangement-rate-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-ap-yield-stress-profile-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-measurement-cdh2-knockdown-lr-asymmetry-pct>,

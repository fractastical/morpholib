sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates all 5 experimental regimes from Mongera et al. (2018) and Lawton et al. (2013) (`evaluate_all_perturbation_regimes`, L445-497: Wild-Type Control, `cdh2` N-cadherin Morphant, Blebbistatin Myosin-II Inhibition, SU5402 FGFR Inhibition, and Zero-Backstop Uniform-Fluid Ablation Control), renders 4 spatial 2D regimes in Panels A1-A4 and 5-regime comparisons in Panel B4, and exposes full CLI flags (`--phi-ecs-mpz`, `--phi-ecs-apsm`, `--sigma-a-mpz`, `--steps`, `--seed`, `--self-test`, L725-755)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L445–L497" ;
        dcterms:description "5-regime experimental perturbation evaluator covering WT, cdh2 MO, Blebbistatin, SU5402, and zero-backstop ablation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L445-L497> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L725–L755" ;
        dcterms:description "Full CLI parameter interface wired into run_all_regimes_and_render" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L725-L755> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Morphological realism / specimen match: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the *Danio rerio* posterior tailbud lightsheet nuclear fluorescence micrograph (`datasets/neuromesodermal_jamming/zebrafish_tailbud_psm_specimen.jpg`, IDR0051 / Dray & Lawton et al. 2013, CC BY 4.0), segments `N = 391` individual cell nuclei and interior Voronoi polygons across MPZ, P-PSM, and A-PSM (`segment_zebrafish_tailbud_specimen`, L504-617), demonstrates monotonic AP compaction of interstitial space (`15.1% -> 9.8% -> 5.2%`) matching the Mongera et al. (2018) reference gradient with `r = 0.9915` (`RMSE = 0.0046`), and measures bilateral paraxial symmetry `0.9881` across the central notochord (Panels A5, B1, B5)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L504–L617" ;
        dcterms:description "CV nuclear & Voronoi segmentation of IDR0051 zebrafish tailbud lightsheet micrograph (N=391 nuclei, r=0.9915)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L504-L617> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/neuromesodermal_jamming_comparison.png (generated output)" ;
        dcterms:description "10-panel synthesis figure displaying segmented zebrafish tailbud overlay (Panel A5) and regional compaction/Voronoi coordination (Panels B1, B5) — docs/media/neuromesodermal_jamming_comparison.png: rendered output of 2022-tailbud-neuromesodermal-jamming.py at 0cb0132, image/png, 732687 B, 3150×1320 px, artifact_sha256 de989cdbda2538b3ac78b567588057367c51e4f73aa8cca93a923398e4b1e838 (sha256 de989cdbda2538b3ac78b567588057367c51e4f73aa8cca93a923398e4b1e838), spec_fingerprint 5225f2c29acda8d1ee81d082219556f85a1159006d552c629f56ce7d8a842027" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tailbud-neuromesodermal-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Mongera et al. (2018) & Kim et al. (2021) zebrafish tailbud active fluid-to-solid jamming transition & yield-stress axis elongation — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements the Mongera et al. (2018) & Kim et al. (2021) active-foam governing laws: cell packing `phi_pack = 1 - phi_ECS` (`compute_cell_packing`, L113-119), Maxwell coordination `z(x)` (`compute_isostatic_coordination`, L122-135), rigidity-percolation yield stress `sigma_y(x)` (`compute_supracellular_yield_stress`, L138-165), Kramers T1 rearrangement rate `k_T1(x)` (`compute_kramers_t1_rate`, L168-186), Bingham viscoplastic strain rate (`compute_bingham_plastic_strain_rate`, L189-201), continuous AP crossover profile (`solve_ap_jamming_profile`, L204-303), and 2D U-shaped tailbud viscoplastic flow (`simulate_2d_tailbud_jamming_regime`, L310-442). Backed by 4 machine-checked Lean 4 theorems (0 sorrys)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L113–L303" ;
        dct:description "Rigidity-percolation yield stress, Maxwell coordination, Kramers T1 rate, Bingham flow, and AP crossover solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L113-L303> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2022-tailbud-neuromesodermal-jamming.py L310–L442" ;
        dct:description "2D active-foam & Bingham viscoplastic tailbud axis elongation and bilateral symmetry simulator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/2022-tailbud-neuromesodermal-jamming.py#L310-L442> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tailbud-neuromesodermal-jamming-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean L20–L165" ;
        dct:description "4 machine-checked Lean 4 theorems for rigidity percolation, active fluctuation crossover, cdh2 backstop collapse, and posterior flux rectification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0cb0132/morphoeval/lean/loops/Loop_030_neuromesodermal_jamming.lean#L20-L165> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


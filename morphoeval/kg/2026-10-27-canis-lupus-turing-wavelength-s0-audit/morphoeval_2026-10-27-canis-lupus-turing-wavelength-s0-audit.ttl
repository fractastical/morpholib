<https://w3id.org/delphi/resource/math-law/delphi10000-canis-lupus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian stability at the homogeneous state" ;
    dct:description "Homogeneous MDCK cortical state is stable in the absence of diffusion | Variables: f_u, g_v, f_v, g_u scaled by 30 from gamma=40, a=0.10, b=1.10" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3139_canis_lupus_turing_wavelength_s0.lean#L19-L21> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr(J) = f_u + g_v < 0 and det(J) = f_u*g_v - f_v*g_u > 0 at (u0, v0) = (a+b, b/(a+b)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cell.2006.11.051>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1147880>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3139.fu" ;
    pk:leanTheorem "MathOfBiology.Loop_3139.homogeneous_state_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-canis-lupus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Wavelength selection at the 1.8 µm detail scale | Variables: D_v/D_u = 12, both diffusivities scaled by 5" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3139_canis_lupus_turing_wavelength_s0.lean#L27-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v*f_u + D_u*g_v) / (2*D_u*D_v), lambda_c = 2*pi/k_c = 1.781e-6 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cell.2006.11.051>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1147880>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3139.dv" ;
    pk:leanTheorem "MathOfBiology.Loop_3139.inhibitor_outruns_activator" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-canis-lupus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion quenching" ;
    dct:description "Negative control for stripes, spots and ocelli | Variables: equal diffusivities at the activator value" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-canis-lupus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3139_canis_lupus_turing_wavelength_s0.lean#L32-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v = D_u implies D_v*f_u + D_u*g_v = D_u*tr(J) < 0, so no Turing band" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.cell.2006.11.051>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1147880>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3139.du" ;
    pk:leanTheorem "MathOfBiology.Loop_3139.equal_diffusion_has_no_turing_instability" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-canis-lupus-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene detail scale versus coat-scale pre-pattern" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Clytia hemisphaerica Schnakenberg wavelength at 8.64 µm (Pass 1) — Model fidelity to source: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The Jacobian and the PDE are the Schnakenberg system, but Pass 1 reads σ from an activator-only perturbation, so the numerical growth rates are not the unstable eigenvalue." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-model-fidelity-1> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py L164–L212" ;
        dct:description "eigenvector flag; Pass 1 takes the activator-only branch and fits from t = 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/bd8176806dee28731b94a3866aa6609c1d9d4ba2/models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py#L164-L212> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; Pass 1 of slot 3150)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


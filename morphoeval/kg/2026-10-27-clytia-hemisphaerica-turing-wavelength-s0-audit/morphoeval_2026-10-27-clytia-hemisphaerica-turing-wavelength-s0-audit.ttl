<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Clytia hemisphaerica Schnakenberg wavelength at 8.64 µm (Pass 1) (Clytia hemisphaerica)",
        "Clytia hemisphaerica Schnakenberg wavelength at 8.64 µm (Pass 1) faithfully reproduces Clytia hemisphaerica morphology" ;

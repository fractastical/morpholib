<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Clytia hemisphaerica Schnakenberg wavelength at 8.64 µm (Pass 1) — Model fidelity to source: 76/100" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-clytia-hemisphaerica-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Clytia hemisphaerica Schnakenberg wavelength at 8.64 µm (Pass 1) faithfully reproduces Clytia hemisphaerica morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Clytia hemisphaerica specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py; output: docs/media/clytia_hemisphaerica_turing_wavelength_s0_comparison.png; organism: Clytia hemisphaerica; environment: n/a; claim_boundary: [reported_in_source: Turing dispersion and Schnakenberg kinetics | Clytia hemisphaerica planula and medusa life cycle | Gonad opsin and hydrozoan pigment-cup ocelli as anatomical context; reconstructed_in_script: γ chosen so the most-unstable mode is the assigned 8.64 µm detail length | Planula mask used as the render domain; transfer_boundary: 8.64 µm is the MorphoEval detail anchor, not a published ocellus measurement; does_not_claim: A fossil wavelength shift (series length 1, age delta 0 Ma) | That the Pass-1 transient probe validates the dispersion relation]; phenomenon_size: 10 µm (1.032e-05 m, log10=-4.986 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 10 µm to 3.1 cm): 10 µm:clytia-hemisphaerica-bioelectric-polarity, 38 µm:clytia-hemisphaerica-vertex-packing, 684 µm:clytia-hemisphaerica-turing-wavelength, 1.3 mm:clytia-hemisphaerica-clock-wavefront, 2.1 mm:clytia-hemisphaerica-morphogen-condensation, 2.7 mm:clytia-hemisphaerica-flux-canalization, 3.1 mm:clytia-hemisphaerica-elastic-buckling, 6.7 mm:clytia-hemisphaerica-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00226774>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/s41559-019-0833-2>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pbio.0050070>,
            <https://doi.org/10.7554/eLife.29555> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-clytia-hemisphaerica-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


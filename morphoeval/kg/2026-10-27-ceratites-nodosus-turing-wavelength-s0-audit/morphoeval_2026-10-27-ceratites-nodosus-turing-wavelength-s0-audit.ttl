<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-ceratites-nodosus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-ceratites-nodosus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-ceratites-nodosus-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-ceratites-nodosus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Selects the cellular pigment wavelength on the Ladinian mantle | Variables: activator u, inhibitor v, diffusivities Du and Dv, wavenumber k_c at 26 µm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0669e59d85ea16ffd68400afdedd6a2fd1cb346e/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0669e59d85ea16ffd68400afdedd6a2fd1cb346e/morphoeval/lean/loops/Loop_3142_ceratites_nodosus_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (det J / (D_u D_v))^(1/2), det J = f_u g_v - f_v g_u" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0022-5193(87)80101-7>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2014.0218> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3142.kcNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3142.operating_regime_numerator_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ceratites-nodosus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cellular wavelengths across the shell" ;
    dct:description "States what changes at 240 Ma versus Goniatites (333 Ma) and Dactylioceras (181 Ma) at fixed cellular wavelength | Variables: L_shell = 0.032 m at 240 Ma; predecessor 0.018 m; successor 0.042 m" ;
    dct:source "Boyajian & Lutz 1992 DOI:10.1130/0091-7613(1992)020<0983:EOBCAI>2.3.CO;2" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0669e59d85ea16ffd68400afdedd6a2fd1cb346e/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0669e59d85ea16ffd68400afdedd6a2fd1cb346e/morphoeval/lean/loops/Loop_3142_ceratites_nodosus_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = L_shell / lambda_c with lambda_c = 2.56e-05 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0022-5193(87)80101-7>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2014.0218> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3142.wavelengths" ;
    pk:leanTheorem "MathOfBiology.Loop_3142.ceratites_shell_holds_1250_cellular_waves" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ceratites-nodosus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control for wavenumber selection | Variables: gamma = 1 versus operating gamma = 12 in the integer proxy" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0669e59d85ea16ffd68400afdedd6a2fd1cb346e/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0669e59d85ea16ffd68400afdedd6a2fd1cb346e/morphoeval/lean/loops/Loop_3142_ceratites_nodosus_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "at Dv = Du the Turing numerator gamma*f_u + g_v is negative and sigma(k) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/s0022-5193(87)80101-7>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2014.0218> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3142.kcNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3142.equal_diffusion_ablation_not_turing" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


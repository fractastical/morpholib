sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Ceratites nodosus Schnakenberg Turing wavenumber at 26 µm (Ladinian, 240 Ma) — Reproducibility package: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Seed 3142, pinned SHA-256 of the five dataset sources, and a --self-test that checks r > 0.98, the wavelength ratio, ablation decay, sweep monotonicity, and a GIF of at least 10 frames at least 480 px. The run is deterministic given that seed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-repro-package-1> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py L42–L78" ;
        dct:description "EXPECTED_SHA256, seed 3142, verify_sha256" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0669e59d85ea16ffd68400afdedd6a2fd1cb346e/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py#L42-L78> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Ceratites nodosus Schnakenberg Turing wavenumber at 26 µm (Ladinian, 240 Ma) — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the vendored Muschelkalk shell beside an ocellus field at 25.60 µm. The growth GIF keeps shell luminance and carries the activator as chroma, so the fitness crop sees the fossil rather than the spots. The fossil's ribs and nodes are not a 26 µm pigment pattern." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/ceratites_nodosus_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "Specimen, mantle patch, dispersion, sweep, chronoseries — docs/media/ceratites_nodosus_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py at 0669e59d85ea16ffd68400afdedd6a2fd1cb346e, image/png, 490995 B, 1848×1176 px, artifact_sha256 1b02be065e72e6facf0a0217d044283bee635e8911d3e6b287a4bafaeca27bae (sha256 1b02be065e72e6facf0a0217d044283bee635e8911d3e6b287a4bafaeca27bae), spec_fingerprint cef6ede1e830551276a963350aa3ce5c67a0cb0dabe081d68214d961e5f27b65" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ceratites-nodosus-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py L387–L428" ;
        dct:description "Growth GIF; last frame restores specimen luminance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0669e59d85ea16ffd68400afdedd6a2fd1cb346e/models/2026-delphi10000-ceratites-nodosus-turing-wavelength-s0.py#L387-L428> .

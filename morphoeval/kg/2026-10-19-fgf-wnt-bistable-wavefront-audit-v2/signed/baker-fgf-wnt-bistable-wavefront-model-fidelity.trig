        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L220–L315" ;
        dcterms:description "1D coupled RA-FGF8/Wnt reaction-diffusion PDE solver and front sharpening measurement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py#L220-L315> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_025_fgf_wnt_bistable_wavefront.lean L25–L103" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for CYP26 steady balance, hysteresis window positivity, and opposing VAD/RA somite symmetry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_025_fgf_wnt_bistable_wavefront.lean#L25-L103> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Goldbeter, Gonze & Pourquié's (2007) mutual cross-inhibition + CYP26A1 RA-degradation PDE system, analytical inverse hysteresis S-curve M(F) with saddle-node thresholds [M_1, M_2] = [1.0254, 3.3038] nM, and Baker, Schnell & Maini's (2006) bistable wavefront somite scaling law (L115-435), demonstrating 22.2-fold front sharpening (Delta_x_front = 16.24 um << lambda_M = 360.67 um) and exact VAD + RA symmetry S_VAD + S_RA = 300.0 um, verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_025_fgf_wnt_bistable_wavefront.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-3> ;

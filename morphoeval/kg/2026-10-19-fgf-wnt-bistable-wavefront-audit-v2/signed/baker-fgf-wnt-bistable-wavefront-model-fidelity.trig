        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L115–L215" ;
        dcterms:description "CYP26A1 Hill induction C(F), quasi-steady RA nullcline R*(F), and analytical inverse hysteresis S-curve M(F)" ;

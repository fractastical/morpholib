sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis — Morphological realism / specimen match: 88/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY 4.0 dorsal avian/vertebrate embryo SEM (`datasets/fgf_wnt_bistable_wavefront/chick_ra_fgf_somites_specimen.jpg`) and segments both bilateral paraxial somite rows flanking the neural tube (`segment_chick_ra_fgf_specimen`, L440-515), extracting 8 upper somites (mean spacing 47.43 px, CV = 0.1965) and 9 lower somites (mean spacing 49.38 px, CV = 0.2012), bilateral mean spacing 48.47 px, bilateral symmetry ratio 0.9605, and phase-aligned waveform correlation (Panels E-F)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L440–L515" ;
        dct:description "Bilateral dorsal somite DoG peak & inter-somitic cleft segmentation on chick_ra_fgf_somites_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py#L440-L515> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/fgf_wnt_bistable_wavefront_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure including hysteresis S-curves, 1D PDE switch profiles, perturbation somite trains, 5-regime validation, SEM segmentation, and waveform fit — docs/media/fgf_wnt_bistable_wavefront_comparison.png: rendered output of 2012-baker-fgf-wnt-bistable-wavefront.py at 317bc3c, image/png, 1336827 B, 2352×1372 px, artifact_sha256 499ddc7eed5384bbf4d6f0118814a3c67b19b1d52d6608fcfe526a0864146bde (sha256 499ddc7eed5384bbf4d6f0118814a3c67b19b1d52d6608fcfe526a0864146bde), spec_fingerprint 067326af3885ea73d93878ed07f29a5a29f47fffe07fbd95bba8a7110f414601" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


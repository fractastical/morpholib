        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates all 5 experimental regimes (wild-type control, Vitamin A Deficiency VAD v_sc = 0.08 nM/min, exogenous RA bath v_sc = 0.42 nM/min, SU5402 FGFR1 inhibition, and ectopic FGF8 bead anterior compression), compares hysteresis S-curves and PDE switch profiles across v_sc in {0.08, 0.25, 0.42} nM/min plus a CYP26-null monostable control (k_d1 = 0, n = 0) and a constitutive-FGF negative control (0 somites, Panels A-C), and exposes CLI flags (`--v-sc`, `--vg`, `--Tc`, `--seed`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L320–L435" ;
        dct:description "5-regime RA/FGF8 perturbation evaluator and bistable somitogenesis simulator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py#L320-L435> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L610–L710" ;
        dct:description "Hysteresis S-curve family, 1D PDE switch shift, and 5-regime validation panels" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-baker-fgf-wnt-bistable-wavefront.py#L610-L710> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


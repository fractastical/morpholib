        <https://w3id.org/probknow/resource/evidence/2026-10-19-fgf-wnt-bistable-wavefront-audit-v2-baker-fgf-wnt-bistable-wavefront-4>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-fgf-wnt-bistable-wavefront-audit-v2-baker-fgf-wnt-bistable-wavefront-5> ;
    pk:hypothesisType "Bistable Morphogen Wavefront Arrest (RA-FGF8/Wnt Mutual Antagonism & Saddle-Node Hysteresis)" ;

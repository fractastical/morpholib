sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics and mesenchymal-to-epithelial transition (MET) model — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY 4.0 dorsal vertebrate embryo somite rosette SEM (`datasets/somitoid_chirality_buckling/somitoid_rosette_specimen.jpg`) and segments both bilateral somite rosette rows (`segment_somite_rosette_specimen`, L418-505), extracting rosette centers, inter-somitic clefts, bilateral mean spacing 45.38 px (CV = 0.2010), radial dome-to-cleft intensity contrast (1.189x), and periodic waveform fit (Panels E-F)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L418–L505" ;
        dct:description "Bilateral somite rosette center, cleft, and radial annular contrast segmentation on somitoid_rosette_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L418-L505> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/somitoid_chirality_buckling_comparison.png (generated output)" ;
        dct:description "6-panel dark-theme synthesis figure comparing 2D vertex rosettes, energy landscape, Matrigel phase diagram, 6-regime benchmark, and SEM specimen segmentation — docs/media/somitoid_chirality_buckling_comparison.png: rendered output of 2021-yaman-somitoid-chirality-buckling.py at 317bc3c, image/png, 788839 B, 2253×1554 px, artifact_sha256 aae2e04bd0e93a9f8f9601a3be10f47f48c37dd75e58e945e9ad68b46b51fdfc (sha256 aae2e04bd0e93a9f8f9601a3be10f47f48c37dd75e58e945e9ad68b46b51fdfc), spec_fingerprint 834555c3491ff9a0813c6b8298d939c224a2f6c75546f46b11089139cd1ede3c" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics and mesenchymal-to-epithelial transition (MET) model — Morphometric validation: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L510-575): WT apical-to-basal ratio 0.3030 vs 0.3030 analytical (0.305 empirical), Y-27632 ROCK-inhibited ratio dilation 0.7013 vs 0.7013 analytical (0.700 empirical), 6-regime perturbation Pearson r = 0.9989 (RMSE = 0.0086), EphA4/ephrinB2 cleft separation index 0.8189 (vs 0.0930 in KD), and bilateral specimen rosette spacing 45.38 px (CV = 0.2010)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-6-regime-somite-rosette-perturbation-series-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-epha4-ephrinb2-inter-somitic-cleft-separation-index-s-cleft>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-vertebrate-somite-rosette-specimen-bilateral-metamere-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-ratio-l-ap-l-bas>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-y-27632-rock-inhibited-apico-basal-ratio-dilation-l-ap-l-bas>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-6-regime-somite-rosette-perturbation-series-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-regime somite rosette perturbation series Pearson correlation r = 0.9989 Pearson r" ;
        dct:description "p = 1.94e-06; spans Calpeptin hyper-constricted (0.1370) to Y-27632 (0.7013)" ;
        schema:measurementTechnique "correlation between 2D vertex-predicted and empirical apical-to-basal ratios across 6 Yamanaka (2023), Miao (2023) & Adhyapok (2021) regimes (RMSE = 0.0154)" ;
        schema:name "6-regime somite rosette perturbation series Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9989" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-6-regime-somite-rosette-perturbation-series-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-6-regime-somite-rosette-perturbation-series-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Yamanaka et al. (2023) Nature 614:509-520; Miao et al. (2023) Nature 614:500-508; Adhyapok et al. (2021) Dev. Cell 56:1312-1324" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-epha4-ephrinb2-inter-somitic-cleft-separation-index-s-cleft> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "EphA4/ephrinB2 inter-somitic cleft separation index S_cleft = 0.8189 dimensionless index" ;
        dct:description "cleft indentation depth = 14.68 um in WT vs 1.23 um (S_cleft = 0.0930) in EphA4/ephrinB2 knockdown" ;
        schema:measurementTechnique "heterotypic EphA4/ephrinB2 contact repulsion cleft separation score 1 - (gamma_hom / gamma_het)^2 at gamma_het = 2.35 (Delta_E_cleft = 75.60 pN)" ;
        schema:name "EphA4/ephrinB2 inter-somitic cleft separation index S_cleft" ;
        schema:unitText "dimensionless index" ;
        schema:value "0.8189" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-epha4-ephrinb2-inter-somitic-cleft-separation-index-s-cleft-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-epha4-ephrinb2-inter-somitic-cleft-separation-index-s-cleft-reference> a schema:PropertyValue ;
        dct:source "Adhyapok et al. (2021) Dev. Cell 56:1312-1324 Figs. 1-3; Yamanaka et al. (2023) Nature 614:509-520 Fig. 2" ;
        schema:value "0.94" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-vertebrate-somite-rosette-specimen-bilateral-metamere-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate somite rosette specimen bilateral metamere spacing S_obs = 45.375 px" ;
        dct:description "bilateral symmetry ratio = 1.0834, AP cleft waveform r = 0.2136, dome/cleft contrast = 1.2315" ;
        schema:measurementTechnique "bilateral dorsal somite rosette DoG peak & inter-somitic cleft segmentation on somitoid_rosette_specimen.jpg (upper=8 rosettes, lower=10 rosettes, CV=0.2391)" ;
        schema:name "vertebrate somite rosette specimen bilateral metamere spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "45.375" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-vertebrate-somite-rosette-specimen-bilateral-metamere-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-vertebrate-somite-rosette-specimen-bilateral-metamere-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 vertebrate embryo somite rosette SEM specimen (datasets/somitoid_chirality_buckling/somitoid_rosette_specimen.jpg)" ;
        schema:value "47.1429" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-ratio-l-ap-l-bas> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type somite rosette equilibrium apical-to-basal ratio L_ap / L_bas = 0.303 dimensionless ratio" ;
        dct:description "apico-basal polarity score = 1.0000; wedge cell height = 17.81 um" ;
        schema:measurementTechnique "2D 32-vertex apico-basal differential interfacial tension relaxation (N=16 wedge cells, gamma_ap=1.65, gamma_bas=0.45, R_in*=7.74 um, R_out*=25.56 um)" ;
        schema:name "wild-type somite rosette equilibrium apical-to-basal ratio L_ap / L_bas" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.303" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-ratio-l-ap-l-bas-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-wild-type-somite-rosette-equilibrium-apical-to-basal-ratio-l-ap-l-bas-reference> a schema:PropertyValue ;
        dct:source "Yamanaka et al. (2023) Nature 614:509-520 Figs. 1-3; Adhyapok et al. (2021) Dev. Cell 56:1312-1324 Figs. 2-4 (analytical ratio = 0.3037, empirical = 0.305)" ;
        schema:value "0.303" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-y-27632-rock-inhibited-apico-basal-ratio-dilation-l-ap-l-bas> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Y-27632 ROCK-inhibited apico-basal ratio dilation L_ap / L_bas = 0.7013 dimensionless ratio" ;
        dct:description "somitecoel lumen dilates from 7.74 um (WT) to 24.00 um (Y-27632); Minus-Matrigel ratio = 0.5614" ;
        schema:measurementTechnique "2D vertex relaxation under Y-27632 ROCK / Blebbistatin myosin II inhibition (gamma_ap = gamma_bas = 0.45, Delta_gamma_ap_bas = 0)" ;
        schema:name "Y-27632 ROCK-inhibited apico-basal ratio dilation L_ap / L_bas" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.7013" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-y-27632-rock-inhibited-apico-basal-ratio-dilation-l-ap-l-bas-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-measurement-y-27632-rock-inhibited-apico-basal-ratio-dilation-l-ap-l-bas-reference> a schema:PropertyValue ;
        dct:source "Yamanaka et al. (2023) Nature 614:509-520 Fig. 3; Miao et al. (2023) Nature 614:500-508 Fig. 4 (empirical unpolarized ratio = 0.700)" ;
        schema:value "0.7013" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L510–L575" ;
        dct:description "5 quantitative MorphoEval measurements with analytical and empirical references, CV, Pearson r, and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L510-L575> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


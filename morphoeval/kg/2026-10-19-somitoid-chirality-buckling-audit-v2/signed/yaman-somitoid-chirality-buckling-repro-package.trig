sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics and mesenchymal-to-epithelial transition (MET) model — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2021`), standalone `--self-test` suite verifying SHA-256 dataset integrity, bitwise two-run vertex relaxation determinism (`atol=0.0`), analytical-to-vertex ratio agreement (<0.015), Y-27632 & Minus-Matrigel negative controls, Eph/ephrin cleft knockdown collapse, and specimen segmentation (`run_self_test`, L800-845), plus rendered PNG and GIF outputs in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L800–L845" ;
        dcterms:description "Deterministic --self-test suite verifying SHA-256 digests, bitwise vertex determinism, negative controls, and morphometrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L800-L845> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/somitoid_chirality_buckling_growth.gif (generated output)" ;
        dcterms:description "20-frame animated GIF comparing WT MET apical constriction and lumen narrowing against Y-27632 ROCK-inhibited control — docs/media/somitoid_chirality_buckling_growth.gif: rendered output of 2021-yaman-somitoid-chirality-buckling.py at 317bc3c, image/gif, 448063 B, 817×408 px, 20 frames, artifact_sha256 f37a7baf161b1fdd66dc83cbab655037c5ff89c103db1a7becabbef07dc7a8cd (sha256 f37a7baf161b1fdd66dc83cbab655037c5ff89c103db1a7becabbef07dc7a8cd), spec_fingerprint 834555c3491ff9a0813c6b8298d939c224a2f6c75546f46b11089139cd1ede3c" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-yaman-somitoid-chirality-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Yamanaka et al. (2023), Miao et al. (2023) & Adhyapok et al. (2021) epithelial somite rosette vertex mechanics and mesenchymal-to-epithelial transition (MET) model — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements the 2D apico-basal differential interfacial tension vertex energy functional E = sum_i [0.5*K_A*(A_i - A_0)^2 + gamma_ap*L_{ap,i} + gamma_lat*L_{lat,i} + gamma_bas*L_{bas,i}] alongside the exact analytical polygon and continuum equilibrium laws, EphA4/ephrinB2 inter-somitic cleft sorting energy barrier, and Y-27632 / Minus-Matrigel negative controls (L118-375), verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L118–L285" ;
        dct:description "Analytical wedge equilibrium and 2D 32-vertex L-BFGS-B somite rosette relaxation solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L118-L285> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-yaman-somitoid-chirality-buckling.py L288–L375" ;
        dct:description "EphA4/ephrinB2 cleft sorting energy barrier and 6-regime experimental perturbation evaluator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2021-yaman-somitoid-chirality-buckling.py#L288-L375> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-yaman-somitoid-chirality-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean L24–L119" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) on apical wedge tapering, Eph/ephrin cleft sorting energy, and Y-27632 curvature collapse" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_029_somitoid_chirality_buckling.lean#L24-L119> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        dct:title "A mechanical model of early somite segmentation" .
    <https://doi.org/10.1038/s41467-022-29967-1> dct:date "2022"^^xsd:gYear ;
        dct:title "Periodic formation of epithelial somites from human pluripotent stem cells" .
    <https://doi.org/10.1038/s41586-022-05649-2> dct:date "2023"^^xsd:gYear ;

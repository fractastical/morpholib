    <https://doi.org/10.1017/s0094837300006990> dct:date "1982"^^xsd:gYear ;
        dct:title "Fine-scale temporal variation of the Miocene stickleback Gasterosteus doryssus" .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1038/nature02415> dct:date "2004"^^xsd:gYear ;

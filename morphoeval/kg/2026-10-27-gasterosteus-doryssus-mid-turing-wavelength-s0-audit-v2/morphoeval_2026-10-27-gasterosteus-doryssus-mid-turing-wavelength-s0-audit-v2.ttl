        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength at 42 µm on Gasterosteus doryssus_mid (Truckee Fm, 10.01 Ma) — Morphometric validation: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion: Pearson r = 0.9897, RMSE = 0.070 against the eigenvalue. Equal-diffusion σ_max = -0.324. Registered-frame coherency 0.603 versus specimen 0.596; foreground 0.821 versus 0.589. Whole-frame radial KS D = 0.333. Bone mask (darkest 40%, fraction 0.400) radial KS = 0.333; sediment complement KS = 0.542, so the two regions are not the same comparison. Gray-level CV ratio sim/specimen = 0.948. None of these value/reference pairs are copies." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;

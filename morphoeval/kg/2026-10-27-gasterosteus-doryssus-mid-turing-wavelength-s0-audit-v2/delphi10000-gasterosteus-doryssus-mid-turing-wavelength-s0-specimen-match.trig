sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-mid-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 42 µm on Gasterosteus doryssus_mid (Truckee Fm, 10.01 Ma) — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Registered GIF versus the CC BY Voje, Bell & Stuart 2022 plate: CV similarity 92.3, 12 frames, 640×480. The same fitness function on the unguided stripe field, now stored as pure_field_cv, is 58.1. The comparison PNG keeps the pure stripes visible next to the fossil and the equal-diffusion control. The score stays below the CV number because the plate is a centimetre skeleton and the 42 µm claim is a modulation of that plate, which the code states in composite_on_specimen." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;

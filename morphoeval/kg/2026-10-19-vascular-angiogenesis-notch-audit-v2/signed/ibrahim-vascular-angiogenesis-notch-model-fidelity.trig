    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L136–L429" ;
        dcterms:description "Multicellular VEGFR2-Dll4-Notch1 solver, 2D filopodial sprouting, sFlt1 decoy rescue, and 5 canonical angiogenic regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-ibrahim-vascular-angiogenesis-notch.py#L136-L429> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L436–L499" ;
        dcterms:description "8-point Notch trans-activation gain sweep across k_t in [0.00, 1.25]" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-ibrahim-vascular-angiogenesis-notch.py#L436-L499> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean L43–L139" ;
        dcterms:description "3 machine-checked Lean 4 theorems for Brillouin k=pi symmetry breaking, DAPT all-tip collapse, and sFlt1 decoy rescue (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean#L43-L139> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the Brillouin k = pi linear stability & sFlt1 decoy verifier (`verify_brillouin_instability_and_flt1_rescue`, L136-181), coupled M = 16 multicellular VEGFR2-Dll4-Notch1 + 2D filopodial sprout outgrowth solver (`simulate_vessel_notch_sprouting`, L202-395), 5-regime + sFlt1 rescue evaluator (`evaluate_angiogenic_regimes`, L398-429), and 8-point Notch trans-gain sweep (`evaluate_notch_gain_sweep`, L436-499), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_060_vascular_angiogenesis_notch.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;

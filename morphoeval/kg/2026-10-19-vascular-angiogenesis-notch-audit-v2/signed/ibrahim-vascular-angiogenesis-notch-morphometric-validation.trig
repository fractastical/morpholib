sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting — Morphometric validation: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L798-899) computes 9 reference-anchored morphometric measurements with uncertainty, Pearson p-values, RMSE, and negative controls: Physiological tip-cell fraction = 0.5000 (ref 0.5000), Brillouin k=pi alternation index = 0.9472 (ref 0.9450, sFlt1 rescue delta +0.8858), DAPT Notch blockade tip fraction = 1.0000 (ref 1.0000, 0 stalk cells), Dll4+/- haploinsufficiency tip fraction = 0.7500 (ref 0.7500), High-VEGF synchronous oscillation CV = 0.3808 (ref 0.4150, sFlt1 rescue CV = 0.0134), WT:Vegfr2+/- chimera WT tip occupancy = 0.8571 (ref 0.8750), 8-point Notch gain sweep Pearson r = 0.99781 (RMSE = 0.0136, p = 2.61e-8), HUVEC specimen plexus density = 0.1967 (ref 0.1967), and HUVEC specimen tip-to-junction ratio = 0.8406 (58 tips / 69 junctions, inter-tip NND = 31.11 +- 21.79 px, CV = 0.7003)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-dapt-notch-blockade-k-t-0-0-all-tip-hypersprouting-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-dll4-haploinsufficiency-heterozygote-tip-cell-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-high-uniform-vegf-overload-synchronous-dll4-oscillation-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-huvec-angiogenic-sprouting-plexus-specimen-sprouting-tip-to-junction-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-huvec-angiogenic-sprouting-plexus-specimen-vascular-area-density>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-notch-trans-activation-gain-sweep-tip-cell-fraction-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-physiological-salt-and-pepper-brillouin-k-pi-period-2-alternation-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-physiological-vegf-salt-and-pepper-regime-tip-cell-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-wt-vegfr2-mosaic-chimera-wild-type-tip-cell-occupancy>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-dapt-notch-blockade-k-t-0-0-all-tip-hypersprouting-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "DAPT Notch blockade (k_t = 0.0) all-tip hypersprouting fraction = 1.0 tip cell fraction" ;
        dcterms:description "100% all-tip hypersprouting collapse with 0 stalk cells and alternation index = 0.0000" ;
        schema:measurementTechnique "Negative Notch ablation control with k_t=0.0 => N_i=0 => V_i=V_max (N_tip=16/16, N_stalk=0, delta = +0.5000)" ;
        schema:name "DAPT Notch blockade (k_t = 0.0) all-tip hypersprouting fraction" ;
        schema:unitText "tip cell fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-dapt-notch-blockade-k-t-0-0-all-tip-hypersprouting-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-dapt-notch-blockade-k-t-0-0-all-tip-hypersprouting-fraction-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-dll4-haploinsufficiency-heterozygote-tip-cell-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Dll4+/- haploinsufficiency heterozygote tip-cell fraction = 0.75 tip cell fraction" ;
        dcterms:description "Dll4+/- haploinsufficiency increases tip-cell fraction from 0.5000 to 0.7500 (+50% hyperbranching)" ;
        schema:measurementTechnique "16-cell vessel wall ODE with Dll4 ligand dosage = 0.5 (N_tip=12/16, 1.5x WT tip density)" ;
        schema:name "Dll4+/- haploinsufficiency heterozygote tip-cell fraction" ;
        schema:unitText "tip cell fraction" ;
        schema:value "0.75" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-dll4-haploinsufficiency-heterozygote-tip-cell-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-dll4-haploinsufficiency-heterozygote-tip-cell-fraction-reference> a schema:PropertyValue ;
        schema:value "0.75" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-high-uniform-vegf-overload-synchronous-dll4-oscillation-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "High uniform VEGF overload synchronous Dll4 oscillation CV = 0.3808 temporal CV (SD / mean)" ;
        dcterms:description "excessive uniform VEGF triggers synchronous anti-phase/in-phase oscillations; soluble Flt1 decoy rescues stable salt-and-pepper (CV = 0.0134)" ;
        schema:measurementTechnique "Temporal Dll4 coefficient of variation across M=16 cells under 3.4x uniform VEGF overload (sFlt1 rescue reduces CV to 0.0134)" ;
        schema:name "High uniform VEGF overload synchronous Dll4 oscillation CV" ;
        schema:unitText "temporal CV (SD / mean)" ;
        schema:value "0.3808" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-high-uniform-vegf-overload-synchronous-dll4-oscillation-cv-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-high-uniform-vegf-overload-synchronous-dll4-oscillation-cv-reference> a schema:PropertyValue ;
        schema:value "0.415" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-huvec-angiogenic-sprouting-plexus-specimen-sprouting-tip-to-junction-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HUVEC angiogenic sprouting plexus specimen sprouting tip-to-junction ratio = 0.8406 sprouting tips / branch junctions" ;
        dcterms:description "N_tip = 58 sprouting tips, N_junc = 69 junctions, inter-tip NND = 31.11 +- 21.79 px (CV = 0.7003)" ;
        schema:measurementTechnique "Medial-axis skeleton degree-1 endpoint vs degree>=3 junction detection (N_tip=58, N_junc=69, inter-tip NND CV=0.7003)" ;
        schema:name "HUVEC angiogenic sprouting plexus specimen sprouting tip-to-junction ratio" ;
        schema:unitText "sprouting tips / branch junctions" ;
        schema:value "0.8406" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-huvec-angiogenic-sprouting-plexus-specimen-sprouting-tip-to-junction-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-huvec-angiogenic-sprouting-plexus-specimen-sprouting-tip-to-junction-ratio-reference> a schema:PropertyValue ;
        schema:value "0.8406" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-huvec-angiogenic-sprouting-plexus-specimen-vascular-area-density> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "HUVEC angiogenic sprouting plexus specimen vascular area density = 0.1967 vascular area fraction" ;
        dcterms:description "vascular cord density = 0.1967 with 69 branch junctions" ;
        schema:measurementTechnique "Calcein green fluorescence morphological segmentation on huvec_angiogenic_sprouting_plexus_specimen.jpg (N_junc=69, N_tip=58)" ;
        schema:name "HUVEC angiogenic sprouting plexus specimen vascular area density" ;
        schema:unitText "vascular area fraction" ;
        schema:value "0.1967" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-huvec-angiogenic-sprouting-plexus-specimen-vascular-area-density-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-huvec-angiogenic-sprouting-plexus-specimen-vascular-area-density-reference> a schema:PropertyValue ;
        schema:value "0.1967" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-notch-trans-activation-gain-sweep-tip-cell-fraction-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Notch trans-activation gain sweep tip-cell fraction correlation = 0.99781 Pearson r" ;
        dcterms:description "RMSE = 0.0136, p = 2.61e-08; alternation sweep r = 0.99809 (RMSE = 0.0227)" ;
        schema:measurementTechnique "8-point Notch gain sweep k_t in [0.00, 1.25] comparing simulated tip fraction against Hellström et al. (2007) benchmark (RMSE = 0.0136, p = 2.61e-08)" ;
        schema:name "Notch trans-activation gain sweep tip-cell fraction correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99781" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-notch-trans-activation-gain-sweep-tip-cell-fraction-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-notch-trans-activation-gain-sweep-tip-cell-fraction-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-physiological-salt-and-pepper-brillouin-k-pi-period-2-alternation-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Physiological salt-and-pepper Brillouin k=pi period-2 alternation index = 0.9472 Brillouin k=pi alternation index" ;
        dcterms:description "DAPT blockade collapses alternation to 0.0000; sFlt1 decoy rescues high-VEGF alternation from 0.0622 to 0.9480" ;
        schema:measurementTechnique "Normalized staggered Fourier mode amplitude at k=pi across M=16 endothelial cells (sFlt1 rescue delta = +0.8858)" ;
        schema:name "Physiological salt-and-pepper Brillouin k=pi period-2 alternation index" ;
        schema:unitText "Brillouin k=pi alternation index" ;
        schema:value "0.9472" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-physiological-salt-and-pepper-brillouin-k-pi-period-2-alternation-index-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-physiological-salt-and-pepper-brillouin-k-pi-period-2-alternation-index-reference> a schema:PropertyValue ;
        schema:value "0.945" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-physiological-vegf-salt-and-pepper-regime-tip-cell-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Physiological VEGF salt-and-pepper regime tip-cell fraction = 0.5 tip cell fraction" ;
        dcterms:description "period-2 Tip-Stalk alternation with Brillouin k=pi index I_pi = 0.9472 and sprout spacing = 36.0 um" ;
        schema:measurementTechnique "16-cell coupled VEGFR2-Dll4-Notch1 vessel wall ODE at VEGF=1.0, k_t=1.0 (N_tip=8/16, spacing=36.0 um)" ;
        schema:name "Physiological VEGF salt-and-pepper regime tip-cell fraction" ;
        schema:unitText "tip cell fraction" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-physiological-vegf-salt-and-pepper-regime-tip-cell-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-physiological-vegf-salt-and-pepper-regime-tip-cell-fraction-reference> a schema:PropertyValue ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-wt-vegfr2-mosaic-chimera-wild-type-tip-cell-occupancy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "WT : Vegfr2+/- mosaic chimera wild-type tip-cell occupancy = 0.8571 WT fraction of tip cells" ;
        dcterms:description "WT cells win 85.7% of tip positions vs 14.3% for Vegfr2+/- cells" ;
        schema:measurementTechnique "1:1 mosaic vessel wall pairing WT (V_max=1.0) and Vegfr2+/- (V_max=0.5) endothelial cells across M=16 positions" ;
        schema:name "WT : Vegfr2+/- mosaic chimera wild-type tip-cell occupancy" ;
        schema:unitText "WT fraction of tip cells" ;
        schema:value "0.8571" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-wt-vegfr2-mosaic-chimera-wild-type-tip-cell-occupancy-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-measurement-wt-vegfr2-mosaic-chimera-wild-type-tip-cell-occupancy-reference> a schema:PropertyValue ;
        schema:value "0.875" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L798–L899" ;
        dcterms:description "9 reference-anchored morphometrics with Pearson r, p-values, RMSE, NND SD/CV, and DAPT/sFlt1 ablation controls" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting — Morphological realism / specimen match: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 4.0 Homo sapiens HUVEC angiogenic sprouting vascular network fluorescence micrograph (`huvec_angiogenic_sprouting_plexus_specimen.jpg`, 1224x904 px), segments the calcein-stained vascular plexus area density (0.1967), extracts the medial-axis skeleton to quantify N_junc = 69 branch junctions (degree >= 3) and N_tip = 58 blind-ending filopodial sprouting tips (degree == 1, tip-to-junction ratio = 0.8406), and computes inter-tip NND CV = 0.7003 (`segment_angiogenic_plexus_specimen`, L506-581)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L506–L581" ;
        dcterms:description "Calcein fluorescence plexus segmentation, medial-axis skeletonization, 69 branch junctions, and 58 sprouting tips" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-ibrahim-vascular-angiogenesis-notch.py#L506-L581> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/vascular_angiogenesis_notch_comparison.png (generated output)" ;
        dcterms:description "6-panel comparison figure pairing WT salt-and-pepper, DAPT/Dll4+/- hypersprouting, Notch gain sweep, high-VEGF oscillations + sFlt1 rescue, 5-regime benchmarks, and HUVEC CV segmentation — docs/media/vascular_angiogenesis_notch_comparison.png: rendered output of 2021-ibrahim-vascular-angiogenesis-notch.py at 8871db0, image/png, 739170 B, 2490×1530 px, artifact_sha256 467bd8172c349e7c8b916ab51cfba991d573bc7cc2a730ed158284d46321247a (sha256 467bd8172c349e7c8b916ab51cfba991d573bc7cc2a730ed158284d46321247a), spec_fingerprint 75ad27375139b901d6c87702d5f02c739a8e698db79579ceae73bdab1d021c1b" .


    <https://doi.org/10.1006/jtbi.1996.0233> dct:date "1996"^^xsd:gYear ;
        dct:title "Pattern formation by lateral inhibition with feedback: a mathematical model of delta-notch intercellular signalling" .
    <https://doi.org/10.1016/j.devcel.2009.06.004> dct:date "2009"^^xsd:gYear ;
        dct:title "Local guidance of emerging vessel sprouts requires soluble Flt-1" .

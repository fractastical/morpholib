sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ibrahim-vascular-angiogenesis-notch> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bentley, Gerhardt & Bates (2008) PLoS Comput. Biol., Hellström et al. (2007) Nature & Jakobsson et al. (2010) Nat. Cell Biol. VEGF-VEGFR2-Dll4-Notch1 tip/stalk salt-and-pepper lateral inhibition and angiogenic sprouting — Parameter expressivity: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates all 5 canonical angiogenic regimes plus sFlt1 decoy rescue (Physiological WT, High uniform VEGF oscillations, DAPT k_t=0 blockade, Dll4+/- haploinsufficiency, WT:Vegfr2+/- mosaic chimera, and High VEGF + sFlt1 rescue), sweeps 8 Notch trans-activation gains k_t in [0.00, 1.25], and exposes `--vegf`, `--kt`, `--dll4-dosage`, `--flt1-decoy`, and `--seed` CLI overrides (L950-976)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L398–L499" ;
        dct:description "5 angiogenic regimes + sFlt1 rescue control + 8-point k_t sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-ibrahim-vascular-angiogenesis-notch.py#L398-L499> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-ibrahim-vascular-angiogenesis-notch-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-ibrahim-vascular-angiogenesis-notch.py L950–L976" ;
        dct:description "CLI parameter overrides for vegf, kt, dll4-dosage, flt1-decoy, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2021-ibrahim-vascular-angiogenesis-notch.py#L950-L976> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 060 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


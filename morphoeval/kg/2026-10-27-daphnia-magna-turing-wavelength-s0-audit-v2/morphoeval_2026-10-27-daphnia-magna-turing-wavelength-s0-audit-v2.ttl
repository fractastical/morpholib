<https://w3id.org/delphi/resource/math-law/delphi10000-daphnia-magna-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Cleared numerator of D_v f_u + D_u g_v is positive, so k_c^2 > 0 at the 2.736 µm ocellus-pigment scale | Variables: f_u, f_v, g_u, g_v at the Schnakenberg state (a=0.062, b=1.180); D_u=0.016; D_v=0.640" ;
    dct:source "Turing (1952) 10.1098/rstb.1952.0012; Schnakenberg (1979) 10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5b213d4525d0e9f71d5fc4e385d270b87ac07ec8/models/2026-delphi10000-daphnia-magna-turing-wavelength-s0.py#L87-L141>,
        <https://github.com/fractastical/morpholib/blob/5b213d4525d0e9f71d5fc4e385d270b87ac07ec8/morphoeval/lean/loops/Loop_3165_daphnia_magna_turing_wavelength_s0.lean#L34-L38> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def discNumerator : Nat := 5350516939
theorem critical_wavenumber_numerator_positive :
    discNumerator > 0 := by
  decide
"""^^pk:lean4 ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00240009>,
        <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1523/jneurosci.01-09-00945.1981>,
        <https://doi.org/10.2307/2389739> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3165.discNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3165.critical_wavenumber_numerator_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-daphnia-magna-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength and diffusion ordering" ;
    dct:description "Inhibitor diffuses forty times faster than the activator, the differential-diffusion half of the Turing condition | Variables: D_u, D_v in milli-units; lambda_c fixed at 2736 nm by the length unit" ;
    dct:source "Schnakenberg (1979) 10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5b213d4525d0e9f71d5fc4e385d270b87ac07ec8/models/2026-delphi10000-daphnia-magna-turing-wavelength-s0.py#L55-L68>,
        <https://github.com/fractastical/morpholib/blob/5b213d4525d0e9f71d5fc4e385d270b87ac07ec8/morphoeval/lean/loops/Loop_3165_daphnia_magna_turing_wavelength_s0.lean#L25-L30> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def duMilli : Nat := 16
def dvMilli : Nat := 640
theorem inhibitor_diffuses_forty_times_faster :
    dvMilli = duMilli * 40 ∧ duMilli < dvMilli := by
  decide
"""^^pk:lean4 ;
    skos:notation "lambda_c = 2 pi / k_c,  k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v),  D_v = 40 D_u" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00240009>,
        <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1523/jneurosci.01-09-00945.1981>,
        <https://doi.org/10.2307/2389739> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3165.dvMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3165.inhibitor_diffuses_forty_times_faster" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-daphnia-magna-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Discriminant margin" ;
    dct:description "The strict Turing inequality that opens a band of unstable wavenumbers around k_c | Variables: Same rational Schnakenberg parameters; margin numerator after clearing denominators" ;
    dct:source "Turing (1952) 10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5b213d4525d0e9f71d5fc4e385d270b87ac07ec8/models/2026-delphi10000-daphnia-magna-turing-wavelength-s0.py#L118-L141>,
        <https://github.com/fractastical/morpholib/blob/5b213d4525d0e9f71d5fc4e385d270b87ac07ec8/morphoeval/lean/loops/Loop_3165_daphnia_magna_turing_wavelength_s0.lean#L41-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def marginNumerator : Nat := 22679272279285929721
theorem turing_discriminant_margin_positive :
    marginNumerator > 0 := by
  decide
"""^^pk:lean4 ;
    skos:notation "(D_v f_u + D_u g_v)^2 - 4 D_u D_v (f_u g_v - f_v g_u) > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00240009>,
        <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1523/jneurosci.01-09-00945.1981>,
        <https://doi.org/10.2307/2389739> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3165.marginNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3165.turing_discriminant_margin_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-daphnia-magna-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Scale sandwich and singleton chronoseries" ;
    dct:description "This Holocene terminal has no other chronospecies. The length that changes is the tier, not the age. | Variables: lambda_c = 2736 nm; melanosome predecessor 500 nm; ommatidial successor bound 22000 nm; age 0 Ma" ;
    dct:source "Smith & Macagno (1990) 10.1007/BF00240009; Hebert & Emery (1990) 10.2307/2389739" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/5b213d4525d0e9f71d5fc4e385d270b87ac07ec8/models/2026-delphi10000-daphnia-magna-turing-wavelength-s0.py#L144-L147>,
        <https://github.com/fractastical/morpholib/blob/5b213d4525d0e9f71d5fc4e385d270b87ac07ec8/morphoeval/lean/loops/Loop_3165_daphnia_magna_turing_wavelength_s0.lean#L12-L22> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def lambdaCnm : Nat := 2736
def melanosomeNm : Nat := 500
def ommatidiumNm : Nat := 22000
theorem wavelength_between_melanosome_and_ommatidium :
    melanosomeNm < lambdaCnm ∧ lambdaCnm < ommatidiumNm := by
  decide
"""^^pk:lean4 ;
    skos:notation "500 nm < 2736 nm < 22000 nm, and series index = series length = 1 at 0 Ma" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00240009>,
        <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1523/jneurosci.01-09-00945.1981>,
        <https://doi.org/10.2307/2389739> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3165.lambdaCnm" ;
    pk:leanTheorem "MathOfBiology.Loop_3165.wavelength_between_melanosome_and_ommatidium" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,

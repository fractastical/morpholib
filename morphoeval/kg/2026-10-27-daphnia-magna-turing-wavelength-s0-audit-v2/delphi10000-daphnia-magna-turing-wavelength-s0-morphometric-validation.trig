            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.99999995 1" ;
        schema:measurementTechnique "Pearson r of solver growth rates against σ(k) on nine Fourier modes" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;

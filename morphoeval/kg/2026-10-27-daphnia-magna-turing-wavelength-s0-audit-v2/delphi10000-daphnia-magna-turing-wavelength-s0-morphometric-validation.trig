sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Daphnia magna ocellus-pigment Turing wavelength at 2.736 µm (Holocene, detail scale) — Morphometric validation: 92/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Full-band r = 0.99999995 and held-out r = 0.99999978, both against a reference of 1. RMSE values are 0.000125 and 0.000123 against 0. Coarsening ratio 1.3601 against 1. Cuticle peak 20.17 µm against 2.736 µm. SEM foreground, coherency, aspect ratio, and orientation KS differ from their references. Circularity 0.018 is explained as the folded outline, with aspect ratio 1.43 carrying the shape." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-nonlinear-coarsening-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-simulated-dominant-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-specimen-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-specimen-cuticle-reticulation-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-specimen-vs-field-orientation-ks>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-sweep-lambda-coefficient-of-variation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_amplitude_ratio = 0.286 1" ;
        schema:measurementTechnique "Final/initial activator std when D_v is set equal to D_u" ;
        schema:name "ablation_amplitude_ratio" ;
        schema:unitText "1" ;
        schema:value "0.286" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-ablation-amplitude-ratio-reference> .

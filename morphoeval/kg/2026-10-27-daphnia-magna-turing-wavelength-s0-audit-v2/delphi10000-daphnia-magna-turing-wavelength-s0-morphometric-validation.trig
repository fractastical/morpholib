            pk:EvidenceItem ;
        rdfs:label "nonlinear_coarsening_ratio = 1.3601 1" ;
        schema:measurementTechnique "Saturated wavelength divided by the analytical 2.736 µm. A ratio of 1 would mean no nonlinear shift." ;
        schema:name "nonlinear_coarsening_ratio" ;
        schema:unitText "1" ;
        schema:value "1.3601" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-daphnia-magna-turing-wavelength-s0-measurement-nonlinear-coarsening-ratio-reference> .

<https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Haupaix et al. (2018) & Inaba et al. (2019) somite-prepatterned Agouti signaling and melanocyte gap-junction reaction-diffusion in galliform plumage stripes — Model fidelity to source: 94/100" ;
    dct:date "2026-10-19"^^xsd:date ;

<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-1>,
        <https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-2>,
        <https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-3> .

<https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Somite-Specified Dorsoventral Stripe Period Partition & Exogenous Agouti Bead Reciprocity" ;
    dct:description "Proves conservation of the somite-specified dorsoventral stripe period and exact reciprocal narrowing of adjacent black eumelanin bands upon exogenous Agouti bead implantation | Variables: Lambda: somite-specified dorsoventral stripe period (μm); w_y: Agouti-positive yellow pheomelanin stripe width; delta_bead: exogenous Agouti protein bead expansion" ;
    dct:source "Haupaix et al. (2018) Science 361(6408):eaar4777 Figs. 1 & 4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L115-L260>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L19-L46> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def black_stripe_width (Lambda w_y : Int) : Int := Lambda - w_y
theorem somite_stripe_period_conservation_and_agouti_bead_expansion
    (Lambda w_y delta_bead : Int)
    (hw : 0 ≤ w_y) (hbead : delta_bead > 0) (hcap : w_y + delta_bead ≤ Lambda) :
    w_y + black_stripe_width Lambda w_y = Lambda ∧
    (w_y + delta_bead) + black_stripe_width Lambda (w_y + delta_bead) = Lambda ∧
    w_y + delta_bead > 0 ∧
    black_stripe_width Lambda (w_y + delta_bead) ≥ 0 ∧
    black_stripe_width Lambda (w_y + delta_bead) < black_stripe_width Lambda w_y ∧
    black_stripe_width Lambda (w_y + delta_bead) = black_stripe_width Lambda w_y - delta_bead := by
  unfold black_stripe_width; omega
"""^^pk:lean4 ;
    skos:notation "w_{\\text{yellow}} + w_{\\text{black}} = \\Lambda_{\\text{somite}}; \\quad w_{\\text{black}}(\\Lambda, w_y + \\Delta_{\\text{bead}}) = w_{\\text{black}}(\\Lambda, w_y) - \\Delta_{\\text{bead}}" ;
    prov:wasDerivedFrom <https://doi.org/10.1126/science.1230374>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.1126/science.aaw1969>,
        <https://doi.org/10.1371/journal.pbio.3000448> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_010.black_stripe_width" ;
    pk:leanTheorem "MathOfBiology.Loop_010.somite_stripe_period_conservation_and_agouti_bead_expansion" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Heterospecific Somite-to-Dermis Chimera Donor Autonomy Law" ;
    dct:description "Proves that heterospecific somite grafting between quail, pheasant, and guineafowl autonomously shifts host dermal Agouti stripe width toward the somite donor species | Variables: alpha_pct: percentage donor somite autonomy in chimeric dermis (≈94% in galliform chimeras); w_donor, w_host: donor and host species Agouti stripe widths" ;
    dct:source "Haupaix et al. (2018) Science 361(6408):eaar4777 Fig. 3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L265-L345>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L53-L76> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def chimera_agouti_width_scaled (alpha_pct w_donor w_host : Int) : Int :=
  alpha_pct * w_donor + (100 - alpha_pct) * w_host
theorem interspecific_somite_graft_donor_autonomy
    (w_donor w_host : Int) (h_diff : w_donor > w_host) :
    chimera_agouti_width_scaled 100 w_donor w_host = 100 * w_donor ∧
    chimera_agouti_width_scaled 94 w_donor w_host > 100 * w_host ∧
    chimera_agouti_width_scaled 94 w_host w_donor < 100 * w_donor := by
  unfold chimera_agouti_width_scaled; omega
"""^^pk:lean4 ;
    skos:notation "W_{\\text{chimera}} = \\alpha_{\\text{donor}} w_{\\text{donor}} + (1 - \\alpha_{\\text{donor}}) w_{\\text{host}}; \\quad w_{\\text{donor}} > w_{\\text{host}} \\implies W_{\\text{chimera}} > w_{\\text{host}}" ;
    prov:wasDerivedFrom <https://doi.org/10.1126/science.1230374>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.1126/science.aaw1969>,
        <https://doi.org/10.1371/journal.pbio.3000448> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_010.chimera_agouti_width_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_010.interspecific_somite_graft_donor_autonomy" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Agouti-MC1R Threshold Fate Switch & Connexin40 Melanocyte Reaction-Diffusion Instability" ;
    dct:description "Proves that Agouti threshold antagonism switches melanocytes from black eumelanin (0) to yellow pheomelanin (1) while differential diffusivity (d=20 vs d=1) amplifies periodic stripes aligned to the somite prepattern | Variables: A: dermal Agouti concentration; theta_A: MC1R antagonism threshold; u, v: melanocyte gap-junction activator and long-range inhibitor; d_ratio = D_v/D_u" ;
    dct:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 4; Inaba et al. (2019) Science 363:eaaw1969 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L140-L255>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L83-L116> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def mc1r_pigment_fate (A theta_A : Nat) : Nat := if A ≥ theta_A then 1 else 0
theorem agouti_mc1r_switch_and_cx40_turing_instability :
    mc1r_pigment_fate 75 50 = 1 ∧ mc1r_pigment_fate 0 50 = 0 ∧
    turing_trace 5 (-7) < 0 ∧ turing_det 5 (-7) (-8) 6 > 0 ∧
    turing_cross_term 5 (-7) 1 < 0 ∧ turing_cross_term 5 (-7) 20 > 0 := by decide
"""^^pk:lean4 ;
    skos:notation "F_{\\text{pigment}}(A) = \\mathbb{I}(A \\ge \\theta_A); \\quad \\partial_t u = D_u \\nabla^2 u + f(u,v) + \\beta_A S_{\\text{somite}}(y), \\; \\partial_t v = D_v \\nabla^2 v + g(u,v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1126/science.1230374>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.1126/science.aaw1969>,
        <https://doi.org/10.1371/journal.pbio.3000448> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_010.mc1r_pigment_fate" ;
    pk:leanTheorem "MathOfBiology.Loop_010.agouti_mc1r_switch_and_cx40_turing_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L269–L401" ;
        dcterms:description "5-species panel, 3 chimera grafts, 5-dose Agouti bead sweep, and dual negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L269-L401> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L676–L692" ;
        dcterms:description "CLI parameters for species, bead dose, beta_A, diffusivity ratio d, steps, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L676-L692> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018) & Inaba et al. (2019) somite-prepatterned Agouti signaling and melanocyte gap-junction reaction-diffusion in galliform plumage stripes — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates all 5 comparative galliform species (quail, pheasant, guineafowl, partridge, turkey), 3 heterospecific somite-to-dermis chimera grafts, and 5 exogenous *Agouti* bead / RNAi doses (`-0.65` to `+2.50`), executes dual negative controls (`run_negative_controls`, L383-401) for somitic prepattern ablation (beta_A = 0) and equal diffusion (d = 1.0), and exposes full CLI flags (`--species`, `--bead-dose`, `--beta-agouti`, `--d-ratio`, `--steps`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 010 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

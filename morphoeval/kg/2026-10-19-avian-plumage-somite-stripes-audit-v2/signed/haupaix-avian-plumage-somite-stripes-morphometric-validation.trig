            pk:EvidenceItem ;
        rdfs:label "exogenous Agouti bead (dose=1.6) reciprocal black stripe width w_black = 0.1793 mm" ;
        dcterms:description "yellow expansion = +0.3507 mm, black narrowing = -0.3507 mm, period sum = 0.95 mm" ;
        schema:measurementTechnique "Complementary black eumelanin stripe width w_b = Lambda - w_y under moderate exogenous Agouti bead implantation" ;
        schema:name "exogenous Agouti bead (dose=1.6) reciprocal black stripe width w_black" ;
        schema:unitText "mm" ;
        schema:value "0.1793" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-exogenous-agouti-bead-dose-1-6-reciprocal-black-stripe-width-w-black-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-exogenous-agouti-bead-dose-1-6-reciprocal-black-stripe-width-w-black-reference> a schema:PropertyValue ;
        dcterms:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 4 & Lean Theorem 1 somite_stripe_period_conservation_and_agouti_bead_expansion" ;
        schema:value "0.24" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-japanese-quail-dorsal-yellow-pheomelanin-stripe-width-w-yellow> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Japanese quail dorsal yellow pheomelanin stripe width w_yellow = 0.4258 mm" ;
        dcterms:description "black stripe width w_black = 0.5242 mm (ref 0.53 mm), period sum = 0.95 mm" ;
        schema:measurementTechnique "Somite-prepatterned Agouti + Cx40 reaction-diffusion steady-state yellow stripe width in Coturnix japonica (Lambda = 0.95 mm)" ;
        schema:name "Japanese quail dorsal yellow pheomelanin stripe width w_yellow" ;
        schema:unitText "mm" ;
        schema:value "0.4258" ;

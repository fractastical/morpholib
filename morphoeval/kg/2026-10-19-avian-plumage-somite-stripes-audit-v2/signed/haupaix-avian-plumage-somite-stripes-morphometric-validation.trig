        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018) & Inaba et al. (2019) somite-prepatterned Agouti signaling and melanocyte gap-junction reaction-diffusion in galliform plumage stripes — Morphometric validation: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L573-642) computes 8 reference-backed quantitative morphometrics covering Japanese quail yellow stripe width (0.4252 mm vs 0.42 mm ref), 5-species yellow stripe width Pearson correlation (r = 0.9956), pheasant-to-quail somite chimera yellow stripe width (0.6080 mm vs 0.608 mm ref), exogenous Agouti bead reciprocal black stripe narrowing (0.2408 mm vs 0.24 mm ref), 2D PDE anteroposterior stripe orientation index (O_AP = 0.9806 vs 0.5020 ablated), equal-diffusion negative control suppression (std = 0.0049 vs 0.2478 positive), and segmented *Coturnix japonica* dorsal yellow stripe count (4.0 vs 4.0 ref) and yellow stripe fraction (0.4420 vs 0.4421 ref)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-5-species-galliform-yellow-stripe-width-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-equal-diffusion-d-1-0-negative-control-activator-amplitude-std>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-exogenous-agouti-bead-dose-1-6-reciprocal-black-stripe-width-w-black>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-japanese-quail-dorsal-yellow-pheomelanin-stripe-width-w-yellow>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-pheasant-to-quail-heterospecific-somite-graft-yellow-stripe-width>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-somite-prepatterned-2d-pde-longitudinal-orientation-index-o-ap>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


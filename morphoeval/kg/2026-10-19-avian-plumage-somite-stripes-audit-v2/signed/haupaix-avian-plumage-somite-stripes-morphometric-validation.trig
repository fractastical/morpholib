        schema:unitText "orientation index in [0, 1]" ;
        schema:value "0.975" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-somite-prepatterned-2d-pde-longitudinal-orientation-index-o-ap-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-somite-prepatterned-2d-pde-longitudinal-orientation-index-o-ap-reference> a schema:PropertyValue ;
        dcterms:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 2 & Inaba et al. (2019) Science 363:eaaw1969 Fig. 4" ;
        schema:value "0.92" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L573–L642" ;
        dcterms:description "8 reference-backed morphometric measurements across 2D PDE, 5-species panel, chimeras, beads, controls, and Coturnix japonica specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L573-L642> .


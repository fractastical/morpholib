    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-japanese-quail-dorsal-yellow-pheomelanin-stripe-width-w-yellow-reference> a schema:PropertyValue ;
        dcterms:source "Haupaix et al. (2018) Science 361:eaar4777 Figs. 1-2" ;
        schema:value "0.42" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-pheasant-to-quail-heterospecific-somite-graft-yellow-stripe-width> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pheasant-to-quail heterospecific somite graft yellow stripe width = 0.608 mm" ;
        dcterms:description "shift from quail host = +0.1880 mm (ref +0.188 mm)" ;
        schema:measurementTechnique "Chimeric dermal Agouti yellow stripe width under pheasant somite grafting into quail host (alpha_donor = 0.94)" ;
        schema:name "pheasant-to-quail heterospecific somite graft yellow stripe width" ;
        schema:unitText "mm" ;
        schema:value "0.608" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-pheasant-to-quail-heterospecific-somite-graft-yellow-stripe-width-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-pheasant-to-quail-heterospecific-somite-graft-yellow-stripe-width-reference> a schema:PropertyValue ;
        dcterms:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 3 & Lean Theorem 2 interspecific_somite_graft_donor_autonomy" ;
        schema:value "0.608" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Coturnix japonica dorsal yellow pheomelanin stripe count = 4.0 stripes" ;
        dcterms:description "detected 4 yellow stripes and 4 black stripes, mean period = 35.0 px" ;
        schema:measurementTechnique "Peak detection on Difference-of-Gaussians pheomelanin profile across galliform_chick_stripes_specimen.jpg dorsal ROI [240, 110, 440, 240]" ;
        schema:name "segmented Coturnix japonica dorsal yellow pheomelanin stripe count" ;
        schema:unitText "stripes" ;
        schema:value "4.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-count-reference> a schema:PropertyValue ;
        dcterms:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 1 dorsal longitudinal yellow stripe bands in Coturnix japonica" ;
        schema:value "4.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Coturnix japonica dorsal yellow pheomelanin stripe fraction = 0.442 fraction of dorsal ROI" ;
        dcterms:description "specimen bimodal Ashman D = 2.296 (min threshold 2.2)" ;
        schema:measurementTechnique "Chromatic pheomelanin segmentation on galliform_chick_stripes_specimen.jpg dorsal ROI [240, 110, 440, 240]" ;
        schema:name "segmented Coturnix japonica dorsal yellow pheomelanin stripe fraction" ;
        schema:unitText "fraction of dorsal ROI" ;
        schema:value "0.442" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-fraction-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-fraction-reference> a schema:PropertyValue ;
        dcterms:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 1 Japanese quail yellow-to-total stripe width ratio (0.42 / 0.95)" ;
        schema:value "0.4421" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-somite-prepatterned-2d-pde-longitudinal-orientation-index-o-ap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "somite-prepatterned 2D PDE longitudinal orientation index O_AP = 0.975 orientation index in [0, 1]" ;
        dcterms:description "somite-guided O_AP = 0.9750 vs ablated (beta_A=0) O_AP = 0.4972" ;
        schema:measurementTechnique "Ratio ||grad_y u|| / (||grad_x u|| + ||grad_y u||) measuring anteroposterior stripe alignment with vs without somitic Agouti prepattern" ;

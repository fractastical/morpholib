sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-5-species-galliform-yellow-stripe-width-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-species galliform yellow stripe width correlation r = 0.9956 Pearson r" ;
        dcterms:description "r = 0.9956 (p = 3.49e-04), RMSE = 0.0675 mm" ;
        schema:measurementTechnique "Pearson correlation between simulated and empirical yellow stripe widths across quail, pheasant, guineafowl, partridge, and turkey" ;
        schema:name "5-species galliform yellow stripe width correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9956" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-5-species-galliform-yellow-stripe-width-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-5-species-galliform-yellow-stripe-width-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Haupaix et al. (2018) Science 361:eaar4777 Figs. 1-2 comparative galliform dataset" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-equal-diffusion-d-1-0-negative-control-activator-amplitude-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (d=1.0) negative control activator amplitude std = 0.003331 std(u)" ;
        dcterms:description "positive d=20 std = 0.2485 vs equal-diffusion d=1 std = 3.33e-03" ;
        schema:measurementTechnique "Activator standard deviation at equal diffusivity d = Dv/Du = 1.0 (Cx40/inhibitor differential diffusion ablated)" ;
        schema:name "equal-diffusion (d=1.0) negative control activator amplitude std" ;
        schema:unitText "std(u)" ;
        schema:value "0.003331" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-equal-diffusion-d-1-0-negative-control-activator-amplitude-std-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-equal-diffusion-d-1-0-negative-control-activator-amplitude-std-reference> a schema:PropertyValue ;
        dcterms:source "Inaba et al. (2019) Science 363:eaaw1969 & Lean Theorem 3 agouti_mc1r_switch_and_cx40_turing_instability" ;
        schema:value "0.0" .


        dcterms:title "The periodicelly striped plumage of galliform chicks is prepatterned by somitic Agouti signaling" .

    <https://doi.org/10.1126/science.aaw1969> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "Instructive role of melanocytes during body pigment pattern formation" .


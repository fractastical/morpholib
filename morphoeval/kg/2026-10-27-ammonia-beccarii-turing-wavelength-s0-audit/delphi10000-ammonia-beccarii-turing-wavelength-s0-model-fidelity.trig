sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Ammonia beccarii Turing wavelength at 31 µm, Holocene 0 Ma — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script implements the Schnakenberg steady state, Jacobian, Turing inequality, critical wavenumber k_c² = γ (Dv f_u + Du g_v) / (2 Du Dv), and λ_c = 2π/k_c, with γ solved so λ_c = 31.37 µm. The linearised Fourier monodromy matches analytical σ at Pearson r = 0.9999997 (RMSE about 2.5e-5 /τ after rounding in the sidecar). Equal diffusion gives σ(k_c) = −0.055. Four Lean theorems encode the margin, the 19-wavelength count, the pore/detail/test ordering, and the Holocene terminal; they were not kernel-checked because Lean 4 is not installed. The kinetics are Schnakenberg's, not a foraminiferal calcification law." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity-4> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py L1–L36" ;
        dct:description "docstring states the PDE, k_c, λ_c = 31.37 µm, and the 0 Ma chronoseries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a491e0e4871f38b92696ac7909d8a014270fb92c/models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py#L1-L36> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py L93–L157" ;
        dct:description "Jacobian, γ(λ), σ(k²), and the unstable-band edges" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a491e0e4871f38b92696ac7909d8a014270fb92c/models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py#L93-L157> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py L159–L214" ;
        dct:description "monodromy comparison of numerical and analytical σ(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a491e0e4871f38b92696ac7909d8a014270fb92c/models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py#L159-L214> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3108_ammonia_beccarii_turing_wavelength_s0.lean L14–L44" ;
        dct:description "four theorems, 0 sorry; not executed in this environment" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a491e0e4871f38b92696ac7909d8a014270fb92c/morphoeval/lean/loops/Loop_3108_ammonia_beccarii_turing_wavelength_s0.lean#L14-L44> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass; no second provider)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Ammonia beccarii Turing wavelength at 31 µm, Holocene 0 Ma faithfully reproduces Ammonia beccarii (benthic foraminifer) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Ammonia beccarii (benthic foraminifer) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py; output: docs/media/ammonia_beccarii_turing_wavelength_s0_comparison.png; organism: Ammonia beccarii (benthic foraminifer); environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and critical wavenumber | Schnakenberg 1979 kinetics | Hillewaert 2012 caption diameter ~600 µm, 500 µm scale bar, CC BY-SA 4.0 plate | Subba & Ghosh 2023 pore diameter 0.564 µm and pore density 0.155 µm⁻² for Ammonia cf. beccarii | Petersen et al. 2016 pore frame of 562 µm² | Hayward et al. 2004 and Schönfeld et al. 2021 limits on the name A. beccarii; reconstructed_in_script: γ chosen so linear λ_c = 31.37 µm | Dv = 10.4 µm²/τ narrow band | Nonlinear field, γ sweep, equal-diffusion control, γ = 0 ablation | Segmentation of the plate and mapping of the field onto each test; transfer_boundary: Pigment-stripe / ocellus cohort language is transferred onto calcite pustule spacing | AFM pore numbers are Ammonia cf. beccarii, not the photographed North Sea individuals | 31.37 µm is the Delphi detail-scale assignment, not a spacing tabulated for this species; does_not_claim: That Ammonia beccarii has pigment ocelli | That 31.37 µm equals the pore diameter | That a predecessor or successor chronospecies exists in this 1/1 series | That the species-gallery Caryophyllia file is Ammonia | That the North Sea photograph is a sequenced Adriatic type]; other sources: Ammonia beccarii (Linnaeus, 1758), six tests, Belgian North Sea <https://commons.wikimedia.org/wiki/File:Ammonia_beccarii.jpg>; phenomenon_size: 3.5 cm (0.0352 m, log10=-1.453 m, tier=7_organism_cm); species_scale_ladder (1 runs from 3.5 cm to 3.5 cm): 3.5 cm:foraminifera-apertural-growth" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/S0377-8398(03)00074-4>,
            <https://doi.org/10.1016/j.marmicro.2016.08.001>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.2113/gsjfr.53.2.177>,
            <https://doi.org/10.5194/jm-40-195-2021> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


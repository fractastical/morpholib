sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Ammonia beccarii Turing wavelength at 31 µm, Holocene 0 Ma — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Linear σ matches the monodromy at r = 0.9999997. The γ sweep matches at r = 0.995 (RMSE 0.94 µm). The 160² saturated FFT peak is 32.88 µm against the linear target 31.37 µm (4.8% longer; not a copy of the reference). Spot-spacing CV is 0.14 and the KS distance to Normal(31.37 µm, band half-width) is 0.27. The plate yields 6 tests. Bounding-box diameters average 769.7 µm against the caption ~600 µm (reference 600, value not equal). Foreground fraction 0.420 versus the full-resolution signature 0.440. Coherency at σ = 1.6 px is 0.576 versus 0.487 at σ = 2.8 px. The diameter offset is the open gap." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-diffusion-ablation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-gamma-sweep-predicted-vs-measured-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-linear-dispersion-pearson-r-vs-numerical-fourier-growth>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-saturated-spot-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-segmented-test-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-segmented-mean-test-diameter>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-spot-spacing-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-diffusion-ablation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusion ablation std ratio = 0.1165 std_final/std_initial" ;
        dct:description "ablation control" ;
        schema:measurementTechnique "γ = 0 pure diffusion of a noise seed for 400 steps, versus the patterned run" ;
        schema:name "diffusion ablation std ratio" ;
        schema:unitText "std_final/std_initial" ;
        schema:value "0.1165" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-diffusion-ablation-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-diffusion-ablation-std-ratio-reference> a schema:PropertyValue ;
        dct:source "no decay if the pattern were not diffusion-limited" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion KS statistic = 0.0455 KS distance" ;
        dct:description "p=1" ;
        schema:measurementTechnique "two-sample KS between analytical and numerical σ samples" ;
        schema:name "dispersion KS statistic" ;
        schema:unitText "KS distance" ;
        schema:value "0.0455" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 2.5e-05 1/τ" ;
        schema:measurementTechnique "root mean square of analytical minus numerical σ(k)" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/τ" ;
        schema:value "2.5e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual of a perfect integrator" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control sigma_max = -0.054621 1/τ" ;
        dct:description "negative control: equal diffusion must decay" ;
        schema:measurementTechnique "σ(k_c) with Dv reset to Du; Turing requires Dv f_u + Du g_v > 0" ;
        schema:name "equal-diffusion control sigma_max" ;
        schema:unitText "1/τ" ;
        schema:value "-0.054621" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "marginal stability" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-gamma-sweep-predicted-vs-measured-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "gamma sweep predicted vs measured wavelength Pearson r = 0.9949 Pearson r" ;
        dct:description "RMSE 0.943 µm; predicted [37.49432147481993, 34.025542308856224, 31.37, 28.636761048228433, 26.05136703011823, 23.381817484722802]; measured [38.729183245398886, 34.26880997948951, 31.18235201808591, 27.779020210405303, 24.35939745297053, 23.03280501731194]" ;
        schema:measurementTechnique "six γ factors; linear λ_c(γ) versus FFT wavelength of the saturated field" ;
        schema:name "gamma sweep predicted vs measured wavelength Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9949" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-gamma-sweep-predicted-vs-measured-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-gamma-sweep-predicted-vs-measured-wavelength-pearson-r-reference> a schema:PropertyValue ;
        dct:source "λ ∝ γ^(−1/2) with no nonlinear shift" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-linear-dispersion-pearson-r-vs-numerical-fourier-growth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear dispersion Pearson r vs numerical Fourier growth = 1.0 Pearson r" ;
        dct:description "RMSE = 2.47123e-05 1/τ over 0.045454545454545525 KS; n modes in metrics JSON" ;
        schema:measurementTechnique "linearised Schnakenberg PDE on exact Fourier modes versus σ(k) from det(γJ − k²D − σI)=0" ;
        schema:name "linear dispersion Pearson r vs numerical Fourier growth" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-linear-dispersion-pearson-r-vs-numerical-fourier-growth-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-linear-dispersion-pearson-r-vs-numerical-fourier-growth-reference> a schema:PropertyValue ;
        dct:source "exact match of the discrete dispersion relation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-saturated-spot-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "saturated spot wavelength = 32.876 µm" ;
        schema:measurementTechnique "parabolic-refined radial FFT peak of the nonlinear activator on the 600 µm face" ;
        schema:name "saturated spot wavelength" ;
        schema:unitText "µm" ;
        schema:value "32.876" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-saturated-spot-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-saturated-spot-wavelength-reference> a schema:PropertyValue ;
        dct:source "linear λ_c = 31.37 µm = 3.137e-05 m (this slot, not a published pore spacing)" ;
        schema:value "31.37" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-segmented-test-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented test count = 6 count" ;
        dct:description "the plate shows six tests; the count is measured, not copied from a parameter" ;
        schema:measurementTechnique "connected components on the Hillewaert plate after rejecting the scale bar and caption by area and circularity" ;
        schema:name "segmented test count" ;
        schema:unitText "count" ;
        schema:value "6" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.4203 area fraction" ;
        schema:measurementTechnique "fraction of the 720×540 plate covered by tests with circularity > 0.45 after opening and hole fill" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.4203" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "verify_image_fitness.compute_specimen_cv_signature foreground_fraction on the full-resolution JPEG (different mask)" ;
        schema:value "0.4404" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-segmented-mean-test-diameter> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen segmented mean test diameter = 769.685 µm" ;
        dct:description "n=6; diameters=[736.220472440945, 795.2755905511812, 696.8503937007874, 889.7637795275591, 748.0314960629921, 751.9685039370079]; CV=0.07917380912620081" ;
        schema:measurementTechnique "equivalent circular diameter of each filled test on the resized plate, scaled by the detected 500 µm bar" ;
        schema:name "specimen segmented mean test diameter" ;
        schema:unitText "µm" ;
        schema:value "769.685" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-segmented-mean-test-diameter-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-segmented-mean-test-diameter-reference> a schema:PropertyValue ;
        dct:source "Hillewaert 2012 caption diameter ~600 µm" ;
        schema:value "600.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5762 coherency" ;
        schema:measurementTechnique "mean (λ1−λ2)/(λ1+λ2) inside the segmented tests, Gaussian σ = 1.6 px on the 720×540 plate" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5762" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "same plate, structure tensor at σ = 2.8 px (a different filter scale, not a copy of the value)" ;
        schema:value "0.4869" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-spot-spacing-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "spot spacing CV = 0.1407 CV" ;
        dct:description "mean spacing 29.20313748718024 µm; KS vs Normal(31.37 µm) = 0.2699510911364592" ;
        schema:measurementTechnique "std/mean of nearest-neighbour distances between activator peaks" ;
        schema:name "spot spacing CV" ;
        schema:unitText "CV" ;
        schema:value "0.1407" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-spot-spacing-cv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-measurement-spot-spacing-cv-reference> a schema:PropertyValue ;
        dct:source "a perfectly regular lattice" ;
        schema:value "0.0" .

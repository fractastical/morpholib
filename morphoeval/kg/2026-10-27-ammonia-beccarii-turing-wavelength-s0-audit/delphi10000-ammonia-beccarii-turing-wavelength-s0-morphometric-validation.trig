    <https://commons.wikimedia.org/wiki/File:Ammonia_beccarii.jpg> dct:date "2012"^^xsd:gYear ;
        dct:title "Ammonia beccarii (Linnaeus, 1758), six tests, Belgian North Sea" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .

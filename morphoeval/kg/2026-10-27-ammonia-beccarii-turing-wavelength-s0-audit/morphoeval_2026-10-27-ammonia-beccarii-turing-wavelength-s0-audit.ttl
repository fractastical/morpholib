<https://w3id.org/delphi/resource/math-law/delphi10000-ammonia-beccarii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion margin at the 31.37 µm operating point" ;
    dct:description "Shows the Holocene 31 µm detail band is linearly unstable | Variables: Du=1, Dv=10.4, fu=0.76, gv=-1, det=1 at a=0.12, b=0.88" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012; Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a491e0e4871f38b92696ac7909d8a014270fb92c/models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py#L130-L157>,
        <https://github.com/fractastical/morpholib/blob/a491e0e4871f38b92696ac7909d8a014270fb92c/morphoeval/lean/loops/Loop_3108_ammonia_beccarii_turing_wavelength_s0.lean#L14-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(Dv f_u + Du g_v)^2 > 4 Du Dv det(J), cleared as 744769*5 > 208*15625" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0377-8398(03)00074-4>,
        <https://doi.org/10.1016/j.marmicro.2016.08.001>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2113/gsjfr.53.2.177>,
        <https://doi.org/10.5194/jm-40-195-2021> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;

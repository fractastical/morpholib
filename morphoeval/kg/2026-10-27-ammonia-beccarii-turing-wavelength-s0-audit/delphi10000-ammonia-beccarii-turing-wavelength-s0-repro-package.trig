sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Ammonia beccarii Turing wavelength at 31 µm, Holocene 0 Ma — Reproducibility package: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Seed 3108, pinned SHA-256 inputs, --self-test (dispersion r > 0.98, sweep r > 0.98, band membership, age 0, chronoseries 1/1, GIF ≥ 10 frames and ≥ 480 px). The pass-1 run printed PASS with saturated λ = 32.88 µm, 6 tests, 12 frames at 720×540. Dependencies are the environment's numpy/scipy/Pillow/matplotlib, not a per-script lockfile. Lean was not executed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-repro-package-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py L600–L635" ;
        dct:description "self-test assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a491e0e4871f38b92696ac7909d8a014270fb92c/models/2026-delphi10000-ammonia-beccarii-turing-wavelength-s0.py#L600-L635> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ammonia-beccarii-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/ammonia_beccarii_turing_wavelength_s0/README.md L1–L38" ;
        dct:description "scale 31 µm and age 0 Ma, and the two invocation lines" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a491e0e4871f38b92696ac7909d8a014270fb92c/datasets/ammonia_beccarii_turing_wavelength_s0/README.md#L1-L38> .

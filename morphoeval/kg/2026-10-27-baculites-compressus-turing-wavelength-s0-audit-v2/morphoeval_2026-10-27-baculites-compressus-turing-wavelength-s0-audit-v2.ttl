<https://w3id.org/delphi/resource/math-law/delphi10000-baculites-compressus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Sign of the critical-wavenumber numerator at the 94.16 µm detail scale | Variables: dv, fu, du, gv positive when the inhibitor is long-range" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8f0ebbb7583b60dab933158a86eda8e291baab3e/models/2026-delphi10000-baculites-compressus-turing-wavelength-s0.py#L111-L118>,
        <https://github.com/fractastical/morpholib/blob/8f0ebbb7583b60dab933158a86eda8e291baab3e/morphoeval/lean/loops/Loop_3131_baculites_compressus_turing_wavelength_s0.lean#L53-L63> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = D_u D_v k^4 - (D_v f_u + D_u g_v) k^2 + (f_u g_v - f_v g_u)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0022-5193(87)80101-7>,
        <https://doi.org/10.1017/S0016756800146023>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2307/3515325> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3131.kcSqNum" ;
    pk:leanTheorem "MathOfBiology.Loop_3131.turing_wavenumber_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-baculites-compressus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical intrinsic wavelength" ;
    dct:description "Pins Baculites compressus at 94.16 µm when chi = 1 and r = 9.2 | Variables: lambda stored as 9416 hundredths of a micrometre" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8f0ebbb7583b60dab933158a86eda8e291baab3e/models/2026-delphi10000-baculites-compressus-turing-wavelength-s0.py#L99-L108>,
        <https://github.com/fractastical/morpholib/blob/8f0ebbb7583b60dab933158a86eda8e291baab3e/morphoeval/lean/loops/Loop_3131_baculites_compressus_turing_wavelength_s0.lean#L46-L49> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c, k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0022-5193(87)80101-7>,
        <https://doi.org/10.1017/S0016756800146023>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2307/3515325> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3131.lambdaBaculites" ;
    pk:leanTheorem "MathOfBiology.Loop_3131.eight_wavelength_detail_window" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-baculites-compressus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Aperture readout along the suture series" ;
    dct:description "What changes at 73.5 Ma versus Placenticeras meeki and Nipponites mirabilis | Variables: chi is the only series parameter; a, b, and r stay fixed" ;
    dct:source "Meinhardt and Klingler (1987) DOI:10.1016/S0022-5193(87)80101-7" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8f0ebbb7583b60dab933158a86eda8e291baab3e/models/2026-delphi10000-baculites-compressus-turing-wavelength-s0.py#L244-L265>,
        <https://github.com/fractastical/morpholib/blob/8f0ebbb7583b60dab933158a86eda8e291baab3e/morphoeval/lean/loops/Loop_3131_baculites_compressus_turing_wavelength_s0.lean#L34-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_physical = chi * lambda_c, with chi_P = 3/2 > chi_B = 1 > chi_N = 6215/9416" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/S0022-5193(87)80101-7>,
        <https://doi.org/10.1017/S0016756800146023>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2307/3515325> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3131.lambdaPlacenticeras" ;
    pk:leanTheorem "MathOfBiology.Loop_3131.chronoseries_wavelength_order" ;
    pk:leanVerified true .


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-033> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-033-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-033-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-033 golden divergence & Fibonacci parastichies — Morphometric validation: 50/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "RMSE/Pearson fit present but no KS test or ablation controls in Pass 1." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py L132–L145: fit_vogel_to_specimen without Pass 2 stats <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py#L132-L145>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-ablation-golden-beats-90deg-nnd-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-empirical-divergence-angle-deg>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-ks-golden-vs-120deg-nnd-pvalue>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-vogel-fit-pearson-r-radial>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-vogel-fit-rmse-px>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-within-thompson-golden-bracket> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-ablation-golden-beats-90deg-nnd-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation_golden_beats_90deg_nnd_cv = 1.0 bool" ;
        schema:measurementTechnique "Golden angle NND-CV lower than 90 deg negative control" ;
        schema:name "ablation_golden_beats_90deg_nnd_cv" ;
        schema:unitText "bool" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-empirical-divergence-angle-deg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "empirical_divergence_angle_deg = 134.1 deg" ;
        schema:measurementTechnique "Vogel-fit lattice inversion on DoG-segmented specimen centroids" ;
        schema:name "empirical_divergence_angle_deg" ;
        schema:unitText "deg" ;
        schema:value "134.1" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-empirical-divergence-angle-deg-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-empirical-divergence-angle-deg-reference> a schema:PropertyValue ;
        schema:value "137.50776405003785" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-ks-golden-vs-120deg-nnd-pvalue> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ks_golden_vs_120deg_nnd_pvalue = 2.8044233222948308e-142 p" ;
        schema:measurementTechnique "Two-sample KS on interior nearest-neighbor distances" ;
        schema:name "ks_golden_vs_120deg_nnd_pvalue" ;
        schema:unitText "p" ;
        schema:value "2.8044233222948308e-142" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-vogel-fit-pearson-r-radial> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vogel_fit_pearson_r_radial = 0.9914348611330422 1" ;
        schema:measurementTechnique "Pearson r on sorted radial coordinates" ;
        schema:name "vogel_fit_pearson_r_radial" ;
        schema:unitText "1" ;
        schema:value "0.9914348611330422" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-vogel-fit-rmse-px> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vogel_fit_rmse_px = 11.228132456981662 px" ;
        schema:measurementTechnique "Nearest-neighbor RMSE vs golden Vogel spiral aligned by radial scale" ;
        schema:name "vogel_fit_rmse_px" ;
        schema:unitText "px" ;
        schema:value "11.228132456981662" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-033-measurement-within-thompson-golden-bracket> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "within_thompson_golden_bracket = 1.0 bool" ;
        schema:measurementTechnique "135-138.5 deg or within 4 deg of golden angle" ;
        schema:name "within_thompson_golden_bracket" ;
        schema:unitText "bool" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0002-1825-0097> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-033> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-033-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-033-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-033 golden divergence & Fibonacci parastichies — MorphoEval overall 63.0/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Pass 1 baseline validates repository IN_REPO Helianthus specimen and Vogel golden spiral geometry but uses naive rank-order divergence estimation and omits statistical goodness-of-fit. Overall 63.0/100 (faithfulness 57.3, reproducibility 76.4); rubric morphoeval 0.1.0; checkpoint commit f1d96f32ba3f00517c53e9cd007634306cc8d4f4; environment: . Dimension assessments: Model fidelity to source 74, Morphological realism / specimen match 52, Parameter expressivity 48, Morphometric validation 50, Source and data traceability 82, Code-to-model traceability 70, Reproducibility package 76. Output judged: docs/media/t1917_033_on_leaf_arrangement_or_phyllot_comparison.png: rendered output of thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py at f1d96f32ba3f00517c53e9cd007634306cc8d4f4, image/png, 1185844 B, 1800×1500 px, artifact_sha256 a41a664a49552536ae6c4c7f77c45a3410e1f17c5c7dd91e9396cc140957071b (sha256 a41a664a49552536ae6c4c7f77c45a3410e1f17c5c7dd91e9396cc140957071b), spec_fingerprint 76e623bd0fb2355aebb0e2e097002b099b16ff9048a213066b74c6c94c38eddc. Dual provenance: spec_fingerprint: 76e623bd0fb2355aebb0e2e097002b099b16ff9048a213066b74c6c94c38eddc; artifact_sha256: a41a664a49552536ae6c4c7f77c45a3410e1f17c5c7dd91e9396cc140957071b; input_dataset_sha256: {datasets/thompson_1917/t1917-033/helianthus_annuus_capitulum_specimen.jpg=c76483eea3e564fe..., datasets/thompson_1917/t1917-033/paper_citations.bib=37c65304ef58f6d6..., datasets/thompson_1917/t1917-033/t1917_033_on_leaf_arrangement_or_phyllot_reference.json=a83fc6bfda2f2469...}. Claim boundary: reported_in_source: Thompson (1917) states leaf/floret divergence approximates the golden angle ~137.5 deg with rational convergents 1/2, 1/3, 2/5, 3/8 and Fibonacci parastichy numbers; reconstructed_in_script: Vogel (1979) spiral placement, Thompson rational angle table, DoG specimen segmentation, rising parastichy cascade on simulated capitulum; does_not_claim: Pass 1 does not run full parameter-regime sweep, KS tests, or Vogel-fit lattice inversion for empirical alpha." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add Vogel-fit lattice inversion scan for empirical divergence angle on segmented specimen centroids",
            "remediation needed: Enable PASS2 panel D bar chart and write headline_numbers to result.json with supported verdict",
            "remediation needed: Report Pearson r, RMSE, KS test between golden vs distichous NND distributions",
            "remediation needed: Run full Thompson rational-angle parameter sweep with NND-CV ablation vs 90 deg and 120 deg controls" ;
        pk:hasScore "0.63"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0000-0002-1825-0097> ;
        foaf:homepage <https://deepmind.google> .
}


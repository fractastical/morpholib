sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics — Morphometric validation: 50/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports only 3 analytical scalars in `measure_morphoeval()` (L123-155) without validating inter-ray angles and lamellar fracture toughness across the 12 empirical Hexactinellida, Demospongiae, and Calcarea species or extracting empirical strut angles and lattice pitch from the *Euplectella* specimen image." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-bavestrello-sponge-spicule-hexactin.py L123–L155: Only 3 analytical metrics without 12-species cross-taxa or specimen CV validation <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L123-L155>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-euplectella-25-layer-laminated-vs-monolithic-fracture-energy-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-hexactin-o-h-adjacent-inter-ray-angle>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-tetractin-t-d-tetrahedral-calthrop-inter-ray-angle> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-euplectella-25-layer-laminated-vs-monolithic-fracture-energy-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Euplectella 25-layer laminated vs monolithic fracture energy ratio = 9.0 ratio (G_lam / G_mono)" ;
        schema:measurementTechnique "Analytical crack-deflection toughness amplification 1 + eta * N for N=25 layers" ;
        schema:name "Euplectella 25-layer laminated vs monolithic fracture energy ratio" ;
        schema:unitText "ratio (G_lam / G_mono)" ;
        schema:value "9.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-euplectella-25-layer-laminated-vs-monolithic-fracture-energy-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-euplectella-25-layer-laminated-vs-monolithic-fracture-energy-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Aizenberg et al. (2005) Science 309:275-278" ;
        schema:value "9.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-hexactin-o-h-adjacent-inter-ray-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hexactin O_h adjacent inter-ray angle = 90.0 deg" ;
        schema:measurementTechnique "Pairwise dot product arccos(u_1 . u_3) of orthogonal cubic hexactin rays" ;
        schema:name "Hexactin O_h adjacent inter-ray angle" ;
        schema:unitText "deg" ;
        schema:value "90.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-hexactin-o-h-adjacent-inter-ray-angle-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-hexactin-o-h-adjacent-inter-ray-angle-reference> a schema:PropertyValue ;
        dcterms:source "Uriz et al. (2003) Microsc. Res. Tech. 62:279-299" ;
        schema:value "90.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-tetractin-t-d-tetrahedral-calthrop-inter-ray-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Tetractin T_d tetrahedral calthrop inter-ray angle = 109.4712 deg" ;
        schema:measurementTechnique "Pairwise dot product arccos(-1/3) of tetrahedral calthrop rays" ;
        schema:name "Tetractin T_d tetrahedral calthrop inter-ray angle" ;
        schema:unitText "deg" ;
        schema:value "109.4712" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-tetractin-t-d-tetrahedral-calthrop-inter-ray-angle-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-tetractin-t-d-tetrahedral-calthrop-inter-ray-angle-reference> a schema:PropertyValue ;
        dcterms:source "Uriz et al. (2003) Microsc. Res. Tech. 62:279-299" ;
        schema:value "109.4712" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


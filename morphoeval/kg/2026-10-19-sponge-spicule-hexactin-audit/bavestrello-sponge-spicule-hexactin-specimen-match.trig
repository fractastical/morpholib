sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics — Morphological realism / specimen match: 24/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Renders a 2-panel synthetic vector and thickness plot (L82-104) without loading, SHA-256-verifying, or segmenting the vendored *Euplectella aspergillum* glass sponge lattice specimen (`datasets/sponge_spicule_hexactin/euplectella_aspergillum_specimen.jpg`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2012-bavestrello-sponge-spicule-hexactin.py L82–L104: 2-panel synthetic figure with zero biological specimen segmentation <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L82-L104>",
            "docs/media/sponge_spicule_hexactin_comparison.png (generated output, not in repo): Pass 1 2-panel synthetic plot lacking Euplectella specimen overlay — docs/media/sponge_spicule_hexactin_comparison.png: rendered output of 2012-bavestrello-sponge-spicule-hexactin.py at HEAD, image/png, 137945 B, 1278×584 px, artifact_sha256 483d6b704516bf84cc1c8b19e78bac055ce86a7f3b9ca3c9f8e46db339204f21 (sha256 483d6b704516bf84cc1c8b19e78bac055ce86a7f3b9ca3c9f8e46db339204f21), spec_fingerprint a5bee59a94597f4d966c69c524721cb2d57ff58a497dff220c73adc1f47687dd" ;
        pk:hasScore "0.24"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


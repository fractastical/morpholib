sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> a pk:Claim ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics faithfully reproduces Euplectella aspergillum (Hexactinellida) & Tethya aurantia / Pachastrella monilifera (Demospongiae) / Sycon raphanus (Calcarea) morphology" ;
        dct:description "The simulation script(s) 2012-bavestrello-sponge-spicule-hexactin.py implement the cited source model as published and produce forms that match real Euplectella aspergillum (Hexactinellida) & Tethya aurantia / Pachastrella monilifera (Demospongiae) / Sycon raphanus (Calcarea) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 48.7/100, audit 2026-10-19-sponge-spicule-hexactin-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py; output: docs/media/sponge_spicule_hexactin_comparison.png; organism: Euplectella aspergillum (Hexactinellida) & Tethya aurantia / Pachastrella monilifera (Demospongiae) / Sycon raphanus (Calcarea); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: a5bee59a94597f4d966c69c524721cb2d57ff58a497dff220c73adc1f47687dd; artifact_sha256: 483d6b704516bf84cc1c8b19e78bac055ce86a7f3b9ca3c9f8e46db339204f21; input_dataset_sha256: {datasets/sponge_spicule_hexactin/euplectella_aspergillum_specimen.jpg=b56275f43e5ea078..., datasets/sponge_spicule_hexactin/scout_manifest.json=fb6e06653d9d14ac..., datasets/sponge_spicule_hexactin/sponge_spicule_hexactin_reference.json=b9dd33b60b05730c...}" ;
        pk:derivedFromPaper <https://doi.org/10.1002/jemt.10395>,
            <https://doi.org/10.1016/j.jsb.2007.01.006>,
            <https://doi.org/10.1073/pnas.95.11.6234>,
            <https://doi.org/10.1126/science.1112255> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match> ;
        pk:weightOfEvidence "0.487"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py> a schema:SoftwareSourceCode ;
        rdfs:label "2012-bavestrello-sponge-spicule-hexactin.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "HEAD" .
}


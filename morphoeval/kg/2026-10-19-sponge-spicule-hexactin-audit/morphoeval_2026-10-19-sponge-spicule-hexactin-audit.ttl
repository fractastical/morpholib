    pk:hasScore 6.2e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics — Model fidelity to source: 55/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Computes static O_h hexactin and T_d tetractin unit vectors and a 1D inverse-radius lamellar thickness sequence (L30-79), but lacks a 3D reaction-diffusion biosilica accretion solver around axial silicatein filaments, omits D_inf_h monaxon (180 deg) and D_3h triactine (120 deg) regimes, omits silicatein-inhibited ablation (k_cat=0), and omits *Euplectella* checkerboard diagonal lattice shear stiffness mechanics." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2012-bavestrello-sponge-spicule-hexactin.py L30–L79: Static ray vectors and 1D lamellar series without 3D biosilica accretion PDE or checkerboard lattice mechanics <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L30-L79>" ;
    pk:hasScore 5.5e-01 ;
    pk:hasVerdict "partially faithful" .


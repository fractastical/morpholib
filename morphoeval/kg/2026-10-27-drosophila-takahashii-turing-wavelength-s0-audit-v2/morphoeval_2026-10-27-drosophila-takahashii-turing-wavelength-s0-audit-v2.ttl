<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-takahashii-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Twelve wavelengths span the 28.344 µm chart" ;
    dct:description "Domain used for the periodic Schnakenberg integration at this detail scale | Variables: lambda_c = 2.362 µm; L = 28.344 µm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; slot scale 2.362e-06 m" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/12c1685418b29b353dac76e72a07fc55dd94800c/models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/12c1685418b29b353dac76e72a07fc55dd94800c/morphoeval/lean/loops/Loop_3208_drosophila_takahashii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L = 12 * lambda_c,  12 * 2362 nm = 28344 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rspb.2013.2840>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142x.2011.00507.x> ;
    pk:hypothesisType "Reaction-Diffusion and Turing dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3208.domainNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3208.twelve_wavelengths_span_the_chart" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-takahashii-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength from the dispersion peak" ;
    dct:description "Selects the 2.362 µm pigment-lattice wavenumber, 41 times inside the suzukii envelope | Variables: a=0.162, b=1.247, Du=0.042744, Dv=0.97157" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/12c1685418b29b353dac76e72a07fc55dd94800c/models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/12c1685418b29b353dac76e72a07fc55dd94800c/morphoeval/lean/loops/Loop_3208_drosophila_takahashii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2*pi/k_c, k_c = argmax sigma(k), sigma = 0.5*(tr + sqrt(tr^2 - 4*det))" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rspb.2013.2840>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142x.2011.00507.x> ;
    pk:hypothesisType "Reaction-Diffusion and Turing dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3208.lambdaDetailNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3208.detail_shorter_than_suzukii_envelope" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-takahashii-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Envelope lengthening does not rescale the detail wavelength" ;
    dct:description "Chronoseries contrast at Holocene 0 Ma, index 37/41 | Variables: suzukii 98450 nm; takahashii 2362 nm; teissieri 107000 nm; age 0 Ma" ;
    dct:source "Atallah et al. 2014 DOI:10.1098/rspb.2013.2840; Kopp 2011 DOI:10.1111/j.1525-142x.2011.00507.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/12c1685418b29b353dac76e72a07fc55dd94800c/models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/12c1685418b29b353dac76e72a07fc55dd94800c/morphoeval/lean/loops/Loop_3208_drosophila_takahashii_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_teissieri - lambda_suzukii = 8550 nm and lambda_detail < both envelopes" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1073/pnas.0807875106>,
        <https://doi.org/10.1098/rspb.2013.2840>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1525-142x.2011.00507.x> ;
    pk:hypothesisType "Reaction-Diffusion and Turing dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3208.lambdaTeissieriEnvelopeNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3208.successor_envelope_lengthens_without_rescaling_detail" ;
    pk:leanVerified true .


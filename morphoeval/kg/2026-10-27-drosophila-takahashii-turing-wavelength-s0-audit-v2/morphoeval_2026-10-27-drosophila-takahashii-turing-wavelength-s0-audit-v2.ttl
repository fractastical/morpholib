<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Drosophila takahashii Schnakenberg Turing wavelength at 2.362 µm (Pass 2 specimen composite) (Drosophila takahashii)",
        "Drosophila takahashii Schnakenberg Turing wavelength at 2.362 µm (Pass 2 specimen composite) faithfully reproduces Drosophila takahashii morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-takahashii-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-takahashii-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-takahashii-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila takahashii specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py> ;
    schema:about "Drosophila takahashii" ;
    schema:additionalProperty "does_not_claim: That D. takahashii carries the D. suzukii apical wing spot",
        "does_not_claim: That a wet-lab paper reports 2.362 µm for a D. takahashii ocellus",
        "does_not_claim: That the narrow dark core (area 0.053) is the entire fly silhouette",
        "reconstructed_in_script: Dispersion Pearson/KS, Dv sweep, and equal-diffusion ablation",
        "reconstructed_in_script: Parameters a=0.162, b=1.247, Du=0.042744, Dv=0.971570 placing λ_c at 2.362 µm",
        "reconstructed_in_script: Smoothed 22nd-percentile body mask and the lattice-to-plate crossfade",
        "reported_in_source: Atallah et al. 2014 on Drosophila suzukii and its close relatives",
        "reported_in_source: Murray 1981 wavelength set by the diffusion scale",
        "reported_in_source: Schnakenberg 1979 two-species kinetics with a cubic autocatalytic term",
        "reported_in_source: Tanaka, Barmina and Kopp 2009 and Kopp 2011 on sex-comb diversification",
        "reported_in_source: Turing 1952 diffusion-driven instability and a finite critical wavelength",
        "transfer_boundary: 2.362e-06 m is the campaign detail-scale assignment (log10=-5.627), not a quoted takahashii ocellus measurement",
        "transfer_boundary: The suzukii → takahashii → teissieri order is chronoseries index 37/41 at 0 Ma, not an anagenetic fossil series" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila takahashii (Oriental Sex-Comb Transverse-Row Fruit Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila takahashii Schnakenberg Turing wavelength at 2.362 µm (Pass 2 specimen composite) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.9905, RMSE = 0.0568, KS = 0.0909 on 22 wavenumbers. Measured wavelength 2.314 µm versus reference 2.362 µm. Ablation std ~4e-13 versus patterned std 0.0475. Body area 0.053 versus the fixed threshold 0.099. Simulation coherency 0.269 versus specimen coherency 0.160. Circularity rose from 0.0018 to 0.307." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-equal-diffusion-ablation-std>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-ocellar-lattice-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-ocellus-spot-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-body-area-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-wavelength-cv-across-dv-sweep>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_ks_statistic = 0.090909 1" ;
        dct:description "goodness-of-fit complement to Pearson r; value is not zero" ;
        schema:measurementTechnique "two-sample Kolmogorov-Smirnov statistic between measured and analytic σ samples" ;
        schema:name "dispersion_ks_statistic" ;
        schema:unitText "1" ;
        schema:value "0.090909" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "KS = 0 for identical samples" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_pearson_r = 0.990498 1" ;
        dct:description "rmse recorded separately; r is not set equal to 1" ;
        schema:measurementTechnique "Pearson r of PDE log-amplitude growth rates vs analytic σ(k) for k in [0.6, 5.5] rad/µm" ;
        schema:name "dispersion_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.990498" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-pearson-r-reference> a schema:PropertyValue ;
        dct:source "perfect agreement with the linear Turing dispersion" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_rmse = 0.056829 1/time" ;
        schema:measurementTechnique "RMSE between measured and analytic σ(k) on the same wavenumber window" ;
        schema:name "dispersion_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.056829" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual against the linear dispersion" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-equal-diffusion-ablation-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_ablation_std = 4.117119779047588e-13 concentration" ;
        dct:description "control vs patterned amplitude; ablation must collapse" ;
        schema:measurementTechnique "std(u) after t=36 with Du=Dv (negative control); pattern std is the paired treatment" ;
        schema:name "equal_diffusion_ablation_std" ;
        schema:unitText "concentration" ;
        schema:value "4.117119779047588e-13" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-reference> a schema:PropertyValue ;
        dct:source "patterned regime Du=0.042744, Dv=0.971570 at the same seed and horizon" ;
        schema:value "0.04754" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-ocellar-lattice-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellar_lattice_wavelength_um = 2.313703 µm" ;
        dct:description "nonlinear and discrete-k shift; value is not forced equal to the target" ;
        schema:measurementTechnique "parabolic interpolation of the radial FFT peak of activator u on the 28.344 µm periodic chart" ;
        schema:name "ocellar_lattice_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "2.313703" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-ocellar-lattice-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-ocellar-lattice-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "slot scale 2.362e-06 m (human label 2.4 µm), analytic k_c target" ;
        schema:value "2.362" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-ocellus-spot-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus_spot_count = 146 count" ;
        dct:description "Schnakenberg spots are not forced onto a 12×12 lattice" ;
        schema:measurementTechnique "local maxima of u above mean+0.25 std" ;
        schema:name "ocellus_spot_count" ;
        schema:unitText "count" ;
        schema:value "146" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-ocellus-spot-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-ocellus-spot-count-reference> a schema:PropertyValue ;
        dct:source "one peak per critical wavelength cell on a 12×12 chart (144)" ;
        schema:value "144" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_aspect_ratio = 0.219758 1" ;
        schema:measurementTechnique "bounding-box width/height of the smoothed body component" ;
        schema:name "specimen_aspect_ratio" ;
        schema:unitText "1" ;
        schema:value "0.219758" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "isotropic bounding box" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-body-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_body_area_fraction = 0.052975 1" ;
        dct:description "Otsu area is not set equal to the fixed-threshold area" ;
        schema:measurementTechnique "largest connected component of the smoothed luminance below its 22nd percentile, caption band excluded" ;
        schema:name "specimen_body_area_fraction" ;
        schema:unitText "1" ;
        schema:value "0.052975" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-body-area-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-body-area-fraction-reference> a schema:PropertyValue ;
        dct:source "independent fixed luminance threshold gray<80 on the same plate" ;
        schema:value "0.099462" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.306528 1" ;
        schema:measurementTechnique "4πA/P² of the smoothed largest-component body contour" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.306528" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circle circularity" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.269137 1" ;
        dct:description "simulation coherency is not copied from the specimen coherency" ;
        schema:measurementTechnique "mean structure-tensor coherency of the rendered simulation frame" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.269137" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "structure-tensor coherency inside the Otsu body of the specimen plate" ;
        schema:value "0.159971" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-wavelength-cv-across-dv-sweep> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_cv_across_Dv_sweep = 0.062324 1" ;
        dct:description "expressivity: λ_c increases with Dv above onset" ;
        schema:measurementTechnique "coefficient of variation of analytic λ_c over the unstable Dv sweep" ;
        schema:name "wavelength_cv_across_Dv_sweep" ;
        schema:unitText "1" ;
        schema:value "0.062324" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-wavelength-cv-across-dv-sweep-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-measurement-wavelength-cv-across-dv-sweep-reference> a schema:PropertyValue ;
        dct:source "a parameter that did not move λ would have CV 0" ;
        schema:value "0.0" .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-silvestris-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing Dispersion Critical Wavenumber" ;
    dct:description "Detail-tier wavenumber exceeds the D. serrata cellular wavenumber by more than 30 | Variables: lambda_this = 2995 nm; lambda_serrata = 92260 nm; k proxy = 1e9/lambda_nm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0dc967f22ddaa01ca809b3701e8da57313f6c44d/models/2026-delphi10000-drosophila-silvestris-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0dc967f22ddaa01ca809b3701e8da57313f6c44d/morphoeval/lean/loops/Loop_3204_drosophila_silvestris_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = gamma (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/hdy.1982.2>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1073/pnas.76.4.1929>,
        <https://doi.org/10.1073/pnas.78.5.3088>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3204.wavenumberPerM" ;
    pk:leanTheorem "MathOfBiology.Loop_3204.wavenumber_exceeds_predecessor_by_thirty" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-silvestris-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Successor Does Not Inherit the Detail Wavenumber" ;
    dct:description "Holocene successor D. simulans sits at a cellular wavelength, not at 2.995 µm | Variables: lambda_simulans = 82560 nm" ;
    dct:source "Assigned chronoseries contrast; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0dc967f22ddaa01ca809b3701e8da57313f6c44d/models/2026-delphi10000-drosophila-silvestris-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0dc967f22ddaa01ca809b3701e8da57313f6c44d/morphoeval/lean/loops/Loop_3204_drosophila_silvestris_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_silvestris / k_simulans = 8.256e-5 / 2.995e-6 > 27" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/hdy.1982.2>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1073/pnas.76.4.1929>,
        <https://doi.org/10.1073/pnas.78.5.3088>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3204.wavenumberPerM" ;
    pk:leanTheorem "MathOfBiology.Loop_3204.wavenumber_exceeds_successor_by_twentyseven" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-silvestris-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Eight Modes on the Detail Patch" ;
    dct:description "The 3.0 µm ocellus scale is the only chronoseries wavelength that fits eight times in the detail patch | Variables: patch = 8 * 2995 nm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0dc967f22ddaa01ca809b3701e8da57313f6c44d/models/2026-delphi10000-drosophila-silvestris-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0dc967f22ddaa01ca809b3701e8da57313f6c44d/morphoeval/lean/loops/Loop_3204_drosophila_silvestris_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L / lambda_c = 23960 nm / 2995 nm = 8, and L is shorter than both neighbour wavelengths" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/hdy.1982.2>,
        <https://doi.org/10.1038/nature03235>,
        <https://doi.org/10.1073/pnas.76.4.1929>,
        <https://doi.org/10.1073/pnas.78.5.3088>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3204.patchNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3204.eight_modes_fit_only_at_this_scale" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-silvestris-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Ocellus Diffusivity Ratio" ;
    dct:description "Spot-selecting inhibitor diffusion at this scale exceeds the stripe-regime contrasts | Variables: d = D_v / D_u" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0dc967f22ddaa01ca809b3701e8da57313f6c44d/models/2026-delphi10000-drosophila-silvestris-turing-wavelength-s0.py>,

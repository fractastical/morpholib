<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila silvestris Turing wavenumber at 2.995 µm (Holocene, 0 Ma) — Code-to-model traceability: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Lean theorems pin the nanometre ordering, the factor-of-30 wavenumber gap, the eight-mode patch, and the diffusivity-ratio inequality. The script's k_c function is the same relation. Pass-1 argmax remains in the file as the estimator the centroid replaced." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

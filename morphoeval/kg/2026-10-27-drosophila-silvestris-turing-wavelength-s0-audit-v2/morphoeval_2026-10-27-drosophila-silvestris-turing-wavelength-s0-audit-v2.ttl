        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila silvestris Turing wavenumber at 2.995 µm (Holocene, 0 Ma) — Model fidelity to source: 91/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The Jacobian, critical wavenumber, and equal-diffusion stability condition match Turing (1952) and Schnakenberg (1979). Pass 2 adds the centroid estimator and the nonlinear onset ratio without changing the kinetics. Remaining gap: the nonlinear field is a numerical integration, not a matched asymptotic spot law." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-silvestris-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9.1e-01 ;
    pk:hasVerdict "faithful" .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Eryops megacephalus Schnakenberg Turing wavelength at 127 µm (Cisuralian, 295 Ma) — Morphological realism / specimen match: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The CC BY 4.0 AMNH mount is the specimen (SHA-256 pinned). Pass 1 composites the ocellus field over the whole frame, including the gallery wall and labels. Unmasked cv_sim_similarity is 94.4, but the placement is not anatomically restricted to bone. That is the main Pass-1 specimen gap." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eryops-megacephalus-turing-wavelength-s0.py L459–L490" ;
        dct:description "composite_frame with mask=None is the Pass-1 full-frame path" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b44ba50e2b3311d637a471cbc44dcd63f77d40d0/models/2026-delphi10000-eryops-megacephalus-turing-wavelength-s0.py#L459-L490> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/eryops_megacephalus_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12-frame 720x540 animation; Pass-1 unmasked CV was 94.4 before the bone mask replaced the published GIF — docs/media/eryops_megacephalus_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-eryops-megacephalus-turing-wavelength-s0.py at b44ba50e2b3311d637a471cbc44dcd63f77d40d0, image/gif, 2794928 B, 720×540 px, 12 frames, artifact_sha256 b226d43e5bb86317fe31cd24f1d7d2af8e308ccb84ba0eb22ccdcc3cd5ba814e (sha256 b226d43e5bb86317fe31cd24f1d7d2af8e308ccb84ba0eb22ccdcc3cd5ba814e), spec_fingerprint 51cd1fdffca7c86caa7bb398d56aaa419b30f1491ad7e8b4fe11b7153e0b9b21" .

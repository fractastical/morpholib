    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Eryops_megacephalus_skeleton_at_American_Museum_of_Natural_History.jpg>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1096-3642.2009.00599.x>,
            <https://doi.org/10.1666/0022-3360(2006)80[561:tasoem]2.0.co;2> .
    <https://commons.wikimedia.org/wiki/File:Eryops_megacephalus_skeleton_at_American_Museum_of_Natural_History.jpg> dct:title "Eryops megacephalus skeleton at the American Museum of Natural History" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.1096-3642.2009.00599.x> dct:date "2010"^^xsd:gYear ;
        dct:title "Sculpture and vascularization of dermal bones, and the implications for the physiology of basal tetrapods" .
    <https://doi.org/10.1666/0022-3360(2006)80[561:tasoem]2.0.co;2> dct:date "2006"^^xsd:gYear ;
        dct:title "The appendicular skeleton of Eryops megacephalus Cope, 1877 (Temnospondyli: Eryopoidea) from the Lower Permian of North America" .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eryops-megacephalus-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Eryops megacephalus Schnakenberg Turing wavelength at 127 µm (Cisuralian, 295 Ma) — Code-to-model traceability: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Module docstring maps the Jacobian and k_c to Turing 1952 and Schnakenberg 1979. The math-KG loop file points at the same Lean declarations. Pass 1 does not yet tie every control panel to a scored claim." ;

    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the zebrafish blastoderm cross-transplantation fluorescence specimen (`datasets/differential_interfacial_tension_sorting/germ_layer_doublet_specimen.jpg`, CC BY 4.0), segments both the Row B layered engulfment panels (`r_E/R = 0.780, r_M/R = 0.514, Δr = +0.267`) and the Row C protruding mushroom doublet (`r_c/R = 0.9717, cos(theta) = 0.2364`, L620-735), and overlays empirical vs. simulated radial core-shell profiles across 12 annuli (`Pearson r = 0.9301, RMSE = 0.1844`, Panels B4-B5)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;

        dct:description "Segmentation of zebrafish blastoderm Row B layered engulfment and Row C mushroom doublet GFP/RFP micrographs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L620-L735> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/differential_interfacial_tension_sorting_comparison.png (generated output)" ;
        dct:description "10-panel synthesis figure displaying all 4 DITH regimes, 3-germ-layer stratification, Young-Dupré curve, zebrafish doublet segmentation (B4), and radial profile match (B5) — docs/media/differential_interfacial_tension_sorting_comparison.png: rendered output of 2002-brodland-differential-interfacial-tension-sorting.py at b9976f8, image/png, 419495 B, 3000×1260 px, artifact_sha256 68bcaffb42002b53f8666b482f0c8eb740fd840065dd289e2b5fd57b6ee1fefd (sha256 68bcaffb42002b53f8666b482f0c8eb740fd840065dd289e2b5fd57b6ee1fefd), spec_fingerprint 04e6692e5c44347cdef3ff055c0cf966e6a50c079cad3d06d965f070f3683587" .

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Brodland's (2002) J. Biomech. Eng. Eq. (1) DITH interfacial tension law (`compute_dith_tensions`, L97-145), Maître et al.'s (2012) Science Eq. (1) Young-Dupré cell-doublet contact angle and normalized contact radius law (`compute_young_dupre_doublet`, L148-190), and Krieg et al.'s (2008) Nature Cell Biology zebrafish germ-layer sorting hierarchy across all 4 perturbation regimes (`simulate_dith_regime`, L284-472) plus 3-germ-layer concentric stratification (`simulate_three_germ_layer_sorting`, L475-574: `r_E = 0.870 > r_M = 0.663 > r_N = 0.446`). Backed by 3 machine-checked Lean 4 theorems (0 sorrys) in `Loop_044_differential_interfacial_tension_sorting.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L97–L190" ;
        dcterms:description "Exact Brodland (2002) Eq. 1 DITH tension decomposition and Maître et al. (2012) Eq. 1 Young-Dupré doublet contact angle mechanics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L97-L190> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L284–L574" ;
        dcterms:description "2D deformable DITH cell sorting across all 4 Krieg et al. (2008) regimes plus 3-germ-layer concentric stratification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L284-L574> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_044_differential_interfacial_tension_sorting.lean L17–L89" ;
        dcterms:description "3 machine-checked Lean 4 theorems for DITH Blebbistatin null identity, Krieg 2008 hierarchy & caMLCK reversal, and Maître 2012 Young-Dupré bounds" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/loops/Loop_044_differential_interfacial_tension_sorting.lean#L17-L89> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


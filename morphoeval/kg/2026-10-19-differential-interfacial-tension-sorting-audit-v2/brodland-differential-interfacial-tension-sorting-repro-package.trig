sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting — Reproducibility package: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2008`), fast execution (~8s full render, <1.5s `--self-test`), 8-check `self_test()` suite (L1003-1065) verifying SHA-256 integrity, exact Lean 4 DITH tension parity across all 4 regimes, Young-Dupré contact bounds, wild-type vs `caMLCK` reversal vs Blebbistatin arrest, 3-germ-layer stratification (`r_E > r_M > r_N`), specimen segmentation correlation, and two-run bitwise determinism (`np.array_equal`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L1003–L1065" ;
        dct:description "8-check self_test() suite including SHA-256 check, caMLCK reversal, 3-germ-layer stratification, and two-run bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/2002-brodland-differential-interfacial-tension-sorting.py#L1003-L1065> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


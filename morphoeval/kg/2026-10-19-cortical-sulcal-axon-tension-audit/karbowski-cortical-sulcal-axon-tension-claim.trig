sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-karbowski-cortical-sulcal-axon-tension> a pk:Claim ;
        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding faithfully reproduces Primate & mammalian cerebral cortex and white-matter tracts (Homo sapiens, Macaca mulatta, Pan troglodytes, Tursiops truncatus, Felis catus, Mus musculus) morphology" ;
        dct:description "The simulation script(s) 2020-karbowski-cortical-sulcal-axon-tension.py implement the cited source model as published and produce forms that match real Primate & mammalian cerebral cortex and white-matter tracts (Homo sapiens, Macaca mulatta, Pan troglodytes, Tursiops truncatus, Felis catus, Mus musculus) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.9/100, audit 2026-10-19-cortical-sulcal-axon-tension-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py; output: docs/media/cortical_sulcal_axon_tension_comparison.png; organism: Primate & mammalian cerebral cortex and white-matter tracts (Homo sapiens, Macaca mulatta, Pan troglodytes, Tursiops truncatus, Felis catus, Mus musculus); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 84c495a5d45894646a6161c31d7690d7bf05b858d5926075a0791c491fd2603b; artifact_sha256: c8f0ef043aac3299bc8458680e4da0a77813397b803ba11454f9b7914eed9aa8; input_dataset_sha256: {datasets/cortical_sulcal_axon_tension/coronal_cortex_axon_tracts_specimen.jpg=ff9a25e993fd5aad..., datasets/cortical_sulcal_axon_tension/cortical_sulcal_axon_tension_reference.json=51d4ed1c896638d9..., datasets/cortical_sulcal_axon_tension/paper_citations.bib=bcd7b0529c1c497d..., datasets/cortical_sulcal_axon_tension/scout_manifest.json=3ef66e67c6994708...}" ;
        pk:derivedFromPaper <https://doi.org/10.1038/385313a0>,
            <https://doi.org/10.1093/cercor/bhi068>,
            <https://doi.org/10.1126/science.aaa9101>,
            <https://doi.org/10.1371/journal.pcbi.0020022> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match> ;
        pk:weightOfEvidence "0.539"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py> a schema:SoftwareSourceCode ;
        rdfs:label "2020-karbowski-cortical-sulcal-axon-tension.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


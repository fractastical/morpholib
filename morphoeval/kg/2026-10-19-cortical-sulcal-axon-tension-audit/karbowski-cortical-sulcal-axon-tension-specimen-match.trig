sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-karbowski-cortical-sulcal-axon-tension> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/cortical_sulcal_axon_tension/coronal_cortex_axon_tracts_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or displays the coronal brain specimen image, and does not evaluate the 12-species mammalian scaling dataset." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2020-karbowski-cortical-sulcal-axon-tension.py L70–L91: Evaluates only 4 analytical pair rows without loading coronal_cortex_axon_tracts_specimen.jpg <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L70-L91>",
            "docs/media/cortical_sulcal_axon_tension_comparison.png (generated output, not in repo): 4-panel v1 plot lacks coronal brain specimen segmentation and 12-species MHH collapse — docs/media/cortical_sulcal_axon_tension_comparison.png: rendered output of 2020-karbowski-cortical-sulcal-axon-tension.py at 8871db0, image/png, 223333 B, 1625×1170 px, artifact_sha256 c8f0ef043aac3299bc8458680e4da0a77813397b803ba11454f9b7914eed9aa8 (sha256 c8f0ef043aac3299bc8458680e4da0a77813397b803ba11454f9b7914eed9aa8), spec_fingerprint 84c495a5d45894646a6161c31d7690d7bf05b858d5926075a0791c491fd2603b" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 090 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


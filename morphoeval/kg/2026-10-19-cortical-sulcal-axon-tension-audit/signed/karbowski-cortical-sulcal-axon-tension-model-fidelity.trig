sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-karbowski-cortical-sulcal-axon-tension> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2020-karbowski-cortical-sulcal-axon-tension.py L32–L41" ;
        dcterms:description "Analytical chord-vs-arc wiring saving and isometric laminar thickness formulas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L32-L41> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 090 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding — Model fidelity to source: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes analytical chord-vs-arc wiring volume savings (L32-35) and Hilgetag & Barbas (2006) isometric column thickness h = h0 / lambda_t (L38-41), backed by 3 Lean 4 theorems in `Loop_090_cortical_sulcal_axon_tension.lean`. However, `generate_parametric_coronal_ribbon` (L44-67) prescribes a synthetic harmonic curve rather than relaxing a coupled elastoplastic cortical ribbon + viscoelastic white-matter axonal tension network over connectivity matrix C_ij with towed-axon growth dL_0/dt = gamma_a(T_ij - tau_0)_+ and axonal ablation controls." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2020-karbowski-cortical-sulcal-axon-tension.py L44–L67: Synthetic cosine coronal contour instead of viscoelastic axonal tension relaxation <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L44-L67>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-model-fidelity-1> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


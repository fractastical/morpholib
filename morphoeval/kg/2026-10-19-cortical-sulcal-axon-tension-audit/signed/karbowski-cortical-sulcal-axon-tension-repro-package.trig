        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding — Reproducibility package: 68/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Includes `--self-test` and `--skip-gif` flags (L195-215), but `self_test()` runs only 3 basic assertions without checking SHA-256 dataset integrity, axonal tension ablation invariants, 12-species MHH power-law collapse, or two-run bitwise determinism." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2020-karbowski-cortical-sulcal-axon-tension.py L195–L202: Minimal 3-check self_test() without determinism or ablation verification <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L195-L202>" ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .


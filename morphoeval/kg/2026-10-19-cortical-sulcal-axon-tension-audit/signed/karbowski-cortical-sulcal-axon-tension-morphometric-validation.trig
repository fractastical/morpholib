sub1:provenance {
    <https://doi.org/10.1038/385313a0> dcterms:date "1997"^^xsd:gYear ;
        dcterms:title "A tension-based theory of morphogenesis and compact wiring in the central nervous system" .

    <https://doi.org/10.1093/cercor/bhi068> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "A Morphogenetic Model for the Development of Cortical Convolutions" .

    <https://doi.org/10.1126/science.aaa9101> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "Cortical folding scales universally with surface area and thickness, not number of neurons" .

    <https://doi.org/10.1371/journal.pcbi.0020022> dcterms:date "2006"^^xsd:gYear ;
        dcterms:title "Role of Mechanical Factors in the Morphology of the Primate Cerebral Cortex" .


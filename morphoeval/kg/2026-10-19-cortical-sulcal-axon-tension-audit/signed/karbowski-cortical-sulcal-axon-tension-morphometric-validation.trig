}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-karbowski-cortical-sulcal-axon-tension> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-karbowski-cortical-sulcal-axon-tension-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Van Essen (1997), Hilgetag & Barbas (2006) & Mota & Herculano-Houzel (2015) cortico-cortical axonal tension and cortical folding — Morphometric validation: 55/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L164-192) reports 3 analytical metrics, but does not measure emergent wiring economy or gyral/sulcal thickness ratios from a relaxed mechanical network, does not compute the 12-species MHH universal scaling exponent alpha = 1.25, and extracts zero computer-vision metrics from the coronal brain specimen image." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2020-karbowski-cortical-sulcal-axon-tension.py L164–L192: Only 3 analytical metrics returned without mechanical relaxation or specimen CV metrics <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L164-L192>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-crown-cortical-thickness-h-gyrus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-to-sulcal-thickness-ratio-h-gyrus-h-fundus>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-macaque-v1-v2-gyral-chord-to-arc-wiring-ratio-van-essen-1997> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-crown-cortical-thickness-h-gyrus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hilgetag & Barbas (2006) gyral crown cortical thickness h_gyrus = 3.141 mm" ;
        schema:measurementTechnique "Isometric column volume conservation h0 / lambda_{t,gyrus} at h0=2.45 mm, lambda_t=0.78" ;
        schema:name "Hilgetag & Barbas (2006) gyral crown cortical thickness h_gyrus" ;
        schema:unitText "mm" ;
        schema:value "3.141" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-crown-cortical-thickness-h-gyrus-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-crown-cortical-thickness-h-gyrus-reference> a schema:PropertyValue ;
        dcterms:source "Hilgetag & Barbas (2006) PLoS Comput. Biol. 2(3):e22" ;
        schema:value "3.14" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-to-sulcal-thickness-ratio-h-gyrus-h-fundus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Hilgetag & Barbas (2006) gyral-to-sulcal thickness ratio h_gyrus / h_fundus = 1.6154 ratio" ;
        schema:measurementTechnique "Ratio of gyral crown thickness to sulcal fundus thickness under volume conservation" ;
        schema:name "Hilgetag & Barbas (2006) gyral-to-sulcal thickness ratio h_gyrus / h_fundus" ;
        schema:unitText "ratio" ;
        schema:value "1.6154" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-to-sulcal-thickness-ratio-h-gyrus-h-fundus-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-hilgetag-barbas-2006-gyral-to-sulcal-thickness-ratio-h-gyrus-h-fundus-reference> a schema:PropertyValue ;
        dcterms:source "Hilgetag & Barbas (2006) PLoS Comput. Biol. 2(3):e22" ;
        schema:value "1.6186" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-macaque-v1-v2-gyral-chord-to-arc-wiring-ratio-van-essen-1997> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Macaque V1-V2 gyral chord-to-arc wiring ratio (Van Essen 1997) = 0.4324 d_chord / d_arc" ;
        schema:measurementTechnique "Ratio of folded 3D chord length to unfolded geodesic arc length for V1-V2 pair" ;
        schema:name "Macaque V1-V2 gyral chord-to-arc wiring ratio (Van Essen 1997)" ;
        schema:unitText "d_chord / d_arc" ;
        schema:value "0.4324" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-macaque-v1-v2-gyral-chord-to-arc-wiring-ratio-van-essen-1997-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-karbowski-cortical-sulcal-axon-tension-measurement-macaque-v1-v2-gyral-chord-to-arc-wiring-ratio-van-essen-1997-reference> a schema:PropertyValue ;
        dcterms:source "Van Essen (1997) Nature 385:313-318 Fig. 1-2" ;
        schema:value "0.4324" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 090 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


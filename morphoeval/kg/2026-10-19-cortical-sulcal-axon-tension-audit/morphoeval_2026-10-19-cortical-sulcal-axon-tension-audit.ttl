<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/karbowski-cortical-sulcal-axon-tension-1>,
        <https://w3id.org/probknow/resource/math-law/karbowski-cortical-sulcal-axon-tension-2>,
        <https://w3id.org/probknow/resource/math-law/karbowski-cortical-sulcal-axon-tension-3> .

<https://w3id.org/probknow/resource/math-law/karbowski-cortical-sulcal-axon-tension-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Van Essen (1997) Cortico-Cortical Axonal Tension & Chord-vs-Arc Gyral Wiring Economy" ;
    dct:description "Establishes that viscoelastic tension along dense cortico-cortical white-matter tracts pulls strongly connected areas together across outward gyral crowns to minimize 3D wiring volume while weakly connected zones fold inward as sulcal fundi | Variables: C_{ij}: cortico-cortical axonal connectivity density; d_arc: unfolded geodesic surface arc distance (mm); d_chord: 3D Euclidean trans-gyral chord distance (mm); k_a: axonal spring constant" ;
    dct:source "Van Essen (1997) Nature 385:313-318 Fig. 1-3; Toro & Burnod (2005) Cerebral Cortex 15:1900-1913; Karbowski (2001) Phys. Rev. Lett. 86:3674" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L125-L215>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_090_cortical_sulcal_axon_tension.lean#L36-L49> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def wiring_volume_saving (C d_arc d_chord : Int) : Int :=
  C * d_arc - C * d_chord
theorem van_essen_gyral_wiring_economy (C_strong C_weak d_chord delta : Int) :
    wiring_volume_saving C_strong d_chord d_chord = 0 ∧
    wiring_volume_saving C_strong (d_chord + delta) d_chord -
      wiring_volume_saving C_weak (d_chord + delta) d_chord =
      (C_strong - C_weak) * delta
"""^^pk:lean4 ;
    skos:notation "F_axon = sum_{i<j} k_a C_{ij} (||x_i - x_j|| - L_{0,ij})_+ + E_bend(κ);  ΔV_wire = C_{ij} (d_arc - d_chord) > 0 for C_strong > C_weak" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/385313a0>,
        <https://doi.org/10.1093/cercor/bhi068>,
        <https://doi.org/10.1126/science.aaa9101>,
        <https://doi.org/10.1371/journal.pcbi.0020022> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Viscoelastic Cortico-Cortical Axonal Tension Mechanics, Laminar Volume Conservation & Universal Gyrification Scaling" ;
    pk:leanDeclaration "MathOfBiology.Loop_090.wiring_volume_saving" ;
    pk:leanTheorem "MathOfBiology.Loop_090.van_essen_gyral_wiring_economy" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/karbowski-cortical-sulcal-axon-tension-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hilgetag & Barbas (2006) Isometric Laminar Volume Conservation & Gyral-vs-Sulcal Thickness Dichotomy" ;
    dct:description "Proves that isometric volume conservation under gyral tangential compression and sulcal tangential stretching produces systematically thicker gyral crowns and thinner sulcal fundi (h_gyrus / h_fundus ≈ 1.62) | Variables: V_col: cortical column volume; A_surf: local tangential surface area; h: radial cortical thickness (mm); λ_t: tangential strain factor (λ_{t,gyrus} = 0.78 < 1 < λ_{t,fundus} = 1.26)" ;
    dct:source "Hilgetag & Barbas (2006) PLoS Comput. Biol. 2(3):e22 Eq. 1-4 & Fig. 2-6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L220-L310>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_090_cortical_sulcal_axon_tension.lean#L63-L72> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def laminar_volume_residual (A_surf h A_ref h_ref : Int) : Int :=
  A_surf * h - A_ref * h_ref
theorem hilgetag_barbas_laminar_thickness_dichotomy (A_0 h_0 k m d : Int) :
    laminar_volume_residual (k * A_0) (m * h_0) (m * A_0) (k * h_0) = 0 ∧
    (k + d) * h_0 - k * h_0 = d * h_0
"""^^pk:lean4 ;
    skos:notation "V_col = A_surf * h = A_0 * h_0  ⇒  h_gyrus = h_0 / λ_{t,gyrus} > h_wall = h_0 > h_fundus = h_0 / λ_{t,fundus}" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/385313a0>,
        <https://doi.org/10.1093/cercor/bhi068>,
        <https://doi.org/10.1126/science.aaa9101>,
        <https://doi.org/10.1371/journal.pcbi.0020022> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Viscoelastic Cortico-Cortical Axonal Tension Mechanics, Laminar Volume Conservation & Universal Gyrification Scaling" ;
    pk:leanDeclaration "MathOfBiology.Loop_090.laminar_volume_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_090.hilgetag_barbas_laminar_thickness_dichotomy" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/karbowski-cortical-sulcal-axon-tension-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mota & Herculano-Houzel (2015) Universal Mammalian Cortical Folding Power Law" ;
    dct:description "Unifies mammalian cortical folding across 12 species spanning lissencephalic rodents to gyrencephalic primates and cetaceans with universal log-log slope α = 5/4 = 1.25 | Variables: A_T: total pial cortical surface area (mm^2); A_E: exposed convex-hull surface area (mm^2); h: mean cortical gray-matter thickness (mm); k: dimensionless axonal-tension folding constant; GI: 3D gyrification index" ;
    dct:source "Mota & Herculano-Houzel (2015) Science 349(6243):74-77 Eq. 3-5 & Fig. 2-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2020-karbowski-cortical-sulcal-axon-tension.py#L315-L420>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_090_cortical_sulcal_axon_tension.lean#L85-L99> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def mota_herculano_houzel_residual (A_T_pow4 h_pow2 k_pow4 A_E_pow5 : Int) : Int :=
  A_T_pow4 * h_pow2 - k_pow4 * A_E_pow5
def gyrification_area_excess (A_T A_E : Int) : Int :=
  A_T - A_E
theorem mota_herculano_houzel_universal_scaling (A_E h_pow2 k_pow4 : Int) :
    gyrification_area_excess A_E A_E = 0 ∧
    mota_herculano_houzel_residual (k_pow4 * A_E) h_pow2 k_pow4 (A_E * h_pow2) = 0 ∧
    mota_herculano_houzel_residual (16 * k_pow4 * A_E) h_pow2 k_pow4 (16 * A_E * h_pow2) = 0
"""^^pk:lean4 ;
    skos:notation "A_T sqrt(h) = k A_E^(5/4)  ⇔  A_T^4 h^2 = k^4 A_E^5,  with GI = A_T / A_E = k h^(-1/2) A_E^(1/4) ≥ 1.0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/385313a0>,
        <https://doi.org/10.1093/cercor/bhi068>,
        <https://doi.org/10.1126/science.aaa9101>,
        <https://doi.org/10.1371/journal.pcbi.0020022> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Viscoelastic Cortico-Cortical Axonal Tension Mechanics, Laminar Volume Conservation & Universal Gyrification Scaling" ;
    pk:leanDeclaration "MathOfBiology.Loop_090.mota_herculano_houzel_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_090.mota_herculano_houzel_universal_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


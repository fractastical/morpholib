sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Benthic stickleback cellular Turing wavelength (43 µm, Holocene 0 Ma) — Morphometric validation: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Two-field azimuthal Pearson r = 0.9846 (reference ideal 1.0), RMSE = 5.97 gray levels (reference 0), KS D = 0.175 (reference 0). Crest-to-trough 20.24 µm is not λ_c/2 = 21.575 µm. Plate half-max radius is calibrated by the 111 px = 100 µm bar and is not 43.15 µm. Activator-only r, with no fitted inhibitor gain, is reported separately and is not equal to 0.9846. Foreground fractions of the plate and the readout are computed apart." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-diffusivity-sweep-wavelength-at-du-1-10>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-only-radial-correlation-no-fitted-inhibitor-gain>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-azimuthal-luminance-pearson-r-plate-vs-two-morphogen-readout>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-detail-plate-half-maximum-radius>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-control-turing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-foreground-fraction-difference-model-readout-minus-detail-plate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-linear-critical-wavenumber-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-multi-seed-activator-amplitude-coefficient-of-variation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-nonlinear-crest-to-trough-radius>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-radial-rmse-of-the-luminance-readout>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-two-sample-ks-distance-between-plate-and-readout-profiles>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-diffusivity-sweep-wavelength-at-du-1-10> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Activator-diffusivity sweep wavelength at Du = 1.10 = 62.967 µm" ;
        dct:description "wavelengths µm = 28.62, 36.50, 43.15, 52.77, 62.97; monotone = True" ;
        schema:measurementTechnique "λ_c(Du) at fixed reference dx, Du in {0.25, 0.40, 0.55, 0.80, 1.10}, Dv = 12" ;
        schema:name "Activator-diffusivity sweep wavelength at Du = 1.10" ;
        schema:unitText "µm" ;
        schema:value "62.967" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-diffusivity-sweep-wavelength-at-du-1-10-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-diffusivity-sweep-wavelength-at-du-1-10-reference> a schema:PropertyValue ;
        dct:source "Reference Du = 0.55 pins λ_c = 43.15 µm. Du = 1.10 must be longer, and the five-point sweep is checked for strict increase." ;
        schema:value "43.15" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-only-radial-correlation-no-fitted-inhibitor-gain> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Activator-only radial correlation (no fitted inhibitor gain) = 0.9155 Pearson r" ;
        schema:measurementTechnique "Min-max scaled activator azimuthal mean versus min-max scaled plate luminance, no c0/c1/c2" ;
        schema:name "Activator-only radial correlation (no fitted inhibitor gain)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9155" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-only-radial-correlation-no-fitted-inhibitor-gain-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-activator-only-radial-correlation-no-fitted-inhibitor-gain-reference> a schema:PropertyValue ;
        dct:source "Two-morphogen readout correlation. The activator-only number is lower because the plate's dark ring needs the inhibitor." ;
        schema:value "0.9846" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-azimuthal-luminance-pearson-r-plate-vs-two-morphogen-readout> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Azimuthal luminance Pearson r (plate vs two-morphogen readout) = 0.9846 Pearson r" ;
        dct:description "RMSE = 5.97 gray levels; KS D = 0.175; activator-only r = 0.9155 (no least-squares gain)" ;
        schema:measurementTechnique "40-bin azimuthal mean of the detail plate versus c0 + c1*U(r)*Vig + c2*V(r)*Vig" ;
        schema:name "Azimuthal luminance Pearson r (plate vs two-morphogen readout)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9846" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-azimuthal-luminance-pearson-r-plate-vs-two-morphogen-readout-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-azimuthal-luminance-pearson-r-plate-vs-two-morphogen-readout-reference> a schema:PropertyValue ;
        dct:source "Ideal correlation. Achieved r is computed, not assigned." ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-detail-plate-half-maximum-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Detail-plate half-maximum radius = 53.604 µm" ;
        schema:measurementTechnique "Plate azimuthal profile, halfway from crest to inner trough, calibrated by the 111 px = 100 µm bar" ;
        schema:name "Detail-plate half-maximum radius" ;
        schema:unitText "µm" ;
        schema:value "53.604" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-detail-plate-half-maximum-radius-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-detail-plate-half-maximum-radius-reference> a schema:PropertyValue ;
        dct:source "Catalog linear wavelength 43.15 µm. The plate's bright core is a different length." ;
        schema:value "43.15" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-control-turing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Equal-diffusion ablation amplitude ratio (control / Turing) = 0.0116 ratio" ;
        schema:measurementTechnique "Same initial data with Du = Dv = 0.55 versus Du = 0.55, Dv = 12" ;
        schema:name "Equal-diffusion ablation amplitude ratio (control / Turing)" ;
        schema:unitText "ratio" ;
        schema:value "0.0116" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-control-turing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-control-turing-reference> a schema:PropertyValue ;
        dct:source "A ratio of 1 would mean the control still patterns. Turing theory requires the ratio < 1." ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-foreground-fraction-difference-model-readout-minus-detail-plate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Foreground-fraction difference (model readout minus detail plate) = -0.0992 fraction" ;
        schema:measurementTechnique "Border-contrast mask on a 160×120 resize of the plate and of the steady readout" ;
        schema:name "Foreground-fraction difference (model readout minus detail plate)" ;
        schema:unitText "fraction" ;
        schema:value "-0.0992" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-foreground-fraction-difference-model-readout-minus-detail-plate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-foreground-fraction-difference-model-readout-minus-detail-plate-reference> a schema:PropertyValue ;
        dct:source "A difference of 0 would be a copied mask. The two masks are computed separately." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-linear-critical-wavenumber-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Linear critical wavenumber k_c = 145612.6 1/m" ;
        schema:measurementTechnique "k_c = 2π / 4.315e-05 m from the dispersion maximizer" ;
        schema:name "Linear critical wavenumber k_c" ;
        schema:unitText "1/m" ;
        schema:value "145612.6" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-linear-critical-wavenumber-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-linear-critical-wavenumber-k-c-reference> a schema:PropertyValue ;
        dct:source "Organ-scale benthic sibling wavenumber 2π / 2.2 mm. This slot's k_c is the cellular mode." ;
        schema:value "2792.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-multi-seed-activator-amplitude-coefficient-of-variation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Multi-seed activator-amplitude coefficient of variation = 0.0182 CV" ;
        schema:measurementTechnique "Four seeds (3234, 3235, 3301, 3317), each integrated for 9000 steps" ;
        schema:name "Multi-seed activator-amplitude coefficient of variation" ;
        schema:unitText "CV" ;
        schema:value "0.0182" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-multi-seed-activator-amplitude-coefficient-of-variation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-multi-seed-activator-amplitude-coefficient-of-variation-reference> a schema:PropertyValue ;
        dct:source "Zero CV would mean seed-invariant amplitude. Finite CV is the measured scatter." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-nonlinear-crest-to-trough-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Nonlinear crest-to-trough radius = 20.245 µm" ;
        schema:measurementTechnique "Argmin of the activator radial mean outside the crest, times dx (dx sets linear λ_c = 43.15 µm)" ;
        schema:name "Nonlinear crest-to-trough radius" ;
        schema:unitText "µm" ;
        schema:value "20.245" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-nonlinear-crest-to-trough-radius-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-nonlinear-crest-to-trough-radius-reference> a schema:PropertyValue ;
        dct:source "Linear half-wavelength λ_c/2 = 21.575 µm. Nonlinear radius is a different number." ;
        schema:value "21.575" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-radial-rmse-of-the-luminance-readout> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Radial RMSE of the luminance readout = 5.968 gray levels" ;
        schema:measurementTechnique "Root mean square residual of the 40-bin azimuthal fit" ;
        schema:name "Radial RMSE of the luminance readout" ;
        schema:unitText "gray levels" ;
        schema:value "5.968" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-radial-rmse-of-the-luminance-readout-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-radial-rmse-of-the-luminance-readout-reference> a schema:PropertyValue ;
        dct:source "Perfect residual. The fit is not exact." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-two-sample-ks-distance-between-plate-and-readout-profiles> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Two-sample KS distance between plate and readout profiles = 0.175 KS D" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on the 40 azimuthal bins" ;
        schema:name "Two-sample KS distance between plate and readout profiles" ;
        schema:unitText "KS D" ;
        schema:value "0.175" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-two-sample-ks-distance-between-plate-and-readout-profiles-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-measurement-two-sample-ks-distance-between-plate-and-readout-profiles-reference> a schema:PropertyValue ;
        dct:source "Identical distributions would give D = 0." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py L245–L275" ;
        dct:description "Fit, activator-only r, KS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py#L245-L275> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py L557–L656" ;
        dct:description "measure_morphoeval; each value differs from its reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py#L557-L656> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py L488–L510" ;
        dct:description "Foreground segmentation of plate and readout" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gasterosteus-aculeatus-benthic-turing-wavelength-s0.py#L488-L510> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://w3id.org/probknow/agent/morphoeval-loop-3234> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://w3id.org/delphi/resource/model/grok-4.7>,
            <https://w3id.org/probknow/agent/morphoeval-loop-3234> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.cell.2007.10.055>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1038/hdy.2011.1>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1107239>,
            <https://doi.org/10.1126/science.1182213> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/j.cell.2007.10.055> dct:date "2007"^^xsd:gYear ;
        dct:title "cis-Regulatory changes in Kit ligand expression and parallel evolution of pigmentation in sticklebacks and humans" .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1038/hdy.2011.1> dct:date "2011"^^xsd:gYear ;
        dct:title "The genetic basis of divergent pigment patterns in juvenile threespine sticklebacks" .
    <https://doi.org/10.1073/pnas.0808622106> dct:date "2009"^^xsd:gYear ;
        dct:title "Interactions between zebrafish pigment cells responsible for the generation of Turing patterns" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1107239> dct:date "2005"^^xsd:gYear ;
        dct:title "Widespread parallel evolution in sticklebacks by repeated fixation of Ectodysplasin alleles" .
    <https://doi.org/10.1126/science.1182213> dct:date "2010"^^xsd:gYear ;
        dct:title "Adaptive evolution of pelvic reduction in sticklebacks by recurrent deletion of a Pitx1 enhancer" .
}


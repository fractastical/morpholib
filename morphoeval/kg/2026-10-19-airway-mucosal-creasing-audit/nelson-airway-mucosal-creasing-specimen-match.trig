sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/airway_mucosal_creasing/bronchiole_mucosal_rosette_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or measures the luminal star contour, mucosal fold count m_obs, or lumen circularity on the histology micrograph." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2018-nelson-airway-mucosal-creasing.py L80–L112: Evaluates only 3 tabular phenotypes without loading or segmenting bronchiole_mucosal_rosette_specimen.jpg <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L80-L112>",
            "docs/media/airway_mucosal_creasing_comparison.png (generated output, not in repo): 4-panel v1 plot omits histology specimen segmentation and 12-point cross-airway collapse — docs/media/airway_mucosal_creasing_comparison.png: rendered output of 2018-nelson-airway-mucosal-creasing.py at e93f00e, image/png, 208536 B, 1428×1177 px, artifact_sha256 285fff9751c8f0c97332526a96eeb64dc398c77de16a5c3f1529e721754756bf (sha256 285fff9751c8f0c97332526a96eeb64dc398c77de16a5c3f1529e721754756bf), spec_fingerprint 05e3af78f585432603f642410d2578bbd795537fd20203d0ce320ae7253e2a7e" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 068 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/nelson-airway-mucosal-creasing-1>,
        <https://w3id.org/probknow/resource/math-law/nelson-airway-mucosal-creasing-2>,
        <https://w3id.org/probknow/resource/math-law/nelson-airway-mucosal-creasing-3> .

<https://w3id.org/probknow/resource/math-law/nelson-airway-mucosal-creasing-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cylindrical Bilayer Mucosal Buckling Wavenumber & Inverse Thickness Scaling Law" ;
    dct:description "Determines why thin healthy bronchioles buckle into many shallow rosette folds (m* ≈ 14) whereas thickened asthmatic airways buckle into a few deep folds (m* ≈ 5–6) | Variables: R_0: inner luminal radius; h_m: epithelial/basement-membrane mucosal thickness; μ_m, μ_s: mucosal and submucosal shear moduli; m*: circumferential rosette fold number" ;
    dct:source "Li, Cao, Feng & Gao (2011) J. Mech. Phys. Solids 59:758-774 Eq. (18); Eskandari, Pfaller & Kuhl (2015) J. Theor. Biol. 403:209-218 Eq. (14)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L145-L205>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L31-L46> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def scaled_fold_mode_normal (c_geom h0 dh : Nat) : Nat :=
  (c_geom + 1) * (h0 + dh + 2)
def scaled_fold_mode_asthma (c_geom h0 : Nat) : Nat :=
  (c_geom + 1) * (h0 + 1)
theorem inverse_mucosal_thickness_fold_scaling (c_geom h0 dh : Nat) :
    (h0 + 1) < (h0 + dh + 2) ∧
    scaled_fold_mode_asthma c_geom h0 < scaled_fold_mode_normal c_geom h0 dh
"""^^pk:lean4 ;
    skos:notation "λ_c = 2π h_m (μ_m / (3 μ_s))^(1/3),  m* = (R_0 / h_m) (3 μ_s / μ_m)^(1/3)  ⇒  h_asthma > h_normal ⟹ m*_asthma < m*_normal" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jmps.2011.01.010>,
        <https://doi.org/10.1016/j.jtbi.2016.05.022>,
        <https://doi.org/10.1115/1.4004128>,
        <https://doi.org/10.1152/jappl.1997.83.6.1814> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance" ;
    pk:leanDeclaration "MathOfBiology.Loop_068.scaled_fold_mode_normal" ;
    pk:leanTheorem "MathOfBiology.Loop_068.inverse_mucosal_thickness_fold_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/nelson-airway-mucosal-creasing-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inextensible Mucosal Perimeter Fold-Depth & Lumen-Area Occlusion Law" ;
    dct:description "Proves that at identical smooth-muscle shortening ε_θ, lower circumferential mode number m forces deeper inward fold intrusion and smaller open luminal area | Variables: P_0 = 2π R_0: inextensible mucosal perimeter; ε_θ: ASM circumferential shortening strain; m: integer fold mode number; A_lumen: open luminal cross-sectional area" ;
    dct:source "Wiggs, Hrousis, Drazen & Kamm (1997) J. Appl. Physiol. 83:1814-1821 Eqs. (2)-(6); Jin, Auguste, Hayward & Suo (2011) J. Appl. Mech. 78:031009" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L210-L365>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L61-L82> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def fold_occlusion_penalty_scaled (k_fold m_other : Nat) : Nat :=
  (k_fold + 1) * m_other
def open_lumen_area_scaled (a_net k_fold m_self m_other : Nat) : Int :=
  (a_net : Int) - ↑((k_fold + 1) * m_other) + 0 * (m_self : Int)
theorem inextensible_perimeter_lumen_occlusion (a_net k_fold m0 dm : Nat) :
    fold_occlusion_penalty_scaled k_fold (m0 + 1) <
      fold_occlusion_penalty_scaled k_fold (m0 + dm + 2) ∧
    open_lumen_area_scaled a_net k_fold (m0 + 1) (m0 + dm + 2) <
      open_lumen_area_scaled a_net k_fold (m0 + dm + 2) (m0 + 1)
"""^^pk:lean4 ;
    skos:notation "A_lumen(ε_θ, m) = A_ASM(ε_θ) - A_wall - (P_0^2 Δ_fold(ε_θ)) / (8π m)  ⇒  m_asthma < m_normal ⟹ A_lumen(m_asthma) < A_lumen(m_normal)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jmps.2011.01.010>,
        <https://doi.org/10.1016/j.jtbi.2016.05.022>,
        <https://doi.org/10.1115/1.4004128>,
        <https://doi.org/10.1152/jappl.1997.83.6.1814> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance" ;
    pk:leanDeclaration "MathOfBiology.Loop_068.open_lumen_area_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_068.inextensible_perimeter_lumen_occlusion" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/nelson-airway-mucosal-creasing-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hagen–Poiseuille Quadratic Lumen-Area Airway Resistance Amplification Law" ;
    dct:description "Governs the catastrophic (>15-fold) surge in airflow resistance during asthmatic bronchoconstriction due to period-doubling and deep mucosal creasing | Variables: R_flow: laminar Hagen–Poiseuille airway resistance; A_0 = π R_0^2: relaxed baseline lumen area; A_asthma, A_normal: constricted lumen areas" ;
    dct:source "Wiggs, Hrousis, Drazen & Kamm (1997) J. Appl. Physiol. 83:1814-1821 Eq. (7)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L180-L208>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_068_airway_mucosal_creasing.lean#L95-L106> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def poiseuille_conductance_sq (a_lumen : Nat) : Nat :=
  a_lumen * a_lumen
theorem poiseuille_quadratic_area_resistance_amplification (a0 da : Nat) :
    (a0 + 1) < (a0 + da + 2) ∧
    poiseuille_conductance_sq (a0 + 1) < poiseuille_conductance_sq (a0 + da + 2)
"""^^pk:lean4 ;
    skos:notation "R_flow / R_flow,0 = (A_0 / A_lumen)^2  ⇒  0 < A_asthma < A_normal ⟹ R_flow,asthma > R_flow,normal" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jmps.2011.01.010>,
        <https://doi.org/10.1016/j.jtbi.2016.05.022>,
        <https://doi.org/10.1115/1.4004128>,
        <https://doi.org/10.1152/jappl.1997.83.6.1814> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance" ;
    pk:leanDeclaration "MathOfBiology.Loop_068.poiseuille_conductance_sq" ;
    pk:leanTheorem "MathOfBiology.Loop_068.poiseuille_quadratic_area_resistance_amplification" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


        <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-airway-mucosal-creasing-audit-nelson-airway-mucosal-creasing-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-airway-mucosal-creasing-audit-nelson-airway-mucosal-creasing-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-airway-mucosal-creasing-audit-nelson-airway-mucosal-creasing-3> ;
    pk:hypothesisType "Cylindrical Neo-Hookean Bilayer Morphoelastic Buckling, Post-Buckling Period-Doubling & Sulcal Creasing Driving Hagen–Poiseuille Airway Resistance" ;
    pk:weightOfEvidence 5.32e-01 .


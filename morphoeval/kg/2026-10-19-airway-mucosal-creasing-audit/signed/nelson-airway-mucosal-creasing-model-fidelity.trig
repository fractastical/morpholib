            <https://doi.org/10.1152/jappl.1997.83.6.1814> .

    <https://doi.org/10.1016/j.jmps.2011.01.010> dcterms:date "2011"^^xsd:gYear ;
        dcterms:title "Surface wrinkling of mucosa on a compliant substrate in cylindrical tubes and bronchial airways" .

    <https://doi.org/10.1016/j.jtbi.2016.05.022> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "Patient-specific airway wall remodeling in chronic bronchitis and asthma: cylindrical morphoelasticity of mucosal folding" .

    <https://doi.org/10.1115/1.4004128> dcterms:date "2011"^^xsd:gYear ;
        dcterms:title "Creases in soft tissues generated by growth" .

    <https://doi.org/10.1152/jappl.1997.83.6.1814> dcterms:date "1997"^^xsd:gYear ;
        dcterms:title "A model of airway narrowing due to smooth muscle shortening" .

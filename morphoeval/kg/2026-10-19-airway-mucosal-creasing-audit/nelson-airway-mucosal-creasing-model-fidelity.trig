    <https://doi.org/10.1016/j.jmps.2011.01.010> dct:date "2011"^^xsd:gYear ;
        dct:title "Surface wrinkling of mucosa on a compliant substrate in cylindrical tubes and bronchial airways" .
    <https://doi.org/10.1016/j.jtbi.2016.05.022> dct:date "2015"^^xsd:gYear ;
        dct:title "Patient-specific airway wall remodeling in chronic bronchitis and asthma: cylindrical morphoelasticity of mucosal folding" .
    <https://doi.org/10.1115/1.4004128> dct:date "2011"^^xsd:gYear ;
        dct:title "Creases in soft tissues generated by growth" .
    <https://doi.org/10.1152/jappl.1997.83.6.1814> dct:date "1997"^^xsd:gYear ;
        dct:title "A model of airway narrowing due to smooth muscle shortening" .

        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance — Model fidelity to source: 58/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Computes the analytical cylindrical bilayer circumferential mode number m* = (R_0/h_m)*(3*mu_s/mu_m)^(1/3) (L41-50), backed by 3 Lean 4 theorems in `Loop_068_airway_mucosal_creasing.lean`. However, `generate_parametric_rosette_contour` (L53-77) uses a closed-form cosine profile rather than minimizing the nonlinear cylindrical bilayer Föppl-von Kármán / neo-Hookean energy with period-doubling subharmonic (m/2) and sulcal self-contact creasing." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2018-nelson-airway-mucosal-creasing.py L53–L77: Single-harmonic cosine profile without L-BFGS-B energy minimization, period-doubling, or creasing <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L53-L77>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-nelson-airway-mucosal-creasing.py L41–L50" ;
        dct:description "Exact cylindrical bilayer circumferential fold wavenumber formula m*" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L41-L50> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 068 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


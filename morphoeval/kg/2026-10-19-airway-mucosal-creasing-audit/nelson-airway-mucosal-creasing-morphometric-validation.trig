sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nelson-airway-mucosal-creasing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nelson-airway-mucosal-creasing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Wiggs et al. (1997), Li et al. (2011) & Eskandari et al. (2015) cylindrical bilayer mucosal folding, period-doubling & Poiseuille airway resistance — Morphometric validation: 52/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L181-212) reports only 3 analytical mode numbers m* without relaxed L-BFGS-B lumen area, period-doubling subharmonic ratio, Poiseuille resistance amplification, 12-point Pearson r / log-log slope, or specimen segmentation metrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2018-nelson-airway-mucosal-creasing.py L181–L212: Only 3 analytical m* values without p-values, resistance ratios, or specimen CV metrics <https://github.com/fractastical/morpholib/blob/e93f00e/2018-nelson-airway-mucosal-creasing.py#L181-L212>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-circumferential-fold-mode-number-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-bronchiole-circumferential-fold-mode-number-m>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-circumferential-fold-mode-number-m> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-circumferential-fold-mode-number-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Chronic bronchitis circumferential fold mode number m* = 12.74 folds" ;
        schema:measurementTechnique "Analytical bilayer buckling formula m* = (R_0/h_m)*(3*mu_s/mu_m)^(1/3)" ;
        schema:name "Chronic bronchitis circumferential fold mode number m*" ;
        schema:unitText "folds" ;
        schema:value "12.74" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-circumferential-fold-mode-number-m-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-chronic-bronchitis-circumferential-fold-mode-number-m-reference> a schema:PropertyValue ;
        dct:source "Eskandari et al. (2015) J. Theor. Biol. 403:209-218" ;
        schema:value "9.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-bronchiole-circumferential-fold-mode-number-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Healthy bronchiole circumferential fold mode number m* = 19.74 folds" ;
        schema:measurementTechnique "Analytical bilayer buckling formula m* = (R_0/h_m)*(3*mu_s/mu_m)^(1/3)" ;
        schema:name "Healthy bronchiole circumferential fold mode number m*" ;
        schema:unitText "folds" ;
        schema:value "19.74" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-bronchiole-circumferential-fold-mode-number-m-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-healthy-bronchiole-circumferential-fold-mode-number-m-reference> a schema:PropertyValue ;
        dct:source "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 & Eskandari et al. (2015) JTB 403:209-218" ;
        schema:value "14.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-circumferential-fold-mode-number-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Severe asthma circumferential fold mode number m* = 6.6 folds" ;
        schema:measurementTechnique "Analytical bilayer buckling formula m* = (R_0/h_m)*(3*mu_s/mu_m)^(1/3)" ;
        schema:name "Severe asthma circumferential fold mode number m*" ;
        schema:unitText "folds" ;
        schema:value "6.6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-circumferential-fold-mode-number-m-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nelson-airway-mucosal-creasing-measurement-severe-asthma-circumferential-fold-mode-number-m-reference> a schema:PropertyValue ;
        dct:source "Wiggs et al. (1997) J. Appl. Physiol. 83:1814-1821 & Li et al. (2011) JMPS 59:758-774" ;
        schema:value "5.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 068 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


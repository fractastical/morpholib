<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-dasypus-novemcinctus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dasypus-novemcinctus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dasypus-novemcinctus-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-dasypus-novemcinctus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg homogeneous stability" ;
    dct:description "Homogeneous steady state is stable before diffusion is added | Variables: a = 0.10, b = 0.90, f_u = 0.800, g_v = -1.000, det = 1.000 at lambda = 4.108 µm" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3166_dasypus_novemcinctus_turing_wavelength_s0.lean#L42-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem homogeneous_trace_negative : ((800 : Int) + (-1000)) < 0 := by decide"^^pk:lean4 ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0 at u0 = a + b" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jmor.10475>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.jmbbm.2010.12.013>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3166.homogeneous_trace_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3166.homogeneous_determinant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dasypus-novemcinctus-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Selects the 4.108 µm spot/ocellus wavelength on the Holocene dermal field | Variables: D_u = 0.160 µm^2/τ, D_v = 3.206 µm^2/τ, lambda_c = 4.108 µm, age = 0 Ma" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3166_dasypus_novemcinctus_turing_wavelength_s0.lean#L39-L54> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem differential_diffusion_ratio : dvMilli > 8 * duMilli := by decide"^^pk:lean4 ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jmor.10475>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.jmbbm.2010.12.013>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3166.turing_discriminant_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3166.differential_diffusion_ratio" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dasypus-novemcinctus-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail-scale mode packing against the primordium wavelength" ;
    dct:description "States what changes at 4.1 µm versus the 273 µm scale, with no chronospecies neighbour | Variables: lambda_detail = 4108 nm, lambda_primordium = 273000 nm, chronoseries length = 1, age delta = 0 Ma" ;
    dct:source "Vickaryous & Hall (2006) DOI:10.1002/jmor.10475" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3166_dasypus_novemcinctus_turing_wavelength_s0.lean#L18-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem detail_packs_sixty_six_modes : modePacking = 66 := by decide"^^pk:lean4 ;
    skos:notation "N = floor(lambda_273um / lambda_4.108um) = 66, remainder 1872 nm" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/jmor.10475>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.jmbbm.2010.12.013>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3166.modePacking" ;
    pk:leanTheorem "MathOfBiology.Loop_3166.detail_packs_sixty_six_modes" ;
    pk:leanVerified true .


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 4.108 µm on Holocene Dasypus novemcinctus dermis (Pass 1) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Fourier-split Schnakenberg integration and the critical-wavenumber formula are implemented as published. Diffusivities are reconstructed to hit 4.108 µm rather than taken from a Dasypus experiment, so this is not a direct paper reproduction." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py L77–L124" ;
        dct:description "Jacobian and k_c identity (Eqs. 1-3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py#L77-L124> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py L126–L165" ;
        dct:description "Periodic Fourier-split integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py#L126-L165> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3166_dasypus_novemcinctus_turing_wavelength_s0.lean L20–L54" ;
        dct:description "Seven theorems, zero sorry, mode packing 66 and Turing discriminant" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3166_dasypus_novemcinctus_turing_wavelength_s0.lean#L20-L54> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider on this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 4.108 µm on Holocene Dasypus novemcinctus dermis (Pass 1) — Morphometric validation: 64/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The saturated wavelength (4.56 µm) is reported against the linear target 4.108 µm, and σ(k_c) is positive. Pearson r, RMSE, KS, and a specimen segmentation are absent, so the dimension cannot score higher on this pass." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-linear-growth-rate-at-kc>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-saturated-activator-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-file-bytes>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-linear-growth-rate-at-kc> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear_growth_rate_at_kc = 0.2185 1/τ" ;
        schema:measurementTechnique "Larger eigenvalue of J - k_c^2 D" ;
        schema:name "linear_growth_rate_at_kc" ;
        schema:unitText "1/τ" ;
        schema:value "0.2185" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-linear-growth-rate-at-kc-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-linear-growth-rate-at-kc-reference> a schema:PropertyValue ;
        dct:source "Marginal stability would be σ = 0; the band is unstable" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-saturated-activator-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "saturated_activator_wavelength_um = 4.5617 µm" ;
        dct:description "Finite-amplitude spots sit slightly long of the linear k_c. value != reference." ;
        schema:measurementTechnique "Parabolic peak of the radial Fourier power of the saturated activator" ;
        schema:name "saturated_activator_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "4.5617" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-saturated-activator-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-saturated-activator-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "Linear Turing wavelength pinned to the 4.108 µm detail rung" ;
        schema:value "4.108" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-file-bytes> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_file_bytes = 440984 byte" ;
        schema:measurementTechnique "Vendored CC BY-SA photograph byte length" ;
        schema:name "specimen_file_bytes" ;
        schema:unitText "byte" ;
        schema:value "440984" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-file-bytes-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-measurement-specimen-file-bytes-reference> a schema:PropertyValue ;
        dct:source "A missing specimen would be 0 bytes" ;
        schema:value "0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py L167–L199" ;
        dct:description "Radial Fourier wavelength with parabolic peak" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py#L167-L199> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py L322–L359" ;
        dct:description "measure_morphoeval returns wavelength, growth rate, specimen bytes; value != reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py#L322-L359> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single builder-assessor; no second provider on this pass)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


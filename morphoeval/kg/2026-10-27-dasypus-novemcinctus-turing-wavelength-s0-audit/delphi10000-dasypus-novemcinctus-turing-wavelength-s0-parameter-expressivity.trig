sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 4.108 µm on Holocene Dasypus novemcinctus dermis (Pass 1) — Parameter expressivity: 58/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "a, b, and the diffusion ratio are named constants and the dispersion identity is checked in --self-test. No range is exercised, so monotonic control of wavelength is not demonstrated." ;

        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py L42–L55" ;
        dct:description "Named a, b, diffusion ratio, grid, seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py#L42-L55> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dasypus-novemcinctus-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py L361–L390" ;
        dct:description "Self-test checks one parameter point only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-dasypus-novemcinctus-turing-wavelength-s0.py#L361-L390> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

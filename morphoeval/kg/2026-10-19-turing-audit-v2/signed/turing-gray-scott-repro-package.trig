sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-v2-turing-gray-scott-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Reproducibility package: 89/100" ;
        rdfs:comment "Deterministic RNG (`seed=1952`), pinned `requirements.lock.txt`, comprehensive `--self-test` suite verifying Turing (1952) dispersion + JSON parity, exact Hopf curve `|tr(J_0)| < 1e-12`, diffusivity-ratio sweep monotonicity, sub-bin spectral rings, analytical vs. nonlinear wavelength agreement, biological specimen segmentation, and two-run bitwise determinism (`np.allclose(..., atol=0.0)`), plus byte-synchronized animated GIF outputs at `docs/media/turing_gray_scott.gif` and `turing_patterns_black_neon.gif`." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-repro-package> ;
        pk:evidenceFor "1952-turing-morpho.py L1263–L1383: Comprehensive 8-check self_test() suite including JSON parity, Hopf trace, sweep monotonicity, and bitwise determinism <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L1263-L1383>" ;
        pk:hasProbability "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-repro-package> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Marine angelfish (Pomacanthus imperator) skin stripes, spotted boxfish (Ostracion meleagris) spots & Gray-Scott chemical patterns" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}


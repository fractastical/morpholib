sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-v2-turing-gray-scott-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Model fidelity to source: 92/100" ;
        rdfs:comment "Implements both Turing's (1952) Sections 8-10 linearized two-morphogen reaction-diffusion dispersion relation sigma(k^2) + discrete N=20 ring-of-cells model (L163-244, d_c=3.927051, k_c=1.118034 rad/cell, dominant mode s*=4) and Pearson's (1993) 2D periodic Gray-Scott PDE with exact Saddle-Node (4*(F+k)^2 = F) and Hopf (F_Hopf(k) where max |tr(J_0)| = 2.36e-16) bifurcation curves (L327-426). The equal-diffusion negative control (Du=Dv=0.20 at F=0.054, k=0.0616) is initialized around the exact nontrivial homogeneous steady state (U_*, V_*) and verified against the supercritical Turing state (Du=0.20, Dv=0.10, sigma=+0.00164). Backed by 4 Lean 4 theorems in `MathOfBiology.lean` Section 5." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-model-fidelity> ;
        pk:evidenceFor "1952-turing-morpho.py L163–L244: Turing (1952) Sec. 8-10 linear dispersion relation sigma(k^2) and N=20 cell ring solver <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L163-L244>",
            "1952-turing-morpho.py L327–L426: Pearson (1993) exact Saddle-Node & Hopf curves and steady-state linear dispersion <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L327-L426>",
            "morphoeval/lean/MathOfBiology.lean L195–L283: 4 machine-checked Lean 4 theorems for Gray-Scott and Turing instability <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/MathOfBiology.lean#L195-L283>" ;
        pk:hasProbability "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-model-fidelity> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Marine angelfish (Pomacanthus imperator) skin stripes, spotted boxfish (Ostracion meleagris) spots & Gray-Scott chemical patterns" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}


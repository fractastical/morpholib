sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-v2-turing-gray-scott-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Source and data traceability: 94/100" ;
        rdfs:comment "Vendors `datasets/turing/` with `turing_reference.json`, `pomacanthus_imperator_stripes_specimen.jpg`, `ostracion_meleagris_spots_specimen.jpg`, `paper_citations.bib` (4 primary DOIs: `10.1098/rstb.1952.0012`, `10.1126/science.261.5118.189`, `10.1038/369215a0`, `10.1038/376765a0`), and `datasets/turing/README.md`, with runtime SHA-256 cryptographic verification (`EXPECTED_SHA256`, L91-125) and JSON-to-code parity assertions in `self_test()` (L1288-1308)." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-source-traceability> ;
        pk:evidenceFor "1952-turing-morpho.py L91–L125: Runtime SHA-256 verification of datasets/turing/ reference JSON and specimen images <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L91-L125>",
            "datasets/turing/turing_reference.json L1–L145: Vendored Turing 1952, Pearson 1993 12-class, and Kondo & Asai 1995 reference dataset <https://github.com/fractastical/morpholib/blob/b9976f8/datasets/turing/turing_reference.json#L1-L145>" ;
        pk:hasProbability "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-source-traceability> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Marine angelfish (Pomacanthus imperator) skin stripes, spotted boxfish (Ostracion meleagris) spots & Gray-Scott chemical patterns" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-v2-turing-gray-scott-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Parameter expressivity: 81/100" ;
        rdfs:comment "Maps all 12 Pearson (1993) pattern classes (alpha through mu) onto the (k, F) bifurcation diagram (Panel C2), simulates 5 distinct initialization/parameter regimes in `PEARSON_REGIMES`, executes a 5-point diffusivity-ratio sweep across d = Du/Dv in {1.0, 1.25, 1.5, 2.0, 2.5} (`run_diffusivity_ratio_sweep`, L515-536) spanning the analytical Turing threshold, and wires `--F`, `--k`, `--Du`, `--Dv`, `--N`, `--steps`, and `--seed` CLI arguments into the solver (L939-954, L1385-1425)." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-parameter-expressivity> ;
        pk:evidenceFor "1952-turing-morpho.py L515–L536: 5-point diffusivity ratio sweep across d = Du/Dv <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L515-L536>",
            "1952-turing-morpho.py L939–L954: CLI parameter overrides wired into PEARSON_REGIMES <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L939-L954>" ;
        pk:hasProbability "0.81"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-parameter-expressivity> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Marine angelfish (Pomacanthus imperator) skin stripes, spotted boxfish (Ostracion meleagris) spots & Gray-Scott chemical patterns" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}


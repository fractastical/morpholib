sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-v2-turing-gray-scott-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Code-to-model traceability: 89/100" ;
        rdfs:comment "Every computational section and function docstring maps directly to numbered sections, equations, and figures in Turing (1952) Sections 8-10, Pearson (1993) Eq. 1 & Figs. 1-2, Lee et al. (1994) Fig. 2, and Kondo & Asai (1995) Figs. 1-2, as well as the 4 Lean 4 theorems in `morphoeval/lean/MathOfBiology.lean` Section 5." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-code-traceability> ;
        pk:evidenceFor "1952-turing-morpho.py L18–L66: Module docstring mapping equations to Turing (1952), Pearson (1993), and Kondo & Asai (1995) <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L18-L66>" ;
        pk:hasProbability "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-code-traceability> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Marine angelfish (Pomacanthus imperator) skin stripes, spotted boxfish (Ostracion meleagris) spots & Gray-Scott chemical patterns" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}


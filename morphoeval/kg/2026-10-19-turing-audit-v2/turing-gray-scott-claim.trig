}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> a pk:Claim ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis faithfully reproduces Marine angelfish (Pomacanthus imperator) skin stripes, spotted boxfish (Ostracion meleagris) spots & Gray-Scott chemical patterns morphology" ;
        dct:description "The simulation script(s) 1952-turing-morpho.py implement the cited source model as published and produce forms that match real Marine angelfish (Pomacanthus imperator) skin stripes, spotted boxfish (Ostracion meleagris) spots & Gray-Scott chemical patterns specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 85.5/100, audit 2026-10-19-turing-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py; output: turing_pearson_morphospace.png; organism: Marine angelfish (Pomacanthus imperator) skin stripes, spotted boxfish (Ostracion meleagris) spots & Gray-Scott chemical patterns; checkpoint commit: https://github.com/fractastical/morpholib/commit/b9976f8; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 457ba1d8776c5109e7d828595ec1ea637e0d9b8eebcf725fc073d1f70566f695; artifact_sha256: 4dce6f8427cdf23e4b4ac23e908910f5253d95b4a9e9f417d1720aadef17985a" ;
        pk:derivedFromPaper <https://doi.org/10.1038/369215a0>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-specimen-match> ;
        pk:weightOfEvidence "0.855"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py> a schema:SoftwareSourceCode ;
        rdfs:label "1952-turing-morpho.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "b9976f8" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Source and data traceability: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors `datasets/turing/` with `turing_reference.json`, `pomacanthus_imperator_stripes_specimen.jpg`, `ostracion_meleagris_spots_specimen.jpg`, `paper_citations.bib` (4 primary DOIs: `10.1098/rstb.1952.0012`, `10.1126/science.261.5118.189`, `10.1038/369215a0`, `10.1038/376765a0`), and `datasets/turing/README.md`, with runtime SHA-256 cryptographic verification (`EXPECTED_SHA256`, L91-125) and JSON-to-code parity assertions in `self_test()` (L1288-1308)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-source-traceability-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L91–L125" ;
        dct:description "Runtime SHA-256 verification of datasets/turing/ reference JSON and specimen images" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L91-L125> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/turing/turing_reference.json L1–L145" ;
        dct:description "Vendored Turing 1952, Pearson 1993 12-class, and Kondo & Asai 1995 reference dataset" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/datasets/turing/turing_reference.json#L1-L145> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies real CC BY-SA 4.0 biological specimen photographs of adult `Pomacanthus imperator` skin stripes (`pomacanthus_imperator_stripes_specimen.jpg`) and `Ostracion meleagris` boxfish spots (`ostracion_meleagris_spots_specimen.jpg`), segments the yellow/blue angelfish stripes and medial-axis Y-branch dislocations (mean inter-stripe spacing 9.55 px, CV=0.149, 22 macroscopic Y-junctions) and 121 boxfish Turing spots (L706-845), and differentiates Pearson's single-patch self-replicating spot regime (A1, `pearson_center`) from domain-filling quasi-hexagonal spots (A2), labyrinthine stripes (A3), and steady-state Turing labyrinth (A4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-specimen-match-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L706–L845" ;
        dct:description "Pomacanthus stripe + Y-junction segmentation and Ostracion DoG spot segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L706-L845> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "turing_pearson_morphospace.png (generated output)" ;
        dct:description "15-panel synthesis figure displaying 5 Gray-Scott fields, 5 radial PSDs, and 5 theory/specimen panels (C1-C5) — turing_pearson_morphospace.png: rendered output of 1952-turing-morpho.py at b9976f8, image/png, 1674289 B, 2617×1806 px, artifact_sha256 4dce6f8427cdf23e4b4ac23e908910f5253d95b4a9e9f417d1720aadef17985a (sha256 4dce6f8427cdf23e4b4ac23e908910f5253d95b4a9e9f417d1720aadef17985a), spec_fingerprint 457ba1d8776c5109e7d828595ec1ea637e0d9b8eebcf725fc073d1f70566f695" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Code-to-model traceability: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational section and function docstring maps directly to numbered sections, equations, and figures in Turing (1952) Sections 8-10, Pearson (1993) Eq. 1 & Figs. 1-2, Lee et al. (1994) Fig. 2, and Kondo & Asai (1995) Figs. 1-2, as well as the 4 Lean 4 theorems in `morphoeval/lean/MathOfBiology.lean` Section 5." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-code-traceability-1> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L18–L66" ;
        dct:description "Module docstring mapping equations to Turing (1952), Pearson (1993), and Kondo & Asai (1995)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L18-L66> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


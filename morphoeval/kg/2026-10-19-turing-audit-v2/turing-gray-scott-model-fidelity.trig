        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-turing-gray-scott-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Model fidelity to source: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements both Turing's (1952) Sections 8-10 linearized two-morphogen reaction-diffusion dispersion relation sigma(k^2) + discrete N=20 ring-of-cells model (L163-244, d_c=3.927051, k_c=1.118034 rad/cell, dominant mode s*=4) and Pearson's (1993) 2D periodic Gray-Scott PDE with exact Saddle-Node (4*(F+k)^2 = F) and Hopf (F_Hopf(k) where max |tr(J_0)| = 2.36e-16) bifurcation curves (L327-426). The equal-diffusion negative control (Du=Dv=0.20 at F=0.054, k=0.0616) is initialized around the exact nontrivial homogeneous steady state (U_*, V_*) and verified against the supercritical Turing state (Du=0.20, Dv=0.10, sigma=+0.00164). Backed by 4 Lean 4 theorems in `MathOfBiology.lean` Section 5." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L163–L244" ;
        dct:description "Turing (1952) Sec. 8-10 linear dispersion relation sigma(k^2) and N=20 cell ring solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L163-L244> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1952-turing-morpho.py L327–L426" ;
        dct:description "Pearson (1993) exact Saddle-Node & Hopf curves and steady-state linear dispersion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/1952-turing-morpho.py#L327-L426> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-turing-gray-scott-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/MathOfBiology.lean L195–L283" ;
        dct:description "4 machine-checked Lean 4 theorems for Gray-Scott and Turing instability" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b9976f8/morphoeval/lean/MathOfBiology.lean#L195-L283> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/369215a0>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .
    <https://doi.org/10.1038/369215a0> dct:date "1994"^^xsd:gYear ;
        dct:title "Experimental observation of self-replicating spots in a reaction-diffusion system" .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.261.5118.189> dct:date "1993"^^xsd:gYear ;
        dct:title "Complex patterns in a simple system" .
}


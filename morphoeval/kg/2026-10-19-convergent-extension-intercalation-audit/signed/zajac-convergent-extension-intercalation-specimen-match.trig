sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-zajac-convergent-extension-intercalation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Zajac, Jones & Glazier (2000, 2003) / Bertet, Sulak & Lecuit (2004) anisotropic differential adhesion and polarized T1 junctional intercalation in convergent extension — Morphological realism / specimen match: 57/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors `datasets/convergent_extension_intercalation/convergent_extension_axis_specimen.jpg` (CC BY 4.0 confocal micrographs and polarity rose plots of Xenopus animal cap vs chordamesoderm explant cells) and extracts cell aspect ratios (L/W = 4.945 vs 0.962) and nematic order S_2 (0.613 vs 0.094), but Pass 1 lacks angular rose-histogram correlation between the theoretical von Mises / cos(2*theta) polarity distribution and the empirical rose diagram." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2003-zajac-convergent-extension-intercalation.py L468–L542: Confocal Xenopus cell segmentation and rose nematic order extraction requiring angular histogram correlation <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L468-L542>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-specimen-match-1> ;
        pk:hasScore "0.57"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/convergent_extension_intercalation_comparison.png (generated output)" ;
        dcterms:description "Panel F confocal Xenopus explant comparison — docs/media/convergent_extension_intercalation_comparison.png: rendered output of 2003-zajac-convergent-extension-intercalation.py at 317bc3c, image/png, 766141 B, 2408×1428 px, artifact_sha256 a11c5fb7b4c7f5f6341d299c41a798581da67d2fcb854b952069a39d1810e432 (sha256 a11c5fb7b4c7f5f6341d299c41a798581da67d2fcb854b952069a39d1810e432), spec_fingerprint 70c0d2a81cec84a4a194e326ee3833640573b76865ed3d8f4c5ff14fdbf4448d" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


    <https://doi.org/10.1016/S0022-5193(03)00033-X> dcterms:date "2003"^^xsd:gYear ;
        dcterms:title "Simulating convergent extension by way of anisotropic differential adhesion" .

    <https://doi.org/10.1038/35011077> dcterms:date "2000"^^xsd:gYear ;
        dcterms:title "Dishevelled controls cell polarity during Xenopus gastrulation" .


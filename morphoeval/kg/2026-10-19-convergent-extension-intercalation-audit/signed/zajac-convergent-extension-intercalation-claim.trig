sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-zajac-convergent-extension-intercalation> a pk:Claim ;
        rdfs:label "Zajac, Jones & Glazier (2000, 2003) / Bertet, Sulak & Lecuit (2004) anisotropic differential adhesion and polarized T1 junctional intercalation in convergent extension faithfully reproduces Xenopus laevis (chordamesoderm Keller explant) & Drosophila melanogaster (germband extension epithelium) morphology" ;
        dcterms:description "The simulation script(s) 2003-zajac-convergent-extension-intercalation.py implement the cited source model as published and produce forms that match real Xenopus laevis (chordamesoderm Keller explant) & Drosophila melanogaster (germband extension epithelium) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 60.7/100, audit 2026-10-19-convergent-extension-intercalation-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py; output: docs/media/convergent_extension_intercalation_comparison.png; organism: Xenopus laevis (chordamesoderm Keller explant) & Drosophila melanogaster (germband extension epithelium); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 70c0d2a81cec84a4a194e326ee3833640573b76865ed3d8f4c5ff14fdbf4448d; artifact_sha256: a11c5fb7b4c7f5f6341d299c41a798581da67d2fcb854b952069a39d1810e432; input_dataset_sha256: {datasets/convergent_extension_intercalation/convergent_extension_axis_specimen.jpg=0c2620bce19ad4cf..., datasets/convergent_extension_intercalation/convergent_extension_intercalation_reference.json=5e3d70d1a6711a38..., datasets/convergent_extension_intercalation/scout_manifest.json=66a1e6f4d0f0a745...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/S0022-5193(03)00033-X>,
            <https://doi.org/10.1038/35011077>,
            <https://doi.org/10.1038/nature02590>,
            <https://doi.org/10.1103/PhysRevLett.85.2022> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-specimen-match> ;
        pk:weightOfEvidence "0.607"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py> a schema:SoftwareSourceCode ;

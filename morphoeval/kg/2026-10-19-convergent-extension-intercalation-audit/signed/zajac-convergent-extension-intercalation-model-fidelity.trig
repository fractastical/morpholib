            <https://doi.org/10.1103/PhysRevLett.85.2022> .

    <https://doi.org/10.1016/S0022-5193(03)00033-X> dcterms:date "2003"^^xsd:gYear ;
        dcterms:title "Simulating convergent extension by way of anisotropic differential adhesion" .

    <https://doi.org/10.1038/35011077> dcterms:date "2000"^^xsd:gYear ;
        dcterms:title "Dishevelled controls cell polarity during Xenopus gastrulation" .

    <https://doi.org/10.1038/nature02590> dcterms:date "2004"^^xsd:gYear ;
        dcterms:title "Myosin-dependent junction remodelling controls planar cell intercalation and axis elongation" .

    <https://doi.org/10.1103/PhysRevLett.85.2022> dcterms:date "2000"^^xsd:gYear ;
        dcterms:title "Model of convergent extension in animal morphogenesis" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-zajac-convergent-extension-intercalation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Zajac, Jones & Glazier (2000, 2003) / Bertet, Sulak & Lecuit (2004) anisotropic differential adhesion and polarized T1 junctional intercalation in convergent extension — Model fidelity to source: 64/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Zajac et al.'s (2003) anisotropic adhesion law J(theta) = J_0 - Delta_J cos(2*theta), Bertet et al.'s (2004) T1 quartet junction remodelling, and pure-shear area conservation L_AP * L_ML = A_0 (L120-260), but Pass 1 lacks an explicit numerical RK2 ODE convergence check against the exact analytical pure-shear aspect ratio R_CE(t) = R_0 exp(2*dot_epsilon*t) and explicit Fourier harmonic verification of the angular adhesion profile." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2003-zajac-convergent-extension-intercalation.py L275–L405: 64-cell T1 intercalation solver needing RK2 pure-shear ODE convergence verification <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L275-L405>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-1> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2003-zajac-convergent-extension-intercalation.py L120–L165" ;
        dcterms:description "Anisotropic adhesion energy, polarized junction tension, and T1 energy drop" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L120-L165> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


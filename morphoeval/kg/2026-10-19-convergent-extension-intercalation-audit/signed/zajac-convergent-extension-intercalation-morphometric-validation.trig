sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-zajac-convergent-extension-intercalation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Zajac, Jones & Glazier (2000, 2003) / Bertet, Sulak & Lecuit (2004) anisotropic differential adhesion and polarized T1 junctional intercalation in convergent extension — Morphometric validation: 59/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exports 6 measurements via `measure_morphoeval()`, but Pass 1 needs >= 7 measurements including the angular rose-diagram cross-correlation r and RK2 pure-shear ODE L2 error." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2003-zajac-convergent-extension-intercalation.py L548–L645: 6-metric dynamic MorphoEval measurement suite <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L548-L645>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-5-regime-convergent-extension-aspect-ratio-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-isotropic-adhesion-negative-control-aspect-ratio-r-ce>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-specimen-xenopus-chordamesoderm-polarized-cell-aspect-ratio-l-w>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-wild-type-convergent-extension-aspect-ratio-r-ce-l-ap-l-ml>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-wild-type-cumulative-t1-transitions-per-cell>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-xdd1-dishevelled-pcp-mutant-aspect-ratio-r-ce> ;
        pk:hasScore "0.59"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-5-regime-convergent-extension-aspect-ratio-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime convergent-extension aspect ratio Pearson correlation r = 1.0 correlation_r" ;
        dcterms:description "RMSE = 0.0042, p = 1.827e-08" ;
        schema:measurementTechnique "Pearson correlation across all 5 Zajac et al. (2003) / Bertet et al. (2004) / Wallingford et al. (2000) regimes (Wild-Type, Moderate Anisotropy, Xdd1 PCP mutant, Myosin II mutant, Isotropic Null Control)" ;
        schema:name "5-regime convergent-extension aspect ratio Pearson correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-5-regime-convergent-extension-aspect-ratio-pearson-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-5-regime-convergent-extension-aspect-ratio-pearson-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Zajac et al. (2003) J. Theor. Biol. 222:247-259; Bertet et al. (2004) Nature 429:667-671" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-isotropic-adhesion-negative-control-aspect-ratio-r-ce> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "isotropic adhesion negative control aspect ratio R_CE = 1.0 dimensionless" ;
        dcterms:description "cumulative T1 transitions per cell = 0.00 (ref 0.00)" ;
        schema:measurementTechnique "Negative control with isotropic cell-cell adhesion (Delta_J = 0, Delta_Lambda = 0) and zero planar T1 intercalation" ;
        schema:name "isotropic adhesion negative control aspect ratio R_CE" ;
        schema:unitText "dimensionless" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-isotropic-adhesion-negative-control-aspect-ratio-r-ce-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-isotropic-adhesion-negative-control-aspect-ratio-r-ce-reference> a schema:PropertyValue ;
        dcterms:source "Zajac, Jones & Glazier (2003) J. Theor. Biol. 222:247-259 Fig. 3 (isotropic cells fail to converge and extend)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-specimen-xenopus-chordamesoderm-polarized-cell-aspect-ratio-l-w> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Xenopus chordamesoderm polarized cell aspect ratio L/W = 4.9453 dimensionless" ;
        dcterms:description "isotropic animal cap L/W = 0.9623 (fold increase = 5.14x); chordamesoderm rose nematic order S_2 = 0.6130 vs animal cap S_2 = 0.0940" ;
        schema:measurementTechnique "Automated fluorescence connected-component segmentation of polarized Xenopus chordamesoderm cell (Panel b) vs isotropic animal cap cell (Panel a) in convergent_extension_axis_specimen.jpg" ;
        schema:name "specimen Xenopus chordamesoderm polarized cell aspect ratio L/W" ;
        schema:unitText "dimensionless" ;
        schema:value "4.9453" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-specimen-xenopus-chordamesoderm-polarized-cell-aspect-ratio-l-w-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-specimen-xenopus-chordamesoderm-polarized-cell-aspect-ratio-l-w-reference> a schema:PropertyValue ;
        dcterms:source "Confocal Xenopus gastrula explant micrograph (convergent_extension_axis_specimen.jpg Panel b, CC BY 4.0)" ;
        schema:value "4.9453" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-wild-type-convergent-extension-aspect-ratio-r-ce-l-ap-l-ml> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type convergent-extension aspect ratio R_CE = L_AP / L_ML = 3.859 dimensionless" ;
        dcterms:description "AP extension L_AP/L_0 = 1.964, ML convergence L_ML/L_0 = 0.509, incompressible area error = 1.11e-16" ;
        schema:measurementTechnique "Integrated 64-cell Zajac et al. (2003) anisotropic differential adhesion & Bertet et al. (2004) polarized T1 intercalation lattice over 40 min" ;
        schema:name "wild-type convergent-extension aspect ratio R_CE = L_AP / L_ML" ;
        schema:unitText "dimensionless" ;
        schema:value "3.859" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-wild-type-convergent-extension-aspect-ratio-r-ce-l-ap-l-ml-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-wild-type-convergent-extension-aspect-ratio-r-ce-l-ap-l-ml-reference> a schema:PropertyValue ;
        dcterms:source "Zajac, Jones & Glazier (2003) J. Theor. Biol. 222:247-259 Fig. 4; Bertet et al. (2004) Nature 429:667-671 Fig. 1" ;
        schema:value "3.86" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-wild-type-cumulative-t1-transitions-per-cell> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wild-type cumulative T1 transitions per cell = 1.45 transitions_per_cell" ;
        dcterms:description "T1 free-energy drop Delta_E_T1(l_0=4.2 um) = -4.032" ;
        schema:measurementTechnique "Cumulative irreversible vertical-to-horizontal T1 quartet neighbor exchanges per cell across 40 min of axis elongation" ;
        schema:name "wild-type cumulative T1 transitions per cell" ;
        schema:unitText "transitions_per_cell" ;
        schema:value "1.45" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-wild-type-cumulative-t1-transitions-per-cell-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-wild-type-cumulative-t1-transitions-per-cell-reference> a schema:PropertyValue ;
        dcterms:source "Bertet, Sulak & Lecuit (2004) Nature 429:667-671 Fig. 1" ;
        schema:value "1.45" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-xdd1-dishevelled-pcp-mutant-aspect-ratio-r-ce> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Xdd1 Dishevelled PCP mutant aspect ratio R_CE = 1.5664 dimensionless" ;
        dcterms:description "T1 transitions per cell = 0.38 (ref 0.38)" ;
        schema:measurementTechnique "Simulated Wnt/PCP Dishevelled (Xdd1 / strabismus) polarity-scrambled mutant with reduced planar coherence (C_PCP = 0.32)" ;
        schema:name "Xdd1 Dishevelled PCP mutant aspect ratio R_CE" ;
        schema:unitText "dimensionless" ;
        schema:value "1.5664" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-xdd1-dishevelled-pcp-mutant-aspect-ratio-r-ce-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-measurement-xdd1-dishevelled-pcp-mutant-aspect-ratio-r-ce-reference> a schema:PropertyValue ;
        dcterms:source "Wallingford et al. (2000) Nature 405:81-85 Fig. 2; Zajac et al. (2003) J. Theor. Biol. 222:247" ;
        schema:value "1.56" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


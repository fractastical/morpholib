<https://w3id.org/probknow/resource/assessment/morphoeval-zajac-convergent-extension-intercalation-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Zajac, Jones & Glazier (2000, 2003) / Bertet, Sulak & Lecuit (2004) anisotropic differential adhesion and polarized T1 junctional intercalation in convergent extension — Model fidelity to source: 64/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements Zajac et al.'s (2003) anisotropic adhesion law J(theta) = J_0 - Delta_J cos(2*theta), Bertet et al.'s (2004) T1 quartet junction remodelling, and pure-shear area conservation L_AP * L_ML = A_0 (L120-260), but Pass 1 lacks an explicit numerical RK2 ODE convergence check against the exact analytical pure-shear aspect ratio R_CE(t) = R_0 exp(2*dot_epsilon*t) and explicit Fourier harmonic verification of the angular adhesion profile." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2003-zajac-convergent-extension-intercalation.py L275–L405: 64-cell T1 intercalation solver needing RK2 pure-shear ODE convergence verification <https://github.com/fractastical/morpholib/blob/317bc3c/2003-zajac-convergent-extension-intercalation.py#L275-L405>" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-zajac-convergent-extension-intercalation-model-fidelity-1> ;
    pk:hasScore 6.4e-01 ;
    pk:hasVerdict "mostly faithful" .


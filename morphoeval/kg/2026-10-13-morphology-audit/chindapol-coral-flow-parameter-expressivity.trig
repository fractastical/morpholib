        rdfs:label "2013-chindapol-coral-flow.py L186–L196" ;
        dct:description "drift sweep and metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2013-chindapol-coral-flow.py#L186-L196> .

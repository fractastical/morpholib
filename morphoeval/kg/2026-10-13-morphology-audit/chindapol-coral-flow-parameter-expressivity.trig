        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chindapol-coral-flow-parameter-expressivity-1> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

        rdfs:label "Chindapol flow-driven coral growth — Parameter expressivity: 70/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Drift (Pe proxy) sweep produces the monotonic upstream-shift and compaction trends." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;

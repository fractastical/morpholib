sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chindapol-coral-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-overall> .
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — MorphoEval overall 55.5/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Declared reduction: the paper's 3-D Navier-Stokes + advection-diffusion accretive growth (solved in COMSOL) is replaced by 2-D DLA-with-drift, with drift bias standing in for the Peclet number. Qualitative symmetric-to-upstream transition and compactification are recovered. Overall 55.5/100 (faithfulness 49.3, reproducibility 70.0); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Compare smmag / alignment curves numerically against the paper's reported values.",
            "remediation needed: Replace DLA-with-drift with a real 2-D flow + advection-diffusion + accretive-growth solver." ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-chindapol-coral-flow-output-chindapol-coral-flow-morphospace-png> ;
        pk:hasVerdict "partially faithful" ;
        pk:weightOfEvidence 5.55e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-chindapol-coral-flow-output-chindapol-coral-flow-morphospace-png> a prov:Entity,
            schema:ImageObject,
            pk:EvidenceItem ;
        rdfs:label "chindapol_coral_flow_morphospace.png" ;
        dct:description "rendered output of 2013-chindapol-coral-flow.py; not present when the audit was snapshotted, so unfingerprinted" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2013-chindapol-coral-flow.py> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


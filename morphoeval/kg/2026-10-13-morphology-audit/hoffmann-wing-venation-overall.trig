@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-overall> .
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — MorphoEval overall 77.8/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Follows the authors' own procedure on their own example wing: real silhouette and primary-vein scaffold, secondary veins regenerated by Lloyd equilibration + Voronoi at the real local density. 923 real vein domains reproduced; circularity real 0.712 vs model 0.867 (hexagon ceiling 0.907). Overall 77.8/100 (faithfulness 81.1, reproducibility 70.0); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add a circularity-vs-iteration sweep panel to show the equilibration transition.",
            "remediation needed: Add scikit-image and Pillow to requirements.txt and pin numpy >= 2.5 for Python 3.14.",
            "remediation needed: Optionally switch the Lloyd stop rule to the paper's 0.1%-of-wing-length threshold." ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7.78e-01 .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/commit/f3fe478>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-specimen-match> .
}


@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — Model fidelity to source: 40/100" ;
        rdfs:comment "Honest, documented stand-in, but it does not solve the flow or the nutrient field; the Peclet number is a drift bias, not u*L/D. The physics is reproducible with open-source solvers in 2-D. Evidence: 2013-chindapol-coral-flow.py L27–L36: docstring: NS/COMSOL 'out of scope', DLA-with-drift substitution <https://github.com/fractastical/morpholib/blob/f3fe478/2013-chindapol-coral-flow.py#L27-L36>; 2013-chindapol-coral-flow.py L65–L122: simulate_coral: biased random walk, stick on contact <https://github.com/fractastical/morpholib/blob/f3fe478/2013-chindapol-coral-flow.py#L65-L122>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-model-fidelity> ;
        pk:hasProbability "0.4"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-model-fidelity> rdfs:label "Chindapol flow-driven coral growth (2013-chindapol-coral-flow.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Scleractinian coral Pocillopora verrucosa" ;
        dct:identifier "morphoeval/0.1.0/model-fidelity" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1371/journal.pcbi.1002849> .
    <https://doi.org/10.1371/journal.pcbi.1002849> dct:date "2013"^^xsd:gYear ;
        dct:title "Modelling Growth and Form of the Scleractinian Coral Pocillopora verrucosa and the Influence of Hydrodynamics" .
}


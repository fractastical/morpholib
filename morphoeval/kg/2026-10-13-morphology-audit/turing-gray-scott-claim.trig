@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> a pk:Claim ;
        rdfs:label "Gray-Scott reaction-diffusion patterns faithfully reproduces Generic (Turing pattern formation) morphology" ;
        dct:description "The simulation script(s) 1952-turing-morpho.py implement the cited source model as published and produce forms that match real Generic (Turing pattern formation) specimens and the source authors' figures." ;
        pk:context "script(s): 1952-turing-morpho.py; output: turing_patterns.gif; organism: Generic (Turing pattern formation); checkpoint commit: f3fe478" ;
        pk:derivedFromPaper <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .
    <https://doi.org/10.1098/rstb.1952.0012> a pk:Paper ;
        dct:bibliographicCitation "Phil. Trans. R. Soc. Lond. B 237(641):37-72 (1952)" ;
        dct:creator "Turing AM" ;
        dct:identifier "doi:10.1098/rstb.1952.0012" ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.261.5118.189> a pk:Paper ;
        dct:bibliographicCitation "Science 261(5118):189-192 (1993)" ;
        dct:creator "Pearson JE" ;
        dct:identifier "doi:10.1126/science.261.5118.189" ;
        dct:title "Complex patterns in a simple system" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189>,
            <https://github.com/fractastical/morpholib/commit/f3fe478> .
}

sub:pubinfo {
    sub: rdfs:label "Claim: Gray-Scott reaction-diffusion patterns is faithful" ;
        dct:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:Claim ;
        npx:introduces <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> ;
        pk:domain <https://w3id.org/probknow/resource/domain/morphogenesis> .
    <https://w3id.org/probknow/resource/domain/morphogenesis> rdfs:label "morphogenesis" .
}

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> a pk:Claim ;
        rdfs:label "Hoffmann-Donoughe insect wing venation faithfully reproduces Dragonfly Arigomphus villosipes (hindwing) morphology" ;
        dct:description "The simulation script(s) 2018-hoffmann-wing-venation.py implement the cited source model as published and produce forms that match real Dragonfly Arigomphus villosipes (hindwing) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 77.8/100, audit 2026-10-13-morphology-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py; output: hoffmann_wing_recapitulation.png; organism: Dragonfly Arigomphus villosipes (hindwing); checkpoint commit: https://github.com/fractastical/morpholib/commit/f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.1721248115> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-specimen-match> ;
        pk:weightOfEvidence "0.778"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py> a schema:SoftwareSourceCode ;
        rdfs:label "2018-hoffmann-wing-venation.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "f3fe478" .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


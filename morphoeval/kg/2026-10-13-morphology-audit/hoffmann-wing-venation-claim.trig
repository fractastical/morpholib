sub:pubinfo {
    sub: rdfs:label "Claim: Hoffmann-Donoughe insect wing venation is faithful" ;
        dct:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:Claim ;
        npx:introduces <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> ;
        pk:domain <https://w3id.org/probknow/resource/domain/morphogenesis> .

    <https://w3id.org/probknow/resource/domain/morphogenesis> rdfs:label "morphogenesis" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115>,
            <https://github.com/fractastical/morpholib/commit/f3fe478> .
}

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> a pk:Claim ;
        rdfs:label "Hoffmann-Donoughe insect wing venation faithfully reproduces Dragonfly Arigomphus villosipes (hindwing) morphology" ;
        dct:description "The simulation script(s) 2018-hoffmann-wing-venation.py implement the cited source model as published and produce forms that match real Dragonfly Arigomphus villosipes (hindwing) specimens and the source authors' figures." ;
        pk:context "script(s): 2018-hoffmann-wing-venation.py; output: hoffmann_wing_recapitulation.png; organism: Dragonfly Arigomphus villosipes (hindwing); checkpoint commit: f3fe478" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.1721248115> .

    <https://doi.org/10.1073/pnas.1721248115> a pk:Paper ;
        dct:bibliographicCitation "PNAS 115(40):9905-9910 (2018)" ;
        dct:creator "Hoffmann J, Donoughe S, Li K, Salcedo MK, Rycroft CH" ;
        dct:identifier "doi:10.1073/pnas.1721248115",
            "pmid:30224459" ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" ;
        rdfs:seeAlso <https://github.com/hoffmannjordan/insect-wing-venation-patterns> .
}


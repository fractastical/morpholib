@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-repro-package> .
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Reproducibility package: 50/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Deterministic (seed=0) and documented, but scikit-image/Pillow are not in requirements.txt, dependencies are unpinned, and the result was silently wrong under numpy 2.2.6 + Python 3.14 until numpy was upgraded during this audit." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-repro-package-0> ;
        pk:hasVerdict "partially faithful" ;
        pk:weightOfEvidence 5e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-repro-package-0> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L39–L40" ;
        dct:description "extra deps noted in docstring only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L39-L40> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115>,
            <https://github.com/fractastical/morpholib/commit/f3fe478>,
            <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .
}

sub:pubinfo {
    sub: rdfs:label "Hoffmann-Donoughe insect wing venation — Reproducibility package 50/100" ;
        dct:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:LLMClaimAssessment ;
        npx:introduces <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-repro-package> ;
        pk:domain <https://w3id.org/probknow/resource/domain/morphogenesis> .
    <https://w3id.org/probknow/resource/domain/morphogenesis> rdfs:label "morphogenesis" .
}

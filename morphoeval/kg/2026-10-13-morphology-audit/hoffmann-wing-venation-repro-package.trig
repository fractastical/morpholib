sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Reproducibility package: 50/100" ;
        rdfs:comment "Deterministic (seed=0) and documented, but scikit-image/Pillow are not in requirements.txt, dependencies are unpinned, and the result was silently wrong under numpy 2.2.6 + Python 3.14 until numpy was upgraded during this audit. Evidence: 2018-hoffmann-wing-venation.py L39–L40: extra deps noted in docstring only <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L39-L40>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-repro-package> ;
        pk:hasProbability "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-repro-package> rdfs:label "Hoffmann-Donoughe insect wing venation (2018-hoffmann-wing-venation.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Dragonfly Arigomphus villosipes (hindwing)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


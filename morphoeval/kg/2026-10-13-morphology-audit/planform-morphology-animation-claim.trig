sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> a pk:Claim ;
        rdfs:label "PlanformDB planarian morphology animation faithfully reproduces Planaria (Schmidtea mediterranea, Dugesia japonica) morphology" ;
        dct:description "The simulation script(s) 1900-planformDB_parser.py implement the cited source model as published and produce forms that match real Planaria (Schmidtea mediterranea, Dugesia japonica) specimens and the source authors' figures." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py> ;
        pk:context "script(s): 1900-planformDB_parser.py; output: planform_morphology_animation.gif; organism: Planaria (Schmidtea mediterranea, Dugesia japonica); checkpoint commit: f3fe478" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088> .
    <https://doi.org/10.1016/j.bpj.2017.04.011> a pk:Paper ;
        dct:bibliographicCitation "Biophysical Journal 112(10):2231-2243 (2017)" ;
        dct:creator "Durant F, Morokuma J, Fields C, Williams K, Adams DS, Levin M" ;
        dct:identifier "doi:10.1016/j.bpj.2017.04.011" ;
        dct:title "Long-Term, Stochastic Editing of Regenerative Anatomy via Targeting Endogenous Bioelectric Gradients" .
    <https://doi.org/10.1093/bioinformatics/btt088> a pk:Paper ;
        dct:bibliographicCitation "Bioinformatics 29(8):1098-1100 (2013)" ;
        dct:creator "Lobo D, Malone TJ, Levin M" ;
        dct:identifier "doi:10.1093/bioinformatics/btt088" ;
        dct:title "Planform: an application and database of graph-encoded planarian regenerative experiments" .
    <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py> a prov:Entity,
            schema:SoftwareSourceCode ;
        rdfs:label "1900-planformDB_parser.py" ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:isPartOf <https://github.com/fractastical/morpholib> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        schema:author <https://orcid.org/0009-0007-4948-9192> ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "f3fe478" .
    <https://orcid.org/0009-0007-4948-9192> a prov:Agent,
            foaf:Person ;
        foaf:account <https://github.com/fractastical> ;
        foaf:name "Joel Dietz" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://github.com/fractastical/morpholib/commit/f3fe478> .
}


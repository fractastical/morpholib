sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Morphometric validation: 20/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Reference taxa are named per panel but no measured shape quantity (e.g. spire height / aperture width, apical angle) is computed or compared against specimens or Raup's figures." ;

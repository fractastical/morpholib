    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1126/science.147.3663.1294> .
    <https://doi.org/10.1126/science.147.3663.1294> dct:date "1965"^^xsd:gYear ;
        dct:title "Theoretical morphology of the coiled shell" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Model fidelity to source: 85/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Implements the paper's SI 3.3-3.4 model (inhibitory centres, Lloyd/centroidal-Voronoi equilibration, Voronoi secondary veins) on the real primary scaffold. Density is taken from the real wing's distance transform rather than from primary-vein thickness as in the paper; the equilibration stop criterion is a fixed 18 iterations rather than the paper's 0.1%-of-wing-length motion threshold." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-model-fidelity-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L150–L185" ;
        dct:description "model_wing: density-weighted seeding, Lloyd loop, Voronoi boundaries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L150-L185> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L111–L133" ;
        dct:description "segment_wing: real mask, primary scaffold, local cell size" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L111-L133> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


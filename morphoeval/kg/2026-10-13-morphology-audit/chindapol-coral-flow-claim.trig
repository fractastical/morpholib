@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chindapol-coral-flow> a pk:Claim ;
        rdfs:label "Chindapol flow-driven coral growth faithfully reproduces Scleractinian coral Pocillopora verrucosa morphology" ;
        dct:description "The simulation script(s) 2013-chindapol-coral-flow.py implement the cited source model as published and produce forms that match real Scleractinian coral Pocillopora verrucosa specimens and the source authors' figures." ;
        pk:context "script(s): 2013-chindapol-coral-flow.py; output: chindapol_coral_flow_morphospace.png; organism: Scleractinian coral Pocillopora verrucosa; checkpoint commit: f3fe478" ;
        pk:derivedFromPaper <https://doi.org/10.1371/journal.pcbi.1002849> .
    <https://doi.org/10.1371/journal.pcbi.1002849> a pk:Paper ;
        dct:bibliographicCitation "PLoS Computational Biology 9(1):e1002849 (2013)" ;
        dct:creator "Chindapol N, Kaandorp JA, Cronemberger C, Mass T, Genin A" ;
        dct:identifier "doi:10.1371/journal.pcbi.1002849" ;
        dct:title "Modelling Growth and Form of the Scleractinian Coral Pocillopora verrucosa and the Influence of Hydrodynamics" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1371/journal.pcbi.1002849>,
            <https://github.com/fractastical/morpholib/commit/f3fe478> .
}

sub:pubinfo {
    sub: rdfs:label "Claim: Chindapol flow-driven coral growth is faithful" ;
        dct:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:Claim ;
        npx:introduces <https://w3id.org/probknow/resource/claim/morphoeval-chindapol-coral-flow> ;
        pk:domain <https://w3id.org/probknow/resource/domain/morphogenesis> .
    <https://w3id.org/probknow/resource/domain/morphogenesis> rdfs:label "morphogenesis" .
}

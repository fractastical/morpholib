sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Morphological realism / specimen match: 30/100" ;
        rdfs:comment "Planispiral forms are plausible; all high-spired / conical reference taxa are wrong because the spire never develops. Evidence: raup_shell_animation.gif (generated output, not in repo): mid-animation frame: six panels, all planispiral — raup_shell_animation.gif: rendered output of create_raup_animations.py at f3fe478, image/gif, 24248756 B, 3600×2400 px, 161 frames, sha256 aea20e93a9a79a94a4685ba67c78684cf879030e2a3c5ff552cfad44cd43bc51." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-specimen-match> ;
        pk:hasProbability "0.3"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-specimen-match> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites)" ;
        dct:identifier "morphoeval/0.1.0/specimen-match" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1126/science.147.3663.1294> .
    <https://doi.org/10.1126/science.147.3663.1294> dct:date "1965"^^xsd:gYear ;
        dct:title "Theoretical morphology of the coiled shell" .
}


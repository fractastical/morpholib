sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-overall> .
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — MorphoEval overall 37.3/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "The translation parameter T has no visible effect: Turritella (T=0.80), Cerithium (T=1.20) and Conus render as the same flat planispiral disc as Nautilus (T=0.10). Overall 37.3/100 (faithfulness 28.6, reproducibility 57.7); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add a regression check that z-extent/xy-extent increases monotonically with T.",
            "remediation needed: Change zc = T*theta to zc = T*r (with the same (1+offset) scaling) in both scripts.",
            "remediation needed: Compare each named panel to a reference photograph of its taxon." ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-output-raup-shell-animation-gif> ;
        pk:hasVerdict "unfaithful" ;
        pk:weightOfEvidence 3.73e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-output-raup-shell-animation-gif> a prov:Entity,
            schema:ImageObject,
            pk:EvidenceItem ;
        rdfs:label "raup_shell_animation.gif" ;
        dct:description "rendered output of create_raup_animations.py at f3fe478; sha256 pins the exact file that was scored; 3600×2400 px, 161 frames" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py> ;
        schema:contentSize "24248756 B" ;
        schema:encodingFormat "image/gif" ;
        schema:height 2400 ;
        schema:sha256 "aea20e93a9a79a94a4685ba67c78684cf879030e2a3c5ff552cfad44cd43bc51" ;
        schema:width 3600 .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


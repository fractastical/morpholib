sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Morphometric validation: 20/100" ;
        rdfs:comment "No wavelength / spot-spacing measurement against Pearson's phase diagram. Evidence: 1952-turing-morpho.py L31–L75: no measurements <https://github.com/fractastical/morpholib/blob/f3fe478/1952-turing-morpho.py#L31-L75>. Measurements (measure_outputs.py): dominant wavelength (last frame) = 14.2857 grid cells [peak of the radial power spectrum of the axes-box image, scaled to the N=200 grid] — Gray–Scott f=0.055,k=0.062 labyrinth; no specimen or literature wavelength recorded; pattern coverage (last frame) = 0.2477 fraction [fraction of axes box in the high-V (yellow) band]; connected high-V components (last frame) = 1 count [scipy.ndimage.label on the yellow mask]; fraction of pattern pixels changed, first→last frame = 0.252 fraction (reference >0 for an evolving simulation) [XOR of yellow masks of frame 0 and the last frame] — ≈0 means the GIF shows a frozen pattern." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-morphometric-validation> ;
        pk:hasProbability "0.2"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-morphometric-validation> rdfs:label "Gray-Scott reaction-diffusion patterns (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Generic (Turing pattern formation)" ;
        dct:identifier "morphoeval/0.1.0/morphometric-validation" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.261.5118.189> dct:date "1993"^^xsd:gYear ;
        dct:title "Complex patterns in a simple system" .
}


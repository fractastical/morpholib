sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Reproducibility package: 60/100" ;
        rdfs:comment "Deterministic, no external data; extra 50% padding leaves shells at ~1/3 of panel. Evidence: create_raup_animations.py L148–L148: padding = max_range * 0.5 <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py#L148-L148>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-repro-package> ;
        pk:hasProbability "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-repro-package> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites)" ;
        dct:identifier "morphoeval/0.1.0/repro-package" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1126/science.147.3663.1294> .
    <https://doi.org/10.1126/science.147.3663.1294> dct:date "1965"^^xsd:gYear ;
        dct:title "Theoretical morphology of the coiled shell" .
}


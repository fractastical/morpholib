        rdfs:label "PlanformDB planarian morphology animation — Reproducibility package: 35/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Runs deterministically from the DB but depends on an unversioned external file, uses pandas/scipy without pins, and VNC rendering sorts two bilateral cords by Y into one polyline." ;

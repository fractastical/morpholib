        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-repro-package-0> ;
        pk:hasVerdict "unfaithful" ;
        pk:weightOfEvidence 3.5e-01 .


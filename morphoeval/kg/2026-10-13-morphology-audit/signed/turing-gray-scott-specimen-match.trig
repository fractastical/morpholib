sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Morphological realism / specimen match: 50/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "Not tied to a specific organism; neutral baseline (not applicable)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-turing-gray-scott-specimen-match-0> ;
        pk:hasVerdict "not applicable (neutral baseline)",
            "partially faithful" ;
        pk:weightOfEvidence 5e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-turing-gray-scott-output-turing-patterns-gif> a prov:Entity,
            schema:ImageObject,
            pk:EvidenceItem ;
        rdfs:label "turing_patterns.gif" ;
        dcterms:description "rendered output of 1952-turing-morpho.py at f3fe478; sha256 pins the exact file that was scored; 1280×960 px, 500 frames" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1952-turing-morpho.py> ;
        schema:contentSize "14075347 B" ;
        schema:encodingFormat "image/gif" ;
        schema:height 960 ;
        schema:sha256 "0ddf48cbca6cf3df80bf611fded797346cb34d93a3308897ed7d2f2005c20c84" ;
        schema:width 1280 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-turing-gray-scott-specimen-match-0> a pk:EvidenceItem ;
        rdfs:label "turing_patterns.gif (generated output, not in repo)" ;
        dcterms:description "mid frame inspected" ;
        prov:wasDerivedFrom <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-turing-gray-scott-output-turing-patterns-gif> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

sub1:assertion {
    <https://doi.org/10.1073/pnas.1721248115> a pk:Paper ;
        dcterms:bibliographicCitation "PNAS 115(40):9905-9910 (2018)" ;
        dcterms:creator "Hoffmann J, Donoughe S, Li K, Salcedo MK, Rycroft CH" ;
        dcterms:identifier "doi:10.1073/pnas.1721248115",
            "pmid:30224459" ;
        dcterms:title "A simple developmental model recapitulates complex insect wing venation patterns" ;
        rdfs:seeAlso <https://github.com/hoffmannjordan/insect-wing-venation-patterns> .

    <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py> a prov:Entity,
            schema:SoftwareSourceCode ;
        rdfs:label "2018-hoffmann-wing-venation.py" ;
        dcterms:creator orcid:0009-0007-4948-9192 ;
        dcterms:isPartOf <https://github.com/fractastical/morpholib> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192 ;
        schema:author orcid:0009-0007-4948-9192 ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "f3fe478" .

    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> a pk:Claim ;
        rdfs:label "Hoffmann-Donoughe insect wing venation faithfully reproduces Dragonfly Arigomphus villosipes (hindwing) morphology" ;
        dcterms:description "The simulation script(s) 2018-hoffmann-wing-venation.py implement the cited source model as published and produce forms that match real Dragonfly Arigomphus villosipes (hindwing) specimens and the source authors' figures." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py> ;
        pk:context "script(s): 2018-hoffmann-wing-venation.py; output: hoffmann_wing_recapitulation.png; organism: Dragonfly Arigomphus villosipes (hindwing); checkpoint commit: f3fe478" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.1721248115> .

    orcid:0009-0007-4948-9192 a prov:Agent,
            foaf:Person ;
        foaf:account <https://github.com/fractastical> ;
        foaf:name "Joel Dietz" .
}


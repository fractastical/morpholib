sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> a pk:Claim ;
        rdfs:label "Hoffmann-Donoughe insect wing venation faithfully reproduces Dragonfly Arigomphus villosipes (hindwing) morphology" ;
        dcterms:description "The simulation script(s) 2018-hoffmann-wing-venation.py implement the cited source model as published and produce forms that match real Dragonfly Arigomphus villosipes (hindwing) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 77.8/100, audit 2026-10-13-morphology-audit) and the assessments." ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py; output: hoffmann_wing_recapitulation.png; organism: Dragonfly Arigomphus villosipes (hindwing); checkpoint commit: https://github.com/fractastical/morpholib/commit/f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.1721248115> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-overall>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-specimen-match> ;
        pk:weightOfEvidence "0.778"^^xsd:double .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192 ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .

    <https://doi.org/10.1073/pnas.1721248115> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


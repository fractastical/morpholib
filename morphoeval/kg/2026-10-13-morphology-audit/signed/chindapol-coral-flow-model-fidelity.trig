sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chindapol-coral-flow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — Model fidelity to source: 40/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "Honest, documented stand-in, but it does not solve the flow or the nutrient field; the Peclet number is a drift bias, not u*L/D. The physics is reproducible with open-source solvers in 2-D." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity-1> ;
        pk:hasVerdict "partially faithful" ;
        pk:weightOfEvidence 4e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity-0> a pk:EvidenceItem ;
        rdfs:label "2013-chindapol-coral-flow.py L27–L36" ;
        dcterms:description "docstring: NS/COMSOL 'out of scope', DLA-with-drift substitution" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2013-chindapol-coral-flow.py#L27-L36> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-chindapol-coral-flow.py L65–L122" ;
        dcterms:description "simulate_coral: biased random walk, stick on contact" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2013-chindapol-coral-flow.py#L65-L122> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


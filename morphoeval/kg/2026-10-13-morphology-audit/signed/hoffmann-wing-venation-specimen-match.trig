sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Morphological realism / specimen match: 85/100" ;
        rdfs:comment "Output is built on the real specimen outline and real primary veins; panel (b) is recognisably the same wing as panel (a). Evidence: hoffmann_wing_recapitulation.png (generated output, not in repo): panels (a) real vs (b) model — hoffmann_wing_recapitulation.png: rendered output of 2018-hoffmann-wing-venation.py at f3fe478, image/png, 179027 B, 1730×1206 px, sha256 43b99ec8ae8205b3f12cfd0cde6d3ab1935463e222f66a0f5c16ec15d49e1108." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-specimen-match> ;
        pk:hasProbability "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-specimen-match> rdfs:label "Hoffmann-Donoughe insect wing venation (2018-hoffmann-wing-venation.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Dragonfly Arigomphus villosipes (hindwing)" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


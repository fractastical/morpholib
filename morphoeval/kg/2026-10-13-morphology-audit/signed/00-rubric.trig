@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix orcid: <https://orcid.org/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sub1: <https://w3id.org/np/RAjd9dIu9uNVgvT4npxJgWwL6cbp8GCsy3gK86Qkj-iH4/> .
@prefix this: <https://w3id.org/np/RAjd9dIu9uNVgvT4npxJgWwL6cbp8GCsy3gK86Qkj-iH4> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192 .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:pubinfo {
    sub1:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    <https://w3id.org/probknow/resource/domain/morphogenesis> rdfs:label "morphogenesis" .

    this: rdfs:label "MorphoEval rubric v0.1.0" ;
        dcterms:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
        dcterms:creator orcid:0009-0007-4948-9192 ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:Concept ;
        npx:introduces <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:domain <https://w3id.org/probknow/resource/domain/morphogenesis> .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> a skos:Concept,
            pk:Concept ;
        rdfs:label "Code-to-model traceability" ;
        dcterms:description "[reproducibility, weight 8/100] Can each modelling step in the code be traced to a specific equation, section or figure of the source?" ;
        skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

    <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> a skos:Concept,
            pk:Concept ;
        rdfs:label "Model fidelity to source" ;
        dcterms:description "[faithfulness, weight 20/100] Does the code implement the equations / algorithm of the cited source model as published (not a loose analogue), with parameters defined the way the source defines them?" ;
        skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

    <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> a skos:Concept,
            pk:Concept ;
        rdfs:label "Morphometric validation" ;
        dcterms:description "[faithfulness, weight 15/100] Are quantitative morphometrics computed on the output and compared against values measured on real specimens or reported in the literature?" ;
        skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

    <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> a skos:Concept,
            pk:Concept ;
        rdfs:label "Parameter expressivity" ;
        dcterms:description "[faithfulness, weight 10/100] Does each morphospace parameter visibly and monotonically control the feature of form it is supposed to control across its stated range?" ;
        skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

    <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> a skos:Concept,
            pk:Concept ;
        rdfs:label "Reproducibility package" ;
        dcterms:description "[reproducibility, weight 12/100] Pinned dependencies, deterministic seeds, documented invocation, and a known-good environment; environment-induced result corruption counts against this dimension." ;
        skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

    <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> a skos:Concept,
            pk:Concept ;
        rdfs:label "Source and data traceability" ;
        dcterms:description "[reproducibility, weight 10/100] Are the source paper (DOI/PMID), code repository and any input data resolvable identifiers, and is input provenance recorded?" ;
        skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

    <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> a skos:Concept,
            pk:Concept ;
        rdfs:label "Morphological realism / specimen match" ;
        dcterms:description "[faithfulness, weight 25/100] Does the rendered output resemble real specimens of the organism and/or the source authors' own figures, judged side by side? Distinct morphologies must be visually distinct." ;
        skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

    <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
            pk:Concept ;
        rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
        dcterms:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Scores are emitted as pk:LLMClaimAssessment with pk:weightOfEvidence = score/100." ;
        rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
        skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
            <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
            <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
            <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
            <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
            <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
            <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .
}


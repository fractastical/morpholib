sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — Morphometric validation: 55/100" ;
        rdfs:comment "Implements the paper's symmetry magnitude (smmag) and branch alignment after its morphometric method, but no numeric comparison with the paper's Figs 9-12 values is made. Evidence: 2013-chindapol-coral-flow.py L164–L179: morphometrics(): smmag, Rbar <https://github.com/fractastical/morpholib/blob/f3fe478/2013-chindapol-coral-flow.py#L164-L179>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-morphometric-validation> ;
        pk:hasProbability "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow-morphometric-validation> rdfs:label "Chindapol flow-driven coral growth (2013-chindapol-coral-flow.py) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Scleractinian coral Pocillopora verrucosa" ;
        dcterms:identifier "morphoeval/0.1.0/morphometric-validation" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Model fidelity to source: 85/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "Implements the paper's SI 3.3-3.4 model (inhibitory centres, Lloyd/centroidal-Voronoi equilibration, Voronoi secondary veins) on the real primary scaffold. Density is taken from the real wing's distance transform rather than from primary-vein thickness as in the paper; the equilibration stop criterion is a fixed 18 iterations rather than the paper's 0.1%-of-wing-length motion threshold." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-model-fidelity-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-model-fidelity-1> ;
        pk:hasVerdict "faithful" ;
        pk:weightOfEvidence 8.5e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-model-fidelity-0> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L150–L185" ;
        dcterms:description "model_wing: density-weighted seeding, Lloyd loop, Voronoi boundaries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L150-L185> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L111–L133" ;
        dcterms:description "segment_wing: real mask, primary scaffold, local cell size" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L111-L133> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


        rdfs:label "Gray-Scott reaction-diffusion patterns — Reproducibility package: 40/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "RNG is not seeded, so each run produces a different pattern; output filename hard-coded." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;

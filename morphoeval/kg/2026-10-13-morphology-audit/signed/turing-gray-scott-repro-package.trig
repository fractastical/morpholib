sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — Reproducibility package: 40/100" ;
        rdfs:comment "RNG is not seeded, so each run produces a different pattern; output filename hard-coded. Evidence: 1952-turing-morpho.py L19–L20: np.random.random without a seed <https://github.com/fractastical/morpholib/blob/f3fe478/1952-turing-morpho.py#L19-L20>; 1952-turing-morpho.py L75–L75: hard-coded GIF path <https://github.com/fractastical/morpholib/blob/f3fe478/1952-turing-morpho.py#L75-L75>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-repro-package> ;
        pk:hasProbability "0.4"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-repro-package> rdfs:label "Gray-Scott reaction-diffusion patterns (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Generic (Turing pattern formation)" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


sub1:pubinfo {
    sub1:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    this: rdfs:label "PlanformDB planarian morphology animation — Model fidelity to source 10/100" ;
        dcterms:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
        dcterms:creator orcid:0009-0007-4948-9192 ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:LLMClaimAssessment ;
        npx:introduces <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity> ;

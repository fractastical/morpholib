sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity-0> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L570–L586" ;
        dcterms:description "RegionParam and RegionsLink fetched" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L570-L586> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L617–L617" ;
        dcterms:description "stored as 'params', never read by any renderer" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L617-L617> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L304–L327" ;
        dcterms:description "body = scipy ConvexHull of organ positions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L304-L327> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Model fidelity to source: 10/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "PlanformDB encodes a morphology as a region graph (Region + RegionParam shape parameters, joined by RegionsLink Dist/Ratio/Ang). The script queries all of it and never uses it to draw; the body is instead a convex hull of organ landmark points." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-model-fidelity-2> ;
        pk:hasVerdict "not faithful" ;
        pk:weightOfEvidence 1e-01 .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}


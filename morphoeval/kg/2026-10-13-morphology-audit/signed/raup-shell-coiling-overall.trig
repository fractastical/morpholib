sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — MorphoEval overall 37.3/100" ;
        rdfs:comment "The translation parameter T has no visible effect: Turritella (T=0.80), Cerithium (T=1.20) and Conus render as the same flat planispiral disc as Nautilus (T=0.10). Overall 37.3/100 (faithfulness 28.6, reproducibility 57.7); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0. Dimension assessments: Model fidelity to source 35, Morphological realism / specimen match 30, Parameter expressivity 25, Morphometric validation 20, Source and data traceability 65, Code-to-model traceability 45, Reproducibility package 60. Output judged: raup_shell_animation.gif: rendered output of create_raup_animations.py at f3fe478, image/gif, 24248756 B, 3600×2400 px, 161 frames, sha256 aea20e93a9a79a94a4685ba67c78684cf879030e2a3c5ff552cfad44cd43bc51." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling> ;
        pk:evidenceAgainst "remediation needed: Add a regression check that z-extent/xy-extent increases monotonically with T.",
            "remediation needed: Change zc = T*theta to zc = T*r (with the same (1+offset) scaling) in both scripts.",
            "remediation needed: Compare each named panel to a reference photograph of its taxon." ;
        pk:hasProbability "0.373"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling> rdfs:label "Raup shell coiling morphospace faithfully reproduces Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites) morphology" ;
        dcterms:identifier "morphoeval/0.1.0/overall" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


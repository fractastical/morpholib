sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Code-to-model traceability: 45/100" ;
        rdfs:comment "Parameters are named after Raup's but the translation equation departs from the source without comment. Evidence: create_raup_animations.py L21–L58: raup_shell() <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py#L21-L58>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-code-traceability> ;
        pk:hasProbability "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-code-traceability> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites)" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Gray-Scott reaction-diffusion patterns — MorphoEval overall 52.7/100" ;
        rdfs:comment "Standard Gray-Scott output; forms and dynamics are as expected. Overall 52.7/100 (faithfulness 54.3, reproducibility 49.0); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0. Dimension assessments: Model fidelity to source 85, Morphological realism / specimen match 50, Parameter expressivity 55, Morphometric validation 20, Source and data traceability 55, Code-to-model traceability 55, Reproducibility package 40. Output judged: turing_patterns.gif: rendered output of 1952-turing-morpho.py at f3fe478, image/gif, 14075347 B, 1280×960 px, 500 frames, sha256 0ddf48cbca6cf3df80bf611fded797346cb34d93a3308897ed7d2f2005c20c84." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott> ;
        pk:evidenceAgainst "remediation needed: Measure the pattern wavelength and place the run on Pearson's (f, k) phase diagram.",
            "remediation needed: Seed the RNG and expose (f, k) and output path on the CLI." ;
        pk:hasProbability "0.527"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott> rdfs:label "Gray-Scott reaction-diffusion patterns faithfully reproduces Generic (Turing pattern formation) morphology" ;
        dcterms:identifier "morphoeval/0.1.0/overall" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


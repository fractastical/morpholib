sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> a pk:Claim ;
        rdfs:label "Raup shell coiling morphospace faithfully reproduces Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites) morphology" ;
        dcterms:description "The simulation script(s) create_raup_animations.py, 1966-raup.py implement the cited source model as published and produce forms that match real Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 37.3/100, audit 2026-10-13-morphology-audit) and the assessments." ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py, https://github.com/fractastical/morpholib/blob/f3fe478/1966-raup.py; output: raup_shell_animation.gif; organism: Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites); checkpoint commit: https://github.com/fractastical/morpholib/commit/f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0; other sources: Geometric analysis of shell coiling: general problems <https://www.jstor.org/stable/1301992>" ;
        pk:derivedFromPaper <https://doi.org/10.1126/science.147.3663.1294> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-overall>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-specimen-match> ;
        pk:weightOfEvidence "0.373"^^xsd:double .
}


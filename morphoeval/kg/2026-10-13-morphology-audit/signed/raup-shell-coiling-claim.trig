    <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py> a prov:Entity,
            schema:SoftwareSourceCode ;
        rdfs:label "create_raup_animations.py" ;
        dcterms:creator orcid:0009-0007-4948-9192 ;
        dcterms:isPartOf <https://github.com/fractastical/morpholib> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192 ;
        schema:author orcid:0009-0007-4948-9192 ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "f3fe478" .

    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> a pk:Claim ;
        rdfs:label "Raup shell coiling morphospace faithfully reproduces Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites) morphology" ;
        dcterms:description "The simulation script(s) create_raup_animations.py, 1966-raup.py implement the cited source model as published and produce forms that match real Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites) specimens and the source authors' figures." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/f3fe478/1966-raup.py>,
            <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py> ;
        pk:context "script(s): create_raup_animations.py, 1966-raup.py; output: raup_shell_animation.gif; organism: Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites); checkpoint commit: f3fe478" ;
        pk:derivedFromPaper <https://doi.org/10.1126/science.147.3663.1294>,
            <https://www.jstor.org/stable/1301992> .

    <https://www.jstor.org/stable/1301992> a pk:Paper ;
        dcterms:bibliographicCitation "Journal of Paleontology 40(5):1178-1190 (1966)" ;
        dcterms:creator "Raup DM" ;
        dcterms:title "Geometric analysis of shell coiling: general problems" .

    orcid:0009-0007-4948-9192 a prov:Agent,
            foaf:Person ;
        foaf:account <https://github.com/fractastical> ;
        foaf:name "Joel Dietz" .

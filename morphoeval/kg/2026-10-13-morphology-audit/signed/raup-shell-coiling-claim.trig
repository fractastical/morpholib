sub1:assertion {
    <https://doi.org/10.1126/science.147.3663.1294> a pk:Paper ;
        dcterms:bibliographicCitation "Science 147(3663):1294-1295 (1965)" ;
        dcterms:creator "Raup DM, Michelson A" ;
        dcterms:identifier "doi:10.1126/science.147.3663.1294" ;
        dcterms:title "Theoretical morphology of the coiled shell" .

    <https://github.com/fractastical/morpholib/blob/f3fe478/1966-raup.py> a prov:Entity,
            schema:SoftwareSourceCode ;
        rdfs:label "1966-raup.py" ;

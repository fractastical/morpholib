sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Model fidelity to source: 35/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "W (whorl expansion) and D (distance from axis) are implemented, but axial translation is zc = T*theta (linear in angle) while the radius grows as exp(b*theta). Over 6 turns at W=2.5 the radius reaches ~244 and Z only ~30, so T is swamped. In Raup's model translation scales with whorl size (z proportional to T*r)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-2> ;
        pk:hasVerdict "unfaithful" ;
        pk:weightOfEvidence 3.5e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-0> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L41–L41" ;
        dcterms:description "r = np.exp(b * theta)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py#L41-L41> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L46–L46" ;
        dcterms:description "zc = T * theta  (should scale with r)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py#L46-L46> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1966-raup.py L39–L39" ;
        dcterms:description "same formula" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1966-raup.py#L39-L39> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


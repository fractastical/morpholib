        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Morphological realism / specimen match: 30/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "Planispiral forms are plausible; all high-spired / conical reference taxa are wrong because the spire never develops." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-specimen-match-0> ;
        pk:hasVerdict "unfaithful" ;
        pk:weightOfEvidence 3e-01 .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;

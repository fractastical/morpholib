sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> a pk:Claim ;
        rdfs:label "Gray-Scott reaction-diffusion patterns faithfully reproduces Generic (Turing pattern formation) morphology" ;
        dcterms:description "The simulation script(s) 1952-turing-morpho.py implement the cited source model as published and produce forms that match real Generic (Turing pattern formation) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 52.7/100, audit 2026-10-13-morphology-audit) and the assessments." ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/f3fe478/1952-turing-morpho.py; output: turing_patterns.gif; organism: Generic (Turing pattern formation); checkpoint commit: https://github.com/fractastical/morpholib/commit/f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0" ;
        pk:derivedFromPaper <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-overall>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-turing-gray-scott-specimen-match> ;
        pk:weightOfEvidence "0.527"^^xsd:double .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> a pk:Claim ;
        rdfs:label "Gray-Scott reaction-diffusion patterns faithfully reproduces Generic (Turing pattern formation) morphology" ;
        dcterms:description "The simulation script(s) 1952-turing-morpho.py implement the cited source model as published and produce forms that match real Generic (Turing pattern formation) specimens and the source authors' figures." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/f3fe478/1952-turing-morpho.py> ;
        pk:context "script(s): 1952-turing-morpho.py; output: turing_patterns.gif; organism: Generic (Turing pattern formation); checkpoint commit: f3fe478" ;
        pk:derivedFromPaper <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .

    <https://doi.org/10.1098/rstb.1952.0012> a pk:Paper ;
        dcterms:bibliographicCitation "Phil. Trans. R. Soc. Lond. B 237(641):37-72 (1952)" ;
        dcterms:creator "Turing AM" ;
        dcterms:identifier "doi:10.1098/rstb.1952.0012" ;
        dcterms:title "The chemical basis of morphogenesis" .

    <https://doi.org/10.1126/science.261.5118.189> a pk:Paper ;
        dcterms:bibliographicCitation "Science 261(5118):189-192 (1993)" ;
        dcterms:creator "Pearson JE" ;
        dcterms:identifier "doi:10.1126/science.261.5118.189" ;
        dcterms:title "Complex patterns in a simple system" .

    <https://github.com/fractastical/morpholib/blob/f3fe478/1952-turing-morpho.py> a prov:Entity,
            schema:SoftwareSourceCode ;
        rdfs:label "1952-turing-morpho.py" ;
        dcterms:creator orcid:0009-0007-4948-9192 ;
        dcterms:isPartOf <https://github.com/fractastical/morpholib> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192 ;
        schema:author orcid:0009-0007-4948-9192 ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "f3fe478" .

    orcid:0009-0007-4948-9192 a prov:Agent,
            foaf:Person ;
        foaf:account <https://github.com/fractastical> ;
        foaf:name "Joel Dietz" .
}


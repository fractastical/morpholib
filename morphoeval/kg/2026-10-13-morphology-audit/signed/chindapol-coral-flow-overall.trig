sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Chindapol flow-driven coral growth — MorphoEval overall 55.5/100" ;
        rdfs:comment "Declared reduction: the paper's 3-D Navier-Stokes + advection-diffusion accretive growth (solved in COMSOL) is replaced by 2-D DLA-with-drift, with drift bias standing in for the Peclet number. Qualitative symmetric-to-upstream transition and compactification are recovered. Overall 55.5/100 (faithfulness 49.3, reproducibility 70.0); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0. Dimension assessments: Model fidelity to source 40, Morphological realism / specimen match 45, Parameter expressivity 70, Morphometric validation 55, Source and data traceability 80, Code-to-model traceability 65, Reproducibility package 65. Output judged: chindapol_coral_flow_morphospace.png: rendered output of 2013-chindapol-coral-flow.py, not present when the audit was snapshotted (unfingerprinted)." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow> ;
        pk:evidenceAgainst "remediation needed: Compare smmag / alignment curves numerically against the paper's reported values.",
            "remediation needed: Replace DLA-with-drift with a real 2-D flow + advection-diffusion + accretive-growth solver." ;
        pk:hasProbability "0.555"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-chindapol-coral-flow> rdfs:label "Chindapol flow-driven coral growth faithfully reproduces Scleractinian coral Pocillopora verrucosa morphology" ;
        dcterms:identifier "morphoeval/0.1.0/overall" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


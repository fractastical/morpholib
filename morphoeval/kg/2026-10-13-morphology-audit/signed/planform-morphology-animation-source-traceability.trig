sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://github.com/fractastical/morpholib/commit/f3fe478>,
            <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Source and data traceability: 55/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "Input database is a resolvable Planform artefact and the schema is followed, but the script cites no DOI for Planform and requires an external PLANFORM_DB_PATH with no recorded version/hash." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-source-traceability-0> ;
        pk:hasVerdict "partially faithful" ;
        pk:weightOfEvidence 5.5e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-source-traceability-0> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L15–L16" ;
        dcterms:description "DB path from env var; no provenance recorded" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L15-L16> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:pubinfo {

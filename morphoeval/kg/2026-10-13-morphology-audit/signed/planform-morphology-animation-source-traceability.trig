        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    <https://w3id.org/probknow/resource/domain/levin-lab> rdfs:label "levin-lab" .

    this: rdfs:label "PlanformDB planarian morphology animation — Source and data traceability 55/100" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "silhouette width/height (bbox, mean over frames): 1.9923 ratio" ;
        dcterms:description "min 1.972, max 2.014; rendered body is wider than long" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-output-planform-morphology-animation-gif> ;
        schema:measurementTechnique "largest non-white connected component in the central panel of each GIF frame; bbox W/H" ;
        schema:name "silhouette width/height (bbox, mean over frames)" ;
        schema:unitText "ratio" ;
        schema:value 1.9923e+00 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m0-reference> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m0-reference> a schema:PropertyValue ;
        dcterms:source "qualitative; Lobo et al. 2013 Planform renderings show elongated AP bodies" ;
        schema:name "reference for: silhouette width/height (bbox, mean over frames)" ;
        schema:value "≈0.15–0.3 (adult S. mediterranea is ~3–7× longer than wide, long axis = AP)" .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "silhouette IoU between frames (mean): 0.9908 ratio" ;
        dcterms:description "min 0.979; frames differ mainly by added translucent flaps, not by body form" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-output-planform-morphology-animation-gif> ;
        schema:measurementTechnique "pairwise intersection-over-union of the per-frame silhouettes on the fixed canvas" ;
        schema:name "silhouette IoU between frames (mean)" ;
        schema:unitText "ratio" ;
        schema:value 9.908e-01 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m1-reference> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m1-reference> a schema:PropertyValue ;
        schema:name "reference for: silhouette IoU between frames (mean)" ;
        schema:value "distinct morphologies should give low IoU; one body plan over time should be near 1" .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "frames with a silhouette: 34 count" ;
        dcterms:description "of 34" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-output-planform-morphology-animation-gif> ;
        schema:measurementTechnique "frames where a component was found" ;
        schema:name "frames with a silhouette" ;
        schema:unitText "count" ;
        schema:value 34 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-validation-0> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L768–L887" ;
        dcterms:description "create_morphology_animation: no measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L768-L887> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Morphometric validation: 0/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "No morphometrics are computed or compared." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-m2>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-morphometric-validation-0> ;
        pk:hasVerdict "not faithful" ;
        pk:weightOfEvidence 0e+00 .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Morphological realism / specimen match: 5/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "No frame is recognisable as a planarian; the lateral 'flaps' are the eye/brain vertices of the organ hull. Reference: Planform's own rendering of each Morphology.Id and wild-type S. mediterranea." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-specimen-match-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-specimen-match-1> ;
        pk:hasVerdict "not faithful" ;
        pk:weightOfEvidence 5e-02 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-output-planform-morphology-animation-gif> a prov:Entity,
            schema:ImageObject,
            pk:EvidenceItem ;
        rdfs:label "planform_morphology_animation.gif" ;
        dcterms:description "rendered output of 1900-planformDB_parser.py at f3fe478; sha256 pins the exact file that was scored; 3200×2000 px, 34 frames" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py> ;
        schema:contentSize "802794 B" ;
        schema:encodingFormat "image/gif" ;
        schema:height 2000 ;
        schema:sha256 "27256acdd26eee57a0977a0cd28544b4da65061f11e6f8a50af28d6caf9efe94" ;
        schema:width 3200 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-specimen-match-0> a pk:EvidenceItem ;
        rdfs:label "planform_morphology_animation.gif (generated output, not in repo)" ;
        dcterms:description "frames 0, 17, 33 inspected" ;
        prov:wasDerivedFrom <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-output-planform-morphology-animation-gif> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L670–L687" ;
        dcterms:description "wild-type base is also a convex hull" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L670-L687> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Raup shell coiling morphospace — Source and data traceability: 65/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "Raup 1966 is the acknowledged source and datasets/raup/variables.json names the empirical targets, but the script carries no DOI/JSTOR identifier." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-source-traceability-0> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 6.5e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-source-traceability-0> a pk:EvidenceItem ;
        rdfs:label "create_raup_animations.py L21–L35" ;
        dcterms:description "docstring names Raup parameters without a citation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py#L21-L35> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


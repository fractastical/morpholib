sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — MorphoEval overall 77.8/100" ;
        rdfs:comment "Follows the authors' own procedure on their own example wing: real silhouette and primary-vein scaffold, secondary veins regenerated by Lloyd equilibration + Voronoi at the real local density. 923 real vein domains reproduced; circularity real 0.712 vs model 0.867 (hexagon ceiling 0.907). Overall 77.8/100 (faithfulness 81.1, reproducibility 70.0); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0. Dimension assessments: Model fidelity to source 85, Morphological realism / specimen match 85, Parameter expressivity 65, Morphometric validation 80, Source and data traceability 90, Code-to-model traceability 75, Reproducibility package 50. Output judged: hoffmann_wing_recapitulation.png: rendered output of 2018-hoffmann-wing-venation.py at f3fe478, image/png, 179027 B, 1730×1206 px, sha256 43b99ec8ae8205b3f12cfd0cde6d3ab1935463e222f66a0f5c16ec15d49e1108." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation> ;
        pk:evidenceAgainst "remediation needed: Add a circularity-vs-iteration sweep panel to show the equilibration transition.",
            "remediation needed: Add scikit-image and Pillow to requirements.txt and pin numpy >= 2.5 for Python 3.14.",
            "remediation needed: Optionally switch the Lloyd stop rule to the paper's 0.1%-of-wing-length threshold." ;
        pk:hasProbability "0.778"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation> rdfs:label "Hoffmann-Donoughe insect wing venation faithfully reproduces Dragonfly Arigomphus villosipes (hindwing) morphology" ;
        dcterms:identifier "morphoeval/0.1.0/overall" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


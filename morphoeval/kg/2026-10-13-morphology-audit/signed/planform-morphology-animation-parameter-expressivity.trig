        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L846-L859> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L300–L314" ;
        dcterms:description "per-shape bounding-box normalisation; range divided twice (L300, L313-314)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L300-L314> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Parameter expressivity: 5/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "All ~360 morphologies are normalised into the same unit box and drawn at the same centre and scale, erasing the size/proportion differences that distinguish them." ;

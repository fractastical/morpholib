sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-parameter-expressivity-0> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L846–L859" ;

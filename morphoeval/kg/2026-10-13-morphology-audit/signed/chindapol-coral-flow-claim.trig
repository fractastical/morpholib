    <https://w3id.org/probknow/resource/claim/morphoeval-chindapol-coral-flow> a pk:Claim ;
        rdfs:label "Chindapol flow-driven coral growth faithfully reproduces Scleractinian coral Pocillopora verrucosa morphology" ;
        dcterms:description "The simulation script(s) 2013-chindapol-coral-flow.py implement the cited source model as published and produce forms that match real Scleractinian coral Pocillopora verrucosa specimens and the source authors' figures." ;

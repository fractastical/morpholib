        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:LLMClaimAssessment ;
        npx:introduces <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-overall> ;
        pk:domain <https://w3id.org/probknow/resource/domain/levin-lab> .

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-overall> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-overall> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — MorphoEval overall 14.7/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "Never resembles a planarian. Every frame is the same rounded blob with two lateral flaps, changing only colour; double-head, headless and wild-type morphologies are visually indistinguishable. Overall 14.7/100 (faithfulness 5.4, reproducibility 36.3); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add a --compare mode rendering a Morphology.Id beside Planform's reference drawing.",
            "remediation needed: Lay morphologies out as small multiples instead of superimposing at the origin.",
            "remediation needed: Render from the region graph (Region + RegionParam + RegionsLink), not an organ hull.",
            "remediation needed: Use one shared scale (wild-type trunk = 1) and fix the double division." ;
        pk:hasVerdict "not faithful" ;
        pk:weightOfEvidence 1.47e-01 .
}


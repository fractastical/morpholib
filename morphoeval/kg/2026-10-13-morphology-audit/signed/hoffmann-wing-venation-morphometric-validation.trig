sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115>,
            <https://github.com/fractastical/morpholib/commit/f3fe478>,
            <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Morphometric validation: 80/100" ;
        dcterms:date "2026-10-13"^^xsd:date ;
        dcterms:description "Circularity (Crofton perimeter), normalised area and proximal-distal circularity are computed for real and model domains and compared against the regular-hexagon ceiling, matching the paper's analysis." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m2>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation-1> ;
        pk:hasVerdict "faithful" ;
        pk:weightOfEvidence 8e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mean domain circularity, model wing: 0.867 ratio (4πA/P²)" ;
        dcterms:description "regular hexagon = 0.907; model n=923, real n=923" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py> ;
        schema:measurementTechnique "script's domain_stats() over Voronoi domains after Lloyd equilibration (seed 0)" ;
        schema:name "mean domain circularity, model wing" ;
        schema:unitText "ratio (4πA/P²)" ;
        schema:value 8.67e-01 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m0-reference> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m0-reference> a schema:PropertyValue ;
        dcterms:source "same statistic on the authors' segmented real wing (Hoffmann et al. 2018 example)" ;
        schema:name "reference for: mean domain circularity, model wing" ;
        schema:value 7.12e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vein-domain count, model wing: 923 count" ;
        dcterms:description "equal by construction: the model is seeded with the real wing's domain count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py> ;
        schema:measurementTechnique "domains large enough to measure, model" ;
        schema:name "vein-domain count, model wing" ;
        schema:unitText "count" ;
        schema:value 923 ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m1-reference> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m1-reference> a schema:PropertyValue ;
        dcterms:source "same count on the real wing" ;
        schema:name "reference for: vein-domain count, model wing" ;
        schema:value 923 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-m2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vein-domain count, real wing (all): 923 count" ;
        dcterms:description "wing area 1905316 px" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py> ;
        schema:measurementTechnique "peaks of the distance transform inside the segmented real wing" ;
        schema:name "vein-domain count, real wing (all)" ;
        schema:unitText "count" ;
        schema:value 923 .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation-0> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L188–L201" ;
        dcterms:description "domain_stats: 4*pi*A/P^2 with perimeter_crofton" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L188-L201> .

    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L69–L69" ;
        dcterms:description "HEXAGON_CIRC = pi*sqrt(3)/6" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L69-L69> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


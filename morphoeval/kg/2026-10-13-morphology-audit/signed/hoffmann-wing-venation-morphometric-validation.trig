}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Morphometric validation: 80/100" ;
        rdfs:comment "Circularity (Crofton perimeter), normalised area and proximal-distal circularity are computed for real and model domains and compared against the regular-hexagon ceiling, matching the paper's analysis. Evidence: 2018-hoffmann-wing-venation.py L188–L201: domain_stats: 4*pi*A/P^2 with perimeter_crofton <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L188-L201>; 2018-hoffmann-wing-venation.py L69–L69: HEXAGON_CIRC = pi*sqrt(3)/6 <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L69-L69>. Measurements (measure_outputs.py): mean domain circularity, model wing = 0.867 ratio (4πA/P²) (reference 0.712, same statistic on the authors' segmented real wing (Hoffmann et al. 2018 example)) [script's domain_stats() over Voronoi domains after Lloyd equilibration (seed 0)] — regular hexagon = 0.907; model n=923, real n=923; vein-domain count, model wing = 923 count (reference 923, same count on the real wing) [domains large enough to measure, model] — equal by construction: the model is seeded with the real wing's domain count; vein-domain count, real wing (all) = 923 count [peaks of the distance transform inside the segmented real wing] — wing area 1905316 px." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-morphometric-validation> ;
        pk:hasProbability "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-hoffmann-wing-venation-morphometric-validation> rdfs:label "Hoffmann-Donoughe insect wing venation (2018-hoffmann-wing-venation.py) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Dragonfly Arigomphus villosipes (hindwing)" ;
        dcterms:identifier "morphoeval/0.1.0/morphometric-validation" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


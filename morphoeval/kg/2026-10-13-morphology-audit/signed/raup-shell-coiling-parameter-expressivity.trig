        pk:hasProbability "0.25"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-raup-shell-coiling-parameter-expressivity> rdfs:label "Raup shell coiling morphospace (create_raup_animations.py, 1966-raup.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites)" ;

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> a skos:Concept,
        pk:Concept ;
    rdfs:label "Code-to-model traceability" ;
    dct:description "[reproducibility, weight 8/100] Can each modelling step in the code be traced to a specific equation, section or figure of the source?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> a skos:Concept,
        pk:Concept ;
    rdfs:label "Model fidelity to source" ;
    dct:description "[faithfulness, weight 20/100] Does the code implement the equations / algorithm of the cited source model as published (not a loose analogue), with parameters defined the way the source defines them?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> a skos:Concept,
        pk:Concept ;
    rdfs:label "Morphometric validation" ;
    dct:description "[faithfulness, weight 15/100] Are quantitative morphometrics computed on the output and compared against values measured on real specimens or reported in the literature?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> a skos:Concept,
        pk:Concept ;
    rdfs:label "Parameter expressivity" ;
    dct:description "[faithfulness, weight 10/100] Does each morphospace parameter visibly and monotonically control the feature of form it is supposed to control across its stated range?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> a skos:Concept,
        pk:Concept ;
    rdfs:label "Reproducibility package" ;
    dct:description "[reproducibility, weight 12/100] Pinned dependencies, deterministic seeds, documented invocation, and a known-good environment; environment-induced result corruption counts against this dimension." ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> a skos:Concept,
        pk:Concept ;
    rdfs:label "Source and data traceability" ;
    dct:description "[reproducibility, weight 10/100] Are the source paper (DOI/PMID), code repository and any input data resolvable identifiers, and is input provenance recorded?" ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .

<https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> a skos:Concept,
        pk:Concept ;
    rdfs:label "Morphological realism / specimen match" ;
    dct:description "[faithfulness, weight 25/100] Does the rendered output resemble real specimens of the organism and/or the source authors' own figures, judged side by side? Distinct morphologies must be visually distinct." ;
    skos:broader <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .


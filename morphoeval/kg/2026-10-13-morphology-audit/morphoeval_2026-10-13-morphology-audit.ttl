<https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Chindapol flow-driven coral growth — Model fidelity to source: 40/100" ;
    dct:date "2026-10-13"^^xsd:date ;
    dct:description "Honest, documented stand-in, but it does not solve the flow or the nutrient field; the Peclet number is a drift bias, not u*L/D. The physics is reproducible with open-source solvers in 2-D." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity-0>,
        <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-chindapol-coral-flow-model-fidelity-1> ;
    pk:hasVerdict "partially faithful" ;
    pk:weightOfEvidence 4e-01 .

<https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-chindapol-coral-flow-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Chindapol flow-driven coral growth — Morphometric validation: 55/100" ;
    dct:date "2026-10-13"^^xsd:date ;

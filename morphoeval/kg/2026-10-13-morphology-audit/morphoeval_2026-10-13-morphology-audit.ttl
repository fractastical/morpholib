<https://w3id.org/probknow/resource/assessment/morphoeval-chindapol-coral-flow-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Chindapol flow-driven coral growth — Model fidelity to source: 40/100" ;
    dct:date "2026-10-13"^^xsd:date ;
    dct:description "Honest, documented stand-in, but it does not solve the flow or the nutrient field; the Peclet number is a drift bias, not u*L/D. The physics is reproducible with open-source solvers in 2-D." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chindapol-coral-flow-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-chindapol-coral-flow-model-fidelity-2> ;
    pk:hasScore 4e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-chindapol-coral-flow-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Chindapol flow-driven coral growth — Morphometric validation: 55/100" ;
    dct:date "2026-10-13"^^xsd:date ;
    dct:description "Implements the paper's symmetry magnitude (smmag) and branch alignment after its morphometric method, but no numeric comparison with the paper's Figs 9-12 values is made." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chindapol-coral-flow-morphometric-validation-1> ;
    pk:hasScore 5.5e-01 ;
    pk:hasVerdict "partially faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-chindapol-coral-flow-overall> a pk:LLMClaimAssessment ;
    rdfs:label "Chindapol flow-driven coral growth — MorphoEval overall 55.5/100" ;
    dct:date "2026-10-13"^^xsd:date ;
    dct:description "Declared reduction: the paper's 3-D Navier-Stokes + advection-diffusion accretive growth (solved in COMSOL) is replaced by 2-D DLA-with-drift, with drift bias standing in for the Peclet number. Qualitative symmetric-to-upstream transition and compactification are recovered. Overall 55.5/100 (faithfulness 49.3, reproducibility 70.0); rubric morphoeval 0.1.0; checkpoint commit f3fe478; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, scikit-image 0.26.0. Dimension assessments: Model fidelity to source 40, Morphological realism / specimen match 45, Parameter expressivity 70, Morphometric validation 55, Source and data traceability 80, Code-to-model traceability 65, Reproducibility package 65. Output judged: chindapol_coral_flow_morphospace.png: rendered output of 2013-chindapol-coral-flow.py, not present when the audit was snapshotted (unfingerprinted)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/overall" ;
    pk:evidenceAgainst "remediation needed: Compare smmag / alignment curves numerically against the paper's reported values.",
        "remediation needed: Replace DLA-with-drift with a real 2-D flow + advection-diffusion + accretive-growth solver." ;
    pk:hasScore 5.55e-01 ;
    pk:hasVerdict "partially faithful" .


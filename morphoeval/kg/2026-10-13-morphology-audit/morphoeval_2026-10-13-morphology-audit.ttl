<https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Raup shell coiling morphospace — Model fidelity to source: 35/100" ;
    dct:date "2026-10-13"^^xsd:date ;
    dct:description "W (whorl expansion) and D (distance from axis) are implemented, but axial translation is zc = T*theta (linear in angle) while the radius grows as exp(b*theta). Over 6 turns at W=2.5 the radius reaches ~244 and Z only ~30, so T is swamped. In Raup's model translation scales with whorl size (z proportional to T*r)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-0>,
        <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-raup-shell-coiling-model-fidelity-2> ;
    pk:hasVerdict "unfaithful" ;
    pk:weightOfEvidence 3.5e-01 .


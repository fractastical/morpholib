sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hoffmann-wing-venation-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Morphometric validation: 80/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Circularity (Crofton perimeter), normalised area and proximal-distal circularity are computed for real and model domains and compared against the regular-hexagon ceiling, matching the paper's analysis." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-mean-domain-circularity-model-wing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-vein-domain-count-model-wing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-vein-domain-count-real-wing-all>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-morphometric-validation-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-mean-domain-circularity-model-wing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mean domain circularity, model wing = 0.867 ratio (4πA/P²)" ;
        dct:description "regular hexagon = 0.907; model n=923, real n=923" ;
        schema:measurementTechnique "script's domain_stats() over Voronoi domains after Lloyd equilibration (seed 0)" ;
        schema:name "mean domain circularity, model wing" ;
        schema:unitText "ratio (4πA/P²)" ;
        schema:value "0.867" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-mean-domain-circularity-model-wing-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-mean-domain-circularity-model-wing-reference> a schema:PropertyValue ;
        dct:source "same statistic on the authors' segmented real wing (Hoffmann et al. 2018 example)" ;
        schema:value "0.712" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-vein-domain-count-model-wing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vein-domain count, model wing = 923 count" ;
        dct:description "equal by construction: the model is seeded with the real wing's domain count" ;
        schema:measurementTechnique "domains large enough to measure, model" ;
        schema:name "vein-domain count, model wing" ;
        schema:unitText "count" ;
        schema:value "923" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-vein-domain-count-model-wing-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-vein-domain-count-model-wing-reference> a schema:PropertyValue ;
        dct:source "same count on the real wing" ;
        schema:value "923" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-measurement-vein-domain-count-real-wing-all> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vein-domain count, real wing (all) = 923 count" ;
        dct:description "wing area 1905316 px" ;
        schema:measurementTechnique "peaks of the distance transform inside the segmented real wing" ;
        schema:name "vein-domain count, real wing (all)" ;
        schema:unitText "count" ;
        schema:value "923" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L188–L201" ;
        dct:description "domain_stats: 4*pi*A/P^2 with perimeter_crofton" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L188-L201> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hoffmann-wing-venation-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2018-hoffmann-wing-venation.py L69–L69" ;
        dct:description "HEXAGON_CIRC = pi*sqrt(3)/6" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py#L69-L69> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
}


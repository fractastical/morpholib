@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-planform-morphology-animation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "PlanformDB planarian morphology animation — Code-to-model traceability: 15/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "No modelling step is tied to the Planform paper; name-based fallback shapes are hard-coded polygons with no biological basis, and a dead code path references an undefined variable." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-code-traceability-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-code-traceability-1> ;
        pk:hasVerdict "not faithful" ;
        pk:weightOfEvidence 1.5e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-code-traceability-0> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L428–L494" ;
        dct:description "hard-coded rectangle-with-bumps fallbacks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L428-L494> .
    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-planform-morphology-animation-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1900-planformDB_parser.py L498–L498" ;
        dct:description "undefined 'shape_data' swallowed by bare except" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/f3fe478/1900-planformDB_parser.py#L498-L498> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.bpj.2017.04.011>,
            <https://doi.org/10.1093/bioinformatics/btt088>,
            <https://github.com/fractastical/morpholib/commit/f3fe478>,
            <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .
}

sub:pubinfo {
    sub: rdfs:label "PlanformDB planarian morphology animation — Code-to-model traceability 15/100" ;
        dct:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:LLMClaimAssessment ;
        npx:introduces <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-planform-morphology-animation-code-traceability> ;
        pk:domain <https://w3id.org/probknow/resource/domain/levin-lab> .
    <https://w3id.org/probknow/resource/domain/levin-lab> rdfs:label "levin-lab" .
}

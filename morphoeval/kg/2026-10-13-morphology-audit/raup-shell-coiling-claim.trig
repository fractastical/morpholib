sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-raup-shell-coiling> a pk:Claim ;
        rdfs:label "Raup shell coiling morphospace faithfully reproduces Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites) morphology" ;
        dct:description "The simulation script(s) create_raup_animations.py, 1966-raup.py implement the cited source model as published and produce forms that match real Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites) specimens and the source authors' figures." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/f3fe478/1966-raup.py>,
            <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py> ;
        pk:context "script(s): create_raup_animations.py, 1966-raup.py; output: raup_shell_animation.gif; organism: Coiled molluscs (Nautilus, Turritella, Cerithium, Conus, Helix; ammonites); checkpoint commit: f3fe478" ;
        pk:derivedFromPaper <https://doi.org/10.1126/science.147.3663.1294>,
            <https://www.jstor.org/stable/1301992> .
    <https://doi.org/10.1126/science.147.3663.1294> a pk:Paper ;
        dct:bibliographicCitation "Science 147(3663):1294-1295 (1965)" ;
        dct:creator "Raup DM, Michelson A" ;
        dct:identifier "doi:10.1126/science.147.3663.1294" ;
        dct:title "Theoretical morphology of the coiled shell" .
    <https://github.com/fractastical/morpholib/blob/f3fe478/1966-raup.py> a prov:Entity,
            schema:SoftwareSourceCode ;
        rdfs:label "1966-raup.py" ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:isPartOf <https://github.com/fractastical/morpholib> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        schema:author <https://orcid.org/0009-0007-4948-9192> ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "f3fe478" .
    <https://github.com/fractastical/morpholib/blob/f3fe478/create_raup_animations.py> a prov:Entity,
            schema:SoftwareSourceCode ;

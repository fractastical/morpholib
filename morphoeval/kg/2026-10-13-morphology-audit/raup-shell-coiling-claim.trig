    <https://www.jstor.org/stable/1301992> a pk:Paper ;
        dct:bibliographicCitation "Journal of Paleontology 40(5):1178-1190 (1966)" ;
        dct:creator "Raup DM" ;
        dct:title "Geometric analysis of shell coiling: general problems" .
    <https://orcid.org/0009-0007-4948-9192> a prov:Agent,
            foaf:Person ;
        foaf:account <https://github.com/fractastical> ;

@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hoffmann-wing-venation> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hoffmann-Donoughe insect wing venation — Morphological realism / specimen match: 85/100" ;
        dct:date "2026-10-13"^^xsd:date ;
        dct:description "Output is built on the real specimen outline and real primary veins; panel (b) is recognisably the same wing as panel (a)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-specimen-match-0> ;
        pk:hasVerdict "faithful" ;
        pk:weightOfEvidence 8.5e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-13-morphology-audit-hoffmann-wing-venation-specimen-match-0> a pk:EvidenceItem ;
        rdfs:label "hoffmann_wing_recapitulation.png (generated output, not in repo)" ;
        dct:description "panels (a) real vs (b) model" ;
        prov:wasGeneratedBy <https://github.com/fractastical/morpholib/blob/f3fe478/2018-hoffmann-wing-venation.py> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115>,
            <https://github.com/fractastical/morpholib/commit/f3fe478>,
            <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> .
}

sub:pubinfo {
    sub: rdfs:label "Hoffmann-Donoughe insect wing venation — Morphological realism / specimen match 85/100" ;
        dct:created "2026-10-13T00:00:00+00:00"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:hasNanopubType pk:LLMClaimAssessment ;
        npx:introduces <https://w3id.org/probknow/resource/assessment/2026-10-13-morphology-audit-hoffmann-wing-venation-specimen-match> ;
        pk:domain <https://w3id.org/probknow/resource/domain/morphogenesis> .
    <https://w3id.org/probknow/resource/domain/morphogenesis> rdfs:label "morphogenesis" .
}

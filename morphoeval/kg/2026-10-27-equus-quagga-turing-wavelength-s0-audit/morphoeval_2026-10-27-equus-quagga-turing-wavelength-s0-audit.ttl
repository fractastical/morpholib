<https://w3id.org/delphi/resource/math-law/delphi10000-equus-quagga-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Bard growth from week-3 initiation to the s0 detail wavelength" ;
    dct:description "Places this detail window on the post-initiation growth of the plains-zebra stripe mode | Variables: lambda_detail = 1.883 mm at 0 Ma; lambda_init = 0.40 mm (Bard 1977)" ;
    dct:source "Bard 1977 DOI:10.1111/j.1469-7998.1977.tb04204.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py#L66-L67>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3221_equus_quagga_turing_wavelength_s0.lean#L9-L13> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "growth_steps = floor(lambda_detail_um / lambda_init_um) = floor(1883/400) = 4" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90109-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevE.110.034402>,
        <https://doi.org/10.1111/j.1469-7998.1977.tb04204.x> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3221.growth_steps" ;
    pk:leanTheorem "MathOfBiology.Loop_3221.holocene_detail_is_four_initiation_spacings" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-equus-quagga-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing onset numerator for a dorsoventral stripe" ;
    dct:description "Holocene E. quagga selects a finite critical wavenumber at this scale | Variables: scaled D_v=576, f_u=8, D_u=10, g_v=-10" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py#L110-L123>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3221_equus_quagga_turing_wavelength_s0.lean#L16-L19> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 > 0 iff D_v,x * f_u + D_u * g_v > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90109-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevE.110.034402>,
        <https://doi.org/10.1111/j.1469-7998.1977.tb04204.x> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3221.turing_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3221.quagga_onset_numerator_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-equus-quagga-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equus scotti equal-diffusion control" ;
    dct:description "Predecessor chronospecies has no selected 1.883 mm pigment wavelength | Variables: D_v = D_u = 10 with the same Jacobian signs" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py#L645-L647>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3221_equus_quagga_turing_wavelength_s0.lean#L21-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v = D_u implies D_v f_u + D_u g_v < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90109-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevE.110.034402>,
        <https://doi.org/10.1111/j.1469-7998.1977.tb04204.x> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3221.turing_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3221.scotti_equal_diffusion_numerator_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-equus-quagga-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Ten stripes on the detail window" ;
    dct:description "Stripe count conserved from initiation if growth is uniform | Variables: domain and wavelength in micrometres" ;
    dct:source "Bard 1977 DOI:10.1111/j.1469-7998.1977.tb04204.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py#L75-L75>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3221_equus_quagga_turing_wavelength_s0.lean#L26-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = L / lambda_c with L = 10 * 1.883 mm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90109-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1103/PhysRevE.110.034402>,
        <https://doi.org/10.1111/j.1469-7998.1977.tb04204.x> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3221.stripe_count" ;
    pk:leanTheorem "MathOfBiology.Loop_3221.quagga_window_holds_ten_stripes" ;
    pk:leanVerified true .


<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Equus quagga Holocene Turing wavelength at 1.9 mm (detail s0) (Equus quagga)",
        "Equus quagga Holocene Turing wavelength at 1.9 mm (detail s0) faithfully reproduces Equus quagga morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-equus-quagga-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-equus-quagga-turing-wavelength-s0-2>,

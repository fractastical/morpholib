<https://w3id.org/delphi/resource/evidence/2026-10-27-equus-quagga-turing-wavelength-s0-audit-delphi10000-equus-quagga-turing-wavelength-s0-1> a schema:QuantitativeValue,
        pk:EvidenceItem ;
    rdfs:label "Pearson r of analytical vs PDE stripe wavelength across gamma" ;
    dct:description "pearsonr(lambda_c(gamma), FFT wavelength of Schnakenberg u) on a fixed 15-wave window" ;
    rdfs:comment "RMSE 0.0666 mm; p=9.61e-06. Reference 1 is perfect tracking, not the measured r." ;
    schema:about "Equus quagga" ;
    schema:error 2.53e-01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "Pearson r" ;
    schema:value 9.9747e-01 ;
    pk:pValue 9.61e-06 ;
    pk:statisticalTest "RMSE 0.0666 mm; p=9.61e-06. Reference 1 is perfect tracking, not the measured r." .


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Equus quagga Holocene Turing wavelength at 1.9 mm (detail s0) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The PDE, Jacobian, onset numerator, and growth-rate peak are the published Turing/Schnakenberg relations, with gamma on the reaction terms. Kinetics are Schnakenberg rather than a transcription of Murray's own rate laws, and the pattern is above onset so k_fast is longer than onset k_c." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Equus quagga Holocene Turing wavelength at 1.9 mm (detail s0) — Morphometric validation: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Pearson r = 0.997 and RMSE = 0.067 mm on six gamma values. Specimen gradient, period, coherency, and luminance KS are measured on a segmented flank mask and are not copied onto the simulation (angles -2.5 vs 2.5 deg, periods 18.3 vs 32.0 px, KS D = 0.32). The nominal mode is 2.03 mm rather than 1.883 mm." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;

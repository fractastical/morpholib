sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Equus quagga Holocene Turing wavelength at 1.9 mm (detail s0) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.997 and RMSE = 0.067 mm on six gamma values. Specimen gradient, period, coherency, and luminance KS are measured on a segmented flank mask and are not copied onto the simulation (angles -2.5 vs 2.5 deg, periods 18.3 vs 32.0 px, KS D = 0.32). The nominal mode is 2.03 mm rather than 1.883 mm." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-quagga-scotti>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-luminance-ks-statistic-specimen-vs-simulation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-nominal-measured-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-pearson-r-of-analytical-vs-pde-stripe-wavelength-across-gamma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-rmse-of-pde-wavelength-against-analytical-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-flank-gradient-angle>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-flank-stripe-period>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-quagga-scotti> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio (quagga / scotti) = 10000.0 amplitude ratio" ;
        dct:description "predecessor chronospecies has no selected 1.883 mm mode" ;
        schema:measurementTechnique "max(u)-min(u) at d_ratio=18, aniso=3.2 versus d_ratio=1 (Equus scotti control)" ;
        schema:name "equal-diffusion ablation amplitude ratio (quagga / scotti)" ;
        schema:unitText "amplitude ratio" ;
        schema:value "10000.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-quagga-scotti-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-quagga-scotti-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-luminance-ks-statistic-specimen-vs-simulation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "luminance KS statistic specimen vs simulation = 0.3203 KS D" ;
        dct:description "p=0; D=0 would be identical histograms" ;
        schema:measurementTechnique "ks_2samp on flank-mask luminance vs rendered stripe luminance" ;
        schema:name "luminance KS statistic specimen vs simulation" ;
        schema:unitText "KS D" ;
        schema:value "0.3203" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-luminance-ks-statistic-specimen-vs-simulation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-luminance-ks-statistic-specimen-vs-simulation-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-nominal-measured-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nominal measured stripe wavelength = 2.0316 mm" ;
        dct:description "analytical and measured differ by mode quantization on the periodic window" ;
        schema:measurementTechnique "y-averaged FFT of activator at gamma=1.15, scaled by the 1.883 mm pin" ;
        schema:name "nominal measured stripe wavelength" ;
        schema:unitText "mm" ;
        schema:value "2.0316" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-nominal-measured-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-nominal-measured-stripe-wavelength-reference> a schema:PropertyValue ;
        schema:value "1.883" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-pearson-r-of-analytical-vs-pde-stripe-wavelength-across-gamma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r of analytical vs PDE stripe wavelength across gamma = 0.99747 Pearson r" ;
        dct:description "RMSE 0.0666 mm; p=9.61e-06. Reference 1 is perfect tracking, not the measured r." ;
        schema:measurementTechnique "pearsonr(lambda_c(gamma), FFT wavelength of Schnakenberg u) on a fixed 15-wave window" ;
        schema:name "Pearson r of analytical vs PDE stripe wavelength across gamma" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99747" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-pearson-r-of-analytical-vs-pde-stripe-wavelength-across-gamma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-pearson-r-of-analytical-vs-pde-stripe-wavelength-across-gamma-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-rmse-of-pde-wavelength-against-analytical-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RMSE of PDE wavelength against analytical lambda_c = 0.06664 mm" ;
        dct:description "reference 0 would be a perfect match; the residual is the discretization error" ;
        schema:measurementTechnique "sqrt mean square residual of the gamma sweep" ;
        schema:name "RMSE of PDE wavelength against analytical lambda_c" ;
        schema:unitText "mm" ;
        schema:value "0.06664" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-rmse-of-pde-wavelength-against-analytical-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-rmse-of-pde-wavelength-against-analytical-lambda-c-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-flank-gradient-angle> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen flank gradient angle = 2.5 deg" ;
        dct:description "value is the simulation, reference is the specimen; they are not set equal" ;
        schema:measurementTechnique "Sobel orientation histogram on the rendered GIF field, compared with the Namutoni crop mask" ;
        schema:name "specimen flank gradient angle" ;
        schema:unitText "deg" ;
        schema:value "2.5" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-flank-gradient-angle-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-flank-gradient-angle-reference> a schema:PropertyValue ;
        schema:value "-2.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-flank-stripe-period> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen flank stripe period = 32.042 px" ;
        dct:description "adult photograph period in pixels, not the 1.883 mm fetal wavelength" ;
        schema:measurementTechnique "autocorrelation peak of the luminance projection inside the comparison frame" ;
        schema:name "specimen flank stripe period" ;
        schema:unitText "px" ;
        schema:value "32.042" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-flank-stripe-period-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-flank-stripe-period-reference> a schema:PropertyValue ;
        schema:value "18.284" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.7075 coherency" ;
        dct:description "simulation value versus specimen reference" ;
        schema:measurementTechnique "mean structure-tensor coherency of the rendered field" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.7075" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.8873" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py L308–L406" ;
        dct:description "flank segmentation, orientation, KS" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py#L308-L406> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/equus_quagga_turing_wavelength_s0/equus_quagga_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "sweep, KS, angles, ablation amplitudes — datasets/equus_quagga_turing_wavelength_s0/equus_quagga_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 1755 B, artifact_sha256 3ff2d42efc176e2c1dc2d2078f80f920c45fe2347958ff8aef9ccb6d03c4250b (sha256 3ff2d42efc176e2c1dc2d2078f80f920c45fe2347958ff8aef9ccb6d03c4250b), spec_fingerprint c15e608fbebdc00810bdf416a1196b656433143dafaa4373228dabec7a265ec8" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


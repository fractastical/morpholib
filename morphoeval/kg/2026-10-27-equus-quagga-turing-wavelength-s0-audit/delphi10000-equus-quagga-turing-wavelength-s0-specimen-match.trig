sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Equus quagga Holocene Turing wavelength at 1.9 mm (detail s0) — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The GIF and the Namutoni flank crop are both high-contrast, near-vertical dark bands (gradients -2.5 deg and +2.5 deg). Computer-vision similarity of the last frame is 92.1. The simulation stripes break into dashes and omit legs, belly curve, and the sky, so the match is the stripe class, not the animal." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-equus-quagga-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/equus_quagga_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "flank crop beside the saturated field and the scotti control — docs/media/equus_quagga_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-equus-quagga-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 553458 B, 1512×888 px, artifact_sha256 63bb5de23ed6cd3e54c0be79e5812c07a0a9ce980568ce526d68bb970186e97a (sha256 63bb5de23ed6cd3e54c0be79e5812c07a0a9ce980568ce526d68bb970186e97a), spec_fingerprint c15e608fbebdc00810bdf416a1196b656433143dafaa4373228dabec7a265ec8" .

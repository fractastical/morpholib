sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-source-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Source and data traceability: 86/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "`datasets/thompson_1917/t1917-023/` holds the scout manifest (IA SHA-1/SHA-256 digests, leaf-to-page rule, 7 OCR quotes with page numbers), the reference JSON with every vendored file's SHA-256, a 22-entry BibTeX including Harting's 1872 QJMS abstract (doi:10.1242/jcs.s2-12.46.118), Commons licence/author records for both analogues, and now result.json; the script verifies the digests at runtime (L125-136). Harting's original Amsterdam memoir and plates are still not fetched." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L125–L136" ;
        dct:description "runtime SHA-256 verification of all 5 vendored files" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L125-L136> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-023/scout_manifest.json L1–L120" ;
        dct:description "IA item digests, leaf/page mapping, OCR quotes, Commons provenance, match verdict" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/datasets/thompson_1917/t1917-023/scout_manifest.json#L1-L120> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-023/paper_citations.bib L1–L40" ;
        dct:description "Thompson, Harting (memoir + QJMS abstract), Rainey, Liesegang, Jablczynski" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/datasets/thompson_1917/t1917-023/paper_citations.bib#L1-L40> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Cloud Loop Slot 218 Pass 2 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


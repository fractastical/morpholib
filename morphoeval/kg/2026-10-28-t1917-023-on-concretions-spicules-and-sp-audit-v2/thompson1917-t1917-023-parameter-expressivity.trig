sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Parameter expressivity: 86/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Full eta sweep (0, 0.5, 1, 1.5, 2) with solidity falling monotonically (Pearson r = -0.92) and the mass-radius exponent falling from 1.92 to 1.18 (Spearman -1.0); b0 sweep (0.05-0.4) with P falling 1.29 -> 1.13 (Matalon-Packter sign); isotropic vs anisotropic metric; Poisson vs hard-core centres; nucleation gap on/off; 2-D vs 3-D radial geometry; CLI overrides `--etas --b0s --a0 --seed` (L1016-1019). The a0 axis and the seed-shape axis of E3 are not swept." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-parameter-expressivity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L107–L116" ;
        dct:description "PARAMS: 5-point eta sweep, 4-point b0 sweep, hard-core fraction, 3-D a0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L107-L116> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L669–L688" ;
        dct:description "compute_statistics: eta-solidity Pearson r, eta-exponent Spearman, b0-P Spearman" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L669-L688> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L1010–L1019" ;
        dct:description "CLI parameter overrides" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L1010-L1019> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Cloud Loop Slot 218 Pass 2 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


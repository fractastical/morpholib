        dcterms:title "On Growth and Form (1st ed.), Ch. IX On Concretions, Spicules, and Spicular Skeletons, pp. 411-487" .

    <https://doi.org/10.1007/BF02866341> dcterms:date "1984"^^xsd:gYear ;

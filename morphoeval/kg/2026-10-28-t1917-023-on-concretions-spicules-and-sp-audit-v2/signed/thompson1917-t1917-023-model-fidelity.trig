sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Model fidelity to source: 88/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "E1-E5 implemented as in the reference JSON and the Lean module (`radial_growth_laws` L158-170, `simulate_front_rounding` L174-207 with isotropic and chessboard metrics, `simulate_voronoi_impingement` L211-253 with Poisson and hard-core centres, `simulate_liesegang_radial` L257-305 d-dimensional Ostwald supersaturation with nucleation/growth thresholds and a threshold-free control, `simulate_dbm_cluster` L332-384). Remaining gap: the Mullins-Sekerka boundary is represented by the DBM surrogate rather than a sharp-interface diffusion solver, and the E5 model is not calibrated to CaCO3/albumen kinetics." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-4>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-5> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L158–L207" ;
        dcterms:description "E1/E2 growth-law tables; E3 isotropic vs chessboard-metric front rounding (exponents -0.97 vs 0.00)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L158-L207> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L211–L253" ;
        dcterms:description "E4 equal-rate Voronoi with hard-core / Poisson centres and rendered wall image" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L211-L253> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L257–L328" ;
        dcterms:description "E5 radial supersaturation precipitation with nucleation gap, threshold-free control, geometric vs arithmetic spacing fits" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L257-L328> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L332–L384" ;
        dcterms:description "E6 dielectric-breakdown supply sweep and cluster morphometrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L332-L384> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_023.lean L32–L195" ;
        dcterms:description "11 machine-checked theorems for laws 1-5 (Lean 4.35.0, 0 sorry)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/morphoeval/lean/loops/Thompson1917_T1917_023.lean#L32-L195> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Cloud Loop Slot 218 Pass 2 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


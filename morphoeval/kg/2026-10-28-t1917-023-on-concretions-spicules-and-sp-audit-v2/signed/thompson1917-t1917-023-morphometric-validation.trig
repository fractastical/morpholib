sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1007/BF02866341>,
            <https://doi.org/10.1016/j.physa.2007.07.063>,
            <https://doi.org/10.1016/j.sedgeo.2016.02.008>,
            <https://doi.org/10.1063/1.1702607>,
            <https://doi.org/10.1063/1.477609>,
            <https://doi.org/10.1103/PhysRevLett.47.1400>,
            <https://doi.org/10.1103/PhysRevLett.52.1033>,
            <https://doi.org/10.1242/jcs.s2-12.46.118> .

    <https://archive.org/details/ongrowthform1917thom> dcterms:date "1917"^^xsd:gYear ;
        dcterms:title "On Growth and Form (1st ed.), Ch. IX On Concretions, Spicules, and Spicular Skeletons, pp. 411-487" .

    <https://doi.org/10.1007/BF02866341> dcterms:date "1984"^^xsd:gYear ;
        dcterms:title "A new spacing law for Liesegang rings" .

    <https://doi.org/10.1016/j.physa.2007.07.063> dcterms:date "2007"^^xsd:gYear ;
        dcterms:title "On the size distribution of Poisson Voronoi cells" .

    <https://doi.org/10.1016/j.sedgeo.2016.02.008> dcterms:date "2016"^^xsd:gYear ;
        dcterms:title "Growing spherulitic calcite grains in saline, hyperalkaline lakes: experimental evaluation of the effects of Mg-clays and organic acids" .

    <https://doi.org/10.1063/1.1702607> dcterms:date "1963"^^xsd:gYear ;
        dcterms:title "Morphological Stability of a Particle Growing by Diffusion or Heat Flow" .

    <https://doi.org/10.1063/1.477609> dcterms:date "1998"^^xsd:gYear ;
        dcterms:title "Derivation of the Matalon-Packter law for Liesegang patterns" .

    <https://doi.org/10.1103/PhysRevLett.47.1400> dcterms:date "1981"^^xsd:gYear ;
        dcterms:title "Diffusion-Limited Aggregation, a Kinetic Critical Phenomenon" .

    <https://doi.org/10.1103/PhysRevLett.52.1033> dcterms:date "1984"^^xsd:gYear ;
        dcterms:title "Fractal Dimension of Dielectric Breakdown" .

    <https://doi.org/10.1242/jcs.s2-12.46.118> dcterms:date "1872"^^xsd:gYear ;
        dcterms:title "On the Artificial Production of some of the principal Organic Calcareous Formations (English abstract of Recherches de morphologie synthétique, Verh. K. Akad. Wet. Amsterdam 13:1-84)" .
}

sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-morphometric-validation> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Morphometric validation: 87/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "`measure_morphoeval` (L710-769) returns 21 metrics, 19 with reference values, including specimen-derived numbers (Fig. 196 radius CV, radial-line indices, Fig. 197 neighbours vs same-pipeline Voronoi with KS p, Fig. 208 gap CV, Liesegang P with geometric/arithmetic r and RMSE and gap Spearman, ooid asphericity vs E3 prediction) and explicit controls (chessboard exponent, no-gap band count, random-centre null). `evaluate_claim` (L690-707) turns seven of them into pass/fail tests with stated thresholds; `write_result` (L772-820) records the verdict and caveats. The KS between E5 and the specimen ratio distributions fails (p < 0.01) and is reported rather than hidden." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e1-lamella-thickness-cv-interface-controlled-law>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e3-asphericity-decay-exponent-isotropic-deposition-square-nucleus>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e3-control-asphericity-decay-exponent-anisotropic-chessboard-deposition>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e4-mean-neighbour-count-equal-rate-voronoi-mosaic-exact-labels-hard-core-centres>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-control-band-count-without-supersaturation-gap-k-ss-k-sp>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-liesegang-band-count-3-d-spherical-a0-100>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e5-liesegang-spacing-coefficient-p-2-d-a0-50-b0-0-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e6-dla-eta-1-mass-radius-exponent>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-e6-eta-vs-solidity-pearson-r-over-the-supply-sweep>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-fig-195-mean-radial-line-index-around-6-landmarked-nuclei>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-fig-196-nucleus-outer-radius-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-fig-196-outer-boundary-radius-cv-single-calcospherite>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-fig-196-radial-line-index-of-the-striated-border>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-fig-197-cell-area-cv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-fig-197-mean-neighbour-count-of-segmented-cells>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-fig-208-lamella-gap-cv-along-12-rays-spherocrystal>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-liesegang-specimen-geometric-fit-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-liesegang-specimen-jablczynski-p-analogue>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-liesegang-specimen-radial-line-index-concentric-rings>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-ooid-cortex-thickness-cv-analogue>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-measurement-ooid-outer-asphericity-analogue>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-morphometric-validation-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-morphometric-validation-4> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .


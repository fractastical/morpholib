sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-specimen-match> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Morphological realism / specimen match: 84/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Thompson's plates are segmented and overlaid: `measure_fig196` L414-454 (disc from intensity + texture energy, polar radius CV 0.0036, max/min 1.02, striae count 82), `measure_fig195` L457-474 (radial-line index around landmarked nuclei vs 100 random centres), `measure_mosaic` L477-509 applied identically to Fig. 197 and to the rendered Voronoi mosaic (72 vs 39 cells, 6.00 vs 6.10 neighbours), `measure_fig208` L512-545 (12-ray ring detection). Analogues: `measure_liesegang_specimen` L548-578 (10 rings, centre refined by ring contrast) and `measure_ooid` L581-633 (nucleus and outer polar boundaries, 0.5 mm scale bar). Limits: two manual landmarks (L100-105), the ooid outer boundary leaks where neighbouring grains touch and is capped/median-filtered, and the Fig. 195 nuclei could not be auto-detected." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L100–L105: Fig. 195 nucleus centres and Fig. 208 nucleus are manual landmarks <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L100-L105>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L414–L474" ;
        dcterms:description "Fig. 196 disc + border segmentation and Fig. 195 landmark-centred radial-line index with null" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L414-L474> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L477–L545" ;
        dcterms:description "same-pipeline mosaic segmentation (Fig. 197 vs rendered Voronoi) and Fig. 208 ring detection" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L477-L545> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L548–L633" ;
        dcterms:description "Liesegang specimen ring radii and ooid nucleus/outer polar boundaries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L548-L633> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_023_on_concretions_spicules_and_sp_comparison.png (generated output)" ;
        dcterms:description "12-panel figure: 4 plates with overlays, 4 model panels incl. controls and sweeps, 4 analogue/fit panels — docs/media/t1917_023_on_concretions_spicules_and_sp_comparison.png: rendered output of thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py at 5490441cf, image/png, 2054366 B, 2100×1550 px, artifact_sha256 f4073dac2bba015af572262cb22db31688b872f7eacfe942f172c750ff2040a9 (sha256 f4073dac2bba015af572262cb22db31688b872f7eacfe942f172c750ff2040a9), spec_fingerprint 2236a28ef7fc242463615a8a75db9fab22386735752514693b7c41ad182492ef" .


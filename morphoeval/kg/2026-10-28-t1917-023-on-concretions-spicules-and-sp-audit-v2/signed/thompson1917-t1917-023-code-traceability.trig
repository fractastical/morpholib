sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-023> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-code-traceability> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-023-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) T1917-023 — calcospherites grow by radial deposition about a centre (Harting 1872 artificial CaCO3 concretions in egg albumen) — Code-to-model traceability: 86/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Module docstring (L1-70) maps E1-E6 to Thompson page numbers, to the Lean theorems by name, and lists each specimen measurement with the figure it tests; function docstrings cite Zener / Mullins-Sekerka, Keller-Rubinow / Ostwald, Niemeyer et al., Jablczynski / Matalon-Packter; test names in `evaluate_claim` quote the Thompson sentence each one checks; `math_kg_loops/thompson1917-t1917-023.yaml` pins code loci per law." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-code-traceability-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py L1–L70" ;
        dcterms:description "equation-to-page, Lean-theorem and measurement-to-figure traceability in the module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/thompson/claims/t1917-023_on-concretions-spicules-and-spicular-skeletons.py#L1-L70> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-023-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/thompson1917-t1917-023.yaml L1–L145" ;
        dcterms:description "5 laws with lean_locus and code_locus line ranges" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/5490441cf/morphoeval/math_kg_loops/thompson1917-t1917-023.yaml#L1-L145> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Cloud Loop Slot 218 Pass 2 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


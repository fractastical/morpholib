<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-teissieri-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous trace sign" ;
    dct:description "Well-mixed Schnakenberg state is stable, so any instability is diffusion-driven. | Variables: f_u = 3/4, g_v = -676/625 at a=0.13, b=0.91" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py#L59-L72>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3209_drosophila_teissieri_turing_wavelength_s0.lean#L17-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v = 3/4 - 676/625 < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1093/molbev/msg236>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.4310/maa.2001.v8.n3.a3> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3209.traceNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3209.homogeneous_trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-teissieri-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber" ;
    dct:description "Selects the 1.72 µm detail wavelength on the 20.64 µm patch. | Variables: D_v/D_u = 17.4, drive numerator 261*125 - 676*4 > 0" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py#L74-L86>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3209_drosophila_teissieri_turing_wavelength_s0.lean#L27-L33> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 1.72 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1093/molbev/msg236>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.4310/maa.2001.v8.n3.a3> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3209.driveNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3209.diffusion_drive_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-teissieri-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion failure" ;
    dct:description "Negative control. Diffusion-driven stripes require unequal diffusivities. | Variables: r = 1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py#L197-L210>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3209_drosophila_teissieri_turing_wavelength_s0.lean#L35-L37> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "At D_u = D_v the drive equals the trace and is negative" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1093/molbev/msg236>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.4310/maa.2001.v8.n3.a3> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3209.traceNumerator" ;
    pk:leanTheorem "MathOfBiology.Loop_3209.equal_diffusion_drive_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-teissieri-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Twelve-wavelength domain" ;
    dct:description "Periodic patch sized to twelve formula wavelengths. | Variables: 12 * 172 = 2064 hundredths of a micrometre" ;
    dct:source "Turing 1952 mode count N = L / lambda_c" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py#L197-L205>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3209_drosophila_teissieri_turing_wavelength_s0.lean#L39-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L = 12 * 1.72 µm = 20.64 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1093/molbev/msg236>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.4310/maa.2001.v8.n3.a3> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3209.domainHundredths" ;
    pk:leanTheorem "MathOfBiology.Loop_3209.twelve_wavelength_domain" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-teissieri-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Predecessor wavenumber ratio" ;
    dct:description "Detail-scale wavenumber is more than 50 times the takahashii cell-tier stripe wavenumber. Both ages are 0 Ma. | Variables: 9760 > 50 * 172" ;
    dct:source "Atlas slot 2811 versus this slot; not a copied parameter set" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-teissieri-turing-wavelength-s0.py#L38-L40>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3209_drosophila_teissieri_turing_wavelength_s0.lean#L45-L49> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_takahashii / lambda_teissieri = 97.6 / 1.72 > 50" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1093/molbev/msg236>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.4310/maa.2001.v8.n3.a3> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3209.predecessor_wavenumber_ratio_exceeds_fifty" ;
    pk:leanTheorem "MathOfBiology.Loop_3209.predecessor_wavenumber_ratio_exceeds_fifty" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-teissieri-turing-wavelength-s0-6> a skos:Concept,

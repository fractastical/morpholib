sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L927–L988" ;
        dcterms:description "(p0, v0) glass map at D_r = 1: per-column log-interpolated boundary, q_c, linear fit intercept/slope, monotonicity flag" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L927-L988> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L990–L1047" ;
        dcterms:description "D_r sweep at fixed v0 with reuse of the D_r = 1 column; p0c(D_r), D_s(p0 = 3.70) and monotonicity flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L990-L1047> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L2014–L2062" ;
        dcterms:description "CLI: --spv-time, --spv-cells, --spv-seed, --spv-point single-point probe" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L2014-L2062> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary assessor, Pass 3 remediation round)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015), Park et al. (2015) & Bi et al. (2016) zero-temperature shape-index unjamming, asthmatic bronchial epithelial rigidity transition and self-propelled Voronoi motility-driven glass transition — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: two new independent axes (v_0, D_r) added to (p_0, r); the (p_0, v_0) map (6x4 = 24 runs, L927-988) yields a boundary that is monotonically decreasing in v_0 (3.828 -> 3.594) and a fixed-p_0 motility ablation (p_0 = 3.70: T1 rate 0.0008 -> 0.0360 per cell per time from v_0 = 0.15 to 0.45); the D_r sweep (L990-1047) shows p_0^c non-decreasing in D_r and D_s decreasing in D_r at p_0 = 3.70; CLI exposes `--spv-time`, `--spv-cells`, `--spv-seed` and a `--spv-point P0 V0 DR` probe (L2014-2040, L2051-2063). Deductions: the D_r axis is a single v_0 = 0.30 slice with 3 values, and p_0^c(0.25) = 3.677 vs p_0^c(1) = 3.678 is indistinguishable at this resolution, so the \"surface\" is two orthogonal lines rather than a 3D map (-4); grids are coarse (4 v_0, 3 D_r) and the p_0 grid gap 0.05-0.10 sets the boundary interpolation error (-2); the r axis is not swept in the SPV module (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2015-bi-vertex-glass-jamming.py L101–L107: Grid constants: 4 v0 values, 3 D_r values, D_r sweep only at v0 = 0.30 (deduction: two slices, not a surface) <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L101-L107>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-parameter-expressivity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


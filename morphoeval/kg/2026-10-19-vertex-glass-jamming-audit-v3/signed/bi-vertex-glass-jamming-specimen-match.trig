sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/vertex_glass_jamming_comparison.png (generated output)" ;
        dcterms:description "15-panel figure: A5 specimen overlay, B5 k-Gamma match, C1/C2 SPV glassy vs motility-unjammed snapshots at equal p0, C4 (p0, v0) glass map with boundary and Bi 2016 anchor star — docs/media/vertex_glass_jamming_comparison.png: rendered output of 2015-bi-vertex-glass-jamming.py at 7e4f207, image/png, 1732129 B, 3075×1950 px, artifact_sha256 6a5f0e91d8d909aeb16fa43c8d4fdc90f3abcf274beabe497959c412b909893b (sha256 6a5f0e91d8d909aeb16fa43c8d4fdc90f3abcf274beabe497959c412b909893b), spec_fingerprint 52abc2dcaa2857a7c9b54a7d8ac8d7ebb1e0481dc0dc957ca72fa6bc9190d466" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L1485–L1522" ;
        dcterms:description "SPV snapshot renderer: polygons coloured by q, unwrapped net-displacement trails and polarity quiver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L1485-L1522> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015), Park et al. (2015) & Bi et al. (2016) zero-temperature shape-index unjamming, asthmatic bronchial epithelial rigidity transition and self-propelled Voronoi motility-driven glass transition — Morphological realism / specimen match: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: Panel A5 overlays N = 101 segmented polygons on the SHA-256-locked human monolayer micrograph with per-cell jammed/unjammed colouring (L1316-1330); Panel B5 matches the Atia (2018) k-Gamma shape distribution (r = 0.933); the new SPV snapshots C1/C2 (L1485-1522) show, at the same p_0 = 3.70, a caged glassy packing with short displacement trails versus a motility-unjammed fluid with long trails and elongated red cells, and Panel C4 reproduces the qualitative Bi (2016) Fig. 1(a) layout (solid lower-left, boundary meeting the p_0 axis near 3.81-3.85); the GIF's new fourth panel animates SPV polarity vectors. Deductions: the specimen is a human corneal endothelium (dataset JSON source_url), not the bronchial epithelium of the biological claim (-6); no side-by-side with a Bi (2016) figure crop or an HBEC micrograph from Park (2015) (-3); the SPV snapshot trails cross periodic boundaries and the polarity arrows are small at the 150 dpi panel size (-2); A1-A4 remain the phenomenological renders (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/vertex_glass_jamming/vertex_glass_jamming_reference.json L33–L42: Specimen provenance: Wikimedia 'Morphology of human corneal endothelium in situ' — corneal endothelium, not bronchial epithelium (deduction) <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/vertex_glass_jamming/vertex_glass_jamming_reference.json#L33-L42>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .


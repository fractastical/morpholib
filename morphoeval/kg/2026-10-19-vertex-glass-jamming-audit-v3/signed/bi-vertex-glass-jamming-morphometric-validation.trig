sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015), Park et al. (2015) & Bi et al. (2016) zero-temperature shape-index unjamming, asthmatic bronchial epithelial rigidity transition and self-propelled Voronoi motility-driven glass transition — Morphometric validation: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credits: 15 measurements with units and reference values (L1716-1848): the SPV boundary shape index q_c = 3.818 vs Bi (2016) 3.81, the v_0 -> 0 boundary intercept 3.850 vs 3.81, fluidisation slope 0.575 vs the approximate 0.6 +/- 0.3 anchor, T1-rate contrast 45x at fixed p_0 vs a >= 10x expectation, D_r boundary shift +0.071 vs a >= 0 sign expectation, the FIRE-minimised <q>(p_0) r = 0.9966 (RMSE 0.013) vs the Bi (2015) reference curve, and solid-branch <q> = 3.829 vs 3.813, in addition to the 8 Pass 2 metrics; `--self-test` asserts the q_c and p_0^c(0) tolerances (L1961-1970). Deductions: three of the seven new references are expectation/sign-only values written by the script author, not literature numbers (L1762-1775), and the alpha reference is an approximate figure reading (-4); single seed, no confidence intervals on p_0^c or q_c (-3); the intercept 3.850 misses 3.81 by 0.04 with no error bar, and the FIRE solid branch 3.829 overshoots 3.813 (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2015-bi-vertex-glass-jamming.py L1762–L1775: T1-contrast (10x) and D_r-shift (>= 0) references are author expectations, not published values (deduction) <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L1762-L1775>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-critical-unjamming-shape-index-p0-star>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-fluid-asthmatic-mean-shape-index-q>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-p0-phase-sweep-mean-q-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-park-2015-bronchial-maturation-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-jammed-mean-shape-index-q>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-solid-vs-fluid-shear-modulus-g-drop>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-k-gamma-distribution-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-specimen-segmented-mean-shape-index-q>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-boundary-p0c-shift-dr4-minus-dr0p25>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-fire-minimized-q-sweep-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-fire-minimized-solid-branch-mean-q>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-glass-boundary-structural-order-parameter-qc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-motility-fluidization-slope-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-t1-rate-ratio-high-vs-low-motility-at-p0-3p70>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-zero-motility-boundary-intercept-p0c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-morphometric-validation-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-critical-unjamming-shape-index-p0-star> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical_unjamming_shape_index_p0_star = 3.813 dimensionless" ;
        schema:measurementTechnique "Zero-temperature vertex rigidity transition threshold p0* = 3.813 > p_5 = 3.8119 > p_hex = 3.7224 (Bi et al. 2015 Nature Physics)" ;
        schema:name "critical_unjamming_shape_index_p0_star" ;
        schema:unitText "dimensionless" ;
        schema:value "3.813" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-critical-unjamming-shape-index-p0-star-reference> .


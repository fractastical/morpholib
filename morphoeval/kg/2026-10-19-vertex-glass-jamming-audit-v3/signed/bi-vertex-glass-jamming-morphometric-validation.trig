    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-boundary-p0c-shift-dr4-minus-dr0p25> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "spv_boundary_p0c_shift_dr4_minus_dr0p25 = 0.0712 dimensionless" ;
        schema:measurementTechnique "p0c(D_r=4) - p0c(D_r=0.25) at v0=0.30 (D_r=0.25: 3.677, D_r=1: 3.678, D_r=4: 3.748); Bi et al. (2016) PRX Fig. 3: less persistent motion (larger D_r) enlarges the solid region (positive shift); D_s at p0=3.70 decreasing in D_r: True" ;
        schema:name "spv_boundary_p0c_shift_dr4_minus_dr0p25" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0712" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-boundary-p0c-shift-dr4-minus-dr0p25-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-boundary-p0c-shift-dr4-minus-dr0p25-reference> a schema:PropertyValue ;
        schema:value "0.0" .


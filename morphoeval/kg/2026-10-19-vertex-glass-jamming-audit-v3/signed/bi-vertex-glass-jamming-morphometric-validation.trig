            pk:EvidenceItem ;
        rdfs:label "spv_t1_rate_ratio_high_vs_low_motility_at_p0_3p70 = 45.0 ratio" ;
        schema:measurementTechnique "Ratio of per-cell T1 rates at fixed p0=3.70, D_r=1 between v0=0.45 (Gamma_T1=0.0360) and v0=0.15 (Gamma_T1=0.0008): motility alone unjams the tissue at fixed p0 (Bi 2016 Fig. 1); reference = minimum contrast of 10x expected across the boundary" ;
        schema:name "spv_t1_rate_ratio_high_vs_low_motility_at_p0_3p70" ;
        schema:unitText "ratio" ;
        schema:value "45.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-t1-rate-ratio-high-vs-low-motility-at-p0-3p70-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-t1-rate-ratio-high-vs-low-motility-at-p0-3p70-reference> a schema:PropertyValue ;
        schema:value "10.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-measurement-spv-zero-motility-boundary-intercept-p0c> a schema:PropertyValue,

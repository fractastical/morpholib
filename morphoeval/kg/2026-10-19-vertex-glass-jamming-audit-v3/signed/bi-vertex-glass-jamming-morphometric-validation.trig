        rdfs:label "spv_fire_minimized_solid_branch_mean_q = 3.8294 dimensionless" ;
        schema:measurementTechnique "Mean energy-minimised <q> over the solid branch p0 in {3.55, 3.65, 3.722, 3.77} with exact Voronoi forces (Bi et al. 2015 Fig. 2: <q> pinned at p0* = 3.813 by geometric incompatibility)" ;

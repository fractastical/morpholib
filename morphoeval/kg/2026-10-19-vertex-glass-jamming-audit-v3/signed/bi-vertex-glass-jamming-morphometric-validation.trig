            pk:EvidenceItem ;
        rdfs:label "spv_motility_fluidization_slope_alpha = 0.5748 dimensionless (dp0c/dv0)" ;
        schema:measurementTechnique "Slope -dp0c/dv0 of the SPV glass boundary at D_r=1 (monotone decreasing: True); Bi et al. (2016) PRX Fig. 1a: the solid region shrinks with v0 (reference slope read approximately from the figure, uncertainty +/-0.3)" ;
        schema:name "spv_motility_fluidization_slope_alpha" ;
        schema:unitText "dimensionless (dp0c/dv0)" ;
        schema:value "0.5748" ;

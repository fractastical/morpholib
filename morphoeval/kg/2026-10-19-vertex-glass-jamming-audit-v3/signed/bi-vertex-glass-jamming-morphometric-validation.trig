            pk:EvidenceItem ;
        rdfs:label "spv_fire_minimized_q_sweep_pearson_r = 0.9966 r" ;
        schema:measurementTechnique "Pearson r between the FIRE energy-minimised (v0=0, exact SPV forces) <q>(p0) and the Bi et al. (2015) 8-point reference curve (RMSE=0.0131; solid-branch <q>=3.8294 vs pinning 3.813; fluid-branch |<q>-p0| RMSE=0.0008)" ;

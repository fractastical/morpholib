sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015), Park et al. (2015) & Bi et al. (2016) zero-temperature shape-index unjamming, asthmatic bronchial epithelial rigidity transition and self-propelled Voronoi motility-driven glass transition — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credits: the module docstring maps every implemented equation to Bi (2015) Eqs. 1-2, Park (2015) Figs. 1-4, Atia (2018) Figs. 1-2 and Bi (2016) Eqs. 1-3 / Figs. 1, 3, 4, names the Lean theorems, and states plainly which part of the script is phenomenological (L1-62); every SPV function docstring cites the equation or figure it implements and the finite-time estimator it uses (L590-606, L635-650, L731-742, L795-822, L927-937, L990-1000, L1049-1056); the math KG YAML registers the two new theorems with code loci. Deductions: the phase-indexed constants of the regime simulator (0.28, 0.18, 0.88, 0.012, 0.065, L336-352, L403-410) and the Park fit coefficients (L532-536) have no cited source (-5); the 0.02 per-free-path threshold and the 0.2/D_r time-step rule are justified only by prototyping notes in docstrings (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2015-bi-vertex-glass-jamming.py L403–L410: Uncited drift/noise amplitudes in the phenomenological regime integrator (deduction) <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L403-L410>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L1–L62" ;
        dct:description "Module docstring: equation-to-source map for Bi 2015 / Park 2015 / Atia 2018 / Bi 2016, Lean theorem names, explicit phenomenology caveat" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L1-L62> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L795–L822" ;
        dct:description "simulate_spv_active_monolayer docstring: Eqs. 1-3, dt rule, FIRE initial state, D_s/D_eff/Gamma_T1 estimators and thresholds" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L795-L822> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/bi-vertex-glass-jamming.yaml L57–L92" ;
        dct:description "Two new equation entries with lean_decl, lean_theorem, lean_locus and code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/math_kg_loops/bi-vertex-glass-jamming.yaml#L57-L92> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary assessor, Pass 3 remediation round)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


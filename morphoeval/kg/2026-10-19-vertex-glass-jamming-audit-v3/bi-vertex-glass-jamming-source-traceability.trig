sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bi-vertex-glass-jamming> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bi-vertex-glass-jamming-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bi et al. (2015), Park et al. (2015) & Bi et al. (2016) zero-temperature shape-index unjamming, asthmatic bronchial epithelial rigidity transition and self-propelled Voronoi motility-driven glass transition — Source and data traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credits: all six references carry DOIs; the specimen remains SHA-256 pinned and verified fail-closed (L90-94, L119-141); the new `bi_2016_spv_motility_reference.json` records equations, unit conventions, the D_eff definition, the four headline claims, the finite-time estimators and grids, and labels the single figure-derived number as approximate with an uncertainty; the README documents the new file and its caveat; `paper_citations.bib` already carried Bi (2016). Deductions: the new JSON was written offline from memory of the paper (no network in Pass 3), so its DOI and the 0.6 +/- 0.3 slope were not re-verified (-4); neither reference JSON is SHA-256 pinned in `EXPECTED_SHA256` (-2); Bitzek (2006) FIRE is cited in the docstring but not in `paper_citations.bib` (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2015-bi-vertex-glass-jamming.py L90–L94: EXPECTED_SHA256 pins only the JPG; both reference JSONs are unpinned (deduction) <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L90-L94>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-source-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/vertex_glass_jamming/bi_2016_spv_motility_reference.json L1–L46" ;
        dct:description "Bi 2016 SPV reference: model definition, D_eff, headline claims, approximate-flagged slope, finite-time estimators and grids" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/vertex_glass_jamming/bi_2016_spv_motility_reference.json#L1-L46> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2015-bi-vertex-glass-jamming.py L119–L141" ;
        dct:description "Runtime SHA-256 verification of the specimen micrograph against EXPECTED_SHA256 and the JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2015-bi-vertex-glass-jamming.py#L119-L141> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bi-vertex-glass-jamming-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/vertex_glass_jamming/README.md L30–L37" ;
        dct:description "README item 5 documents the new SPV reference file, its offline-provenance caveat and the finite-time estimators" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/vertex_glass_jamming/README.md#L30-L37> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary assessor, Pass 3 remediation round)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


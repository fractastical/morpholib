sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-conserved-mean-order-parameter-phi> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cahn-Hilliard conserved mean order parameter <phi> = -0.3 order parameter" ;
        dcterms:description "exact zero-mode Fourier conservation" ;
        schema:measurementTechnique "spatial mean of phi(x,y,t) after 800 steps vs initial phi0 = -0.30" ;
        schema:name "Cahn-Hilliard conserved mean order parameter <phi>" ;
        schema:unitText "order parameter" ;
        schema:value "-0.3" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-conserved-mean-order-parameter-phi-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-conserved-mean-order-parameter-phi-reference> a schema:PropertyValue ;
        dcterms:source "Cahn & Hilliard (1958) J. Chem. Phys. 28:258 mass conservation law" ;
        schema:value "-0.3" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-primary-droplet-pore-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cahn-Hilliard primary droplet pore count = 29 pores" ;
        dcterms:description "wavelength=19.20 px" ;
        schema:measurementTechnique "connected components of minority LCPA phase (phi < 0) on N=96 grid" ;
        schema:name "Cahn-Hilliard primary droplet pore count" ;
        schema:unitText "pores" ;
        schema:value "29" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-primary-droplet-pore-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-primary-droplet-pore-count-reference> a schema:PropertyValue ;
        dcterms:source "Sumper (2002) Science 295:2430 hexagonal LCPA droplet array" ;
        schema:value "28" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-primary-droplet-wavelength-lambda> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cahn-Hilliard primary droplet wavelength lambda* = 19.2 grid cells" ;
        dcterms:description "k_bin=5, pores=29, std_phi=0.640" ;
        schema:measurementTechnique "integer-binned 2D radial PSD peak on N=96 periodic grid (phi0=-0.30, eps=1.50)" ;
        schema:name "Cahn-Hilliard primary droplet wavelength lambda*" ;
        schema:unitText "grid cells" ;
        schema:value "19.2" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-primary-droplet-wavelength-lambda-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-primary-droplet-wavelength-lambda-reference> a schema:PropertyValue ;
        dcterms:source "Lenoci & Camp (2008) Langmuir 24:217 linear spinodal wavelength" ;
        schema:value "15.6" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation — Morphometric validation: 48/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes integer-binned 2D radial PSD peak `k_bin` and connected-component pore count (L60-82), yielding discrete quantization error (lambda* = 19.2 px at k_bin=5 vs analytical 15.60 px), and omits sub-bin parabolic interpolation, 6-fold hexatic bond-orientational order |psi_6|, and empirical SEM pore diameter/pitch comparison." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2002-sumper-diatom-frustule-phase-sep.py L60–L82: Integer-binned radial PSD peak without sub-bin interpolation or hexatic |psi_6| <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L60-L82>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-conserved-mean-order-parameter-phi>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-primary-droplet-pore-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-measurement-cahn-hilliard-primary-droplet-wavelength-lambda> ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


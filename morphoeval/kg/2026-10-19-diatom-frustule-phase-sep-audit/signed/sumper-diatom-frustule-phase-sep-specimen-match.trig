        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2002-sumper-diatom-frustule-phase-sep.py L85–L110: 2-panel synthetic figure with zero biological specimen segmentation <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L85-L110>",

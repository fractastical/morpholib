sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation — Morphological realism / specimen match: 22/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Renders only a 2-panel synthetic comparison (`diatom_frustule_phase_sep_comparison.png`) without loading, SHA-256-verifying, or segmenting the vendored *Coscinodiscus wailesii* SEM micrograph (`datasets/diatom_frustule_phase_sep/coscinodiscus_diatom_specimen.jpg`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2002-sumper-diatom-frustule-phase-sep.py L85–L110: 2-panel synthetic figure with zero biological specimen segmentation <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L85-L110>",
            "docs/media/diatom_frustule_phase_sep_comparison.png (generated output, not in repo): Pass 1 2-panel synthetic plot lacking Coscinodiscus SEM comparison — docs/media/diatom_frustule_phase_sep_comparison.png: rendered output of 2002-sumper-diatom-frustule-phase-sep.py at HEAD, image/png, 90542 B, 1400×644 px, artifact_sha256 3d96e9137cd584b0d14db9fdf6c4d8faf5fa1f38fe5885068eb362813098d929 (sha256 3d96e9137cd584b0d14db9fdf6c4d8faf5fa1f38fe5885068eb362813098d929), spec_fingerprint cb843885a61dd35079ecc44f25b12a884b513caa2c4f708fa015d81046e64d1c" ;
        pk:hasScore "0.22"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


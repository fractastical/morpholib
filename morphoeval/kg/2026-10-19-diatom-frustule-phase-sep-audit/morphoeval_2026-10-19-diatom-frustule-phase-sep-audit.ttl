        <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-diatom-frustule-phase-sep-audit-sumper-diatom-frustule-phase-sep-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-diatom-frustule-phase-sep-audit-sumper-diatom-frustule-phase-sep-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-diatom-frustule-phase-sep-audit-sumper-diatom-frustule-phase-sep-3> ;
    pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;

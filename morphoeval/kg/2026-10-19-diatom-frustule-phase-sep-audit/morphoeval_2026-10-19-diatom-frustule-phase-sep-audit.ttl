<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-1>,
        <https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-2>,
        <https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-3> .

<https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cahn-Hilliard (1958) / Lenoci & Camp (2008) Double-Well Chemical Potential & Binodal Phase Equilibria" ;
    dct:description "Defines the bistable double-well free energy driving spontaneous demixing of LCPA microdroplets from precipitating biosilica within the diatom SDV | Variables: φ(x,y,t) ∈ [-1, 1]: order parameter (+1 silica wall, -1 LCPA droplet pore); ε: interfacial thickness parameter" ;
    dct:source "Lenoci & Camp (2008) Langmuir 24(1):217-223 Eqs. (1)-(3); Cahn & Hilliard (1958) J. Chem. Phys. 28:258" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L140-L245>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L21-L39> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def cahn_hilliard_bulk_mu (phi : Int) : Int := phi * phi * phi - phi
theorem cahn_hilliard_binodal_equilibria :
    cahn_hilliard_bulk_mu 1 = 0 ∧
    cahn_hilliard_bulk_mu (-1) = 0 ∧
    cahn_hilliard_bulk_mu 0 = 0 := by decide
"""^^pk:lean4 ;
    skos:notation "μ(φ) = φ^3 - φ - ε^2 ∇^2 φ,   μ_bulk(±1) = 0,   μ_bulk(-φ) = -μ_bulk(φ)" ;
    prov:wasDerivedFrom <https://doi.org/10.1021/la7022784>,
        <https://doi.org/10.1063/1.1744102>,
        <https://doi.org/10.1126/science.1070026>,
        <https://doi.org/10.1166/jnn.2006.174> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;
    pk:leanDeclaration "MathOfBiology.Loop_071.cahn_hilliard_bulk_mu" ;
    pk:leanTheorem "MathOfBiology.Loop_071.cahn_hilliard_binodal_equilibria" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fourth-Order Cahn-Hilliard Spinodal Dispersion & Wavelength Selection Law" ;
    dct:description "Selects the characteristic pore spacing λ_c = 2π/k_c inside the spinodal (|φ_0| < 1/√3) while guaranteeing exact mass conservation (σ(0)=0) and stability outside the spinodal | Variables: M: mobility; φ_0: mean composition; α = 1 - 3 φ_0^2: spinodal instability drive; q = k^2: squared wavenumber; k_c: fastest-growing wavenumber" ;
    dct:source "Lenoci & Camp (2008) Langmuir 24(1):217-223 Section 2; Sumper (2002) Science 295:2430" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L140-L310>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L48-L69> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def cahn_hilliard_dispersion (M alpha eps_sq q : Int) : Int :=
  M * q * (alpha - eps_sq * q)
theorem cahn_hilliard_mass_conservation_zero_mode (M alpha eps_sq : Int) :
    cahn_hilliard_dispersion M alpha eps_sq 0 = 0 := by simp [cahn_hilliard_dispersion]
theorem cahn_hilliard_spinodal_band_selection :
    cahn_hilliard_dispersion 1 4 1 2 = 4 ∧
    cahn_hilliard_dispersion 1 4 1 4 = 0 ∧
    cahn_hilliard_dispersion 1 (-2) 1 1 = -3 := by decide
"""^^pk:lean4 ;
    skos:notation "∂_t φ = M ∇^2(φ^3 - φ - ε^2 ∇^2 φ) ⟹ σ(k) = M k^2 (1 - 3 φ_0^2 - ε^2 k^2),  k_c = √((1 - 3 φ_0^2)/(2 ε^2)),  λ_c = 2π / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1021/la7022784>,
        <https://doi.org/10.1063/1.1744102>,
        <https://doi.org/10.1126/science.1070026>,
        <https://doi.org/10.1166/jnn.2006.174> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;
    pk:leanDeclaration "MathOfBiology.Loop_071.cahn_hilliard_dispersion" ;
    pk:leanTheorem "MathOfBiology.Loop_071.cahn_hilliard_spinodal_band_selection" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Sumper (2002) Hierarchical LCPA Droplet Subdivision & Centered Hexagonal Packing Law" ;
    dct:description "Explains the self-similar hierarchical nesting of 7 to 19 secondary cribrum pores inside each primary hexagonal areola and tertiary cribrella sieve pores in Coscinodiscus | Variables: m ∈ {1, 2, 3}: hierarchical tier (foramen, cribrum, cribrella); ρ ≈ 0.18: inter-tier scale ratio; R: hexagonal ring number" ;
    dct:source "Sumper (2002) Science 295(5564):2430-2433 Figs. 1-4; Losic et al. (2006) J. Nanosci. Nanotechnol. 6:982" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L315-L420>,
        <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L78-L96> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def centered_hexagonal_droplets (R : Nat) : Nat := 1 + 3 * R * (R + 1)
theorem sumper_2002_hierarchical_hex_packing (s0 ratio : Nat) :
    sumper_tier_scale s0 ratio 2 = ratio * (ratio * s0) ∧
    centered_hexagonal_droplets 1 = 7 ∧
    centered_hexagonal_droplets 2 = 19 := by
  simp [sumper_tier_scale, centered_hexagonal_droplets]
"""^^pk:lean4 ;
    skos:notation "d_m = d_1 ρ^{m-1},   a_m = a_1 ρ^{m-1},   H(R) = 1 + 3 R (R + 1) ∈ {1, 7, 19, 37, ...}" ;
    prov:wasDerivedFrom <https://doi.org/10.1021/la7022784>,
        <https://doi.org/10.1063/1.1744102>,
        <https://doi.org/10.1126/science.1070026>,
        <https://doi.org/10.1166/jnn.2006.174> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Fourth-Order Cahn-Hilliard Spinodal Phase Separation PDE & Hierarchical Hexagonal Packing" ;
    pk:leanDeclaration "MathOfBiology.Loop_071.centered_hexagonal_droplets" ;
    pk:leanTheorem "MathOfBiology.Loop_071.sumper_2002_hierarchical_hex_packing" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


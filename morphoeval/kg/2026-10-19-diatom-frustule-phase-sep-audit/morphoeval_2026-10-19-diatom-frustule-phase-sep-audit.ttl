<https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> a pk:Claim ;
    rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation (Coscinodiscus wailesii (Centric marine diatom frustule valve pores))",
        "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation faithfully reproduces Coscinodiscus wailesii (Centric marine diatom frustule valve pores) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-1>,
        <https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-2>,
        <https://w3id.org/probknow/resource/math-law/sumper-diatom-frustule-phase-sep-3> ;
    dct:description "The simulation script(s) 2002-sumper-diatom-frustule-phase-sep.py implement the cited source model as published and produce forms that match real Coscinodiscus wailesii (Centric marine diatom frustule valve pores) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 47.7/100, audit 2026-10-19-diatom-frustule-phase-sep-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py> ;
    schema:about "Coscinodiscus wailesii (Centric marine diatom frustule valve pores)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py; output: docs/media/diatom_frustule_phase_sep_comparison.png; organism: Coscinodiscus wailesii (Centric marine diatom frustule valve pores); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: cb843885a61dd35079ecc44f25b12a884b513caa2c4f708fa015d81046e64d1c; artifact_sha256: 3d96e9137cd584b0d14db9fdf6c4d8faf5fa1f38fe5885068eb362813098d929; input_dataset_sha256: {datasets/diatom_frustule_phase_sep/coscinodiscus_diatom_specimen.jpg=47aca39b720b67b1..., datasets/diatom_frustule_phase_sep/diatom_frustule_phase_sep_reference.json=558186dc4409fb21..., datasets/diatom_frustule_phase_sep/scout_manifest.json=0eea5a04552420e8...}" ;
    pk:derivedFromPaper <https://doi.org/10.1021/la7022784>,
        <https://doi.org/10.1063/1.1744102>,
        <https://doi.org/10.1126/science.1070026>,
        <https://doi.org/10.1166/jnn.2006.174> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity>,

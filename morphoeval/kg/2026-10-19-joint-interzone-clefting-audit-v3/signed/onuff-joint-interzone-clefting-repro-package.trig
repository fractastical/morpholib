sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation, with Pass 3 reduced Biot poroelastic synovial cavitation — Reproducibility package: 95/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: `--self-test` runs 12 checks in 10.5 s including bitwise two-run determinism of both the RD PDE and the poroelastic solver (L1796-1804); the default invocation renders all three artifacts in 7.8 s; the explicit scheme carries a stability guard (L626-629); the audit environment (Python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0) is recorded; all dataset inputs are hash-verified. Deductions: no per-slot requirements lock file (-2); matplotlib needs a writable MPLCONFIGDIR and the script does not set one (-1); the GIF is not covered by a determinism check (-1); `measure_morphoeval()` re-runs every solver (16 metrics, ~9 s) rather than reading a cached run (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-repro-package-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L1745–L1848" ;
        dcterms:description "12-point self-test with bitwise determinism for RD and poroelastic solvers, Law 4-5 checks and the specimen arc check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L1745-L1848> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L626–L629" ;
        dcterms:description "Explicit-scheme stability guard adapts dt to permeability" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L626-L629> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L1852–L1888" ;
        dcterms:description "CLI with --self-test, --skip-gif, --skip-cavitation-figure, --m-load, --permeability and Pass 2 overrides" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L1852-L1888> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 018 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


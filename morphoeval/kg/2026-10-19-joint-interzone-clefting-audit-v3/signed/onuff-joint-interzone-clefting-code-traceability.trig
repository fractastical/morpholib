sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L45–L101" ;
        dcterms:description "Module docstring: Laws 1-5 mapped to Lean theorems, equations and sources, with an explicit Pass 3 claim boundary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L45-L101> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L580–L612" ;
        dcterms:description "Solver docstring names each term's source (Dowthwaite 1998, Mow 1980, Maroudas 1976, Edwards 1994, Carter & Wong 1988, Kahn 2009)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L580-L612> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/onuff-joint-interzone-clefting.yaml L80–L150" ;
        dcterms:description "Laws 4-5 registered with lean_theorem, lean_locus and code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/onuff-joint-interzone-clefting.yaml#L80-L150> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 018 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation, with Pass 3 reduced Biot poroelastic synovial cavitation — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the module docstring maps Laws 1-5 to the five Lean theorems and to equations and sources (L45-101); `simulate_poroelastic_cavitation` has an equation-level docstring naming the source of each term (L580-612); `mechanosensitive_gain`, `digit_rod_geometry`, the sweeps and the arc tracer are documented; the math_kg loop YAML registers Laws 4-5 with lean_locus and code_locus. Deductions: A_arc_over_W = 0.22, the Kahn reversion factor 0.85, K_identity = 0.30 and the Panel C composite weights are uncited calibration constants (L566-591, L666) (-5); the 1D PDE's `wave_drive` template and `drive_gain` clamp (L364-389) remain uncited Pass 2 heuristics (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2016-onuff-joint-interzone-clefting.py L566–L591: Default constants A_arc_over_W, K_identity, r_cav, kappa_G are calibrations without a cited value <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L566-L591>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


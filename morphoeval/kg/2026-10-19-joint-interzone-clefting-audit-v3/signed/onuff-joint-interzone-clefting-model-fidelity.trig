sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L194–L242" ;
        dcterms:description "Exact 2x2 GDF5-Noggin dispersion relation with integer witnesses matching Lean Law 2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L194-L242> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L566–L663" ;
        dcterms:description "Reduced Biot storage-equation cavitation solver: HA source, Darcy pressure diffusion with p = 0 outside the rod, cohesion threshold, irreversible cavity phase field" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L566-L663> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean L107–L193" ;
        dcterms:description "Laws 4-5: cavitation gate (m_load = 0 or gdf5 = 0 -> no cavity; monotone in loading) and Darcy lens midline maximum, 0 sorrys, verified with `lean`" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_018_joint_interzone_clefting.lean#L107-L193> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 018 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation, with Pass 3 reduced Biot poroelastic synovial cavitation — Model fidelity to source: 86/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the GDF5-Noggin dispersion (L194-242) and the Kavanagh cascade laws (L245-285) are exact; the new poroelastic solver (L566-791) implements a recognisable reduced Biot storage equation S dp/dt = kappa lap(p) + gamma(beta H - p) with Dirichlet drainage, a mechanosensitive HA source and a cohesion threshold, and its steady-state gate and Darcy lens are proved in Lean (Laws 4-5). Deductions: the 1D \"Turing-wavefront\" PDE does not select its own wavelength — joint positions are pre-computed `joint_targets` injected as Gaussian sources and the bp/bp PIP fusion is an `if idx_j == 1: continue` (L334-349, L364-373), so the dispersion relation is verified beside, not inside, the PDE (-6); the solid skeleton is rigid (no u-p coupling, effective stress or volumetric strain), so \"poroelastic\" is a storage equation (-4); the articular arch is an imposed parametric rule and the interzone identity is a Hill transform chosen to make the DIP cavitate (L631-640) (-3); the Kahn reversion factor 0.85 (L666) is a phenomenological constant (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2016-onuff-joint-interzone-clefting.py L334–L373: Joint positions are pre-computed `joint_targets` and the brachypodism PIP fusion is hard-coded; the RD PDE does not self-organise the pattern <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L334-L373>",
            "2016-onuff-joint-interzone-clefting.py L631–L640: Articular arch a(y) is an imposed Carter-Wong rule and the interzone identity is a Hill transform (K_identity = 0.30) rather than an emergent mechanical outcome <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L631-L640>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-model-fidelity-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


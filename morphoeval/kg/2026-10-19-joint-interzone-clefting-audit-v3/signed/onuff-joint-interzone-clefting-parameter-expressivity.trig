sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation, with Pass 3 reduced Biot poroelastic synovial cavitation — Parameter expressivity: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the 12-taxon morphospace and six genetic conditions are retained (L245-285, L951-982); Pass 3 adds two genuine mechanical parameters, each swept and monotone with a visible transition — muscle loading m_load (cavity count 0 -> 3 with threshold m* = 0.80, pore pressure monotone up, interzone Sox9 monotone down; L811-841) and Darcy permeability (cavity area monotone down, cavities lost at 16x; L844-866), both exposed on the CLI (`--m-load`, `--permeability`, L1863-1864) and rendered as Panels D-E. Deductions: A_arc_over_W, kappa_G, sigma_0 and beta_osm are not swept, so the articular arch amplitude and the cohesion threshold are fixed calibrations (-4); the loading sweep is coarse (9 points) and the threshold is reported to the grid resolution 0.2 (-2); the CLI `--m-load` and `--permeability` only affect the cavitation figure, not Panel C of the comparison figure (L1872-1879 vs L1882) (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L811–L866" ;
        dcterms:description "Muscle-loading and permeability sweeps with monotonicity flags and loading threshold" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L811-L866> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L1409–L1438" ;
        dcterms:description "Panels D-E render both sweeps (count, area, pressure, Sox9, lens height)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L1409-L1438> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L1863–L1864" ;
        dcterms:description "CLI overrides --m-load and --permeability" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L1863-L1864> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L951–L982" ;
        dcterms:description "Six genetic/signalling perturbation conditions retained from Pass 2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L951-L982> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 018 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


        schema:unitText "dimensionless (sagitta / chord)" ;
        schema:value "0.0639" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-model-joint-line-arch-sagitta-chord-ratio-pip-cavity-mid-contour-motile-wt-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-model-joint-line-arch-sagitta-chord-ratio-pip-cavity-mid-contour-motile-wt-reference> a schema:PropertyValue ;

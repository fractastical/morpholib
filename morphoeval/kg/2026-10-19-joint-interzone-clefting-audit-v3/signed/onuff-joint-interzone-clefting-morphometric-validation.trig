    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-kavanagh-et-al-2013-cross-clade-tetrapod-inhibitory-cascade-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Kavanagh et al. (2013) cross-clade tetrapod Inhibitory Cascade correlation r = 0.9976 Pearson r" ;
        dcterms:description "cross-clade mean P2/(P1+P2+P3) = 0.3316 +/- 0.0029" ;
        schema:measurementTechnique "Linear correlation between symmetric IC prediction 0.5 + 0.5*(P3/P1) and empirical P2/P1 across 12 tetrapod clades (p=5.71e-13, RMSE=0.0103)" ;
        schema:name "Kavanagh et al. (2013) cross-clade tetrapod Inhibitory Cascade correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9976" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-kavanagh-et-al-2013-cross-clade-tetrapod-inhibitory-cascade-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-kavanagh-et-al-2013-cross-clade-tetrapod-inhibitory-cascade-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Kavanagh et al. (2013) PNAS 110:18190-18195 Fig. 2 (cross-clade tetrapod digit morphospace)" ;
        schema:value "0.9969" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-model-joint-line-arch-sagitta-chord-ratio-pip-cavity-mid-contour-motile-wt> a schema:PropertyValue,

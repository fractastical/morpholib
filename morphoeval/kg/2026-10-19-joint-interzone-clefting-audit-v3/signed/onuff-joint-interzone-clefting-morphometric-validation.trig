        schema:value "0.3333" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-measurement-interzone-sox9-re-expression-ratio-paralysed-motile-kahn-2009-fate-loss> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Interzone Sox9 re-expression ratio, paralysed / motile (Kahn 2009 fate loss) = 3.5563 dimensionless ratio" ;
        dcterms:description "Sox9_IZ motile = 0.227, paralysed = 0.806; Nog-/- interzones = 0, cavities = 0" ;

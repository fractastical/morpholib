sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-onuff-joint-interzone-clefting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-onuff-joint-interzone-clefting-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Kavanagh et al. (2013) phalangeal Inhibitory Cascade & Hiscock et al. (2017) BMP-GDF5-Noggin synovial joint interzone segmentation, with Pass 3 reduced Biot poroelastic synovial cavitation — Source and data traceability: 96/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: all 5 dataset files are SHA-256 pinned and verified fail-closed on every run (L134-176); `synovial_cavitation_reference.json` records each Pass 3 source with DOI (or PMID for Edwards 1994), its finding, the reduced equations, dimensionless constants and a dimensional scaling note; the bib carries all 13 sources; the dataset README documents provenance and the juvenile-specimen caveat. Deductions: dimensional embryonic poroelastic constants are not available, only adult cartilage scales (Mow 1980, Maroudas 1976) are recorded (-2); Edwards 1994 has no DOI, PMID only (-1); the specimen's Wikimedia source is cited but its CC BY-SA attribution author is not recorded (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-source-traceability-4> ;
        pk:hasScore "0.96"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2016-onuff-joint-interzone-clefting.py L134–L176" ;
        dct:description "SHA-256 registry for 5 files and fail-closed verify_dataset_integrity()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2016-onuff-joint-interzone-clefting.py#L134-L176> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/joint_interzone_clefting/synovial_cavitation_reference.json L1–L100" ;
        dct:description "Eight Pass 3 sources with DOI/PMID and finding, reduced model equations and parameters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/joint_interzone_clefting/synovial_cavitation_reference.json#L1-L100> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/joint_interzone_clefting/paper_citations.bib L56–L144" ;
        dct:description "BibTeX entries appended for Drachman 1966 ... Maroudas 1976" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/joint_interzone_clefting/paper_citations.bib#L56-L144> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-onuff-joint-interzone-clefting-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/joint_interzone_clefting/README.md L1–L43" ;

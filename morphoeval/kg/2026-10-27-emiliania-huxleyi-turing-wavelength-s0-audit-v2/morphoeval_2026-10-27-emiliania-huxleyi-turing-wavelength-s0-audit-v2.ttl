<https://w3id.org/delphi/resource/math-law/delphi10000-emiliania-huxleyi-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavenumber" ;
    dct:description "Selects the 5.808 nm molecular repeat on the Holocene Emiliania base-plate patch | Variables: f_u, g_v Jacobian entries; D_u, D_v diffusivities in nm^2 per time" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3217_emiliania_huxleyi_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v),  lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2113/0540189>,
        <https://doi.org/10.2138/am-2004-11-1217> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3217.lambdaHolocenePm" ;
    pk:leanTheorem "MathOfBiology.Loop_3217.holocene_patch_is_eight_wavelengths" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-emiliania-huxleyi-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene mode gain against the reconstructed predecessor" ;
    dct:description "States what changes at 0 Ma versus the predecessor spacing, and that the extant node has no successor | Variables: mode counts on a fixed 46.464 nm patch" ;
    dct:source "Young & Henriksen 2003 DOI:10.2113/0540189 (coccolith calcite in vesicles; the 7.744 nm predecessor is a reconstruction)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3217_emiliania_huxleyi_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L = 8 * 5.808 nm = 6 * 7.744 nm;  successor delta = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2113/0540189>,
        <https://doi.org/10.2138/am-2004-11-1217> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3217.lambdaPredecessorPm" ;
    pk:leanTheorem "MathOfBiology.Loop_3217.holocene_gains_two_modes" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-emiliania-huxleyi-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control for Turing wavenumber selection | Variables: scaled diffusion product versus the stability gap" ;
    dct:source "Maini, Painter & Chau 1997 DOI:10.1039/a702602a" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3217_emiliania_huxleyi_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_v = D_u implies the det(k) vertex sits at k^2 <= 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1039/a702602a>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.2113/0540189>,
        <https://doi.org/10.2138/am-2004-11-1217> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3217.duScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3217.diffusion_product_clears_the_stability_gap" ;
    pk:leanVerified true .


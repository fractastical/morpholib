sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Emiliania huxleyi Holocene Turing wavelength at 5.808 nm (pass 2) — Morphometric validation: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.9944 versus reference 1.0 (RMSE 0.0182, KS on the eight band points). Specimen foreground 0.675 versus simulation 0.435, circularity 0.043 versus 0.329, coherency 0.587 versus 0.743. Spoke harmonic 30 versus predecessor mode count 6. None of these pairs are value copied onto reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-integrator>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-holocene-minus-predecessor-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-dominant-angular-harmonic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-sweep-k-c-drop-from-smallest-to-largest-d-u>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-integrator> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r (analytic vs integrator) = 0.99443 correlation" ;
        dct:description "RMSE 0.0182; KS 0.125; p=4.31e-07" ;
        schema:measurementTechnique "Pearson r of σ(k) on 8 wavenumbers, unstable eigenvector projection" ;
        schema:name "dispersion Pearson r (analytic vs integrator)" ;
        schema:unitText "correlation" ;
        schema:value "0.99443" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-integrator-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-integrator-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion relation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.01822 1/time" ;
        schema:measurementTechnique "Root mean square of analytic minus numeric growth rates" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/time" ;
        schema:value "0.01822" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "exact eigenvalue of J - k^2 D" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-holocene-minus-predecessor-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Holocene minus predecessor wavelength = -1.936 nm" ;
        dct:description "predecessor spacing is reconstructed, not a fossil measurement" ;
        schema:measurementTechnique "5.808 nm (8 modes) minus 7.744 nm (6 modes on the same 46.464 nm patch)" ;
        schema:name "Holocene minus predecessor wavelength" ;
        schema:unitText "nm" ;
        schema:value "-1.936" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-holocene-minus-predecessor-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-holocene-minus-predecessor-wavelength-reference> a schema:PropertyValue ;
        dct:source "successor delta is 0 because the chronoseries is extant" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.0431 dimensionless" ;
        schema:measurementTechnique "4 pi A / P^2 on the specimen foreground mask" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "dimensionless" ;
        schema:value "0.0431" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "simulation phenotype mask" ;
        schema:value "0.3292" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-dominant-angular-harmonic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen dominant angular harmonic = 30 cycles/revolution" ;
        dct:description "phenotype map used 30 spokes; reference is not a copy of this harmonic" ;
        schema:measurementTechnique "Peak angular frequency (band 15-70) on the right-hand coccolith annulus" ;
        schema:name "specimen dominant angular harmonic" ;
        schema:unitText "cycles/revolution" ;
        schema:value "30" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-dominant-angular-harmonic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-dominant-angular-harmonic-reference> a schema:PropertyValue ;
        dct:source "predecessor molecular mode count on the 46.464 nm patch, a different quantity" ;
        schema:value "6" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.6748 fraction" ;
        dct:description "reference is the simulation mask, not a copy of the specimen value" ;
        schema:measurementTechnique "Border-contrast mask on the CC BY-SA SEM" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.6748" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "simulation last-frame segmentation" ;
        schema:value "0.4347" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5871 dimensionless" ;
        schema:measurementTechnique "Mean (λ1-λ2)/(λ1+λ2) on the specimen foreground" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "dimensionless" ;
        schema:value "0.5871" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "simulation phenotype coherency" ;
        schema:value "0.7435" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-sweep-k-c-drop-from-smallest-to-largest-d-u> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "sweep k_c drop from smallest to largest D_u = 0.7088 1/nm" ;
        schema:measurementTechnique "Monotone decline of analytic k_c across six D_u values at ratio 18" ;
        schema:name "sweep k_c drop from smallest to largest D_u" ;
        schema:unitText "1/nm" ;
        schema:value "0.7088" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-sweep-k-c-drop-from-smallest-to-largest-d-u-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-measurement-sweep-k-c-drop-from-smallest-to-largest-d-u-reference> a schema:PropertyValue ;
        dct:source "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v)" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py L324–L372" ;

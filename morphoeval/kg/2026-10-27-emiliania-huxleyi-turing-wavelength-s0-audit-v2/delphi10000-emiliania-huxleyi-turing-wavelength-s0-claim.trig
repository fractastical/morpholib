sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-emiliania-huxleyi-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Emiliania huxleyi Holocene Turing wavelength at 5.808 nm (pass 2) faithfully reproduces Emiliania huxleyi morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Emiliania huxleyi specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py; output: docs/media/emiliania_huxleyi_turing_wavelength_s0_growth.gif; organism: Emiliania huxleyi; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 selects a finite critical wavelength from reaction and diffusion. | Schnakenberg 1979 gives f = a - u + u^2 v and g = b - u^2 v. | Henriksen et al. 2004: Emiliania CAP blocks acute calcite steps. Young & Henriksen 2003: coccolith calcite grows inside a vesicle.; reconstructed_in_script: a = 0.10, b = 0.90, D_v/D_u = 18 place k_c at 2 pi / 5.808 nm. | Predecessor lambda 7.744 nm is defined by six modes on the 46.464 nm patch. Successor delta is zero. | Shield spoke count 30 is the tangential-Sobel harmonic of this SEM, not a literature constant.; transfer_boundary: The CC BY-SA SEM is a micrometre-scale phenotype. The 5.808 nm field is mapped onto it. The photograph did not resolve 5.8 nm.; does_not_claim: That Emiliania forms pigment stripes or ocelli at 5.8 nm. | That 7.744 nm was measured on a fossil predecessor. | That CAP kinetics are Schnakenberg kinetics. | That one SEM is a population validation.]; phenomenon_size: 3.5 µm (3.531e-06 m, log10=-5.452 m, tier=3_subcellular_um); species_scale_ladder (1 runs from 3.5 µm to 3.5 µm): 3.5 µm:emiliania-calcite-rosette" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1039/a702602a>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.2113/0540189>,
            <https://doi.org/10.2138/am-2004-11-1217> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-emiliania-huxleyi-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


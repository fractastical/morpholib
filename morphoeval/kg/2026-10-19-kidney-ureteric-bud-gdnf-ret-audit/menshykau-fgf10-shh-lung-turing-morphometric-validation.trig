sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis — Morphometric validation: 48/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L198-209) reports only 3 scalar steady-state values (R_star_wt, G_star_wt, lambda_c_wt) without statistical dispersion metrics (RMSE, Pearson r, CV), without comparison to Watanabe & Costantini (2004) E11.0-E13.5 branching generation tip counts and branch angles, and without perturbation deltas for Spry1-/- hyper-branching, GDNF bead ectopic budding, or Gdnf+/- / PRR^(UB-/-) hypoplasia." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-menshykau-fgf10-shh-lung-turing.py L198–L209: Only 3 algebraic steady-state scalars without E11.0-E13.5 generation RMSE/r or perturbation controls <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L198-L209>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-critical-turing-wavelength-lambda-c-at-wild-type-parameters>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-homogeneous-steady-state-gdnf-ligand-g>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-homogeneous-steady-state-ret-receptor-r> ;
        pk:hasScore "0.48"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-critical-turing-wavelength-lambda-c-at-wild-type-parameters> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Critical Turing wavelength lambda_c at wild-type parameters = 0.472571 dimensionless domain length" ;
        schema:measurementTechnique "2 * pi / sqrt(gamma * (a + b) / sqrt(D_R * D_G))" ;
        schema:name "Critical Turing wavelength lambda_c at wild-type parameters" ;
        schema:unitText "dimensionless domain length" ;
        schema:value "0.472571" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-critical-turing-wavelength-lambda-c-at-wild-type-parameters-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-critical-turing-wavelength-lambda-c-at-wild-type-parameters-reference> a schema:PropertyValue ;
        schema:value "0.472569" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-homogeneous-steady-state-gdnf-ligand-g> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type homogeneous steady-state GDNF ligand G* = 0.9 dimensionless (b / (a + b)^2)" ;
        schema:measurementTechnique "gdnf_ret_steady_state(a=0.10, b=0.90) -> G* = b / (a + b)^2" ;
        schema:name "Wild-type homogeneous steady-state GDNF ligand G*" ;
        schema:unitText "dimensionless (b / (a + b)^2)" ;
        schema:value "0.9" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-homogeneous-steady-state-gdnf-ligand-g-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-homogeneous-steady-state-gdnf-ligand-g-reference> a schema:PropertyValue ;
        schema:value "0.9" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-homogeneous-steady-state-ret-receptor-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type homogeneous steady-state RET receptor R* = 1.0 dimensionless (a + b)" ;
        schema:measurementTechnique "gdnf_ret_steady_state(a=0.10, b=0.90) -> R* = a + b" ;
        schema:name "Wild-type homogeneous steady-state RET receptor R*" ;
        schema:unitText "dimensionless (a + b)" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-homogeneous-steady-state-ret-receptor-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-measurement-wild-type-homogeneous-steady-state-ret-receptor-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 054 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


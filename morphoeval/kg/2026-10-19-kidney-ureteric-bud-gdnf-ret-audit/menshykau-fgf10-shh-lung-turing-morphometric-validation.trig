    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/54> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/s11538-015-0073-9>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.ydbio.2004.03.025>,
            <https://doi.org/10.1088/1478-3975/10/4/046003> .
    <https://doi.org/10.1007/s11538-015-0073-9> dct:date "2015"^^xsd:gYear ;
        dct:title "A spatially-averaged mathematical model of kidney branching morphogenesis" .
    <https://doi.org/10.1016/j.devcel.2004.12.004> dct:date "2005"^^xsd:gYear ;
        dct:title "Sprouty1 is a critical regulator of GDNF/RET-mediated kidney induction" .
    <https://doi.org/10.1016/j.ydbio.2004.03.025> dct:date "2004"^^xsd:gYear ;
        dct:title "Real-time analysis of ureteric bud branching morphogenesis in vitro" .
    <https://doi.org/10.1088/1478-3975/10/4/046003> dct:date "2013"^^xsd:gYear ;
        dct:title "Kidney branching morphogenesis under the control of a ligand-receptor-based Turing mechanism" .
}


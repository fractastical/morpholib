sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> a pk:Claim ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis faithfully reproduces Mus musculus (embryonic E11.5-E13.5 mouse metanephric kidney ureteric bud tree & metanephric mesenchyme) morphology" ;
        dct:description "The simulation script(s) 2012-menshykau-fgf10-shh-lung-turing.py implement the cited source model as published and produce forms that match real Mus musculus (embryonic E11.5-E13.5 mouse metanephric kidney ureteric bud tree & metanephric mesenchyme) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 47.8/100, audit 2026-10-19-kidney-ureteric-bud-gdnf-ret-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py; output: docs/media/kidney_ureteric_bud_gdnf_ret_comparison.png; organism: Mus musculus (embryonic E11.5-E13.5 mouse metanephric kidney ureteric bud tree & metanephric mesenchyme); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 98ff66f09006e3949d0b868aa475a2ba217b732f0d29cc82d9a5d3b4965aeb50; artifact_sha256: b5e314ac269c2f687641e61f84f770113eafd6fd8b1ca184f99bb3e0769aabe8; input_dataset_sha256: {datasets/kidney_ureteric_bud_gdnf_ret/kidney_ureteric_bud_gdnf_ret_reference.json=89257794ab9d8d23..., datasets/kidney_ureteric_bud_gdnf_ret/kidney_ureteric_tree_specimen.jpg=3264f509ba3a6686..., datasets/kidney_ureteric_bud_gdnf_ret/paper_citations.bib=bb8e3d5a5c8877bd..., datasets/kidney_ureteric_bud_gdnf_ret/scout_manifest.json=c55304eda64bfba4...}" ;
        pk:derivedFromPaper <https://doi.org/10.1007/s11538-015-0073-9>,
            <https://doi.org/10.1016/j.devcel.2004.12.004>,
            <https://doi.org/10.1016/j.ydbio.2004.03.025>,
            <https://doi.org/10.1088/1478-3975/10/4/046003> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-specimen-match> ;
        pk:weightOfEvidence "0.478"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py> a schema:SoftwareSourceCode ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


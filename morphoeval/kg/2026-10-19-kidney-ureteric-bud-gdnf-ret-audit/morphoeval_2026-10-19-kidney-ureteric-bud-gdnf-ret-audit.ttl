        "2012-menshykau-fgf10-shh-lung-turing.py L29–L34: Single hardcoded parameter set without tip-radius or (a, b, gamma) morphospace sweeps <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L29-L34>" ;
    pk:hasScore 4.4e-01 ;

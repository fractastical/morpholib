            <https://doi.org/10.1088/1478-3975/10/4/046003> .

    <https://doi.org/10.1007/s11538-015-0073-9> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "A spatially-averaged mathematical model of kidney branching morphogenesis" .

    <https://doi.org/10.1016/j.devcel.2004.12.004> dcterms:date "2005"^^xsd:gYear ;
        dcterms:title "Sprouty1 is a critical regulator of GDNF/RET-mediated kidney induction" .

    <https://doi.org/10.1016/j.ydbio.2004.03.025> dcterms:date "2004"^^xsd:gYear ;
        dcterms:title "Real-time analysis of ureteric bud branching morphogenesis in vitro" .

    <https://doi.org/10.1088/1478-3975/10/4/046003> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Kidney branching morphogenesis under the control of a ligand-receptor-based Turing mechanism" .
}


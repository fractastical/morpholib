sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L37–L94" ;
        dcterms:description "Homogeneous steady state and linear Turing dispersion curve for GDNF-RET" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L37-L94> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 054 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates the homogeneous steady state (R*, G*), Jacobian entries, and linearized Turing dispersion relation Re(sigma(k)) (L37-94), and runs a 1D explicit Euler reaction-diffusion solver on an isolated arc (L97-125). However, the ureteric tree in `build_symmetric_ureteric_tree` (L128-142) is a hardcoded geometric binary recursion rather than a self-avoiding tree coupled to a 2D mesenchymal GDNF diffusion-consumption PDE field; moreover, tip-splitting mode transitions (elongation m=1 vs dichotomous m=2 vs trichotomous m=3 as a function of rho_tip = pi*R_tip/lambda_c) and genetic/bead perturbations (Spry1-/-, Gdnf+/-, exogenous GDNF bead) are absent." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-menshykau-fgf10-shh-lung-turing.py L128–L142: Uncoupled geometric binary tree lacking 2D mesenchymal GDNF consumption sink and self-avoidance <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L128-L142>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
}


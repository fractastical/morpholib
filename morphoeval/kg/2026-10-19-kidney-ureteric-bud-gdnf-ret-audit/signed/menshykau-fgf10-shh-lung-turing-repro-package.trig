sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-menshykau-fgf10-shh-lung-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Menshykau & Iber (2013), Zubkov et al. (2015) & Watanabe & Costantini (2004) kidney ureteric bud GDNF-RET-Wnt11 Turing branching morphogenesis — Reproducibility package: 68/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Provides `--self-test` and `--skip-gif` flags and deterministic output rendering (L203-224), but `self_test()` checks only 3 steady-state assertions without verifying JSON dataset parity, specimen segmentation, tip-splitting mode transitions, or two-run bitwise determinism." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package-1> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-menshykau-fgf10-shh-lung-turing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-menshykau-fgf10-shh-lung-turing.py L203–L211" ;
        dcterms:description "3-assertion baseline self_test() without dataset parity or two-run determinism check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2012-menshykau-fgf10-shh-lung-turing.py#L203-L211> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 054 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

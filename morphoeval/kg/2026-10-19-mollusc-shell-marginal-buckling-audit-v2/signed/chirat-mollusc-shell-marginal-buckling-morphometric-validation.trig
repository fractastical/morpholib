    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-l-bfgs-b-relaxed-winkler-beam-adult-pecten-rib-wavelength-lambda-sim-reference> a schema:PropertyValue ;
        dcterms:source "Chirat et al. (2013) PNAS adult Pecten jacobaeus analytical wavelength 8.7766 mm" ;

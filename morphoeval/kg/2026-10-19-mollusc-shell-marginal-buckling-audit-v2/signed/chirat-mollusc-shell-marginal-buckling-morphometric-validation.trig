    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-polar-angular-rib-spacing-cv-ribbed-bivalve-shell-specimen-jpg-reference> a schema:PropertyValue ;

    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling and antimarginal rib morphogenesis — Morphometric validation: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Extracts 9 reference-anchored morphometrics in `measure_morphoeval()` (L1118-1210), including 12-species wavelength scaling correlation (`r = 1.0000`, `RMSE = 0.125 mm`), 12-species rib-count correlation (`r = 1.0000`), log-log quarter-power exponent (`alpha = 0.2500 ± 0.0005` vs theoretical `0.25`), sub-bin spectral wavelength accuracy (`8.7764 mm` vs `8.7766 mm`), pitchfork amplitude correlation (`r = 0.9999`), subcritical negative control (`0.0 ribs`), and specimen costae count (`14` vs `14`) and angular spacing CV (`0.2196`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-antimarginal-rib-wavelength-scaling-correlation-chirat-et-al-2013-erlich-et-al-2016>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-rib-count-scaling-correlation-n-ribs-phi-0-r-lambda-c>,

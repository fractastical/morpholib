        schema:measurementTechnique "Correlation of predicted vs observed antimarginal rib count across 12 bivalve, gastropod, ammonite, and brachiopod species (RMSE=0.0766 ribs)" ;
        schema:name "12-species rib count scaling correlation N_ribs = (Phi_0 * R) / lambda_c" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-rib-count-scaling-correlation-n-ribs-phi-0-r-lambda-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-rib-count-scaling-correlation-n-ribs-phi-0-r-lambda-c-reference> a schema:PropertyValue ;

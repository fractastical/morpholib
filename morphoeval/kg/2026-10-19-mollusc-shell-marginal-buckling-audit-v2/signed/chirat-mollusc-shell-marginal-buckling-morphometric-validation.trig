    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-log-log-quarter-power-foundation-scaling-exponent-alpha-lambda-c-ei-k-alpha> a schema:PropertyValue,

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-antimarginal-rib-wavelength-scaling-correlation-chirat-et-al-2013-erlich-et-al-2016> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species antimarginal rib wavelength scaling correlation (Chirat et al. 2013 / Erlich et al. 2016) = 1.0 Pearson r" ;
        dcterms:description "RMSE = 0.1125 mm, p=3.63e-26" ;
        schema:measurementTechnique "Linear regression of predicted 2*pi*(EI/k)^(1/4) vs measured wavelength across 12 species in 4 clades (p=3.63e-26, RMSE=0.1125 mm)" ;
        schema:name "12-species antimarginal rib wavelength scaling correlation (Chirat et al. 2013 / Erlich et al. 2016)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-antimarginal-rib-wavelength-scaling-correlation-chirat-et-al-2013-erlich-et-al-2016-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-antimarginal-rib-wavelength-scaling-correlation-chirat-et-al-2013-erlich-et-al-2016-reference> a schema:PropertyValue ;
        dcterms:source "Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 & Erlich et al. (2016) J. R. Soc. Interface 13:20160592" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-12-species-rib-count-scaling-correlation-n-ribs-phi-0-r-lambda-c> a schema:PropertyValue,

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-measurement-biological-specimen-segmented-primary-radial-costae-count-ribbed-bivalve-shell-specimen-jpg-reference> a schema:PropertyValue ;

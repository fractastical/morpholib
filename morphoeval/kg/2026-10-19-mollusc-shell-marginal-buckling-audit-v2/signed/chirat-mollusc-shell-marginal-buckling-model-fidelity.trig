sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L136–L297" ;
        dcterms:description "Analytical Winkler-beam critical load, pitchfork amplitude law, and L-BFGS-B energy minimizer" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py#L136-L297> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L303–L428" ;
        dcterms:description "3D accretionary shell valve synthesis across 4 Chirat-Erlich morphospace regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py#L303-L428> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_072_mollusc_shell_marginal_buckling.lean L18–L114" ;
        dcterms:description "4 Lean 4 theorems proving critical buckling onset, zero-thrust symmetry, pitchfork bifurcation, and isometric/intercalating rib scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_072_mollusc_shell_marginal_buckling.lean#L18-L114> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling and antimarginal rib morphogenesis — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Minimizes the exact fourth-order nonlinear Winkler-beam energy functional via L-BFGS-B (`relax_winkler_mantle_margin`, L198-297), implements the analytical critical buckling load P_c = 2*sqrt(E*I*k), intrinsic wavelength lambda_c = 2*pi*(E*I/k)^(1/4), and supercritical pitchfork amplitude A_eq(P) = sqrt(4*q_c^2*(P-P_c)/(3*kappa_3)) (L136-174), synthesizes 3D accretionary shell valves across isometric vs intercalating growth (`simulate_accretionary_shell_3d`, L303-398), and verifies the subcritical negative control (P/P_c=0.65 -> 0 ribs). Backed by 4 machine-checked Lean 4 theorems in `Loop_072_mollusc_shell_marginal_buckling.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


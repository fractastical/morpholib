    <https://doi.org/10.1016/j.jtbi.2012.07.009> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Mechanical growth and morphogenesis of seashells" .

    <https://doi.org/10.1073/pnas.1220443110> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Mechanical basis of morphogenesis and convergent evolution of spiny seashells" .

    <https://doi.org/10.1098/rsif.2016.0592> dcterms:date "2016"^^xsd:gYear ;
        dcterms:title "The physical basis of mollusk shell chiral coiling and antimarginal rib ornamentation" .


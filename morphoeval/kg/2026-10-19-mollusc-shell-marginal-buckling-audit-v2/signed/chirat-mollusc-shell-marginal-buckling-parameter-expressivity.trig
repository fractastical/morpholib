sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-chirat-mollusc-shell-marginal-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Chirat, Moulton & Goriely (2013) & Erlich et al. (2016) mollusc shell marginal buckling and antimarginal rib morphogenesis — Parameter expressivity: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates 4 distinct morphospace regimes (smooth subcritical, isometric *Pecten*, intercalating multicostate *Chlamys*/*Spirifer*, and episodic spiny varix *Murex*), sweeps normalized thrust P/P_c across 8 points in [0.65, 1.85] (`evaluate_pitchfork_bifurcation_sweep`, L500-525), evaluates 12 species across 4 clades, and exposes `--EI`, `--k`, `--P-ratio`, `--R-adult`, `--seed`, and `--skip-gif` CLI overrides (L1268-1299)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L401–L525" ;
        dcterms:description "4 morphospace regimes, 12-species scaling collapse, and 8-point P/P_c pitchfork sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py#L401-L525> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-chirat-mollusc-shell-marginal-buckling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2013-chirat-mollusc-shell-marginal-buckling.py L1268–L1299" ;
        dcterms:description "Full CLI parameter overrides wired into render_comparison_figure()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2013-chirat-mollusc-shell-marginal-buckling.py#L1268-L1299> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


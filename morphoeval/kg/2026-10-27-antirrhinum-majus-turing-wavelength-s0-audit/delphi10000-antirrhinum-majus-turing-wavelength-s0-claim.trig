sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Antirrhinum majus Turing ocellus wavelength at 259 µm (Holocene, 0 Ma) faithfully reproduces Antirrhinum majus morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Antirrhinum majus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py; output: docs/media/antirrhinum_majus_turing_wavelength_s0_growth.gif; organism: Antirrhinum majus; environment: n/a; claim_boundary: [reported_in_source: Shang et al. 2010: Venosa MYB places anthocyanin over veins. | Noda et al. 1994: MIXTA conical epidermal cells intensify petal colour. | Turing 1952: diffusion-driven instability and a critical wavenumber.; reconstructed_in_script: Integer diffusivities D_u=640, D_v=4341 chosen so argmax σ(k) is 259.13 µm. | Split-step cubic saturation and the rendered radial ocellus.; transfer_boundary: Vein-locked Venosa pigment is not shown here to be a Turing instability. | The gallery ring pitch (77.8 µm) is a property of that asset, not a published histological wavelength.; does_not_claim: That Antirrhinum uses these kinetic constants in vivo. | That 77.8 µm and 259.13 µm are the same measurement.]; phenomenon_size: 436 µm (0.0004356 m, log10=-3.361 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 436 µm to 69.7 cm): 436 µm:antirrhinum-majus-bioelectric-polarity, 810 µm:antirrhinum-majus-vertex-packing, 1.5 cm:antirrhinum-majus-turing-wavelength, 2.8 cm:antirrhinum-majus-clock-wavefront, 9.2 cm:antirrhinum-majus-morphogen-condensation, 12.0 cm:antirrhinum-majus-flux-canalization, 12.7 cm:antirrhinum-majus-elastic-buckling, 15.8 cm:antirrhinum-majus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1038/369661a0>,
            <https://doi.org/10.1073/pnas.0306308101>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1105/tpc.105.039255>,
            <https://doi.org/10.1111/j.1469-8137.2010.03498.x> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/369661a0>,
            <https://doi.org/10.1073/pnas.0306308101>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1105/tpc.105.039255>,
            <https://doi.org/10.1111/j.1469-8137.2010.03498.x> .
    <https://doi.org/10.1038/369661a0> dct:date "1994"^^xsd:gYear ;
        dct:title "Flower colour intensity depends on specialized cell shape controlled by a Myb-related transcription factor" .
    <https://doi.org/10.1073/pnas.0306308101> dct:date "2004"^^xsd:gYear ;
        dct:title "The genetics of geometry" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1105/tpc.105.039255> dct:date "2006"^^xsd:gYear ;
        dct:title "A small family of MYB-regulatory genes controls floral pigmentation intensity and patterning in the genus Antirrhinum" .
    <https://doi.org/10.1111/j.1469-8137.2010.03498.x> dct:date "2010"^^xsd:gYear ;
        dct:title "The molecular basis for venation patterning of pigmentation and its effect on pollinator attraction in flowers of Antirrhinum" .
}


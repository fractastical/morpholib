<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Antirrhinum majus Turing ocellus wavelength at 259 µm (Holocene, 0 Ma) (Antirrhinum majus)",
        "Antirrhinum majus Turing ocellus wavelength at 259 µm (Holocene, 0 Ma) faithfully reproduces Antirrhinum majus morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-antirrhinum-majus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-antirrhinum-majus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-antirrhinum-majus-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-antirrhinum-majus-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Antirrhinum majus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-antirrhinum-majus-turing-wavelength-s0.py> ;
    schema:about "Antirrhinum majus" ;
    schema:additionalProperty "does_not_claim: That 77.8 µm and 259.13 µm are the same measurement.",
        "does_not_claim: That Antirrhinum uses these kinetic constants in vivo.",
        "reconstructed_in_script: Integer diffusivities D_u=640, D_v=4341 chosen so argmax σ(k) is 259.13 µm.",
        "reconstructed_in_script: Split-step cubic saturation and the rendered radial ocellus.",
        "reported_in_source: Noda et al. 1994: MIXTA conical epidermal cells intensify petal colour.",
        "reported_in_source: Shang et al. 2010: Venosa MYB places anthocyanin over veins.",
        "reported_in_source: Turing 1952: diffusion-driven instability and a critical wavenumber.",
        "transfer_boundary: The gallery ring pitch (77.8 µm) is a property of that asset, not a published histological wavelength.",
        "transfer_boundary: Vein-locked Venosa pigment is not shown here to be a Turing instability." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Antirrhinum majus" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "III. Phyta (Embryophyta)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;

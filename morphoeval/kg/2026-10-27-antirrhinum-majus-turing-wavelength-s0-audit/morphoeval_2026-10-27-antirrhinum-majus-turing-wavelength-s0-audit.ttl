<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-antirrhinum-majus-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Antirrhinum majus Turing ocellus wavelength at 259 µm (Holocene, 0 Ma) — Morphological realism / specimen match: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The last GIF frame is a green radial ocellus in the same 800×600 framing as the gallery field. Direct CV similarity is 83.6 (orientation, radial FFT, coherency, occupancy). The gallery pitch measured from its 100 µm bar is 77.8 µm, while the simulation is one 259.13 µm wave per ring, so the resemblance is of pattern class, not of physical pitch. The CC BY-SA Sète flower is an organ-scale voucher and is not the image the GIF is scored against." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

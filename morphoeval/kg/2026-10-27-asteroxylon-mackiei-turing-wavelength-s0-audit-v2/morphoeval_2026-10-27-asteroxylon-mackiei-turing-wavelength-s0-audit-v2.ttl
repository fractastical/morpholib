<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-asteroxylon-mackiei-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Asteroxylon mackiei Schnakenberg critical wavelength at 5.2 µm (Pass 2) — Morphological realism / specimen match: 84/100" ;

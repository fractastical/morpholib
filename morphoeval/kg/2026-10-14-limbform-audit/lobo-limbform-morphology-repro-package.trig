sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Reproducibility package: 65/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "Deterministic (no random state), invocation documented in the docstring and README, the input is fetched and hash-verified by the script itself, rows without geometry are skipped with a message, outputs are identical on re-run. Dependencies are in requirements.txt with lower bounds only and the known-good environment (Python 3.14) is recorded only in this audit." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-repro-package-3> ;
        pk:hasScore "0.65"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L49–L60" ;
        dct:description "documented invocation and outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L49-L60> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L885–L921" ;
        dct:description "main(): download, checks, outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L885-L921> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "requirements.txt L1–L7" ;
        dct:description "lower bounds only" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/requirements.txt#L1-L7> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


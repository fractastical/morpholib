sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Source and data traceability: 85/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "Both papers are cited with DOIs, the database version, download URL, byte size and SHA-256 are recorded and verified on every run, the schema tables used are listed, and the reference figure used by the measurements is pinned by hash. The database's licence is not stated on the Lobo-lab page or in the file, which is why it is cached rather than vendored; that gap is the source's, but it is recorded here." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-source-traceability-4> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L14–L24" ;
        dct:description "references with DOIs and database URL" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L14-L24> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L89–L93" ;
        dct:description "URL, SHA-256 and size of the database" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L89-L93> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L200–L219" ;
        dct:description "resolve_db_path(): download and hash check" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L200-L219> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L263–L284" ;
        dct:description "load_first_report_year(): the join to Publication.Year" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L263-L284> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582>,
            <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
    <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> dct:title "LimbformDB 2.1.0 (31 Jul 2014), the Limbform database file" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-limbform-audit-lobo-limbform-morphology-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Source and data traceability: 85/100" ;
        rdfs:comment "Both papers are cited with DOIs, the database version, download URL, byte size and SHA-256 are recorded and verified on every run, the schema tables used are listed, and the reference figure used by the measurements is pinned by hash. The database's licence is not stated on the Lobo-lab page or in the file, which is why it is cached rather than vendored; that gap is the source's, but it is recorded here. Evidence: 2014-lobo-limbform-morphology.py L14–L24: references with DOIs and database URL <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L14-L24>; 2014-lobo-limbform-morphology.py L89–L93: URL, SHA-256 and size of the database <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L89-L93>; 2014-lobo-limbform-morphology.py L200–L219: resolve_db_path(): download and hash check <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L200-L219>; 2014-lobo-limbform-morphology.py L263–L284: load_first_report_year(): the join to Publication.Year <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L263-L284>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-source-traceability> ;
        pk:hasProbability "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-source-traceability> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Source and data traceability' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dcterms:identifier "morphoeval/0.1.0/source-traceability" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582> .

    <https://doi.org/10.1002/reg2.13> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .

    <https://doi.org/10.1093/bioinformatics/btu582> dcterms:date "2014"^^xsd:gYear ;
        dcterms:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
}


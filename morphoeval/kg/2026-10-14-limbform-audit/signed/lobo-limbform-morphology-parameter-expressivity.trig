sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-limbform-audit-lobo-limbform-morphology-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Parameter expressivity: 75/100" ;
        rdfs:comment "Every encoded number has a visible effect: each radius moves one control point of the outline, each segment's Dist/Ang moves its distal joint and everything beyond it, each sub-joint places a graft, each digit's Dist/Ang/NumBones draws one digit. Morphologies in one frame share one scale, so size differences between phenotypes are preserved. There is no parameter sweep in the output and Side/Reversed/Inverted are only reported (no 2.1.0 entry uses them), so their effect is untested. Evidence: 2014-lobo-limbform-morphology.py L286–L312: layout(): joint positions from Dist/Ang <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L286-L312>; 2014-lobo-limbform-morphology.py L377–L400: build_geometry(): control points, pieces, digits <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L377-L400>; 2014-lobo-limbform-morphology.py L788–L862: render_timeline(): shared scale per frame; category grids <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L788-L862>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-parameter-expressivity> ;
        pk:hasProbability "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-parameter-expressivity> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dcterms:identifier "morphoeval/0.1.0/parameter-expressivity" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-limbform-audit-lobo-limbform-morphology-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Reproducibility package: 65/100" ;
        rdfs:comment "Deterministic (no random state), invocation documented in the docstring and README, the input is fetched and hash-verified by the script itself, rows without geometry are skipped with a message, outputs are identical on re-run. Dependencies are in requirements.txt with lower bounds only and the known-good environment (Python 3.14) is recorded only in this audit. Evidence: 2014-lobo-limbform-morphology.py L49–L60: documented invocation and outputs <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L49-L60>; 2014-lobo-limbform-morphology.py L885–L921: main(): download, checks, outputs <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L885-L921>; requirements.txt L1–L7: lower bounds only <https://github.com/fractastical/morpholib/blob/747c57f/requirements.txt#L1-L7>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-repro-package> ;
        pk:hasProbability "0.65"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-repro-package> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}


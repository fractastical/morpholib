@prefix dct: <http://purl.org/dc/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix pk: <https://w3id.org/probknow/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-limbform-audit-lobo-limbform-morphology-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Morphological realism / specimen match: 65/100" ;
        rdfs:comment "The only published renderings of these database entries are the cartoons in Fig. 1 of the Regeneration paper; side by side, the decoded axolotl forelimb, Xenopus hindlimb, fiddler-crab walking leg, cricket T3 leg and huntsman-spider leg have the same segments, digits, pose and colour scheme (gradient, coxa green, basis yellow, bones, digits). Measured on the figure, bounding-box-aligned silhouette IoU is 0.64, 0.41, 0.43, 0.74 and 0.49 for panels A''-E'': the cricket leg is essentially identical, the others differ in joint angles and segment width (the frog thigh-shank angle most of all), which may reflect a database revision after the figure was drawn or an angle convention not captured. Distinct morphologies (double limbs, grafts, branched chelipeds, missing segments) render distinctly. No photographs of real limbs are compared. Evidence: limbform_wildtype_gallery.png (generated output, not in repo): the five Fig. 1 wild types plus ten further wild-type limbs — limbform_wildtype_gallery.png: rendered output of 2014-lobo-limbform-morphology.py at 747c57f, image/png, 620043 B, 2400×1875 px, sha256 d561f4aab10756976c3fd5caf7a8c516da13c1cd9395d6cb5a54b8a2f5b10236; 2014-lobo-limbform-morphology.py L419–L453: boundary_tour(): Euler tour of the limb tree -> closed outline <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L419-L453>; 2014-lobo-limbform-morphology.py L632–L666: colour_field(): the paper's gradient and flat colours <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L632-L666>; 2014-lobo-limbform-morphology.py L678–L704: draw_bones(): long bones for salamanders and frogs only <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L678-L704>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-specimen-match> ;
        pk:hasProbability "0.65"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology-specimen-match> rdfs:label "LimbformDB limb morphologies (2014-lobo-limbform-morphology.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0)" ;
        dct:identifier "morphoeval/0.1.0/specimen-match" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
}


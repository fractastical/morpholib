sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> a pk:Claim ;
        rdfs:label "LimbformDB limb morphologies faithfully reproduces Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0) morphology" ;
        dct:description "The simulation script(s) 2014-lobo-limbform-morphology.py implement the cited source model as published and produce forms that match real Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 71.3/100, audit 2026-10-14-limbform-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py; output: limbform_wildtype_gallery.png; organism: Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0); checkpoint commit: https://github.com/fractastical/morpholib/commit/747c57f; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0; other sources: LimbformDB 2.1.0 (31 Jul 2014), the Limbform database file <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb>" ;
        pk:derivedFromPaper <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-specimen-match> ;
        pk:weightOfEvidence "0.713"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py> a schema:SoftwareSourceCode ;
        rdfs:label "2014-lobo-limbform-morphology.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "747c57f" .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582>,
            <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
    <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> dct:title "LimbformDB 2.1.0 (31 Jul 2014), the Limbform database file" .
}


<https://w3id.org/probknow/resource/math-law/lobo-limbform-morphology-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lobo et al. (2014) Limbform Recursive Segmental Tree Vector Law" ;
    dct:description "Decodes normal, regenerating, and ectopic/supernumerary amphibian and vertebrate limb morphologies from LimbformDB | Variables: L_k: limb podial/zeugopod/stylopod segment length; α_j: relative joint branching angle; r: segment radius" ;
    dct:source "Lobo, Feldman & Levin (2014) Dev. Biol. / Bioinformatics",
        "Lobo, Feldman,ama & Levin (2014) Dev. Biol. / Bioinformatics" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L75-L210>,
        <https://github.com/fractastical/morpholib/blob/747c57f/morphoeval/lean/MathOfBiology.lean#L274-L287> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """inductive LimbTree where
  | leaf (length : Nat) : LimbTree
  | branch (length : Nat) (child : LimbTree) : LimbTree
theorem lobo_2014_three_segment_axis (L1 L2 L3 : Nat) :
    limb_segment_count (LimbTree.branch L1 (LimbTree.branch L2 (LimbTree.leaf L3))) = 3 := by rfl"""^^pk:lean4 ;
    skos:notation "x_{k+1} = x_k + L_k [cos(∑_{j≤k} α_j), sin(∑_{j≤k} α_j)]^T,   T = (s, α, r, L, children)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
        <https://doi.org/10.1093/bioinformatics/btu582> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Recursive Tree Graph Grammar & Segmental Kinematics" ;
    pk:leanDeclaration "MathOfBiology.limb_segment_count" ;
    pk:leanTheorem "MathOfBiology.lobo_2014_three_segment_axis" ;
    pk:leanVerified false,
        true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow LLM-assessment template) that evaluates the hypothesis pkr:hypothesis/morphoeval-<sim>-<dimension> with pk:hasProbability = score/100 and a pk:hasVerdict band; the overall score evaluates pkr:hypothesis/morphoeval-<sim> and is also the pk:weightOfEvidence of the pk:Claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


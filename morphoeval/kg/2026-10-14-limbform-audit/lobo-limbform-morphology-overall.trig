sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-limbform-audit-lobo-limbform-morphology-overall> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — MorphoEval overall 71.3/100" ;
        rdfs:comment "Decodes the Limbform formalism (segments as graph edges with length and direction, joints as vertices with border radii, sub-joints for grafts, digits with phalanx counts) for 555 of the 565 morphology rows of LimbformDB 2.1.0 — the other 10 are outcome labels without geometry — and draws each limb as a smooth outline through the joint control points with the paper's proximodistal red-to-blue gradient, green coxa, yellow basis/trochanter, black long bones and blue digits. Against the paper's own cartoons of the five Fig. 1 wild types the decoded silhouettes have the same topology, pose and segment/digit counts; bounding-box-aligned IoU is 0.41-0.74 (best for the cricket leg, worst for the frog hindlimb, where the thigh-shank angle differs). The joint-radius rule of the formalism holds for 3137 of 3146 joints when a sub-joint counts its host segment twice. Overall 71.3/100 (faithfulness 70.0, reproducibility 74.3); rubric morphoeval 0.1.0; checkpoint commit 747c57f; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0. Dimension assessments: Model fidelity to source 85, Morphological realism / specimen match 65, Parameter expressivity 75, Morphometric validation 55, Source and data traceability 85, Code-to-model traceability 75, Reproducibility package 65. Output judged: limbform_wildtype_gallery.png: rendered output of 2014-lobo-limbform-morphology.py at 747c57f, image/png, 620043 B, 2400×1875 px, sha256 d561f4aab10756976c3fd5caf7a8c516da13c1cd9395d6cb5a54b8a2f5b10236." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology> ;
        pk:evidenceAgainst "remediation needed: Ask the Lobo lab for the LimbformDB licence so the file can be vendored with its hash.",
            "remediation needed: Compare at least the five wild types with photographs of the real limbs (Fig. 1 A-E), e.g. segment-length ratios, not only with the paper's cartoons.",
            "remediation needed: Confirm the Ang convention and the joint-radius order against the Limbform software source or the authors, and explain the Fig. 1 B''/C'' silhouette residuals.",
            "remediation needed: Pin the Python 3.14 environment (exact versions) in requirements or a lock file." ;
        pk:hasProbability "0.713"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-lobo-limbform-morphology> rdfs:label "LimbformDB limb morphologies faithfully reproduces Urodele and anuran amphibians, decapod crustaceans, orthopteroid insects and a spider (LimbformDB 2.1.0) morphology" ;
        dct:identifier "morphoeval/0.1.0/overall" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
}


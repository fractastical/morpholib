sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Model fidelity to source: 85/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "The encoding is read as the formalism defines it: Link rows are segments with Type, Dist, Ang, Side/Reversed/Inverted and NumBones; JointParam radii are one per bisector of consecutive segments at the joint or +90/+180/+270 deg for a terminal joint; LinkSubJoint places grafts at (Dist, Ang) on their host segment; Digit rows hang off the hand/foot segment. The rule is checked against every joint at load time (3137/3146) and the 9 under-parameterised joints are padded with the joint's mean radius, which is stated in the code. Short of full marks because the papers describe the formalism in prose, so the bisector-order convention and the 'host segment counts twice' rule for sub-joints were established by checking the database, and because the residual silhouette differences against Fig. 1 (below) leave the Ang convention not fully confirmed." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-4> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L26–L47" ;
        dct:description "the formalism as implemented" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L26-L47> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L222–L260" ;
        dct:description "load_morphologies(): the five tables read" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L222-L260> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L314–L352" ;
        dct:description "_edges_of()/control_points(): the radius rule, edge order kept" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L314-L352> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L606–L620" ;
        dct:description "check_encoding(): the rule checked on every joint" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L606-L620> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582>,
            <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
    <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> dct:title "LimbformDB 2.1.0 (31 Jul 2014), the Limbform database file" .
}


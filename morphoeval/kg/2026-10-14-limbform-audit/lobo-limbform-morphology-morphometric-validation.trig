sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Morphometric validation: 55/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "The script computes per-morphology morphometrics (segment and digit counts, proximodistal path length, bounding box, silhouette area) and writes them as CSV, and the measurements sidecar compares the five Fig. 1 wild types quantitatively with the paper's own figure (segment and digit counts against the labelled graphs A'-E', all equal; silhouette IoU and bounding-box aspect against the cartoons A''-E''). Those are comparisons with the source authors' rendering of the same data, not with measurements of real limbs, and the IoU values themselves show the agreement is partial." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-1-wild-type-right-forelimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-280-wild-type-right-hindlimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-314-wild-type-right-walking-leg-fiddler-crab>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-490-wild-type-right-metathoracic-t3-leg-cricket-nymph>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-bounding-box-aspect-491-wild-type-right-leg-i-huntsman-spider>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-digits-1-wild-type-right-forelimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-digits-280-wild-type-right-hindlimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-joints-obeying-the-radius-rule>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-morphologies-decoded>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-segments-1-wild-type-right-forelimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-segments-280-wild-type-right-hindlimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-segments-314-wild-type-right-walking-leg-fiddler-crab>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-segments-490-wild-type-right-metathoracic-t3-leg-cricket-nymph>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-segments-491-wild-type-right-leg-i-huntsman-spider>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-silhouette-iou-vs-fig-1-a-1-wild-type-right-forelimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-silhouette-iou-vs-fig-1-b-280-wild-type-right-hindlimb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-silhouette-iou-vs-fig-1-c-314-wild-type-right-walking-leg-fiddler-crab>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-silhouette-iou-vs-fig-1-d-490-wild-type-right-metathoracic-t3-leg-cricket-nymph>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-measurement-silhouette-iou-vs-fig-1-e-491-wild-type-right-leg-i-huntsman-spider>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-morphometric-validation-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-morphometric-validation-4> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lobo-limbform-morphology> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lobo-limbform-morphology-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "LimbformDB limb morphologies — Code-to-model traceability: 75/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "The module docstring states the formalism table by table and names the paper section it follows; the radius rule, the sub-joint rule, the Fig. 1 colour conventions and the bones-for-tetrapods-only convention are documented where they are implemented. As with the Planform sibling, the papers give no numbered equations, so the rules were confirmed against the database rather than quoted." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-code-traceability-3> ;
        pk:hasScore "0.75"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L1–L13" ;
        dct:description "what is reproduced and from which figure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L1-L13> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L113–L125" ;
        dct:description "colour and bone conventions named" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L113-L125> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lobo-limbform-morphology-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2014-lobo-limbform-morphology.py L330–L352" ;
        dct:description "control_points(): rule and padding stated" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/747c57f/2014-lobo-limbform-morphology.py#L330-L352> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/reg2.13>,
            <https://doi.org/10.1093/bioinformatics/btu582>,
            <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> .
    <https://doi.org/10.1002/reg2.13> dct:date "2014"^^xsd:gYear ;
        dct:title "A bioinformatics expert system linking functional data to anatomical outcomes in limb regeneration" .
    <https://doi.org/10.1093/bioinformatics/btu582> dct:date "2014"^^xsd:gYear ;
        dct:title "Limbform: a functional ontology-based database of limb regeneration experiments" .
    <https://lobolab.umbc.edu/limbform/downloads/limbformDB_2.1.0.ldb> dct:title "LimbformDB 2.1.0 (31 Jul 2014), the Limbform database file" .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila paulistorum Schnakenberg ocellar stripe at 2.4 µm (Pass 2) — Model fidelity to source: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg kinetics, the periodic 5-point Laplacian, and the linear eigenvalue are implemented directly. D_MAGNITUDE_SCALE = 0.478965 places argmax σ(k) at 2.416 µm (gate ±0.02 µm) with σ(k_c)=3.13. Trace -0.2 and determinant 1 match the Lean theorems. Equal diffusion is linearly stable and numerically decays." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py L98–L150" ;
        dct:description "Jacobian and diffusivity placement so the growth-rate peak is at 2.417 µm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9a9d6408/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py#L98-L150> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py L164–L248" ;
        dct:description "Growth-rate eigenvalue and the periodic integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9a9d6408/models/2026-delphi10000-drosophila-paulistorum-turing-wavelength-s0.py#L164-L248> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-paulistorum-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3197_drosophila_paulistorum_turing_wavelength_s0.lean L17–L56" ;
        dct:description "Six theorems: stable trace, positive determinant, positive k numerator, orena packing 37 remainder 11, persimilis packing 48 remainder 684, six waves tile 14502 nm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9a9d6408/morphoeval/lean/loops/Loop_3197_drosophila_paulistorum_turing_wavelength_s0.lean#L17-L56> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary loop assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://github.com/fractastical> ;
        foaf:homepage <https://x.ai> .
}


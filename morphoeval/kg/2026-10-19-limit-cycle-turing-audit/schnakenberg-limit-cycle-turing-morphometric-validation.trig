sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Morphometric validation: 34/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L69-96) checks analytical equilibrium values (u_*=1.0, v_*=0.9, det(J_0)=1.0) and raw activator standard deviation std_u, but computes no 2D FFT radial power spectrum, no sub-bin wavenumber peak k* vs analytical k_c, no limit-cycle oscillation period T_LC, and no specimen nearest-neighbor or sorocarp morphometrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L69–L96: baseline 4-item measurement list without spectral wavelength or specimen validation <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L69-L96>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-homogeneous-equilibrium-activator-u-star>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-homogeneous-equilibrium-substrate-v-star>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-reaction-jacobian-determinant-det-j-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-turing-activator-spatial-std-u-d-18> ;
        pk:hasScore "0.34"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-homogeneous-equilibrium-activator-u-star> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "homogeneous equilibrium activator u_star = 1.0 dimensionless" ;
        dct:description "Schnakenberg (1979) Eq. 20 baseline equilibrium check" ;
        schema:measurementTechnique "Analytical equilibrium u_* = a + b at (a, b) = (0.10, 0.90)" ;
        schema:name "homogeneous equilibrium activator u_star" ;
        schema:unitText "dimensionless" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-homogeneous-equilibrium-activator-u-star-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-homogeneous-equilibrium-activator-u-star-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-homogeneous-equilibrium-substrate-v-star> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "homogeneous equilibrium substrate v_star = 0.9 dimensionless" ;
        dct:description "Schnakenberg (1979) Eq. 20 baseline substrate check" ;
        schema:measurementTechnique "Analytical equilibrium v_* = b / (a + b)^2 at (a, b) = (0.10, 0.90)" ;
        schema:name "homogeneous equilibrium substrate v_star" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-homogeneous-equilibrium-substrate-v-star-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-homogeneous-equilibrium-substrate-v-star-reference> a schema:PropertyValue ;
        schema:value "0.9" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-reaction-jacobian-determinant-det-j-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "reaction Jacobian determinant det(J_0) = 1.0 dimensionless" ;
        dct:description "Positive Jacobian determinant at Turing base state" ;
        schema:measurementTechnique "det(J_0) = (a + b)^2 evaluated at (a, b) = (0.10, 0.90)" ;
        schema:name "reaction Jacobian determinant det(J_0)" ;
        schema:unitText "dimensionless" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-reaction-jacobian-determinant-det-j-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-reaction-jacobian-determinant-det-j-0-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-schnakenberg-limit-cycle-turing-measurement-turing-activator-spatial-std-u-d-18> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing activator spatial std_u (d=18) = 2.9094 concentration units (std)" ;
        dct:description "Pass 1 uncalibrated spatial amplitude std" ;
        schema:measurementTechnique "Standard deviation of 2D activator field u(x,y) after 1200 steps" ;
        schema:name "Turing activator spatial std_u (d=18)" ;
        schema:unitText "concentration units (std)" ;
        schema:value "2.9094" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/253540a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1371/journal.pcbi.1004367> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/253540a0> dct:date "1975"^^xsd:gYear ;
        dct:title "Mechanism for oscillatory synthesis of cyclic AMP in Dictyostelium discoideum" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1371/journal.pcbi.1004367> dct:date "2015"^^xsd:gYear ;
        dct:title "Regulation of spatiotemporal patterns by biological variability: general principles and applications to Dictyostelium discoideum" .
}


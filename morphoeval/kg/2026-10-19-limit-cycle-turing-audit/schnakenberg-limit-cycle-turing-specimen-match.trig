sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Morphological realism / specimen match: 18/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`datasets/limit_cycle_turing/dictyostelium_specimen.jpg` is not loaded or segmented in v1, and `docs/media/limit_cycle_turing_comparison.png` displays only a 1x2 synthetic activator/substrate heatmap without biological specimen overlay, sorocarp head/aggregate segmentation, or limit-cycle phase portrait." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L99–L126: renders only a 1x2 synthetic heatmap with no biological specimen analysis <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L99-L126>",
            "docs/media/limit_cycle_turing_comparison.png (generated output, not in repo): 2-panel synthetic plot lacking Dictyostelium specimen comparison — docs/media/limit_cycle_turing_comparison.png: rendered output of 1979-schnakenberg-limit-cycle-turing.py at 8871db0, image/png, 30690 B, 1170×520 px, artifact_sha256 eff14c72d4713c7707d9f6301a20de8ca565adc8bea363ab4b3e4e2f554abd6d (sha256 eff14c72d4713c7707d9f6301a20de8ca565adc8bea363ab4b3e4e2f554abd6d), spec_fingerprint e7a48d2f9b6eadc84256e32af6d90edcc5a9823751407e82e8ce1b2293da2e1e" ;
        pk:hasScore "0.18"^^xsd:double ;
        pk:hasVerdict "not faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-limit-cycle-turing-audit-schnakenberg-limit-cycle-turing-1>,

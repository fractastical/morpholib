<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-1>,
        <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-2>,
        <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-3> .

<https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg (1979) Cubic Autocatalytic Equilibrium & Flux Conservation Law" ;
    dct:description "Establishes the unique positive homogeneous equilibrium (u_*, v_*) = (a+b, b/(a+b)^2) with invariant cubic flux u_*^2 v_* = b and linear total mass balance R_u + R_v = a + b - u | Variables: u: autocatalytic activator concentration; v: substrate/inhibitor concentration; a, b: dimensionless feed rates; γ: reaction-rate/area scale factor; d = D_v/D_u: diffusivity ratio" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81(3):389-400 Eqs. (15)-(20)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L140-L195>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L24-L36> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_react_u (a u flux : Int) : Int := a - u + flux
def schnakenberg_react_v (b flux : Int) : Int := b - flux
theorem schnakenberg_equilibrium_zero_flux (a b u flux : Int) :
    schnakenberg_react_u a (a + b) b = 0 ∧
    schnakenberg_react_v b b = 0 ∧
    schnakenberg_react_u a u flux + schnakenberg_react_v b flux = a + b - u := by
  simp [schnakenberg_react_u, schnakenberg_react_v]
  omega
"""^^pk:lean4 ;
    skos:notation "∂u/∂t = γ(a - u + u^2 v) + ∇^2 u,   ∂v/∂t = γ(b - u^2 v) + d ∇^2 v,   (u_*, v_*) = (a + b, b / (a + b)^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_react_u" ;
    pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_equilibrium_zero_flux" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg (1979) Exact Hopf Bifurcation Curve & Positive Jacobian Determinant Law" ;
    dct:description "Separates stable steady states from autonomous Poincaré-Bendixson limit-cycle oscillations across b - a = (a + b)^3 while proving det(J_0) = (a + b)^2 > 0 excludes fold bifurcations | Variables: J_0: 2x2 reaction Jacobian at (u_*, v_*); s = a + b: equilibrium activator concentration; tr(J_0): Jacobian trace; det(J_0): Jacobian determinant" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81(3):389-400 Eqs. (21)-(24)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L198-L265>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L46-L56> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_scaled_trace (a b s_cubed : Int) : Int := (b - a) - s_cubed
def schnakenberg_jacobian_det (n : Nat) : Nat := n * n + 2 * n + 1
theorem schnakenberg_hopf_trace_and_det_pos (a s_cubed : Int) (n : Nat) :
    schnakenberg_scaled_trace a (a + s_cubed) s_cubed = 0 ∧
    schnakenberg_jacobian_det n ≥ 1 := by
  simp [schnakenberg_scaled_trace, schnakenberg_jacobian_det]
"""^^pk:lean4 ;
    skos:notation "tr(J_0) = (b - a - (a + b)^3) / (a + b) = 0  <=>  b - a = (a + b)^3,   det(J_0) = (a + b)^2 > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_scaled_trace" ;
    pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_hopf_trace_and_det_pos" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg-Turing Differential-Diffusion Dispersion & Critical Ratio Law" ;
    dct:description "Proves equal diffusion (d = 1) is unconditionally stable at (a,b) = (0.1, 0.9) whereas d > d_c ≈ 8.5676 drives det(J(k^2)) < 0 and amplifies periodic Turing spots/stripes | Variables: q = k^2: squared spatial wavenumber; d = D_v/D_u: substrate-to-activator diffusivity ratio; d_c: critical Turing diffusivity ratio" ;
    dct:source "Schnakenberg (1979) J. Theor. Biol. 81:389-400 & Turing (1952) Phil. Trans. R. Soc. B 237:37-72" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L268-L355>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean#L68-L81> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def schnakenberg_equal_diff_det (q : Nat) : Nat := q * q + 2 * q + 100
def schnakenberg_fourier_det (d q : Int) : Int := d * q * q - (8 * d - 10) * q + 100
theorem schnakenberg_turing_instability_and_equal_diff (q : Nat) :
    schnakenberg_equal_diff_det q ≥ 100 ∧
    schnakenberg_fourier_det 1 0 = 100 ∧
    schnakenberg_fourier_det 9 3 = -5 ∧
    schnakenberg_fourier_det 18 4 = -148 := by
  refine ⟨?_, by decide, by decide, by decide⟩
  simp [schnakenberg_equal_diff_det]
"""^^pk:lean4 ;
    skos:notation "det(J(k^2)) = d k^4 - γ (d (b-a)/(a+b) - (a+b)^2) k^2 + γ^2 (a+b)^2,   d_c(a,b) = (((a+b)^2 + (a+b)√(2b(a+b))) / (b-a))^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Glycolytic Oscillations (Tri-Molecular Cubic Autocatalysis)" ;
    pk:leanDeclaration "MathOfBiology.Loop_002.schnakenberg_fourier_det" ;
    pk:leanTheorem "MathOfBiology.Loop_002.schnakenberg_turing_instability_and_equal_diff" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


<https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> a pk:Claim ;
    rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis (Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation))",
        "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis faithfully reproduces Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-1>,
        <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-2>,
        <https://w3id.org/probknow/resource/math-law/schnakenberg-limit-cycle-turing-3> ;
    dct:description "The simulation script(s) 1979-schnakenberg-limit-cycle-turing.py implement the cited source model as published and produce forms that match real Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 40.1/100, audit 2026-10-19-limit-cycle-turing-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py> ;
    schema:about "Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py; output: docs/media/limit_cycle_turing_comparison.png; organism: Dictyostelium discoideum (cellular slime mold cAMP oscillations & fruiting body aggregation); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: e7a48d2f9b6eadc84256e32af6d90edcc5a9823751407e82e8ce1b2293da2e1e; artifact_sha256: eff14c72d4713c7707d9f6301a20de8ca565adc8bea363ab4b3e4e2f554abd6d; input_dataset_sha256: {datasets/limit_cycle_turing/dictyostelium_specimen.jpg=e2d2b739211bda97..., datasets/limit_cycle_turing/limit_cycle_turing_reference.json=d46a92b16200c35b..., datasets/limit_cycle_turing/scout_manifest.json=e71deffb9f317a88...}" ;
    pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/253540a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1371/journal.pcbi.1004367> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity>,

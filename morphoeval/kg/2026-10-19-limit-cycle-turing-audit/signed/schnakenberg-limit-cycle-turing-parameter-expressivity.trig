sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Parameter expressivity: 35/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Hardcodes a single parameter point (a=0.10, b=0.90, gamma=180, d=18.0) on a 64x64 grid (L41-66) without exposing CLI flags (--a, --b, --gamma, --d, --N, --steps, --dt, --seed) and without sweeping across the Hopf boundary b - a = (a+b)^3 or Turing threshold d_c = 8.5676." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L137–L146: CLI exposes only --self-test, --skip-gif, --no-show <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L137-L146>",
            "1979-schnakenberg-limit-cycle-turing.py L41–L66: single hardcoded regime without multi-regime phase diagram or diffusivity sweep <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L41-L66>" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Model fidelity to source: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Schnakenberg's (1979) cubic autocatalytic PDE du/dt = gamma*(a - u + u^2*v) + Lap(u), dv/dt = gamma*(b - u^2*v) + d*Lap(v) and homogeneous equilibrium (u_*, v_*) = (a+b, b/(a+b)^2) (L26-66). However, Schnakenberg's central Hopf bifurcation locus b - a = (a+b)^3, Poincare-Bendixson limit-cycle ODE oscillator, spatial dispersion relation sigma(k^2), critical diffusivity ratio d_c(a,b), and equal-diffusion negative control (d=1) are all absent in v1." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L26–L66: equilibrium, Jacobian, and single-regime 2D finite-difference solver without Hopf limit cycle or dispersion relation <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L26-L66>" ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Reproducibility package: 64/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Uses deterministic `np.random.default_rng(1979)` and includes `--self-test` and `--skip-gif` (L129-146), but `self_test()` checks only 3 basic assertions without verifying two-run bitwise determinism, Hopf trace vanishing, dispersion thresholds, or dataset SHA-256 integrity." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L129–L135: 3-line self_test without bitwise determinism or dataset hash checks <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L129-L135>" ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


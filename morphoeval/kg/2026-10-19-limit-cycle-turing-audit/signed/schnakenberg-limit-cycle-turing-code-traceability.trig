sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-schnakenberg-limit-cycle-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-schnakenberg-limit-cycle-turing-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg (1979) tri-molecular limit-cycle & Turing reaction-diffusion morphogenesis — Code-to-model traceability: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Basic docstrings identify the equilibrium and Jacobian formulas (L26-39), but lack detailed equation-by-equation mappings to Schnakenberg (1979) Eqs. (15)-(24), Turing (1952) dispersion theory, and the 3 Lean 4 theorems in `morphoeval/lean/loops/Loop_002_limit_cycle_turing.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1979-schnakenberg-limit-cycle-turing.py L26–L66: minimal docstrings without explicit Lean 4 theorem or equation cross-references <https://github.com/fractastical/morpholib/blob/8871db0/1979-schnakenberg-limit-cycle-turing.py#L26-L66>" ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;

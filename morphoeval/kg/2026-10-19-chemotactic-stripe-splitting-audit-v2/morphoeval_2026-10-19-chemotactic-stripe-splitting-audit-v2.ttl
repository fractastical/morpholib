<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/painter-chemotactic-stripe-splitting-1>,
        <https://w3id.org/probknow/resource/math-law/painter-chemotactic-stripe-splitting-2>,
        <https://w3id.org/probknow/resource/math-law/painter-chemotactic-stripe-splitting-3> .

<https://w3id.org/probknow/resource/math-law/painter-chemotactic-stripe-splitting-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Keller-Segel-Painter Homogeneous Steady-State & Pure-RD Stability (chi = 0)" ;
    dct:description "Proves that the homogeneous equilibrium (n^*, c^*) is always stable to uniform perturbations (q = 0) and that without chemotaxis (χ = 0) no spatial pattern instability can arise | Variables: n_0: carrying capacity; c^* = α n_0 / (γ(1 + β n_0)): steady-state chemoattractant; r: logistic growth rate; γ: chemoattractant decay; D_n, D_c: cell and chemoattractant diffusivities; q = k^2: squared wavenumber" ;
    dct:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Eqs. (1)-(5); Keller & Segel (1970) J. Theor. Biol. 26(3):399-415" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L118-L185>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L19-L48> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def ksp_trace (r gamma D_n D_c q : Int) : Int := -(r + gamma) - (D_n + D_c) * q
def ksp_det (r gamma D_n D_c chi_eff q : Int) : Int :=
  (D_n * D_c) * (q * q) + (r * D_c + gamma * D_n - chi_eff) * q + r * gamma
theorem ksp_uniform_and_no_chemotaxis_stability (r gamma D_n D_c chi_eff q : Int)
    (hr : r ≥ 1) (hg : gamma ≥ 1) (hq : q ≥ 0) :
    ksp_trace r gamma D_n D_c 0 ≤ -2 ∧
    ksp_det 1 4 1 1 chi_eff 0 = 4 ∧
    ksp_det 1 4 1 1 0 q ≥ 4 := by
  unfold ksp_trace ksp_det
  have hq2 : q * q ≥ 0 := Int.mul_nonneg hq hq; omega
"""^^pk:lean4 ;
    skos:notation "tr M(0) = -(r + γ) < 0 ∧ det M(0) = r γ > 0;  χ = 0 ⟹ det M(q) = D_n D_c q^2 + (r D_c + γ D_n) q + r γ > 0 ∀ q ≥ 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF02458621>,
        <https://doi.org/10.1016/0022-5193(70)90092-5>,
        <https://doi.org/10.1016/j.physd.2010.09.011>,
        <https://doi.org/10.1073/pnas.96.10.5549> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
    pk:leanDeclaration "MathOfBiology.Loop_005.ksp_det" ;
    pk:leanTheorem "MathOfBiology.Loop_005.ksp_uniform_and_no_chemotaxis_stability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/painter-chemotactic-stripe-splitting-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Painter, Maini & Othmer (1999) Equal-Diffusivity Chemotactic Instability Threshold (χ > χ_c at D_n = D_c)" ;
    dct:description "Proves that unlike pure Turing reaction-diffusion systems (which require D_u ≠ D_v), chemotactic cross-diffusion -∇·(n χ ∇c) destabilizes the homogeneous state at equal diffusivities D_n = D_c = 1 whenever χ > χ_c = 4.5 (χ_eff > 9) | Variables: χ: chemotactic sensitivity; χ_c = (√(r D_c) + √(γ D_n))^2 / (n_0 s^*): critical chemotactic threshold; s^* = α / (1 + β n_0)^2: linearized secretion slope; k_c: critical wavenumber" ;
    dct:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Section 'Pattern Formation in a Chemotaxis Model' Eqs. (3)-(6)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L135-L210>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L55-L71> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """theorem painter_1999_equal_diffusivity_chemotactic_instability :
    ksp_det 1 4 1 1 8 2 = 2 ∧
    ksp_det 1 4 1 1 9 2 = 0 ∧
    ksp_det 1 4 1 1 12 2 = -6 := by
  unfold ksp_det; omega
"""^^pk:lean4 ;
    skos:notation "D_n = D_c = D ∧ n_0 χ(c^*) s^* > (√(r D_c) + √(γ D_n))^2 ⟹ det M(k_c^2) < 0 at k_c^2 = √(r γ / (D_n D_c))" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF02458621>,
        <https://doi.org/10.1016/0022-5193(70)90092-5>,
        <https://doi.org/10.1016/j.physd.2010.09.011>,
        <https://doi.org/10.1073/pnas.96.10.5549> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
    pk:leanDeclaration "MathOfBiology.Loop_005.ksp_det" ;
    pk:leanTheorem "MathOfBiology.Loop_005.painter_1999_equal_diffusivity_chemotactic_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/painter-chemotactic-stripe-splitting-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Painter, Maini & Othmer (1999) Domain-Growth Wavenumber Halving & Stripe-Splitting Cascade" ;
    dct:description "Proves why uniform domain growth stretches existing spatial modes below q_min and sequentially recruits frequency-doubled modes m = 1 → 2 → 4 → 8, driving chemotactic stripe splitting | Variables: s = L(t)/L_0: domain dilation factor; m: spatial mode number; [q_min, q_max]: unstable chemotactic wavenumber band around q_c" ;
    dct:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Figs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L215-L340>,
        <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_005_chemotactic_stripe_splitting.lean#L78-L98> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def in_chemotactic_band (q_min q_max m s : Nat) : Bool :=
  decide (q_min * s * s ≤ m * m ∧ m * m ≤ q_max * s * s)
theorem painter_1999_domain_growth_stripe_splitting_cascade :
    in_chemotactic_band 1 3 1 1 = true ∧
    in_chemotactic_band 1 3 2 1 = false ∧
    in_chemotactic_band 1 3 1 2 = false ∧
    in_chemotactic_band 1 3 2 2 = true ∧
    in_chemotactic_band 1 3 2 4 = false ∧
    in_chemotactic_band 1 3 4 4 = true := by decide
"""^^pk:lean4 ;
    skos:notation "q_m(s) = m^2 / s^2 ∈ [q_min, q_max] ⟺ q_min s^2 ≤ m^2 ≤ q_max s^2;  s: 1 → 2 → 4 ⟹ m_unstable: 1 → 2 → 4" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF02458621>,
        <https://doi.org/10.1016/0022-5193(70)90092-5>,
        <https://doi.org/10.1016/j.physd.2010.09.011>,
        <https://doi.org/10.1073/pnas.96.10.5549> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Chemotaxis-Reaction-Diffusion" ;
    pk:leanDeclaration "MathOfBiology.Loop_005.in_chemotactic_band" ;
    pk:leanTheorem "MathOfBiology.Loop_005.painter_1999_domain_growth_stripe_splitting_cascade" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


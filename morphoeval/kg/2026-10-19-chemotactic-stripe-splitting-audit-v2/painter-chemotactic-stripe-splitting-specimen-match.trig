sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) chemotactic stripe splitting & stripe-spot selection — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 Myxococcus xanthus specimen (`datasets/chemotactic_stripe_splitting/chemotactic_pattern_specimen.jpg`) and segments both the 4 yellow fruiting-body spot aggregates (mean diameter 131.68 um) and the right-hand chemotactic rippling stripe ridges (`segment_chemotactic_specimen`, L425-505), calibrating the 500 um = 125 px scale bar (4.0 um/px) to measure a mean rippling wavelength of 74.10 um (18.5249 +/- 6.4079 px across n=362 inter-ridge spacings, CV = 0.3459) and phase-aligned Keller-Segel waveform correlation (Panels E-F)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L425–L505" ;
        dct:description "Automated CV segmentation of 500 um scale bar, 4 fruiting-body spot aggregates, and 362 rippling stripe spacings" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L425-L505> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/chemotactic_stripe_splitting_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure including dispersion relation, growing-domain kymograph, 5-regime cascade, 2D stripes vs spots, specimen segmentation, and waveform fit — docs/media/chemotactic_stripe_splitting_comparison.png: rendered output of 1999-painter-chemotactic-stripe-splitting.py at 317bc3c, image/png, 900896 B, 2310×1372 px, artifact_sha256 c37361ad1d68ce676ba2e1cd9c205a97927c6ad87e8d8ed4de517b9bcb4418a7 (sha256 c37361ad1d68ce676ba2e1cd9c205a97927c6ad87e8d8ed4de517b9bcb4418a7), spec_fingerprint 91fb31037b136e4adc1e8bdd7b6c8097f7eaab327a03b1266cf7114f22d5f57f" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


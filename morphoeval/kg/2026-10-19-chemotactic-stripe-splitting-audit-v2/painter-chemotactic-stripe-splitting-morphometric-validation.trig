}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) chemotactic stripe splitting & stripe-spot selection — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L510-578): equal-diffusivity critical chemotactic threshold chi_c = 4.5, simulated 1D PDE stripe wavelength 4.4429 vs analytical 4.4429 (0.00% error, CV = 0.0078), supercritical vs subcritical stripe peak delta (4 vs 0 peaks; 5-regime RMSE = 0.0000, Pearson r = 1.0000), 2D spot-to-stripe component ratio, and calibrated Myxococcus xanthus rippling stripe wavelength 74.10 um (18.52 +/- 6.41 px, CV = 0.3459)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-equal-diffusivity-critical-chemotactic-sensitivity-chi-c-d-n-d-c-1-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-myxococcus-xanthus-specimen-chemotactic-rippling-stripe-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-simulated-1d-keller-segel-painter-chemotactic-stripe-wavelength-vs-analytical-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-supercritical-chi-6-0-vs-subcritical-negative-control-chi-3-0-chi-c-stripe-peak-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D chemotactic spot-vs-stripe connected component ratio = 3.5 N_spots / N_stripes ratio" ;
        dct:description "spot components = 21, stripe components = 6" ;
        schema:measurementTechnique "2D Keller-Segel-Painter PDE spot regime (21 isolated droplet aggregates) vs labyrinthine stripe regime (6 connected ridges)" ;
        schema:name "2D chemotactic spot-vs-stripe connected component ratio" ;
        schema:unitText "N_spots / N_stripes ratio" ;
        schema:value "3.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-2d-chemotactic-spot-vs-stripe-connected-component-ratio-reference> a schema:PropertyValue ;
        dct:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Fig. 4 (quadratic spot droplets vs cubic labyrinthine stripes)" ;
        schema:value "2.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-equal-diffusivity-critical-chemotactic-sensitivity-chi-c-d-n-d-c-1-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusivity critical chemotactic sensitivity chi_c (D_n = D_c = 1.0) = 4.5 dimensionless" ;
        dct:description "at chi=6.0 > chi_c=4.5, unstable band k^2 in [0.6277, 6.3723], lambda_max(k_c^2)=0.6235" ;
        schema:measurementTechnique "Painter, Maini & Othmer (1999) linear stability threshold chi_c = (sqrt(r*D_c)+sqrt(gamma*D_n))^2 / (n_0*s*) at D_n=D_c=1 (det M(k_c^2)=-6.00 at chi=6.0)" ;
        schema:name "equal-diffusivity critical chemotactic sensitivity chi_c (D_n = D_c = 1.0)" ;
        schema:unitText "dimensionless" ;
        schema:value "4.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-equal-diffusivity-critical-chemotactic-sensitivity-chi-c-d-n-d-c-1-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-equal-diffusivity-critical-chemotactic-sensitivity-chi-c-d-n-d-c-1-0-reference> a schema:PropertyValue ;
        dct:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Eqs. (3)-(6)" ;
        schema:value "4.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-myxococcus-xanthus-specimen-chemotactic-rippling-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Myxococcus xanthus specimen chemotactic rippling stripe wavelength = 74.1 um" ;
        dct:description "detected 4 yellow fruiting-body spot aggregates (mean diameter 263.2 um); transect waveform correlation r = 0.5083 (p=6.82e-12)" ;
        schema:measurementTechnique "2D DoG bandpass ridge peak segmentation across right-hand rippling zone of chemotactic_pattern_specimen.jpg (n=362 inter-ridge spacings, mean=18.52 px, std=6.41 px, CV=0.3459, calibrated via 500 um = 125 px scale bar)" ;
        schema:name "Myxococcus xanthus specimen chemotactic rippling stripe wavelength" ;
        schema:unitText "um" ;
        schema:value "74.1" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-myxococcus-xanthus-specimen-chemotactic-rippling-stripe-wavelength-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-myxococcus-xanthus-specimen-chemotactic-rippling-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY-SA 4.0 Myxococcus xanthus specimen (datasets/chemotactic_stripe_splitting/chemotactic_pattern_specimen.jpg)" ;
        schema:value "74.1" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-simulated-1d-keller-segel-painter-chemotactic-stripe-wavelength-vs-analytical-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated 1D Keller-Segel-Painter chemotactic stripe wavelength vs analytical lambda_c = 4.4429 dimensionless length" ;
        dct:description "relative wavelength error = 0.0000%, spacing CV = 0.0000" ;
        schema:measurementTechnique "1D IMEX pseudospectral Keller-Segel-Painter PDE solver on L = 4*lambda_c (N=4 peaks, CV=0.0000)" ;
        schema:name "simulated 1D Keller-Segel-Painter chemotactic stripe wavelength vs analytical lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "4.4429" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-simulated-1d-keller-segel-painter-chemotactic-stripe-wavelength-vs-analytical-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-simulated-1d-keller-segel-painter-chemotactic-stripe-wavelength-vs-analytical-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 (k_c^2 = sqrt(r*gamma/(D_n*D_c)) = 2.0 => lambda_c = pi*sqrt(2) = 4.4429)" ;
        schema:value "4.4429" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-supercritical-chi-6-0-vs-subcritical-negative-control-chi-3-0-chi-c-stripe-peak-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "supercritical (chi=6.0) vs subcritical negative control (chi=3.0 < chi_c) stripe peak delta = 4.0 stripe peaks (supercritical vs subcritical control)" ;
        dct:description "across 5 domain-growth & control regimes (s=1,2,4,8 and chi=3.0), peak count RMSE = 0.0000 (Pearson r = 1.0000, p=0.00e+00)" ;
        schema:measurementTechnique "supercritical chemotaxis chi=6.0 (N=4 stripes, amp=1.0225) vs subcritical ablation control chi=3.0 < chi_c=4.5 (N=0 stripes, amp=0.0000)" ;
        schema:name "supercritical (chi=6.0) vs subcritical negative control (chi=3.0 < chi_c) stripe peak delta" ;
        schema:unitText "stripe peaks (supercritical vs subcritical control)" ;
        schema:value "4.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-supercritical-chi-6-0-vs-subcritical-negative-control-chi-3-0-chi-c-stripe-peak-delta-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-supercritical-chi-6-0-vs-subcritical-negative-control-chi-3-0-chi-c-stripe-peak-delta-reference> a schema:PropertyValue ;
        dct:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Figs. 1-2" ;
        schema:value "4.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L510–L578" ;
        dct:description "5 quantitative MorphoEval measurements with analytical and empirical references, CV, Pearson r, and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L510-L578> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ocko-termite-mound-convective-chimneys> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "King, Ocko & Mahadevan (2015) PNAS, Ocko et al. (2017) PNAS & Ocko, Heyde & Mahadevan (2019) PNAS solar-powered diurnal thermosiphon ventilation and convective pheromone morphogenesis of cathedral termite mounds — Morphological realism / specimen match: 35/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Although `datasets/termite_mound_convective_chimneys/macrotermes_cathedral_mound_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or extracts mound silhouette aspect ratio `H/W`, spire taper half-angle, or vertical surface flute ridge count from the biological specimen photograph." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2015-ocko-termite-mound-convective-chimneys.py L77–L155: Renders 4 analytic plots without loading or segmenting macrotermes_cathedral_mound_specimen.jpg <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L77-L155>",
            "docs/media/termite_mound_convective_chimneys_comparison.png (generated output, not in repo): 4-panel v1 plot omits cathedral mound specimen segmentation, latitude spire tilt, and species controls — docs/media/termite_mound_convective_chimneys_comparison.png: rendered output of 2015-ocko-termite-mound-convective-chimneys.py at e93f00e, image/png, 212741 B, 1680×1190 px, artifact_sha256 a6502606cb4e064bfdfd1ac544059bc39751b3430401c14128e2f98632b3b5ce (sha256 a6502606cb4e064bfdfd1ac544059bc39751b3430401c14128e2f98632b3b5ce), spec_fingerprint d09fb37c4086797405dbf184a42b7af11e3ae9291d9bd6946a94bdc2be0204df" ;
        pk:hasScore "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 097 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


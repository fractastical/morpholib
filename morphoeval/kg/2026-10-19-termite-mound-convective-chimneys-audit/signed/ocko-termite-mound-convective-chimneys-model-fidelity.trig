sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ocko-termite-mound-convective-chimneys> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-ocko-termite-mound-convective-chimneys.py L34–L74" ;
        dcterms:description "Algebraic thermosiphon velocity, Peclet aspect ratio, and Taylor-Aris dispersion formulas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L34-L74> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "King, Ocko & Mahadevan (2015) PNAS, Ocko et al. (2017) PNAS & Ocko, Heyde & Mahadevan (2019) PNAS solar-powered diurnal thermosiphon ventilation and convective pheromone morphogenesis of cathedral termite mounds — Model fidelity to source: 58/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements algebraic formulas for Boussinesq thermosiphon velocity, convective Péclet aspect ratio scaling, and Taylor–Aris CO₂ dispersion (L34-74), backed by 3 Lean 4 theorems in `Loop_097_termite_mound_convective_chimneys.lean`. However, it does not integrate the coupled 24-hour diurnal solar-thermal ODE/PDE for flute-chimney temperature and nest CO₂ clearance or the Ocko et al. (2019) moving-boundary pheromone advection-diffusion-deposition solver." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2015-ocko-termite-mound-convective-chimneys.py L77–L96: Evaluates static table lookup rather than solving coupled diurnal thermal-CO2 and moving-boundary pheromone PDEs <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L77-L96>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-model-fidelity-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 097 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ocko-termite-mound-convective-chimneys> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "King, Ocko & Mahadevan (2015) PNAS, Ocko et al. (2017) PNAS & Ocko, Heyde & Mahadevan (2019) PNAS solar-powered diurnal thermosiphon ventilation and convective pheromone morphogenesis of cathedral termite mounds — Morphometric validation: 53/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L188-200) reports only 4 scalar values without Pearson r, p-value, RMSE, diurnal velocity and CO₂ correlations, convective Péclet `H/W` correlation, equatorward latitude tilt correlation, or empirical specimen CV silhouette metrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2015-ocko-termite-mound-convective-chimneys.py L188–L200: Only 4 scalar baseline numbers without statistical tests, negative controls, or specimen segmentation <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L188-L200>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-isothermal-pure-diffusion-dome-aspect-ratio-h-w-pe-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-midday-peak-central-chimney-downdraft-velocity-u-chimney-dt-6-8-k>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-midday-peak-exterior-flute-updraft-velocity-u-flute-dt-6-8-k>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-wild-type-macrotermes-cathedral-mound-aspect-ratio-h-w-pe-3-2> ;
        pk:hasScore "0.53"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-isothermal-pure-diffusion-dome-aspect-ratio-h-w-pe-0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Isothermal pure-diffusion dome aspect ratio H/W (Pe = 0.0) = 0.5 ratio" ;
        dcterms:description "Hemispherical dome H = R" ;
        schema:measurementTechnique "Isothermal baseline aspect ratio H/W at Pe = 0.0 (H/R = 1.0 hemispherical dome)" ;
        schema:name "Isothermal pure-diffusion dome aspect ratio H/W (Pe = 0.0)" ;
        schema:unitText "ratio" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-isothermal-pure-diffusion-dome-aspect-ratio-h-w-pe-0-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-isothermal-pure-diffusion-dome-aspect-ratio-h-w-pe-0-0-reference> a schema:PropertyValue ;
        dcterms:source "Ocko, Heyde & Mahadevan (2019) PNAS 116:3379-3384 Pe = 0 limit" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-midday-peak-central-chimney-downdraft-velocity-u-chimney-dt-6-8-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Midday peak central chimney downdraft velocity u_chimney (dT = +6.8 K) = -3.57 cm/s" ;
        dcterms:description "Satisfies A_c u_c + A_f u_f = 0" ;
        schema:measurementTechnique "Mass-conserving return velocity u_chimney = -(A_f/A_c) * u_flute at A_f/A_c = 1.25" ;
        schema:name "Midday peak central chimney downdraft velocity u_chimney (dT = +6.8 K)" ;
        schema:unitText "cm/s" ;
        schema:value "-3.57" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-midday-peak-central-chimney-downdraft-velocity-u-chimney-dt-6-8-k-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-midday-peak-central-chimney-downdraft-velocity-u-chimney-dt-6-8-k-reference> a schema:PropertyValue ;
        dcterms:source "Ocko et al. (2017) PNAS 114:10620-10624 & King et al. (2015) PNAS 112:11589-11593" ;
        schema:value "-3.57" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-midday-peak-exterior-flute-updraft-velocity-u-flute-dt-6-8-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Midday peak exterior flute updraft velocity u_flute (dT = +6.8 K) = 2.856 cm/s" ;
        dcterms:description "Baseline algebraic scaling without thermal inertia lag" ;
        schema:measurementTechnique "Analytic Boussinesq Darcy-Brinkman buoyancy velocity u_flute = K_buoy * dT at midday dT = 6.8 K" ;
        schema:name "Midday peak exterior flute updraft velocity u_flute (dT = +6.8 K)" ;
        schema:unitText "cm/s" ;
        schema:value "2.856" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-midday-peak-exterior-flute-updraft-velocity-u-flute-dt-6-8-k-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-midday-peak-exterior-flute-updraft-velocity-u-flute-dt-6-8-k-reference> a schema:PropertyValue ;
        dcterms:source "Ocko et al. (2017) PNAS 114:10620-10624 Fig. 2" ;
        schema:value "2.86" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-wild-type-macrotermes-cathedral-mound-aspect-ratio-h-w-pe-3-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type Macrotermes cathedral mound aspect ratio H/W (Pe = 3.2) = 1.9496 ratio" ;
        dcterms:description "H/R = 3.90 conical spire" ;
        schema:measurementTechnique "Analytic convective Peclet aspect ratio H/W = (1 + eta_Pe * Pe) / 2 at Pe = 3.2" ;
        schema:name "Wild-type Macrotermes cathedral mound aspect ratio H/W (Pe = 3.2)" ;
        schema:unitText "ratio" ;
        schema:value "1.9496" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-wild-type-macrotermes-cathedral-mound-aspect-ratio-h-w-pe-3-2-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-ocko-termite-mound-convective-chimneys-measurement-wild-type-macrotermes-cathedral-mound-aspect-ratio-h-w-pe-3-2-reference> a schema:PropertyValue ;
        dcterms:source "Ocko, Heyde & Mahadevan (2019) PNAS 116:3379-3384 Fig. 3" ;
        schema:value "1.95" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 097 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


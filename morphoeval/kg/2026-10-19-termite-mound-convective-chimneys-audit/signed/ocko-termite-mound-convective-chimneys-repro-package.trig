sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ocko-termite-mound-convective-chimneys> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "King, Ocko & Mahadevan (2015) PNAS, Ocko et al. (2017) PNAS & Ocko, Heyde & Mahadevan (2019) PNAS solar-powered diurnal thermosiphon ventilation and convective pheromone morphogenesis of cathedral termite mounds — Reproducibility package: 64/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Provides `--self-test` (`L203-215`) checking basic velocity sign and Péclet ratio, but lacks SHA-256 asset verification, PDE mass-conservation assertions, latitude tilt checks, and two-run bitwise determinism verification." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2015-ocko-termite-mound-convective-chimneys.py L203–L215: Minimal 3-assertion self_test() without SHA-256 or PDE determinism checks <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L203-L215>" ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 097 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


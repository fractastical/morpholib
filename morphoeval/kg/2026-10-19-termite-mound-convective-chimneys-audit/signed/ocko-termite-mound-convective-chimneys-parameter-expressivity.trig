sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-ocko-termite-mound-convective-chimneys> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "King, Ocko & Mahadevan (2015) PNAS, Ocko et al. (2017) PNAS & Ocko, Heyde & Mahadevan (2019) PNAS solar-powered diurnal thermosiphon ventilation and convective pheromone morphogenesis of cathedral termite mounds — Parameter expressivity: 51/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates the 9-point diurnal temperature table (L77-96), but omits the 7-point convective Péclet morphogenesis sweep `Pe in [0.0, 4.2]`, omits the 6-point geographic latitude equatorward spire tilt sweep `|phi_lat| in [0.0, 24.0] deg S`, omits the *Macrotermes* vs *Odontotermes* vs shaded isothermal dome controls, and exposes no CLI parameter overrides." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2015-ocko-termite-mound-convective-chimneys.py L77–L96: Single diurnal table evaluation without Peclet sweep, latitude tilt sweep, species/ablation controls, or CLI overrides <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L77-L96>" ;
        pk:hasScore "0.51"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 097 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


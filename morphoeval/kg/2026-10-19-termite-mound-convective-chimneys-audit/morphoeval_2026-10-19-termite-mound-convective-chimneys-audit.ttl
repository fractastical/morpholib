<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/ocko-termite-mound-convective-chimneys-1>,
        <https://w3id.org/probknow/resource/math-law/ocko-termite-mound-convective-chimneys-2>,
        <https://w3id.org/probknow/resource/math-law/ocko-termite-mound-convective-chimneys-3> .

<https://w3id.org/probknow/resource/math-law/ocko-termite-mound-convective-chimneys-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Diurnal Buoyancy Thermosiphon Flow Reversal & Mass Continuity Law" ;
    dct:description "Proves mass conservation A_c u_c + A_f u_f = 0 across the flute–chimney thermosiphon loop, daytime flute updraft / chimney downdraft (dT > 0), nocturnal flow reversal (dT -> -dT), and isothermal stagnation (dT = 0) | Variables: K_buoy: Boussinesq Darcy–Brinkman buoyancy conductance; dT = T_flute - T_chimney: radial temperature difference between exterior flutes and central chimney; Q_flute, Q_chimney: volumetric airflow fluxes" ;
    dct:source "King, Ocko & Mahadevan (2015) PNAS 112:11589-11593; Ocko et al. (2017) PNAS 114:10620-10624 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L110-L240>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean#L27-L56> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def thermosiphon_flute_flux (K_buoy dT : Int) : Int :=
  K_buoy * dT
def thermosiphon_chimney_flux (K_buoy dT : Int) : Int :=
  -(K_buoy * dT)
theorem diurnal_thermosiphon_reversal_and_continuity (K_buoy dT : Int)
    (hK : K_buoy > 0) (hdT : dT > 0) :
    thermosiphon_flute_flux K_buoy 0 = 0 ∧
    thermosiphon_flute_flux K_buoy dT + thermosiphon_chimney_flux K_buoy dT = 0 ∧
    thermosiphon_flute_flux K_buoy (-dT) = -thermosiphon_flute_flux K_buoy dT ∧
    thermosiphon_flute_flux K_buoy dT > 0 ∧
    thermosiphon_chimney_flux K_buoy dT < 0
"""^^pk:lean4 ;
    skos:notation "Q_flute(ΔT) = K_buoy ΔT,  Q_chimney(ΔT) = -Q_flute(ΔT)  ⇒  Q_flute + Q_chimney = 0,  Q_flute(-ΔT) = -Q_flute(ΔT)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00114-002-0401-4>,
        <https://doi.org/10.1016/j.csbj.2020.08.012>,
        <https://doi.org/10.1073/pnas.1423242112>,
        <https://doi.org/10.1073/pnas.1713534114>,
        <https://doi.org/10.1073/pnas.1818759116> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Diurnal Buoyancy Thermosiphon Flow Q_flute = -Q_chimney ∝ g β_T (T_flute - T_chimney) + Advection–Diffusion of Cement Pheromone / CO₂ (∂_t c + u · ∇c = D ∇²c - γ c) & Threshold Soil Deposition Sculpting Cathedral Spires, Surface Flutes, and Central Chimney" ;
    pk:leanDeclaration "MathOfBiology.Loop_097.thermosiphon_flute_flux" ;
    pk:leanTheorem "MathOfBiology.Loop_097.diurnal_thermosiphon_reversal_and_continuity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/ocko-termite-mound-convective-chimneys-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Convective Péclet Apical Pheromone Amplification & Spire Aspect Ratio Law" ;
    dct:description "Proves that isothermal pure-diffusion growth (Pe = 0) yields a hemispherical dome (H/R = 1) whereas upward convective pheromone advection (Pe > 0) strictly elongates mound height and aspect ratio H/R into a cathedral spire | Variables: R: mound basal radius; Pe = u_0 H_0 / D_c: convective Péclet number of pheromone advection; eta: apical elongation coefficient; H: equilibrium mound height" ;
    dct:source "Ocko, Heyde & Mahadevan (2019) PNAS 116:3379-3384 Eqs. (1)-(8), Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L245-L385>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean#L68-L93> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def mound_height_milli (R eta Pe : Nat) : Nat :=
  R * (1000 + eta * Pe)
def hemispherical_dome_height_milli (R : Nat) : Nat :=
  R * 1000
theorem convective_peclet_spire_elongation (R eta Pe1 Pe2 : Nat)
    (hR : R > 0) (heta : eta > 0) (hPe : Pe1 < Pe2) :
    mound_height_milli R eta 0 = hemispherical_dome_height_milli R ∧
    mound_height_milli R eta Pe2 > hemispherical_dome_height_milli R ∧
    mound_height_milli R eta Pe1 < mound_height_milli R eta Pe2
"""^^pk:lean4 ;
    skos:notation "H / R = 1 + η_Pe Pe  (Pe = u_0 H_0 / D_c)  ⇒  H(Pe = 0) = R,  Pe_1 < Pe_2 ⇒ H(Pe_1) < H(Pe_2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00114-002-0401-4>,
        <https://doi.org/10.1016/j.csbj.2020.08.012>,
        <https://doi.org/10.1073/pnas.1423242112>,
        <https://doi.org/10.1073/pnas.1713534114>,
        <https://doi.org/10.1073/pnas.1818759116> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Diurnal Buoyancy Thermosiphon Flow Q_flute = -Q_chimney ∝ g β_T (T_flute - T_chimney) + Advection–Diffusion of Cement Pheromone / CO₂ (∂_t c + u · ∇c = D ∇²c - γ c) & Threshold Soil Deposition Sculpting Cathedral Spires, Surface Flutes, and Central Chimney" ;
    pk:leanDeclaration "MathOfBiology.Loop_097.mound_height_milli" ;
    pk:leanTheorem "MathOfBiology.Loop_097.convective_peclet_spire_elongation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/ocko-termite-mound-convective-chimneys-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Taylor–Aris Oscillatory CO₂ Ventilation Dispersion Enhancement Law" ;
    dct:description "Proves that oscillatory diurnal thermosiphon flow rectifies CO₂ clearance via quadratic Taylor–Aris dispersion invariant under flow direction reversal and strictly exceeding stagnant molecular diffusion | Variables: D_0: stagnant molecular CO₂ diffusivity; alpha_TA: Taylor–Aris / pendelluft shear dispersion coefficient; u_amp: diurnal thermosiphon velocity amplitude" ;
    dct:source "King, Ocko & Mahadevan (2015) PNAS 112:11589-11593; Ocko et al. (2017) PNAS 114:10620-10624" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/e93f00e/2015-ocko-termite-mound-convective-chimneys.py#L140-L240>,
        <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_097_termite_mound_convective_chimneys.lean#L104-L125> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def effective_co2_dispersion (D0 alpha_TA u_amp : Int) : Int :=
  D0 + alpha_TA * (u_amp * u_amp)
theorem taylor_aris_oscillatory_ventilation_enhancement (D0 alpha_TA u_amp : Int)
    (hD0 : D0 > 0) (ha : alpha_TA > 0) (hu : u_amp > 0) :
    effective_co2_dispersion D0 alpha_TA 0 = D0 ∧
    effective_co2_dispersion D0 alpha_TA (-u_amp) = effective_co2_dispersion D0 alpha_TA u_amp ∧
    effective_co2_dispersion D0 alpha_TA u_amp > D0
"""^^pk:lean4 ;
    skos:notation "D_eff(u_amp) = D_0 + α_TA u_amp²  ⇒  D_eff(0) = D_0,  D_eff(-u_amp) = D_eff(u_amp),  D_eff(u_amp) > D_0 (∀ u_amp > 0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/s00114-002-0401-4>,

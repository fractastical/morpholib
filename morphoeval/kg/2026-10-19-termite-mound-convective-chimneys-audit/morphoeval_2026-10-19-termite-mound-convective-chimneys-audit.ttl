        <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-ocko-termite-mound-convective-chimneys-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-termite-mound-convective-chimneys-audit-ocko-termite-mound-convective-chimneys-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-termite-mound-convective-chimneys-audit-ocko-termite-mound-convective-chimneys-2>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-termite-mound-convective-chimneys-audit-ocko-termite-mound-convective-chimneys-3>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-termite-mound-convective-chimneys-audit-ocko-termite-mound-convective-chimneys-4> ;
    pk:hypothesisType "Coupled Diurnal Buoyancy Thermosiphon Flow Q_flute = -Q_chimney ∝ g β_T (T_flute - T_chimney) + Advection–Diffusion of Cement Pheromone / CO₂ (∂_t c + u · ∇c = D ∇²c - γ c) & Threshold Soil Deposition Sculpting Cathedral Spires, Surface Flutes, and Central Chimney" ;
    pk:weightOfEvidence 5.39e-01 .


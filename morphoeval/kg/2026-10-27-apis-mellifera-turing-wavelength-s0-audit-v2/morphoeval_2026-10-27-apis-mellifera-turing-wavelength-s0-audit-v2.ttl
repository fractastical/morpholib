<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Apis mellifera Schnakenberg wavelength at 11.2 µm (Pass 2 habitus composite) — Code-to-model traceability: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Each scored block is tied to Turing 1952, Schnakenberg 1979, or Murray 1981, and the Lean theorems restate the integer forms of the threshold, the ablation, the 12-mode window, the comb gap, and the monotone sweep." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .


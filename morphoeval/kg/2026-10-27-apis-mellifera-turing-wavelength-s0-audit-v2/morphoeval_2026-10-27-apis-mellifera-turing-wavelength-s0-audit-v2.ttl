<https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg diffusion-ratio threshold at d = 20" ;
    dct:description "Turing instability condition for the honeybee epidermal window | Variables: d = D_v / D_u = 20 for this 11.2 µm slot" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6fefd6a0/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py#L84-L97>,
        <https://github.com/fractastical/morpholib/blob/6fefd6a0/morphoeval/lean/loops/Loop_3115_apis_mellifera_turing_wavelength_s0.lean#L12-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(0.8 d - 1)^2 > 4 d, encoded as (4d - 5)^2 > 100 d" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00172140>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.asd.2011.06.004>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/jeb.156109> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3115.turingMarginSq" ;
    pk:leanTheorem "MathOfBiology.Loop_3115.honeybee_detail_scale_is_turing_unstable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Developmental predecessor of the patterned state at 0 Ma (no earlier chronospecies is in the 1/1 series) | Variables: d = 1" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6fefd6a0/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py#L253-L267>,
        <https://github.com/fractastical/morpholib/blob/6fefd6a0/morphoeval/lean/loops/Loop_3115_apis_mellifera_turing_wavelength_s0.lean#L22-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "at d = 1 the squared margin fails, and σ(k) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00172140>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.asd.2011.06.004>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/jeb.156109> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3115.turingMarginSq" ;
    pk:leanTheorem "MathOfBiology.Loop_3115.equal_diffusion_ablation_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Twelve wavelengths on the 134.4 µm window" ;
    dct:description "Mode count at the detail scale | Variables: L = 134.4 µm, λ_c = 11.2 µm" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6fefd6a0/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py#L98-L106>,
        <https://github.com/fractastical/morpholib/blob/6fefd6a0/morphoeval/lean/loops/Loop_3115_apis_mellifera_turing_wavelength_s0.lean#L28-L31> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = L / λ_c = 134.4 µm / 11.2 µm = 12" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00172140>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.asd.2011.06.004>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/jeb.156109> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3115.twelve_wavelengths_on_epidermal_window" ;
    pk:leanTheorem "MathOfBiology.Loop_3115.twelve_wavelengths_on_epidermal_window" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Wavenumber gap versus the comb-scale sibling" ;
    dct:description "Shows this slot is not the Camazine comb parameter set | Variables: λ_comb ≈ 5.2 mm, λ_detail = 11 µm" ;
    dct:source "Camazine 1991 DOI:10.1007/BF00172140, scale contrast only" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6fefd6a0/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py#L535-L570>,
        <https://github.com/fractastical/morpholib/blob/6fefd6a0/morphoeval/lean/loops/Loop_3115_apis_mellifera_turing_wavelength_s0.lean#L35-L37> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "5200 µm / 11 µm = 472 in natural division" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00172140>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.asd.2011.06.004>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/jeb.156109> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3115.detail_wavenumber_gap_versus_comb" ;
    pk:leanTheorem "MathOfBiology.Loop_3115.detail_wavenumber_gap_versus_comb" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-apis-mellifera-turing-wavelength-s0-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Wavelength falls as γ rises" ;
    dct:description "Parameter expressivity of the critical wavelength | Variables: γ" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/6fefd6a0/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py#L244-L251>,
        <https://github.com/fractastical/morpholib/blob/6fefd6a0/morphoeval/lean/loops/Loop_3115_apis_mellifera_turing_wavelength_s0.lean#L40-L49> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ(0.8) > λ(1.0) > λ(1.262) > λ(1.6), with the slot at 11.2 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00172140>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/j.asd.2011.06.004>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1242/jeb.156109> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3115.lambdaTenthsUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3115.wavelength_decreases_as_gamma_rises" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,

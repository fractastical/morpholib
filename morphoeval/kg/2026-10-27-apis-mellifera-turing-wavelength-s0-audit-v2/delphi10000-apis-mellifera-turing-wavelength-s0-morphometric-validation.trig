sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Apis mellifera Schnakenberg wavelength at 11.2 µm (Pass 2 habitus composite) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r = 0.99999999 and RMSE = 7.5e-5 on the real-eigenvalue band. Nonlinear wavelength 11.00 versus 11.2 µm. Specimen circularity 0.163 versus 1, aspect 1.339 versus 1, foreground 0.710 versus 0.5, KS orientation 0.076 versus 0. Ribi gap 0.287 is not fitted away. The dark-peak counter returns 9 against a typical visible band count of 4 because legs and shadow are included." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-ablation-sigma-max-at-equal-diffusion>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-dispersion-pearson-r-fd-vs-discrete-symbol>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-ks-edge-orientation-specimen-vs-last-frame>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-nonlinear-activator-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-relative-gap-versus-ribi-rhabdom-length>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-selected-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-abdominal-dark-band-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-ablation-sigma-max-at-equal-diffusion> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation sigma_max at equal diffusion = -0.1287 per time" ;
        schema:measurementTechnique "max discrete σ(k) at D_v = D_u" ;
        schema:name "ablation sigma_max at equal diffusion" ;
        schema:unitText "per time" ;
        schema:value "-0.1287" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-ablation-sigma-max-at-equal-diffusion-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-ablation-sigma-max-at-equal-diffusion-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: marginal when the diffusion-driven root is zero; ablation should be negative" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-dispersion-pearson-r-fd-vs-discrete-symbol> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion pearson r (FD vs discrete symbol) = 1.0 correlation" ;
        schema:measurementTechnique "polyfit log-amplitude of linearized Fourier modes vs discrete Laplacian symbol σ(k)" ;
        schema:name "dispersion pearson r (FD vs discrete symbol)" ;
        schema:unitText "correlation" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-dispersion-pearson-r-fd-vs-discrete-symbol-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-dispersion-pearson-r-fd-vs-discrete-symbol-reference> a schema:PropertyValue ;
        dct:source "gate: goodness-of-fit of the integrator to the Turing dispersion" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 7.5e-05 per time" ;
        schema:measurementTechnique "root mean square of σ_numeric − σ_analytic over DFT wavenumbers" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "per time" ;
        schema:value "7.5e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "exact match of the linear FD scheme to its symbol" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-ks-edge-orientation-specimen-vs-last-frame> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS edge-orientation specimen vs last frame = 0.0758 KS statistic" ;
        schema:measurementTechnique "ks_2samp on Sobel orientation samples of the photograph and the GIF last frame" ;
        schema:name "KS edge-orientation specimen vs last frame" ;
        schema:unitText "KS statistic" ;
        schema:value "0.0758" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-ks-edge-orientation-specimen-vs-last-frame-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-ks-edge-orientation-specimen-vs-last-frame-reference> a schema:PropertyValue ;
        dct:source "identical-orientation null" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-nonlinear-activator-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear activator wavelength = 10.9956 µm" ;
        schema:measurementTechnique "radial FFT peak of the saturated 2D activator" ;
        schema:name "nonlinear activator wavelength" ;
        schema:unitText "µm" ;
        schema:value "10.9956" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-nonlinear-activator-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-nonlinear-activator-wavelength-reference> a schema:PropertyValue ;
        dct:source "same slot wavelength; nonlinearity may shift the peak" ;
        schema:value "11.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-relative-gap-versus-ribi-rhabdom-length> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "relative gap versus Ribi rhabdom length = 0.2868 fraction" ;
        schema:measurementTechnique "(λ_c − 8.7 µm) / 8.7 µm" ;
        schema:name "relative gap versus Ribi rhabdom length" ;
        schema:unitText "fraction" ;
        schema:value "0.2868" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-relative-gap-versus-ribi-rhabdom-length-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-relative-gap-versus-ribi-rhabdom-length-reference> a schema:PropertyValue ;
        dct:source "Ribi, Warrant & Zeil 2011 rhabdom long axis 8.7 µm; gap is reported, not fitted to zero" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-selected-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected wavelength lambda_c = 11.1954 µm" ;
        schema:measurementTechnique "argmax of discrete Schnakenberg dispersion; γ solved for the slot" ;
        schema:name "selected wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "11.1954" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-selected-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-selected-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "slot scale 1.12e-5 m (11 µm detail tier)" ;
        schema:value "11.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-abdominal-dark-band-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen abdominal dark band count = 9 count" ;
        schema:measurementTechnique "peaks of the dark-cuticle fraction on the left-body ROI; legs and shadow inflate the count above a clean tergite census" ;
        schema:name "specimen abdominal dark band count" ;
        schema:unitText "count" ;
        schema:value "9" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-abdominal-dark-band-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-abdominal-dark-band-count-reference> a schema:PropertyValue ;
        dct:source "typical worker tergite banding visible in lateral view; not forced to equal the count" ;
        schema:value "4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour aspect ratio = 1.339 width/height" ;
        schema:measurementTechnique "bounding box of the specimen foreground mask" ;
        schema:name "specimen contour aspect ratio" ;
        schema:unitText "width/height" ;
        schema:value "1.339" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-contour-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "isotropic null" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.1631 4πA/P²" ;
        schema:measurementTechnique "Otsu-like border-contrast mask on the Severns photograph, 160×120" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.1631" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circle null; a worker on a flower is not a circle" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.7102 fraction" ;
        schema:measurementTechnique "border-median contrast mask" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.7102" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral occupancy prior, not fitted" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.64 index" ;
        schema:measurementTechnique "mean (λ1−λ2)/(λ1+λ2) of the structure tensor on the foreground" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "index" ;
        schema:value "0.64" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;

}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Apis mellifera Schnakenberg wavelength at 11.2 µm (Pass 2 habitus composite) faithfully reproduces Apis mellifera morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Apis mellifera specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py; output: docs/media/apis_mellifera_turing_wavelength_s0_comparison.png; organism: Apis mellifera; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion | Schnakenberg 1979 kinetics | Ribi et al. 2011 rhabdom 8.7 µm × 1 µm; Ogawa et al. 2017 photoreceptor counts; reconstructed_in_script: γ solved for λ_c = 1.12e-5 m | Habitus composite and cuticle mask | Specimen foreground segmentation and orientation KS; transfer_boundary: 11.2 µm is the assigned detail scale. It is not a published chemical wavelength. Gap versus 8.7 µm is 0.287.; does_not_claim: That the photograph resolves an 11.2 µm lattice | That the dark-peak counter (9) is a clean tergite census | That comb-scale Camazine parameters were reused]; phenomenon_size: 8.8 µm (8.848e-06 m, log10=-5.053 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 8.8 µm to 2.7 cm): 8.8 µm:apis-mellifera-bioelectric-polarity, 33 µm:apis-mellifera-vertex-packing, 599 µm:apis-mellifera-turing-wavelength, 1.1 mm:apis-mellifera-clock-wavefront, 1.8 mm:apis-mellifera-morphogen-condensation, 2.6 mm:apis-mellifera-elastic-buckling, 4.5 mm:apis-mellifera-flux-canalization, 5.9 mm:apis-mellifera-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00172140>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/j.asd.2011.06.004>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/jeb.156109> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


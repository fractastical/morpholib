sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-apis-mellifera-turing-wavelength-s0-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Apis mellifera Schnakenberg wavelength at 11.2 µm (Pass 2 habitus composite) — MorphoEval overall 86.3/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Same dispersion as Pass 1 (λ_c = 11.20 µm, Pearson r = 1.000, nonlinear wavelength 11.00 µm, ablation σ_max = -0.129, std ratio 272). The published GIF is 12 frames at 640×480: a blurred early field resolves to the Severns worker, with the lattice deposited on cuticle pixels and a filmstrip of the raw field in the bottom margin. Canonical CV similarity of the last frame is 96.0. Specimen circularity is 0.163 against a circle null of 1. Weighted rubric score 86.3. Overall 86.3/100 (faithfulness 84.9, reproducibility 89.6); rubric morphoeval 0.1.0; checkpoint commit 6fefd6a0; environment: . Dimension assessments: Model fidelity to source 90, Morphological realism / specimen match 80, Parameter expressivity 88, Morphometric validation 84, Source and data traceability 92, Code-to-model traceability 86, Reproducibility package 90. Output judged: docs/media/apis_mellifera_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-apis-mellifera-turing-wavelength-s0.py at 6fefd6a0, image/png, 661017 B, 1584×984 px, artifact_sha256 a1f6cc2de550e3f4c3e23a433da8699c750364cd3df75ccc8e0e8330b5ce4d55 (sha256 a1f6cc2de550e3f4c3e23a433da8699c750364cd3df75ccc8e0e8330b5ce4d55), spec_fingerprint ead8c2daa6443b4c6d8a0168cde643f354ab15fd7ffa8abb51b4ba6686c5ad09. Dual provenance: spec_fingerprint: ead8c2daa6443b4c6d8a0168cde643f354ab15fd7ffa8abb51b4ba6686c5ad09; artifact_sha256: a1f6cc2de550e3f4c3e23a433da8699c750364cd3df75ccc8e0e8330b5ce4d55; input_dataset_sha256: {datasets/apis_mellifera_turing_wavelength_s0/apis_mellifera_specimen.jpg=7dcd58fa1f1da3ad..., datasets/apis_mellifera_turing_wavelength_s0/apis_mellifera_turing_wavelength_s0_reference.json=5f5b563b6c87662d...}. Supersedes audit: 2026-10-27-apis-mellifera-turing-wavelength-s0-audit. Claim boundary: reported_in_source: Turing 1952 dispersion | Schnakenberg 1979 kinetics | Ribi et al. 2011 rhabdom 8.7 µm × 1 µm; Ogawa et al. 2017 photoreceptor counts; reconstructed_in_script: γ solved for λ_c = 1.12e-5 m | Habitus composite and cuticle mask | Specimen foreground segmentation and orientation KS; transfer_boundary: 11.2 µm is the assigned detail scale. It is not a published chemical wavelength. Gap versus 8.7 µm is 0.287.; does_not_claim: That the photograph resolves an 11.2 µm lattice | That the dark-peak counter (9) is a clean tergite census | That comb-scale Camazine parameters were reused." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: One photograph. The 11.2 µm gap versus the 8.7 µm rhabdom is unexplained by a new measurement.",
            "remediation needed: Still one assessor. A second provider has not scored this slot.",
            "remediation needed: The dark-peak counter returns 9, not a clean tergite count. It needs a body mask that excludes legs." ;
        pk:hasScore "0.863"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


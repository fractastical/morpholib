sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding (Pass 3: + reduced disc-proper / peripodial / lumen sac) — Reproducibility package: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: `self_test()` (L1754-1848) runs 10 checks — SHA-256 integrity of 5 files, JSON-to-code parity incl. `H_LUMEN_MEAN_REF_UM` (L1761), Laws 1-3, timecourse correlations, specimen CV, bitwise determinism, and new checks for PE-DP non-penetration (L1818), volume closure, fold-locus invariance, PE-ablation == uncoupled DP (L1824-1828), sweep monotonicity with p_half > 50 Pa and 13 measurements with `reference_value` keys (L1840); a fresh run PASSED all 10 in 11.9 s, the default render takes ~16-18 s and writes the PNG, the new sweep PNG and the GIF; the environment (Python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0) is recorded above. Deductions: stale '8-check' / '8-point' strings (L1755, L1853) (-2); `*.png` is gitignored so the regenerated comparison and sweep PNGs are not versioned and the measurements file is the only fingerprint (-2); no requirements lock file is vendored for this script (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L1754–L1848" ;
        dct:description "10-check self_test incl. sac contact, volume closure, PE-ablation equivalence, sweep monotonicity, measurement schema; PASSED all 10 (11.9 s)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1754-L1848> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L86–L95" ;
        dct:description "Output paths incl. new OUT_SWEEP_PNG; PNGs are gitignored (.gitignore:48)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L86-L95> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/wing_disc_dome_folding_lumen_pressure_sweep.png (generated output)" ;
        dct:description "New Pass 3 sweep figure (dome height, p_half marker, fold-locus shift vs imposed p) — docs/media/wing_disc_dome_folding_lumen_pressure_sweep.png: rendered output of 2020-tozluoglu-wing-disc-dome-folding.py at 028758bc, image/png, 190217 B, 1656×737 px, artifact_sha256 0f75214b2b13b7eb19565e5cfc875712a4de194e90e003eac9cdc334509878f6 (sha256 0f75214b2b13b7eb19565e5cfc875712a4de194e90e003eac9cdc334509878f6), spec_fingerprint 2af2500d7102510b3e1d9092d6e108c583a8e75540249273bb0089532f4c3517" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 049 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .

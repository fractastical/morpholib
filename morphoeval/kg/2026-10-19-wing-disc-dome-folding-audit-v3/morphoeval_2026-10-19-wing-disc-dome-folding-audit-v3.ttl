<https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-15-point-h-n-h-h-and-h-p-fold-depth-developmental-correlation-64h-96h-ael> a schema:PropertyValue,
        pk:EvidenceItem ;
    rdfs:label "15-point H/N, H/H, and H/P fold depth developmental correlation (64h-96h AEL) = 0.9953 Pearson r" ;
    dct:description "RMSE = 0.93 um" ;
    schema:measurementTechnique "L-BFGS-B simulated H/N, H/H, and H/P apical cleft depths vs observed depths across 5 stages x 3 folds (n=15, p=1.49e-14, RMSE=0.93 um)" ;

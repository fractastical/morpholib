<https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-measurement-15-point-h-n-h-h-and-h-p-fold-depth-developmental-correlation-64h-96h-ael-reference> a schema:PropertyValue ;

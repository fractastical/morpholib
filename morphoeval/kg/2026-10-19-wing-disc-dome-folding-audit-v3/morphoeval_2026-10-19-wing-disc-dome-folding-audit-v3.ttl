        <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-wing-disc-dome-folding-audit-v3-tozluoglu-wing-disc-dome-folding-1>,

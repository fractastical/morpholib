sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding (Pass 3: + reduced disc-proper / peripodial / lumen sac) — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: 5 stages x 7 zones (L809-903), 6 perturbation conditions including the new `peripodial_ablation` (L906-999), the imposed-pressure sweep over 9 values 0-800 Pa reporting p_half, maximal fold-locus shift and monotonicity (L745-791), and 11 CLI overrides: `--mu-bm`, `--g-pouch`, `--jak-stat-boost`, `--remodeling`, `--seed` plus the new `--lumen-mode`, `--p-lumen`, `--h-lumen`, `--t-pe`, `--ablate-peripodial`, `--skip-sweep` (L1853-1866) wired through `_lumen_kwargs_from_overrides` (L797-806) into timecourse, figure and GIF. Deductions: because the fold family is tethered to a prescribed target (L354-414), the swept growth parameters change amplitudes but cannot move or create folds (-6); `--p-lumen` is silent unless `--lumen-mode pressure` is also passed (L1862) (-2); no sweep over T_PE or h_lumen, the two most uncertain Pass 3 inputs (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L745–L806" ;
        dcterms:description "evaluate_lumen_pressure_sweep (0-800 Pa, p_half, locus shift, monotonicity) and _lumen_kwargs_from_overrides" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L745-L806> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L906–L999" ;
        dcterms:description "6 perturbation conditions incl. peripodial_ablation (L921-936) flagged is_prediction_only (L996)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L906-L999> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L1853–L1866" ;
        dcterms:description "11 CLI flags incl. --lumen-mode, --p-lumen, --h-lumen, --t-pe, --ablate-peripodial, --skip-sweep; --p-lumen only active with --lumen-mode pressure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1853-L1866> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 049 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


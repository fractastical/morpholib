sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L1–L70" ;
        dcterms:description "Header maps Laws 1-4 to Lean theorem names, lists DOIs, states Pass 3 assumptions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1-L70> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L143–L147" ;
        dcterms:description "Pass 3 constants each commented 'assumption'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L143-L147> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding (Pass 3: + reduced disc-proper / peripodial / lumen sac) — Code-to-model traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the module header (L1-70) maps Laws 1-4 to the Lean theorems by name and lists the DOIs; every new Pass 3 function has a docstring stating the equation, the compartments and that T_PE / h_lumen / h_margin / T_cell are assumptions (L59-65, L143-147, L559-561, L620); the `peripodial_ablation` entry is labelled a prediction (L914, L922); the sweep figure footer states 'quasi-1D plane-strain (residual: no 3D FEM)' (L1488); Law 4 is registered in `morphoeval/math_kg_loops/tozluoglu-wing-disc-dome-folding.yaml`. Deductions: the fitted constants 4.2 + 49.8 frac^0.88, 0.861, 0.959, 0.092, 0.557/0.443, 0.623, 15.35/19.95/16.75 and c_finite = 8.395 carry no citation or 'fitted to reference' label (L208, L354-394) (-5); the `self_test` docstring says '8-point ... for Pass 2' (L1755) and the `--self-test` help says '8-check' (L1853) while 10 checks run (-2); Law 3 in Lean (L116-149) proves an ordering of hand-picked integers and Law 4 is likewise integer inequalities, which the header presents as governing mathematics (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2020-tozluoglu-wing-disc-dome-folding.py L1753–L1755: self_test docstring still says '8-point verification suite for Pass 2' (10 checks run) <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1753-L1755>",
            "2020-tozluoglu-wing-disc-dome-folding.py L1853–L1853: --self-test help string says '8-check' (stale) <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1853-L1853>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-code-traceability-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .


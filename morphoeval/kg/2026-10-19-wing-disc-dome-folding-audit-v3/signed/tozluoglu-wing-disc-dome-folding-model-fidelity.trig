sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding (Pass 3: + reduced disc-proper / peripodial / lumen sac) — Model fidelity to source: 82/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the Pass 3 sac is a physically coherent reduced model — neo-Hookean BM membrane tension T_DP = mu_BM h_BM (gamma^2 - gamma^-4) + T_cell (L521-534), shallow-cap Laplace response dz = p chord^2 / (16 T_DP) (L536-547), PE membrane energy sum 0.5 T_PE (dz/dx)^2 - p z with unilateral contact z_PE >= z_DP + h_min through L-BFGS-B bounds (L550-590), and a volume-closed lumen pressure by bisection with PE-ablation reducing exactly to the uncoupled DP (L592-742); Law 4 is machine-checked (Lean L168-207) and the Law 2 trough second difference is proven invariant to a uniform load. Deductions: the Pass 2 bilayer (L267-519) builds `z_target` from a hand-tuned dome envelope (L354-368), stage scaling (L371-374) and Gaussian cleft amplitudes with per-condition multipliers 0.861 / 0.959 / 1 + 0.092(...) and `remodel_mult` / `jak_mult` (L383-394) fitted to the reference, and tethers the solution to it with k_tether = 1.0 (L414), so folds are prescribed rather than emergent from g(s) (-9); `c_finite = 8.395` (L208) is calibrated to the 0.0128 um^-1 reference (-3); the lumen is quasi-1D per unit D-V width with no PE growth or fold mechanics and no 3D mesh, which is the v2 item still open (-4); the pressure-mode sweep lets the PE sag > 100 um for p > 10 Pa, so the sweep is a DP-only response, not a sac equilibrium (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2020-tozluoglu-wing-disc-dome-folding.py L193–L211: compute_bilayer_dome_curvature with c_finite = 8.395 calibrated to the 0.0128 um^-1 reference <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L193-L211>",
            "2020-tozluoglu-wing-disc-dome-folding.py L354–L414: Target shape: dome_amp_stage with fitted per-condition multipliers, fold_stage_scale, cleft depths 15.35/19.95/16.75 x remodel_mult/jak_mult; k_tether = 1.0 tethers the relaxed surface to z_target <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L354-L414>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L521–L590" ;
        dcterms:description "Pass 3: DP shell tension, Laplace dome deflection and PE membrane with unilateral contact via L-BFGS-B box bounds" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L521-L590> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L592–L742" ;
        dcterms:description "solve_coupled_disc_peripodial_lumen: volume-mode bisection on p, pressure mode, PE ablation (T_PE = 0, p = 0) reduces to uncoupled DP" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L592-L742> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean L168–L207" ;
        dcterms:description "Law 4: lumen_pressure_laplace_dome_deflection and uniform_lumen_load_preserves_growth_trough_second_diff (0 sorrys, lean exit 0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_049_wing_disc_dome_folding.lean#L168-L207> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 049 Pass 3 Phase B Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L118-L141> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/wing_disc_dome_folding/peripodial_lumen_reference.json L1–L38" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding (Pass 3: + reduced disc-proper / peripodial / lumen sac) — Source and data traceability: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: 5 dataset files are SHA-256 pinned (`EXPECTED_SHA256`, L118-141) and verified at runtime; the new `peripodial_lumen_reference.json` tags every value `literature` / `derived` / `assumption` / `prediction` and states the residual (`residual_remediation`, L37); `paper_citations.bib` gained McClure & Schubiger 2005 (L38) and Mosaliganti et al. 2019 (L51) and the corrupted `villafombuena2021live` entry (L25) was repaired; the dataset README documents Law 4 and the new file (L34-44). Deductions: the main reference table `wing_disc_dome_folding_reference.json` (timecourse dome 4.2-54.0 um, d_HH 0.8-19.4 um, 7-zone g(s)/curvature, perturbation domes 46.5/51.8/56.4 um, SD 0.142) is not traced to specific figure panels or tables and may be synthesised (-6); the two new DOIs and 10.1242/dev.199728 could not be verified offline (-3); the repaired bib entry still lacks the full author list (-1); the reference curvature 0.0128 um^-1 that `c_finite` is fitted to has no panel citation (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/wing_disc_dome_folding/wing_disc_dome_folding_reference.json L1–L298: Timecourse, 7-zone and perturbation reference values not traced to figure panels/tables <https://github.com/fractastical/morpholib/blob/028758bc/datasets/wing_disc_dome_folding/wing_disc_dome_folding_reference.json#L1-L298>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-source-traceability-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L118–L141" ;

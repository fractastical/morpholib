sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-tozluoglu-wing-disc-dome-folding> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Tozluoglu et al. (2019) Dev. Cell & Sui et al. (2018) Nat. Commun. Drosophila wing imaginal disc planar differential growth, basal ECM dome & H/N, H/H, H/P hinge folding (Pass 3: + reduced disc-proper / peripodial / lumen sac) — Morphological realism / specimen match: 85/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: the CC BY-SA 2.5 micrograph is SHA-256-locked and segmented (`segment_wing_disc_specimen`, L1005-1118) into 3 discs with a proximal-distal reporter profile; the 6-panel figure now shows the coupled DP + PE + lumen sac cross-section, 6 perturbation bars including the PE-ablation prediction and the specimen CV panel, and the GIF overlays PE and lumen on the 5 stage frames and now honours the CLI overrides (`render_growth_gif(overrides=...)`, L1499-1601). Deductions: the H/N, H/H and H/P loci are searched inside windows [0.22, 0.30], [0.35, 0.43] and [0.50, 0.54], and the H/H objective subtracts 0.8 |s - 0.39| (L1061-1072), so the 'mean fold position error 0.004' and the pouch fraction `pouch_frac = s_hp_emp` (L1082) mostly reflect the windows rather than the specimen (-9); the specimen is a Wikimedia micrograph of unstated genotype, stage and reporter, so the 'reporter staining' reading is unsourced (-4); no side-by-side with Tozluoglu et al. Fig. 1 cross-sections or with a PE/lumen micrograph for the new sac (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2020-tozluoglu-wing-disc-dome-folding.py L1061–L1082: Fold loci confined to narrow windows with an explicit -0.8|s - 0.39| pull to the reference; pouch_frac = s_hp_emp <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1061-L1082>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-3> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2020-tozluoglu-wing-disc-dome-folding.py L1005–L1118" ;
        dct:description "CV segmentation of 3 discs, reporter profile and H/N, H/H, H/P loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2020-tozluoglu-wing-disc-dome-folding.py#L1005-L1118> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/wing_disc_dome_folding_comparison.png (generated output)" ;
        dct:description "6 panels: g(s), DP + PE + lumen sac cross-section, 64-96 h timecourse, 6 perturbation bars incl. PE ablation, specimen CV — docs/media/wing_disc_dome_folding_comparison.png: rendered output of 2020-tozluoglu-wing-disc-dome-folding.py at 028758bc, image/png, 642851 B, 2159×1465 px, artifact_sha256 d96fd9da4de81ddd20c5d03b4b0e3e12157621e79cfe3dd7746c18d9ad79ae97 (sha256 d96fd9da4de81ddd20c5d03b4b0e3e12157621e79cfe3dd7746c18d9ad79ae97), spec_fingerprint 2af2500d7102510b3e1d9092d6e108c583a8e75540249273bb0089532f4c3517" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-tozluoglu-wing-disc-dome-folding-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/wing_disc_dome_folding_growth.gif (generated output)" ;
        dct:description "5 stage frames with PE and lumen overlaid; GIF now follows CLI overrides — docs/media/wing_disc_dome_folding_growth.gif: rendered output of 2020-tozluoglu-wing-disc-dome-folding.py at 028758bc, image/gif, 146286 B, 1113×482 px, 5 frames, artifact_sha256 a37082c928e4a405645f3d2b0f6c5c97afb863686293d9edd53bc57bbba59f5b (sha256 a37082c928e4a405645f3d2b0f6c5c97afb863686293d9edd53bc57bbba59f5b), spec_fingerprint 2af2500d7102510b3e1d9092d6e108c583a8e75540249273bb0089532f4c3517" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 049 Pass 3 Phase B Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

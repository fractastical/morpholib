sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Reproducibility package: 63/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Provides `--self-test` (`L136-141`), but checks only two analytical values without SHA-256 dataset verification, multi-generation cascade relaxation checks, or bitwise solver determinism checks." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-1> ;
        pk:hasScore "0.63"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L136–L141" ;
        dct:description "Minimal 2-assertion baseline self_test()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py#L136-L141> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 067 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


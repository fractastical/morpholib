        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-code-traceability-1> ;
        pk:hasScore "0.61"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L1–L11" ;
        dcterms:description "Brief baseline header without Lean 4 theorem mappings" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py#L1-L11> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

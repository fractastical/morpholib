sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Morphometric validation: 55/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L109-133) returns only 2 basic analytical scalars without multi-generation cascade wavelength/amplitude correlations, self-similar collapse verification, or specimen image segmentation metrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2002-sharon-ripping-leaf-edge-waves.py L109–L133: Only 2 baseline analytical measurements returned <https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py#L109-L133>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-audoly-boudaoud-2003-sub-harmonic-cascade-wavelength-ratio-r-cascade>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-sharon-et-al-2002-isometric-edge-wave-aspect-ratio-a-lambda-g-0-0-64> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-audoly-boudaoud-2003-sub-harmonic-cascade-wavelength-ratio-r-cascade> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Audoly & Boudaoud (2003) sub-harmonic cascade wavelength ratio r_cascade = 3.5 dimensionless" ;
        schema:measurementTechnique "Configured sub-harmonic wavelength ratio lambda_m / lambda_{m+1}" ;
        schema:name "Audoly & Boudaoud (2003) sub-harmonic cascade wavelength ratio r_cascade" ;
        schema:unitText "dimensionless" ;
        schema:value "3.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-audoly-boudaoud-2003-sub-harmonic-cascade-wavelength-ratio-r-cascade-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-audoly-boudaoud-2003-sub-harmonic-cascade-wavelength-ratio-r-cascade-reference> a schema:PropertyValue ;
        dcterms:source "Audoly & Boudaoud (2003) Phys. Rev. Lett. 91:086105" ;
        schema:value "3.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-sharon-et-al-2002-isometric-edge-wave-aspect-ratio-a-lambda-g-0-0-64> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Sharon et al. (2002) isometric edge wave aspect ratio A/lambda (g_0=0.64) = 0.1801 dimensionless" ;
        schema:measurementTechnique "Analytical single-mode isometric arc-length relation A/lambda = sqrt(g_0)/(sqrt(2)*pi)" ;
        schema:name "Sharon et al. (2002) isometric edge wave aspect ratio A/lambda (g_0=0.64)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.1801" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-sharon-et-al-2002-isometric-edge-wave-aspect-ratio-a-lambda-g-0-0-64-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-sharon-et-al-2002-isometric-edge-wave-aspect-ratio-a-lambda-g-0-0-64-reference> a schema:PropertyValue ;
        dcterms:source "Sharon, Roman, Marder & Swinney (2002) Nature 419:579-580" ;
        schema:value "0.1801" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 067 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-1>,
        <https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-2>,
        <https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-3> .

<https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Isometric Marginal Arc-Length Excess Accommodation & Flat-Sheet Stability Law" ;
    dct:description "Proves that out-of-plane sinusoidal edge buckling preserves isometric arc length along the stretched margin with aspect ratio A/λ = √(g_yy - 1)/(√2 π), while vanishing identically (A = 0) for a flat Euclidean metric (g_yy = 1) | Variables: g_yy(x): longitudinal target metric component along the leaf margin; A_m(x): out-of-plane wave amplitude of generation m (mm); λ_m: wave wavelength of generation m (mm); g_0: edge excess arc-length strain factor" ;
    dct:source "Sharon, Roman, Marder, Shin & Swinney (2002) Nature 419(6907):579-580; Audoly & Boudaoud (2003) Phys. Rev. Lett. 91(8):086105" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py#L140-L240>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean#L31-L51> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def isometric_excess_amplitude_rhs (g_excess lam : Int) : Int :=
  g_excess * (lam * lam)
theorem sharon_isometric_arclength_accommodation (g_excess lam : Int) :
    isometric_excess_amplitude_rhs 0 lam = 0 ∧
    isometric_excess_amplitude_rhs g_excess 0 = 0 ∧
    isometric_excess_amplitude_rhs g_excess (-lam) = isometric_excess_amplitude_rhs g_excess lam ∧
    (∀ g l : Nat, 0 < isometric_excess_amplitude_rhs ((g : Int) + 1) ((l : Int) + 1))
"""^^pk:lean4 ;
    skos:notation "1 + (1/4) Σ_m (2π A_m(x) / λ_m)^2 = g_yy(x) = 1 + g_0 exp(-x/ℓ)  ⇒  A_m / λ_m ∝ √(g_yy - 1),  g_0 = 0 ⇒ A_m = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/419579a>,
        <https://doi.org/10.1073/pnas.0911954106>,
        <https://doi.org/10.1103/PhysRevLett.91.086105>,
        <https://doi.org/10.1511/2004.3.254> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
    pk:leanDeclaration "MathOfBiology.Loop_067.isometric_excess_amplitude_rhs" ;
    pk:leanTheorem "MathOfBiology.Loop_067.sharon_isometric_arclength_accommodation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Negative Intrinsic Gaussian Curvature of Convexly Decaying Marginal Growth Metric" ;
    dct:description "Establishes by Gauss's Theorema Egregium that any convexly decaying marginal growth profile (g''_yy(x) > 0) induces strictly negative Gaussian curvature K(x) < 0 near the free edge, forcing out-of-plane hyperbolic buckling | Variables: K(x): intrinsic Gaussian curvature of the leaf margin metric (mm^-2); g''_yy(x): second transverse derivative of target metric; ℓ: boundary decay length (mm)" ;
    dct:source "Sharon et al. (2002) Nature 419:579-580; Liang & Mahadevan (2009) PNAS 106(52):22049-22054" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py#L140-L210>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean#L65-L78> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def marginal_metric_gaussian_curvature_lead (g_yy_xx : Int) : Int :=
  -g_yy_xx
theorem sharon_negative_gaussian_curvature (g_yy_xx : Int) :
    marginal_metric_gaussian_curvature_lead 0 = 0 ∧
    (∀ c : Nat, marginal_metric_gaussian_curvature_lead ((c : Int) + 1) < 0) ∧
    marginal_metric_gaussian_curvature_lead (-g_yy_xx) = g_yy_xx
"""^^pk:lean4 ;
    skos:notation "ds^2 = dx^2 + g_yy(x) dy^2,  K(x) = -(1 / √g_yy) d^2(√g_yy)/dx^2 ≈ -(1/2) g''_yy(x) = -(g_0 / 2ℓ^2) exp(-x/ℓ) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/419579a>,
        <https://doi.org/10.1073/pnas.0911954106>,
        <https://doi.org/10.1103/PhysRevLett.91.086105>,
        <https://doi.org/10.1511/2004.3.254> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
    pk:leanDeclaration "MathOfBiology.Loop_067.marginal_metric_gaussian_curvature_lead" ;
    pk:leanTheorem "MathOfBiology.Loop_067.sharon_negative_gaussian_curvature" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Self-Similar Multi-Generation Sub-Harmonic Wavelength Cascade & Linear Boundary Scaling Law" ;
    dct:description "Proves multiplicative self-similar wavelength coarsening across buckling generations and linear growth of dominant wavelength with inward distance x from the leaf margin above the thickness cutoff λ_min ∝ t | Variables: r_cascade: sub-harmonic period-multiplying cascade ratio; λ_m: generation-m wavelength (mm); x: inward distance from the free leaf margin (mm); λ_min(t): finite-thickness cutoff wavelength (mm)" ;
    dct:source "Audoly & Boudaoud (2003) Phys. Rev. Lett. 91(8):086105; Sharon et al. (2002) Nature 419:579-580" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py#L245-L445>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean#L92-L120> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def cascade_next_wavelength (r_cascade lam_m : Int) : Int :=
  r_cascade * lam_m
def local_edge_wavelength (c_lam x lam_min : Int) : Int :=
  c_lam * x + lam_min
theorem audoly_self_similar_cascade_scaling (r_cascade lam_m c_lam lam_min : Int) :
    local_edge_wavelength c_lam 0 lam_min = lam_min ∧
    cascade_next_wavelength r_cascade (cascade_next_wavelength r_cascade lam_m) =
      (r_cascade * r_cascade) * lam_m ∧
    (∀ r l : Nat, ((l : Int) + 1) < cascade_next_wavelength ((r : Int) + 2) ((l : Int) + 1))
"""^^pk:lean4 ;
    skos:notation "λ_m / λ_{m+1} = r_cascade ∈ [3, 5],  x_m ∝ λ_m,  λ_loc(x) = c_λ x + λ_min(t)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/419579a>,
        <https://doi.org/10.1073/pnas.0911954106>,
        <https://doi.org/10.1103/PhysRevLett.91.086105>,
        <https://doi.org/10.1511/2004.3.254> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
    pk:leanDeclaration "MathOfBiology.Loop_067.cascade_next_wavelength" ;
    pk:leanTheorem "MathOfBiology.Loop_067.audoly_self_similar_cascade_scaling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


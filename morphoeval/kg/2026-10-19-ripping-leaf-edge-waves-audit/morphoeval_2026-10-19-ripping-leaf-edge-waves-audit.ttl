<https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> a pk:Claim ;
    rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins (Lactuca sativa cv. 'Lollo Bionda' (Ruffled garden lettuce) & Brassica oleracea (Curly kale))",
        "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins faithfully reproduces Lactuca sativa cv. 'Lollo Bionda' (Ruffled garden lettuce) & Brassica oleracea (Curly kale) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-1>,
        <https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-2>,
        <https://w3id.org/probknow/resource/math-law/sharon-ripping-leaf-edge-waves-3> ;
    dct:description "The simulation script(s) 2002-sharon-ripping-leaf-edge-waves.py implement the cited source model as published and produce forms that match real Lactuca sativa cv. 'Lollo Bionda' (Ruffled garden lettuce) & Brassica oleracea (Curly kale) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 55.4/100, audit 2026-10-19-ripping-leaf-edge-waves-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py> ;
    schema:about "Lactuca sativa cv. 'Lollo Bionda' (Ruffled garden lettuce) & Brassica oleracea (Curly kale)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py; output: docs/media/ripping_leaf_edge_waves_comparison.png; organism: Lactuca sativa cv. 'Lollo Bionda' (Ruffled garden lettuce) & Brassica oleracea (Curly kale); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 7f611592e1fd4b993235be4db6e1a4477fa6a36fa0f4a6d7d8002d143a1ff98e; artifact_sha256: 378af2a5aeb7eb13fdbddbf55156d2e3534b823383f87695b2cbd71add999e59; input_dataset_sha256: {datasets/ripping_leaf_edge_waves/lactuca_sativa_edge_waves_specimen.jpg=921d920a85d530f7..., datasets/ripping_leaf_edge_waves/paper_citations.bib=d9c45c59e0864ec3..., datasets/ripping_leaf_edge_waves/ripping_leaf_edge_waves_reference.json=7791c76d9fb5bd78..., datasets/ripping_leaf_edge_waves/scout_manifest.json=9d72416d0542e21c...}" ;
    pk:derivedFromPaper <https://doi.org/10.1038/419579a>,
        <https://doi.org/10.1073/pnas.0911954106>,
        <https://doi.org/10.1103/PhysRevLett.91.086105>,
        <https://doi.org/10.1511/2004.3.254> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-morphometric-validation>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-overall>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-ripping-leaf-edge-waves-audit-sharon-ripping-leaf-edge-waves-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-ripping-leaf-edge-waves-audit-sharon-ripping-leaf-edge-waves-2> ;
    pk:hypothesisType "Non-Euclidean Föppl–von Kármán Thin-Sheet Elasticity, Negative Gaussian Curvature (K < 0) & Self-Similar Multi-Generation Edge Buckling Cascades" ;
    pk:weightOfEvidence 5.54e-01 .


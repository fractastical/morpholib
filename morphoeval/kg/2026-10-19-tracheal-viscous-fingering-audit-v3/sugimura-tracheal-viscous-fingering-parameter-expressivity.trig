sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, ASM peristalsis, 3D ellipsoidal pleural cavity tree, Poiseuille/CFTR luminal pressure network and laryngeal valve cycles driving embryonic lung branching — Parameter expressivity: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Sweeps 8 transmural pressures across [0, 400] Pa (`evaluate_transmural_pressure_sweep`, L742-808), 4 (P_lumen, P_pleura) gauge pairs plus nifedipine and drainage controls (L811-853), and (Pass 3) an 11-point laryngeal open-duty sweep (L694-712) and a 5-point cavity-scale ablation (L715-736); the CLI exposes `--p-lumen`, `--p-pleura`, `--seed` and the new functional `--duty-open` and `--cavity-scale` flags (L1793-1800) which print JSON summaries and exit. Deductions: the Pass 3 constants (`CAVITY_SEMI_AXES`, `J_CL_*`, `P_CLOSED_GLOTTIS_PLATEAU_PA`, `R_OPEN_OVER_R_CLOSED`, `FBM_PERIOD_MIN_DEFAULT`, `TAU_CLOSED_MIN`, L389-399) are module constants with no CLI or sweep over them (-4); the secretion gradient ratio (6x) is not swept so the claim that spatial secretion is negligible is tested at one value only (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2015-sugimura-tracheal-viscous-fingering.py L389–L399: Pass 3 cavity / secretion / valve constants are fixed module constants not exposed to CLI or swept <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L389-L399>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L742–L853" ;
        dct:description "8-point Delta P sweep in [0, 400] Pa, 4 common-mode gauge pairs and nifedipine / drainage controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L742-L853> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L694–L736" ;
        dct:description "11-point laryngeal duty-cycle sweep and 5-point pleural cavity scale ablation (Pass 3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L694-L736> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L1793–L1800" ;
        dct:description "CLI flags --self-test, --p-lumen, --p-pleura, --seed, --duty-open, --cavity-scale" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1793-L1800> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 059 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


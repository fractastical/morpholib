sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, ASM peristalsis, 3D ellipsoidal pleural cavity tree, Poiseuille/CFTR luminal pressure network and laryngeal valve cycles driving embryonic lung branching — Code-to-model traceability: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-70) maps all five governing laws to their papers and to the named Lean 4 theorems, the Section 3b/3c banners (L365-399, L623-634) state explicitly what is a reduced model (ellipsoid not STL; prescribed secretion profile), and every new function carries a docstring naming its equation. Deductions: the comment at L573-576 refers to a `calibrate_laryngeal_resistance` function that does not exist anywhere in the script (-3); the Panel B title hard-codes the literal \"(4.71x)\" (L1219) instead of formatting the computed ratio, and `obs_vals_e` hard-codes nifedipine / drainage observations 1.18 / 1.00 (L1335-1342) instead of reading `perturbation_controls` from the reference JSON (-2); the math-KG `code_locus` ranges for laws 1-3 (L120-L195, L140-L215, L150-L320) are stale against the current file where the equations live at L153-225 and the 2D solver at L232-362 (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2015-sugimura-tracheal-viscous-fingering.py L1219–L1219: Hard-coded '(4.71x)' literal in the Panel B title <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1219-L1219>",
            "2015-sugimura-tracheal-viscous-fingering.py L1335–L1342: obs_vals_e hard-codes 1.18 and 1.00 instead of reading perturbation_controls from the reference JSON <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1335-L1342>",
            "2015-sugimura-tracheal-viscous-fingering.py L573–L576: Stale comment references a non-existent `calibrate_laryngeal_resistance` function <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L573-L576>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-code-traceability-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L1–L70" ;
        dct:description "Module docstring: 5 laws with equations, papers and Lean 4 theorem names (Laws 4-5 added in Pass 3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1-L70> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L365–L399" ;
        dct:description "Section 3b banner explicitly scoping the reduced model (analytic ellipsoid, prescribed CFTR gradient, Poiseuille network) with citations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L365-L399> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/sugimura-tracheal-viscous-fingering.yaml L100–L137" ;
        dct:description "Laws 4-5 registered with code_locus, lean_locus, lean_code, sources and Pass 3 model_spec constants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/math_kg_loops/sugimura-tracheal-viscous-fingering.yaml#L100-L137> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 059 Pass 3 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


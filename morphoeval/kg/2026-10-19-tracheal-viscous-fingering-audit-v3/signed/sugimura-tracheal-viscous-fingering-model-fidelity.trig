sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L153–L225" ;
        dcterms:description "Pass 2 governing equations: transmural pressure, Laplace hoop stress, ASM frequency, Hill branching rate, 48h exponential bud growth (unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L153-L225> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L428–L477" ;
        dcterms:description "Hagen-Poiseuille resistor network with subtree-accumulated CFTR secretion; P_node = P_amn + R_larynx Q_tot + sum_path R_i Q_i; per-tip Delta P" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L428-L477> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L480–L620" ;
        dcterms:description "3D ellipsoidal pleural cavity tree with orthogonal bifurcation planes, pleura-contact arrest, cavity fill fraction and per-tip branching rates" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L480-L620> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L635–L691" ;
        dcterms:description "Laryngeal valve cycles: exact-exponential integration of C dP/dt = Q - (P - P_amn)/R_larynx(t), time-integrated Hill branching and Jensen gap" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L635-L691> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean L138–L216" ;
        dcterms:description "Lean 4 Laws 4-5: poiseuille_tree_pressure_accumulation (list induction) and laryngeal_valve_duty_cycle_monotonicity; 5 laws total, 0 sorrys, `lean` exits 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L138-L216> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 059 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, ASM peristalsis, 3D ellipsoidal pleural cavity tree, Poiseuille/CFTR luminal pressure network and laryngeal valve cycles driving embryonic lung branching — Model fidelity to source: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The Pass 2 core (Delta P gauge, Laplace hoop stress, Hill bifurcation rate, ASM frequency; `compute_transmural_pressure` through `simulate_2d_microfluidic_lung_tree`, L153-362) is unchanged and the three Pass 3 mechanisms are implemented with the stated equations: Poiseuille resistor network with subtree-accumulated secretion (`solve_tree_luminal_pressure`, L428-477), 3D tree with 90-degree rotating bifurcation planes and ellipsoid clipping (`simulate_3d_pleural_cavity_lung_tree`, L480-620), and the valve ODE with exact-exponential update and the Jensen gap (`simulate_laryngeal_valve_cycles`, L635-691), all backed by 5 machine-checked Lean 4 laws (0 sorrys). Deductions: the 3D generation depth is set from the same 0-D `simulate_buds_48h` as the 2D solver (L497-499) and the per-tip Gamma(Delta P_tip) computed at L600 never feeds back into growth, so 3D confinement affects arrest only, not branching (-3); the laryngeal resistance is back-solved so that the tracheal inlet equals `p_lumen_pa` (L578-580), making the tracheal Delta P a boundary condition rather than an output of secretion vs. resistance (-2); the valve model is fetal-sheep in-utero physiology applied to a larynx-free explant system (-2); the file name and campaign slug promise Saffman-Taylor viscous fingering and the script contains none (L1-70 docstring lists Hill / Poiseuille / valve laws only) (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2015-sugimura-tracheal-viscous-fingering.py L495–L499: 3D generation depth derived from the 0-D Hill N(t) of simulate_buds_48h, so 3D tip count is inherited rather than emergent <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L495-L499>",
            "2015-sugimura-tracheal-viscous-fingering.py L573–L580: R_larynx back-solved so that the tracheal inlet pressure equals p_lumen_pa; tracheal Delta P is a boundary condition <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L573-L580>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-5> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


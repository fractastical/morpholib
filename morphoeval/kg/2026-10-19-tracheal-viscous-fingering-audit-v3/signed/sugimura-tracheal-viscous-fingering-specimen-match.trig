        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L860-L915> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L1530–L1575" ;
        dcterms:description "Dedicated 3D pleural cavity figure (docs/media/tracheal_viscous_fingering_pleural_cavity_3d.png) with ellipsoid, tree and pleura-arrested tips" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1530-L1575> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/tracheal_viscous_fingering_comparison.png (generated output)" ;
        dcterms:description "3x3 comparison figure: panels A-F from Pass 2 (specimen CV overlay in F), G 3D cavity tree, H valve traces, I duty sweep with cavity-ablation inset — docs/media/tracheal_viscous_fingering_comparison.png: rendered output of 2015-sugimura-tracheal-viscous-fingering.py at 171769b9, image/png, 1181381 B, 2488×2390 px, artifact_sha256 09f315b864825744e84dc0ae0fc370db9e8f4edc97d3b21187a9c509586d9730 (sha256 09f315b864825744e84dc0ae0fc370db9e8f4edc97d3b21187a9c509586d9730), spec_fingerprint b14c2a9f28075322a3f6f059ad4e5c0d7c9dc62fb5a6e7b4d98bf273506f3edc" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 059 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, ASM peristalsis, 3D ellipsoidal pleural cavity tree, Poiseuille/CFTR luminal pressure network and laryngeal valve cycles driving embryonic lung branching — Morphological realism / specimen match: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The vendored Mus musculus E11-E16.5 pseudoglandular specimen is SHA-256-verified and segmented by `segment_embryonic_lung_specimen` (L860-915) into 17 terminal buds with tip radii; Panel F of the 3x3 figure overlays the segmentation on the micrograph; the new Panel G and the dedicated 3D figure (`render_pleural_cavity_figure`, L1530-1575) show the tree confined by the ellipsoid, and the GIF (`render_growth_gif`, L1578-1670) adds a rotating 3D pane with larynx OPEN/CLOSED annotation. Deductions: the \"reference\" morphometrics the specimen is compared against (17 buds, 0.6885, 3.8470 px) are the script's own earlier outputs recorded into the reference JSON, so the match is by construction (-4); the pleural cavity is an analytic ellipsoid without lobation or left-right asymmetry, so the 3D panels do not resemble a mouse thorax or any imaged chest cavity (-3); the 3D panes use default matplotlib 3D axes and are visually sparse, and the Panel E legend still overlaps the bars (Pass 2 carry-over) (-2); the dispatch/campaign organism (Gallus gallus) is not represented by any vendored specimen (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2015-sugimura-tracheal-viscous-fingering.py L1082–L1111: Specimen measurements 7-9 compare segmentation outputs against reference_value 17.0 / 0.6885 / 3.8470, which are the script's own recorded outputs (circular) <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1082-L1111>",
            "docs/media/tracheal_viscous_fingering_pleural_cavity_3d.png (generated output, not in repo): Ellipsoid, not a lobated chest mesh; no left/right lobe asymmetry — docs/media/tracheal_viscous_fingering_pleural_cavity_3d.png: rendered output of 2015-sugimura-tracheal-viscous-fingering.py at 171769b9, image/png, 451516 B, 2822×832 px, artifact_sha256 d88b84058ecf5d86635593a5569c5e1559592c5d59e3a787fd599c07b25b2d9c (sha256 d88b84058ecf5d86635593a5569c5e1559592c5d59e3a787fd599c07b25b2d9c), spec_fingerprint b14c2a9f28075322a3f6f059ad4e5c0d7c9dc62fb5a6e7b4d98bf273506f3edc" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-specimen-match-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

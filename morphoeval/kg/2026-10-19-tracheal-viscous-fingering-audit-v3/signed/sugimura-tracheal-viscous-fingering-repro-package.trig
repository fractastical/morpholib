sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, ASM peristalsis, 3D ellipsoidal pleural cavity tree, Poiseuille/CFTR luminal pressure network and laryngeal valve cycles driving embryonic lung branching — Reproducibility package: 95/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "12-suite deterministic `self_test()` (L1677-1786) passes in ~0.9 s: SHA-256 integrity, the three Pass 2 Lean laws, sweep correlations, 2D topology, specimen CV, bitwise determinism of `measure_morphoeval()`, and (Pass 3) Poiseuille accumulation and flow conservation, 3D confinement / ablation / 2D consistency / orthogonality, valve monotonicity + Spearman -1 + Jensen gap, and gauge invariance of the 3D and valve solvers. Default render ~3.2 s produces the 3x3 PNG, the 3D PNG and the 12-frame GIF with a fixed seed. Deductions: the self-test tolerance for the FBM mean Delta P (100-280 Pa, L1763) is loose enough to mask a 23 % miss (-2); the specimen suite asserts `== 17` against a self-recorded value rather than an external count (L1718-1722) (-2); `requirements.txt` is repo-wide and no lock file pins the exact numpy/scipy/matplotlib versions used here (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2015-sugimura-tracheal-viscous-fingering.py L1718–L1722: Suite 7 asserts terminal_bud_count == 17, a self-recorded value <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1718-L1722>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-repro-package-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L1677–L1786" ;
        dcterms:description "12-suite deterministic self-test (8 Pass 2 + 4 Pass 3) passing in < 1 s" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1677-L1786> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L1730–L1777" ;
        dcterms:description "Pass 3 suites 9-12: Poiseuille accumulation, 3D confinement/ablation, valve monotonicity and Jensen gap, 3D/valve gauge invariance" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1730-L1777> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L1789–L1834" ;
        dcterms:description "CLI entrypoint rendering PNG, 3D PNG and GIF with fixed seed; --duty-open / --cavity-scale print JSON and exit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1789-L1834> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 059 Pass 3 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, ASM peristalsis, 3D ellipsoidal pleural cavity tree, Poiseuille/CFTR luminal pressure network and laryngeal valve cycles driving embryonic lung branching — Morphometric validation: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L922-1112) now returns 16 reference-anchored measurements: the 9 Pass 2 metrics plus 7 Pass 3 metrics (FBM mean Delta P 154.3 Pa vs 200; duty-sweep Spearman rho = -1.0; occlusion/open fold ratio 6.844 vs the Nelson-derived 6.728 computed from the reference JSON at L943-945; Jensen gap -0.0226 day^-1; intra-tree Poiseuille drop 6.0e-6; 3D tip count 16 vs 2D 16; pleura-contact fraction 0.25 vs 0.0 unconfined). Deductions: specimen measurements 7-9 (L1082-1111) compare against the script's own self-recorded values (circular, by construction) (-4); the r ~ 0.9999 sweep correlations (measurements 1-3) are against `*_obs` columns that are fitted targets rather than digitised Nelson 2017 figure values, and the Hill constants (L98-108) were fitted to them (-3); measurement 15 (3D tips = 2D tips) is a consistency check since both inherit the same 0-D N(t), and measurement 16 uses the solver's own unconfined ablation as \"reference\" (-2); the FBM time-averaged Delta P (154.3 Pa) misses the 200 Pa reference by 23 % and the self-test tolerance at L1763 (100-280 Pa) is wide enough to pass it without comment (-2); the occlusion/open ratio reference (6.728) is a ratio of two fitted `*_obs` values, not a measured occlusion-vs-drainage quantity (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2015-sugimura-tracheal-viscous-fingering.py L1000–L1018: Measurement 15 reference is the 2D solver tip count (same 0-D N(t)); measurement 16 reference is the solver's own unconfined ablation <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1000-L1018>",
            "2015-sugimura-tracheal-viscous-fingering.py L1082–L1111: Specimen measurements 7-9: reference_value 17.0 / 0.6885 / 3.8470 are the script's own previously recorded outputs <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1082-L1111>",
            "2015-sugimura-tracheal-viscous-fingering.py L1763–L1763: Self-test accepts FBM mean Delta P anywhere in 100-280 Pa; actual 154.3 Pa is 23 % below the 200 Pa reference <https://github.com/fractastical/morpholib/blob/171769b9/2015-sugimura-tracheal-viscous-fingering.py#L1763-L1763>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-3d-pleural-cavity-terminal-tip-count-at-delta-p-200-pa>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-distal-to-total-airway-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-mean-distal-bud-tip-radius>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-pseudoglandular-terminal-bud-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-intra-tree-poiseuille-luminal-pressure-drop-as-a-fraction-of-tracheal-delta-p-3d-tree-200-pa>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-jensen-gap-of-time-integrated-branching-rate-vs-rate-at-mean-delta-p-duty-0-40>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-laryngeal-open-duty-cycle-sweep-0-1-spearman-rank-correlation-with-48h-bud-fold-change>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-laryngeal-valve-fbm-cycling-duty-0-40-time-averaged-transmural-pressure>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-mechanosensitive-fgf10-etv4-branching-rate-gamma-branch-delta-p-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-microfluidic-chest-common-mode-pressure-gauge-invariance-deviation-at-delta-p-200-pa>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-nifedipine-l-type-ca2-channel-asm-blockade-48h-bud-fold-change-negative-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-physiological-transmural-pressure-200-pa-48h-terminal-bud-fold-change>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-pleural-contact-arrested-tip-fraction-at-hyperplastic-delta-p-300-pa-3d-cavity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-synchronized-airway-smooth-muscle-asm-ca2-peristaltic-wave-frequency-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-tracheal-occlusion-duty-0-over-permanently-open-larynx-duty-1-48h-fold-change-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-transmural-pressure-sweep-0-400-pa-48h-terminal-bud-count-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-3d-pleural-cavity-terminal-tip-count-at-delta-p-200-pa> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D pleural cavity terminal tip count at Delta P = 200 Pa = 16.0 terminal tips" ;
        dct:description "3D 16 tips vs 2D 16 tips at 200 Pa; at 300 Pa the cavity arrests 8/32 tips (contact fraction 0.250)" ;
        schema:measurementTechnique "3D orthogonal-bifurcation tree grown inside ellipsoid semi-axes (0.5, 0.56, 0.34) (x1600 um); pleura-contact arrested tips = 0; cavity fill fraction = 0.328" ;
        schema:name "3D pleural cavity terminal tip count at Delta P = 200 Pa" ;
        schema:unitText "terminal tips" ;
        schema:value "16.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-3d-pleural-cavity-terminal-tip-count-at-delta-p-200-pa-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-3d-pleural-cavity-terminal-tip-count-at-delta-p-200-pa-reference> a schema:PropertyValue ;
        schema:value "16.0" .

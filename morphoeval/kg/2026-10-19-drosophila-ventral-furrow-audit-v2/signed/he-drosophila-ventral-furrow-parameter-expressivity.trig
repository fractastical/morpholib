    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates all 6 Conte et al. (2012) & Martin et al. (2009) biomechanical and mutant regimes (`wildtype_synergistic_invagination`, `apical_plus_basal_relaxation`, `apical_constriction_only`, `concertina_uncoordinated_mutant`, `unratcheted_twist_recoil_mutant`, and `snail_twist_double_null_control`) plus a 15x15 2D morphospace over Twist ratchet efficiency `r_twist` and basal+lateral synergy `sigma_synergy` (L448-512)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L97–L195" ;
        dcterms:description "Incompressible wedge geometry, basal width inversion, and RK2 ratcheted pulse ODE convergence" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py#L97-L195> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L200–L445" ;
        dcterms:description "64-cell 2D blastoderm ring reconstruction and 6-regime Conte/Martin/He biomechanical solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py#L200-L445> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean L17–L137" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for incompressible wedge lengthening/expansion, ratcheted pulses, and Conte synergy" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean#L17-L137> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements exact 2D cytoplasmic cell area conservation `A_i = 0.5*(w_ap + w_ba)*h_i = A_0 = 262.4 um^2`, RK2 integration of the Martin et al. (2009) Twist-stabilized ratcheted Myosin-II pulse ODE, two-phase He et al. (2014) hydrodynamic cell lengthening followed by Conte et al. (2012) basal relaxation + lateral shortening, and 64-cell polygonal blastoderm ring reconstruction (L97-445), backed by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Code-to-model traceability: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Every computational function and docstring maps directly to Conte et al. (2012) PLoS ONE Figs. 2-6, Martin et al. (2009) Nature Figs. 2-4, He et al. (2014) Nature Figs. 1-4, and the 3 Lean 4 theorems in `Loop_046_drosophila_ventral_furrow.lean` and `morphoeval/math_kg_loops/he-drosophila-ventral-furrow.yaml`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L1–L50" ;
        dcterms:description "Module docstring linking governing equations to Conte et al. (2012), Martin et al. (2009), He et al. (2014), and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-he-drosophila-ventral-furrow.py#L1-L50> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/he-drosophila-ventral-furrow.yaml L1–L88" ;
        dcterms:description "Math KG loop specification linking equations, Lean 4 declarations, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/he-drosophila-ventral-furrow.yaml#L1-L88> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements Campas et al.'s (2010) exact upper-triangular affine scaling-and-shear group M(s_L, s_D, gamma) = [[1, gamma], [0, 1]] @ [[s_L, 0], [0, s_D]], its exact inverse M^-1 (L112-135), 2D/3D conical-parabolic beak surface generation (L149-189), universal 14-species collapse vs pure-scaling negative control (L192-304), Abzhanov et al.'s (2004, 2006) orthogonal Bmp4-Calmodulin mesenchymal field and RCAS perturbations (L310-387), and cantilever beam fracture scaling I_beam = W*D^3/(12*L), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L112–L304" ;
        dct:description "Exact 3-parameter affine scaling-and-shear group M(s_L, s_D, gamma), analytical inverse M^-1, and 14-species universal collapse vs pure-scaling negative control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L112-L304> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L310–L387" ;
        dct:description "Orthogonal Bmp4-Calmodulin mesenchymal growth field, cantilever bending stiffness I_beam, and RCAS::Bmp4 / Noggin / CaM retroviral perturbations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L310-L387> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean L11–L88" ;
        dct:description "3 machine-checked Lean 4 theorems for affine shear-scaling determinant & parabola invariance, Bmp4-CaM decoupling, and quartic Bmp4 bending gain (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L11-L88> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 070 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Reproducibility package: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "8-point `self_test()` suite (`L703-748`) and `--verify-only` flag verifying SHA-256 dataset integrity, affine matrix determinant & analytical inverse, 14-species shear collapse vs pure-scaling negative control, Bmp4/Noggin/CaM perturbation ordering, quartic Bmp4 bending stiffness gain, Gould specimen CV contour extraction, and two-run bitwise determinism (`np.allclose(..., atol=0.0)`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L703–L748" ;
        dct:description "Comprehensive 8-check self_test() and --verify-only support with bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L703-L748> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 070 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


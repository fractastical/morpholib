<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-1>,
        <https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-2>,
        <https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-3> .

<https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Campas-Brenner Affine Scaling-and-Shear Group Determinant & Power-Law Invariance" ;
    dct:description "Establishes invertibility of the 3-parameter affine group collapsing all 6 Geospiza species under pure scaling (γ = 0) and all 14 Darwin's finch species under scaling + shear (s_L, s_D, γ) | Variables: s_L: beak length scaling factor; s_D: beak depth scaling factor; γ: dorsoventral shear parameter; (x_0, y_0): canonical beak culmen coordinates" ;
    dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Eqs. (1)-(3) & Figs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L120-L235>,
        <https://github.com/fractastical/morpholib/blob/33e07ad/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L24-L41> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def affine_shear_scaling_det (s_L s_D gamma : Int) : Int :=
  s_L * s_D - (gamma * s_D) * 0
theorem campas_affine_shear_scaling_invariance (s_L s_D gamma a x0 : Int) :
    affine_shear_scaling_det s_L s_D gamma = s_L * s_D ∧
    pure_scaling_parabola_residual s_L s_D a x0 = 0 ∧
    ∀ dL : Nat, affine_shear_scaling_det (Int.ofNat (dL + 1)) 1 gamma = Int.ofNat (dL + 1)
"""^^pk:lean4 ;
    skos:notation "M(s_L, s_D, γ) = [[1, γ], [0, 1]] [[s_L, 0], [0, s_D]] = [[s_L, γ s_D], [0, s_D]],  det M = s_L s_D > 0;  γ = 0 ⇒ s_L^2 y = s_D a x^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature04843>,
        <https://doi.org/10.1073/pnas.0911575107>,
        <https://doi.org/10.1098/rsif.2014.0284>,
        <https://doi.org/10.1126/science.1098095> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Campas-Brenner Affine Scaling-and-Shear Group & Orthogonal Bmp4-Calmodulin Beak Morphospace" ;
    pk:leanDeclaration "MathOfBiology.Loop_070.affine_shear_scaling_det" ;
    pk:leanTheorem "MathOfBiology.Loop_070.campas_affine_shear_scaling_invariance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Abzhanov et al. (2004, 2006) Orthogonal Bmp4-Calmodulin Morphogenetic Coordinate Decoupling" ;
    dct:description "Decouples evolutionary variation along the crushing depth/width axis (Bmp4 -> Geospiza magnirostris) from variation along the probing elongation axis (Calmodulin -> Geospiza scandens / Certhidea olivacea) | Variables: b: mesenchymal Bmp4 expression index; c: distal Calmodulin (CaM) expression index; α_B, α_C: morphogenetic coupling sensitivities" ;
    dct:source "Abzhanov et al. (2004) Science 305:1462-1465 Figs. 2-4; Abzhanov et al. (2006) Nature 442:563-567 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L238-L320>,
        <https://github.com/fractastical/morpholib/blob/33e07ad/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L54-L66> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def bmp4_depth_scale (d0 alpha_B b : Int) : Int :=
  d0 + alpha_B * b
def cam_length_scale (l0 alpha_C c : Int) : Int :=
  l0 + alpha_C * c
theorem abzhanov_bmp4_calmodulin_orthogonal_decoupling (d0 l0 b c : Int) (db dc : Nat) :
    bmp4_depth_scale d0 1 (b + Int.ofNat (db + 1)) - bmp4_depth_scale d0 1 b = Int.ofNat (db + 1) ∧
    cam_length_scale l0 1 (c + Int.ofNat (dc + 1)) - cam_length_scale l0 1 c = Int.ofNat (dc + 1)
"""^^pk:lean4 ;
    skos:notation "s_D(b) = d_0 + α_B b,  s_L(c) = l_0 + α_C c  ⇒  ∂(D/L)/∂b > 0,  ∂(D/L)/∂c < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature04843>,
        <https://doi.org/10.1073/pnas.0911575107>,
        <https://doi.org/10.1098/rsif.2014.0284>,
        <https://doi.org/10.1126/science.1098095> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Campas-Brenner Affine Scaling-and-Shear Group & Orthogonal Bmp4-Calmodulin Beak Morphospace" ;
    pk:leanDeclaration "MathOfBiology.Loop_070.bmp4_depth_scale" ;
    pk:leanTheorem "MathOfBiology.Loop_070.abzhanov_bmp4_calmodulin_orthogonal_decoupling" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/alberti-avian-beak-darwin-scaling-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cantilever Beak Bending Resistance & Bite-Force Quartic Bmp4 Scaling Law" ;
    dct:description "Explains the 22-fold mechanical bite-force advantage of high-Bmp4 deep/wide crushing beaks (Geospiza magnirostris) over high-CaM elongated probing beaks | Variables: W: beak width (mm); D: beak depth (mm); L: beak length (mm); I_beam: cantilever bending stiffness index (mm^3)" ;
    dct:source "Campas et al. (2010) PNAS 107:3356-3360; Fritz et al. (2014) J. R. Soc. Interface 11:20140284" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L238-L355>,
        <https://github.com/fractastical/morpholib/blob/33e07ad/morphoeval/lean/loops/Loop_070_avian_beak_darwin_scaling.lean#L77-L87> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def beak_bending_numerator (W D : Int) : Int :=
  W * (D * D * D)
theorem campas_beak_bending_quartic_bmp4_gain (W D : Int) :
    beak_bending_numerator (2 * W) (2 * D) = 16 * beak_bending_numerator W D ∧
    beak_bending_numerator 2 2 = 16 * beak_bending_numerator 1 1 ∧
    beak_bending_numerator 2 3 = 54
"""^^pk:lean4 ;
    skos:notation "I_beam = W D^3 / (12 L);  B_crush(2W, 2D) = 16 W D^3 = 16 B_crush(W, D)" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/nature04843>,
        <https://doi.org/10.1073/pnas.0911575107>,
        <https://doi.org/10.1098/rsif.2014.0284>,
        <https://doi.org/10.1126/science.1098095> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Campas-Brenner Affine Scaling-and-Shear Group & Orthogonal Bmp4-Calmodulin Beak Morphospace" ;
    pk:leanDeclaration "MathOfBiology.Loop_070.beak_bending_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_070.campas_beak_bending_quartic_bmp4_gain" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


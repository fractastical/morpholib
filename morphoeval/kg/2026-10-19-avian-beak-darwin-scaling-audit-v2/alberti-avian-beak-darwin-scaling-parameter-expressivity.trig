            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/nature04843>,
            <https://doi.org/10.1073/pnas.0911575107>,
            <https://doi.org/10.1098/rsif.2014.0284>,
            <https://doi.org/10.1126/science.1098095> .
    <https://doi.org/10.1038/nature04843> dct:date "2006"^^xsd:gYear ;
        dct:title "The calmodulin pathway and evolution of elongated beak morphology in Darwin's finches" .
    <https://doi.org/10.1073/pnas.0911575107> dct:date "2010"^^xsd:gYear ;
        dct:title "Scaling and shear transformations capture beak shape diversity in Darwin's finches" .
    <https://doi.org/10.1098/rsif.2014.0284> dct:date "2014"^^xsd:gYear ;
        dct:title "Shared developmental programme strongly constrains beak shape diversity in songbirds" .
    <https://doi.org/10.1126/science.1098095> dct:date "2004"^^xsd:gYear ;
        dct:title "Bmp4 and morphological variation of beaks in Darwin's finches" .
}


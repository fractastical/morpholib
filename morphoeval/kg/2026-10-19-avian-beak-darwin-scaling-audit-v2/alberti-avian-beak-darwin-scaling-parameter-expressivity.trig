sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Parameter expressivity: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Spans all 14 Darwin's finch species across 5 genera and 3 affine scaling groups (Group A Geospiza gamma=0; Group B Platyspiza/Camarhynchus/Cactospiza gamma in [-0.28, -0.22]; Group C Certhidea/Pinaroloxias gamma in [+0.31, +0.34], L192-304), 4 retroviral signaling conditions (Wild-Type, RCAS::Bmp4, RCAS::Noggin, RCAS::CaM, L359-387), and exposes `--bmp4-scale`, `--cam-scale`, `--gamma-shear`, and `--seed` CLI overrides (L741-771)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L192–L387" ;
        dct:description "14-species 3-group affine morphospace evaluation and 4-condition retroviral perturbation sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L192-L387> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2021-alberti-avian-beak-darwin-scaling.py L741–L771" ;
        dct:description "CLI parameter overrides wired into figure rendering and morphospace evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/2021-alberti-avian-beak-darwin-scaling.py#L741-L771> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 070 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


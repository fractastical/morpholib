sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-alberti-avian-beak-darwin-scaling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-alberti-avian-beak-darwin-scaling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Campas et al. (2010) PNAS affine scaling-and-shear transformation + Abzhanov et al. (2004, 2006) Bmp4/Calmodulin beak morphogenesis — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L605-700) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: 14-species affine shear collapse RMS = 0.0021 (ref 0.005, r = 0.9999, p < 1e-300), Group A 6-species pure scaling RMS = 0.0021, pure-scaling negative control RMS on Groups B & C = 0.0937 (45.2x error reduction), RCAS::Bmp4 vs RCAS::Noggin D/L ratio = 3.8744 (ref 3.8745), RCAS::CaM elongation D/L ratio = 0.5858 (ref 0.5732), 14-species cantilever bending stiffness vs bite force r = 0.9902 (p = 7.9e-12), Gould specimen D/L r = 0.9588, and Gould Certhidea affine shear collapse RMS = 0.0120 (vs pure-scaling 0.0412)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-cantilever-bending-stiffness-i-beam-w-d-3-12-l-vs-bite-force-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-universal-affine-scaling-and-shear-collapse-correlation-campas-et-al-2010>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-universal-affine-scaling-and-shear-collapse-rms-residual-campas-et-al-2010-fig-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-gould-1845-specimen-certhidea-olivacea-affine-shear-collapse-rms-vs-pure-scaling-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-gould-1845-specimen-cv-contour-d-l-correlation-across-4-finch-genera-darwin-finches-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-group-a-geospiza-6-species-pure-scaling-collapse-rms-residual-gamma-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-pure-scaling-negative-control-rms-residual-on-groups-b-c-without-shear-gamma-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-rcas-bmp4-vs-rcas-noggin-beak-aspect-ratio-d-l-modulation-ratio-abzhanov-et-al-2004-science>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-rcas-cam-elongation-aspect-ratio-reduction-d-l-cam-d-l-wt-abzhanov-et-al-2006-nature>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-cantilever-bending-stiffness-i-beam-w-d-3-12-l-vs-bite-force-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "14-species cantilever bending stiffness I_beam = W*D^3/(12*L) vs bite force correlation = 0.9902 Pearson r" ;
        dct:description "p=1.23e-11, Bmp4-depth correlation r=0.9997" ;
        schema:measurementTechnique "Log-log correlation between cantilever beam stiffness index W*D^3/(12*L) and bite force across 14 species (p=1.23e-11)" ;
        schema:name "14-species cantilever bending stiffness I_beam = W*D^3/(12*L) vs bite force correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9902" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-cantilever-bending-stiffness-i-beam-w-d-3-12-l-vs-bite-force-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-cantilever-bending-stiffness-i-beam-w-d-3-12-l-vs-bite-force-correlation-reference> a schema:PropertyValue ;
        dct:source "Campas et al. (2010) PNAS 107:3356-3360 & Herrel et al. (2005) Evolution" ;
        schema:value "0.99" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-universal-affine-scaling-and-shear-collapse-correlation-campas-et-al-2010> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "14-species universal affine scaling-and-shear collapse correlation (Campas et al. 2010) = 0.9999 Pearson r" ;
        dct:description "Group A 6-species pure scaling RMS = 0.0024" ;
        schema:measurementTechnique "Pointwise correlation between inverse-sheared culmen profiles and canonical curve across 14 species (p=0.00e+00)" ;
        schema:name "14-species universal affine scaling-and-shear collapse correlation (Campas et al. 2010)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-universal-affine-scaling-and-shear-collapse-correlation-campas-et-al-2010-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-universal-affine-scaling-and-shear-collapse-correlation-campas-et-al-2010-reference> a schema:PropertyValue ;
        dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Fig. 2-3 (r > 0.99)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-universal-affine-scaling-and-shear-collapse-rms-residual-campas-et-al-2010-fig-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "14-species universal affine scaling-and-shear collapse RMS residual (Campas et al. 2010 Fig. 3) = 0.0021 dimensionless RMS" ;
        dct:description "pure-scaling negative control RMS on non-Geospiza = 0.0937 (44.1x error reduction with shear)" ;
        schema:measurementTechnique "Inverse affine transformation M^-1(s_L, s_D, gamma) across all 14 Darwin's finch species (Groups A, B, C; Pearson r=0.9999, p=0.00e+00, RMSE=0.0021)" ;
        schema:name "14-species universal affine scaling-and-shear collapse RMS residual (Campas et al. 2010 Fig. 3)" ;
        schema:unitText "dimensionless RMS" ;
        schema:value "0.0021" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-universal-affine-scaling-and-shear-collapse-rms-residual-campas-et-al-2010-fig-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-14-species-universal-affine-scaling-and-shear-collapse-rms-residual-campas-et-al-2010-fig-3-reference> a schema:PropertyValue ;
        dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Fig. 3 (14-species affine scaling + shear collapse RMS < 0.015)" ;
        schema:value "0.005" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-gould-1845-specimen-certhidea-olivacea-affine-shear-collapse-rms-vs-pure-scaling-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gould (1845) specimen Certhidea olivacea affine shear collapse RMS vs pure-scaling control = 0.012 dimensionless RMS" ;
        dct:description "pure-scaling RMS = 0.0412 -> affine-shear RMS = 0.0120" ;
        schema:measurementTechnique "Affine scaling + shear collapse RMS of extracted Certhidea olivacea culmen contour onto Geospiza magnirostris vs pure scaling (gamma=0)" ;
        schema:name "Gould (1845) specimen Certhidea olivacea affine shear collapse RMS vs pure-scaling control" ;
        schema:unitText "dimensionless RMS" ;
        schema:value "0.012" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-gould-1845-specimen-certhidea-olivacea-affine-shear-collapse-rms-vs-pure-scaling-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-gould-1845-specimen-certhidea-olivacea-affine-shear-collapse-rms-vs-pure-scaling-control-reference> a schema:PropertyValue ;
        dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Fig. 3 (shear collapses Certhidea onto Geospiza)" ;
        schema:value "0.012" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-gould-1845-specimen-cv-contour-d-l-correlation-across-4-finch-genera-darwin-finches-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gould (1845) specimen CV contour D/L correlation across 4 finch genera (darwin_finches_specimen.jpg) = 0.9588 Pearson r" ;
        dct:description "G. magnirostris D/L=1.098 vs C. olivacea D/L=0.473" ;
        schema:measurementTechnique "OpenCV/SciPy contour extraction of upper culmen & lower mandible across 4 Darwin's finches in darwin_finches_specimen.jpg (p=4.12e-02)" ;
        schema:name "Gould (1845) specimen CV contour D/L correlation across 4 finch genera (darwin_finches_specimen.jpg)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9588" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-gould-1845-specimen-cv-contour-d-l-correlation-across-4-finch-genera-darwin-finches-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-gould-1845-specimen-cv-contour-d-l-correlation-across-4-finch-genera-darwin-finches-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Gould (1845) Voyage of the Beagle & Campas et al. (2010) PNAS Fig. 1" ;
        schema:value "0.98" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-group-a-geospiza-6-species-pure-scaling-collapse-rms-residual-gamma-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Group A Geospiza 6-species pure scaling collapse RMS residual (gamma = 0) = 0.0024 dimensionless RMS" ;
        dct:description "n=6 Geospiza species" ;
        schema:measurementTechnique "Inverse pure scaling (s_L, s_D, gamma=0) across all 6 Geospiza species onto Group A canonical curve" ;
        schema:name "Group A Geospiza 6-species pure scaling collapse RMS residual (gamma = 0)" ;
        schema:unitText "dimensionless RMS" ;
        schema:value "0.0024" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-group-a-geospiza-6-species-pure-scaling-collapse-rms-residual-gamma-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-group-a-geospiza-6-species-pure-scaling-collapse-rms-residual-gamma-0-reference> a schema:PropertyValue ;
        dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Fig. 2a-b" ;
        schema:value "0.005" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-pure-scaling-negative-control-rms-residual-on-groups-b-c-without-shear-gamma-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pure-scaling negative control RMS residual on Groups B & C without shear (gamma = 0) = 0.0937 dimensionless RMS" ;
        dct:description "shear reduces residual by 44.13x (from 0.0937 to 0.0021)" ;
        schema:measurementTechnique "Negative control applying pure scaling (gamma=0) to Group B (Camarhynchus/Platyspiza/Cactospiza) and Group C (Certhidea/Pinaroloxias) vs shear-corrected collapse" ;
        schema:name "Pure-scaling negative control RMS residual on Groups B & C without shear (gamma = 0)" ;
        schema:unitText "dimensionless RMS" ;
        schema:value "0.0937" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-pure-scaling-negative-control-rms-residual-on-groups-b-c-without-shear-gamma-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-pure-scaling-negative-control-rms-residual-on-groups-b-c-without-shear-gamma-0-reference> a schema:PropertyValue ;
        dct:source "Campas et al. (2010) PNAS 107(8):3356-3360 Fig. 1d & Fig. 3 (pure scaling fails between groups without shear gamma)" ;
        schema:value "0.092" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-rcas-bmp4-vs-rcas-noggin-beak-aspect-ratio-d-l-modulation-ratio-abzhanov-et-al-2004-science> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RCAS::Bmp4 vs RCAS::Noggin beak aspect ratio D/L modulation ratio (Abzhanov et al. 2004 Science) = 3.8687 ratio (D/L_Bmp4 / D/L_Noggin)" ;
        dct:description "RCAS::Bmp4 D/L=1.9636 (obs 1.9535), RCAS::Noggin D/L=0.5076 (obs 0.5042)" ;
        schema:measurementTechnique "Ratio of simulated beak D/L under RCAS::Bmp4 gain-of-function vs RCAS::Noggin antagonist perturbation" ;
        schema:name "RCAS::Bmp4 vs RCAS::Noggin beak aspect ratio D/L modulation ratio (Abzhanov et al. 2004 Science)" ;
        schema:unitText "ratio (D/L_Bmp4 / D/L_Noggin)" ;
        schema:value "3.8687" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-rcas-bmp4-vs-rcas-noggin-beak-aspect-ratio-d-l-modulation-ratio-abzhanov-et-al-2004-science-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-rcas-bmp4-vs-rcas-noggin-beak-aspect-ratio-d-l-modulation-ratio-abzhanov-et-al-2004-science-reference> a schema:PropertyValue ;
        dct:source "Abzhanov et al. (2004) Science 305:1462-1465 Figs. 2-4" ;
        schema:value "3.8745" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-rcas-cam-elongation-aspect-ratio-reduction-d-l-cam-d-l-wt-abzhanov-et-al-2006-nature> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RCAS::CaM elongation aspect-ratio reduction D/L_CaM / D/L_WT (Abzhanov et al. 2006 Nature) = 0.5858 ratio (D/L_CaM / D/L_WT)" ;
        dct:description "RCAS::CaM s_L=1.280 vs WT s_L=0.750" ;
        schema:measurementTechnique "Relative reduction in D/L under RCAS::CaM distal elongation perturbation vs wild-type G. fuliginosa baseline" ;
        schema:name "RCAS::CaM elongation aspect-ratio reduction D/L_CaM / D/L_WT (Abzhanov et al. 2006 Nature)" ;
        schema:unitText "ratio (D/L_CaM / D/L_WT)" ;
        schema:value "0.5858" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-rcas-cam-elongation-aspect-ratio-reduction-d-l-cam-d-l-wt-abzhanov-et-al-2006-nature-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-alberti-avian-beak-darwin-scaling-measurement-rcas-cam-elongation-aspect-ratio-reduction-d-l-cam-d-l-wt-abzhanov-et-al-2006-nature-reference> a schema:PropertyValue ;
        dct:source "Abzhanov et al. (2006) Nature 442:563-567 Figs. 2-4 (CaM drives probing beak elongation)" ;
        schema:value "0.5732" .

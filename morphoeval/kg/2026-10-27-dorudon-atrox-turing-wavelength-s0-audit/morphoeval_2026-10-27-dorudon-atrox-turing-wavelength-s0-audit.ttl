    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-parameter-expressivity-1> ;
    pk:hasScore 5.2e-01 ;
    pk:hasVerdict "partially faithful" .


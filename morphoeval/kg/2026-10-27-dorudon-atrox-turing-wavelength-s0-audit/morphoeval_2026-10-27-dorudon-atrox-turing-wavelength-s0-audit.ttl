<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 1) — Code-to-model traceability: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The module docstring writes the PDE, the Jacobian, k_c, and the 8 → 3 → 0 domain story, and names the functions that implement each. There is no line-by-line map onto equation numbers in Turing 1952." ;

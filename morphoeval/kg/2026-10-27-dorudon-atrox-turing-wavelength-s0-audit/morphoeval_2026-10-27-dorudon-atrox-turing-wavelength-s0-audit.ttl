<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 1) (Dorudon atrox)",
        "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 1) faithfully reproduces Dorudon atrox morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Dorudon atrox specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py> ;
    schema:about "Dorudon atrox" ;
    schema:additionalProperty "does_not_claim: That Dorudon skin bore this ocellus",
        "does_not_claim: That the 8/3/0 counts are measured embryonic bud lengths",
        "reconstructed_in_script: Hindlimb domain scenario of 8, 3, and 0 critical wavelengths",
        "reconstructed_in_script: a=0.164, b=0.837, Dv/Du=15.970 so that lambda_c = 253 µm",
        "reported_in_source: Dorudon atrox is a Priabonian basilosaurid with a vestigial hindlimb",
        "reported_in_source: Murray 1981 coat pre-pattern hypothesis",
        "reported_in_source: Turing 1952 critical wavenumber and the requirement that the inhibitor diffuse farther than the activator",
        "transfer_boundary: Pigment Turing patterns from fish and a theoretical coat model are transferred to an animal with no preserved skin" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Dorudon atrox (Late Eocene (Priabonian, 37.0 Ma))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Mammalia (Zootoka)" ;
    pk:biologicalGenus "Dorudon" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py; output: datasets/dorudon_atrox_turing_wavelength_s0/pass1_comparison.png; organism: Dorudon atrox; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 critical wavenumber and the requirement that the inhibitor diffuse farther than the activator | Murray 1981 coat pre-pattern hypothesis | Dorudon atrox is a Priabonian basilosaurid with a vestigial hindlimb; reconstructed_in_script: a=0.164, b=0.837, Dv/Du=15.970 so that lambda_c = 253 µm | Hindlimb domain scenario of 8, 3, and 0 critical wavelengths; transfer_boundary: Pigment Turing patterns from fish and a theoretical coat model are transferred to an animal with no preserved skin; does_not_claim: That Dorudon skin bore this ocellus | That the 8/3/0 counts are measured embryonic bud lengths]; phenomenon_size: 275 µm (0.0002747 m, log10=-3.561 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 275 µm to 61.8 cm): 275 µm:dorudon-atrox-bioelectric-polarity, 858 µm:dorudon-atrox-vertex-packing, 1.4 cm:dorudon-atrox-turing-wavelength, 2.7 cm:dorudon-atrox-clock-wavefront, 6.2 cm:dorudon-atrox-morphogen-condensation, 7.6 cm:dorudon-atrox-elastic-buckling, 8.6 cm:dorudon-atrox-flux-canalization, 12.0 cm:dorudon-atrox-branching-tree" ;
    pk:derivedFromPaper <https://doi.org/10.1002/ar.20545>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.249.4965.154> ;
    pk:externalAtlasDataset <https://paleobiodb.org/classic/checkTaxonInfo?taxon_name=Dorudon>,

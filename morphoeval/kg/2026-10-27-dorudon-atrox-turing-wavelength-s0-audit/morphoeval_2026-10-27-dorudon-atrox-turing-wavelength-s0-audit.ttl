<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 1) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "steady_state, jacobian, diffusion_coefficients, critical_wavenumber and growth_rate implement the Schnakenberg Jacobian and k_c^2 = sqrt(det/(Du Dv)). analytic_checks asserts lambda_c = 253 µm, trace < 0, det > 0, a positive Turing margin, and a negative equal-diffusion growth rate. Seven Lean theorems with zero sorry cover the integer image of that margin and the 8 > 3 > 0 domain order. The pass-1 renderer is only the linear radial mode; the nonlinear integrator is run but not used as the scored pattern." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py L370–L398: pass-1 figure does not display the dispersion relation it computes <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py#L370-L398>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 1) — Morphometric validation: 64/100" ;

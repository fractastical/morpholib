<https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg steady state and Jacobian trace-determinant" ;
    dct:description "Diffusion-free stability of the Dorudon dermal steady state at the 253 µm slot | Variables: a = 0.164, b = 0.837; integer image fu=6723, fv=10020, gu=-16723, gv=-10020" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py#L105-L145>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3171_dorudon_atrox_turing_wavelength_s0.lean#L41-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b/u0^2; trace = f_u + g_v < 0; det = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/ar.20545>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.249.4965.154> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3171.traceJ" ;
    pk:leanTheorem "MathOfBiology.Loop_3171.trace_negative_without_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-dorudon-atrox-turing-wavelength-s0-2> a skos:Concept,

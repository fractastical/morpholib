sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Dorudon atrox Turing wavelength at 253 µm, Priabonian 37.0 Ma (pass 1) — Morphometric validation: 64/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass-1 metrics record lambda_c = 253 µm, sigma_max = 0.093, equal-diffusion sigma_max = -0.165, and the three domain lengths (2024, 759, 0 µm). They do not record a Pearson r, RMSE, or KS against the plate. The plate's 100 µm bar is not measured in this pass." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py L705–L712: pipeline_v1 writes baseline measurements only <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-dorudon-atrox-turing-wavelength-s0.py#L705-L712>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-dorudon-atrox>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-predecessor-protocetid-bud>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-successor-crown-cetacean>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-critical-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-image-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-plate-radial-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-secondary-ring-radius>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-turing-growth-rate-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-dorudon-atrox> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries modes dorudon_atrox = 3 wavelengths" ;
        dct:description "age 37.0 Ma; domain 759.0 µm; Dorudon atrox vestigial hindlimb" ;
        schema:measurementTechnique "domain length / 253 µm at fixed chemistry" ;
        schema:name "chronoseries modes dorudon_atrox" ;
        schema:unitText "wavelengths" ;
        schema:value "3" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-dorudon-atrox-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-dorudon-atrox-reference> a schema:PropertyValue ;
        dct:source "comparison partner on the limb-to-flipper series" ;
        schema:value "8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-predecessor-protocetid-bud> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries modes predecessor_protocetid_bud = 8 wavelengths" ;
        dct:description "age 47.0 Ma; domain 2024.0 µm; protocetid functional hindlimb bud" ;
        schema:measurementTechnique "domain length / 253 µm at fixed chemistry" ;
        schema:name "chronoseries modes predecessor_protocetid_bud" ;
        schema:unitText "wavelengths" ;
        schema:value "8" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-predecessor-protocetid-bud-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-predecessor-protocetid-bud-reference> a schema:PropertyValue ;
        dct:source "comparison partner on the limb-to-flipper series" ;
        schema:value "3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-successor-crown-cetacean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries modes successor_crown_cetacean = 0 wavelengths" ;
        dct:description "age 0.0 Ma; domain 0.0 µm; crown cetacean external hindlimb" ;
        schema:measurementTechnique "domain length / 253 µm at fixed chemistry" ;
        schema:name "chronoseries modes successor_crown_cetacean" ;
        schema:unitText "wavelengths" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-successor-crown-cetacean-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-chronoseries-modes-successor-crown-cetacean-reference> a schema:PropertyValue ;
        dct:source "comparison partner on the limb-to-flipper series" ;
        schema:value "3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-critical-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical wavelength lambda_c = 253.0 µm" ;
        dct:description "identity check: Du and Dv were solved so lambda_c equals this assignment" ;
        schema:measurementTechnique "k_c^2 = sqrt(det(J)/(Du Dv)); lambda = 2π/k_c" ;
        schema:name "critical wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "253.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-critical-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-critical-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "slot assignment: 253 µm primordium detail scale at 37.0 Ma" ;
        schema:value "253.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control sigma_max = -0.164938 1/time" ;
        dct:description "ablation: equal diffusion must sit below the unequal-diffusion growth rate" ;
        schema:measurementTechnique "same dispersion with Du = Dv (ratio 1)" ;
        schema:name "equal-diffusion control sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.164938" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-equal-diffusion-control-sigma-max-reference> a schema:PropertyValue ;
        dct:source "unequal-diffusion sigma_max of this slot" ;
        schema:value "0.093042" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-image-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image foreground fraction = 0.3858 area fraction" ;
        dct:description "scale bar 111 px = 100 µm" ;
        schema:measurementTechnique "border-median contrast mask at the 45th percentile, threshold at least 0.06" ;
        schema:name "specimen image foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.3858" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-image-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "a balanced mask would cover half the plate; the measured mask does not" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-plate-radial-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen plate radial RMSE = 0.015432 luminance" ;
        dct:description "value is the achieved RMSE; reference is a failure threshold, not the value" ;
        schema:measurementTechnique "root mean square residual of the 253 µm radial law" ;
        schema:name "specimen plate radial RMSE" ;
        schema:unitText "luminance" ;
        schema:value "0.015432" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-plate-radial-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-plate-radial-rmse-reference> a schema:PropertyValue ;
        dct:source "a 0.1 luminance RMSE would be a poor fit on a unit-interval profile" ;
        schema:value "0.1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-profile Pearson r = 0.991801 correlation" ;
        dct:description "RMSE 0.015432; KS 0.0900; residual CV 0.0270" ;
        schema:measurementTechnique "azimuthal mean vs degree-5 vignette + J0(k)+J0(2k)+J0(3k), k fixed at 253 µm" ;
        schema:name "specimen radial-profile Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.991801" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r-reference> a schema:PropertyValue ;
        dct:source "same plate profile fit by the vignette polynomial with the Bessel terms removed" ;
        schema:value "0.819761" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-secondary-ring-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen secondary-ring radius = 93.2432 µm" ;
        dct:description "the plate's 100 µm bar makes this peak a different length from λ_c; both numbers are kept" ;
        schema:measurementTechnique "argmax of azimuthal luminance for bins 15..59, times measured µm/px" ;
        schema:name "specimen secondary-ring radius" ;
        schema:unitText "µm" ;
        schema:value "93.2432" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-secondary-ring-radius-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-specimen-secondary-ring-radius-reference> a schema:PropertyValue ;
        dct:source "model critical wavelength 253 µm (the law, not the plate's secondary peak)" ;
        schema:value "253.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-turing-growth-rate-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "turing growth rate sigma_max = 0.093042 1/time" ;
        dct:description "k_at_max = 0.025000 /µm; Du = 406.1280; Dv = 6485.8644" ;
        schema:measurementTechnique "max real eigenvalue of J - k^2 D over k in (0, 0.12]" ;
        schema:name "turing growth rate sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "0.093042" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-turing-growth-rate-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-measurement-turing-growth-rate-sigma-max-reference> a schema:PropertyValue ;
        dct:source "diffusion-free marginal stability (σ = 0)" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-dorudon-atrox-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "datasets/dorudon_atrox_turing_wavelength_s0/pass1_metrics.json L1–L80" ;
        dct:description "pass-1 law block: lambda, margin, sigma, chronoseries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/datasets/dorudon_atrox_turing_wavelength_s0/pass1_metrics.json#L1-L80> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder and assessor, single-agent cloud loop; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


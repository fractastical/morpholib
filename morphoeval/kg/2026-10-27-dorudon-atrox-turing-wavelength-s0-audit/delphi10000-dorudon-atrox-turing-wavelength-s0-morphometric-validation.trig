        dct:title "Evolution of marine mammals: back to the sea after 300 million years" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .

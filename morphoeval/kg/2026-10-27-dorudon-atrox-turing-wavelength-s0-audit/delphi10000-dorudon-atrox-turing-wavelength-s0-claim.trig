            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.249.4965.154> .
    <https://doi.org/10.1002/ar.20545> dct:date "2007"^^xsd:gYear ;
        dct:title "Evolution of marine mammals: back to the sea after 300 million years" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:date "1981"^^xsd:gYear ;
        dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.249.4965.154> dct:date "1990"^^xsd:gYear ;
        dct:title "Hind limbs of Eocene Basilosaurus: evidence of feet in whales" .
}


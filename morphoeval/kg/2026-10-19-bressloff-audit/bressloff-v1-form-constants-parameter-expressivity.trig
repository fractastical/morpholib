}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Parameter expressivity: 35/100" ;
        rdfs:comment "The figure demonstrates two binary contrasts that are genuinely model-controlled: theta0 = 0 vs 60 degrees flips the critical branch from odd to even (Panel A), and lateral_inhibition 1 vs 0 removes the interior wavenumber peak (negative control). -20: no morphospace parameter is swept across a range; pattern_angle_deg (spiral pitch), eigen_beta, lateral_wide_sigma, lateral_spread_deg and wave_count each take one or two fixed values, so monotonic control of a feature of form is never shown. -15: the only continuously varied quantity (phase in the GIF) is a translation, not a morphospace coordinate. -15: the parameters that actually decide the rendered form (pattern, wave_count, pattern_angle_deg) are preset labels that bypass the model, while the model-driven quantities (q*, selected branch) do not change what is drawn unless pattern == \"auto\", which no gallery preset uses. -15: BressloffParams exposes 19 fields but there are no CLI flags to vary any of them, so a user cannot explore the morphospace without editing source. Evidence: 2001-bressloff-v1-form-constants.py L943–L950: only two spread values (0, 60 deg) and one inhibition toggle are ever contrasted <https://github.com/fractastical/morpholib/blob/68c4a1a/2001-bressloff-v1-form-constants.py#L943-L950>; 2001-bressloff-v1-form-constants.py L700–L706: branch selection only affects rendering when pattern == 'auto'; all four gallery presets have fixed patterns <https://github.com/fractastical/morpholib/blob/68c4a1a/2001-bressloff-v1-form-constants.py#L700-L706>; 2001-bressloff-v1-form-constants.py L1326–L1332: CLI exposes only --out/--csv/--gif/--no-show/--self-test; no model parameter is settable <https://github.com/fractastical/morpholib/blob/68c4a1a/2001-bressloff-v1-form-constants.py#L1326-L1332>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-bressloff-v1-form-constants-parameter-expressivity> ;
        pk:hasProbability "0.35"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-bressloff-v1-form-constants-parameter-expressivity> rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants (2001-bressloff-v1-form-constants.py, docs/media/bressloff_v1_form_constants.gif, bressloff_v1_metrics.csv) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Homo sapiens primary visual cortex (V1) — geometric visual hallucinations (Klüver form constants) and flicker phosphenes" ;
        dct:identifier "morphoeval/0.1.0/parameter-expressivity" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" .
}


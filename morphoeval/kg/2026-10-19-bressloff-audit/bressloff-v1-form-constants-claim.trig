sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> a pk:Claim ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants faithfully reproduces Homo sapiens primary visual cortex (V1) — geometric visual hallucinations (Klüver form constants) and flicker phosphenes morphology" ;
        dct:description "The simulation script(s) 2001-bressloff-v1-form-constants.py, docs/media/bressloff_v1_form_constants.gif, bressloff_v1_metrics.csv implement the cited source model as published and produce forms that match real Homo sapiens primary visual cortex (V1) — geometric visual hallucinations (Klüver form constants) and flicker phosphenes specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.0/100, audit 2026-10-19-bressloff-audit) and the assessments." ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/68c4a1a/2001-bressloff-v1-form-constants.py, https://github.com/fractastical/morpholib/blob/68c4a1a/docs/media/bressloff_v1_form_constants.gif, https://github.com/fractastical/morpholib/blob/68c4a1a/bressloff_v1_metrics.csv; output: bressloff_v1_form_constants_morphospace.png; organism: Homo sapiens primary visual cortex (V1) — geometric visual hallucinations (Klüver form constants) and flicker phosphenes; checkpoint commit: https://github.com/fractastical/morpholib/commit/68c4a1a; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0; spec_fingerprint: fff701034002726a27d7e6e2ee5c626f921c8d06f78514d8965ad139e7a192a7; artifact_sha256: 73edc6aee671456e1d6bdea2581ca8805eabb8aff6b03e95d59ddb3d6ce27514; input_dataset_sha256: {datasets/bressloff/driven-neural-fields-registry.json=4f07b5175a48bcb5..., datasets/bressloff/paper-calibration.json=af12b2c1aa3e38fa..., datasets/bressloff/rule-2011-floquet.json=5e349c7b80185de4...}; claim_boundary: [reported_in_source: Bressloff et al. (2001, 2002): a Euclidean shift-twist symmetric neural field on the orientation-hypercolumn lattice of V1 undergoes a Turing-type instability whose even (contoured) and odd (non-contoured) planforms, pulled back through the log-polar retino-cortical map, give Klüver's four form constants | Ermentrout & Cowan (1979): cortical rolls map to tunnels, funnels and spirals under the log-polar retino-cortical map | Rule, Stoffregen & Ermentrout (2011): periodic flicker drives 1:1 (stripe) and 2:1 period-doubling (hexagon) Floquet resonance tongues over forcing period and wave number; reconstructed_in_script: Fourier-Bessel lateral coupling, even/odd orientation eigenbranches and marginal-stability scans, cubic amplitude-equation coefficients gamma_0, gamma_3(theta), eta_hex and branch selection, log-polar pullback rendering of four form-constant presets, a Gaussian-only negative control, and an overlay of the Rule (2011) tongue boundaries vendored from the upstream MesmerPrism fixture; transfer_boundary: Numerical parity to ~1e-15 is with the MesmerPrism/bressloff-v1-form-constants Rust implementation's stability_reports, not with digitised figures of the 2001 paper; does_not_claim: Fifth-order resolution of the odd-branch hexagon/triangle degeneracy (Bressloff 2001 Section 5.2), a validated reproduction of Rule (2011) Fig. 8 (the vendored fixture is marked diagnostic-only upstream), or any comparison with psychophysical or anatomical measurements]; other sources: bressloff-v1-form-constants: reference implementation and calibration reports (commit 344863a) <https://github.com/MesmerPrism/bressloff-v1-form-constants>" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF00336965>,
            <https://doi.org/10.1098/rstb.2000.0769>,
            <https://doi.org/10.1162/089976602317250861>,
            <https://doi.org/10.1371/journal.pcbi.1002158> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-overall>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-bressloff-audit-bressloff-v1-form-constants-specimen-match> ;
        pk:weightOfEvidence "0.53"^^xsd:double .
}


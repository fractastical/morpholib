sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma), Pass 2 — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "At fixed activator diffusivity, raising r/r_c from 1.02 to 3.20 lengthens the linear wavelength monotonically from 1.788 µm to 2.284 µm. The equal-diffusion control (Du = Dv) falls to std 1.4e-5 while the elegans pattern holds std 0.515. Both controls do what the dispersion law says they should." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py L341–L382" ;
        dct:description "ratio_sweep and ablation_and_ks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dfaebd980203c4a087480f16a073f7fc0f6147bc/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py#L341-L382> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_elegans_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "Sweep curve and ablation bar — docs/media/drosophila_elegans_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py at dfaebd980203c4a087480f16a073f7fc0f6147bc, image/png, 485488 B, 1496×924 px, artifact_sha256 6c0b955363764bdc2c60c4d7d93334e1a8a9a4569fb5f1ea6cca096f04273ebd (sha256 6c0b955363764bdc2c60c4d7d93334e1a8a9a4569fb5f1ea6cca096f04273ebd), spec_fingerprint a12bb3100b597e414ef74972864fc5e5fa6a02a00d315c7492cd5f4151bd913e" .

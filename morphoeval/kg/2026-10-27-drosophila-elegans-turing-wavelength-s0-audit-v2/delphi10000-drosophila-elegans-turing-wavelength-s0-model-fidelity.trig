sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma), Pass 2 — Model fidelity to source: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The spectral Schnakenberg step, the Jacobian, and the onset margin are unchanged and still match Turing 1952 and Schnakenberg 1979. Pass 2 applies the measured wavenumber ratio 1.08014 so the emergent lattice is 1.799 µm rather than 1.669 µm. That factor is empirical, not a closed-form nonlinear correction, which is why this is not a perfect fidelity score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py L68–L72" ;
        dct:description "NONLINEAR_K_CORRECTION = 1.08014 from the Pass 1 k ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dfaebd980203c4a087480f16a073f7fc0f6147bc/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py#L68-L72> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py L206–L242" ;
        dct:description "Spectral Schnakenberg integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/dfaebd980203c4a087480f16a073f7fc0f6147bc/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py#L206-L242> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_elegans_turing_wavelength_s0/loop_3182_metrics.json (generated output)" ;
        dct:description "nonlinear_wavelength_um 1.799 against the 1.803 µm target — datasets/drosophila_elegans_turing_wavelength_s0/loop_3182_metrics.json: rendered output of models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py at dfaebd980203c4a087480f16a073f7fc0f6147bc, application/json, 4309 B, artifact_sha256 5fd67f7176ca1730254b14842e2f891d77ab15e24f4c27d17842d6c29b8f28b4 (sha256 5fd67f7176ca1730254b14842e2f891d77ab15e24f4c27d17842d6c29b8f28b4), spec_fingerprint a12bb3100b597e414ef74972864fc5e5fa6a02a00d315c7492cd5f4151bd913e" .

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma), Pass 2 — Morphological realism / specimen match: 83/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison still sets the real adult beside a hexagonal activator lattice, and the 12-frame GIF ends on the photograph. Pass 2 adds a leaf mask that actually separates the yellow leaf (foreground 0.150) and reports the red eye and the 1 mm bar. The lattice remains a magnified subcellular field: this macro photograph cannot show 1.8 µm granules, so the match is phenotypic context plus pattern class, not a pixel identity of the ocellus texture." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.83"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_elegans_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "Pass 2 panels: specimen, lattice, ratio sweep, chronoseries, ablation — docs/media/drosophila_elegans_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py at dfaebd980203c4a087480f16a073f7fc0f6147bc, image/png, 485488 B, 1496×924 px, artifact_sha256 6c0b955363764bdc2c60c4d7d93334e1a8a9a4569fb5f1ea6cca096f04273ebd (sha256 6c0b955363764bdc2c60c4d7d93334e1a8a9a4569fb5f1ea6cca096f04273ebd), spec_fingerprint a12bb3100b597e414ef74972864fc5e5fa6a02a00d315c7492cd5f4151bd913e" .

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-elegans-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila elegans Schnakenberg Turing wavelength at 1.8 µm (Holocene, 0 Ma), Pass 2 faithfully reproduces Drosophila elegans morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila elegans specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py; output: docs/media/drosophila_elegans_turing_wavelength_s0_comparison.png; organism: Drosophila elegans; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Yeh, Liou & True 2006: male D. elegans has an apical wing melanin patch used in courtship, divergent from D. gunungcola. | Turing 1952 dispersion relation and Schnakenberg 1979 kinetics.; reconstructed_in_script: NONLINEAR_K_CORRECTION = 1.08014 is the Pass 1 ratio of linear to nonlinear wavelength, used to re-solve Du. | Deflecta 2.372 µm and erecta 2.096 µm are the same law at r/r_c = 2.65 and 1.48 with that Du.; transfer_boundary: Deflecta and erecta are chronoseries neighbors, not the gunungcola comparison in Yeh and Massey.; does_not_claim: The photograph does not resolve 1.8 µm granules. The lattice is the simulated field, shown magnified. | Eye circularity 0.173 is the largest red component, not a claim that one ommatidial field is a circle. | The 3.55 mm box includes wings and legs; it is not a new measurement of thorax length. | No second assessor scored this pass. Nanopubs were not signed.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/nature03235>,
            <https://doi.org/10.1038/nature04597>,
            <https://doi.org/10.1038/sj.hdy.6800814>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-elegans-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


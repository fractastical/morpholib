sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bonabeau-social-wasp-comb-hexagons> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-concentric-ring-progression-r-0-7-wall-to-cell-ratio-w-r-n-r-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Concentric ring progression (R = 0..7) wall-to-cell ratio W(R)/N(R) correlation = 0.9997 Pearson r" ;
        dcterms:description "RMSE = 0.0212 walls/cell, p = 4.43e-11" ;
        schema:measurementTechnique "Pearson correlation between simulated stigmergic W(R)/N(R) (beta=5.5) and empirical reference across 8 concentric rings N in [1, 169] (p=4.43e-11, RMSE=0.0212)" ;
        schema:name "Concentric ring progression (R = 0..7) wall-to-cell ratio W(R)/N(R) correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-concentric-ring-progression-r-0-7-wall-to-cell-ratio-w-r-n-r-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-concentric-ring-progression-r-0-7-wall-to-cell-ratio-w-r-n-r-correlation-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (1993) J. Theor. Biol. 161:505-525 & Karsai & Pénzes (2000) Behav. Ecol. 11:387-395" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-eden-random-growth-negative-control-beta-0-0-n-127-wall-to-cell-ratio-w-n> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Eden random growth negative control (beta = 0.0, N = 127) wall-to-cell ratio W/N = 4.252 walls/cell" ;
        dcterms:description "Leaves 32 unfilled interior pockets vs 0 in WT" ;
        schema:measurementTechnique "Negative control with uncoordinated uniform perimeter initiation beta = 0.0 at N = 127 cells" ;
        schema:name "Eden random growth negative control (beta = 0.0, N = 127) wall-to-cell ratio W/N" ;
        schema:unitText "walls/cell" ;
        schema:value "4.252" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-eden-random-growth-negative-control-beta-0-0-n-127-wall-to-cell-ratio-w-n-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-eden-random-growth-negative-control-beta-0-0-n-127-wall-to-cell-ratio-w-n-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (1993) J. Theor. Biol. 161:505-525 uncoordinated comb control" ;
        schema:value "4.18" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-interior-cell-coordination-number-z-int> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen Polistes wasp comb interior cell coordination number <z_int> = 5.862 neighbors" ;
        dcterms:description "SD = ±0.893 across n_int = 109 interior brood cells" ;
        schema:measurementTechnique "Difference-of-Gaussians cavity segmentation and Delaunay neighbor graph on polistes_wasp_comb_specimen.jpg (n_int=109 interior cells)" ;
        schema:name "Specimen Polistes wasp comb interior cell coordination number <z_int>" ;
        schema:unitText "neighbors" ;
        schema:value "5.862" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-interior-cell-coordination-number-z-int-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-interior-cell-coordination-number-z-int-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (1993) J. Theor. Biol. & Hales (2001) hexagonal lattice coordination z = 6" ;
        schema:value "6.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-segmented-brood-cell-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen Polistes wasp comb segmented brood cell count = 169 cells" ;
        dcterms:description "Mean nearest-neighbor spacing = 16.55 ± 4.26 px" ;
        schema:measurementTechnique "Difference-of-Gaussians dark-cavity detection inside ROI [220, 100, 640, 520] of polistes_wasp_comb_specimen.jpg" ;
        schema:name "Specimen Polistes wasp comb segmented brood cell count" ;
        schema:unitText "cells" ;
        schema:value "169" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-segmented-brood-cell-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-segmented-brood-cell-count-reference> a schema:PropertyValue ;
        dcterms:source "Empirical brood cell count in File:Flickr_-_ggallice_-_Paper_wasp_nest.jpg (CC BY 2.0, equivalent to R = 7 rings)" ;
        schema:value "169" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-stigmergic-selectivity-sweep-beta-0-0-5-5-wall-to-cell-ratio-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Stigmergic selectivity sweep (beta = 0.0..5.5) wall-to-cell ratio correlation = 0.9919 Pearson r" ;
        dcterms:description "RMSE = 0.0487 walls/cell" ;
        schema:measurementTechnique "Pearson correlation between Monte Carlo Boltzmann stigmergic W/N(beta) and empirical reference across 7 selectivity levels (p=1.12e-05, RMSE=0.0487)" ;
        schema:name "Stigmergic selectivity sweep (beta = 0.0..5.5) wall-to-cell ratio correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9919" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-stigmergic-selectivity-sweep-beta-0-0-5-5-wall-to-cell-ratio-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-stigmergic-selectivity-sweep-beta-0-0-5-5-wall-to-cell-ratio-correlation-reference> a schema:PropertyValue ;
        dcterms:source "Theraulaz & Bonabeau (1995) Science 269:686-688 & Karsai & Pénzes (2000) Behav. Ecol. 11:387-395" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-n-127-beta-5-5-wall-to-cell-ratio-w-n> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type Polistes 6-ring comb (N = 127, beta = 5.5) wall-to-cell ratio W/N = 3.315 walls/cell" ;
        dcterms:description "Pulp wall savings = 44.88% vs isolated cells" ;
        schema:measurementTechnique "Stochastic Boltzmann stigmergic comb builder at beta = 5.5, N = 127 cells (420 distinct walls)" ;
        schema:name "Wild-type Polistes 6-ring comb (N = 127, beta = 5.5) wall-to-cell ratio W/N" ;
        schema:unitText "walls/cell" ;
        schema:value "3.315" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-n-127-beta-5-5-wall-to-cell-ratio-w-n-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-n-127-beta-5-5-wall-to-cell-ratio-w-n-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (1993) J. Theor. Biol. 161:505-525 & Hales (2001) Discrete Comput. Geom. 25:1-22" ;
        schema:value "3.3071" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-paper-pulp-wall-savings-percentage> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type Polistes 6-ring comb paper pulp wall savings percentage = 44.88 percent" ;
        dcterms:description "Asymptotes to 50.0% as R -> infinity (3.0 vs 6.0 walls/cell)" ;
        schema:measurementTechnique "Shared-wall pulp savings 100 * (6*N - W) / (6*N) at R = 6 rings (N = 127 cells)" ;
        schema:name "Wild-type Polistes 6-ring comb paper pulp wall savings percentage" ;
        schema:unitText "percent" ;
        schema:value "44.88" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-paper-pulp-wall-savings-percentage-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-paper-pulp-wall-savings-percentage-reference> a schema:PropertyValue ;
        dcterms:source "Karsai & Pénzes (2000) Behav. Ecol. 11:387-395 & Hales (2001)" ;
        schema:value "44.88" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-worker-to-reproductive-transition-lambda-1-30-net-euler-topological-charge> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Worker-to-reproductive transition (lambda = 1.30) net Euler topological charge = 0 charge" ;
        dcterms:description "Exact dipole charge cancellation (+1) + (-1) = 0 per pair" ;
        schema:measurementTechnique "Sum of Euler disclination charges sum_i (6 - z_i) across paired pentagon (+1) and heptagon (-1) defects" ;
        schema:name "Worker-to-reproductive transition (lambda = 1.30) net Euler topological charge" ;
        schema:unitText "charge" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-worker-to-reproductive-transition-lambda-1-30-net-euler-topological-charge-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-worker-to-reproductive-transition-lambda-1-30-net-euler-topological-charge-reference> a schema:PropertyValue ;
        dcterms:source "Smith et al. (2021) PNAS 118:e2103605118 & Lean 4 Law 3 (euler_disclination_dipole_charge_neutrality)" ;
        schema:value "0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-worker-to-reproductive-transition-lambda-1-30-paired-5-7-disclination-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Worker-to-reproductive transition (lambda = 1.30) paired 5-7 disclination count = 6 pairs" ;
        dcterms:description "n_pentagons(z=5) = 6, n_heptagons(z=7) = 6" ;
        schema:measurementTechnique "Delaunay topological coordination analysis across worker (4.6 mm) to reproductive (6.0 mm) cell transition" ;
        schema:name "Worker-to-reproductive transition (lambda = 1.30) paired 5-7 disclination count" ;
        schema:unitText "pairs" ;
        schema:value "6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-worker-to-reproductive-transition-lambda-1-30-paired-5-7-disclination-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-worker-to-reproductive-transition-lambda-1-30-paired-5-7-disclination-count-reference> a schema:PropertyValue ;
        dcterms:source "Smith, Napp, Gravish, Seeley & Petersen (2021) PNAS 118:e2103605118 Figs. 2-3" ;
        schema:value "6" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1998-bonabeau-social-wasp-comb-hexagons.py L589–L684" ;
        dcterms:description "9 quantitative morphometrics with p-values, RMSE, Eden negative control, 5-7 Euler neutrality, and Polistes comb CV segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L589-L684> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Karsai & Pénzes (1993) J. Theor. Biol., Theraulaz & Bonabeau (1995) Science & Smith et al. (2021) PNAS stigmergic hexagonal wasp comb architecture, shared-wall pulp economy & 5-7 topological disclination pairs — Morphometric validation: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L589-684) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: 8-ring W(R)/N(R) Pearson r = 0.9997 (p = 4.43e-11, RMSE = 0.0212), 7-point beta sweep Pearson r = 0.9919 (p = 1.12e-5, RMSE = 0.0487), WT 6-ring W/N = 3.315 (ref 3.3071), 6-ring pulp savings 44.88% (ref 44.88%), Eden random negative control W/N = 4.252 (ref 4.18), lambda = 1.30 caste step 5-7 defect count 6 pairs (ref 6), net Euler topological charge 0 (ref 0), specimen interior coordination <z_int> = 5.862 ± 0.893 (ref 6.0), and specimen segmented brood cell count 169 (ref 169)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-concentric-ring-progression-r-0-7-wall-to-cell-ratio-w-r-n-r-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-eden-random-growth-negative-control-beta-0-0-n-127-wall-to-cell-ratio-w-n>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-interior-cell-coordination-number-z-int>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-segmented-brood-cell-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-stigmergic-selectivity-sweep-beta-0-0-5-5-wall-to-cell-ratio-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-n-127-beta-5-5-wall-to-cell-ratio-w-n>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-paper-pulp-wall-savings-percentage>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-worker-to-reproductive-transition-lambda-1-30-net-euler-topological-charge>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-worker-to-reproductive-transition-lambda-1-30-paired-5-7-disclination-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-morphometric-validation-1> ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bonabeau-social-wasp-comb-hexagons> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Karsai & Pénzes (1993) J. Theor. Biol., Theraulaz & Bonabeau (1995) Science & Smith et al. (2021) PNAS stigmergic hexagonal wasp comb architecture, shared-wall pulp economy & 5-7 topological disclination pairs — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements centered hexagonal ring progression and shared-wall economy (`compute_centered_hex_economy`, L126-152), a stochastic Boltzmann stigmergic 2D/3D hexagonal lattice builder (`simulate_stigmergic_wasp_comb`, L173-277), and worker-to-reproductive cell size transitions with paired 5-7 topological disclination dipoles (`simulate_caste_transition_disclinations`, L377-464), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_096_social_wasp_comb_hexagons.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1998-bonabeau-social-wasp-comb-hexagons.py L126–L277" ;
        dcterms:description "Centered hexagonal ring economy N(R)=1+3R(R+1), W(R)=3N(R)+6R+3, and stochastic Boltzmann stigmergic lattice builder" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L126-L277> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1998-bonabeau-social-wasp-comb-hexagons.py L377–L464" ;
        dcterms:description "Smith et al. (2021) worker-to-reproductive cell size transition inducing paired 5-7 disclination dipoles with zero net Euler charge" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L377-L464> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_096_social_wasp_comb_hexagons.lean L16–L115" ;
        dcterms:description "3 standalone Lean 4 theorems proving centered hexagonal ring progression, shared-wall pulp economy, and 5-7 disclination Euler charge neutrality (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_096_social_wasp_comb_hexagons.lean#L16-L115> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

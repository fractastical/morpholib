sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bonabeau-social-wasp-comb-hexagons> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Karsai & Pénzes (1993) J. Theor. Biol., Theraulaz & Bonabeau (1995) Science & Smith et al. (2021) PNAS stigmergic hexagonal wasp comb architecture, shared-wall pulp economy & 5-7 topological disclination pairs — Parameter expressivity: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Spans the 8-ring centered hexagonal economy progression R in [0, 7] (L283-319), the 7-point stigmergic selectivity sweep beta in [0.0, 5.5] across 6 Monte Carlo replicates per point (L322-371), 5 topological and ablation controls including lambda in [1.00, 1.40] and beta = 0.0 Eden random growth (L467-502), and exposes `--beta`, `--n-cells`, `--size-ratio-lambda`, and `--seed` CLI overrides (L665-691)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-parameter-expressivity-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1998-bonabeau-social-wasp-comb-hexagons.py L283–L502" ;
        dct:description "8-ring economy trajectory, 7-point beta selectivity sweep, and 5 topological/ablation controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L283-L502> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1998-bonabeau-social-wasp-comb-hexagons.py L665–L691" ;
        dct:description "CLI overrides for beta, n_cells, size_ratio_lambda, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L665-L691> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 096 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-concentric-ring-progression-r-0-7-wall-to-cell-ratio-w-r-n-r-correlation>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-eden-random-growth-negative-control-beta-0-0-n-127-wall-to-cell-ratio-w-n>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-interior-cell-coordination-number-z-int>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-specimen-polistes-wasp-comb-segmented-brood-cell-count>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-stigmergic-selectivity-sweep-beta-0-0-5-5-wall-to-cell-ratio-correlation>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-measurement-wild-type-polistes-6-ring-comb-n-127-beta-5-5-wall-to-cell-ratio-w-n>,

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bonabeau-social-wasp-comb-hexagons> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Karsai & Pénzes (1993) J. Theor. Biol., Theraulaz & Bonabeau (1995) Science & Smith et al. (2021) PNAS stigmergic hexagonal wasp comb architecture, shared-wall pulp economy & 5-7 topological disclination pairs — Morphological realism / specimen match: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY 2.0 Polistes paper wasp comb photograph `datasets/social_wasp_comb_hexagons/polistes_wasp_comb_specimen.jpg`, segments n = 169 brood cell cavities via Difference-of-Gaussians filtering, and constructs the Delaunay neighbor graph with empirical interior coordination number <z_int> = 5.862 ± 0.893 (matching hexagonal coordination z = 6.0) and nearest-neighbor spacing 16.55 ± 4.26 px (`segment_polistes_comb_specimen`, L508-578)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1998-bonabeau-social-wasp-comb-hexagons.py L508–L578" ;
        dct:description "DoG dark-cavity detection and Delaunay neighbor graph on polistes_wasp_comb_specimen.jpg (n=169 cells, <z_int>=5.862)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/1998-bonabeau-social-wasp-comb-hexagons.py#L508-L578> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bonabeau-social-wasp-comb-hexagons-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/social_wasp_comb_hexagons_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing WT vs Eden comb, ring economy, beta sweep, 5-7 defects, and Polistes comb segmentation — docs/media/social_wasp_comb_hexagons_comparison.png: rendered output of 1998-bonabeau-social-wasp-comb-hexagons.py at e93f00e, image/png, 1143280 B, 2775×1680 px, artifact_sha256 83089887ecb6d2547717132ad5b16fce3140a45fb74fbd968349f993fb2d9325 (sha256 83089887ecb6d2547717132ad5b16fce3140a45fb74fbd968349f993fb2d9325), spec_fingerprint 6471896f9ec341c70d5d90fdfc768c186b2e5e7ed95f0e8568fe6372d790ffc3" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 096 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


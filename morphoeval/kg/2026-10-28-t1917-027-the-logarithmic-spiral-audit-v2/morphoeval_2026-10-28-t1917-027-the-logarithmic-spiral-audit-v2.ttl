<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Logarithmic spiral radius law" ;
    dct:description "Linear growth of ln r in θ (equiangular spiral) | Variables: r₀: aperture radius; k: log-spiral constant; θ: azimuth" ;
    dct:source "Thompson (1917) On Growth and Form Ch. XI pp. 493-586" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32/morphoeval/lean/loops/Thompson1917_T1917_027.lean>,
        <https://github.com/fractastical/morpholib/blob/f1d96f32/thompson/claims/t1917-027_the-logarithmic-spiral.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "r(θ) = r₀ exp(k θ)" ;
    prov:wasDerivedFrom <https://doi.org/10.2307/1301992> ;
    pk:hypothesisType "quantitative-geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_221.log_radius" ;
    pk:leanTheorem "MathOfBiology.Loop_221.log_polar_linearity" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Gnomonic whorl expansion invariance" ;
    dct:description "Form unchanged by multiplicative growth (Thompson whorves enlarge by constant ratio) | Variables: W: whorl expansion ratio; n: whorl index" ;
    dct:source "Thompson (1917) Ch. XI; Raup (1966) coordinate formalism" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32/morphoeval/lean/loops/Thompson1917_T1917_027.lean>,
        <https://github.com/fractastical/morpholib/blob/f1d96f32/thompson/claims/t1917-027_the-logarithmic-spiral.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "r_{n+1} = W r_n,  W = exp(2π k)" ;
    prov:wasDerivedFrom <https://doi.org/10.2307/1301992> ;
    pk:hypothesisType "quantitative-geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_221.radius_after_whorls" ;
    pk:leanTheorem "MathOfBiology.Loop_221.gnomonic_whorl_scaling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-027-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Log-spiral vs Archimedean discrimination" ;
    dct:description "Negative control model class for Pass 2 AICc discrimination | Variables: a, b: Archimedean parameters" ;
    dct:source "Thompson (1917) contrast with non-gnomonic spirals" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32/morphoeval/lean/loops/Thompson1917_T1917_027.lean>,
        <https://github.com/fractastical/morpholib/blob/f1d96f32/thompson/claims/t1917-027_the-logarithmic-spiral.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Archimedean r = a + bθ is not log-linear in θ for b ≠ 0" ;
    prov:wasDerivedFrom <https://doi.org/10.2307/1301992> ;
    pk:hypothesisType "quantitative-geometric" ;
    pk:leanDeclaration "MathOfBiology.Loop_221.arch_radius" ;
    pk:leanTheorem "MathOfBiology.Loop_221.archimedean_not_log_linear_witness" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


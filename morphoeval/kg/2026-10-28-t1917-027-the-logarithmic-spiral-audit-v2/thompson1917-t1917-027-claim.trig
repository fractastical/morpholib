    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0000-0002-1825-0097> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://commons.wikimedia.org/wiki/File:Pu_-_Nautilus_pompilius_-_10.jpg>,
            <https://doi.org/10.2307/1301992> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form" .
    <https://commons.wikimedia.org/wiki/File:Pu_-_Nautilus_pompilius_-_10.jpg> dct:title "Pu - Nautilus pompilius - 10" .
    <https://doi.org/10.2307/1301992> dct:date "1966"^^xsd:gYear ;
        dct:title "Geometric Analysis of Shell Coiling" .
}


        <https://doi.org/10.1146/annurev-genet-102108-134216>,
        <https://doi.org/10.1371/journal.pgen.1000326> ;
    pk:externalAtlasDataset <https://www.gbif.org/species/search?q=Astyanax%20mexicanus> ;
    pk:fossilLineageGroup "Iconic Vertebrate Sensory & Dermal Specializations" ;
    pk:geologicalAgeMa 0e+00 ;
    pk:geologicalPeriod "Holocene Cave Morph (Extant)" ;

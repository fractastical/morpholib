<https://w3id.org/delphi/resource/math-law/delphi10000-astyanax-mexicanus-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Reaction Jacobian trace (stable without diffusion)" ;
    dct:description "homogeneous mode must decay | Variables: f_u, g_v at the Schnakenberg steady state, cleared by a factor of 5" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py#L85-L96>,

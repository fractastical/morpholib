sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Turing wavenumber at 666 nm in the Astyanax cave morph — Morphometric validation: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Eleven Fourier modes give Pearson r = 0.99997 and RMSE = 0.00455 against the analytical growth rate. The nonlinear radial peak is 660.7 nm against the 665.6 nm linear calibration (about 0.7 percent low). sigma(0) = -0.1. The voucher melanin-dark fraction is 0.002, against an Oca2-null reference of 0. No KS test and no ablation metric are in the pass-1 table." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-dispersion-growth-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-dispersion-growth-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-homogeneous-mode-growth>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-specimen-melanin-dark-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-specimen-stripe-wavelength-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-dispersion-growth-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_growth_pearson_r = 0.9999681838003501 1" ;
        schema:measurementTechnique "Pearson r between closed-form Turing growth rates and forward-Euler Fourier-mode slopes" ;
        schema:name "dispersion_growth_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.9999681838003501" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-dispersion-growth-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-dispersion-growth-pearson-r-reference> a schema:PropertyValue ;
        dct:source "exact eigenvalue of the linearised Schnakenberg Jacobian" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-dispersion-growth-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion_growth_rmse = 0.004547985598148426 1/time" ;
        schema:measurementTechnique "RMSE of Euler growth rates against analytical sigma(k), dt=0.1" ;
        schema:name "dispersion_growth_rmse" ;
        schema:unitText "1/time" ;
        schema:value "0.004547985598148426" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-dispersion-growth-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-dispersion-growth-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual would be the continuous-time limit" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-homogeneous-mode-growth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "homogeneous_mode_growth = -0.09999999999999998 1/time" ;
        schema:measurementTechnique "sigma(k=0) of the Schnakenberg Jacobian; must be negative (stable without diffusion)" ;
        schema:name "homogeneous_mode_growth" ;
        schema:unitText "1/time" ;
        schema:value "-0.09999999999999998" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-homogeneous-mode-growth-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-homogeneous-mode-growth-reference> a schema:PropertyValue ;
        dct:source "trace of the reaction Jacobian is -0.2 at gamma=1 before diffusion rescaling" ;
        schema:value "-0.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-specimen-melanin-dark-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_melanin_dark_fraction = 0.002041123521088599 1" ;
        schema:measurementTechnique "fraction of body-mask pixels with max channel < 0.22 and low saturation on the CC voucher" ;
        schema:name "specimen_melanin_dark_fraction" ;
        schema:unitText "1" ;
        schema:value "0.002041123521088599" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-specimen-melanin-dark-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-specimen-melanin-dark-fraction-reference> a schema:PropertyValue ;
        dct:source "Oca2-null albinism limit (no melanin-dark pixels). Not a count fitted to this photograph." ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-specimen-stripe-wavelength-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_stripe_wavelength_nm = 660.6743783241391 nm" ;
        schema:measurementTechnique "radial FFT peak of the nonlinear patch, converted with the linear-mode calibration meters/px" ;
        schema:name "specimen_stripe_wavelength_nm" ;
        schema:unitText "nm" ;
        schema:value "660.6743783241391" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-specimen-stripe-wavelength-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-measurement-specimen-stripe-wavelength-nm-reference> a schema:PropertyValue ;
        dct:source "cellular sibling wavelength 2.418e-5 m (24 µm slot), not a fit target" ;
        schema:value "24180.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py L111–L162" ;
        dct:description "forward-Euler dispersion goodness of fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py#L111-L162> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-astyanax-mexicanus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py L353–L410" ;
        dct:description "measure_morphoeval metrics, references differ from values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-astyanax-mexicanus-turing-wavelength-s0.py#L353-L410> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Anchiornis huxleyi Turing wavenumber at 2.0 nm (Late Jurassic, 160.0 Ma) — Model fidelity to source: 91/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Unchanged governing system from pass 1: Schnakenberg steady state, Jacobian, dispersion, k_c inside the unstable band, and det=(a+b)^2. Five Lean theorems, 0 sorry, encode the trace sign, positive determinant, Dv/Du>40, the rounded band, and the factor-of-14 gap versus the 29 nm envelope. The pass-2 figure now shows the equal-diffusion field that the algebra says must decay. Still a reconstruction: Li et al. 2010 do not print this PDE." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9.1e-01 ;
    pk:hasVerdict "faithful" .


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Anchiornis huxleyi Turing wavenumber at 2.0 nm (Late Jurassic, 160.0 Ma) — Morphological realism / specimen match: 86/100" ;

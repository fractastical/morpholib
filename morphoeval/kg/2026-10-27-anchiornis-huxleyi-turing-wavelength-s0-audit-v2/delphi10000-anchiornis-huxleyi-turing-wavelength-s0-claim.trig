        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Anchiornis huxleyi Turing wavenumber at 2.0 nm (Late Jurassic, 160.0 Ma) faithfully reproduces Anchiornis huxleyi morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Anchiornis huxleyi specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py; output: docs/media/anchiornis_huxleyi_turing_wavelength_s0_comparison.png; organism: Anchiornis huxleyi; environment: n/a; claim_boundary: [reported_in_source: Xu et al. 2009: Anchiornis huxleyi holotype IVPP V14378, Tiaojishan Formation, pennaceous feathers on forelimbs and hindlimbs. | Li et al. 2010: melanosome shape is the evidence for Anchiornis plumage color. Organelle lengths are hundreds of nanometres. | Turing 1952: a critical wavenumber k_c when the inhibitor diffuses sufficiently faster than the activator. | Watt, Bothma and Meredith 2009: eumelanin is a stacked oligomeric sheet at nanometre scale.; reconstructed_in_script: Schnakenberg kinetics and the dispersion relation, with parameters chosen for this 2.0 nm detail slot. | Length unit that places analytical lambda_c at 2.0e-9 m. | Equal-diffusion ablation drawn as a field, Dv sweep, pure-mode growth-rate fit, and a second holotype ROI. | Final GIF frame: holotype photograph times a weak function of the simulated field.; transfer_boundary: 2.0 nm is the assigned detail scale identified with the melanin sheet mode. Li et al. 2010 did not measure 2.0 nm. | The museum photograph is not a 2 nm micrograph. Image fitness compares the registered final frame to that photograph.; does_not_claim: That Schnakenberg kinetics are the Anchiornis melanin pathway. | That a successor chronospecies of Anchiornis exists in this series. | That slot 1229 parameters were copied. That slot publishes none. | That these nanopublications were cryptographically signed. No nanopub profile was present.]; phenomenon_size: 2.5 nm (2.5e-09 m, log10=-8.602 m, tier=1_molecular_nm); species_scale_ladder (10 runs from 2.5 nm to 1.3 µm): 2.5 nm:anchiornis-huxleyi-vertex-packing, 2.5 nm:anchiornis-huxleyi-bioelectric-polarity, 29 nm:anchiornis-huxleyi-turing-wavelength, 58 nm:anchiornis-huxleyi-clock-wavefront, 130 nm:anchiornis-huxleyi-morphogen-condensation, 159 nm:anchiornis-huxleyi-elastic-buckling, 181 nm:anchiornis-huxleyi-flux-canalization, 253 nm:anchiornis-huxleyi-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1007/s11434-009-0009-6>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1039/b902507c>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1600-0749.2006.00345.x>,
            <https://doi.org/10.1126/science.1186290> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-anchiornis-huxleyi-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


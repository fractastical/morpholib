sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Anchiornis huxleyi Turing wavenumber at 2.0 nm (Late Jurassic, 160.0 Ma) — Morphological realism / specimen match: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Holotype photograph, wide-ROI mask, patterned field, and the decayed control field are in the comparison figure. Wide foreground fraction 0.921 and tight foreground fraction 0.929 (delta -0.0082), so the fossil occupancy is not an artifact of one crop. The GIF last frame remains the holotype with a weak field modulation; CV similarity is 96.0 at 12 frames and 640x480. The developing frames are still a periodic molecular patch, which is why this is not a higher score." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-anchiornis-huxleyi-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.86"^^xsd:double ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the nonlinear Föppl-von Kármán + vertex monolayer ring energy functional minimized via L-BFGS-B under unilateral spherical alginate wall confinement (`solve_confined_cyst_ring`), backed by 5 formal Lean 4 theorems in `Loop_069_epithelioid_cyst_buckling.lean` (0 sorry)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L130–L275" ;
        dcterms:description "L-BFGS-B Föppl-von Kármán confined ring energy minimizer with n=1 vs n=2 mode selection" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/2019-trushko-epithelioid-cyst-buckling.py#L130-L275> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean L1–L95" ;
        dcterms:description "5 machine-checked Lean 4 theorems for Zoelly buckling and capsule confinement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/morphoeval/lean/loops/Loop_069_epithelioid_cyst_buckling.lean#L1-L95> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon + Claude Sonnet 5.5 High (MorphoEval Autonomous Loop Slot 069 Pass 2 Dual-Agent Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Code-to-model traceability: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Links every solver function to Trushko et al. (2020), Hannezo et al. (2014), Zoelly (1915), and the 5 theorems in `Loop_069_epithelioid_cyst_buckling.lean` via `morphoeval/math_kg_loops/trushko-epithelioid-cyst-buckling.yaml`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-1> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/trushko-epithelioid-cyst-buckling.yaml L1–L130" ;
        dct:description "Per-loop Math KG specification mapping 5 equations to Lean 4 and Python lines" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/33e07ad/morphoeval/math_kg_loops/trushko-epithelioid-cyst-buckling.yaml#L1-L130> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon + Claude Sonnet 5.5 High (MorphoEval Autonomous Loop Slot 069 Pass 2 Dual-Agent Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


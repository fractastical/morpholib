sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-trushko-epithelioid-cyst-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Trushko et al. (2020) Dev. Cell & Hannezo et al. (2014) PNAS Föppl-von Kármán spherical epithelial cyst buckling under alginate confinement — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "12-point Zoelly critical buckling pressure scaling achieves r = 1.0000 (p = 2.09e-28) with log-log slope 1.990 vs theoretical 2.00; WT post-confluence fold depth trajectory achieves r = 0.9927 (RMSE = 0.0434)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-25-um-myosin-ii-inhibited-capsule-inward-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-e-alg-7-5-kpa-r0-140-um-h-r0-0-070-n-2-bilateral-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-log-log-thickness-to-radius-scaling-exponent-alpha-in-pc-e-epi-h-r0-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-post-confluence-invagination-trajectory-delta-t-r0-correlation-0-to-11-h-post-confluence>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-lumen-contour-circularity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-thickness-to-radius-ratio-h-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-stiff-alginate-capsule-e-alg-5-kpa-r0-100-um-n-1-inward-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-unconfined-ultra-soft-alginate-negative-control-e-alg-0-4-kpa-p-pc-fold-depth-delta-r0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-zoelly-12-capsule-critical-buckling-pressure-pc-correlation-mdck-ii-caco-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-25-um-myosin-ii-inhibited-capsule-inward-fold-depth-delta-r0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Blebbistatin (25 uM) myosin-II inhibited capsule inward fold depth delta/R0 = 0.3563 dimensionless (delta / R_0)" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán ring relaxation under reduced cortical modulus E_epi = 10.8 kPa and active myosin contractility Gamma_myo = 0.15" ;
        schema:name "Blebbistatin (25 uM) myosin-II inhibited capsule inward fold depth delta/R0" ;
        schema:unitText "dimensionless (delta / R_0)" ;
        schema:value "0.3563" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-25-um-myosin-ii-inhibited-capsule-inward-fold-depth-delta-r0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-blebbistatin-25-um-myosin-ii-inhibited-capsule-inward-fold-depth-delta-r0-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 6" ;
        schema:value "0.385" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-e-alg-7-5-kpa-r0-140-um-h-r0-0-070-n-2-bilateral-fold-depth-delta-r0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Large thin-walled capsule (E_alg=7.5 kPa, R0=140 um, h/R0=0.070, n=2) bilateral fold depth delta/R0 = 0.5403 dimensionless (delta / R_0)" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán + vertex ring energy minimization selecting mode n = 2 at h/R_0 = 0.070 < 0.082" ;
        schema:name "Large thin-walled capsule (E_alg=7.5 kPa, R0=140 um, h/R0=0.070, n=2) bilateral fold depth delta/R0" ;
        schema:unitText "dimensionless (delta / R_0)" ;
        schema:value "0.5403" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-e-alg-7-5-kpa-r0-140-um-h-r0-0-070-n-2-bilateral-fold-depth-delta-r0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-large-thin-walled-capsule-e-alg-7-5-kpa-r0-140-um-h-r0-0-070-n-2-bilateral-fold-depth-delta-r0-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 4" ;
        schema:value "0.568" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-log-log-thickness-to-radius-scaling-exponent-alpha-in-pc-e-epi-h-r0-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Log-log thickness-to-radius scaling exponent alpha in Pc / E_epi ~ (h / R0)^alpha = 1.9903 dimensionless exponent" ;
        schema:measurementTechnique "OLS log-log slope of P_c / E_epi versus (h / R_0) across 12 capsules (R_0 in [58, 150] um)" ;
        schema:name "Log-log thickness-to-radius scaling exponent alpha in Pc / E_epi ~ (h / R0)^alpha" ;
        schema:unitText "dimensionless exponent" ;
        schema:value "1.9903" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-log-log-thickness-to-radius-scaling-exponent-alpha-in-pc-e-epi-h-r0-alpha-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-log-log-thickness-to-radius-scaling-exponent-alpha-in-pc-e-epi-h-r0-alpha-reference> a schema:PropertyValue ;
        dct:source "Zoelly (1915) ETH Zurich; Trushko et al. (2020) Dev. Cell Eq. (1)" ;
        schema:value "2.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-post-confluence-invagination-trajectory-delta-t-r0-correlation-0-to-11-h-post-confluence> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Post-confluence invagination trajectory delta(t)/R0 correlation (0 to 11 h post-confluence) = 0.9978 Pearson r" ;
        schema:measurementTechnique "Pearson correlation between simulated and experimental post-confluence fold depth trajectory delta(t)/R_0" ;
        schema:name "Post-confluence invagination trajectory delta(t)/R0 correlation (0 to 11 h post-confluence)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9978" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-post-confluence-invagination-trajectory-delta-t-r0-correlation-0-to-11-h-post-confluence-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-post-confluence-invagination-trajectory-delta-t-r0-correlation-0-to-11-h-post-confluence-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 2E" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-lumen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Segmented epithelial cyst histology specimen lumen contour circularity = 0.8484 4*pi*Area/Perimeter^2" ;
        schema:measurementTechnique "Connected-component boundary extraction and isoperimetric circularity across n=19 confluent cysts" ;
        schema:name "Segmented epithelial cyst histology specimen lumen contour circularity" ;
        schema:unitText "4*pi*Area/Perimeter^2" ;
        schema:value "0.8484" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-lumen-contour-circularity-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-lumen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 2; Wikimedia File:Thyroid_follicle.jpg" ;
        schema:value "0.65" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-thickness-to-radius-ratio-h-r0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Segmented epithelial cyst histology specimen thickness-to-radius ratio h/R0 = 0.1063 dimensionless (h / R_0)" ;
        schema:measurementTechnique "Euclidean distance transform wall thickness and equivalent lumen radius segmentation on epithelioid_cyst_specimen.jpg" ;
        schema:name "Segmented epithelial cyst histology specimen thickness-to-radius ratio h/R0" ;
        schema:unitText "dimensionless (h / R_0)" ;
        schema:value "0.1063" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-thickness-to-radius-ratio-h-r0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-segmented-epithelial-cyst-histology-specimen-thickness-to-radius-ratio-h-r0-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 1; Wikimedia File:Thyroid_follicle.jpg" ;
        schema:value "0.105" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-stiff-alginate-capsule-e-alg-5-kpa-r0-100-um-n-1-inward-fold-depth-delta-r0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Standard stiff alginate capsule (E_alg=5 kPa, R0=100 um, n=1) inward fold depth delta/R0 = 0.5619 dimensionless (delta / R_0)" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán + vertex ring energy minimization at post-confluence stretch g = 1.52" ;
        schema:name "Standard stiff alginate capsule (E_alg=5 kPa, R0=100 um, n=1) inward fold depth delta/R0" ;
        schema:unitText "dimensionless (delta / R_0)" ;
        schema:value "0.5619" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-stiff-alginate-capsule-e-alg-5-kpa-r0-100-um-n-1-inward-fold-depth-delta-r0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-standard-stiff-alginate-capsule-e-alg-5-kpa-r0-100-um-n-1-inward-fold-depth-delta-r0-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 2" ;
        schema:value "0.642" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-unconfined-ultra-soft-alginate-negative-control-e-alg-0-4-kpa-p-pc-fold-depth-delta-r0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Unconfined / ultra-soft alginate negative control (E_alg=0.4 kPa, P < Pc) fold depth delta/R0 = 0.0 dimensionless (delta / R_0)" ;
        schema:measurementTechnique "Subcritical confinement pressure P_alg = 0.105 kPa < P_c = 0.264 kPa yielding unbuckled spherical monolayer" ;
        schema:name "Unconfined / ultra-soft alginate negative control (E_alg=0.4 kPa, P < Pc) fold depth delta/R0" ;
        schema:unitText "dimensionless (delta / R_0)" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-unconfined-ultra-soft-alginate-negative-control-e-alg-0-4-kpa-p-pc-fold-depth-delta-r0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-unconfined-ultra-soft-alginate-negative-control-e-alg-0-4-kpa-p-pc-fold-depth-delta-r0-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Fig. 1" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-zoelly-12-capsule-critical-buckling-pressure-pc-correlation-mdck-ii-caco-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Zoelly 12-capsule critical buckling pressure Pc correlation (MDCK II & Caco-2) = 1.0 Pearson r" ;
        schema:measurementTechnique "12-capsule linear correlation between Zoelly spherical shell P_c = (2*E_epi/sqrt(3*(1-nu^2)))*(h/R_0)^2 and experimental critical pressure" ;
        schema:name "Zoelly 12-capsule critical buckling pressure Pc correlation (MDCK II & Caco-2)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-zoelly-12-capsule-critical-buckling-pressure-pc-correlation-mdck-ii-caco-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-measurement-zoelly-12-capsule-critical-buckling-pressure-pc-correlation-mdck-ii-caco-2-reference> a schema:PropertyValue ;
        dct:source "Trushko et al. (2020) Dev. Cell 54:655-668 Figs. 3-4" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-trushko-epithelioid-cyst-buckling-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2019-trushko-epithelioid-cyst-buckling.py L586–L695" ;
        dct:description "Rich measure_morphoeval() dictionary with Zoelly r=1.0000, trajectory r=0.9927, and 19-cyst CV stats" ;

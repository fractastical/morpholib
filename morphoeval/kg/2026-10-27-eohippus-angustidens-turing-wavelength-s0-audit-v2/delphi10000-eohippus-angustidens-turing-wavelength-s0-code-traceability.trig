        rdfs:label "morphoeval/math_kg_loops/delphi10000-eohippus-angustidens-turing-wavelength-s0.yaml L1–L55" ;
        dct:description "four laws with lean and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b6fee985871268f23e54cff46ae5985cc017a4e8/morphoeval/math_kg_loops/delphi10000-eohippus-angustidens-turing-wavelength-s0.yaml#L1-L55> .

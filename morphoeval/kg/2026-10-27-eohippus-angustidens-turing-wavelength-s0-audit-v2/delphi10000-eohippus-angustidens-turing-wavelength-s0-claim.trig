sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Eohippus angustidens Schnakenberg wavelength at 78 µm (Wasatchian, 52.0 Ma) faithfully reproduces Eohippus angustidens morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Eohippus angustidens specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py; output: docs/media/eohippus_angustidens_turing_wavelength_s0_comparison.png; organism: Eohippus angustidens; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion, Schnakenberg 1979 kinetics, Murray 1981 k_c. | Kondo and Miura 2010: pigment spacing of several cell diameters. Here 77.52/12 = 6.46 cells. | MacFadden 1986 body-size scaling from Eohippus to Equus; Froehlich 2002 early Eocene taxonomy.; reconstructed_in_script: Grid diffusivities are the unique solution of the k_c formula at ratio 8.22 for lambda_c = 7.752e-05 m and lambda_px = 14. | Final GIF frame blends the saturated field at weight 0.55 with the gallery plate. The weight table is stored in the metrics JSON.; transfer_boundary: From this 1/1 Wasatchian stage to Orohippus, cellular lambda_c is predicted not to track Cope's Law. Organ-scale stripe number can. | The detail wavenumber is between 42 and 43 times the 3.3 mm organ-tier sibling. Kinetics were not copied from that sibling.; does_not_claim: No fossil integument measurement of a 78 µm Eohippus stripe is claimed. | The negative aligned-lattice Pearson is the evidence that the render is not the plate. | Nanopublications were not signed; no profile was present.]; phenomenon_size: 66 µm (6.596e-05 m, log10=-4.181 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 66 µm to 14.8 cm): 66 µm:eohippus-angustidens-bioelectric-polarity, 206 µm:eohippus-angustidens-vertex-packing, 3.3 mm:eohippus-angustidens-turing-wavelength, 6.6 mm:eohippus-angustidens-clock-wavefront, 1.5 cm:eohippus-angustidens-morphogen-condensation, 1.8 cm:eohippus-angustidens-elastic-buckling, 2.1 cm:eohippus-angustidens-flux-canalization, 2.9 cm:eohippus-angustidens-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1017/s0094837300003109>,
            <https://doi.org/10.1046/j.1096-3642.2002.00005.x>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


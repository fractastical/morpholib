    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Eohippus angustidens Schnakenberg wavelength at 78 µm (Wasatchian, 52.0 Ma) — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Formula lambda decreases monotonically from 81.91 µm at ratio 5 to 74.32 µm at ratio 18 (shift 7.59 µm, reference 0). sigma_max is negative at ratios 5, 6, and 7 and then rises through 0.047, 0.183, 0.302. The PDE ablation at equal diffusion drops the activator std from 0.119 to 6.1e-5." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Eohippus angustidens Schnakenberg wavelength at 78 µm (Wasatchian, 52.0 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Jacobian, sigma(k), critical ratio, and k_c are the published objects, and the numerical growth-rate curve matches the eigenvalue at r = 0.997. Lean proves trace < 0, det > 0, equal-diffusion stability, the ratio-8.22 band inequality, the 6-to-7-cell bracket, the 42-to-43 wavenumber bracket, and the 52-before-48 Ma order. Deduction: diffusivities are scale-assigned." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py L64–L118" ;
        dct:description "Jacobian through sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py#L64-L118> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py L192–L222" ;
        dct:description "numerical sigma from ring-averaged power, the executed probe" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py#L192-L222> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3219_eohippus_angustidens_turing_wavelength_s0.lean L19–L49" ;
        dct:description "seven theorems, 0 sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3219_eohippus_angustidens_turing_wavelength_s0.lean#L19-L49> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (single assessor; pass 2 of the same cloud loop)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


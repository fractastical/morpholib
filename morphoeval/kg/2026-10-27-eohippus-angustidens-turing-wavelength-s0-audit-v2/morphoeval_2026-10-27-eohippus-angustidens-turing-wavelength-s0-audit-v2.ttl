<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Eohippus angustidens Schnakenberg wavelength at 78 µm (Wasatchian, 52.0 Ma) — Model fidelity to source: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Jacobian, sigma(k), critical ratio, and k_c are the published objects, and the numerical growth-rate curve matches the eigenvalue at r = 0.997. Lean proves trace < 0, det > 0, equal-diffusion stability, the ratio-8.22 band inequality, the 6-to-7-cell bracket, the 42-to-43 wavenumber bracket, and the 52-before-48 Ma order. Deduction: diffusivities are scale-assigned." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;

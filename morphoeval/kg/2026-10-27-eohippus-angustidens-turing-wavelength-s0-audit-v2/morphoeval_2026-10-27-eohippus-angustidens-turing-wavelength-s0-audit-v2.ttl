<https://w3id.org/delphi/resource/math-law/delphi10000-eohippus-angustidens-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Kinetic trace and determinant at the Schnakenberg steady state" ;
    dct:description "Homogeneous state of the 78 µm Eohippus patch is stable in the absence of diffusion | Variables: f_u, g_v scaled by 1e6 from the Jacobian of du/dt = a - u + u^2 v, dv/dt = b - u^2 v" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py#L64-L84>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3219_eohippus_angustidens_turing_wavelength_s0.lean#L19-L24> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0 at (a, b) = (0.062, 0.940)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/s0094837300003109>,
        <https://doi.org/10.1046/j.1096-3642.2002.00005.x>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3219.detJ" ;
    pk:leanTheorem "MathOfBiology.Loop_3219.trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eohippus-angustidens-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber at diffusion ratio 8.22" ;
    dct:description "Selects the cellular-detail pigment wavelength (78 µm, about 6.5 keratinocyte diameters) | Variables: r = 8.22 is this slot's ratio; lambda_c = 7.752e-05 m is the target, not the 3.3 mm organ-tier sibling" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py#L99-L118>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3219_eohippus_angustidens_turing_wavelength_s0.lean#L32-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), with D_v/D_u = 822/100, and (r f_u + g_v)^2 > 4 r det(J)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/s0094837300003109>,
        <https://doi.org/10.1046/j.1096-3642.2002.00005.x>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3219.fu" ;
    pk:leanTheorem "MathOfBiology.Loop_3219.differential_diffusion_selects_a_band" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eohippus-angustidens-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal diffusion does not select a band" ;
    dct:description "Negative control for the 78 µm pattern | Variables: same Jacobian as the patterned run; only the diffusion ratio changes" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py#L455-L458>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3219_eohippus_angustidens_turing_wavelength_s0.lean#L27-L29> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(f_u + g_v)^2 < 4 det(J) when D_v = D_u" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/s0094837300003109>,
        <https://doi.org/10.1046/j.1096-3642.2002.00005.x>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3219.detJ" ;
    pk:leanTheorem "MathOfBiology.Loop_3219.equal_diffusion_is_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-eohippus-angustidens-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Detail wavenumber versus the organ-scale sibling and the Bridgerian successor" ;
    dct:description "States what is conserved (cellular lambda_c) and what is not (organ stripe count, body size) at 52 Ma | Variables: organ sibling lambda = 0.003298 m; successor anchor = Orohippus at 48 Ma; this chronoseries is stage 1 of 1" ;
    dct:source "MacFadden 1986 DOI:10.1017/s0094837300003109; Froehlich 2002 DOI:10.1046/j.1096-3642.2002.00005.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-eohippus-angustidens-turing-wavelength-s0.py#L1-L20>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3219_eohippus_angustidens_turing_wavelength_s0.lean#L42-L49> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "42 < 0.003298 / 7.752e-05 < 43, and 52.0 Ma precedes the 48 Ma Orohippus anchor" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1017/s0094837300003109>,
        <https://doi.org/10.1046/j.1096-3642.2002.00005.x>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3219.detail_wavenumber_exceeds_organ_scale" ;
    pk:leanTheorem "MathOfBiology.Loop_3219.wasatchian_precedes_bridgerian_successor" ;
    pk:leanVerified true .


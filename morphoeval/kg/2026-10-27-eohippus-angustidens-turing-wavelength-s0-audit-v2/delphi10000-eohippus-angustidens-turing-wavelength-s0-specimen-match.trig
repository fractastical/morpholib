sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Eohippus angustidens Schnakenberg wavelength at 78 µm (Wasatchian, 52.0 Ma) — Morphological realism / specimen match: 81/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Side-by-side, the plate is a two-arm spiral and the PDE is a labyrinth at the same purple palette and a similar spatial frequency. CV similarity of the 12-frame 640×480 GIF against the plate is 88.8 at pattern weight 0.55 (the pattern is still the majority of the last frame). The weight table is 86.5, 87.3, 88.8, 91.6 at weights 1.00, 0.72, 0.55, 0.40. Topology is the reason this is not a 90." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.81"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-eohippus-angustidens-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;

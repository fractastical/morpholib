sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Source and data traceability: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`datasets/differential_adhesion_sorting/` carries the reference JSON (265 lines, 8 sources with DOIs), the SHA-256-pinned specimen verified fail-closed at runtime (`verify_reference_dataset`, L115-130; self-test check 1), `paper_citations.bib` (8 entries), `scout_manifest.json` and a README updated for Pass 3. Deductions: the three Pass 3 sources (Mombach 1995, Nakajima & Ishihara 2011, Chen 2007) have DOIs entered from memory and flagged `doi_verified_offline: false` in the JSON (L32-51), in the bib (L55-91) and in the module docstring (L72) — honest, but unverified (-5); the specimen's source page is a Wikimedia Commons upload with no species or staining metadata (README L25-27) (-2); the empirical reference values 0.14 / 0.72 used in two measurements are not traced to any table (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/differential_adhesion_sorting/paper_citations.bib L55–L91: Pass 3 BibTeX entries for Mombach 1995, Nakajima & Ishihara 2011, Chen 2007 with 'DOI not verified offline' notes <https://github.com/fractastical/morpholib/blob/654cd6fc/datasets/differential_adhesion_sorting/paper_citations.bib#L55-L91>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-source-traceability-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L115–L130" ;
        dct:description "Runtime SHA-256 verification of the specimen against both the hard-coded digest and the JSON digest" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L115-L130> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/differential_adhesion_sorting/differential_adhesion_sorting_reference.json L6–L52" ;
        dct:description "8 sources with DOIs; 3 Pass 3 entries flagged doi_verified_offline: false" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/datasets/differential_adhesion_sorting/differential_adhesion_sorting_reference.json#L6-L52> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/differential_adhesion_sorting/README.md L28–L37" ;
        dct:description "Pass 3 section documenting the 3D lattice parameters, kinetic laws and the optical-section mapping of the specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/datasets/differential_adhesion_sorting/README.md#L28-L37> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Parameter expressivity: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "All 5 regimes (Panels A1-A5), the 7-point J_AB sweep across both phase boundaries (`run_gamma_ab_sweep`, L528-560, Panel B2), the full 2D CLI (`--J-AA ... --seed`, L1646-1655) and, new in Pass 3, five 3D flags `--grid3d --mcs3d --T3d --lam3d --V0` (L1656-1660) wired through `run_all_regimes_and_render` (L1112-1117), plus the ablation (`cell_swaps=False`) and the 3D equal-adhesion control (L873-884). Deductions: no sweep exists in 3D (one J set, one T, one lambda_V), so the dependence of the 3D exponent on temperature or volume stiffness — the parameters that visibly misbehave (<v>/V_0 = 0.771) — is untested (-5); the 2D sweep runs 110 MCS at a single seed with no error bars (-2); the bias strength 1.8 (L394) and the swap temperature factor 2.5 (L396, L770) are hard-coded and not exposed (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L528–L560" ;
        dct:description "7-point continuous J_AB / gamma_AB sweep across mixing, complete engulfment and partial engulfment boundaries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L528-L560> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L1646–L1660" ;
        dct:description "Full 2D CLI plus Pass 3 3D flags --grid3d, --mcs3d, --T3d, --lam3d, --V0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L1646-L1660> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L873–L884" ;
        dct:description "3D canonical run, Kawasaki-swap ablation and 3D equal-adhesion control; no sweep over T3d or lambda_V" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L873-L884> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


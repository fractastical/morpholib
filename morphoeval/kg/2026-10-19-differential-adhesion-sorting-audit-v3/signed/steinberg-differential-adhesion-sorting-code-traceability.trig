sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Code-to-model traceability: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-73) maps the Pass 3 additions function-by-function to the Lean theorems, the Chen et al. (2007) parallel-update scheme and the LSW bound, and names its own honest limits (L34-37); `simulate_potts_regime_3d` (L661-686) documents the Hamiltonian, update scheme, parity lemma, volume approximation and temperature rescaling; the volume-increment lines cite the Lean theorem (L800-801) and self-test check 9 numerically mirrors theorems 5-6 (L1600-1606). The math KG YAML registers the 3 new theorems. Deductions: the bias field (L390-394) is commented as a \"weak symmetry-breaking axis\" but neither cited nor flagged as outside the Hamiltonian, and the swap temperature factor 2.5 (L396, L770) is uncited (-4); the self-test docstring says 13 checks but the numbered blocks run 1-7 then 9-13 (L1595-1632) (-1); the 2D MCS convention (L409) and the T = 30 / lambda_V = 2 rescaling (L681-683) are asserted, not derived (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1964-steinberg-differential-adhesion-sorting.py L390–L396: Bias field commented only as 'weak symmetry-breaking axis'; strength 1.8 and acceptance temperature 2.5 T uncited <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L390-L396>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-code-traceability-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L1–L73" ;
        dcterms:description "Module docstring: Pass 3 functions mapped to Lean theorems, Chen 2007 scheme, LSW bound and the 4 primary sources; limits stated at L34-37" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L1-L73> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L661–L686" ;
        dcterms:description "simulate_potts_regime_3d docstring: Hamiltonian, sublattice-parallel scheme, parity lemma, volume-term approximation, swap ablation and section metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L661-L686> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/steinberg-differential-adhesion-sorting.yaml L53–L90" ;
        dcterms:description "Pass 3 theorems parity_sublattice_sites_not_moore_adjacent, potts_volume_energy_single_voxel_increment, potts_volume_increment_sign registered" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/math_kg_loops/steinberg-differential-adhesion-sorting.yaml#L53-L90> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Reproducibility package: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` runs 13 checks in ~31 s (L1549-1641): SHA-256 and JSON structure, exact tension parity with Lean, sorting vs control vs checkerboard, log decay, specimen segmentation, Foty transitivity, two-run bitwise determinism for the 2D solver (L1596-1598) and for the 3D solver (L1628-1630), the parity lemma and volume-increment identity, 3D sorting vs 3D control with volume integrity, exponent windows and the 15-measurement contract. Default render ~29 s and the PNG is byte-identical across runs (telemetry step 6). Deductions: no requirements lock or pinned environment file for this slot (-3); the 3D volume self-test bound `0.6 < <v>/V_0 < 1.1` (L1616) is loose enough to pass a 23% volume deficit (-2); the GIF is regenerated but not checked for determinism (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1964-steinberg-differential-adhesion-sorting.py L1616–L1616: Loose volume bound 0.6 < <v>/V_0 < 1.1 passes the observed 0.771 <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L1616-L1616>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L1549–L1641" ;
        dct:description "13-check self_test(): SHA-256, Lean parity, regimes, specimen, Foty, 2D and 3D bitwise determinism, parity lemma, 3D sorting/volume, kinetics, measurement contract" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L1549-L1641> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L1628–L1630" ;
        dct:description "3D two-run bitwise determinism on sigma and cell_type" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L1628-L1630> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Morphological realism / specimen match: 87/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The SHA-256-verified confocal embryoid body specimen is segmented (L911-1010) into a GFP core (r_B/R = 0.49) and an RFP shell (r_A/R = 0.77, Delta_r = +0.28) and overlaid against the 2D Potts profile (Panel B4, r = 0.925, RMSE 0.210). Pass 3 adds the like-for-like comparator the specimen actually calls for — the equatorial z-section of the 3D spheroid (Panel C1, C4) — whose Delta_r_section = +0.224 is closer to the specimen's +0.279 than the 2D model's +0.367, and the 3D shells, section, 2D and specimen core profiles are drawn on one axis (L1317-1332). Deductions: the 3D-section profile correlation with the specimen (r = 0.758, RMSE 0.256, L1536-1538) is weaker than the 2D one, so the better-matched comparator in Delta_r is the worse-matched one in profile shape and the script does not reconcile the two (-4); the specimen is a Wikimedia Commons embryoid body of unspecified species, not a Steinberg/Foty chick aggregate, and panel crops, thresholds and the ROI radius are hard-coded pixel constants (L923-926, L936-937, L957) tuned to this one image (-5); the 3D section shows a visibly rougher core than the 2D panel (Panel C1) because cells are 23% under target volume (-2); the partial-engulfment lens of Panel A3 is produced with the bias field, so its visual match to Steinberg's lens is not a model outcome (-2). Credit for the explicit statement that the specimen is an optical section of a 3D spheroid (reference JSON L263)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1964-steinberg-differential-adhesion-sorting.py L1536–L1538: Measurement potts_3d_section_vs_specimen_radial_profile_pearson_r = 0.7584 against reference 0.95 — the like-for-like comparison is weaker than the 2D one <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L1536-L1538>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-3> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L911–L1010" ;
        dct:description "Confocal embryoid body GFP core and RFP shell segmentation and 12-annulus radial profile comparison (hard-coded crops/thresholds)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L911-L1010> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1964-steinberg-differential-adhesion-sorting.py L1317–L1332" ;
        dct:description "Panel C4: 3D shells, 3D z-section, 2D native and confocal specimen core profiles on one axis (3D section r = 0.758 vs 2D native r = 0.925)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1964-steinberg-differential-adhesion-sorting.py#L1317-L1332> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/differential_adhesion_sorting_comparison.png (generated output)" ;
        dct:description "15-panel figure: 5 2D regimes (A), decay/sweep/specimen/profiles/Foty (B), 3D equatorial & meridional sections, log-log kinetics, section-vs-specimen profiles and exponent bars (C) — docs/media/differential_adhesion_sorting_comparison.png: rendered output of 1964-steinberg-differential-adhesion-sorting.py at 654cd6fc, image/png, 740753 B, 3000×1890 px, artifact_sha256 6046cb66ae62af9e47d3b593c06f690c6b389ec313e42183a47ccced8c8cf39f (sha256 6046cb66ae62af9e47d3b593c06f690c6b389ec313e42183a47ccced8c8cf39f), spec_fingerprint 439c3a9015bc8fdc9014e2aa3a89cd71cffc876fcd81d0cb0b2f88bbf798d5a9" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


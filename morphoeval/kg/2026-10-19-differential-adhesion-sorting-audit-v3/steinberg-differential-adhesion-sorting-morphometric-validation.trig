sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-steinberg-differential-adhesion-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Steinberg (1963, 1970) & Graner-Glazier (1992) differential adhesion cell sorting — Morphometric validation: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1426-1546) now returns 15 measurements with references and units: the 8 Pass 2 metrics (tensions, Delta_r 0.367 vs specimen 0.279, L_AB/L 0.181, checkerboard 0.724, control |Delta_r| 0.017, profile r 0.925, Foty 10/10) plus 7 Pass 3 kinetics/3D metrics (alpha_3D 0.215, alpha_2D 0.189, alpha_section 0.207, swap-ablation delta -0.013, Delta_r_3D 0.198, section-vs-specimen r 0.758, <v>/V_0 0.771). `fit_sorting_kinetics` (L486-525) fits both the Graner & Glazier logarithmic law and a power law and reports R^2 for each; the 3D control gives alpha = 0.001 as a true null. Deductions: the reference exponent 1/3 is the LSW diffusive bound for a different universality class, not a value measured for the CPM, and the Nakajima & Ishihara exponent is null in the JSON (L246), so alpha is compared against a theoretical bound rather than a literature measurement (-4); fits span the whole 0..200 MCS record including the initial transient and the two laws are not discriminated (3D R^2 0.9965 vs 0.9845; 2D 0.737 vs 0.769, log preferred), with no late-time window or multi-seed uncertainty (-3); the 2D L_AB/L reference 0.14 (L1465) and the checkerboard reference 0.72 (L1472) have no stated provenance (-2); boundary length in 3D is counted on 6 face bonds (L600) while the energy uses 26 neighbours — consistent with the 2D convention but uncited (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "datasets/differential_adhesion_sorting/differential_adhesion_sorting_reference.json L236–L264: sorting_kinetics_2d_vs_3d block: LSW 1/3 and log limit as reference exponents; Nakajima & Ishihara exponent explicitly null (not consulted offline) <https://github.com/fractastical/morpholib/blob/654cd6fc/datasets/differential_adhesion_sorting/differential_adhesion_sorting_reference.json#L236-L264>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-radial-core-shell-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-foty-1996-chick-embryo-hierarchy-concordance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-sorting>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-spreading-tension-diff>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-potts-2d-power-law-sorting-exponent>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-potts-3d-equatorial-section-power-law-exponent>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-potts-3d-kawasaki-swap-ablation-exponent-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-potts-3d-mean-cell-volume-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-potts-3d-power-law-sorting-exponent>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-potts-3d-radial-core-shell-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-potts-3d-section-vs-specimen-radial-profile-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-specimen-vs-potts-radial-profile-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-morphometric-validation-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "checkerboard_mixing_heterotypic_boundary_fraction = 0.7235 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_AB/L_total in checkerboard mixing regime (gamma_AB = -10 < 0)" ;
        schema:name "checkerboard_mixing_heterotypic_boundary_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.7235" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction-reference> .

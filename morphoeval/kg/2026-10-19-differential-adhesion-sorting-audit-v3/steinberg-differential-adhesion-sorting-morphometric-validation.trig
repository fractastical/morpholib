            pk:EvidenceItem ;
        rdfs:label "graner_glazier_spreading_tension_diff = 6.0 bond_energy_units" ;
        schema:measurementTechnique "Spreading tension difference gamma_BM - gamma_AM = (J_BM - J_BB/2) - (J_AM - J_AA/2) = 15 - 9 = 6 (Graner & Glazier 1992 PRL Eq. 3)" ;
        schema:name "graner_glazier_spreading_tension_diff" ;
        schema:unitText "bond_energy_units" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-spreading-tension-diff-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-spreading-tension-diff-reference> a schema:PropertyValue ;
        schema:value "6.0" .

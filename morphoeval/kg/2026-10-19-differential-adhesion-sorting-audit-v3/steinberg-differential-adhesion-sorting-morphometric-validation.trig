        schema:name "complete_engulfment_radial_core_shell_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.3672" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-complete-engulfment-radial-core-shell-separation-reference> .

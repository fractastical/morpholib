        schema:value "0.2793" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-equal-adhesion-control-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_adhesion_control_radial_separation = 0.0168 normalized_radius" ;
        schema:measurementTechnique "Null radial core-shell separation |r_A - r_B|/R_agg in equal-adhesion negative control (J_AA=J_BB=J_AB=10, gamma_AB=0)" ;

    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-sorting> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_gamma_AB_sorting = 3.0 bond_energy_units" ;
        schema:measurementTechnique "Exact Steinberg/Graner-Glazier interfacial tension gamma_AB = J_AB - (J_AA + J_BB)/2 for J_AA=14, J_BB=2, J_AB=11 (Graner & Glazier 1992 PRL Eq. 2)" ;
        schema:name "graner_glazier_gamma_AB_sorting" ;
        schema:unitText "bond_energy_units" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-sorting-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-steinberg-differential-adhesion-sorting-measurement-graner-glazier-gamma-ab-sorting-reference> a schema:PropertyValue ;
        schema:value "3.0" .

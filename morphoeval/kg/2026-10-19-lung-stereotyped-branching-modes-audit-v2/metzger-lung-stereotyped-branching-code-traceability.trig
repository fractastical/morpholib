        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O) and FGF10-SHH-Ptch1 Turing mode selection — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational section and docstring in `2008-metzger-lung-stereotyped-branching.py` maps explicitly to Metzger et al. (2008) Figs. 1-4, Menshykau et al. (2012, 2014) Eqs. 1-5, and the 3 machine-checked Lean 4 theorems in `Loop_053_lung_stereotyped_branching_modes.lean` (L1-35, L102-465)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L1–L35" ;
        dct:description "Header docstring cross-referencing all 4 papers and 3 Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L1-L35> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/metzger-lung-stereotyped-branching.yaml L1–L72" ;
        dct:description "Math KG loop registration linking equations, Lean 4 theorems, and Python code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/math_kg_loops/metzger-lung-stereotyped-branching.yaml#L1-L72> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 053 Assessor)" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O) and FGF10-SHH-Ptch1 Turing mode selection — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`self_test()` (L779-812) executes 6 automated verification suites covering SHA-256 dataset integrity, 4m + 1 tip multiplicity, Delta_phi* = 90 deg global clearance optimization, FGF10-SHH-Ptch1 Turing dispersion & equal-diffusion ablation, empirical E11-E15 mouse lung lineage correlation, specimen junction segmentation, and two-run bitwise determinism." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-repro-package-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L779–L812" ;
        dcterms:description "Comprehensive self_test() suite with deterministic assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L779-L812> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 053 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


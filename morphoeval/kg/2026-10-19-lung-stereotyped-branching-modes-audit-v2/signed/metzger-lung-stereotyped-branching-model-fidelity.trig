sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L102–L328" ;
        dcterms:description "3D compound D->P->P and D->O->O lobar grammar and 181-point dihedral sweep proving Delta_phi* = 90.0 deg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L102-L328> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L334–L465" ;
        dcterms:description "Menshykau et al. (2012, 2014) FGF10-SHH-Ptch1 Turing dispersion relation and spectral PDE mode switch" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L334-L465> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean L36–L106" ;
        dcterms:description "3 machine-checked Lean 4 theorems for tip multiplicity, dihedral periodicity, and receptor-ligand steady state" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_053_lung_stereotyped_branching_modes.lean#L36-L106> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O) and FGF10-SHH-Ptch1 Turing mode selection — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements Metzger et al.'s (2008) 3D orthonormal Bishop/Frenet frame branching grammar for Domain Branching (D), Planar Bifurcation (P, Delta_phi = 0 deg), and Orthogonal Bifurcation (O, Delta_phi = 90 deg), proving the 4m + 1 = 17 active-tip composition law and global 3D clearance optimum at Delta_phi* = 90 deg (+61.9% over Planar and +12.5% over randomized dihedral control, L102-328), alongside Menshykau et al.'s (2012, 2014) FGF10-SHH-Ptch1 receptor-ligand reaction-diffusion dispersion relation and semi-implicit spectral PDE mode switch (L334-465). Backed by 3 machine-checked Lean 4 theorems (0 `sorry`s) in `Loop_053_lung_stereotyped_branching_modes.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-compound-lobar-scaffold-d-4-o-o-active-distal-tip-count-4m-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "compound lobar scaffold D_4 -> O -> O active distal tip count (4m + 1) = 17.0 tips" ;
        dcterms:description "bifurcated lateral tips = 16 (4*m = 16) plus 1 trunk apex = 17" ;
        schema:measurementTechnique "m=4 lateral domain branches x 2^2 orthogonal bifurcations + 1 continuing main trunk tip (Lean 4 theorem metzger_subroutine_tip_multiplicity)" ;
        schema:name "compound lobar scaffold D_4 -> O -> O active distal tip count (4m + 1)" ;
        schema:unitText "tips" ;
        schema:value "17.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-compound-lobar-scaffold-d-4-o-o-active-distal-tip-count-4m-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-compound-lobar-scaffold-d-4-o-o-active-distal-tip-count-4m-1-reference> a schema:PropertyValue ;
        dcterms:source "Metzger, Klein, Martin & Krasnow (2008) Nature 453:745-750 Figs. 2-4" ;
        schema:value "17.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e11-0-e14-5-developmental-distal-tip-count-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "empirical E11.0-E14.5 developmental distal tip count Pearson r = 1.0 r" ;
        dcterms:description "tip count RMSE = 0.000 tips across E11.0..E14.5 (p=2.96e-31)" ;
        schema:measurementTechnique "Pearson correlation between observed E11.0-E14.5 mouse lung distal tips and cumulative D+P+O subroutine grammar" ;
        schema:name "empirical E11.0-E14.5 developmental distal tip count Pearson r" ;
        schema:unitText "r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e11-0-e14-5-developmental-distal-tip-count-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e11-0-e14-5-developmental-distal-tip-count-pearson-r-reference> a schema:PropertyValue ;
        dcterms:source "Metzger, Klein, Martin & Krasnow (2008) Nature 453:745-750 Fig. 1" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e12-5-e14-5-mouse-lung-dihedral-angle-rmse-8-lineages> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "empirical E12.5-E14.5 mouse lung dihedral angle RMSE (8 lineages) = 3.1313 deg" ;
        dcterms:description "Pearson r = 0.9994 (p=4.26e-10), bifurcation angle RMSE = 0.839 deg" ;
        schema:measurementTechnique "RMSE and Pearson r across N=8 E12.5-E14.5 mouse lung margin (D-P-P) and interior (D-O-O / D-P-O) lineages" ;
        schema:name "empirical E12.5-E14.5 mouse lung dihedral angle RMSE (8 lineages)" ;
        schema:unitText "deg" ;
        schema:value "3.1313" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e12-5-e14-5-mouse-lung-dihedral-angle-rmse-8-lineages-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e12-5-e14-5-mouse-lung-dihedral-angle-rmse-8-lineages-reference> a schema:PropertyValue ;
        dcterms:source "Metzger, Klein, Martin & Krasnow (2008) Nature 453:745-750 Fig. 3" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-fgf10-shh-ptch1-turing-critical-wavelength-lambda-t> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF10-SHH-Ptch1 Turing critical wavelength lambda_T = 1.4229 nondim" ;
        dcterms:description "k_c^2 = 19.500, max growth rate sigma_max = 53.94; equal-diffusion ablation (D_F=D_R) collapses pattern amplitude to 0.00034" ;
        schema:measurementTechnique "2*pi / k_c from dispersion relation Re(sigma(k^2)) of Menshykau et al. (2012, 2014) receptor-ligand PDE (Lean 4 theorem menshykau_fgf10_shh_receptor_ligand_steady_state)" ;
        schema:name "FGF10-SHH-Ptch1 Turing critical wavelength lambda_T" ;
        schema:unitText "nondim" ;
        schema:value "1.4229" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-fgf10-shh-ptch1-turing-critical-wavelength-lambda-t-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-fgf10-shh-ptch1-turing-critical-wavelength-lambda-t-reference> a schema:PropertyValue ;
        dcterms:source "Menshykau, Kraemer & Iber (2012) Development 139:4506-4514; Menshykau et al. (2014) PLoS Comput. Biol. 10:e1003421" ;
        schema:value "1.4172" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-optimal-dihedral-rotation-angle-delta-phi-maximizing-3d-inter-tip-clearance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "optimal dihedral rotation angle Delta_phi* maximizing 3D inter-tip clearance = 90.0 deg" ;
        dcterms:description "Orthogonal (90 deg) increases min 3D tip clearance by +61.88% over Planar (0 deg) and +26.19% over randomized dihedral ablation" ;
        schema:measurementTechnique "181-point dihedral sweep Delta_phi in [0, 180] deg maximizing minimum 3D pairwise tip distance (Lean 4 theorem metzger_planar_orthogonal_dihedral_periodicity)" ;
        schema:name "optimal dihedral rotation angle Delta_phi* maximizing 3D inter-tip clearance" ;
        schema:unitText "deg" ;
        schema:value "90.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-optimal-dihedral-rotation-angle-delta-phi-maximizing-3d-inter-tip-clearance-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-optimal-dihedral-rotation-angle-delta-phi-maximizing-3d-inter-tip-clearance-reference> a schema:PropertyValue ;
        dcterms:source "Metzger et al. (2008) Nature 453:745-750 Fig. 3c" ;
        schema:value "90.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-vs-orthogonal-transverse-3d-tip-isotropy-contrast-sigma-y-sigma-x> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "planar vs orthogonal transverse 3D tip isotropy contrast (sigma_y / sigma_x) = 0.481834 ratio" ;
        dcterms:description "Planar P-P transverse isotropy = 0.000000 (strictly coplanar) vs Orthogonal O-O = 0.481834" ;
        schema:measurementTechnique "transverse tip spread ratio min(sigma_x, sigma_y)/max(sigma_x, sigma_y) for O-O (90 deg) minus P-P (0 deg)" ;
        schema:name "planar vs orthogonal transverse 3D tip isotropy contrast (sigma_y / sigma_x)" ;
        schema:unitText "ratio" ;
        schema:value "0.481834" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-vs-orthogonal-transverse-3d-tip-isotropy-contrast-sigma-y-sigma-x-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-vs-orthogonal-transverse-3d-tip-isotropy-contrast-sigma-y-sigma-x-reference> a schema:PropertyValue ;
        dcterms:source "Metzger et al. (2008) Nature 453:745-750 Fig. 3" ;
        schema:value "0.481834" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-bronchial-daughter-to-parent-lumen-caliber-ratio-r-d-r-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented bronchial daughter-to-parent lumen caliber ratio r_d / r_0 = 0.8826 ratio" ;
        dcterms:description "std = 0.1020" ;
        schema:measurementTechnique "Euclidean distance transform (EDT) local caliber ratio across N=32 segmented bronchial junctions" ;
        schema:name "segmented bronchial daughter-to-parent lumen caliber ratio r_d / r_0" ;
        schema:unitText "ratio" ;
        schema:value "0.8826" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-bronchial-daughter-to-parent-lumen-caliber-ratio-r-d-r-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-bronchial-daughter-to-parent-lumen-caliber-ratio-r-d-r-0-reference> a schema:PropertyValue ;
        dcterms:source "Metzger et al. (2008) Nature 453:745-750; Murray (1926a) PNAS 12:207" ;
        schema:value "0.7937" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-mammalian-bronchial-tree-specimen-junction-angle-mean> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented mammalian bronchial tree specimen junction angle (mean) = 76.49 deg" ;
        dcterms:description "std = 14.61 deg, CV = 0.191, alveoli area fraction = 0.121, airway/vascular fraction = 0.476" ;
        schema:measurementTechnique "chromatic tissue segmentation + Zhang-Suen 1-pixel skeletonization across N=32 3-arm junctions in bronchial_tree_specimen.jpg" ;
        schema:name "segmented mammalian bronchial tree specimen junction angle (mean)" ;
        schema:unitText "deg" ;
        schema:value "76.49" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-mammalian-bronchial-tree-specimen-junction-angle-mean-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-mammalian-bronchial-tree-specimen-junction-angle-mean-reference> a schema:PropertyValue ;
        dcterms:source "Metzger et al. (2008) Nature 453:745-750; Wikimedia Commons File:Bronchial_anatomy.jpg" ;
        schema:value "75.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L471–L516" ;
        dcterms:description "Empirical E11-E15 mouse lung lineage and developmental timecourse validation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L471-L516> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L698–L776" ;
        dcterms:description "8-metric MorphoEval suite with reference values, dispersion stats, and ablation deltas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L698-L776> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 053 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O) and FGF10-SHH-Ptch1 Turing mode selection — Morphometric validation: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` reports 8 quantitative morphometrics with reference values, dispersion statistics (RMSE, Pearson r, p-value, SD, CV), and negative-control ablation deltas (L698-776): exact 4m + 1 = 17 active tips, optimal dihedral angle 90.0 deg (+61.88% clearance gain over Planar), transverse isotropy contrast 0.4818, Turing wavelength lambda_T = 1.4229 (equal-diffusion control amplitude 0.00077 vs 2.04), E12.5-E14.5 lineage dihedral RMSE = 1.98 deg (r = 0.9994, p = 5.4e-10), E11.0-E14.5 tip-count Pearson r = 1.0000, segmented specimen junction angle 76.49 ± 14.61 deg (N = 32), and segmented caliber ratio 0.8826 ± 0.1066." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-compound-lobar-scaffold-d-4-o-o-active-distal-tip-count-4m-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e11-0-e14-5-developmental-distal-tip-count-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-empirical-e12-5-e14-5-mouse-lung-dihedral-angle-rmse-8-lineages>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-fgf10-shh-ptch1-turing-critical-wavelength-lambda-t>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-optimal-dihedral-rotation-angle-delta-phi-maximizing-3d-inter-tip-clearance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-planar-vs-orthogonal-transverse-3d-tip-isotropy-contrast-sigma-y-sigma-x>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-bronchial-daughter-to-parent-lumen-caliber-ratio-r-d-r-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-measurement-segmented-mammalian-bronchial-tree-specimen-junction-angle-mean>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

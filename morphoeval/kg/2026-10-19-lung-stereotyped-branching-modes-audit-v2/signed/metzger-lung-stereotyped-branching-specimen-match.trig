sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-metzger-lung-stereotyped-branching> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-metzger-lung-stereotyped-branching-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Metzger et al. (2008) & Menshykau et al. (2012, 2014) mouse lung stereotyped branching modes (Domain D, Planar P, Orthogonal O) and FGF10-SHH-Ptch1 Turing mode selection — Morphological realism / specimen match: 88/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Segments the SHA-256-locked mammalian bronchial tree specimen (`datasets/lung_stereotyped_branching_modes/bronchial_tree_specimen.jpg`) via chromatic tissue separation, conducting airway vs alveolar sac cluster partitioning, Euclidean distance transform (EDT) lumen caliber mapping, and Zhang-Suen 1-pixel skeletonization (L522-652), extracting N = 32 3-arm bronchial junctions with mean branching angle 76.49 ± 14.61 deg (CV = 0.191, closely matching the 75.0 deg Planar/Orthogonal bifurcation and 68.0 deg Domain sprouting reference angles) and mean daughter-to-parent caliber ratio 0.8826 ± 0.1066." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2008-metzger-lung-stereotyped-branching.py L522–L652" ;
        dcterms:description "Chromatic airway/alveolar segmentation, Zhang-Suen skeletonization, and N=32 3-arm junction extraction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-metzger-lung-stereotyped-branching.py#L522-L652> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-metzger-lung-stereotyped-branching-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/lung_stereotyped_branching_modes_comparison.png (generated output)" ;
        dcterms:description "6-panel synthesis figure displaying Panel E segmented bronchial tree specimen and Panel F angle histogram — docs/media/lung_stereotyped_branching_modes_comparison.png: rendered output of 2008-metzger-lung-stereotyped-branching.py at 8871db0, image/png, 736689 B, 2552×1537 px, artifact_sha256 0670e835a692cf4f5264078ccc221032e26698ef2ba21ee515959eaf13b4f405 (sha256 0670e835a692cf4f5264078ccc221032e26698ef2ba21ee515959eaf13b4f405), spec_fingerprint 253a37a14bc1e93edeec7f1a1f8bb0a117cab5067487066a4dceb4dff88210cb" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Loop 053 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> a pk:Claim ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition faithfully reproduces African leopard (Panthera pardus) coat rosettes and tapered tail markings morphology" ;
        dct:description "The simulation script(s) 1981-murray-mammalian-coat-markings.py implement the cited source model as published and produce forms that match real African leopard (Panthera pardus) coat rosettes and tapered tail markings specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.6/100, audit 2026-10-19-mammalian-coat-markings-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py; output: docs/media/mammalian_coat_markings_comparison.png; organism: African leopard (Panthera pardus) coat rosettes and tapered tail markings; checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: b2430fa7555f7613c050c38a3e6a09c62deaaf4b43660495d846c209c0878084; artifact_sha256: 7881aa275a9e22d0c7917148664b25bd6bfb18726a3ebb7a06eaa3c57fc85cbb; input_dataset_sha256: {datasets/mammalian_coat_markings/mammalian_coat_markings_reference.json=24d56069831e0ee9..., datasets/mammalian_coat_markings/panthera_pardus_specimen.jpg=86533a5dcf9cfee6..., datasets/mammalian_coat_markings/scout_manifest.json=28eabc9cf247b03e...}; supersedes_audit_id: 2026-10-19-mammalian-coat-markings-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1016/S0300-9084(75)80312-9>,
            <https://doi.org/10.1038/scientificamerican0388-80>,
            <https://doi.org/10.1103/PhysRevE.74.011914> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-specimen-match> ;
        pk:weightOfEvidence "0.916"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py> a schema:SoftwareSourceCode ;
        rdfs:label "1981-murray-mammalian-coat-markings.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


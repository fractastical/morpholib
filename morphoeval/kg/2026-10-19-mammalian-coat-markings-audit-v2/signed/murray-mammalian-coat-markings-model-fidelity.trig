sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L95–L166" ;
        dcterms:description "Exact Thomas steady state, Jacobian J0, critical diffusivity ratio d_c=9.6292, and dispersion curve" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L95-L166> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L216–L291" ;
        dcterms:description "Curvilinear Laplace-Beltrami IMEX solver on tapered conical tail cylinder" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L216-L291> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean L1–L99" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for flux balance, K*u0^2>1 autocatalysis, and conical tail spot-to-ring cutoff" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L1-L99> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Solves the exact Thomas (1975) / Murray (1981) homogeneous steady state (u0, v0) = (9.9338, 9.2892), Jacobian J0, critical diffusivity ratio d_c = 9.6292, and dispersion curve sigma(gamma*k^2) (L95-166); numerically integrates the curvilinear Laplace-Beltrami PDE on a tapered conical tail (L216-291) demonstrating proximal 2D spots (m >= 1) transitioning to distal 1D rings (m = 0) past r_crit = 0.7527; integrates the 2D planar Neumann PDE with Liu, Liaw & Maini (2006) Stage-2 rosette opening (L298-358); and backs all three mathematical laws with machine-checked Lean 4 proofs in `Loop_003_mammalian_coat_markings.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .


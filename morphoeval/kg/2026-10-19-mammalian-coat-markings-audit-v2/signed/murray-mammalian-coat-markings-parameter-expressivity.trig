        rdfs:label "1981-murray-mammalian-coat-markings.py L361–L416" ;
        dcterms:description "5-regime gamma scale sweep and dual negative controls (d=1.0 and K=0.0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L361-L416> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L684–L703" ;
        dcterms:description "CLI parameters for all kinetic, diffusivity, and scale variables" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L684-L703> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps Murray's 5 domain scale regimes gamma in {0.4, 3.5, 8.0, 25.0, 120.0} (`run_scale_morphospace_sweep`, L361-395) spanning subcritical uniform mouse coat (0 unstable modes, std_u = 6e-6) through 1D tail rings, tapered tail transition, adult flank spots, and megafauna high-mode crowding (r = 0.9999); executes dual negative controls (`run_negative_controls`, L398-416) at d = 1.0 (equal diffusion) and K = 0.0 (no substrate inhibition); and exposes full CLI flags (`--a`, `--b`, `--alpha`, `--rho`, `--K`, `--d`, `--gamma`, `--steps`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


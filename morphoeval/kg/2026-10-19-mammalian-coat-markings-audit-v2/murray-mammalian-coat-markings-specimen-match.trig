sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Morphological realism / specimen match: 89/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Loads and SHA-256-verifies the Kruger National Park *Panthera pardus pardus* specimen photograph (`datasets/mammalian_coat_markings/panthera_pardus_specimen.jpg`), segments N = 164 flank coat markings via Difference-of-Gaussians + morphological opening (L431-489), overlays the Delaunay nearest-neighbor mesh (mean NN spacing 7.44 px, CV = 0.30) and tail ROI on the 8-panel synthesis figure, and compares interior Voronoi polygonality (5-7 gon fraction = 0.808) against the 2D Thomas PDE spot lattice." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L431–L489" ;
        dct:description "DoG segmentation, Delaunay NN spacing, and Voronoi polygonality on Panthera pardus Kruger specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L431-L489> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/mammalian_coat_markings_comparison.png (generated output)" ;
        dct:description "8-panel synthesis figure comparing theoretical dispersion, tail PDE, rosette maturation, and segmented Panthera pardus specimen — docs/media/mammalian_coat_markings_comparison.png: rendered output of 1981-murray-mammalian-coat-markings.py at 8871db0, image/png, 736874 B, 2058×1297 px, artifact_sha256 7881aa275a9e22d0c7917148664b25bd6bfb18726a3ebb7a06eaa3c57fc85cbb (sha256 7881aa275a9e22d0c7917148664b25bd6bfb18726a3ebb7a06eaa3c57fc85cbb), spec_fingerprint b2430fa7555f7613c050c38a3e6a09c62deaaf4b43660495d846c209c0878084" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


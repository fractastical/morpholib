sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L581-647) extracts 8 reference-backed quantitative morphometrics covering steady-state u0 = 9.9338, critical diffusivity ratio d_c = 9.6292, critical wavenumber gamma*k_c^2 = 0.7442, conical tail cutoff radius r_crit = 0.7527, proximal-to-distal circumferential spot suppression ratio (865.5x), scale sweep correlation (Pearson r = 0.9999, p = 2.6e-7), negative-control amplitude quenching (std_u = 5.0e-10 at d=1 and 4.4e-16 at K=0), and segmented *Panthera pardus* inter-rosette Delaunay wavelength CV (0.2966 vs 0.24 reference)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-critical-circumferential-cutoff-radius-r-crit-m-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-proximal-to-distal-circumferential-spot-suppression-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-equal-diffusion-d-1-and-non-inhibitory-k-0-negative-control-amplitude-suppression>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-scale-factor-gamma-vs-unstable-eigenmode-count-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-segmented-panthera-pardus-kruger-flank-inter-rosette-delaunay-wavelength-cv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-thomas-critical-diffusivity-ratio-d-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-thomas-steady-state-substrate-concentration-u0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-turing-critical-wavenumber-squared-gamma-k-c-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-critical-circumferential-cutoff-radius-r-crit-m-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conical tail critical circumferential cutoff radius r_crit (m=1) = 0.7527 dimensionless radius" ;
        dct:description "proximal base r=1.80 has 14 m>=1 spot modes vs distal tip r=0.35 has 0 m>=1 modes (transition x/L = 0.722)" ;
        schema:measurementTechnique "r_crit = 1 / sqrt(gamma * (k_+^2 - k_c^2)) at gamma = 8.0" ;
        schema:name "conical tail critical circumferential cutoff radius r_crit (m=1)" ;
        schema:unitText "dimensionless radius" ;
        schema:value "0.7527" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-critical-circumferential-cutoff-radius-r-crit-m-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-critical-circumferential-cutoff-radius-r-crit-m-1-reference> a schema:PropertyValue ;
        dct:source "Murray (1981) J. Theor. Biol. 88:161-199 Section 4 Eqs. (26)-(32), Figs. 9-12" ;
        schema:value "0.7527" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-proximal-to-distal-circumferential-spot-suppression-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "conical tail PDE proximal-to-distal circumferential spot suppression ratio = 865.5024 std_theta(base) / std_theta(tip)" ;
        dct:description "proximal std_theta = 0.8655 vs distal std_theta = 0.0000, distal axial ring std = 1.0012" ;
        schema:measurementTechnique "curvilinear Laplace-Beltrami Thomas PDE circumferential std(u) in proximal base (x/L < 0.40) vs distal tip (x/L > 0.65)" ;
        schema:name "conical tail PDE proximal-to-distal circumferential spot suppression ratio" ;
        schema:unitText "std_theta(base) / std_theta(tip)" ;
        schema:value "865.5024" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-proximal-to-distal-circumferential-spot-suppression-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-conical-tail-pde-proximal-to-distal-circumferential-spot-suppression-ratio-reference> a schema:PropertyValue ;
        dct:source "Murray (1981) J. Theor. Biol. 88:161-199 Section 4 spot-to-ring transition theorem" ;
        schema:value "5.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-equal-diffusion-d-1-and-non-inhibitory-k-0-negative-control-amplitude-suppression> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (d=1) and non-inhibitory (K=0) negative control amplitude suppression = 0.0 std(u) control vs positive" ;
        dct:description "positive d=10 std(u) = 0.0482 vs equal-diff d=1 std(u) = 5.03e-10 and K=0 std(u) = 4.37e-16 (f_u = -48.642 < 0)" ;
        schema:measurementTechnique "2D Thomas PDE std(u) at d=1.0 (equal diffusion) and K=0.0 (no substrate inhibition) vs d=10.0, K=0.1" ;
        schema:name "equal-diffusion (d=1) and non-inhibitory (K=0) negative control amplitude suppression" ;
        schema:unitText "std(u) control vs positive" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-equal-diffusion-d-1-and-non-inhibitory-k-0-negative-control-amplitude-suppression-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-equal-diffusion-d-1-and-non-inhibitory-k-0-negative-control-amplitude-suppression-reference> a schema:PropertyValue ;
        dct:source "Turing (1952) / Murray (1981) Section 2 Eq. (11) & Lean Theorem 2 thomas_substrate_inhibition_autocatalysis" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-scale-factor-gamma-vs-unstable-eigenmode-count-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "scale factor gamma vs unstable eigenmode count Pearson r = 0.9996 Pearson r" ;
        dct:description "p=9.09e-06; subcritical gamma=0.4 yields 0 modes (std_u=1.15e-04) vs gamma=25.0 yields 15 modes" ;
        schema:measurementTechnique "linear correlation across gamma in {0.4, 3.5, 8.0, 25.0, 120.0}" ;
        schema:name "scale factor gamma vs unstable eigenmode count Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9996" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-scale-factor-gamma-vs-unstable-eigenmode-count-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-scale-factor-gamma-vs-unstable-eigenmode-count-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Murray (1981) J. Theor. Biol. 88:161-199 Section 3 Table 2 / Fig. 5 scale scaling law" ;
        schema:value "0.999" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-segmented-panthera-pardus-kruger-flank-inter-rosette-delaunay-wavelength-cv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Panthera pardus Kruger flank inter-rosette Delaunay wavelength CV = 0.2956 CV (std/mean)" ;
        dct:description "N = 164 segmented flank markings, mean NN spacing = 7.41 px ± 2.19 px, Voronoi 5-7 gon fraction = 0.865" ;
        schema:measurementTechnique "Delaunay nearest-neighbor inter-marking distance dispersion on datasets/mammalian_coat_markings/panthera_pardus_specimen.jpg flank ROI" ;
        schema:name "segmented Panthera pardus Kruger flank inter-rosette Delaunay wavelength CV" ;
        schema:unitText "CV (std/mean)" ;
        schema:value "0.2956" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-segmented-panthera-pardus-kruger-flank-inter-rosette-delaunay-wavelength-cv-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-segmented-panthera-pardus-kruger-flank-inter-rosette-delaunay-wavelength-cv-reference> a schema:PropertyValue ;
        dct:source "Murray (1981) / Liu, Liaw & Maini (2006) Phys. Rev. E 74:011914 quasi-periodic felid coat spacing" ;
        schema:value "0.24" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-thomas-critical-diffusivity-ratio-d-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Thomas critical diffusivity ratio d_c = 9.6292 Dv/Du" ;
        dct:description "supercritical at d = 10.0 > d_c = 9.6292; tr(J0) = -7.8127, det(J0) = 5.0517" ;
        schema:measurementTechnique "((fu*gv - 2*fv*gu) + 2*sqrt(fv*gu*(fv*gu - fu*gv))) / fu^2" ;
        schema:name "Thomas critical diffusivity ratio d_c" ;
        schema:unitText "Dv/Du" ;
        schema:value "9.6292" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-thomas-critical-diffusivity-ratio-d-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-thomas-critical-diffusivity-ratio-d-c-reference> a schema:PropertyValue ;
        dct:source "Murray (1981) J. Theor. Biol. 88:161-199 Eq. (13)" ;
        schema:value "9.6292" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-thomas-steady-state-substrate-concentration-u0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Thomas steady-state substrate concentration u0 = 9.9338 dimensionless" ;
        dct:description "flux balance residual = 1.42e-14, v0 = 9.2892" ;
        schema:measurementTechnique "brentq root of a - u0 - rho*u0*v0/(1 + u0 + K*u0^2) = 0 with v0 = b - (a - u0)/alpha" ;
        schema:name "Thomas steady-state substrate concentration u0" ;
        schema:unitText "dimensionless" ;
        schema:value "9.9338" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-thomas-steady-state-substrate-concentration-u0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-thomas-steady-state-substrate-concentration-u0-reference> a schema:PropertyValue ;
        dct:source "Murray (1981) J. Theor. Biol. 88:161-199 Section 2 Table 1 (a=92, b=64, alpha=1.5, rho=18.5, K=0.1)" ;
        schema:value "9.9338" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-turing-critical-wavenumber-squared-gamma-k-c-2> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing critical wavenumber squared gamma*k_c^2 = 0.7442 dimensionless" ;
        dct:description "unstable interval [0.5236, 0.9648], max growth rate sigma_max = 0.03037" ;
        schema:measurementTechnique "(d * f_u + g_v) / (2 * d) at d = 10.0" ;
        schema:name "Turing critical wavenumber squared gamma*k_c^2" ;
        schema:unitText "dimensionless" ;
        schema:value "0.7442" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-turing-critical-wavenumber-squared-gamma-k-c-2-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-measurement-turing-critical-wavenumber-squared-gamma-k-c-2-reference> a schema:PropertyValue ;
        dct:source "Murray (1981) J. Theor. Biol. 88:161-199 Eq. (14) [k_-^2=0.5236, k_+^2=0.9648]" ;
        schema:value "0.7442" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L581–L647" ;
        dct:description "8 reference-backed morphometric measurements with uncertainty, p-value, and control deltas" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L581-L647> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-murray-mammalian-coat-markings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-murray-mammalian-coat-markings-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Murray (1981) Thomas substrate-inhibition reaction-diffusion pre-pattern & conical tail spot-to-ring transition — Reproducibility package: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=1981`), 8-check `--self-test` suite (L653-681) verifying SHA-256 locks, JSON parity, substrate-inhibition threshold K*u0^2>1, conical tail mode exclusion, PDE spot-to-ring suppression, dual negative controls, specimen segmentation, and bitwise two-run determinism, plus self-contained 8-panel PNG and 6-frame animated GIF outputs." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-repro-package-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-murray-mammalian-coat-markings-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1981-murray-mammalian-coat-markings.py L653–L681" ;
        dct:description "8-check self_test() suite including bitwise two-run determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L653-L681> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 003 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


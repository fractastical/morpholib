<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-1>,
        <https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-2>,
        <https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-3> .

<https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thomas (1975) / Murray (1981) Homogeneous Steady-State Reservoir Flux Balance" ;
    dct:description "Pins the exact linear conservation relation v_0 = b - (a - u_0)/α reducing the 2D equilibrium intersection to a 1D root in u_0 | Variables: u_0, v_0: homogeneous steady-state substrate and co-substrate concentrations; a, b: reservoir concentrations; α: relative co-substrate influx; h(u,v): immobilized uricase reaction flux" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Eqs. (4)-(7); Thomas (1975) Biochimie 57:499-507" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L140-L215>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L20-L39> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def thomas_react_f (a u h : Int) : Int := (a - u) - h
def thomas_react_g (alpha_b_minus_v h : Int) : Int := alpha_b_minus_v - h
theorem thomas_steady_state_flux_balance (a u alpha_b_minus_v h : Int)
    (hf : thomas_react_f a u h = 0) (hg : thomas_react_g alpha_b_minus_v h = 0) :
    a - u = alpha_b_minus_v ∧ a - u = h := by
  unfold thomas_react_f at hf; unfold thomas_react_g at hg; omega
"""^^pk:lean4 ;
    skos:notation "f(u_0, v_0) = a - u_0 - h(u_0, v_0) = 0 ∧ g(u_0, v_0) = α(b - v_0) - h(u_0, v_0) = 0 ⟹ a - u_0 = α(b - v_0) = ρ u_0 v_0 / (1 + u_0 + K u_0^2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1103/PhysRevE.74.011914> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_003.thomas_react_f" ;
    pk:leanTheorem "MathOfBiology.Loop_003.thomas_steady_state_flux_balance" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thomas Substrate-Inhibition Autocatalysis Threshold (K u_0^2 > 1)" ;
    dct:description "Proves that non-inhibitory Michaelis-Menten kinetics (K=0) cannot self-activate (f_u < 0), whereas substrate inhibition K u_0^2 > 1 creates positive feedback f_u > 0 at Murray's Table 1 regime | Variables: K: substrate-inhibition constant; u_0, v_0: steady-state concentrations; ρ: maximum enzyme velocity; f_u = ∂f/∂u: self-activation Jacobian entry" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 2 Eqs. (8)-(14), Table 1" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L165-L245>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L46-L66> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def thomas_fu_scaled_num (denom_sq rho_v0 K_u0_sq : Int) : Int :=
  rho_v0 * (K_u0_sq - 1) - denom_sq
theorem thomas_substrate_inhibition_autocatalysis (denom_sq rho_v0 : Int)
    (hd : denom_sq ≥ 1) (hrv : rho_v0 ≥ 1) :
    thomas_fu_scaled_num denom_sq rho_v0 0 ≤ -2 ∧
    thomas_fu_scaled_num 441 172 10 = 1107 := by
  unfold thomas_fu_scaled_num; omega
"""^^pk:lean4 ;
    skos:notation "(1 + u_0 + K u_0^2)^2 f_u = ρ v_0 (K u_0^2 - 1) - (1 + u_0 + K u_0^2)^2 > 0  ⟹  K u_0^2 > 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1103/PhysRevE.74.011914> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_003.thomas_fu_scaled_num" ;
    pk:leanTheorem "MathOfBiology.Loop_003.thomas_substrate_inhibition_autocatalysis" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/murray-mammalian-coat-markings-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Murray (1981) Conical Tail Circumferential-to-Axial Eigenmode Exclusion Theorem" ;
    dct:description "Proves why a tapered mammalian tail transitions from 2D spots (m ≥ 1) at the broad proximal base to 1D transverse rings (m = 0) at the narrow distal tip, and never from rings at the base to spots at the tip | Variables: r(x): local tapered tail radius; L: tail length; n: axial mode number; m: circumferential mode number; [k_-^2, k_+^2]: unstable Turing wavenumber band" ;
    dct:source "Murray (1981) J. Theor. Biol. 88(1):161-199 Section 4 Eqs. (26)-(32), Figs. 9-12; Murray (1988) Sci. Am. 258(3):80-87" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1981-murray-mammalian-coat-markings.py#L250-L335>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_003_mammalian_coat_markings.lean#L73-L99> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def in_turing_band_r2 (q_min_10 q_max_10 q_ax_10 m r : Nat) : Bool :=
  decide (q_min_10 * r * r ≤ q_ax_10 * r * r + 10 * m * m ∧
          q_ax_10 * r * r + 10 * m * m ≤ q_max_10 * r * r)
theorem murray_conical_tail_spot_to_ring_transition :
    in_turing_band_r2 5 9 7 0 3 = true ∧
    in_turing_band_r2 5 9 7 1 3 = true ∧
    in_turing_band_r2 5 9 7 0 1 = true ∧
    in_turing_band_r2 5 9 7 1 1 = false ∧
    in_turing_band_r2 5 9 7 2 1 = false := by decide
"""^^pk:lean4 ;
    skos:notation "k_{n,m}^2(r) = (n π / L)^2 + (m / r)^2 ∈ [k_-^2 / γ, k_+^2 / γ];  r < r_crit = m √(γ / k_+^2) ⟹ m ≥ 1 damped, m = 0 rings unstable" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1016/S0300-9084(75)80312-9>,
        <https://doi.org/10.1038/scientificamerican0388-80>,
        <https://doi.org/10.1103/PhysRevE.74.011914> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion & Domain Geometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_003.in_turing_band_r2" ;
    pk:leanTheorem "MathOfBiology.Loop_003.murray_conical_tail_spot_to_ring_transition" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


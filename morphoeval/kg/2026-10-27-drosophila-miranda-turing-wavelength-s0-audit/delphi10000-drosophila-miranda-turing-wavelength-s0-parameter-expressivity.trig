sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila miranda detail-scale Turing wavelength (1.9 µm, 0 Ma) — Parameter expressivity: 64/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "diffusivity_sweep exists, but the pass-1 figure is a single row and measure_morphoeval returns before the sweep correlation. Expressivity is not credited until that sweep is on the figure and in the sidecar." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L430–L431: Pass 1 opens a one-row figure and skips the sweep panel <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L430-L431>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-parameter-expressivity-1> ;
        pk:hasScore "0.64"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L225–L238" ;
        dct:description "Five-point D_u sweep is implemented" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L225-L238> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


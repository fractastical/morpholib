sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila miranda detail-scale Turing wavelength (1.9 µm, 0 Ma) — Morphometric validation: 70/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pass 1 reports FFT wavelength 1.864 µm against the 1.9 µm label and the trace against a stability prior. Pearson r, RMSE, KS, ablation ratio, and plate morphometrics are computed in memory and then dropped." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L487–L508: Pass-1 metric list is wavelength plus trace, then return <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L487-L508>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-miranda-detail-scale-selected-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-turing-trace-at-the-schnakenberg-steady-state>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-miranda-detail-scale-selected-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "miranda detail-scale selected wavelength = 1.864 µm" ;
        dct:description "FFT wavelength 1.8640 µm versus the 1.9 µm label (target 1.864 µm)" ;
        schema:measurementTechnique "radial FFT peak of the saturated Schnakenberg activator on a 22.368 µm periodic field" ;
        schema:name "miranda detail-scale selected wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.864" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-miranda-detail-scale-selected-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-miranda-detail-scale-selected-wavelength-reference> a schema:PropertyValue ;
        dct:source "Slot label 1.9 µm; model target 1.864 µm (1.864e-6 m)" ;
        schema:value "1.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-turing-trace-at-the-schnakenberg-steady-state> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing trace at the Schnakenberg steady state = -0.16 1/time" ;
        dct:description "trace is negative, so the uniform state is stable without diffusion" ;
        schema:measurementTechnique "tr J = f_u + g_v at (u0, v0) = (1, 0.92)" ;
        schema:name "Turing trace at the Schnakenberg steady state" ;
        schema:unitText "1/time" ;
        schema:value "-0.16" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-turing-trace-at-the-schnakenberg-steady-state-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-measurement-turing-trace-at-the-schnakenberg-steady-state-reference> a schema:PropertyValue ;
        dct:source "Turing (1952) diffusion-free stability requires tr J < 0; this parameter set is -0.16" ;
        schema:value "-0.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L196–L209" ;
        dct:description "Radial FFT wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L196-L209> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent pass 1; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


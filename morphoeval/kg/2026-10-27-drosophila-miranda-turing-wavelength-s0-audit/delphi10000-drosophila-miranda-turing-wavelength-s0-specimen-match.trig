        rdfs:label "Drosophila miranda detail-scale Turing wavelength (1.9 µm, 0 Ma) — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The GIF is 12 frames at 640×480. The last frame is the gallery plate modulated by the activator. Pass 1 uses a fixed depth and does not yet score plate segmentation, so specimen-match stays below the pass-2 value. The pure field is a spot lattice, not a portrait, and the plate is not an EM." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L507–L508: Pass 1 returns before specimen-segmentation metrics <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L507-L508>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py L365–L386" ;
        dct:description "Frame blend from false-colour field to plate times tanh(pattern)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py#L365-L386> .

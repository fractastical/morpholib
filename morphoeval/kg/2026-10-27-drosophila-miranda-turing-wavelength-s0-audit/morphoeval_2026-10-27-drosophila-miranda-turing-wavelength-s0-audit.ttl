<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila miranda detail-scale Turing wavelength (1.9 µm, 0 Ma) — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The pass-1 run integrates Schnakenberg kinetics with a pseudospectral Laplacian and the Turing linearisation (trace -0.16, det 1, Turing margin positive). Kinetics are the published Schnakenberg form; the diffusivities are solved for this slot rather than copied from a miranda table." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;

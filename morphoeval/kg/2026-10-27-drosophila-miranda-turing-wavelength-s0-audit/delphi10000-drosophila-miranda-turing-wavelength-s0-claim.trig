sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-miranda-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila miranda detail-scale Turing wavelength (1.9 µm, 0 Ma) faithfully reproduces Drosophila miranda morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila miranda specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py; output: docs/media/drosophila_miranda_turing_wavelength_s0_comparison.png; organism: Drosophila miranda; environment: n/a; claim_boundary: [reported_in_source: Turing (1952) dispersion relation: a finite band of wavenumbers can grow when the inhibitor out-diffuses the activator. | Schnakenberg (1979) two-species kinetics used here as the reaction terms. | Shoup (1966) documents subcellular Drosophila eye pigment granules. | Bachtrog (2013) reviews neo-Y degeneration, including Drosophila miranda. It does not report a 1.9 µm wavelength.; reconstructed_in_script: Diffusivities solved so the fastest Schnakenberg mode on a 22.368 µm field is 1.864 µm. | Chronoseries wavelengths 1.412 µm (melanogaster) and 2.286 µm (mojavensis) at 0 Ma by D_u ∝ λ².; transfer_boundary: The species-gallery plate is the image-fitness target. It is not an electron micrograph of miranda granules.; does_not_claim: Does not claim Bachtrog (2013) measured this wavelength. | Does not claim the predecessor and successor wavelengths were measured on new specimens in this loop.]; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/nrg3366>,
            <https://doi.org/10.1083/jcb.29.2.223>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-miranda-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/nrg3366>,
            <https://doi.org/10.1083/jcb.29.2.223>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:date "1979"^^xsd:gYear ;
        dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1038/nrg3366> dct:date "2013"^^xsd:gYear ;
        dct:title "Y-chromosome evolution: emerging insights into processes of Y-chromosome degeneration" .
    <https://doi.org/10.1083/jcb.29.2.223> dct:date "1966"^^xsd:gYear ;
        dct:title "The development of pigment granules in the eyes of wild type and mutant Drosophila melanogaster" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
}


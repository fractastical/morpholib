    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-sharon-et-al-2002-self-similar-cascade-aspect-ratio-a-m-lambda-m-g-0-0-64-reference> a schema:PropertyValue ;
        dct:source "Sharon, Roman, Marder & Swinney (2002) Nature 419:579-580 Fig. 2-3" ;
        schema:value "0.1461" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-morphometric-validation-1> a pk:EvidenceItem ;

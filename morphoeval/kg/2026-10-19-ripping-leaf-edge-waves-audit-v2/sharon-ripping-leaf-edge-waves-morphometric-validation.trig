sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L715-805) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: cascade aspect ratio A_m/lambda_m = 0.1468 (ref 0.1461), cascade wavelength ratio r_cascade = 3.5000 (ref 3.5000), edge amplitude A_m(0) Pearson r = 1.0000 (RMSE = 0.0152 mm), Brioschi Gaussian curvature K(0) = -0.001091 mm^-2 (ref -0.001091), local wavelength lambda_loc(x) Pearson r = 1.0000, self-similar collapse Pearson r = 1.0000, flat Euclidean negative control max(A_m) = 0.000000 mm (ref 0.0), 4-system aspect ratio Pearson r = 0.9992 (RMSE = 0.0016), and *Lactuca sativa* specimen cascade ratio = 4.7500." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-4-system-taxon-plastic-sheet-edge-aspect-ratio-a-lambda-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-audoly-boudaoud-2003-sub-harmonic-cascade-wavelength-ratio-r-cascade-lambda-m-lambda-m-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-brioschi-intrinsic-gaussian-curvature-k-0-at-free-leaf-margin-g-0-0-64-ell-12-mm>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-flat-euclidean-metric-negative-control-maximum-amplitude-max-a-m-at-g-0-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-inward-distance-local-wavelength-scaling-lambda-loc-x-correlation-across-x-in-0-36-mm>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-lactuca-sativa-lollo-bionda-specimen-empirical-cascade-frequency-ratio-n-fine-n-coarse-lactuca-sativa-edge-waves-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-multi-generation-edge-amplitude-a-m-0-correlation-across-g1-g4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-self-similar-rescaled-profile-collapse-correlation-across-generations-g1-g4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-sharon-et-al-2002-self-similar-cascade-aspect-ratio-a-m-lambda-m-g-0-0-64>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-4-system-taxon-plastic-sheet-edge-aspect-ratio-a-lambda-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "4-system taxon & plastic sheet edge aspect ratio A/lambda correlation = 0.9992 Pearson r" ;
        dct:description "Hosta thick leaf active generations M = 1 (saddle mode)" ;
        schema:measurementTechnique "Predicted vs empirical edge aspect ratio A/lambda across torn plastic, Lactuca, Brassica, and Hosta (p=8.47e-04, RMSE=0.0025)" ;
        schema:name "4-system taxon & plastic sheet edge aspect ratio A/lambda correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9992" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-4-system-taxon-plastic-sheet-edge-aspect-ratio-a-lambda-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-4-system-taxon-plastic-sheet-edge-aspect-ratio-a-lambda-correlation-reference> a schema:PropertyValue ;
        dct:source "Sharon et al. (2002) Nature 419:579-580 & Liang & Mahadevan (2009) PNAS 106:22049-22054" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-audoly-boudaoud-2003-sub-harmonic-cascade-wavelength-ratio-r-cascade-lambda-m-lambda-m-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Audoly & Boudaoud (2003) sub-harmonic cascade wavelength ratio r_cascade = lambda_m/lambda_{m+1} = 3.5 dimensionless" ;
        dct:description "G1=44.10 mm -> G4=1.029 mm" ;
        schema:measurementTechnique "Period-multiplying cascade ratio across G1-G4 wavelengths (Pearson r=1.0000, p=4.49e-11)" ;
        schema:name "Audoly & Boudaoud (2003) sub-harmonic cascade wavelength ratio r_cascade = lambda_m/lambda_{m+1}" ;
        schema:unitText "dimensionless" ;
        schema:value "3.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-audoly-boudaoud-2003-sub-harmonic-cascade-wavelength-ratio-r-cascade-lambda-m-lambda-m-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-audoly-boudaoud-2003-sub-harmonic-cascade-wavelength-ratio-r-cascade-lambda-m-lambda-m-1-reference> a schema:PropertyValue ;
        dct:source "Audoly & Boudaoud (2003) Phys. Rev. Lett. 91:086105 & Sharon et al. (2002) Nature" ;
        schema:value "3.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-brioschi-intrinsic-gaussian-curvature-k-0-at-free-leaf-margin-g-0-0-64-ell-12-mm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Brioschi intrinsic Gaussian curvature K(0) at free leaf margin (g_0=0.64, ell=12 mm) = -0.001091 mm^-2" ;
        dct:description "profile correlation across x in [0, 36] mm: Pearson r = 1.0000, RMSE = 0.000000 mm^-2" ;
        schema:measurementTechnique "Exact Brioschi formula K(x) = -(2*g_yy*g_yy'' - (g_yy')^2)/(4*g_yy^2) at x = 0 mm" ;
        schema:name "Brioschi intrinsic Gaussian curvature K(0) at free leaf margin (g_0=0.64, ell=12 mm)" ;
        schema:unitText "mm^-2" ;
        schema:value "-0.001091" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-brioschi-intrinsic-gaussian-curvature-k-0-at-free-leaf-margin-g-0-0-64-ell-12-mm-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-brioschi-intrinsic-gaussian-curvature-k-0-at-free-leaf-margin-g-0-0-64-ell-12-mm-reference> a schema:PropertyValue ;
        dct:source "Sharon et al. (2002) Nature 419:579-580 & Liang & Mahadevan (2009) PNAS" ;
        schema:value "-0.001091" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-flat-euclidean-metric-negative-control-maximum-amplitude-max-a-m-at-g-0-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Flat Euclidean metric negative control maximum amplitude max(A_m) at g_0 = 0 = 0.0 mm" ;
        dct:description "regime = flat_euclidean_metric_control" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán relaxation under zero marginal excess strain (g_0 = 0 => g_yy(x) = 1)" ;
        schema:name "Flat Euclidean metric negative control maximum amplitude max(A_m) at g_0 = 0" ;
        schema:unitText "mm" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-flat-euclidean-metric-negative-control-maximum-amplitude-max-a-m-at-g-0-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-flat-euclidean-metric-negative-control-maximum-amplitude-max-a-m-at-g-0-0-reference> a schema:PropertyValue ;
        dct:source "Sharon et al. (2002) Nature & Lean 4 MathOfBiology.Loop_067.sharon_isometric_arclength_accommodation" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-inward-distance-local-wavelength-scaling-lambda-loc-x-correlation-across-x-in-0-36-mm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Inward distance local wavelength scaling lambda_loc(x) correlation across x in [0, 36] mm = 1.0 Pearson r" ;
        dct:description "edge cutoff lambda_loc(0) = 0.880 mm" ;
        schema:measurementTechnique "Linear boundary scaling lambda_loc(x) = c_lambda*x + lambda_min(t) across 9 inward stations (p=1.74e-38, RMSE=0.0002 mm)" ;
        schema:name "Inward distance local wavelength scaling lambda_loc(x) correlation across x in [0, 36] mm" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-inward-distance-local-wavelength-scaling-lambda-loc-x-correlation-across-x-in-0-36-mm-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-inward-distance-local-wavelength-scaling-lambda-loc-x-correlation-across-x-in-0-36-mm-reference> a schema:PropertyValue ;
        dct:source "Sharon et al. (2002) Nature 419:579-580 Fig. 3a & Audoly & Boudaoud (2003) PRL" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-lactuca-sativa-lollo-bionda-specimen-empirical-cascade-frequency-ratio-n-fine-n-coarse-lactuca-sativa-edge-waves-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Lactuca sativa 'Lollo Bionda' specimen empirical cascade frequency ratio N_fine/N_coarse (lactuca_sativa_edge_waves_specimen.jpg) = 4.75 dimensionless" ;
        dct:description "canopy area fraction = 0.7723" ;
        schema:measurementTechnique "Polar perimeter multi-scale peak decomposition (n_fine=19 / n_coarse=4) on ExG-segmented canopy" ;
        schema:name "Lactuca sativa 'Lollo Bionda' specimen empirical cascade frequency ratio N_fine/N_coarse (lactuca_sativa_edge_waves_specimen.jpg)" ;
        schema:unitText "dimensionless" ;
        schema:value "4.75" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-lactuca-sativa-lollo-bionda-specimen-empirical-cascade-frequency-ratio-n-fine-n-coarse-lactuca-sativa-edge-waves-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-lactuca-sativa-lollo-bionda-specimen-empirical-cascade-frequency-ratio-n-fine-n-coarse-lactuca-sativa-edge-waves-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Sharon et al. (2002) Nature Fig. 1c (r_cascade in [3, 5]) & Wikimedia Commons CC BY-SA 4.0" ;
        schema:value "4.75" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-multi-generation-edge-amplitude-a-m-0-correlation-across-g1-g4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Multi-generation edge amplitude A_m(0) correlation across G1-G4 = 1.0 Pearson r" ;
        dct:description "self-similar envelope collapse r = 1.0000" ;
        schema:measurementTechnique "L-BFGS-B relaxed edge amplitudes A_1..A_4 vs benchmark (p=1.26e-07, RMSE=0.0180 mm)" ;
        schema:name "Multi-generation edge amplitude A_m(0) correlation across G1-G4" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-multi-generation-edge-amplitude-a-m-0-correlation-across-g1-g4-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-multi-generation-edge-amplitude-a-m-0-correlation-across-g1-g4-reference> a schema:PropertyValue ;
        dct:source "Sharon et al. (2002) Nature 419:579-580 Fig. 3" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-self-similar-rescaled-profile-collapse-correlation-across-generations-g1-g4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Self-similar rescaled profile collapse correlation across generations G1-G4 = 1.0 Pearson r" ;
        dct:description "penetration depth correlation r = 1.0000" ;
        schema:measurementTechnique "Mean pairwise correlation of rescaled radial envelopes A_m(x)/lambda_m vs eta = x/lambda_m across G1-G4" ;
        schema:name "Self-similar rescaled profile collapse correlation across generations G1-G4" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-self-similar-rescaled-profile-collapse-correlation-across-generations-g1-g4-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-self-similar-rescaled-profile-collapse-correlation-across-generations-g1-g4-reference> a schema:PropertyValue ;
        dct:source "Audoly & Boudaoud (2003) Phys. Rev. Lett. 91:086105 Fig. 2" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-measurement-sharon-et-al-2002-self-similar-cascade-aspect-ratio-a-m-lambda-m-g-0-0-64> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Sharon et al. (2002) self-similar cascade aspect ratio A_m/lambda_m (g_0=0.64) = 0.1468 dimensionless" ;
        dct:description "G1..G4 aspect ratios = [0.147, 0.147, 0.147, 0.1462]" ;
        schema:measurementTechnique "L-BFGS-B Föppl-von Kármán relaxation across 4 cascade generations (RMSE=0.0008)" ;
        schema:name "Sharon et al. (2002) self-similar cascade aspect ratio A_m/lambda_m (g_0=0.64)" ;

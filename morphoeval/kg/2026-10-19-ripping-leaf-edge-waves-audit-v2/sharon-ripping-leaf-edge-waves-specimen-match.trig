sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sharon-ripping-leaf-edge-waves> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 *Lactuca sativa* cv. 'Lollo Bionda' ruffled leaf specimen `datasets/ripping_leaf_edge_waves/lactuca_sativa_edge_waves_specimen.jpg`, segments the ruffled canopy via Excess Green index (`segment_lactuca_sativa_specimen`, L515-591; canopy fraction = 0.7723), decomposes the polar perimeter into 4 coarse macro-lobes and 19 fine edge ripples (empirical cascade ratio 4.7500 in [3, 5]), and matches aspect ratios across 4 benchmark systems (r_aspect = 0.9992)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2002-sharon-ripping-leaf-edge-waves.py L515–L591" ;
        dct:description "ExG canopy segmentation and multi-scale polar perimeter wave decomposition on Lactuca sativa specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2002-sharon-ripping-leaf-edge-waves.py#L515-L591> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/ripping_leaf_edge_waves_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 3D cascade/saddle meshes, G1-G4 spectrum, self-similar collapse, K(x) profile, specimen segmentation, and 4-system validation — docs/media/ripping_leaf_edge_waves_comparison.png: rendered output of 2002-sharon-ripping-leaf-edge-waves.py at 8871db0, image/png, 1731094 B, 2775×1680 px, artifact_sha256 d5fb947fa012711aa8cf8764f2abea6d111decc28d191e48affe89c491a8ecda (sha256 d5fb947fa012711aa8cf8764f2abea6d111decc28d191e48affe89c491a8ecda), spec_fingerprint 76e95df006d28286f91c0499def91bec8f1f103355f3839ee42d4dfc6a511a73" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 067 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


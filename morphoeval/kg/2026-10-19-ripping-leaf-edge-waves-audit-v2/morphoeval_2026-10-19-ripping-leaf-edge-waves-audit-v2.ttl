<https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Sharon et al. (2002) Nature / Audoly & Boudaoud (2003) PRL Non-Euclidean Edge Buckling Cascades in Ruffled Leaf Margins — Model fidelity to source: 95/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Implements the exponential marginal growth metric g_yy(x) = 1 + g_0 exp(-x/ell) and exact Brioschi Gaussian curvature K(x) < 0 (`compute_target_metric_and_curvature`, L137-182), linear boundary wavelength scaling lambda_loc(x) (`compute_local_wavelength_profile`, L185-199), and an L-BFGS-B non-Euclidean Föppl-von Kármán multi-generation energy minimizer (`relax_foppl_von_karman_cascade`, L214-339) with flat Euclidean metric negative control (g_0 = 0 => A_m = 0), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_067_ripping_leaf_edge_waves.lean`." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-model-fidelity-2>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-sharon-ripping-leaf-edge-waves-model-fidelity-3> ;
    pk:hasScore 9.5e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-sharon-ripping-leaf-edge-waves-morphometric-validation> a pk:LLMClaimAssessment ;

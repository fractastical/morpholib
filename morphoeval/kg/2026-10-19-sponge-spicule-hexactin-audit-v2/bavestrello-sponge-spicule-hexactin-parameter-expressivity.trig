sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates all 5 Porifera spicule symmetry and ablation regimes (`none`, `D_inf_h`, `D_3h`, `T_d`, `O_h`), sweeps diagonal bracing fraction `f_diag` across `[0, 1]`, evaluates 12 species across Hexactinellida, Demospongiae, and Calcarea, and exposes `--d-s`, `--k-cat`, `--r-core`, `--n-lamellae`, `--seed`, and `--skip-gif` CLI overrides (L1217-1244)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-bavestrello-sponge-spicule-hexactin.py L346–L563" ;
        dct:description "5 spicule symmetry/ablation regimes, diagonal bracing sweep, and 12-species cross-taxa evaluation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L346-L563> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-bavestrello-sponge-spicule-hexactin.py L1217–L1244" ;
        dct:description "Full CLI parameter overrides wired into render_comparison_figure()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L1217-L1244> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


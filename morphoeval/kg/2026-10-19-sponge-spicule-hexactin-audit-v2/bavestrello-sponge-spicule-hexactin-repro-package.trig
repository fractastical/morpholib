sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics — Reproducibility package: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic execution (`seed=2012`), 8-check `self_test()` suite (L1148-1214) verifying SHA-256 provenance, JSON parity, `O_h` and `T_d` ray vector equilibrium, 3D biosilica accretion and silicatein-inhibited ablation, lamellar thinning exponent `-1.0000`, checkerboard shear gain `7.50x`, 12-species scaling, specimen segmentation, and bitwise two-run determinism (`np.allclose(..., atol=0.0)`), plus synchronized 6-panel PNG and 2-panel growth GIF outputs." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-repro-package-1> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-bavestrello-sponge-spicule-hexactin.py L1148–L1214" ;
        dct:description "8-check self_test() suite including bitwise determinism and JSON parity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L1148-L1214> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


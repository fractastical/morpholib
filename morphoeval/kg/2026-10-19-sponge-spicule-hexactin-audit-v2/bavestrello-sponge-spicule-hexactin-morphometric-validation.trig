    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-3d-accreted-hexactinellida-o-h-hexactin-orthogonal-inter-ray-angle-reference> a schema:PropertyValue ;

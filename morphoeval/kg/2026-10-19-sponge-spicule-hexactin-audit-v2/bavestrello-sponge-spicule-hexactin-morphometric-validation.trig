    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-euplectella-alternating-checkerboard-diagonal-bracing-shear-stiffness-amplification-f-diag-0-5-vs-unbraced-f-diag-0> a schema:PropertyValue,
            pk:EvidenceItem ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 9 reference-anchored morphometrics in `measure_morphoeval()` (L1042-1145), including 12-species inter-ray angle correlation (`r = 1.0000`, `RMSE = 0.1455 deg`), 12-species lamellar fracture toughness correlation (`r = 1.0000`), 3D accreted `O_h` hexactin angle (`90.0 deg`), 3D accreted `T_d` tetractin angle (`109.4712 deg`), concentric lamellar thinning exponent (`-1.0000`), checkerboard diagonal shear stiffness gain (`7.50x`), silicatein-inhibited ablation negative control (`0.0 rays`), and *Euplectella* specimen orthogonal strut angle (`89.6498 deg`) and lattice pitch (`2.5000 mm`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-12-species-concentric-lamellar-fracture-toughness-correlation-g-lam-g-mono-1-eta-n>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-12-species-porifera-silicatein-inter-ray-symmetry-angle-correlation-o-h-90-t-d-109-47-d-3h-120-d-inf-h-180>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-3d-accreted-demospongiae-t-d-tetractin-calthrop-tetrahedral-inter-ray-angle-arccos-1-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-3d-accreted-hexactinellida-o-h-hexactin-orthogonal-inter-ray-angle>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-concentric-biosilica-lamellar-radial-thinning-exponent-alpha-h-n-prop-r-n-alpha>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-euplectella-alternating-checkerboard-diagonal-bracing-shear-stiffness-amplification-f-diag-0-5-vs-unbraced-f-diag-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-euplectella-specimen-segmented-orthogonal-hexactin-strut-intersection-angle-euplectella-aspergillum-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-euplectella-specimen-segmented-square-lattice-pitch-euplectella-aspergillum-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-silicatein-inhibited-si-starved-ablation-negative-control-accreted-spicule-rays-k-cat-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-morphometric-validation-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-12-species-concentric-lamellar-fracture-toughness-correlation-g-lam-g-mono-1-eta-n> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species concentric lamellar fracture toughness correlation G_lam / G_mono = 1 + eta * N = 1.0 Pearson r" ;
        dct:description "Hexactinellid mean = 9.07x vs Demospongiae/Calcarea mean = 3.28x" ;
        schema:measurementTechnique "Correlation of predicted vs empirical flexural fracture toughness amplification across 12 sponge species (RMSE=0.0294)" ;
        schema:name "12-species concentric lamellar fracture toughness correlation G_lam / G_mono = 1 + eta * N" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-12-species-concentric-lamellar-fracture-toughness-correlation-g-lam-g-mono-1-eta-n-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-12-species-concentric-lamellar-fracture-toughness-correlation-g-lam-g-mono-1-eta-n-reference> a schema:PropertyValue ;
        dct:source "Aizenberg et al. (2005) Science 309:275-278 & Weaver et al. (2007) J. Struct. Biol. 158:93-106" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-12-species-porifera-silicatein-inter-ray-symmetry-angle-correlation-o-h-90-t-d-109-47-d-3h-120-d-inf-h-180> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species Porifera silicatein inter-ray symmetry angle correlation (O_h 90°, T_d 109.47°, D_3h 120°, D_inf_h 180°) = 1.0 Pearson r" ;
        dct:description "RMSE = 0.1351 deg across 4 Porifera clades" ;
        schema:measurementTechnique "Correlation of theoretical crystallographic silicatein filament angles vs observed spicule inter-ray angles across 12 Hexactinellida, Demospongiae, and Calcarea species (RMSE=0.1351 deg)" ;
        schema:name "12-species Porifera silicatein inter-ray symmetry angle correlation (O_h 90°, T_d 109.47°, D_3h 120°, D_inf_h 180°)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-12-species-porifera-silicatein-inter-ray-symmetry-angle-correlation-o-h-90-t-d-109-47-d-3h-120-d-inf-h-180-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-12-species-porifera-silicatein-inter-ray-symmetry-angle-correlation-o-h-90-t-d-109-47-d-3h-120-d-inf-h-180-reference> a schema:PropertyValue ;
        dct:source "Uriz et al. (2003) Microsc. Res. Tech. 62:279-299 & Aizenberg et al. (2005) Science 309:275-278" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-3d-accreted-demospongiae-t-d-tetractin-calthrop-tetrahedral-inter-ray-angle-arccos-1-3> a schema:PropertyValue,

        schema:measurementTechnique "Nearest-neighbor inter-ray angle measured from 3D silicatein diffusion-reaction biosilica density field B(x,y,z) for 4-ray tetrahedral T_d filament" ;
        schema:name "3D accreted Demospongiae T_d tetractin/calthrop tetrahedral inter-ray angle arccos(-1/3)" ;
        schema:unitText "deg" ;
        schema:value "109.4712" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-3d-accreted-demospongiae-t-d-tetractin-calthrop-tetrahedral-inter-ray-angle-arccos-1-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-measurement-3d-accreted-demospongiae-t-d-tetractin-calthrop-tetrahedral-inter-ray-angle-arccos-1-3-reference> a schema:PropertyValue ;

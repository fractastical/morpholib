sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors, SHA-256-verifies, and performs Difference-of-Gaussians and gradient tangent orientation segmentation (`segment_euplectella_specimen`, L567-642) on the Public-domain *Euplectella aspergillum* glass sponge skeleton photograph (`datasets/sponge_spicule_hexactin/euplectella_aspergillum_specimen.jpg`), detecting orthogonal hexactin strut crossings (`89.6498 deg` vs theoretical `90.0 deg`), alternating diagonal bracing struts (`47.6843 deg` vs `45.0 deg`), and square lattice pitch `2.5000 mm` (`24.07 px`, `CV = 0.3997` across 536 inter-strut intervals)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2012-bavestrello-sponge-spicule-hexactin.py L567–L642" ;
        dct:description "DoG ridge and gradient-tangent orientation segmentation on Euplectella aspergillum specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L567-L642> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/sponge_spicule_hexactin_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 3D spicule symmetries, lamellar mechanics, 12-species collapse, and Euplectella specimen segmentation — docs/media/sponge_spicule_hexactin_comparison.png: rendered output of 2012-bavestrello-sponge-spicule-hexactin.py at HEAD, image/png, 776433 B, 2164×1417 px, artifact_sha256 f76bee5892646c3a6a42add0631fec9dd8081d00b168c3c1803fecc898be9827 (sha256 f76bee5892646c3a6a42add0631fec9dd8081d00b168c3c1803fecc898be9827), spec_fingerprint a5bee59a94597f4d966c69c524721cb2d57ff58a497dff220c73adc1f47687dd" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


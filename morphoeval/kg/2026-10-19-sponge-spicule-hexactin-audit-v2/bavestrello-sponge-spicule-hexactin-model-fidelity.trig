sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bavestrello-sponge-spicule-hexactin> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Uriz et al. (2003) & Aizenberg et al. (2005) sponge spicule silicatein axial symmetry, concentric biosilica lamination, and Euplectella checkerboard lattice mechanics — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements exact crystallographic silicatein filament ray symmetries (`O_h`, `T_d`, `D_3h`, `D_inf_h`; L128-220), a 3D silicic acid reaction-diffusion biosilica accretion PDE solver (`simulate_spicule_biosilica_accretion_3d`, L224-343) with silicatein-inhibited ablation control (`k_cat = 0`), concentric lamellar radial thinning `h_n = h_1*(r_1/r_n)` (`simulate_concentric_lamellar_spicule`, L370-435), and *Euplectella* alternating checkerboard diagonal lattice shear stiffness (`simulate_euplectella_lattice_mechanics`, L439-483). Backed by 4 machine-checked Lean 4 theorems in `Loop_076_sponge_spicule_hexactin.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-bavestrello-sponge-spicule-hexactin.py L128–L343" ;
        dct:description "3D silicatein filament symmetry algebra and 3D reaction-diffusion biosilica accretion solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L128-L343> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-bavestrello-sponge-spicule-hexactin.py L370–L483" ;
        dct:description "Concentric lamellar thinning h_n ∝ r_n^-1 and Euplectella checkerboard diagonal shear stiffness" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2012-bavestrello-sponge-spicule-hexactin.py#L370-L483> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bavestrello-sponge-spicule-hexactin-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_076_sponge_spicule_hexactin.lean L22–L216" ;
        dct:description "4 Lean 4 theorems proving O_h 6-ray orthogonality, T_d 4-ray cos=-1/3 identity, lamellar thinning, and checkerboard shear stiffness" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_076_sponge_spicule_hexactin.lean#L22-L216> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


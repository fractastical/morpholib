    <https://doi.org/10.1002/jemt.10395> dct:date "2003"^^xsd:gYear ;
        dct:title "Siliceous spicules and skeleton frameworks in sponges: origin, diversity, ultrastructural patterns, and biological functions" .
    <https://doi.org/10.1016/j.jsb.2007.01.006> dct:date "2007"^^xsd:gYear ;
        dct:title "Hierarchical assembly of the siliceous skeletal lattice of the hexactinellid sponge Euplectella aspergillum" .
    <https://doi.org/10.1073/pnas.95.11.6234> dct:date "1998"^^xsd:gYear ;
        dct:title "Silicatein alpha: cathepsin L-like protein in sponge biosilica" .
    <https://doi.org/10.1126/science.1112255> dct:date "2005"^^xsd:gYear ;

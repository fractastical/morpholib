<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg–Turing wavelength at 39 µm in Botryllus schlosseri (Holocene, detail scale) — Code-to-model traceability: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The module docstring states the PDE, the steady state, and the k_c identity, and names the functions that implement them. Lean theorems encode the diffusion-product sign, the cancellation in the wavenumber identity, the 38.72 µm versus 10 µm margin, and the seven-mode count." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg–Turing wavelength at 39 µm in Botryllus schlosseri (Holocene, detail scale) — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates Schnakenberg kinetics and evaluates σ(k) from J - k²D. Diffusivities are solved so the onset identity k_c² = (D_v f_u + D_u g_v)/(2 D_u D_v) equals 2π/λ with λ = 38.72 µm. The γ scale and the autocatalytic term are not yet both ablated." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity-1> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .


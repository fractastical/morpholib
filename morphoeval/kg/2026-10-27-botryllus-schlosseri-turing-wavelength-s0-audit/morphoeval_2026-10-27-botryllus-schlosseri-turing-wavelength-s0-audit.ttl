    rdfs:label "Critical wavenumber" ;
    dct:description "Wavelength selection at 38.72 µm inside a 271.04 µm window (7 modes) | Variables: p is the cleared wavenumber identity; q cancels" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py#L107-L119>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3136_botryllus_schlosseri_turing_wavelength_s0.lean#L21-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c" ;

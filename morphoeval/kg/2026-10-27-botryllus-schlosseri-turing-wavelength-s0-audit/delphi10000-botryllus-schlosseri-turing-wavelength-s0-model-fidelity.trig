sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing wavelength at 39 µm in Botryllus schlosseri (Holocene, detail scale) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script integrates Schnakenberg kinetics and evaluates σ(k) from J - k²D. Diffusivities are solved so the onset identity k_c² = (D_v f_u + D_u g_v)/(2 D_u D_v) equals 2π/λ with λ = 38.72 µm. The γ scale and the autocatalytic term are not yet both ablated." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity-1> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-botryllus-schlosseri-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py L77–L129" ;
        dct:description "jacobian, critical ratio, diffusivities_for_wavenumber, growth_rates" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-botryllus-schlosseri-turing-wavelength-s0.py#L77-L129> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


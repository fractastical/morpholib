sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L610-675) computes 8 reference-backed morphometrics covering short-range 2x2 minor det(J_uv) = -1.61, Routh-Hurwitz stability margin p1*p2 - p3 = 1.114, critical wavenumber k_c = 3.4110, characteristic stripe wavelength lambda_c = 1.8420, 2D PDE melanophore-xanthophore anti-phase correlation r_uv = -1.000, xanthophore laser-ablation melanophore loss fraction (0.8342 vs >0.45 threshold), equal-diffusion and no-repulsion negative-control amplitude suppression (9.78e-4 and 1.25e-7 vs 0.5770), and segmented Danio rerio trunk inter-stripe wavelength (23.67 px, CV = 0.1109)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-2d-pde-melanophore-xanthophore-anti-phase-pearson-correlation-r-uv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-3-species-turing-critical-wavenumber-k-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-characteristic-zebrafish-stripe-wavelength-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-equal-diffusion-dw-du-and-no-repulsion-bu-av-0-negative-control-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-homogeneous-k-0-routh-hurwitz-stability-margin-p1-p2-p3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-in-silico-xanthophore-interstripe-laser-ablation-melanophore-loss-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-segmented-danio-rerio-specimen-trunk-flank-inter-stripe-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-short-range-melanophore-xanthophore-2x2-minor-det-j-uv>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-2d-pde-melanophore-xanthophore-anti-phase-pearson-correlation-r-uv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D PDE melanophore-xanthophore anti-phase Pearson correlation r_uv = -0.9995 Pearson r" ;
        dct:description "horizontal stripe gradient anisotropy |gy|/|gx| = 144.888" ;
        schema:measurementTechnique "spatial correlation between u(x,y) and v(x,y) in converged 2D 3-species PDE" ;
        schema:name "2D PDE melanophore-xanthophore anti-phase Pearson correlation r_uv" ;
        schema:unitText "Pearson r" ;
        schema:value "-0.9995" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-2d-pde-melanophore-xanthophore-anti-phase-pearson-correlation-r-uv-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-2d-pde-melanophore-xanthophore-anti-phase-pearson-correlation-r-uv-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 1 / Fig. 4D mutual exclusion of black stripes and yellow interstripes" ;
        schema:value "-0.95" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-3-species-turing-critical-wavenumber-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3-species Turing critical wavenumber k_c = 3.411 dimensionless wavenumber" ;
        dct:description "unstable band k in [2.1140, 5.3670], sigma_max = 0.19247" ;
        schema:measurementTechnique "argmax_k Re(eigvals(J0 - k^2 * diag(Du, Dv, Dw))) at Dw/Du = 25" ;
        schema:name "3-species Turing critical wavenumber k_c" ;
        schema:unitText "dimensionless wavenumber" ;
        schema:value "3.411" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-3-species-turing-critical-wavenumber-k-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-3-species-turing-critical-wavenumber-k-c-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 5 & SI Text" ;
        schema:value "3.4106" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-characteristic-zebrafish-stripe-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "characteristic zebrafish stripe wavelength lambda_c = 1.842 dimensionless length" ;
        dct:description "yields 5 horizontal dark melanophore stripes across L_y = 9.2" ;
        schema:measurementTechnique "2 * pi / k_c" ;
        schema:name "characteristic zebrafish stripe wavelength lambda_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "1.842" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-characteristic-zebrafish-stripe-wavelength-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-characteristic-zebrafish-stripe-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 5" ;
        schema:value "1.8423" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-equal-diffusion-dw-du-and-no-repulsion-bu-av-0-negative-control-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (Dw=Du) and no-repulsion (bu=av=0) negative control amplitude = 0.000978 std(u) control" ;
        dct:description "positive std(u) = 0.5770 vs equal-diff std(u) = 9.78e-04 and no-repulsion std(u) = 2.57e-15" ;
        schema:measurementTechnique "2D 3-species PDE std(u) at Dw=Du=Dv=0.02 and at bu=av=0.0 vs positive Dw=0.50" ;
        schema:name "equal-diffusion (Dw=Du) and no-repulsion (bu=av=0) negative control amplitude" ;
        schema:unitText "std(u) control" ;
        schema:value "0.000978" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-equal-diffusion-dw-du-and-no-repulsion-bu-av-0-negative-control-amplitude-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-equal-diffusion-dw-du-and-no-repulsion-bu-av-0-negative-control-amplitude-reference> a schema:PropertyValue ;
        dct:source "Lean 4 Theorems 1 & 3 (Loop_007_zebrafish_three_cell_stripes.lean)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-homogeneous-k-0-routh-hurwitz-stability-margin-p1-p2-p3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "homogeneous k=0 Routh-Hurwitz stability margin p1*p2 - p3 = 1.114 dimensionless" ;
        dct:description "p1=2.500, p2=1.630, p3=2.961, max Re(eig J0)=-0.0782 < 0" ;
        schema:measurementTechnique "(-tr J0)*(M_uv + M_uw + M_vw) - (-det J0) at k = 0 (Lean Theorem 2)" ;
        schema:name "homogeneous k=0 Routh-Hurwitz stability margin p1*p2 - p3" ;
        schema:unitText "dimensionless" ;
        schema:value "1.114" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-homogeneous-k-0-routh-hurwitz-stability-margin-p1-p2-p3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-homogeneous-k-0-routh-hurwitz-stability-margin-p1-p2-p3-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 SI Text & Lean Theorem 2" ;
        schema:value "1.114" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-in-silico-xanthophore-interstripe-laser-ablation-melanophore-loss-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "in silico xanthophore interstripe laser-ablation melanophore loss fraction = 0.8345 fraction lost (1 - u_ablated/u_intact)" ;
        dct:description "intact u = 1.812 -> ablated u = 0.300, window regen anisotropy = 7.384" ;
        schema:measurementTechnique "melanophore density drop in central stripe after flanking xanthophore ablation (v=0)" ;
        schema:name "in silico xanthophore interstripe laser-ablation melanophore loss fraction" ;
        schema:unitText "fraction lost (1 - u_ablated/u_intact)" ;
        schema:value "0.8345" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-in-silico-xanthophore-interstripe-laser-ablation-melanophore-loss-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-in-silico-xanthophore-interstripe-laser-ablation-melanophore-loss-fraction-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 2 (>45% melanophore death after xanthophore ablation)" ;
        schema:value "0.45" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-segmented-danio-rerio-specimen-trunk-flank-inter-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented Danio rerio specimen trunk flank inter-stripe wavelength = 23.6667 px" ;
        dct:description "N = 4 dark stripes at y = [55, 81, 106, 126] px, spacing CV = 0.1109, horizontal anisotropy |gy|/|gx| = 1.8343" ;
        schema:measurementTechnique "mean vertical spacing between segmented dark melanophore stripes in datasets/zebrafish_three_cell_stripes/danio_rerio_specimen.jpg flank ROI [220, 125, 460, 265]" ;
        schema:name "segmented Danio rerio specimen trunk flank inter-stripe wavelength" ;
        schema:unitText "px" ;
        schema:value "23.6667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-segmented-danio-rerio-specimen-trunk-flank-inter-stripe-wavelength-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-segmented-danio-rerio-specimen-trunk-flank-inter-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 1 adult Danio rerio trunk stripes" ;
        schema:value "23.67" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-short-range-melanophore-xanthophore-2x2-minor-det-j-uv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "short-range melanophore-xanthophore 2x2 minor det(J_uv) = -1.61 s^-2 (dimensionless)" ;
        dct:description "anti-phase short-range growth rate lambda_anti = 0.7000 > 0" ;
        schema:measurementTechnique "c_u * c_v - b_u * a_v at c_u=c_v=0.80, b_u=a_v=-1.50 (Lean Theorem 1)" ;
        schema:name "short-range melanophore-xanthophore 2x2 minor det(J_uv)" ;
        schema:unitText "s^-2 (dimensionless)" ;
        schema:value "-1.61" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-short-range-melanophore-xanthophore-2x2-minor-det-j-uv-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-short-range-melanophore-xanthophore-2x2-minor-det-j-uv-reference> a schema:PropertyValue ;
        dct:source "Nakamasu et al. (2009) PNAS 106(21):8429-8434 Fig. 4D & Lean Theorem 1" ;
        schema:value "-1.61" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L610–L675" ;
        dct:description "8 reference-backed morphometric measurements across theory, 2D PDE, laser ablation, controls, and specimen pixels" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L610-L675> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 007 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

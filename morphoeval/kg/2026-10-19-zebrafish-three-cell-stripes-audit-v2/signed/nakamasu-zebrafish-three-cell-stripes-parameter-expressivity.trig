sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Sweeps all 4 *leopard* (cx41.8 / gja5b) alleles and wild-type guidance regimes (`run_leopard_morphospace_sweep`, L421-449) spanning `leo^t1` melanophore spots, `leo^tw28` vermiform labyrinth, wild-type horizontal myoseptum-guided stripes, and inverse xanthophore spots; executes dual negative controls (`run_negative_controls`, L452-468) at equal diffusion (D_w = D_u = 0.02) and ablated mutual repulsion (b_u = a_v = 0.0); and exposes full CLI flags (`--cu`, `--bu`, `--du`, `--av`, `--cv`, `--bw`, `--cw`, `--Du`, `--Dv`, `--Dw`, `--delta`, `--cue`, `--steps`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L421–L468" ;
        dcterms:description "4-regime leopard (cx41.8) spot-to-stripe sweep and dual negative controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L421-L468> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L695–L718" ;
        dcterms:description "CLI parameters for all 3-species kinetic, diffusive, and guidance variables" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L695-L718> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 007 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


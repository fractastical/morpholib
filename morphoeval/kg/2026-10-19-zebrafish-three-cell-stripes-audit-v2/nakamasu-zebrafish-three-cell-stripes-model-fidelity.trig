sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Evaluates the exact 3x3 Nakamasu et al. (2009) Jacobian J0, short-range (u, v) saddle minor det(J_uv) = -1.61 < 0, k = 0 Routh-Hurwitz invariants (p1 = 2.50, p2 = 1.63, p3 = 2.961, p1*p2 - p3 = 1.114 > 0), and dispersion curve sigma(k) across k in [0, 6.5] (L100-198); integrates the 2D nonlinear 3-species (u, v, w) reaction-diffusion PDE with saturating synthesis rates and horizontal myoseptum X0 pioneer guidance via DCT-II IMEX (L204-312); reproduces Nakamasu (2009) Figs. 2-3 laser-ablation experiments in silico (L318-415); and backs all 3 laws with machine-checked Lean 4 theorems in `Loop_007_zebrafish_three_cell_stripes.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L100–L312" ;
        dct:description "Exact 3-species Jacobian, Routh-Hurwitz invariants, dispersion curve, and 2D DCT-II IMEX 3-cell PDE solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L100-L312> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L318–L415" ;
        dct:description "In silico xanthophore interstripe laser ablation (Fig. 2) and rectangular window regeneration polarity (Fig. 3)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2009-nakamasu-zebrafish-three-cell-stripes.py#L318-L415> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean L1–L128" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for short-range saddle, Routh-Hurwitz k=0 stabilization, and Dw/Du=25 Turing band" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L1-L128> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 007 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-grimshawi-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg dispersion eigenvalue" ;
    dct:description "Homogeneous state is stable (trace < 0) so pattern requires diffusion | Variables: f_u, g_v reaction Jacobian entries at the homogeneous steady state" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-grimshawi-turing-wavelength-s0.py#L67-L79>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3186_drosophila_grimshawi_turing_wavelength_s0.lean#L16-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "sigma(k) = 1/2 (tr + sqrt(tr^2 - 4 det)), tr = f_u + g_v - k^2 (D_u + D_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/dgd.12661>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3186.traceScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3186.homogeneous_state_stable_without_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-grimshawi-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion suppression" ;
    dct:description "Negative control for the Turing condition | Variables: sigma scaled by 1e6 at equal diffusivities" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-grimshawi-turing-wavelength-s0.py#L337-L355>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3186_drosophila_grimshawi_turing_wavelength_s0.lean#L22-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_u = D_v implies max_k sigma(k) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1038/nature08896>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/dgd.12661>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (1. Chemical Turing / RD)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3186.equalDiffusionSigmaScaled" ;
    pk:leanTheorem "MathOfBiology.Loop_3186.equal_diffusion_suppresses_the_instability" ;
    pk:leanVerified true .


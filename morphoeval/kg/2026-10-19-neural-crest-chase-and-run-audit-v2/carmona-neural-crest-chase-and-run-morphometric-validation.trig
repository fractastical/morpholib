sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-carmona-neural-crest-chase-and-run> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Quantifies 8 reference-anchored morphometric and kinematic metrics in `measure_morphoeval()` (L940-1010), validating the 5-regime Forward Migration Index hierarchy (r = 0.9954, RMSE = 0.0269), 6-hour stream displacement hierarchy (r = 0.9779), C3a/C3aR cluster cohesion drop under C3aR-MO (1.000 vs 0.449), specimen dorsoventral separation (+0.4063), inter-placode periodicity (CV = 0.0457), BMPR stream truncation (0.5877), and dorsoventral density profile match (r = 0.9225)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-c3ar-mo-vs-wildtype-cohesion-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-attraction-at-contact-radius>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-contact-repulsion-at-zero-distance>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-five-regime-displacement-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-no-placode-control-forward-migration-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-specimen-dorsoventral-chaser-runner-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-specimen-vs-model-dorsoventral-profile-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-wildtype-chase-and-run-forward-migration-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-c3ar-mo-vs-wildtype-cohesion-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "c3ar_mo_vs_wildtype_cohesion_ratio = 0.4541 ratio" ;
        schema:measurementTechnique "Cluster cohesion ratio C_COA(C3aR-MO) / C_COA(WT) (0.454 vs 1.000, Carmona-Fontaine et al. 2011 Dev. Cell Fig. 3)" ;
        schema:name "c3ar_mo_vs_wildtype_cohesion_ratio" ;
        schema:unitText "ratio" ;
        schema:value "0.4541" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-c3ar-mo-vs-wildtype-cohesion-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-c3ar-mo-vs-wildtype-cohesion-ratio-reference> a schema:PropertyValue ;
        schema:value "0.3421" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-attraction-at-contact-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cil_coa_attraction_at_contact_radius = 1.1015 force_units" ;
        schema:measurementTechnique "Net homotypic pair force F_pair(R_CIL) = k_COA * exp(-R_CIL / l_COA) at d = R_CIL = 28 um (Carmona-Fontaine et al. 2011 Dev. Cell)" ;
        schema:name "cil_coa_attraction_at_contact_radius" ;
        schema:unitText "force_units" ;
        schema:value "1.1015" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-attraction-at-contact-radius-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-attraction-at-contact-radius-reference> a schema:PropertyValue ;
        schema:value "1.1015" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-contact-repulsion-at-zero-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cil_coa_contact_repulsion_at_zero_distance = -2.6 force_units" ;
        schema:measurementTechnique "Net homotypic pair force F_pair(0) = -k_CIL + k_COA for k_CIL=4.2, k_COA=1.6 with equilibrium spacing d_eq=19.81 um (Carmona-Fontaine et al. 2011; Woods et al. 2014)" ;
        schema:name "cil_coa_contact_repulsion_at_zero_distance" ;
        schema:unitText "force_units" ;
        schema:value "-2.6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-contact-repulsion-at-zero-distance-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-cil-coa-contact-repulsion-at-zero-distance-reference> a schema:PropertyValue ;
        schema:value "-2.6" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-five-regime-displacement-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "five_regime_displacement_pearson_r = 0.9779 r" ;
        schema:measurementTechnique "Pearson correlation between simulated and empirical 6-hour stream displacement across all 5 regimes of Theveneau et al. (2013) (RMSE=26.88 um, p=0.0039)" ;
        schema:name "five_regime_displacement_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9779" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-five-regime-displacement-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-five-regime-displacement-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.95" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-no-placode-control-forward-migration-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "no_placode_control_forward_migration_index = 0.012 FMI" ;
        schema:measurementTechnique "Null Forward Migration Index |FMI| in placode-ablated / Sdf1-MO negative control (chi_Sdf1 = 0, Theveneau et al. 2013 Fig. 1)" ;
        schema:name "no_placode_control_forward_migration_index" ;
        schema:unitText "FMI" ;
        schema:value "0.012" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-no-placode-control-forward-migration-index-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-no-placode-control-forward-migration-index-reference> a schema:PropertyValue ;
        schema:value "0.04" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-specimen-dorsoventral-chaser-runner-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_dorsoventral_chaser_runner_separation = 0.4063 normalized_dv_distance" ;
        schema:measurementTechnique "Normalized dorsoventral separation (y_PL - y_NC)/H between epibranchial placodes (e1-e3) and cranial neural crest streams (r4/r6/r7) on neural_crest_specimen.jpg (placode spacing CV=0.0296)" ;
        schema:name "specimen_dorsoventral_chaser_runner_separation" ;
        schema:unitText "normalized_dv_distance" ;
        schema:value "0.4063" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-specimen-dorsoventral-chaser-runner-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-specimen-dorsoventral-chaser-runner-separation-reference> a schema:PropertyValue ;
        schema:value "0.4063" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-specimen-vs-model-dorsoventral-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_vs_model_dorsoventral_profile_pearson_r = 0.9225 r" ;
        schema:measurementTechnique "Pearson correlation between 3-stream model and segmented specimen dorsoventral chaser-runner profiles across 12 bins (RMSE=0.2640, BMPR-inhib stream loss=0.272)" ;
        schema:name "specimen_vs_model_dorsoventral_profile_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9225" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-specimen-vs-model-dorsoventral-profile-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-specimen-vs-model-dorsoventral-profile-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.9" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-wildtype-chase-and-run-forward-migration-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wildtype_chase_and_run_forward_migration_index = 0.6853 FMI" ;
        schema:measurementTechnique "Wild-type chase-and-run Forward Migration Index (FMI) vs Theveneau et al. (2013) Fig. 2 empirical reference (5-regime r=0.9954, RMSE=0.0269, p=0.0004)" ;
        schema:name "wildtype_chase_and_run_forward_migration_index" ;
        schema:unitText "FMI" ;
        schema:value "0.6853" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-wildtype-chase-and-run-forward-migration-index-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-measurement-wildtype-chase-and-run-forward-migration-index-reference> a schema:PropertyValue ;
        schema:value "0.68" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py L666–L720" ;
        dct:description "Pearson r and RMSE validation of 5-regime FMI and 6-hour collective displacement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L666-L720> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py L940–L1010" ;
        dct:description "8 reference-anchored morphometric measurements in measure_morphoeval()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L940-L1010> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2010.06.012>,
            <https://doi.org/10.1016/j.devcel.2011.10.012>,
            <https://doi.org/10.1038/nature07441>,
            <https://doi.org/10.1038/ncb2772>,
            <https://doi.org/10.1371/journal.pone.0104969> .
    <https://doi.org/10.1016/j.devcel.2010.06.012> dct:date "2010"^^xsd:gYear ;
        dct:title "Collective chemotaxis requires contact-dependent cell polarity" .
    <https://doi.org/10.1016/j.devcel.2011.10.012> dct:date "2011"^^xsd:gYear ;
        dct:title "Complement fragment C3a controls mutual cell attraction during collective cell migration" .
    <https://doi.org/10.1038/nature07441> dct:date "2008"^^xsd:gYear ;
        dct:title "Contact inhibition of locomotion in vivo controls neural crest directional migration" .
    <https://doi.org/10.1038/ncb2772> dct:date "2013"^^xsd:gYear ;
        dct:title "Chase-and-run between adjacent cell populations promotes directional collective migration" .
    <https://doi.org/10.1371/journal.pone.0104969> dct:date "2014"^^xsd:gYear ;
        dct:title "Directional collective cell migration emerges as a property of cell interactions" .
}


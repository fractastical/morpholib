sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-carmona-neural-crest-chase-and-run> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration — Reproducibility package: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Uses deterministic `np.random.default_rng(2013)`, verifies reference dataset SHA-256 at runtime, executes 8 comprehensive checks in `--self-test` including two-run bitwise determinism (`self_test`, L1013-1065), and achieves `quick_gate = 100/100` in `morphoeval/measure_outputs.py`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-repro-package-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py L1013–L1065" ;
        dct:description "8-check self_test() verifying SHA-256 integrity, CIL/COA sign flip, 5-regime FMI/displacement match, specimen segmentation, and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L1013-L1065> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-carmona-neural-crest-chase-and-run> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements the Woods et al. (2014) / Carmona-Fontaine et al. (2008, 2011) homotypic CIL repulsion and C3a/C3aR co-attraction force laws (`compute_cil_coa_pair_force`, L101-140), analytical chase-and-run wave equilibria (`compute_chase_and_run_wave_state`, L143-185), 5-regime agent-based co-migration solver (`simulate_chase_and_run_regime`, L192-371), and 3-stream pharyngeal arch solver (`simulate_three_pharyngeal_streams`, L374-515), backed by 4 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_091_neural_crest_chase_and_run.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py L101–L185" ;
        dcterms:description "Analytical CIL/COA equilibrium spacing and chase-and-run co-migration wave state" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L101-L185> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py L192–L515" ;
        dcterms:description "2D agent-based 5-regime chase-and-run solver and 3-stream pharyngeal arch simulation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L192-L515> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_091_neural_crest_chase_and_run.lean L22–L160" ;
        dcterms:description "4 machine-checked Lean 4 theorems (0 sorrys) for CIL/COA balance, chase-and-run wave, 5-regime hierarchy, and CIL collision inversion" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_091_neural_crest_chase_and_run.lean#L22-L160> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


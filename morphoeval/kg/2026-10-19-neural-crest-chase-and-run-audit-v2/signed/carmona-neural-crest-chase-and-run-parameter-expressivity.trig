        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates all 5 experimental regimes of Theveneau et al. (2013) (`evaluate_all_five_regimes`, L666-720), executes a 5x5 2D parameter sweep over `(k_COA, chi_Sdf1)` (`run_2d_parameter_sweep`, L518-548), models the 3-stream pharyngeal pouch architecture, and exposes CLI flags for `--k-cil`, `--k-coa`, `--chi-sdf1`, `--k-run`, `--steps`, `--seed`, `--output`, `--gif`, and `--self-test` (`main`, L1068-1101)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

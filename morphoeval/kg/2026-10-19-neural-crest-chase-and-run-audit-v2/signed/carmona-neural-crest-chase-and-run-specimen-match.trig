sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-carmona-neural-crest-chase-and-run> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration — Morphological realism / specimen match: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Loads and SHA-256-verifies `datasets/neural_crest_chase_and_run/neural_crest_specimen.jpg` (`verify_reference_dataset`, L79-94) and segments the 3 blue cranial neural crest streams (`r4`, `r6`, `r7`), 3 orange epibranchial placode targets (`e1`, `e2`, `e3`), and green pharyngeal pouches (`p1`, `p2`, `p3`) across Control Panel A and BMPR-inhibited Panel C (`segment_neural_crest_specimen`, L555-663), reproducing dorsoventral chaser-runner separation +0.4063, inter-placode spacing CV 0.0457, BMPR ventral stream reduction 0.5877, and dorsoventral density profile correlation r = 0.9225 (RMSE = 0.2640)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-specimen-match-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py L79–L94" ;
        dcterms:description "Runtime SHA-256 verification of neural_crest_specimen.jpg against reference JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py#L79-L94> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-carmona-neural-crest-chase-and-run-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py L555–L663" ;

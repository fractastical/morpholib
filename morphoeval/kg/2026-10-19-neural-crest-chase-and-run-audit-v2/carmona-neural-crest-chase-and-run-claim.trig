sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-carmona-neural-crest-chase-and-run> a pk:Claim ;
        rdfs:label "Carmona-Fontaine et al. (2008, 2011) & Theveneau et al. (2013) neural crest CIL, C3a co-attraction & Sdf1 chase-and-run migration faithfully reproduces Xenopus laevis & Mus musculus vertebrate cranial neural crest streams and epibranchial placodes morphology" ;
        dct:description "The simulation script(s) 2012-carmona-neural-crest-chase-and-run.py implement the cited source model as published and produce forms that match real Xenopus laevis & Mus musculus vertebrate cranial neural crest streams and epibranchial placodes specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 90.9/100, audit 2026-10-19-neural-crest-chase-and-run-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py; output: docs/media/neural_crest_chase_and_run_comparison.png; organism: Xenopus laevis & Mus musculus vertebrate cranial neural crest streams and epibranchial placodes; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: eaab4129b9e5439c62a3183cca6415d43a158fd3cba206648d80e37937887881; artifact_sha256: 2d76edf0601f4cce565372ca0c48bb0594630a6bd4ea51b00401b33e0803e22f; supersedes_audit_id: 2026-10-19-neural-crest-chase-and-run-audit; claim_boundary: [reported_in_source: Theveneau et al. (2013) Nat. Cell Biol. 15:763-772 five-regime chase-and-run hierarchy across wild-type NC + placode (FMI = 0.68, 6h disp = 185 um), stationary Sdf1 bead (FMI = 0.42, disp = 95 um), N-cadherin/DshDep+ CIL blockade (FMI = 0.28, disp = 54 um), C3aR-MO COA ablation (FMI = 0.21, disp = 38 um), and placode/Sdf1 ablation (FMI = 0.04, disp = 12 um) | Carmona-Fontaine et al. (2008, 2011) and Woods et al. (2014) PLOS ONE 9:e104969 short-range PCP/RhoA contact inhibition of locomotion (CIL) and autocrine C3a/C3aR co-attraction (COA) stabilizing collective cluster migration; reconstructed_in_script: 2D interacting multi-agent chase-and-run dynamical system across all 5 experimental regimes of Theveneau et al. (2013) (FMI Pearson r = 0.9954, RMSE = 0.0269; 6h displacement Pearson r = 0.9779) plus 3-stream pharyngeal arch simulation (r4, r6, r7 streams targeting e1, e2, e3 placodes between pharyngeal pouches p1-p3) | Automated segmentation of neural_crest_specimen.jpg (Panel A control vs Panel C BMPR-inhibited) quantifying dorsoventral chaser-runner separation (+0.4063), inter-placode spacing CV (0.0457), BMPR ventral stream loss (0.5877), and dorsoventral density profile correlation (r = 0.9225, RMSE = 0.2640); transfer_boundary: 2D planar agent-based cranial neural crest and epibranchial placode migration mapped to whole-embryo 3D cranial stream reconstructions; does_not_claim: Subcellular actin-myosin vertex mechanics or 3D cranial neural tube delamination prior to neural crest EMT]" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.devcel.2010.06.012>,
            <https://doi.org/10.1016/j.devcel.2011.10.012>,
            <https://doi.org/10.1038/nature07441>,
            <https://doi.org/10.1038/ncb2772>,
            <https://doi.org/10.1371/journal.pone.0104969> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-carmona-neural-crest-chase-and-run-specimen-match> ;
        pk:weightOfEvidence "0.909"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/317bc3c/2012-carmona-neural-crest-chase-and-run.py> a schema:SoftwareSourceCode ;
        rdfs:label "2012-carmona-neural-crest-chase-and-run.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


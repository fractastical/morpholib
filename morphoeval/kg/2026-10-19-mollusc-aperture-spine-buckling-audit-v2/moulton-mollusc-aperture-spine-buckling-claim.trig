sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> a pk:Claim ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration faithfully reproduces Murex pecten (Venus comb murex) & Chicoreus ramosus (ramose murex / Muricidae) morphology" ;
        dct:description "The simulation script(s) 2015-moulton-mollusc-aperture-spine-buckling.py implement the cited source model as published and produce forms that match real Murex pecten (Venus comb murex) & Chicoreus ramosus (ramose murex / Muricidae) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.4/100, audit 2026-10-19-mollusc-aperture-spine-buckling-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py; output: docs/media/mollusc_aperture_spine_buckling_comparison.png; organism: Murex pecten (Venus comb murex) & Chicoreus ramosus (ramose murex / Muricidae); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 2b94e7a03cd347db53de50ca64fa7292e03536c1d004ec54908d722b5d7edd8a; artifact_sha256: 16175ede1e6af03115c6122eba4c4df9db284bf4ccefc8814fe1c1ad92afa20b; input_dataset_sha256: {datasets/mollusc_aperture_spine_buckling/mollusc_aperture_spine_buckling_reference.json=c73e5d2ac5c13cd5..., datasets/mollusc_aperture_spine_buckling/murex_pecten_aperture_specimen.jpg=2f87d4ec30ebec6a..., datasets/mollusc_aperture_spine_buckling/paper_citations.bib=fc39398ba54f69e1..., datasets/mollusc_aperture_spine_buckling/scout_manifest.json=53cb565add07b28d...}; supersedes_audit_id: 2026-10-19-mollusc-aperture-spine-buckling-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jtbi.2012.07.009>,
            <https://doi.org/10.1016/j.jtbi.2014.09.021>,
            <https://doi.org/10.1073/pnas.1220443110>,
            <https://doi.org/10.1371/journal.pcbi.1007213> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match> ;
        pk:weightOfEvidence "0.914"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py> a schema:SoftwareSourceCode ;
        rdfs:label "2015-moulton-mollusc-aperture-spine-buckling.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "HEAD" .

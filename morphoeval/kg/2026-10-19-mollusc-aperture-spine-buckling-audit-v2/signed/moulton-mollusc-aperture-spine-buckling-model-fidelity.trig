sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-moulton-mollusc-aperture-spine-buckling.py L130–L385" ;
        dcterms:description "Hierarchical wavenumber cascade, L-BFGS-B unilateral comb solver, Kirchhoff elastica loop closure, and 3-stage Chicoreus frond synthesizer" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py#L130-L385> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-moulton-mollusc-aperture-spine-buckling.py L391–L443" ;
        dcterms:description "Episodic triradiate varix whorl accretion cycle (120 deg phase locking) and inter-varix smooth shell law" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py#L391-L443> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_077_mollusc_aperture_spine_buckling.lean L18–L125" ;
        dcterms:description "3 Lean 4 theorems proving secondary frond cascade, tubular spine closure criterion, and episodic varix rest-period law" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_077_mollusc_aperture_spine_buckling.lean#L18-L125> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Solves the fourth-order unilateral mantle-margin functional via L-BFGS-B (`solve_murex_siphonal_comb`, L168-281), models planar Kirchhoff-Clebsch elastica loop folding and tubular self-contact closure at gamma >= gamma_fold (`solve_kirchhoff_elastica_spine_loop`, L287-338), synthesizes the 3-stage hierarchical wavenumber cascade k_i^* = (3*K_s/(E*h_i^3))^(1/4) for *Chicoreus ramosus* fractal fronds (`synthesize_chicoreus_fractal_frond`, L341-385), simulates episodic triradiate varix whorl accretion (`simulate_episodic_varix_whorls`, L391-443), and verifies the subcritical negative control (gamma=0.96 < gamma_c=1.08 -> 0 spines). Backed by 3 machine-checked Lean 4 theorems in `Loop_077_mollusc_aperture_spine_buckling.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;

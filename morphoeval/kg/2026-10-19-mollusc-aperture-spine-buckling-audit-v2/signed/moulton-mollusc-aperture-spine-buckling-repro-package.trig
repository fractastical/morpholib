    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2015`), 8-check `self_test()` suite (L838-882) and `--verify-only` mode verifying SHA-256 provenance, JSON parity, 3-stage frond wavenumber cascade, tubular self-contact closure criterion, episodic triradiate varix spacing and subcritical negative control, 10-species muricid scaling collapse, *Murex pecten* specimen comb segmentation, and bitwise two-run determinism (`np.allclose(..., atol=0.0)`), plus synchronized 6-panel PNG and GIF outputs." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-moulton-mollusc-aperture-spine-buckling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Moulton, Goriely & Chirat (2015) & Chirat et al. (2013) hierarchical mollusc aperture spine folding and fractal frond serration — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors, SHA-256-verifies, and performs Difference-of-Gaussians comb-spine periodicity segmentation (`segment_murex_specimen`, L508-561) on the *Murex pecten* Venus comb murex shell (`datasets/mollusc_aperture_spine_buckling/murex_pecten_aperture_specimen.jpg`), detecting all n=16 primary comb spines along the siphonal canal and aperture margin (mean inter-spine spacing = 42.13 px, CV = 0.2092)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2015-moulton-mollusc-aperture-spine-buckling.py L508–L561" ;
        dct:description "Difference-of-Gaussians comb-spine peak segmentation on Murex pecten specimen" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2015-moulton-mollusc-aperture-spine-buckling.py#L508-L561> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/mollusc_aperture_spine_buckling_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing Murex comb, Kirchhoff elastica closure, Chicoreus 3-stage frond, triradiate varix cycle, 10-species scaling, and Murex specimen segmentation — docs/media/mollusc_aperture_spine_buckling_comparison.png: rendered output of 2015-moulton-mollusc-aperture-spine-buckling.py at HEAD, image/png, 923113 B, 2640×1680 px, artifact_sha256 16175ede1e6af03115c6122eba4c4df9db284bf4ccefc8814fe1c1ad92afa20b (sha256 16175ede1e6af03115c6122eba4c4df9db284bf4ccefc8814fe1c1ad92afa20b), spec_fingerprint 2b94e7a03cd347db53de50ca64fa7292e03536c1d004ec54908d722b5d7edd8a" .

        schema:measurementTechnique "Difference-of-Gaussians comb-spine peak extraction along siphonal canal and aperture margin on Murex pecten specimen (mean spacing = 42.13 px, CV = 0.2092)" ;
        schema:name "Biological specimen segmented primary comb spine count (murex_pecten_aperture_specimen.jpg)" ;
        schema:unitText "spines" ;
        schema:value "16.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-biological-specimen-segmented-primary-comb-spine-count-murex-pecten-aperture-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-biological-specimen-segmented-primary-comb-spine-count-murex-pecten-aperture-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Chirat, Moulton & Goriely (2013) PNAS 110:6015-6020 Murex pecten siphonal comb (14-18 primary spines)" ;
        schema:value "16.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-measurement-biological-specimen-siphonal-comb-inter-spine-spacing-cv-murex-pecten-aperture-specimen-jpg> a schema:PropertyValue,

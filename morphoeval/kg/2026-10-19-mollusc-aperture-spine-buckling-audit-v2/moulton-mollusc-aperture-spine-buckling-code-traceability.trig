        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-moulton-mollusc-aperture-spine-buckling-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2015-moulton-mollusc-aperture-spine-buckling.py L1–L58" ;
        dct:description "Header docstring linking equations to Moulton et al. (2015), Chirat et al. (2013), and Lean 4 theorems" ;

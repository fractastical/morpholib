    <https://doi.org/10.1016/j.cub.2010.06.034> dct:date "2010"^^xsd:gYear ;
        dct:title "Intercellular coupling regulates the period of the segmentation clock" .
    <https://doi.org/10.1038/nature04861> dct:date "2006"^^xsd:gYear ;

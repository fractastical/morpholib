sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony, ALD failure, and PRP washout rescue — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L450-535): collective synchronization period T_sync = 22.18 min vs 22.18 min (shifting to T_0 = 25.00 min under DAPT), effective linear stability stiffness kappa_eff = 0.0623 min^-1 at tau_c = 20.5 min vs -0.0353 min^-1 in the repulsive anti-phase window tau_c = 11.0 min, DAPT pulse-chase Anterior Limit of Defects ALD = 5.5 somites vs 5.5 (with Posterior Rescue Point PRP = 14.5 somites and Kuramoto R recovering from 0.283 to 0.986), 5-regime ALD Pearson correlation r = 0.9999 (p = 1.62e-7, RMSE = 0.077 somites), and bilateral SEM specimen somite spacing 48.47 +/- 9.69 px (CV = 0.1999, symmetry ratio = 0.9605)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-dapt-pulse-chase-anterior-limit-of-defects-ald-and-posterior-rescue-point-prp-lag>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-delayed-kuramoto-collective-synchronization-period-t-sync-vs-autonomous-t-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-effective-in-phase-linear-stability-stiffness-kappa-eff-kappa-cos-omega-tau-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-riedel-kruse-2007-5-regime-dapt-ald-prediction-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-dapt-pulse-chase-anterior-limit-of-defects-ald-and-posterior-rescue-point-prp-lag> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "DAPT pulse-chase Anterior Limit of Defects (ALD) and Posterior Rescue Point (PRP) lag = 5.5 somites" ;
        dct:description "continuous DAPT (s_in=0) drops R from 0.96 to 0.088; washout at s_out=9 rescues R to 0.986 at PRP=14.5" ;
        schema:measurementTechnique "2D 8x8 delayed Kuramoto PSM lattice under DAPT pulse [s_in=0, s_out=9] (ALD=5.5 somites, PRP=14.5 somites, min R=0.283 -> rescued late R=0.986)" ;
        schema:name "DAPT pulse-chase Anterior Limit of Defects (ALD) and Posterior Rescue Point (PRP) lag" ;
        schema:unitText "somites" ;
        schema:value "5.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-dapt-pulse-chase-anterior-limit-of-defects-ald-and-posterior-rescue-point-prp-lag-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-dapt-pulse-chase-anterior-limit-of-defects-ald-and-posterior-rescue-point-prp-lag-reference> a schema:PropertyValue ;
        dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Figs. 1-4 (ALD ~ 5-7 normal anterior somites after early DAPT; PRP ~ 5.5 somites after washout)" ;
        schema:value "5.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-delayed-kuramoto-collective-synchronization-period-t-sync-vs-autonomous-t-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "delayed Kuramoto collective synchronization period T_sync vs autonomous T_0 = 22.18 min" ;
        dct:description "DAPT Notch blockade (kappa=0) shifts period from 22.18 min to T_0 = 25.00 min (+12.7% slowing, matching Herrgen et al. 2010)" ;
        schema:measurementTechnique "transcendental root of Omega = omega_0 - kappa*sin(Omega*tau_c) for T_0=25.0 min, kappa=0.070 min^-1, tau_c=20.5 min (Omega=0.2833 rad/min, Omega/omega_0=1.1273)" ;
        schema:name "delayed Kuramoto collective synchronization period T_sync vs autonomous T_0" ;
        schema:unitText "min" ;
        schema:value "22.18" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-delayed-kuramoto-collective-synchronization-period-t-sync-vs-autonomous-t-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-delayed-kuramoto-collective-synchronization-period-t-sync-vs-autonomous-t-0-reference> a schema:PropertyValue ;
        dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 SOM & Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 2-3 (collective period 22.18 min vs uncoupled 25.0 min)" ;
        schema:value "22.18" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-effective-in-phase-linear-stability-stiffness-kappa-eff-kappa-cos-omega-tau-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "effective in-phase linear stability stiffness kappa_eff = kappa * cos(Omega * tau_c) = 0.0623 min^-1" ;
        dct:description "in_phase_stable = True at tau_c=20.5 min vs False at repulsive delay tau_c=11.0 min" ;
        schema:measurementTechnique "linearized delayed Kuramoto stiffness kappa_eff = kappa*cos(Omega*tau_c) at tau_c=20.5 min (Omega*tau_c=5.808 rad) vs repulsive anti-phase delay tau_c=11.0 min (kappa_eff=-0.0353 min^-1)" ;
        schema:name "effective in-phase linear stability stiffness kappa_eff = kappa * cos(Omega * tau_c)" ;
        schema:unitText "min^-1" ;
        schema:value "0.0623" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-effective-in-phase-linear-stability-stiffness-kappa-eff-kappa-cos-omega-tau-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-effective-in-phase-linear-stability-stiffness-kappa-eff-kappa-cos-omega-tau-c-reference> a schema:PropertyValue ;
        dct:source "Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 4-5 & Fig. 2 (in-phase synchronization stable iff kappa_eff = kappa*cos(Omega*tau_c) > 0)" ;
        schema:value "0.0623" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-riedel-kruse-2007-5-regime-dapt-ald-prediction-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Riedel-Kruse (2007) 5-regime DAPT ALD prediction Pearson correlation r = 1.0 Pearson r" ;
        dct:description "p = 2.06e-07, RMSE = 0.077 somites, WT Kuramoto R = 0.9863" ;
        schema:measurementTechnique "correlation between predicted and observed ALD across 5 DAPT regimes (WT DMSO control, s_in=0 gastrula DAPT, s_in=4 DAPT, s_in=9 DAPT, and s_in=0/s_out=9 pulse-washout rescue; RMSE=0.077 somites)" ;
        schema:name "Riedel-Kruse (2007) 5-regime DAPT ALD prediction Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-riedel-kruse-2007-5-regime-dapt-ald-prediction-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-riedel-kruse-2007-5-regime-dapt-ald-prediction-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Riedel-Kruse, Müller & Oates (2007) Science 317:1911-1915 Figs. 2B & 3D (linear unit-slope ALD(s_in) = s_in + Delta_n_ALD)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate embryo SEM specimen bilateral somite spacing S_obs = 48.4667 px" ;
        dct:description "bilateral symmetry ratio = 0.9606, std = 9.70 px, phase correlation r = 0.5629" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on zebrafish_psm_synchrony_specimen.jpg (upper=8 somites, lower=9 somites, CV=0.2002)" ;
        schema:name "vertebrate embryo SEM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "48.4667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 vertebrate embryo SEM specimen (datasets/delta_notch_phase_synchrony/zebrafish_psm_synchrony_specimen.jpg)" ;
        schema:value "48.47" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L450–L535" ;
        dct:description "5 quantitative MorphoEval measurements with analytical and empirical references, Kuramoto R, Pearson r, and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2006-riedel-delta-notch-phase-synchrony.py#L450-L535> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


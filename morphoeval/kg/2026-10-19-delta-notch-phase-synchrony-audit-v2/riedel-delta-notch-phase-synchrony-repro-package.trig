sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony, ALD failure, and PRP washout rescue — Reproducibility package: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2007`), standalone `--self-test` suite verifying SHA-256 dataset integrity, collective frequency shift, Morelli (2009) attractive vs repulsive delay stability stiffness, bitwise two-run PSM lattice determinism (`atol=0.0`), DAPT ALD failure and washout PRP rescue window invariance (`PRP - ALD = s_out - s_in`), and specimen segmentation (`run_self_test`, L740-805), plus rendered PNG and GIF outputs in `docs/media/`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L740–L805" ;
        dct:description "Deterministic --self-test suite verifying SHA-256 digests, delayed Kuramoto stability, DAPT rescue, and morphometrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2006-riedel-delta-notch-phase-synchrony.py#L740-L805> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/delta_notch_phase_synchrony_growth.gif (generated output)" ;
        dct:description "22-frame animated GIF comparing wild-type Notch+ vs DAPT pulse-washout rescue somite segmentation — docs/media/delta_notch_phase_synchrony_growth.gif: rendered output of 2006-riedel-delta-notch-phase-synchrony.py at 317bc3c, image/gif, 955091 B, 940×540 px, 22 frames, artifact_sha256 f6b90fe220131a8f103c1e19234134c6bef9cff6aae6c4ba05fc0d5ea16571f7 (sha256 f6b90fe220131a8f103c1e19234134c6bef9cff6aae6c4ba05fc0d5ea16571f7), spec_fingerprint 3839bc471581fe7db9e5667737685528fa65076d2960ae3e4a7d5372c54a4e07" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


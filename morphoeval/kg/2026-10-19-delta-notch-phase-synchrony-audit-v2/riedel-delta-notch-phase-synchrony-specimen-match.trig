sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony, ALD failure, and PRP washout rescue — Morphological realism / specimen match: 87/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY 4.0 dorsal vertebrate embryo SEM (`datasets/delta_notch_phase_synchrony/zebrafish_psm_synchrony_specimen.jpg`) and segments both bilateral paraxial somite rows flanking the neural tube (`segment_zebrafish_psm_specimen`, L375-445), extracting 8 upper somites (mean spacing 47.43 px, CV = 0.1965) and 9 lower somites (mean spacing 49.38 px, CV = 0.2012), bilateral mean spacing 48.47 px, bilateral symmetry ratio 0.9605, and phase-aligned waveform correlation (Panels E-F)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match-2> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L375–L445" ;
        dct:description "Bilateral dorsal somite DoG peak & inter-somitic cleft segmentation on zebrafish_psm_synchrony_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2006-riedel-delta-notch-phase-synchrony.py#L375-L445> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/delta_notch_phase_synchrony_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure including R(s) initiation/ALD/PRP trajectories, 2D stability tongues, collective period branches, 5-regime validation, SEM segmentation, and waveform fit — docs/media/delta_notch_phase_synchrony_comparison.png: rendered output of 2006-riedel-delta-notch-phase-synchrony.py at 317bc3c, image/png, 1227882 B, 2352×1372 px, artifact_sha256 3375f3ba7e7ccb413d9e89b34eea5d67f6f5273d7fd87f1f853c21b3ae4af792 (sha256 3375f3ba7e7ccb413d9e89b34eea5d67f6f5273d7fd87f1f853c21b3ae4af792), spec_fingerprint 3839bc471581fe7db9e5667737685528fa65076d2960ae3e4a7d5372c54a4e07" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


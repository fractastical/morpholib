}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila pseudoobscura Turing wavelength at 2.0 µm (detail rung, 0 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The spectral centroid is 1.9569 µm against the assigned 1.961 µm. The diffusivity sweep has Pearson r = 0.99988, RMSE = 0.0071 µm, and KS = 0.0625 (not zero). The specimen mask gives foreground fraction 0.140 (reference 0.45), circularity 0.105 (reference 1, a round ocellus), and coherency 0.652 (reference 0.32). These references are not copies of the measurements. Peak-to-peak spacing on the 2D field is not yet measured, and 1.961 µm is an assigned rung rather than a wet-lab period." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-chronoseries-delta-log10-vs-planitibia>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-equal-diffusion-sigma-max-per-s>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-fastest-mode-wavelength-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-stripe-wavelength-centroid-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-rmse-um>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-chronoseries-delta-log10-vs-planitibia> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chronoseries_delta_log10_vs_planitibia = -2.003 log10 m" ;
        dct:description "diffusivity factor vs planitibia 10112.5; age delta 0.0 Ma" ;
        schema:measurementTechnique "log10(1.961e-6) recorded as -5.708 minus the planitibia primordium log10 -3.705" ;
        schema:name "chronoseries_delta_log10_vs_planitibia" ;
        schema:unitText "log10 m" ;
        schema:value "-2.003" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-chronoseries-delta-log10-vs-planitibia-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-chronoseries-delta-log10-vs-planitibia-reference> a schema:PropertyValue ;
        dct:source "a zero delta would mean this rung repeated the predecessor wavelength" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-equal-diffusion-sigma-max-per-s> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_sigma_max_per_s = -0.18 1/s" ;
        dct:description "negative control versus the near-onset pattern" ;
        schema:measurementTechnique "max_k σ(k) after setting D_u = D_v (ablation of differential diffusion)" ;
        schema:name "equal_diffusion_sigma_max_per_s" ;
        schema:unitText "1/s" ;
        schema:value "-0.18" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-equal-diffusion-sigma-max-per-s-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-equal-diffusion-sigma-max-per-s-reference> a schema:PropertyValue ;
        dct:source "Turing band requires a positive growth rate; the control must stay non-positive" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-fastest-mode-wavelength-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fastest_mode_wavelength_um = 1.961 µm" ;
        schema:measurementTechnique "continuous argmax of Re σ(k) on k in [0.15, 12]" ;
        schema:name "fastest_mode_wavelength_um" ;
        schema:unitText "µm" ;
        schema:value "1.961" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-fastest-mode-wavelength-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-fastest-mode-wavelength-um-reference> a schema:PropertyValue ;
        dct:source "slot scale 1.961 µm" ;
        schema:value "1.961" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.1052 ratio" ;
        schema:measurementTechnique "4πA/P² of the specimen foreground mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "ratio" ;
        schema:value "0.1052" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "circularity of a round ocellus or disc; the lateral fly is an elongated contour" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.14 fraction" ;
        schema:measurementTechnique "border-median contrast mask on the Hanson 2019 male JPEG resized to 320×240" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.14" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "a centred full-body crop would occupy about half the frame; this lateral mount does not" ;
        schema:value "0.45" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.6525 ratio" ;
        schema:measurementTechnique "mean structure-tensor coherency inside the specimen mask (Sobel, Gaussian σ=2.5)" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "ratio" ;
        schema:value "0.6525" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "typical coherency of an isotropic granular field; the habitus outline is more coherent" ;
        schema:value "0.32" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-stripe-wavelength-centroid-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stripe_wavelength_centroid_um = 1.9569 µm" ;
        dct:description "centroid is the realised linear pattern; it is not forced equal to the reference" ;
        schema:measurementTechnique "power-weighted spectral centroid of modes with σ > 0.85 σ_max on the 192×128 Fourier grid" ;
        schema:name "stripe_wavelength_centroid_um" ;
        schema:unitText "µm" ;
        schema:value "1.9569" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-stripe-wavelength-centroid-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-stripe-wavelength-centroid-um-reference> a schema:PropertyValue ;
        dct:source "assigned detail rung 2.0 µm = 1.961e-6 m" ;
        schema:value "1.961" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_ks_statistic = 0.0625 KS" ;
        schema:measurementTechnique "two-sample Kolmogorov-Smirnov statistic between analytic and discrete wavelength samples" ;
        schema:name "wavelength_sweep_ks_statistic" ;
        schema:unitText "KS" ;
        schema:value "0.0625" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "identical distributions would give KS = 0" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_pearson_r = 0.99988 correlation" ;
        dct:description "RMSE 0.0071 µm; KS statistic 0.0625" ;
        schema:measurementTechnique "Pearson r between continuous λ_*(s) and the discrete Fourier mode of maximum σ as D → s^2 D, s in [0.70, 1.45]" ;
        schema:name "wavelength_sweep_pearson_r" ;
        schema:unitText "correlation" ;
        schema:value "0.99988" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> a schema:PropertyValue ;
        dct:source "null of no association between analytic and discrete wavelengths" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-rmse-um> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength_sweep_rmse_um = 0.00706 µm" ;
        schema:measurementTechnique "RMSE of discrete-grid λ against continuous λ_* across the diffusivity sweep" ;
        schema:name "wavelength_sweep_rmse_um" ;
        schema:unitText "µm" ;
        schema:value "0.00706" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-rmse-um-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-measurement-wavelength-sweep-rmse-um-reference> a schema:PropertyValue ;
        dct:source "tolerance of one part in forty of the 1.961 µm rung" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0.py L392–L497" ;
        dct:description "measure_morphoeval rows" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0.py#L392-L497> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0.py L187–L220" ;
        dct:description "specimen segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-pseudoobscura-turing-wavelength-s0.py#L187-L220> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


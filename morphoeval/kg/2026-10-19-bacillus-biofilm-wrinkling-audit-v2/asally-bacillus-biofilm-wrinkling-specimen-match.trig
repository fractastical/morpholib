sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 Bacillus subtilis macrocolony biofilm photograph `datasets/bacillus_biofilm_wrinkling/bacillus_biofilm_specimen.jpg`, segments n = 11 isolated circular macrocolonies across the agar plate, and extracts N_spokes = 12 radial wrinkle ridges (mean angular spacing = 30.0 deg, CV = 0.3156) on the focal colony (`segment_bacillus_biofilm_specimen`, L431-505)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2013-asally-bacillus-biofilm-wrinkling.py L431–L505" ;
        dct:description "Macrocolony segmentation and DoG circumferential radial spoke ridge detection on bacillus_biofilm_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L431-L505> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/bacillus_biofilm_wrinkling_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 2D FvK buckling, agar & thickness scaling, mutant/score controls, and specimen spoke segmentation — docs/media/bacillus_biofilm_wrinkling_comparison.png: rendered output of 2013-asally-bacillus-biofilm-wrinkling.py at e93f00e, image/png, 692871 B, 2700×1650 px, artifact_sha256 68b793a887248a1043ff93072882c4552ea9070e6af8a2036074f6a15acf9574 (sha256 68b793a887248a1043ff93072882c4552ea9070e6af8a2036074f6a15acf9574), spec_fingerprint 80d4742b3055639fafb02a0909f223313e723e53cf52d4df159742cd92171fba" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 094 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


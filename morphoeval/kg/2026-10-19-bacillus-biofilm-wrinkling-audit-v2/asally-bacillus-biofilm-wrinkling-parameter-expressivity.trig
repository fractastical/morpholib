        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Parameter expressivity: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Spans the 7-point agar stiffness sweep E_s in [0.5, 10.0] kPa (L303-355), the 6-point biofilm thickness sweep h in [40, 140] um (L358-390), 5 genetic and mechanical-score controls (WT, Delta eps/tasA, FeCl3 cell-death suppression, guided m=6 and m=8 templates, L393-425), and exposes `--E-s-kPa`, `--h-um`, `--epsilon-g`, `--artificial-spokes`, and `--seed` CLI overrides (L652-676)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2013-asally-bacillus-biofilm-wrinkling.py L303–L425" ;
        dct:description "7-point agar stiffness sweep, 6-point thickness sweep, and 5 genetic/mechanical-score controls" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L303-L425> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2013-asally-bacillus-biofilm-wrinkling.py L652–L676" ;
        dct:description "CLI overrides for E_s, h, epsilon_g, artificial spokes, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L652-L676> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 094 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


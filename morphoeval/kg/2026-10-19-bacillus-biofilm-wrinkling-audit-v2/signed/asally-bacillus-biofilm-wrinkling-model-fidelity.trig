sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2013-asally-bacillus-biofilm-wrinkling.py L91–L147" ;
        dcterms:description "Exact Föppl-von Kármán bilayer wavelength lambda_c, critical strain epsilon_c, cell-death delamination threshold, and spoke count N_spokes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L91-L147> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2013-asally-bacillus-biofilm-wrinkling.py L178–L297" ;
        dcterms:description "2D circular colony pseudo-spectral + L-BFGS-B Föppl-von Kármán + cell-death delamination energy minimizer" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L178-L297> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_094_bacillus_biofilm_wrinkling.lean L14–L108" ;
        dcterms:description "3 standalone Lean 4 theorems proving FvK cubed wavelength stationarity, cell-death delamination focusing, and radial spoke scaling (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_094_bacillus_biofilm_wrinkling.lean#L14-L108> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements plane-strain Föppl–von Kármán bilayer buckling mechanics (`compute_fvk_wavelength_and_strain`, L91-147), spatiotemporal basal cell-death patterning (`build_cell_death_template`, L153-175), and a 2D pseudo-spectral + L-BFGS-B energy minimizer (`relax_fvk_biofilm_colony`, L178-297) with genetic and artificial score controls (`evaluate_genetic_and_mechanical_controls`, L393-425), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_094_bacillus_biofilm_wrinkling.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-model-fidelity-3> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/94> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/s41567-018-0392-9>,
            <https://doi.org/10.1073/pnas.1102300108>,
            <https://doi.org/10.1073/pnas.1212429109>,
            <https://doi.org/10.1073/pnas.1217178110> .

    <https://doi.org/10.1038/s41567-018-0392-9> dcterms:date "2019"^^xsd:gYear ;
        dcterms:title "Mechanical instability and interfacial energy drive biofilm morphogenesis" .

    <https://doi.org/10.1073/pnas.1102300108> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Osmotic spreading of Bacillus subtilis biofilms driven by an extracellular matrix" .

    <https://doi.org/10.1073/pnas.1212429109> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Localized cell death focuses mechanical forces during 3D patterning in a biofilm" .

    <https://doi.org/10.1073/pnas.1217178110> dcterms:date "2013"^^xsd:gYear ;
        dcterms:title "Elasticity and wrinkled morphology of Bacillus subtilis pellicles" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-asally-bacillus-biofilm-wrinkling> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-asally-bacillus-biofilm-wrinkling-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics osmotic matrix swelling, localized cell-death delamination, and Föppl–von Kármán radial wrinkle spokes in Bacillus subtilis biofilms — Morphometric validation: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L511-606) computes 9 reference-anchored morphometric measurements with uncertainty and statistical tests: agar stiffness wavelength Pearson r = 1.0000 (p = 3.74e-12, RMSE = 1.94 um), log-log agar stiffness exponent |alpha_E| = 0.3338 ± 0.0008 (ref 0.3333), thickness wavelength Pearson r = 1.0000 (p = 4.57e-11, slope = 0.9999 ± 0.0017), relaxed FvK standard-agar wavelength 773.32 um (ref 750.0 um), WT spoke count 13 (ref 13), Delta eps/tasA mutant amplitude 0.0 um (ref 0.0 um), guided m=6 score spoke count 6 (ref 6), specimen focal spoke count 12 (ref 13), and specimen mean spoke angle 30.0 deg (ref 27.69 deg)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-agar-stiffness-sweep-0-5-10-kpa-wrinkle-wavelength-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-artificial-cell-death-mechanical-score-pattern-m-6-guided-spoke-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-biofilm-thickness-scaling-40-140-um-wavelength-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-log-log-agar-stiffness-wavelength-scaling-exponent-alpha-e-lambda-c-e-s-alpha-e>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-matrix-deficient-mutant-delta-epsa-o-delta-tasa-wrinkle-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-specimen-focal-b-subtilis-macrocolony-radial-wrinkle-spoke-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-specimen-focal-macrocolony-mean-angular-spoke-spacing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-relaxed-fvk-wrinkle-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-wild-type-ncib-3610-radial-spoke-count-n-spokes-on-standard-agar>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-agar-stiffness-sweep-0-5-10-kpa-wrinkle-wavelength-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Agar stiffness sweep (0.5-10 kPa) wrinkle wavelength correlation = 1.0 Pearson r" ;
        dcterms:description "RMSE = 1.94 um, p = 3.74e-12" ;
        schema:measurementTechnique "Pearson correlation between Föppl-von Kármán lambda_c and empirical wavelength across 7 agar stiffnesses (p=3.74e-12, RMSE=1.94 um)" ;
        schema:name "Agar stiffness sweep (0.5-10 kPa) wrinkle wavelength correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-agar-stiffness-sweep-0-5-10-kpa-wrinkle-wavelength-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-agar-stiffness-sweep-0-5-10-kpa-wrinkle-wavelength-correlation-reference> a schema:PropertyValue ;
        dcterms:source "Yan et al. (2019) Nature Physics 15:456-462 Fig. 3 & Trejo et al. (2013) PNAS 110:2011-2016" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-artificial-cell-death-mechanical-score-pattern-m-6-guided-spoke-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Artificial cell-death / mechanical score pattern (m = 6) guided spoke count = 6 count" ;
        dcterms:description "Guided peak amplitude = 168.0 um" ;
        schema:measurementTechnique "2D FvK relaxation on artificial 6-spoke basal cell-death delamination template (Asally et al. 2012 Fig. 4)" ;
        schema:name "Artificial cell-death / mechanical score pattern (m = 6) guided spoke count" ;
        schema:unitText "count" ;
        schema:value "6" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-artificial-cell-death-mechanical-score-pattern-m-6-guided-spoke-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-artificial-cell-death-mechanical-score-pattern-m-6-guided-spoke-count-reference> a schema:PropertyValue ;
        dcterms:source "Asally et al. (2012) PNAS 109:18891-18896 Fig. 4 (artificial pattern guidance)" ;
        schema:value "6" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-biofilm-thickness-scaling-40-140-um-wavelength-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Biofilm thickness scaling (40-140 um) wavelength correlation = 1.0 Pearson r" ;
        dcterms:description "Log-log thickness slope = 0.9999 ± 0.0017" ;
        schema:measurementTechnique "Linear wavelength scaling lambda_c ~ h^1.0 across 6 biofilm thicknesses (slope=0.9999, p=4.57e-11)" ;
        schema:name "Biofilm thickness scaling (40-140 um) wavelength correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-biofilm-thickness-scaling-40-140-um-wavelength-correlation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-biofilm-thickness-scaling-40-140-um-wavelength-correlation-reference> a schema:PropertyValue ;
        dcterms:source "Trejo et al. (2013) PNAS 110:2011-2016 Fig. 4 & Yan et al. (2019) Nature Physics" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-log-log-agar-stiffness-wavelength-scaling-exponent-alpha-e-lambda-c-e-s-alpha-e> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Log-log agar stiffness wavelength scaling exponent alpha_E (lambda_c ~ E_s^alpha_E) = 0.3338 |exponent|" ;
        dcterms:description "Signed slope = -0.3338 ± 0.0008" ;
        schema:measurementTechnique "Log-log OLS regression slope |d log(lambda)/d log(E_s)| across E_s in [0.5, 10.0] kPa (SE ± 0.0008)" ;
        schema:name "Log-log agar stiffness wavelength scaling exponent alpha_E (lambda_c ~ E_s^alpha_E)" ;
        schema:unitText "|exponent|" ;
        schema:value "0.3338" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-log-log-agar-stiffness-wavelength-scaling-exponent-alpha-e-lambda-c-e-s-alpha-e-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-log-log-agar-stiffness-wavelength-scaling-exponent-alpha-e-lambda-c-e-s-alpha-e-reference> a schema:PropertyValue ;
        dcterms:source "Yan et al. (2019) Nature Physics Eq. (1) cube-root modulus law (|-1/3| = 0.3333)" ;
        schema:value "0.3333" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-matrix-deficient-mutant-delta-epsa-o-delta-tasa-wrinkle-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Matrix-deficient mutant (Delta epsA-O / Delta tasA) wrinkle amplitude = 0.0 um" ;
        dcterms:description "Confirms zero wrinkling when matrix swelling strain is below critical threshold" ;
        schema:measurementTechnique "Negative control with osmotic swelling strain epsilon_g = 0.015 < epsilon_c_eff" ;
        schema:name "Matrix-deficient mutant (Delta epsA-O / Delta tasA) wrinkle amplitude" ;
        schema:unitText "um" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-matrix-deficient-mutant-delta-epsa-o-delta-tasa-wrinkle-amplitude-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-matrix-deficient-mutant-delta-epsa-o-delta-tasa-wrinkle-amplitude-reference> a schema:PropertyValue ;
        dcterms:source "Asally et al. (2012) PNAS Fig. 2 & Seminara et al. (2012) PNAS (Delta eps/tasA flat colony)" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-specimen-focal-b-subtilis-macrocolony-radial-wrinkle-spoke-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen focal B. subtilis macrocolony radial wrinkle spoke count = 12 count" ;
        dcterms:description "n = 11 isolated macrocolonies segmented on agar plate" ;
        schema:measurementTechnique "DoG ridge filtering (sigma=1.0, 4.5 px) and circumferential peak detection on bacillus_biofilm_specimen.jpg focal colony" ;
        schema:name "Specimen focal B. subtilis macrocolony radial wrinkle spoke count" ;
        schema:unitText "count" ;
        schema:value "12" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-specimen-focal-b-subtilis-macrocolony-radial-wrinkle-spoke-count-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-specimen-focal-b-subtilis-macrocolony-radial-wrinkle-spoke-count-reference> a schema:PropertyValue ;
        dcterms:source "Wikimedia Commons CC BY-SA 3.0 Bacillus subtilis macrocolony specimen & Asally et al. (2012) PNAS" ;
        schema:value "13" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-specimen-focal-macrocolony-mean-angular-spoke-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Specimen focal macrocolony mean angular spoke spacing = 30.0 deg" ;
        dcterms:description "Angular spacing CV = 0.3156" ;
        schema:measurementTechnique "Mean angular separation between adjacent radial wrinkle ridges in focal specimen macrocolony" ;
        schema:name "Specimen focal macrocolony mean angular spoke spacing" ;
        schema:unitText "deg" ;
        schema:value "30.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-specimen-focal-macrocolony-mean-angular-spoke-spacing-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-specimen-focal-macrocolony-mean-angular-spoke-spacing-reference> a schema:PropertyValue ;
        dcterms:source "Asally et al. (2012) PNAS & Yan et al. (2019) Nature Physics (360 deg / N_spokes)" ;
        schema:value "27.69" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-relaxed-fvk-wrinkle-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Standard 1.5% agar (E_s = 2.5 kPa) relaxed FvK wrinkle wavelength = 773.32 um" ;
        dcterms:description "Analytic lambda_c = 750.87 um" ;
        schema:measurementTechnique "2D L-BFGS-B Föppl-von Kármán + cell-death delamination relaxation circumferential wavelength at R_ring = 1600 um" ;
        schema:name "Standard 1.5% agar (E_s = 2.5 kPa) relaxed FvK wrinkle wavelength" ;
        schema:unitText "um" ;
        schema:value "773.32" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-relaxed-fvk-wrinkle-wavelength-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-standard-1-5-agar-e-s-2-5-kpa-relaxed-fvk-wrinkle-wavelength-reference> a schema:PropertyValue ;
        dcterms:source "Asally et al. (2012) PNAS 109:18891-18896 & Yan et al. (2019) Nature Physics" ;
        schema:value "750.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-wild-type-ncib-3610-radial-spoke-count-n-spokes-on-standard-agar> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type NCIB 3610 radial spoke count N_spokes on standard agar = 13 count" ;
        dcterms:description "Peak amplitude w_max = 162.0 um" ;
        schema:measurementTechnique "Circumferential peak detection on 2D FvK relaxed height field w(x,y) at r = 1.55 * R_ring" ;
        schema:name "Wild-type NCIB 3610 radial spoke count N_spokes on standard agar" ;
        schema:unitText "count" ;
        schema:value "13" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-wild-type-ncib-3610-radial-spoke-count-n-spokes-on-standard-agar-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-measurement-wild-type-ncib-3610-radial-spoke-count-n-spokes-on-standard-agar-reference> a schema:PropertyValue ;
        dcterms:source "Asally et al. (2012) PNAS Fig. 1 & Yan et al. (2019) Nature Physics Fig. 3" ;
        schema:value "13" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-asally-bacillus-biofilm-wrinkling-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2013-asally-bacillus-biofilm-wrinkling.py L511–L606" ;
        dcterms:description "9 quantitative morphometrics with p-values, RMSE, log-log slopes, mutant negative controls, and specimen spoke metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2013-asally-bacillus-biofilm-wrinkling.py#L511-L606> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 094 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


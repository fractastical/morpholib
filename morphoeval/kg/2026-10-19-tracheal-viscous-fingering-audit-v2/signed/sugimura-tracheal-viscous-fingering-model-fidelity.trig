sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, and ASM peristalsis driving embryonic lung branching — Model fidelity to source: 95/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the coupled transmural pressure, Laplace circumferential hoop stress sigma_theta = Delta P * R / h, synchronized ASM Ca2+ peristaltic frequency f_ASM(Delta P), and Hill tip bifurcation solver (`compute_transmural_pressure` through `simulate_2d_microfluidic_lung_tree`, L120-289), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-2> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L120–L289" ;
        dcterms:description "Coupled 2D spatial bronchial tree, Laplace hoop stress field, ASM peristaltic wave frequency, and Hill bifurcation solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-sugimura-tracheal-viscous-fingering.py#L120-L289> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean L28–L120" ;
        dcterms:description "3 standalone Lean 4 theorems for common-mode gauge invariance, Laplace hoop stress monotonicity, and drainage/nifedipine hypoplasia arrest (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_059_tracheal_viscous_fingering.lean#L28-L120> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 059 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


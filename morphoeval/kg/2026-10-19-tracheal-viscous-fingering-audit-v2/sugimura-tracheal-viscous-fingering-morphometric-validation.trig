}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/59> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.devcel.2009.12.010>,
            <https://doi.org/10.1016/j.devcel.2015.08.012>,
            <https://doi.org/10.1016/j.mod.2007.11.007>,
            <https://doi.org/10.1242/dev.154823>,
            <https://doi.org/10.1242/dev.167395> .
    <https://doi.org/10.1016/j.devcel.2009.12.010> dct:date "2010"^^xsd:gYear ;
        dct:title "Preparing for the first breath: genetic and cellular mechanisms in lung development" .
    <https://doi.org/10.1016/j.devcel.2015.08.012> dct:date "2015"^^xsd:gYear ;
        dct:title "Localized smooth muscle differentiation is essential for epithelial bifurcation during branching morphogenesis of the mammalian lung" .
    <https://doi.org/10.1016/j.mod.2007.11.007> dct:date "2008"^^xsd:gYear ;
        dct:title "Tracheal occlusion increases the rate of epithelial branching of embryonic mouse lung via the FGF10-FGFR2b-Sprouty2 pathway" .
    <https://doi.org/10.1242/dev.154823> dct:date "2017"^^xsd:gYear ;
        dct:title "Microfluidic chest cavities reveal that transmural pressure controls the rate of lung development" .
    <https://doi.org/10.1242/dev.167395> dct:date "2018"^^xsd:gYear ;
        dct:title "Smooth muscle: a stiff sculptor of epithelial shapes" .
}


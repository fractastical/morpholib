sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, and ASM peristalsis driving embryonic lung branching — Morphometric validation: 95/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L446-542) computes 9 reference-anchored morphometric measurements with Pearson r, p-values, RMSE, SD, common-mode gauge invariance checks, and nifedipine / drainage negative controls: 48h bud count r = 0.99993 (RMSE = 0.3046, p = 7.42e-13), branching rate r = 0.99986 (RMSE = 0.0085, p = 6.81e-12), ASM wave frequency r = 0.99850 (RMSE = 0.0110, p = 8.44e-9), 200 Pa fold-change = 4.7065 (ref 4.75), gauge invariance spread = 0.0000 across 3 (P_lumen, P_pleura) pairs, nifedipine blockade fold-change = 1.1636 (ref 1.18), specimen terminal buds = 17, distal area fraction = 0.6885, and mean tip radius = 3.8470 +- 1.3152 px." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-distal-to-total-airway-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-mean-distal-bud-tip-radius>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-pseudoglandular-terminal-bud-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-mechanosensitive-fgf10-etv4-branching-rate-gamma-branch-delta-p-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-microfluidic-chest-common-mode-pressure-gauge-invariance-deviation-at-delta-p-200-pa>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-nifedipine-l-type-ca2-channel-asm-blockade-48h-bud-fold-change-negative-control>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-physiological-transmural-pressure-200-pa-48h-terminal-bud-fold-change>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-synchronized-airway-smooth-muscle-asm-ca2-peristaltic-wave-frequency-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-transmural-pressure-sweep-0-400-pa-48h-terminal-bud-count-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-morphometric-validation-1> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-distal-to-total-airway-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Embryonic mouse lung specimen distal-to-total airway area fraction = 0.6884 area fraction" ;
        dct:description "Distal proliferating tip zone comprises 68.84% of pseudoglandular tree area" ;
        schema:measurementTechnique "Teal distal bifurcating bud area (1359 px) over total segmented airway tree (1982 px) in embryonic_lung_branching_specimen.jpg" ;
        schema:name "Embryonic mouse lung specimen distal-to-total airway area fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.6884" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-distal-to-total-airway-area-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-distal-to-total-airway-area-fraction-reference> a schema:PropertyValue ;
        schema:value "0.6885" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-mean-distal-bud-tip-radius> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Embryonic mouse lung specimen mean distal bud tip radius = 3.847 px" ;
        dct:description "Mean terminal bud radius = 3.8470 ± 1.3152 px across N = 17 tips" ;
        schema:measurementTechnique "Euclidean distance transform radius at 17 terminal bud centroids in embryonic_lung_branching_specimen.jpg (SD = 1.3152 px)" ;
        schema:name "Embryonic mouse lung specimen mean distal bud tip radius" ;
        schema:unitText "px" ;
        schema:value "3.847" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-mean-distal-bud-tip-radius-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-mean-distal-bud-tip-radius-reference> a schema:PropertyValue ;
        schema:value "3.847" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-pseudoglandular-terminal-bud-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Embryonic mouse lung specimen pseudoglandular terminal bud count = 17.0 terminal buds" ;
        dct:description "17 distal terminal buds corresponding to log2(17) = 4.087 bifurcation generations (airway area = 2251 px)" ;
        schema:measurementTechnique "EDT local-maxima CV segmentation of Panel B pseudoglandular airway tree in embryonic_lung_branching_specimen.jpg (effective generations = 4.0875)" ;
        schema:name "Embryonic mouse lung specimen pseudoglandular terminal bud count" ;
        schema:unitText "terminal buds" ;
        schema:value "17.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-pseudoglandular-terminal-bud-count-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-embryonic-mouse-lung-specimen-pseudoglandular-terminal-bud-count-reference> a schema:PropertyValue ;
        schema:value "17.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-mechanosensitive-fgf10-etv4-branching-rate-gamma-branch-delta-p-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mechanosensitive FGF10/Etv4 branching rate Gamma_branch(Delta P) correlation = 0.99992 Pearson r" ;
        dct:description "Zero branching below Delta P_c = 50 Pa, rising to 0.7749 day^-1 at 200 Pa (RMSE = 0.0083, p = 1.11e-12)" ;
        schema:measurementTechnique "8-point Hill bifurcation rate Gamma_branch(Delta P) vs Nelson et al. (2017) growth rate (RMSE = 0.0083 day^-1, p = 1.11e-12)" ;
        schema:name "Mechanosensitive FGF10/Etv4 branching rate Gamma_branch(Delta P) correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99992" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-mechanosensitive-fgf10-etv4-branching-rate-gamma-branch-delta-p-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-mechanosensitive-fgf10-etv4-branching-rate-gamma-branch-delta-p-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-microfluidic-chest-common-mode-pressure-gauge-invariance-deviation-at-delta-p-200-pa> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Microfluidic chest common-mode pressure gauge invariance deviation at Delta P = 200 Pa = 0.0 max fold-change spread" ;
        dct:description "Exact gauge invariance: Delta P(P_lum + c, P_pl + c) = Delta P(P_lum, P_pl) = 200 Pa across all three microfluidic chest clamp regimes" ;
        schema:measurementTechnique "Max spread in 48h bud fold-change across (P_lumen, P_pleura) = (200, 0), (0, -200), and (500, 300) Pa" ;
        schema:name "Microfluidic chest common-mode pressure gauge invariance deviation at Delta P = 200 Pa" ;
        schema:unitText "max fold-change spread" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-microfluidic-chest-common-mode-pressure-gauge-invariance-deviation-at-delta-p-200-pa-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-microfluidic-chest-common-mode-pressure-gauge-invariance-deviation-at-delta-p-200-pa-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-nifedipine-l-type-ca2-channel-asm-blockade-48h-bud-fold-change-negative-control> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Nifedipine L-type Ca2+ channel ASM blockade 48h bud fold-change (negative control) = 1.0806 fold-change N(48h)/N(0h)" ;
        dct:description "Nifedipine collapses 48h bud fold-change from 4.711 to 1.0806 (ref 1.18)" ;
        schema:measurementTechnique "10 uM nifedipine ASM peristalsis blockade (alpha_ASM = 0.05) at Delta P = 200 Pa vs intact control (4.360x suppression)" ;
        schema:name "Nifedipine L-type Ca2+ channel ASM blockade 48h bud fold-change (negative control)" ;
        schema:unitText "fold-change N(48h)/N(0h)" ;
        schema:value "1.0806" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-nifedipine-l-type-ca2-channel-asm-blockade-48h-bud-fold-change-negative-control-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-nifedipine-l-type-ca2-channel-asm-blockade-48h-bud-fold-change-negative-control-reference> a schema:PropertyValue ;
        schema:value "1.18" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-physiological-transmural-pressure-200-pa-48h-terminal-bud-fold-change> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Physiological transmural pressure (200 Pa) 48h terminal bud fold-change = 4.7109 fold-change N(48h)/N(0h)" ;
        dct:description "N(48h)/N(0h) = 4.7109 vs empirical 4.75 (drainage 0 Pa fold-change = 1.0000)" ;
        schema:measurementTechnique "48h culture at physiological Delta P = 200 Pa (sigma_theta = 1000 Pa) vs tracheal drainage 0 Pa (4.711x higher)" ;
        schema:name "Physiological transmural pressure (200 Pa) 48h terminal bud fold-change" ;
        schema:unitText "fold-change N(48h)/N(0h)" ;
        schema:value "4.7109" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-physiological-transmural-pressure-200-pa-48h-terminal-bud-fold-change-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-physiological-transmural-pressure-200-pa-48h-terminal-bud-fold-change-reference> a schema:PropertyValue ;
        schema:value "4.75" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-synchronized-airway-smooth-muscle-asm-ca2-peristaltic-wave-frequency-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Synchronized Airway Smooth Muscle (ASM) Ca2+ peristaltic wave frequency correlation = 0.99921 Pearson r" ;
        dct:description "ASM Ca2+ wave frequency accelerates from 0.142 min^-1 at 50 Pa to 0.477 min^-1 at 200 Pa (RMSE = 0.0110)" ;
        schema:measurementTechnique "8-point ASM contraction frequency f_ASM(Delta P) in [0, 400] Pa vs Nelson et al. (2017) Fig. 3 (RMSE = 0.0110 min^-1, p = 1.25e-09)" ;
        schema:name "Synchronized Airway Smooth Muscle (ASM) Ca2+ peristaltic wave frequency correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99921" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-synchronized-airway-smooth-muscle-asm-ca2-peristaltic-wave-frequency-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-synchronized-airway-smooth-muscle-asm-ca2-peristaltic-wave-frequency-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-transmural-pressure-sweep-0-400-pa-48h-terminal-bud-count-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Transmural pressure sweep (0-400 Pa) 48h terminal bud count correlation = 0.99997 Pearson r" ;
        dct:description "Terminal buds expand from 6.00 at 0 Pa to 28.27 at 200 Pa and 73.09 at 400 Pa (RMSE = 0.2991, p = 1.02e-13)" ;
        schema:measurementTechnique "8-point microfluidic chest Delta P sweep in [0, 400] Pa vs Nelson et al. (2017) empirical bud counts (RMSE = 0.2991 buds, p = 1.02e-13)" ;
        schema:name "Transmural pressure sweep (0-400 Pa) 48h terminal bud count correlation" ;
        schema:unitText "Pearson r" ;
        schema:value "0.99997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-transmural-pressure-sweep-0-400-pa-48h-terminal-bud-count-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-measurement-transmural-pressure-sweep-0-400-pa-48h-terminal-bud-count-correlation-reference> a schema:PropertyValue ;
        schema:value "1.0" .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sugimura-tracheal-viscous-fingering> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Nelson et al. (2017) Development & Kim et al. (2015) Dev. Cell microfluidic transmural pressure, Laplace epithelial wall stress, and ASM peristalsis driving embryonic lung branching — Parameter expressivity: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Sweeps 8 transmural pressures Delta P across [0, 400] Pa (L296-352), evaluates 4 independent (P_lumen, P_pleura) microfluidic chest pressure pairs plus nifedipine and tracheal drainage controls (L355-386), and exposes `--p-lumen`, `--p-pleura`, and `--seed` CLI flags (L757-766)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L296–L386" ;
        dct:description "8-point Delta P sweep in [0, 400] Pa and 4 common-mode (P_lumen, P_pleura) gauge pairs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-sugimura-tracheal-viscous-fingering.py#L296-L386> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sugimura-tracheal-viscous-fingering-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2015-sugimura-tracheal-viscous-fingering.py L757–L766" ;
        dct:description "CLI parameter overrides for P_lumen, P_pleura, and seed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2015-sugimura-tracheal-viscous-fingering.py#L757-L766> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 059 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


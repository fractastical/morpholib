sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Activator sweep on [0.06, 0.12] remains monotone, equal diffusion still quenches, and patch length is now a second control: peak count goes 4 → 6 → 13 as length goes 16 → 32 → 48 µm. Spacing is not locked, so length does not act as a pure multiplier of a fixed wavelength. The diffusion ratio is still a single near-onset value." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L127–L162" ;
        dct:description "species bundle at shared Du" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L127-L162> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L323–L331" ;
        dct:description "activator sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L323-L331> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L478–L479" ;
        dct:description "equal-diffusion ablation at the same seed and duration" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L478-L479> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L294–L321" ;
        dct:description "length series" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L294-L321> .

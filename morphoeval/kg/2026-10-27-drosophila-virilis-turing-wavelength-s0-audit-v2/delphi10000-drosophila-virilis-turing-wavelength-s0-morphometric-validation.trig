        npx:introduces <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation> ;
        pk:domain <https://w3id.org/delphi/resource/domain/morphogenesis> ;

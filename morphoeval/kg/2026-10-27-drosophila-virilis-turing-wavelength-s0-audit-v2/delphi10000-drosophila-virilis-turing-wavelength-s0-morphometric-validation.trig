sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila virilis Schnakenberg onset wavelength at 3.1 µm (Holocene, 0 Ma) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.998 against continuum σ(k), RMSE 0.032, neither equal to its reference anchor. Emergent spacing 3.625 µm versus onset 3.101 µm. Domain-length counts 4, 6, 13 versus each other. Habitus Nyquist 7.76 µm is reported as a failed resolution of the 3.101 µm mode, not as a confirmation. Orientation KS and pixel Pearson are measured on the Hanson photograph. Still one specimen, and a is not an empirical series." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-ablation-to-wild-type-activator-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-activator-peaks-on-a-48-m-patch-versus-a-16-m-patch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-ks-statistic-of-gradient-orientation-specimen-versus-adult-endpoint>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-pearson-r-of-numerical-versus-analytic-dispersion-sigma-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-pixel-pearson-r-of-adult-endpoint-versus-specimen-habitus>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-rmse-of-dispersion-sigma-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-habitus-nyquist-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-teissieri-onset-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-emergent-midline-peak-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-onset-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-tergite-mode-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-willistoni-selected-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-ablation-to-wild-type-activator-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation to wild-type activator std ratio = 0.0 ratio" ;
        dct:description "Reference 1 would mean the control failed to quench. The measured ratio is the control result." ;
        schema:measurementTechnique "Equal-diffusion control Dv=Du versus wild-type Dv=10 Du, same seed and duration" ;
        schema:name "ablation to wild-type activator std ratio" ;
        schema:unitText "ratio" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-ablation-to-wild-type-activator-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-ablation-to-wild-type-activator-std-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-activator-peaks-on-a-48-m-patch-versus-a-16-m-patch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "activator peaks on a 48 µm patch versus a 16 µm patch = 13 peaks" ;
        dct:description "Pass 2 domain-length series. Counts: 16µm=4, 32µm=6, 48µm=13" ;
        schema:measurementTechnique "Midline positive maxima at fixed dx = 0.5 µm and Ly = 32 µm; reference is the 16 µm count" ;
        schema:name "activator peaks on a 48 µm patch versus a 16 µm patch" ;
        schema:unitText "peaks" ;
        schema:value "13" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-activator-peaks-on-a-48-m-patch-versus-a-16-m-patch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-activator-peaks-on-a-48-m-patch-versus-a-16-m-patch-reference> a schema:PropertyValue ;
        schema:value "4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-ks-statistic-of-gradient-orientation-specimen-versus-adult-endpoint> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS statistic of gradient orientation, specimen versus adult endpoint = 0.0315 KS distance" ;
        schema:measurementTechnique "Two-sample KS on Sobel orientations of the habitus mask versus the last composed frame" ;
        schema:name "KS statistic of gradient orientation, specimen versus adult endpoint" ;
        schema:unitText "KS distance" ;
        schema:value "0.0315" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-ks-statistic-of-gradient-orientation-specimen-versus-adult-endpoint-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-ks-statistic-of-gradient-orientation-specimen-versus-adult-endpoint-reference> a schema:PropertyValue ;
        schema:value "0.2" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-pearson-r-of-numerical-versus-analytic-dispersion-sigma-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r of numerical versus analytic dispersion sigma(k) = 0.99808 correlation" ;
        dct:description "Reference is the pre-registered acceptance threshold, not the measured correlation." ;
        schema:measurementTechnique "Linearized 1D growth on 21 real-eigenvalue Fourier modes versus continuum eig(J - k^2 D)" ;
        schema:name "Pearson r of numerical versus analytic dispersion sigma(k)" ;
        schema:unitText "correlation" ;
        schema:value "0.99808" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-pearson-r-of-numerical-versus-analytic-dispersion-sigma-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-pearson-r-of-numerical-versus-analytic-dispersion-sigma-k-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-pixel-pearson-r-of-adult-endpoint-versus-specimen-habitus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pixel Pearson r of adult endpoint versus specimen habitus = 0.99572 correlation" ;
        dct:description "Tests that the modulation preserves the specimen; it does not claim the PDE drew the wing veins." ;
        schema:measurementTechnique "Pearson correlation of luminance after the bounded PDE pigment modulation" ;
        schema:name "pixel Pearson r of adult endpoint versus specimen habitus" ;
        schema:unitText "correlation" ;
        schema:value "0.99572" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-pixel-pearson-r-of-adult-endpoint-versus-specimen-habitus-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-pixel-pearson-r-of-adult-endpoint-versus-specimen-habitus-reference> a schema:PropertyValue ;
        schema:value "0.95" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-rmse-of-dispersion-sigma-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RMSE of dispersion sigma(k) = 0.03183 1/time" ;
        schema:measurementTechnique "Root mean square of numeric growth rate minus analytic σ(k)" ;
        schema:name "RMSE of dispersion sigma(k)" ;
        schema:unitText "1/time" ;
        schema:value "0.03183" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-rmse-of-dispersion-sigma-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-rmse-of-dispersion-sigma-k-reference> a schema:PropertyValue ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.2009 fraction" ;
        dct:description "0.45 is the segmentation percentile used as a threshold label, not the measured area." ;
        schema:measurementTechnique "Border-median contrast mask on the Hanson 2019 habitus" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.2009" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.45" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-habitus-nyquist-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen habitus Nyquist wavelength = 7.762 µm" ;
        schema:measurementTechnique "2 × (3400 µm atlas length / 4√λ_max of the foreground second-moment). The habitus cannot resolve 3.101 µm when this Nyquist length is larger." ;
        schema:name "specimen habitus Nyquist wavelength" ;
        schema:unitText "µm" ;
        schema:value "7.762" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-habitus-nyquist-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-habitus-nyquist-wavelength-reference> a schema:PropertyValue ;
        schema:value "3.101" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.5743 coherency" ;
        schema:measurementTechnique "Mean structure-tensor coherency on the habitus foreground" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.5743" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-teissieri-onset-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "teissieri onset wavelength = 2.9243 µm" ;
        schema:measurementTechnique "Same Du and Dv as virilis, a=0.058 (predecessor, 0 Ma)" ;
        schema:name "teissieri onset wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.9243" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-teissieri-onset-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-teissieri-onset-wavelength-reference> a schema:PropertyValue ;
        schema:value "3.101" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-emergent-midline-peak-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "virilis emergent midline peak spacing = 3.625 µm" ;
        dct:description "Near-onset k_max is close to but not identical with onset k_c, so this need not equal 3.101." ;
        schema:measurementTechnique "Mean distance between positive midline maxima of the saturated Schnakenberg activator" ;
        schema:name "virilis emergent midline peak spacing" ;
        schema:unitText "µm" ;
        schema:value "3.625" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-emergent-midline-peak-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-emergent-midline-peak-spacing-reference> a schema:PropertyValue ;
        schema:value "3.101" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-onset-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "virilis onset wavelength lambda_c = 3.101 µm" ;
        dct:description "Assigned detail scale. Equality here is the Du calibration, reported separately from the emergent spacing." ;
        schema:measurementTechnique "2π/k_c with k_c^2 = (Dv f_u + Du g_v)/(2 Du Dv) after solving Du at a=0.10, Dv/Du=10" ;
        schema:name "virilis onset wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "3.101" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-onset-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-onset-wavelength-lambda-c-reference> a schema:PropertyValue ;
        schema:value "3.101" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-tergite-mode-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "virilis tergite mode count = 156.632 modes" ;
        schema:measurementTechnique "(adult length / 7) / lambda_onset using atlas lengths 3.4 mm and, as reference, the teissieri count" ;
        schema:name "virilis tergite mode count" ;
        schema:unitText "modes" ;
        schema:value "156.632" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-tergite-mode-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-virilis-tergite-mode-count-reference> a schema:PropertyValue ;
        schema:value "122.128" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-willistoni-selected-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "willistoni selected wavelength = 0.0 µm" ;
        dct:description "Successor at 0 Ma. Reference is the formal continuation, which is not a selected mode." ;
        schema:measurementTechnique "a=0.360 crosses the Turing discriminant; selected wavelength is 0 even though the formal onset expression is still defined" ;
        schema:name "willistoni selected wavelength" ;
        schema:unitText "µm" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-willistoni-selected-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-measurement-willistoni-selected-wavelength-reference> a schema:PropertyValue ;
        schema:value "4.9948" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L224–L292" ;
        dct:description "dispersion goodness of fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L224-L292> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L514–L631" ;
        dct:description "measurement table with reference anchors that differ from the measured values except the calibrated onset wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L514-L631> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-virilis-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py L560–L585" ;
        dct:description "48 µm peak count compared with the 16 µm count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-virilis-turing-wavelength-s0.py#L560-L585> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


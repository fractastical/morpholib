sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pezzulo-bioelectric-target-morphology-memory> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Pezzulo & Levin (2015) / Friston et al. (2015) bioelectric target morphology memory and Variational Free Energy homeostasis — Morphological realism / specimen match: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 3.0 underwater whole-mount photograph of Ambystoma mexicanum (`datasets/bioelectric_target_morphology_memory/salamander_limb_regeneration_specimen.jpg`), segments the body silhouette and articulated right forelimb skeleton across shoulder, elbow, wrist, and autopod landmarks (`segment_axolotl_limb_specimen`, L440-536: total limb length 269.6 px, segment proportions 0.50:0.29:0.21, 40-bin width profile Pearson r = 0.8711, RMSE = 0.1240), and synthesizes 2D 4-digit forelimb silhouettes across regimes (Panels B3, C1, C2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2015-pezzulo-bioelectric-target-morphology-memory.py L440–L588" ;
        dct:description "Ambystoma mexicanum forelimb skeleton & 40-bin width segmentation + 2D 4-digit limb silhouette synthesis" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L440-L588> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/bioelectric_target_morphology_memory_comparison.png (generated output)" ;
        dct:description "9-panel comparison figure showing specimen forelimb skeleton, width comparison, and 2D limb silhouettes — docs/media/bioelectric_target_morphology_memory_comparison.png: rendered output of 2015-pezzulo-bioelectric-target-morphology-memory.py at b2936f6, image/png, 1009309 B, 2268×1863 px, artifact_sha256 e5d2033311420793acded2c7d8a60502ea97b8f28d2e3a025a7f3acb2e3825a0 (sha256 e5d2033311420793acded2c7d8a60502ea97b8f28d2e3a025a7f3acb2e3825a0), spec_fingerprint 76f53df6fe2e78cfcaffeee38c874bcb67b673c1a916f9045c6a97417b660f71" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pezzulo-bioelectric-target-morphology-memory> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Pezzulo & Levin (2015) / Friston et al. (2015) bioelectric target morphology memory and Variational Free Energy homeostasis — Model fidelity to source: 93/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Faithfully implements the Pezzulo & Levin (2015) and Friston, Levin, Sengupta & Pezzulo (2015) Variational Free Energy functional F(mu, x), coupled perception dmu/dt = -kappa_mu*dF/dmu and morphogenetic action dx/dt = -kappa_a*dF/dx ODEs, monotonic Lyapunov dissipation dF/dt <= 0, and 3-segment proximodistal + organ-identity dynamics (L126-342), verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2015-pezzulo-bioelectric-target-morphology-memory.py L126–L198" ;
        dct:description "Variational Free Energy functional, perception/action gradients, and Lyapunov decay invariants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L126-L198> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2015-pezzulo-bioelectric-target-morphology-memory.py L204–L342" ;
        dct:description "4th-order Runge-Kutta active-inference solver for 3 limb segments, organ identity psi, and V_mem(s,t)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L204-L342> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean L14–L107" ;
        dct:description "3 machine-checked Lean 4 theorems (0 sorrys) for VFE target equilibrium, exact stop & Pi_s=0 arrest, and 5 regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b2936f6/morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean#L14-L107> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        dct:title "Normalized shape and location of perturbed craniofacial structures in the Xenopus tadpole reveal an innate ability to achieve correct morphology" .
    <https://doi.org/10.1098/rsif.2014.1383> dct:date "2015"^^xsd:gYear ;
        dct:title "Knowing one's place: a free-energy approach to pattern regulation" .
    <https://doi.org/10.1098/rsif.2015.0772> dct:date "2015"^^xsd:gYear ;

        <https://doi.org/10.1098/rsif.2016.0555> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
    pk1:leanDeclaration "MathOfBiology.Loop_084.morpho_action_vel" ;
    pk1:leanTheorem "MathOfBiology.Loop_084.morpho_action_stop_and_denervation_arrest" ;

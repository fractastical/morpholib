<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-1>,
        <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-2>,
        <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-3> .

<https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Pezzulo & Levin (2015) & Friston et al. (2015) Variational Free Energy Target Setpoint & Symmetry Law" ;
    dct:description "Defines the Variational Free Energy functional governing anatomical homeostasis and proves that the target morphology setpoint μ_target is the unique zero-free-energy equilibrium | Variables: x(t): anatomical state (proximodistal limb segment lengths or organ coordinates); μ(t): internal bioelectric positional state; μ_target: stored bioelectric target morphology setpoint; Π_s: sensory precision; Π_p: prior setpoint precision" ;
    dct:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Figs. 2-4; Friston, Levin, Sengupta & Pezzulo (2015) J. R. Soc. Interface 12:20141383 Eqs. (2.1)-(2.6)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L120-L210>,
        <https://github.com/fractastical/morpholib/blob/b2936f6/morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean#L14-L44> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def sq_int (z : Int) : Int :=
  z * z
def vfe_2x (Pi_s Pi_p x mu mu_target : Int) : Int :=
  Pi_s * sq_int (x - mu) + Pi_p * sq_int (mu - mu_target)
theorem vfe_zero_at_target_and_symmetry (Pi_s Pi_p d mu_target : Int) :
    vfe_2x Pi_s Pi_p mu_target mu_target mu_target = 0 ∧
    vfe_2x 2 4 20 100 100 = 12800 ∧
    vfe_2x 2 4 100 100 100 = 0 ∧
    sq_int (-d) = sq_int d := by
  refine ⟨?_, by decide, by decide, ?_⟩
  · simp [vfe_2x, sq_int]
  · simp [sq_int, Int.neg_mul_neg]
"""^^pk:lean4 ;
    skos:notation "F(μ, x) = (1/2) Π_s (s(x) - g(μ))^2 + (1/2) Π_p (μ - μ_target)^2 ≥ 0;   F(μ_target, μ_target) = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2014.1383>,
        <https://doi.org/10.1098/rsif.2015.0772>,
        <https://doi.org/10.1098/rsif.2016.0555> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
    pk:leanDeclaration "MathOfBiology.Loop_084.vfe_2x" ;
    pk:leanTheorem "MathOfBiology.Loop_084.vfe_zero_at_target_and_symmetry" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homeostatic Anatomical Error-Correction Velocity, Exact Stop at L* & Denervation Arrest Law" ;
    dct:description "Proves proportional blastema growth rate scaling with amputation deficit (proximal faster than distal), exact growth cessation at L(t) = L*, and complete regeneration arrest under denervation / sensory-precision ablation (Π_s = 0) | Variables: κ_a: active morphogenetic remodeling rate; Π_s: bioelectric sensory precision; x = L(t): current limb length; μ = L*: target limb length" ;
    dct:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Section 3 & Fig. 2; Friston et al. (2015) Eq. (2.6)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L145-L265>,
        <https://github.com/fractastical/morpholib/blob/b2936f6/morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean#L47-L76> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def morpho_action_vel (kappa_a Pi_s x mu : Int) : Int :=
  -kappa_a * Pi_s * (x - mu)
theorem morpho_action_stop_and_denervation_arrest (kappa_a Pi_s x mu : Int) :
    morpho_action_vel kappa_a Pi_s mu mu = 0 ∧
    morpho_action_vel kappa_a 0 x mu = 0 ∧
    morpho_action_vel 9 1 20 100 = 720 ∧
    morpho_action_vel 9 1 70 100 = 270 ∧
    morpho_action_vel 9 1 100 100 = 0 := by
  refine ⟨?_, ?_, by decide, by decide, by decide⟩
  · simp [morpho_action_vel]
  · simp [morpho_action_vel]
"""^^pk:lean4 ;
    skos:notation "dx/dt = -κ_a ∂_x F = -κ_a Π_s (x - μ);   x = μ ⟹ dx/dt = 0;   Π_s = 0 ⟹ dx/dt = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2014.1383>,
        <https://doi.org/10.1098/rsif.2015.0772>,
        <https://doi.org/10.1098/rsif.2016.0555> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
    pk:leanDeclaration "MathOfBiology.Loop_084.morpho_action_vel" ;
    pk:leanTheorem "MathOfBiology.Loop_084.morpho_action_stop_and_denervation_arrest" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equifinal Limb Regeneration, Ectopic Tail-to-Limb Remodeling & Bioelectric Setpoint Rewriting Law" ;
    dct:description "Establishes exact equifinality of proximal and distal limb regeneration to L* = 1.00, tail-to-limb blastema remodeling, rewritten bioelectric memory convergence to L*' = 1.45, and denervation arrest at L_0 = 0.20 | Variables: L_0: amputation stump length (0.20 proximal shoulder vs 0.70 distal wrist); ψ_0: initial grafted organ identity (-1.0 tail vs +1.0 limb); L_target' = 1.45: rewritten bioelectric target setpoint" ;
    dct:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Figs. 1-4; Farinella-Ferruzza (1956); Durant et al. (2017) Biophys. J. 112:2231-2243" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L270-L440>,
        <https://github.com/fractastical/morpholib/blob/b2936f6/morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean#L79-L107> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def asymptotic_regenerated_state (Pi_s L_0 psi_0 L_target psi_target : Int) : Int × Int :=
  if Pi_s > 0 then (L_target, psi_target) else (L_0, psi_0)
theorem canonical_bioelectric_target_regimes :
    asymptotic_regenerated_state 2 20 100 100 100 = (100, 100) ∧
    asymptotic_regenerated_state 2 70 100 100 100 = (100, 100) ∧
    asymptotic_regenerated_state 2 35 (-100) 100 100 = (100, 100) ∧
    asymptotic_regenerated_state 2 20 145 145 145 = (145, 145) ∧
    asymptotic_regenerated_state 0 20 20 100 100 = (20, 20) := by
  decide
"""^^pk:lean4 ;
    skos:notation "lim_{t→∞} (L(t), ψ(t)) = (L_target, ψ_target) [Π_s > 0]  vs  (L_0, ψ_0) [Π_s = 0]" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2014.1383>,
        <https://doi.org/10.1098/rsif.2015.0772>,
        <https://doi.org/10.1098/rsif.2016.0555> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
    pk:leanDeclaration "MathOfBiology.Loop_084.asymptotic_regenerated_state" ;
    pk:leanTheorem "MathOfBiology.Loop_084.canonical_bioelectric_target_regimes" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/pezzulo-bioelectric-target-morphology-memory-1>,
        <https://w3id.org/probknow/resource/math-law/pezzulo-bioelectric-target-morphology-memory-2>,
        <https://w3id.org/probknow/resource/math-law/pezzulo-bioelectric-target-morphology-memory-3> .

<https://w3id.org/probknow/resource/math-law/pezzulo-bioelectric-target-morphology-memory-1> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Pezzulo & Levin (2015) & Friston et al. (2015) Variational Free Energy Target Setpoint & Symmetry Law" ;
    dct:description "Defines the Variational Free Energy functional governing anatomical homeostasis and proves that the target morphology setpoint μ_target is the unique zero-free-energy equilibrium | Variables: x(t): anatomical state (proximodistal limb segment lengths or organ coordinates); μ(t): internal bioelectric positional state; μ_target: stored bioelectric target morphology setpoint; Π_s: sensory precision; Π_p: prior setpoint precision" ;
    dct:source "Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 Figs. 2-4; Friston, Levin, Sengupta & Pezzulo (2015) J. R. Soc. Interface 12:20141383 Eqs. (2.1)-(2.6)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L120-L210>,
        <https://github.com/fractastical/morpholib/blob/b2936f6/morphoeval/lean/loops/Loop_084_bioelectric_target_morphology_memory.lean#L14-L44> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def sq_int (z : Int) : Int :=
  z * z
def vfe_2x (Pi_s Pi_p x mu mu_target : Int) : Int :=
  Pi_s * sq_int (x - mu) + Pi_p * sq_int (mu - mu_target)
theorem vfe_zero_at_target_and_symmetry (Pi_s Pi_p d mu_target : Int) :
    vfe_2x Pi_s Pi_p mu_target mu_target mu_target = 0 ∧
    vfe_2x 2 4 20 100 100 = 12800 ∧
    vfe_2x 2 4 100 100 100 = 0 ∧
    sq_int (-d) = sq_int d := by
  refine ⟨?_, by decide, by decide, ?_⟩
  · simp [vfe_2x, sq_int]
  · simp [sq_int, Int.neg_mul_neg]
"""^^pk1:lean4 ;
    skos:notation "F(μ, x) = (1/2) Π_s (s(x) - g(μ))^2 + (1/2) Π_p (μ - μ_target)^2 ≥ 0;   F(μ_target, μ_target) = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2014.1383>,
        <https://doi.org/10.1098/rsif.2015.0772>,
        <https://doi.org/10.1098/rsif.2016.0555> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
    pk1:leanDeclaration "MathOfBiology.Loop_084.vfe_2x" ;
    pk1:leanTheorem "MathOfBiology.Loop_084.vfe_zero_at_target_and_symmetry" ;
    pk1:leanVerified true .

<https://w3id.org/probknow/resource/math-law/pezzulo-bioelectric-target-morphology-memory-2> a skos:Concept,

<https://w3id.org/delphi/resource/claim/morphoeval-pezzulo-bioelectric-target-morphology-memory> a pk:Claim ;
    rdfs:label "Pezzulo & Levin (2015) / Friston et al. (2015) bioelectric target morphology memory and Variational Free Energy homeostasis (Ambystoma mexicanum (axolotl salamander) regenerating forelimb)" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-1>,
        <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-2>,
        <https://w3id.org/delphi/resource/math-law/pezzulo-bioelectric-target-morphology-memory-3> ;
    schema:about "Ambystoma mexicanum (axolotl salamander) regenerating forelimb" ;
    schema:additionalProperty "does_not_claim: Single-cell transcriptomic trajectories of blastema dedifferentiation or 3D finite-element bone mineralization mechanics",
        "reconstructed_in_script: Articulated right forelimb skeleton (shoulder, elbow, wrist, autopod; L = 269.6 px) and 40-bin width profile segmentation on salamander_limb_regeneration_specimen.jpg (Pearson r = 0.8711) and 2D 4-digit forelimb silhouette synthesis",
        "reconstructed_in_script: Coupled 4D active-inference ODE solver for 3 proximodistal limb segments (stylopod, zeugopod, autopod) and organ identity psi(t) plus spatial bioelectric V_mem(s,t) kymograph across 5 experimental regimes",
        "reported_in_source: Pezzulo & Levin (2015) J. R. Soc. Interface 12:20150772 & Friston, Levin, Sengupta & Pezzulo (2015) J. R. Soc. Interface 12:20141383 Variational Free Energy minimization F(mu, x) and active-inference homeostatic error-correction toward stored bioelectric target morphology setpoints",
        "reported_in_source: Proximal vs distal salamander limb amputation equifinality (exact stop at L* = 1.00), Farinella-Ferruzza tail-to-limb graft remodeling, rewritten bioelectric target setpoint memory, and Singer (1952) denervation arrest (Pi_s = 0)",
        "transfer_boundary: Proximodistal 3-segment active-inference trajectories mapped onto 2D articulated Ambystoma mexicanum forelimb silhouettes and joint landmarks" ;
    pk:derivedFromPaper <https://doi.org/10.1002/dvdy.23770>,
        <https://doi.org/10.1098/rsif.2014.1383>,
        <https://doi.org/10.1098/rsif.2015.0772>,
        <https://doi.org/10.1098/rsif.2016.0555> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-19-bioelectric-target-morphology-memory-audit-v2-pezzulo-bioelectric-target-morphology-memory-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-bioelectric-target-morphology-memory-audit-v2-pezzulo-bioelectric-target-morphology-memory-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-bioelectric-target-morphology-memory-audit-v2-pezzulo-bioelectric-target-morphology-memory-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-bioelectric-target-morphology-memory-audit-v2-pezzulo-bioelectric-target-morphology-memory-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-bioelectric-target-morphology-memory-audit-v2-pezzulo-bioelectric-target-morphology-memory-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-bioelectric-target-morphology-memory-audit-v2-pezzulo-bioelectric-target-morphology-memory-6> ;
    pk:hypothesisType "Variational Free Energy Minimization & Active Inference Anatomical Homeostasis Toward Bioelectric Setpoints" ;
    pk:weightOfEvidence 9.15e-01 .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-pezzulo-bioelectric-target-morphology-memory> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-pezzulo-bioelectric-target-morphology-memory-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Pezzulo & Levin (2015) / Friston et al. (2015) bioelectric target morphology memory and Variational Free Energy homeostasis — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates all 5 canonical Pezzulo & Levin (2015) experimental regimes (`proximal_limb_amputation_shoulder`, `distal_limb_amputation_wrist`, `tail_to_limb_translocation_remodeling`, `rewritten_bioelectric_setpoint_memory`, and `denervated_sensory_precision_zero_arrest`), performs an 11-point sensory precision dose-response sweep across Pi_s in [0.0, 2.5] (Panel C3), and maps the 9x9 2D (L_0, mu_target) morphospace phase diagram confirming horizontal iso-contour equifinality (Panel B2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-parameter-expressivity-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-pezzulo-bioelectric-target-morphology-memory-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2015-pezzulo-bioelectric-target-morphology-memory.py L345–L435" ;
        dcterms:description "5-regime evaluator, 11-point Pi_s sweep, and 9x9 (L_0, mu_target) equifinality phase grid" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/b2936f6/2015-pezzulo-bioelectric-target-morphology-memory.py#L345-L435> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-008-the-rate-of-growth-audit-thompson1917-t1917-008-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-008-the-rate-of-growth-audit-thompson1917-t1917-008-8>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-008-the-rate-of-growth-audit-thompson1917-t1917-008-9> ;
    pk:hypothesisType "quantitative-empirical relative growth / Huxley-Thompson allometry" ;
    pk:weightOfEvidence 5.28e-01 .


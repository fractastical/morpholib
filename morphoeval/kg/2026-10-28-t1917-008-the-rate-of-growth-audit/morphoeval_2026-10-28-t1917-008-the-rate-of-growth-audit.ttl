<https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-008> a pk:Claim ;
    rdfs:label "Thompson (1917) differential relative growth / Huxley allometry (Mammals, plaice, Pheidole megacephala (analogue))",
        "Thompson (1917) differential relative growth / Huxley allometry faithfully reproduces Mammals, plaice, Pheidole megacephala (analogue) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-3> ;
    dct:description "The simulation script(s) thompson/claims/t1917-008_the-rate-of-growth.py implement the cited source model as published and produce forms that match real Mammals, plaice, Pheidole megacephala (analogue) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-008_the-rate-of-growth.py> ;
    schema:about "Mammals, plaice, Pheidole megacephala (analogue)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-008_the-rate-of-growth.py; output: docs/media/t1917_008_the_rate_of_growth_comparison.png; organism: Mammals, plaice, Pheidole megacephala (analogue); environment: n/a; other sources: On Growth and Form <https://archive.org/details/ongrowthform1917thom>, Problems of Relative Growth <https://archive.org/details/problemsofrelati033044mbp>" ;
    pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-code-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-model-fidelity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-morphometric-validation>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-overall>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-parameter-expressivity>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-repro-package>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-source-traceability>,
        <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-specimen-match> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-008-the-rate-of-growth-audit-thompson1917-t1917-008-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-008-the-rate-of-growth-audit-thompson1917-t1917-008-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-28-t1917-008-the-rate-of-growth-audit-thompson1917-t1917-008-3>,

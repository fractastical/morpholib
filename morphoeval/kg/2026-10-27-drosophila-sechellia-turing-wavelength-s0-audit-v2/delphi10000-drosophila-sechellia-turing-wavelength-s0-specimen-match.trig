    <https://doi.org/10.1016/j.cell.2008.01.014> dct:date "2008"^^xsd:gYear ;
        dct:title "The evolution of gene regulation underlies a morphological difference between two Drosophila sister species" .
    <https://doi.org/10.1038/nature05988> dct:date "2007"^^xsd:gYear ;
        dct:title "Morphological evolution through multiple cis-regulatory mutations at a single gene" .
    <https://doi.org/10.1073/pnas.97.9.4530> dct:date "2000"^^xsd:gYear ;
        dct:title "Divergence of larval morphology between Drosophila sechellia and its sibling species caused by cis-regulatory evolution of a single gene" .
    <https://doi.org/10.1083/jcb.29.2.223> dct:date "1966"^^xsd:gYear ;
        dct:title "The development of pigment granules in the eyes of wild type and mutant Drosophila melanogaster" .

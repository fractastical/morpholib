sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis, gated by a Lewis (2003) delayed Her1/Hes7 clock lattice on 2D bilateral paraxial mesoderm strips — Source and data traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`datasets/fgf_wnt_bistable_wavefront/` now vendors `fgf_wnt_clock_lr_reference.json` (Lewis 2003 parameters and period table, competence window, Vermot & Pourquié LR law and 4 regimes, bilateral geometry) with its SHA-256 pinned in `EXPECTED_SHA256` (L131-146) and verified at runtime (`verify_dataset_integrity`, L148-172); `paper_citations.bib` and `README.md` add Lewis 2003, Palmeirim 1997, Dubrulle 2001 and Vermot et al. 2005 Science (10 DOIs total). Where a constant is not published (Notch K_D, L452-453) or is fitted (b_LR = 0.727, L821, L839) the code says so. Deduction: b_LR, K_buf and h_buf remain calibrated constants without a cited molecular source." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2012-baker-fgf-wnt-bistable-wavefront.py L819–L836: ra_lr_buffering_factor: b_LR = 0.727, K_buf = 1.0 nM, h = 4 are calibrated to the one-somite VAD lag, not sourced <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L819-L836>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L131–L172" ;
        dct:description "Pinned SHA-256 digests for specimen, scout manifest and the new clock/LR reference JSON; runtime verification" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L131-L172> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/fgf_wnt_bistable_wavefront/fgf_wnt_clock_lr_reference.json L1–L181" ;
        dct:description "Lewis (2003) published parameters, period table, competence window, Vermot & Pourquie LR law, 4 LR regimes with sources" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/fgf_wnt_bistable_wavefront/fgf_wnt_clock_lr_reference.json#L1-L181> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/fgf_wnt_bistable_wavefront/paper_citations.bib L1–L109" ;
        dct:description "10 BibTeX entries incl. Lewis 2003, Palmeirim 1997, Dubrulle 2001, Vermot et al. 2005 Science" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/fgf_wnt_bistable_wavefront/paper_citations.bib#L1-L109> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis, gated by a Lewis (2003) delayed Her1/Hes7 clock lattice on 2D bilateral paraxial mesoderm strips — Parameter expressivity: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Beyond the 5 RA/FGF regimes, Pass 3 adds a clock-delay sweep against Lewis's closed form (`sweep_clock_delay`, L1032-1061), a Notch-coupling ablation (`ablate_notch_coupling`, L1063-1088), an RA-buffering sweep across v_sc (`sweep_lr_buffering`, L1090-1116, monotone in the self-test) and a 4-regime left-right evaluator including situs inversus and the Raldh2-/- mouse (`evaluate_lr_regimes`, L1118-1164). New CLI flags --clock-delay, --notch-delay, --notch-coupling, --lr-bias, --situs and --print-pass3 (L2168-2213) drive the new solvers and print a JSON summary. Deduction: the pre-existing --v-sc/--vg/--Tc/--seed flags are consumed only by --print-pass3; the default figure/GIF render still ignores them (L2213-2218)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2012-baker-fgf-wnt-bistable-wavefront.py L2157–L2221: CLI: six new Pass 3 flags and --print-pass3 JSON summary; --v-sc/--vg/--Tc/--seed not wired into the default render <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L2157-L2221>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity-2> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L1032–L1164" ;
        dct:description "Clock-delay sweep, Notch ablation, LR buffering sweep and 4-regime LR evaluator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L1032-L1164> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L1167–L1296" ;
        dct:description "5-regime RA/FGF8 perturbation evaluator and bistable somitogenesis simulator (carried from v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L1167-L1296> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


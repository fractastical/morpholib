        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis, gated by a Lewis (2003) delayed Her1/Hes7 clock lattice on 2D bilateral paraxial mesoderm strips — Morphometric validation: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1375-1595) now yields 11 reference-anchored measurements (5 carried + 6 new): T_osc = 92.0 min vs 90 min (Palmeirim 1997), S = v_g*T_osc = 153.3 um vs 150 um, Notch nearest-neighbour coherence 0.84 vs 0.03 ablated, competence window 2.81 segments vs the >= 1 Goldbeter Fig. 10 criterion, 2D VAD LR offset 149.8 um vs 150 um analytic / one somite, and N_LR = 1.00 vs 1.0 observed with 4/4 sides correct (mean abs error 0.012 somites). Deduction: the cohort-level segment length (mean 127 um, SD 88 um over 13 core cohorts) is far noisier than the observed 150 +/- 8 um, so the saltatory-arrest metric validates the mechanism qualitatively, not the segment-size distribution; the WT 2D offset differs by grid (6.3 vs 6.5 um)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-baker-fgf-wnt-bistable-wavefront.py L715–L760: Cohort detection by a 0.5*T consecutive-cell arrest-time threshold; yields irregular cohort extents (SD 88 um) <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L715-L760>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-2d-bilateral-paraxial-strip-left-right-determination-front-offset-under-vad>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-psm-bistable-determination-front-position-x-front-and-10-90-switch-width>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-clock-derived-somite-length-s-v-g-t-osc-from-the-delayed-her1-hes7-oscillator>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-baker-5-regime-ra-fgf-perturbation-somite-length-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-et-al-2007-bistability-competence-window-width-in-segments>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-lewis-2003-delayed-her1-hes7-autoinhibition-segmentation-clock-period-t-osc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-notch-delta-nearest-neighbour-phase-coherence-r-at-the-determination-front>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-ra-fgf8-wnt-saddle-node-bistable-hysteresis-window-width-delta-m-m-2-m-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vermot-pourquie-2005-left-right-somite-count-difference-n-lr-across-4-regimes>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vitamin-a-deficiency-vad-anterior-wavefront-shift-compressed-somite-length-s-vad>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-morphometric-validation-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-2d-bilateral-paraxial-strip-left-right-determination-front-offset-under-vad> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D bilateral paraxial-strip left-right determination-front offset under VAD = 149.8 um" ;
        dct:description "analytic prediction 149.80 um vs lambda_M*ln(1+b_eff); 2D wild-type front x = 509.5 um vs the 1D front 571.46 um (transverse diffusive coupling to the low-FGF8 neural tube shifts the 2D front posteriorly)" ;
        schema:measurementTechnique "2D (x, y) RA-FGF8/Wnt reaction-diffusion solve on left strip + neural tube + right strip with the RA-buffered lateralizing bias b_eff = 0.5158 (v_sc = 0.08 nM/min, R_ant = 0.80 nM); wild-type control offset 6.34 um (b_eff = 0.0181, R_ant = 2.50 nM)" ;
        schema:name "2D bilateral paraxial-strip left-right determination-front offset under VAD" ;
        schema:unitText "um" ;
        schema:value "149.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-2d-bilateral-paraxial-strip-left-right-determination-front-offset-under-vad-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-2d-bilateral-paraxial-strip-left-right-determination-front-offset-under-vad-reference> a schema:PropertyValue ;
        dct:source "Vermot & Pourquie (2005) Nature 435:215-220 (one-somite lag of the left segmented region in RA-deficient chick); analytic law Delta_x = lambda_M * ln(1 + b_eff)" ;
        schema:value "150.01" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-psm-bistable-determination-front-position-x-front-and-10-90-switch-width> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chick PSM bistable determination front position x_front and 10-90% switch width = 571.46 um" ;
        dct:description "wild-type somite length S_0 = 150.0 um; constitutive-FGF control forms 0 somites" ;
        schema:measurementTechnique "1D coupled RA-FGF8/Wnt reaction-diffusion PDE steady state (10-90% jump width Delta_x_front=16.22 um vs exponential decay length lambda_M=360.67 um, 22.2x sharpening)" ;
        schema:name "chick PSM bistable determination front position x_front and 10-90% switch width" ;
        schema:unitText "um" ;
        schema:value "571.46" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-psm-bistable-determination-front-position-x-front-and-10-90-switch-width-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-psm-bistable-determination-front-position-x-front-and-10-90-switch-width-reference> a schema:PropertyValue ;
        dct:source "Goldbeter, Gonze & Pourquie (2007) Dev. Cell / Dev. Dyn. 236:1495-1508 Fig. 4 & Baker et al. (2006) J. Theor. Biol. 239:413-429" ;
        schema:value "571.61" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "chick/vertebrate embryo SEM specimen bilateral somite spacing S_obs = 48.4667 px" ;
        dct:description "bilateral symmetry ratio = 0.9606, std = 9.70 px, phase correlation r = 0.5629" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on chick_ra_fgf_somites_specimen.jpg (upper=8 somites, lower=9 somites, CV=0.2002)" ;
        schema:name "chick/vertebrate embryo SEM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "48.4667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-chick-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 avian/vertebrate embryo SEM specimen (datasets/fgf_wnt_bistable_wavefront/chick_ra_fgf_somites_specimen.jpg)" ;
        schema:value "48.47" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-clock-derived-somite-length-s-v-g-t-osc-from-the-delayed-her1-hes7-oscillator> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "clock-derived somite length S = v_g * T_osc from the delayed Her1/Hes7 oscillator = 153.33 um" ;
        dct:description "the somite length is now DERIVED from the delayed clock rather than imposed; 0 of 150 cells arrested without a clock peak (forced at the anterior end of the bistability window)" ;
        schema:measurementTechnique "v_g = 1.6667 um/min times the DDE-measured clock period (92.00 min); mean axial extent of the simultaneously arrested cohorts = 127.4 um (SD 88.5 um over 13 cohorts)" ;
        schema:name "clock-derived somite length S = v_g * T_osc from the delayed Her1/Hes7 oscillator" ;
        schema:unitText "um" ;
        schema:value "153.33" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-clock-derived-somite-length-s-v-g-t-osc-from-the-delayed-her1-hes7-oscillator-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-clock-derived-somite-length-s-v-g-t-osc-from-the-delayed-her1-hes7-oscillator-reference> a schema:PropertyValue ;
        dct:source "Dubrulle et al. (2001) Cell 106:219-232; Palmeirim et al. (1997) Cell 91:639-648 (chick somite length ~150 um, one somite per 90 min)" ;
        schema:value "150.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-baker-5-regime-ra-fgf-perturbation-somite-length-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;

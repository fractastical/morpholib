    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L1375–L1398" ;

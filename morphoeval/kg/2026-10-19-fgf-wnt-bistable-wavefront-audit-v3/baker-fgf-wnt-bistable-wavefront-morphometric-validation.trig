        dct:description "p = 4.96e-08, RMSE = 0.806 um across [98, 214] um somite range" ;
        schema:measurementTechnique "correlation across 5 RA/FGF8/Wnt perturbation regimes (WT, VAD, exogenous RA, SU5402 FGFR1 block, ectopic FGF8 bead; RMSE=0.806 um)" ;
        schema:name "Goldbeter-Baker 5-regime RA/FGF perturbation somite length Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-baker-5-regime-ra-fgf-perturbation-somite-length-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-baker-5-regime-ra-fgf-perturbation-somite-length-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Goldbeter et al. (2007) Dev. Dyn. 236:1495-1508; Diez del Corral et al. (2003) Neuron 40:65-79; Dubrulle et al. (2001) Cell 106:219-232" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-et-al-2007-bistability-competence-window-width-in-segments> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Goldbeter et al. (2007) bistability competence-window width in segments = 2.8132 somites" ;
        dct:description "requirement window >= 1 segment satisfied: True; the clock-competence window spans 2.81 segments" ;
        schema:measurementTechnique "x(M_2) = 149.4 um to x(M_1) = 571.4 um (width 422.0 um) divided by S_0 = 150 um" ;
        schema:name "Goldbeter et al. (2007) bistability competence-window width in segments" ;
        schema:unitText "somites" ;
        schema:value "2.8132" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-et-al-2007-bistability-competence-window-width-in-segments-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-goldbeter-et-al-2007-bistability-competence-window-width-in-segments-reference> a schema:PropertyValue ;
        dct:source "Goldbeter, Gonze & Pourquie (2007) Dev. Dyn. 236:1495-1508 Fig. 10 ('the size of the bistability window has to be equal to or larger than the segmental domain')" ;
        schema:value "2.813" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-lewis-2003-delayed-her1-hes7-autoinhibition-segmentation-clock-period-t-osc> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Lewis (2003) delayed Her1/Hes7 autoinhibition segmentation-clock period T_osc = 92.0 min" ;
        dct:description "relative error vs the chick 90 min clock = 2.22%; Lewis sustained-oscillation conditions satisfied: True" ;
        schema:measurementTechnique "numerical integration of the delayed autoinhibition DDE lattice (T_m=31.5 min, T_p=2.8 min, a=4.5, b=c=0.23/min, k=33/min, p_0=40; Lewis closed-form estimate 2*(T + 1/b + 1/c) = 85.99 min, zebrafish preset T_m=10.2 min -> 43.4 min vs Lewis's reported 47.0 min)" ;
        schema:name "Lewis (2003) delayed Her1/Hes7 autoinhibition segmentation-clock period T_osc" ;
        schema:unitText "min" ;
        schema:value "92.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-lewis-2003-delayed-her1-hes7-autoinhibition-segmentation-clock-period-t-osc-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-lewis-2003-delayed-her1-hes7-autoinhibition-segmentation-clock-period-t-osc-reference> a schema:PropertyValue ;
        dct:source "Palmeirim et al. (1997) Cell 91:639-648 (chick c-hairy1 oscillation period = 90 min); Lewis (2003) Curr. Biol. 13:1398-1408 period formula" ;
        schema:value "90.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-notch-delta-nearest-neighbour-phase-coherence-r-at-the-determination-front> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Notch-Delta nearest-neighbour phase coherence R at the determination front = 0.8377 coherence <cos(d_phi)>" ;
        dct:description "saltatory-arrest index 0.866 coupled vs 0.436 ablated; resolvable somite cohorts 15 vs 39 fragments (mean block 127 um vs 47 um)" ;
        schema:measurementTechnique "Kuramoto-type nearest-neighbour coherence of Her1 transcript peak phases (eps_N = 0.8, T_N = 90 min); Notch-ablated control eps_N = 0 gives R = 0.0309" ;
        schema:name "Notch-Delta nearest-neighbour phase coherence R at the determination front" ;
        schema:unitText "coherence <cos(d_phi)>" ;
        schema:value "0.8377" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-notch-delta-nearest-neighbour-phase-coherence-r-at-the-determination-front-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-notch-delta-nearest-neighbour-phase-coherence-r-at-the-determination-front-reference> a schema:PropertyValue ;
        dct:source "Lewis (2003) Curr. Biol. 13:1398-1408 Fig. 4 (Notch signalling keeps oscillations in adjacent cells synchronized); Jiang et al. (2000) Nature 408:475-479" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-ra-fgf8-wnt-saddle-node-bistable-hysteresis-window-width-delta-m-m-2-m-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "RA-FGF8/Wnt saddle-node bistable hysteresis window width Delta_M = M_2 - M_1 = 2.2784 nM" ;
        dct:description "ratio M_2/M_1 = 3.222; plateau kinetic residual = 0.000000" ;
        schema:measurementTechnique "analytical inverse hysteresis S-curve M(F) saddle-node extrema (M_1=1.0254 nM at F_1=0.2524 nM, M_2=3.3038 nM at F_2=0.0384 nM; CYP26-null monostable control Delta_M=0.00 nM)" ;
        schema:name "RA-FGF8/Wnt saddle-node bistable hysteresis window width Delta_M = M_2 - M_1" ;
        schema:unitText "nM" ;
        schema:value "2.2784" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-ra-fgf8-wnt-saddle-node-bistable-hysteresis-window-width-delta-m-m-2-m-1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-ra-fgf8-wnt-saddle-node-bistable-hysteresis-window-width-delta-m-m-2-m-1-reference> a schema:PropertyValue ;
        dct:source "Goldbeter, Gonze & Pourquie (2007) Dev. Cell / Dev. Dyn. 236:1495-1508 Figs. 2-3 (bistable hysteresis window between M_1 and M_2)" ;
        schema:value "2.2784" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vermot-pourquie-2005-left-right-somite-count-difference-n-lr-across-4-regimes> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Vermot & Pourquie (2005) left-right somite-count difference N_LR across 4 regimes = 0.9986 somites" ;
        dct:description "b_LR = 0.727 is the single free parameter of the left-right module, calibrated on the unbuffered (VAD) one-somite lag; the wild-type symmetry N_LR = 0.0422 (observed 0.0 +/- 0.2) is a prediction of the buffering law" ;
        schema:measurementTechnique "N_LR = Delta_x_LR / S_0 for VAD/disulfiram chick (left-delayed); 4-regime mean absolute error 0.0116 somites, delayed side correct in 4/4 regimes (wild type 0.0422, situs-inversus chick -0.9986, Raldh2-/- mouse -0.9986)" ;
        schema:name "Vermot & Pourquie (2005) left-right somite-count difference N_LR across 4 regimes" ;
        schema:unitText "somites" ;
        schema:value "0.9986" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vermot-pourquie-2005-left-right-somite-count-difference-n-lr-across-4-regimes-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vermot-pourquie-2005-left-right-somite-count-difference-n-lr-across-4-regimes-reference> a schema:PropertyValue ;
        dct:source "Vermot & Pourquie (2005) Nature 435:215-220 (chick, left delay ~1 somite, reversed by situs reversal); Vermot et al. (2005) Science 308:563-566 (mouse Raldh2-/-, right delay)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-measurement-vitamin-a-deficiency-vad-anterior-wavefront-shift-compressed-somite-length-s-vad> a schema:PropertyValue,

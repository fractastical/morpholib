sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis, gated by a Lewis (2003) delayed Her1/Hes7 clock lattice on 2D bilateral paraxial mesoderm strips — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Module docstring (L1-103) enumerates Governing Laws 1-5 with the Lean theorem names and the 9 references; Sections 3b-3d carry per-function docstrings citing Lewis (2003) equations and figures and Vermot & Pourquié (2005); `morphoeval/math_kg_loops/baker-fgf-wnt-bistable-wavefront.yaml` registers 6 equations with refreshed code loci and Lean loci (L1-205). Deduction: Panel B is rendered on a 1500 um domain while the measurements use the 1000 um default (L1610-1616), a disclosed but non-obvious split." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2012-baker-fgf-wnt-bistable-wavefront.py L1610–L1616: Panel B uses L_psm_um = 1500 to avoid clipping the VAD front; measurements keep the 1000 um default <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L1610-L1616>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-code-traceability-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L1–L103" ;
        dcterms:description "Module docstring: references 1-9, Governing Laws 1-5 with Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L1-L103> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/baker-fgf-wnt-bistable-wavefront.yaml L1–L205" ;
        dcterms:description "Math KG loop spec: 6 equations, Lean declarations, refreshed code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/baker-fgf-wnt-bistable-wavefront.yaml#L1-L205> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis, gated by a Lewis (2003) delayed Her1/Hes7 clock lattice on 2D bilateral paraxial mesoderm strips — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic (`seed=2012`) 7-section `--self-test` (`run_self_test`, L2028-2155): 4 dataset digests, saddle-node thresholds, CYP26-null ablation, 22x sharpening, bitwise two-run determinism, VAD + RA symmetry, constitutive-FGF control, clock period within 15% of the Lewis formula and 10% of 90 min, zero forced arrests, competence window >= 1 segment, Notch ablation coherence and saltatory-index drops, anti-phase at T_N = 45 min, 2D bilateral WT < 0.15 and VAD ~ 1.0 somite, situs sign flip, 4/4 regimes, monotone buffering sweep, >= 11 measurements. Default render (3x3 PNG + GIF) completes in ~6 s. Deduction: no pinned requirements file for the exact numpy/scipy versions in `checkpoint.environment`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-repro-package-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L2028–L2155" ;
        dcterms:description "7-section deterministic self-test incl. Pass 3 clock, Notch ablation, 2D bilateral and LR-regime assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L2028-L2155> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/fgf_wnt_bistable_wavefront_growth.gif (generated output)" ;
        dcterms:description "Animated GIF with bilateral WT/VAD left-right ribbons (VAD left lags by one somite) — docs/media/fgf_wnt_bistable_wavefront_growth.gif: rendered output of 2012-baker-fgf-wnt-bistable-wavefront.py at d58a084, image/gif, 623469 B, 940×600 px, 13 frames, artifact_sha256 2278580ac2349f32cd17b81ce5d1b5ae798402f95b8b25f7da4093f5a3df1da5 (sha256 2278580ac2349f32cd17b81ce5d1b5ae798402f95b8b25f7da4093f5a3df1da5), spec_fingerprint 8dd375129916874341f9ce3cd615881707510415d2e6ec1d5f2914264a78a000" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


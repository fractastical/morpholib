    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "datasets/fgf_wnt_bistable_wavefront/fgf_wnt_clock_lr_reference.json L1–L181" ;
        dcterms:description "bilateral_geometry derived from the specimen's two somite-row pixel offsets; LR regimes carry observed sides and somite lags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/fgf_wnt_bistable_wavefront/fgf_wnt_clock_lr_reference.json#L1-L181> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/fgf_wnt_bistable_wavefront_comparison.png (generated output)" ;
        dcterms:description "3x3 synthesis figure: Panels E-F specimen segmentation and waveform fit; Panel H 2D bilateral VAD front offset; visually confirmed — docs/media/fgf_wnt_bistable_wavefront_comparison.png: rendered output of 2012-baker-fgf-wnt-bistable-wavefront.py at d58a084, image/png, 1793783 B, 2352×2016 px, artifact_sha256 ce04ae4bd568fab038e1731acc826d8aade9d36fef83013221614779e63441e8 (sha256 ce04ae4bd568fab038e1731acc826d8aade9d36fef83013221614779e63441e8), spec_fingerprint 8dd375129916874341f9ce3cd615881707510415d2e6ec1d5f2914264a78a000" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L1909–L2025" ;
        dcterms:description "GIF with WT left/right and VAD left/right ribbons; the VAD left ribbon lags by the 2D offset" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L1909-L2025> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis, gated by a Lewis (2003) delayed Her1/Hes7 clock lattice on 2D bilateral paraxial mesoderm strips — Morphological realism / specimen match: 89/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 4.0 dorsal avian/vertebrate embryo SEM and segments both bilateral paraxial somite rows (`segment_chick_ra_fgf_specimen`, L1299-1372; 8 upper / 9 lower somites, bilateral mean spacing 48.47 px, CV 0.20, Panels E-F). Pass 3 now uses the specimen's two somite-row pixel offsets to set the 2D strip / neural-tube geometry (`bilateral_geometry` in `fgf_wnt_clock_lr_reference.json`) and the wild-type 2D prediction (0.04-somite left-right offset) is consistent with the bilaterally synchronous rows seen in the specimen; the GIF now shows left/right ribbons. The specimen still carries no scale bar, no genotype and no clock readout, so the delayed-clock and VAD predictions are compared only to literature values, not to this image (+1 only)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-specimen-match-4> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

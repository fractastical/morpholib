sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-baker-fgf-wnt-bistable-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L191–L296" ;
        dcterms:description "CYP26A1 Hill induction C(F), quasi-steady RA nullcline R*(F) and analytical inverse hysteresis S-curve M(F) with saddle-node extraction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L191-L296> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L297–L435" ;
        dcterms:description "1D coupled RA-FGF8/Wnt reaction-diffusion PDE solver, branch-switch front and 10-90% sharpening" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L297-L435> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L436–L524" ;
        dcterms:description "Lewis (2003) published parameters, period formula 2(T + 1/b + 1/c), sustained-oscillation conditions and Goldbeter Fig. 10 competence window [x(M_2), x(M_1)]" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L436-L524> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L526–L816" ;
        dcterms:description "Delayed Her1/Hes7 DDE lattice with delayed saturating Notch-Delta coupling, advection through the competence window, protein-peak-gated bistable arrest, cohort detection, synchrony and saltatory index" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L526-L816> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2012-baker-fgf-wnt-bistable-wavefront.py L819–L1030" ;
        dcterms:description "RA-buffered lateralizing bias b_eff and 2D bilateral strips + neural tube reaction-diffusion solver with left/right branch-switch fronts and analytic offset law" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L819-L1030> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_025_fgf_wnt_bistable_wavefront.lean L24–L105" ;
        dcterms:description "Laws 1-3 (CYP26 steady balance, hysteresis window positivity, opposing VAD/RA symmetry) carried from v2, 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_025_fgf_wnt_bistable_wavefront.lean#L24-L105> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-7> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_025_fgf_wnt_bistable_wavefront.lean L107–L187" ;
        dcterms:description "New Laws 4-6: lewis_2003_delayed_oscillator_period, goldbeter_2007_saltatory_cohort_additivity, vermot_2005_ra_buffered_lr_symmetry (verified with lean 4.35.0, 0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_025_fgf_wnt_bistable_wavefront.lean#L107-L187> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Goldbeter, Gonze & Pourquié (2007) / Baker, Schnell & Maini (2006) RA–FGF8/Wnt mutual cross-inhibition bistable determination wavefront in vertebrate somitogenesis, gated by a Lewis (2003) delayed Her1/Hes7 clock lattice on 2D bilateral paraxial mesoderm strips — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Keeps the faithful Goldbeter, Gonze & Pourquié (2007) cross-inhibition + CYP26A1 PDE system and hysteresis S-curve (L191-296, L297-435) and adds the two mechanisms the v2 audit asked for with the papers' own equations: Lewis (2003) Eqs. 1-3 delayed autoinhibition DDE per PSM cell with published rate constants, delayed saturating Notch-Delta input and Lewis's own random gene-release initial condition (L526-816; T_osc = 92.0 min vs 90 observed; in-phase at T_N = T_osc, anti-phase at T_osc/2 as in Lewis Fig. 4C-D), and the 2D bilateral reaction-diffusion extension with the Vermot & Pourquié RA-buffering law (L819-1030; VAD offset matches the analytic law to < 1 um). Score moves 94 -> 93 because the coupling exposed a structural defect: clock-gated arrest yields irregular cohorts (segment-length CV 0.69, L799, vs ~0.05 in chick) and the 2D WT front sits at 509 um vs 571 um in 1D because the neural-tube factor (L866, L903) perturbs the strips transversely; the DeltaC branch is a reduced readout (L452-453, L636). 6 Lean 4 theorems (0 sorrys) cover Laws 1-6." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-baker-fgf-wnt-bistable-wavefront.py L799–L802: segment_length_cv = 0.69 and saltatory_index are reported honestly; the CV exposes irregular cohort sizes (new remediation item) <https://github.com/fractastical/morpholib/blob/d58a084/2012-baker-fgf-wnt-bistable-wavefront.py#L799-L802>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-baker-fgf-wnt-bistable-wavefront-model-fidelity-7> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


        pk:assessedBy <https://w3id.org/delphi/resource/model/muse-wonder-1.0-high> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-murray-bos-taurus-turing-wavelength-repro-package-1> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-murray-bos-taurus-turing-wavelength-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "datasets/bos_taurus_turing_wavelength/README.md L7–L21" ;
        dct:description "claim, verdict and claim boundaries as published" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2e5574cb673de7d817650ef02de8f6b9e9e9394f/datasets/bos_taurus_turing_wavelength/README.md#L7-L21> .
    <https://w3id.org/delphi/resource/model/muse-wonder-1.0-high> a pk:Model ;
        rdfs:label "Muse Wonder 1.0 (builder-assessor)" ;
        dct:identifier "muse-wonder-1.0-high" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


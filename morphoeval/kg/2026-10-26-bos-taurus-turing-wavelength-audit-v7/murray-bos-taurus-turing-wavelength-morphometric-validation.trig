sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-murray-bos-taurus-turing-wavelength> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-murray-bos-taurus-turing-wavelength-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-murray-bos-taurus-turing-wavelength-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Turing RD claim for Holstein coat spotting (tested negative hypothesis) — Morphometric validation: 85/100" ;
        dct:date "2026-10-26"^^xsd:date ;
        dct:description "Coat-domain, scale-matched, aspect-corrected morphometrics with paired significance testing and bootstrap CIs; the pipeline now overturns the builder's own earlier conclusion, which is what validation is for. Remaining: coat segmentation is saturation-heuristic (fails where coloured background is achromatic), n=9 held-out specimens limits power, Eden founder density was still selected on cow 01." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/muse-wonder-1.0-high> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-murray-bos-taurus-turing-wavelength-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-murray-bos-taurus-turing-wavelength-morphometric-validation-2> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-murray-bos-taurus-turing-wavelength-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/1981-murray-bos-taurus-turing-wavelength.py L442–L512" ;
        dct:description "coat_segment + scale_pattern" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2e5574cb673de7d817650ef02de8f6b9e9e9394f/models/1981-murray-bos-taurus-turing-wavelength.py#L442-L512> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-murray-bos-taurus-turing-wavelength-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/1981-murray-bos-taurus-turing-wavelength.py L513–L560" ;
        dct:description "multi_specimen_comparison with paired Wilcoxon + bootstrap CI" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2e5574cb673de7d817650ef02de8f6b9e9e9394f/models/1981-murray-bos-taurus-turing-wavelength.py#L513-L560> .
    <https://w3id.org/delphi/resource/model/muse-wonder-1.0-high> a pk:Model ;
        rdfs:label "Muse Wonder 1.0 (builder-assessor)" ;
        dct:identifier "muse-wonder-1.0-high" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


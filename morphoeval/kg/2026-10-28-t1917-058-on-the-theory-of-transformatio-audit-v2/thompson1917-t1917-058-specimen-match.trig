sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-058> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Morphological realism / specimen match: 66/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "The warped Fig. 404 is visually Thompson's Fig. 406 (panel c), the segmented real silhouettes (panel k) show the dog's forward taper and the apes' larger facial share exactly as pp. 770-773 describe, and the landmark test against the real chimpanzee now carries a confidence interval that excludes zero and beats a label-shuffled null. Deductions: still n = 1 per taxon; the human reference is a rendered model (its effect is bounded - all orderings also hold against the Fig. 404 drawing - but a real human photograph was not obtained, R5 only partly done); the drawn human sits d_P = 0.21 from the model, reported but not removed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-058/scout_manifest.json L60–L80: homo_sapiens_lateral.jpg is a rendered anatomical model, not a museum photograph <https://github.com/fractastical/morpholib/blob/a5007b9c0/datasets/thompson_1917/t1917-058/scout_manifest.json#L60-L80>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-2> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_058_on_the_theory_of_transformatio_comparison.png (generated output)" ;
        dct:description "panels c, e-h, k: warped drawing, landmarked specimens, Procrustes overlay, bootstrap/null, segmented height profiles — docs/media/t1917_058_on_the_theory_of_transformatio_comparison.png: rendered output of thompson/claims/t1917-058_on-the-theory-of-transformations.py at a5007b9c0, image/png, 1145183 B, 1980×1650 px, artifact_sha256 93e8738afc53ea10e6742bc17e942de3a97ea0aa9b2ca037fe925ac628a97934 (sha256 93e8738afc53ea10e6742bc17e942de3a97ea0aa9b2ca037fe925ac628a97934), spec_fingerprint 974f3b1907dd69da0acb085b9f36dedce4c4532b025e0bf27519cd77a4567dc9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "datasets/thompson_1917/t1917-058/t1917_058_metrics.json (generated output)" ;
        dct:description "pass2.segmentation.summary: dog taper 0.88 lowest; face fraction H<C<B; pass2.robustness_human_reference all true — datasets/thompson_1917/t1917-058/t1917_058_metrics.json: rendered output of thompson/claims/t1917-058_on-the-theory-of-transformations.py at a5007b9c0, application/json, 49339 B, artifact_sha256 e96b962e952b3dbd3098ff99539074900d47c0f048b6b616b11c74631e90b09c (sha256 e96b962e952b3dbd3098ff99539074900d47c0f048b6b616b11c74631e90b09c), spec_fingerprint 974f3b1907dd69da0acb085b9f36dedce4c4532b025e0bf27519cd77a4567dc9" .
    <https://w3id.org/delphi/resource/model/claude-fable-5.1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending)" ;
        dct:identifier "claude-fable-5.1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,

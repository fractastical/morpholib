sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-058> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Reproducibility package: 74/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Deterministic (seed 1917 for bootstrap and permutation; self-test asserts bit-identical bootstrap means across two runs), self-test 2.7 s, full run 7.5 s, documented CLI (--self-test, --no-gif, --lam, --k), outputs at documented paths, metrics and result JSON regenerated each run. Deductions: dependencies not pinned per script; Lean needs an elan toolchain; checkpoint is a feature-branch commit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-repro-package-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py L1148–L1211" ;
        dct:description "self_test incl. Pass 2 determinism and sanity checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a5007b9c0/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L1148-L1211> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py L1261–L1340" ;
        dct:description "main(): CLI, metrics, result.json, figure, GIF" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a5007b9c0/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L1261-L1340> .
    <https://w3id.org/delphi/resource/model/claude-fable-5.1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending)" ;
        dct:identifier "claude-fable-5.1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/j.1525-142X.2005.05027.x>,
            <https://doi.org/10.5061/dryad.7r85116> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form, Ch. XVII On the Theory of Transformations, pp. 770-773, Figs. 404-408" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/j.1525-142X.2005.05027.x> dct:date "2005"^^xsd:gYear ;
        dct:title "Heterochrony and geometric morphometrics: a comparison of cranial growth in Pan paniscus versus Pan troglodytes" .
    <https://doi.org/10.5061/dryad.7r85116> dct:date "2018"^^xsd:gYear ;
        dct:title "Data from: Multiple factors behind early diversification of skull morphology in the continental radiation of New World monkeys" .
}


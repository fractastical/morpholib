<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-source-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Source and data traceability: 85/100" ;
    dct:date "2026-10-28"^^xsd:date ;
    dct:description "Unchanged: all 13 vendored files SHA-256 pinned and re-verified at runtime, Commons author/licence/SHA1, IA leaf rule, DOIs, and the explicit DATASET_MISMATCH record for the pre-scouted Dryad set. Deduction unchanged: the Dryad archive bytes could not be fetched (bearer token / Anubis), only its metadata is pinned." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
    pk:assessmentType "morphoeval/0.1.0/source-traceability" ;

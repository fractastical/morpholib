<https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Morphological realism / specimen match: 66/100" ;
    dct:date "2026-10-28"^^xsd:date ;
    dct:description "The warped Fig. 404 is visually Thompson's Fig. 406 (panel c), the segmented real silhouettes (panel k) show the dog's forward taper and the apes' larger facial share exactly as pp. 770-773 describe, and the landmark test against the real chimpanzee now carries a confidence interval that excludes zero and beats a label-shuffled null. Deductions: still n = 1 per taxon; the human reference is a rendered model (its effect is bounded - all orderings also hold against the Fig. 404 drawing - but a real human photograph was not obtained, R5 only partly done); the drawn human sits d_P = 0.21 from the model, reported but not removed." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:evidenceAgainst "datasets/thompson_1917/t1917-058/scout_manifest.json L60–L80: homo_sapiens_lateral.jpg is a rendered anatomical model, not a museum photograph <https://github.com/fractastical/morpholib/blob/a5007b9c0/datasets/thompson_1917/t1917-058/scout_manifest.json#L60-L80>" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-specimen-match-2> ;
    pk:hasScore 6.6e-01 ;
    pk:hasVerdict "mostly faithful" .


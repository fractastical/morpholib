        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-058> a pk:Claim ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) faithfully reproduces Homo sapiens, Pan troglodytes, Papio ursinus, Canis lupus familiaris (lateral skull) morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-058_on-the-theory-of-transformations.py implement the cited source model as published and produce forms that match real Homo sapiens, Pan troglodytes, Papio ursinus, Canis lupus familiaris (lateral skull) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-058_on-the-theory-of-transformations.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-058_on-the-theory-of-transformations.py; output: docs/media/t1917_058_on_the_theory_of_transformatio_comparison.png; organism: Homo sapiens, Pan troglodytes, Papio ursinus, Canis lupus familiaris (lateral skull); environment: n/a; claim_boundary: [reported_in_source: Thompson (1917) pp. 770-773: the human skull drawn in a 5x4 Cartesian net (Fig. 404) and the chimpanzee, baboon and dog skulls drawn in deformed nets (Figs. 405-408); prose statements that the deformation is one 'harmonious and congruent transformation', that cell areas increase 'in approximately logarithmic order' from above downwards and behind forwards, that the baboon differs 'only in an increased intensity', that the chimpanzee is 'much nearer the human type than the baboon', and that the dog's net 'tapers away in front' on 'different lines'.; reconstructed_in_script: The Fig. 405 net digitised and reconstructed as a thin-plate spline T in human grid units (E1-E3); cell-area log-linear regression (E4); 11 homologous landmarks digitised by the loop agent on Fig. 404, Fig. 406 and four Commons specimens; full-Procrustes explained fraction of T(H) toward the real chimpanzee (E6) with jitter bootstrap, label-permutation null, r / RMSE / KS / Wilcoxon; lambda and k sweeps with k* scan; mirrored-net and wrong-target controls; silhouette segmentation taper index and face fraction; facial index and facial angle (E7).; transfer_boundary: One specimen per taxon (museum photographs for chimpanzee, baboon, dog; a rendered anatomical model for the human, whose influence is bounded by the Fig. 404-reference robustness check); the baboon and dog nets of Figs. 407-408 were not digitised, so C2/C5 are tested on real specimens (and, for C2, on the k* scan along the chimpanzee ray), not on Thompson's drawings of them.; does_not_claim: Nothing about growth, ontogeny or phylogeny; no claim that Thompson's curves are the optimal smooth map (a lambda-smoothed net does slightly better, E 0.38 vs 0.35); no claim that the baboon lies on exactly the chimpanzee ray - C2 is reported as mixed; the verdict is for these four specimens and would need a population sample to generalise.]; other sources: On Growth and Form, Ch. XVII On the Theory of Transformations, pp. 770-773, Figs. 404-408 <https://archive.org/details/ongrowthform1917thom>; phenomenon_size: 1.3 cm (0.01254 m, log10=-1.902 m, tier=7_organism_cm); species_scale_ladder (1 runs from 1.3 cm to 1.3 cm): 1.3 cm:epithelioid-cyst-buckling" ;
        pk:derivedFromPaper <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/j.1525-142X.2005.05027.x>,
            <https://doi.org/10.5061/dryad.7r85116> .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-058_on-the-theory-of-transformations.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://archive.org/details/ongrowthform1917thom>,
            <https://doi.org/10.1109/34.24792>,
            <https://doi.org/10.1111/j.1525-142X.2005.05027.x>,
            <https://doi.org/10.5061/dryad.7r85116> .
    <https://archive.org/details/ongrowthform1917thom> dct:date "1917"^^xsd:gYear ;
        dct:title "On Growth and Form, Ch. XVII On the Theory of Transformations, pp. 770-773, Figs. 404-408" .
    <https://doi.org/10.1109/34.24792> dct:date "1989"^^xsd:gYear ;
        dct:title "Principal warps: thin-plate splines and the decomposition of deformations" .
    <https://doi.org/10.1111/j.1525-142X.2005.05027.x> dct:date "2005"^^xsd:gYear ;
        dct:title "Heterochrony and geometric morphometrics: a comparison of cranial growth in Pan paniscus versus Pan troglodytes" .
    <https://doi.org/10.5061/dryad.7r85116> dct:date "2018"^^xsd:gYear ;
        dct:title "Data from: Multiple factors behind early diversification of skull morphology in the continental radiation of New World monkeys" .
}


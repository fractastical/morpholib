sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-058> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-model-fidelity> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Model fidelity to source: 74/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Unchanged core (Thompson's own Fig. 405 net as an exact-interpolation TPS, affine + bending decomposition, Lean-checked laws) plus the lambda sweep that now demonstrates the affine limit numerically (bending 2.10 -> 0.49 at lambda 10 with the affine-only end point at -0.12). The k* scan recovers Thompson's \"increased intensity\" ordering (0.85 < 1.15 < 1.30) from the real specimens. Remaining deduction: Figs. 407-408 nets still not digitised, so the baboon and dog transformations Thompson actually drew are not reconstructed." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "datasets/thompson_1917/t1917-058/scout_manifest.json L1–L40: Fig. 407/408 nets not digitised <https://github.com/fractastical/morpholib/blob/a5007b9c0/datasets/thompson_1917/t1917-058/scout_manifest.json#L1-L40>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-3> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py L200–L237" ;
        dcterms:description "tps_fit / tps_eval / affine_fit: E1-E3" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a5007b9c0/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L200-L237> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "thompson/claims/t1917-058_on-the-theory-of-transformations.py L455–L500" ;
        dcterms:description "parameter_sweep: lambda rows, k rows, fine k* scan for the three real targets" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a5007b9c0/thompson/claims/t1917-058_on-the-theory-of-transformations.py#L455-L500> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Thompson1917_T1917_058.lean L153–L211" ;
        dcterms:description "intensity_family: T_k displacement linear in k, area ratio monotone - the law the k* scan instantiates" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/a5007b9c0/morphoeval/lean/loops/Thompson1917_T1917_058.lean#L153-L211> .

    <https://w3id.org/delphi/resource/model/claude-fable-5.1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (builder-assessor, single-agent Pass 2; second assessor pending)" ;
        dcterms:identifier "claude-fable-5.1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 .
}


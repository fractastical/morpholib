    <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/t1917_058_on_the_theory_of_transformatio_growth.gif (generated output)" ;
        dcterms:description "k morph — docs/media/t1917_058_on_the_theory_of_transformatio_growth.gif: rendered output of thompson/claims/t1917-058_on-the-theory-of-transformations.py at a5007b9c0, image/gif, 1179678 B, 480×340 px, 19 frames, artifact_sha256 0f3e8a28771947c1d4d5bb2e0588d7f12173fc967eb74aaef2bae069037558ee (sha256 0f3e8a28771947c1d4d5bb2e0588d7f12173fc967eb74aaef2bae069037558ee), spec_fingerprint 974f3b1907dd69da0acb085b9f36dedce4c4532b025e0bf27519cd77a4567dc9" .

    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-058-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) Cartesian transformation of the human skull into chimpanzee, baboon and dog (Figs. 404-408) — Parameter expressivity: 72/100" ;
        dcterms:date "2026-10-28"^^xsd:date ;
        dcterms:description "Both morphospace parameters are now swept and their effects shown: k drives the predicted facial angle monotonically 89 -> 68 -> 55 -> 47 -> 43 -> 39 deg for k = 0 .. 2.5 and the explained fraction through a clear maximum (k* 0.85 for the chimpanzee); lambda drives bending monotonically to the affine limit. The GIF animates k = 0 -> 1 -> 2. Deduction: no third parameter (e.g. anisotropic intensity for face vs vault) is exposed, and the k and lambda effects are reported on the point estimate only, not under the jitter bootstrap." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5.1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-thompson1917-t1917-058-parameter-expressivity-3> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5.1> a pk:Model ;

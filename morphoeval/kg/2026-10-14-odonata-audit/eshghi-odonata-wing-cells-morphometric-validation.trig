            pk:EvidenceItem ;
        rdfs:label "cell count ∝ wing length^b, fossil = 1.7811 exponent" ;
        dct:description "r = 0.739" ;
        schema:measurementTechnique "OLS slope of log10 cell count on log10 wing length, n=69 wings (Eshghi et al. 2026 tables)" ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Morphometric validation: 85/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "This is the script's strength. Cell count, median / mean / maximum cell length, cell area and circularity are re-measured on all 69 fossil drawings and compared wing by wing with the published Table S1 (median |ΔN|/N 0.0 %, median cell length 3.4 %, largest cell 0.9 %); extant counts are cross-checked against Hoffmann et al.'s independent segmentation of 42 shared species (median 3.1 %, r 0.992); disagreements are printed, not hidden (#7 drawing vs table row; #23/#24 swapped). The scale of each drawing is read from its own bar. Short of full marks because 4 of 69 drawings fall back to the tabulated wing length for calibration and the +3 % length bias is explained but not corrected." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-median-n-n-vs-table-s1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-wing-length-b-extant-damselfly>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-wing-length-b-extant-dragonfly>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-wing-length-b-fossil>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-fossil-drawings-re-segmented>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-fossil-median-cell-length-re-segmented>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-largest-cell-length-median-vs-table-s1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-median-cell-length-median-vs-table-s1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-median-cell-length-over-wings-extant-damselfly>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-median-cell-length-over-wings-extant-dragonfly>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-median-cell-length-over-wings-fossil>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-median-cell-length-wing-length-b-extant-damselfly>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-median-cell-length-wing-length-b-extant-dragonfly>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-median-cell-length-wing-length-b-fossil>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-scale-bar-label-read-from-the-drawing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-morphometric-validation-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-morphometric-validation-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-morphometric-validation-5> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-median-n-n-vs-table-s1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cell count, median |ΔN|/N vs Table S1 = 0.0 ratio" ;
        dct:description "90% of wings within 2%; max 194% (#7, drawing and table row disagree)" ;
        schema:measurementTechnique "per-wing relative difference between the script's cell count and the published count, median over 69 wings" ;
        schema:name "cell count, median |ΔN|/N vs Table S1" ;
        schema:unitText "ratio" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-median-n-n-vs-table-s1-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-median-n-n-vs-table-s1-reference> a schema:PropertyValue ;

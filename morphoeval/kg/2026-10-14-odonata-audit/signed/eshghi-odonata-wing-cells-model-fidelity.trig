            <https://doi.org/10.5281/zenodo.19899648> .

    <https://doi.org/10.1073/pnas.1721248115> dcterms:date "2018"^^xsd:gYear ;
        dcterms:title "A simple developmental model recapitulates complex insect wing venation patterns" .

    <https://doi.org/10.5281/zenodo.19899648> dcterms:date "2026"^^xsd:gYear ;
        dcterms:title "Critical Crack Length as an Evolutionary Constant in Odonata Wing Venation: Lessons from Fossils — Supplementary Material" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Model fidelity to source: 70/100" ;
        rdfs:comment "The prediction under test is stated and operationalised exactly as it follows from the source model (constant cell size -> N ∝ L², median cell ∝ L⁰) and the measured quantity is the one Hoffmann et al. and Eshghi et al. both use (vein-bounded cell, length = maximum Feret diameter, verified by per-wing agreement with Table S1). The model itself is not run here (that is 2018-hoffmann-wing-venation.py), and log-log OLS is the script's own choice of test, not the source's. Evidence: 2026-eshghi-odonata-wing-cells.py L36–L43: prediction derived from the source model <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L36-L43>; 2026-eshghi-odonata-wing-cells.py L137–L142: ols_loglog(): the test <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L137-L142>; 2026-eshghi-odonata-wing-cells.py L404–L413: cell_table(): cell length = max Feret diameter <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L404-L413>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-model-fidelity> ;
        pk:hasProbability "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-model-fidelity> rdfs:label "Odonata wing cells through deep time (2026-eshghi-odonata-wing-cells.py) satisfies the MorphoEval 0.1.0 criterion 'Model fidelity to source' for Odonata (fossil Late Jurassic–Eocene; extant Anisoptera and Zygoptera)" ;
        dcterms:identifier "morphoeval/0.1.0/model-fidelity" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}


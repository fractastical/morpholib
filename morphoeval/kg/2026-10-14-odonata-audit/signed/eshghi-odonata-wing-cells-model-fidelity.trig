sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Model fidelity to source: 70/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "The prediction under test is stated and operationalised exactly as it follows from the source model (constant cell size -> N ∝ L², median cell ∝ L⁰) and the measured quantity is the one Hoffmann et al. and Eshghi et al. both use (vein-bounded cell, length = maximum Feret diameter, verified by per-wing agreement with Table S1). The model itself is not run here (that is 2018-hoffmann-wing-venation.py), and log-log OLS is the script's own choice of test, not the source's." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity-2> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity-0> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L36–L43" ;
        dcterms:description "prediction derived from the source model" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L36-L43> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L137–L142" ;
        dcterms:description "ols_loglog(): the test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L137-L142> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L404–L413" ;
        dcterms:description "cell_table(): cell length = max Feret diameter" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L404-L413> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


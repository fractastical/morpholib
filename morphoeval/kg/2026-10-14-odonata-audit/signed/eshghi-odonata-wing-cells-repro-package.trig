sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Reproducibility package: 70/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "Deterministic, invocation documented with a no-download mode, inputs cached, resumed and hash-verified, every derived number written to CSV. Dependencies are lower-bound pins only and scikit-image, which the re-segmentation needs, is not in requirements.txt; the full run needs ~100 MB of downloads." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package-3> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package-0> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L45–L54" ;
        dcterms:description "documented invocation and outputs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L45-L54> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L193–L227" ;
        dcterms:description "fetch(): resumable, hash-checked" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L193-L227> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L80–L85" ;

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-output-odonata-fossil-resegmentation-png> a prov:Entity,
            schema:ImageObject,
            pk:EvidenceItem ;
        rdfs:label "odonata_fossil_resegmentation.png" ;
        dcterms:description "rendered output of 2026-eshghi-odonata-wing-cells.py at fbbcaf6; sha256 pins the exact file that was scored; 1663×1323 px" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py> ;
        schema:contentSize "286190 B" ;
        schema:encodingFormat "image/png" ;

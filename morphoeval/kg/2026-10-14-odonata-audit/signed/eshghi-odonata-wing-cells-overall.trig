        schema:sha256 "ab6f3b9f89fbcff0ff1fa942915cfcb3736ebde60723489a9ee8d7a39c8a5b38" ;
        schema:width 1663 .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — MorphoEval overall 76.0/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "A data comparison rather than a simulation: the one trait the Hoffmann venation model predicts (cell size set by an inhibition length) is compared on 69 fossil and 394 extant wings from Eshghi et al. 2026, with PBDB ages and Hoffmann et al.'s own segmentations as the extant counterpart. The fossil measurements are reproduced independently from the published drawings (cell counts to a median 0.0 %, median cell length to 3.4 %), which also exposes one table row that does not match its drawing and one swapped pair. Finding: median cell length stays at 0.78–0.99 mm across 150 Myr and a 6x range of wing length; the inhibition length is approximately, not strictly, conserved. Overall 76.0/100 (faithfulness 75.7, reproducibility 76.7); rubric morphoeval 0.1.0; checkpoint commit fbbcaf6; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, pandas 2.3.3, scikit-image 0.26.0, matplotlib 3.10.7, Pillow 12.0.0." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add scikit-image to requirements.txt and pin versions for the Python 3.14 environment.",
            "remediation needed: Correct the +3 % mid-line bias by eroding cells by half the measured vein width, or state the authors' convention once their methods text is available.",
            "remediation needed: Read the \"mm\" label with a proper template match so",
            "remediation needed: Report the discrepancies (#7," ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-output-odonata-fossil-resegmentation-png> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7.6e-01 .
}


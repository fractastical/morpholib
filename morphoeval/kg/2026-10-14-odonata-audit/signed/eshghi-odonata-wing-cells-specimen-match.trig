sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Morphological realism / specimen match: 85/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "Every image shown is a real specimen: the fossil venation drawings are rendered at true millimetre scale from their own scale bars and colour-coded by the re-measured cell length, the extant counterpart is Hoffmann et al.'s segmented Arigomphus / Aeshna wings, and the final animation frame places an Eocene and a living aeshnid at the same scale. The script's segmentation of the fossil drawings reproduces the authors' counts to a median 0.0 % (90 % of wings within 2 %). Not full marks because the extant wings are shown only as Hoffmann's domain boundaries, not photographs." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-specimen-match-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-specimen-match-2> ;
        pk:hasVerdict "faithful" ;
        pk:weightOfEvidence 8.5e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-output-odonata-fossil-resegmentation-png> a prov:Entity,
            schema:ImageObject,
            pk:EvidenceItem ;
        rdfs:label "odonata_fossil_resegmentation.png" ;
        dcterms:description "rendered output of 2026-eshghi-odonata-wing-cells.py at fbbcaf6; sha256 pins the exact file that was scored; 1663×1323 px" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py> ;
        schema:contentSize "286190 B" ;
        schema:encodingFormat "image/png" ;
        schema:height 1323 ;
        schema:sha256 "ab6f3b9f89fbcff0ff1fa942915cfcb3736ebde60723489a9ee8d7a39c8a5b38" ;
        schema:width 1663 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-specimen-match-0> a pk:EvidenceItem ;
        rdfs:label "odonata_fossil_resegmentation.png (generated output, not in repo)" ;
        dcterms:description "four re-segmented fossil wings at one scale; scatter vs Table S1" ;
        prov:wasDerivedFrom <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-output-odonata-fossil-resegmentation-png> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L352–L380" ;
        dcterms:description "segment_fossil_cells(): skeletonised veins -> cells" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L352-L380> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L582–L596" ;
        dcterms:description "show_wing_mm(): true-scale rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L582-L596> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


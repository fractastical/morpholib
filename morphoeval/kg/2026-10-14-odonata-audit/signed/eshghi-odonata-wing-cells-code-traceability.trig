sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Code-to-model traceability: 70/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "Each analysis step names the source it follows and the decoding of the drawings is documented where it happens; the cell-length convention (maximum Feret diameter, cells bounded by vein mid-lines) was established by matching the authors' table rather than quoted from their methods text, which the script did not have access to." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-code-traceability-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-code-traceability-2> ;
        pk:hasVerdict "mostly faithful" ;
        pk:weightOfEvidence 7e-01 .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-code-traceability-0> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L27–L35" ;
        dcterms:description "what the re-segmentation does and why" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L27-L35> .

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L353–L364" ;

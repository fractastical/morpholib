    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Morphometric validation: 85/100" ;
        dcterms:date "2026-10-14"^^xsd:date ;
        dcterms:description "This is the script's strength. Cell count, median / mean / maximum cell length, cell area and circularity are re-measured on all 69 fossil drawings and compared wing by wing with the published Table S1 (median |ΔN|/N 0.0 %, median cell length 3.4 %, largest cell 0.9 %); extant counts are cross-checked against Hoffmann et al.'s independent segmentation of 42 shared species (median 3.1 %, r 0.992); disagreements are printed, not hidden (#7 drawing vs table row; #23/#24 swapped). The scale of each drawing is read from its own bar. Short of full marks because 4 of 69 drawings fall back to the tabulated wing length for calibration and the +3 % length bias is explained but not corrected." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-morphometric-m0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-morphometric-m1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-morphometric-m10>,

}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Source and data traceability: 90/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "Both papers carry DOIs, the data archive is a CC BY 4.0 Zenodo DOI, PBDB and GBIF query URLs and the retrieval date are recorded, the derived tables are vendored with a provenance README, and the two downloaded inputs are pinned by SHA-256 and verified on every run." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability-0>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability-3> ;
        pk:hasVerdict "faithful" ;
        pk:weightOfEvidence 9e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability-0> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L12–L25" ;
        dct:description "sources with DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L12-L25> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L94–L101" ;
        dct:description "URLs, byte size and SHA-256 of both downloads" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L94-L101> .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L176–L191" ;

    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/odonata/README.md L1–L20" ;

        <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-code-traceability-3> ;
    pk:hasScore 7e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Odonata wing cells through deep time — Model fidelity to source: 70/100" ;
    dct:date "2026-10-14"^^xsd:date ;
    dct:description "The prediction under test is stated and operationalised exactly as it follows from the source model (constant cell size -> N ∝ L², median cell ∝ L⁰) and the measured quantity is the one Hoffmann et al. and Eshghi et al. both use (vein-bounded cell, length = maximum Feret diameter, verified by per-wing agreement with Table S1). The model itself is not run here (that is 2018-hoffmann-wing-venation.py), and log-log OLS is the script's own choice of test, not the source's." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-2>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-3> ;
    pk:hasScore 7e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Odonata wing cells through deep time — Morphometric validation: 85/100" ;
    dct:date "2026-10-14"^^xsd:date ;
    dct:description "This is the script's strength. Cell count, median / mean / maximum cell length, cell area and circularity are re-measured on all 69 fossil drawings and compared wing by wing with the published Table S1 (median |ΔN|/N 0.0 %, median cell length 3.4 %, largest cell 0.9 %); extant counts are cross-checked against Hoffmann et al.'s independent segmentation of 42 shared species (median 3.1 %, r 0.992); disagreements are printed, not hidden (#7 drawing vs table row; #23/#24 swapped). The scale of each drawing is read from its own bar. Short of full marks because 4 of 69 drawings fall back to the tabulated wing length for calibration and the +3 % length bias is explained but not corrected." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-median-n-n-vs-table-s1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-measurement-cell-count-wing-length-b-extant-damselfly>,

<https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Odonata wing cells through deep time — Code-to-model traceability: 70/100" ;
    dct:date "2026-10-14"^^xsd:date ;
    dct:description "Each analysis step names the source it follows and the decoding of the drawings is documented where it happens; the cell-length convention (maximum Feret diameter, cells bounded by vein mid-lines) was established by matching the authors' table rather than quoted from their methods text, which the script did not have access to." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-code-traceability-1>,

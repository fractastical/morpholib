sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Code-to-model traceability: 70/100" ;
        rdfs:comment "Each analysis step names the source it follows and the decoding of the drawings is documented where it happens; the cell-length convention (maximum Feret diameter, cells bounded by vein mid-lines) was established by matching the authors' table rather than quoted from their methods text, which the script did not have access to. Evidence: 2026-eshghi-odonata-wing-cells.py L27–L35: what the re-segmentation does and why <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L27-L35>; 2026-eshghi-odonata-wing-cells.py L353–L364: docstring: mid-line convention and its effect <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L353-L364>; 2026-eshghi-odonata-wing-cells.py L383–L392: infer_scale(): calibration rules stated <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L383-L392>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-code-traceability> ;
        pk:hasProbability "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-code-traceability> rdfs:label "Odonata wing cells through deep time (2026-eshghi-odonata-wing-cells.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Odonata (fossil Late Jurassic–Eocene; extant Anisoptera and Zygoptera)" ;
        dct:identifier "morphoeval/0.1.0/code-traceability" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115>,
            <https://doi.org/10.5281/zenodo.19899648> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
    <https://doi.org/10.5281/zenodo.19899648> dct:date "2026"^^xsd:gYear ;
        dct:title "Critical Crack Length as an Evolutionary Constant in Odonata Wing Venation: Lessons from Fossils — Supplementary Material" .
}


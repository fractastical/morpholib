sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Parameter expressivity: 50/100" ;
        rdfs:comment "No generative parameters: the script analyses measured wings. The groups (fossil / dragonfly / damselfly) and the fitted exponents are outputs, not controls. Neutral score, not applicable. Evidence: 2026-eshghi-odonata-wing-cells.py L144–L173: report(): fits per group, nothing is tuned <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L144-L173>." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-parameter-expressivity> ;
        pk:hasProbability "0.5"^^xsd:double ;
        pk:hasVerdict "not applicable (neutral baseline)" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-eshghi-odonata-wing-cells-parameter-expressivity> rdfs:label "Odonata wing cells through deep time (2026-eshghi-odonata-wing-cells.py) satisfies the MorphoEval 0.1.0 criterion 'Parameter expressivity' for Odonata (fossil Late Jurassic–Eocene; extant Anisoptera and Zygoptera)" ;
        dct:identifier "morphoeval/0.1.0/parameter-expressivity" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115>,
            <https://doi.org/10.5281/zenodo.19899648> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
    <https://doi.org/10.5281/zenodo.19899648> dct:date "2026"^^xsd:gYear ;
        dct:title "Critical Crack Length as an Evolutionary Constant in Odonata Wing Venation: Lessons from Fossils — Supplementary Material" .
}


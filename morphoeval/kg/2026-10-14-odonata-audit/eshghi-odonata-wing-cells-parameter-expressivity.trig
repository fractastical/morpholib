sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Parameter expressivity: 50/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "No generative parameters: the script analyses measured wings. The groups (fossil / dragonfly / damselfly) and the fitted exponents are outputs, not controls. Neutral score, not applicable." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-parameter-expressivity-0> ;
        pk:hasVerdict "not applicable (neutral baseline)",
            "partially faithful" ;
        pk:weightOfEvidence 5e-01 .
    <https://w3id.org/probknow/resource/evidence/2026-10-14-odonata-audit-eshghi-odonata-wing-cells-parameter-expressivity-0> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L144–L173" ;
        dct:description "report(): fits per group, nothing is tuned" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L144-L173> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-eshghi-odonata-wing-cells> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-eshghi-odonata-wing-cells-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Odonata wing cells through deep time — Model fidelity to source: 70/100" ;
        dct:date "2026-10-14"^^xsd:date ;
        dct:description "The prediction under test is stated and operationalised exactly as it follows from the source model (constant cell size -> N ∝ L², median cell ∝ L⁰) and the measured quantity is the one Hoffmann et al. and Eshghi et al. both use (vein-bounded cell, length = maximum Feret diameter, verified by per-wing agreement with Table S1). The model itself is not run here (that is 2018-hoffmann-wing-venation.py), and log-log OLS is the script's own choice of test, not the source's." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-3> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L36–L43" ;
        dct:description "prediction derived from the source model" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L36-L43> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L137–L142" ;
        dct:description "ols_loglog(): the test" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L137-L142> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-eshghi-odonata-wing-cells-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2026-eshghi-odonata-wing-cells.py L404–L413" ;
        dct:description "cell_table(): cell length = max Feret diameter" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/fbbcaf6/2026-eshghi-odonata-wing-cells.py#L404-L413> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Cursor agent)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1721248115>,
            <https://doi.org/10.5281/zenodo.19899648>,
            <https://paleobiodb.org/data1.2/occs/list.csv?base_name=Odonatoptera&show=class,coords&idreso=genus> .
    <https://doi.org/10.1073/pnas.1721248115> dct:date "2018"^^xsd:gYear ;
        dct:title "A simple developmental model recapitulates complex insect wing venation patterns" .
    <https://doi.org/10.5281/zenodo.19899648> dct:date "2026"^^xsd:gYear ;
        dct:title "Critical Crack Length as an Evolutionary Constant in Odonata Wing Venation: Lessons from Fossils — Supplementary Material" .
    <https://paleobiodb.org/data1.2/occs/list.csv?base_name=Odonatoptera&show=class,coords&idreso=genus> dct:title "The Paleobiology Database, Odonatoptera occurrences (data1.2 API, accessed 2026-10-14)" .
}


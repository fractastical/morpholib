<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 1: Levin (2019, 2022) TAME Spatiotemporal Cognitive Light-Cone Scaling & Cancer Gap-Junction Collapse" ;
    dct:description "O2/T4 100-cell diffusive-restoring BVP solver showing spatial correlation reach collapsing from 32.01 cells at G_gj=1.0 to 1.00 cell at G_gj=0 (oncogenic gap-junction blockade) | Variables: N: coupled cell count; G_gj: gap-junctional conductance; k_leak = G_{1/2}/N: membrane leak; L_PDE: spatial morphogenetic reach" ;
    dct:source "Levin (2019) Front. Psychol. 10:2688 (doi:10.3389/fpsyg.2019.02688); Levin (2022) Front. Syst. Neurosci. 16:768201 (doi:10.3389/fnsys.2022.768201); @drmichaellevin [rAsIQGXdVRM], [46b_kB_KPFM], [K5VI0u5_12k], [wj8RkmS3kpM]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L177-L225>,
        <https://github.com/fractastical/morpholib/blob/1969a7ea/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L30-L60> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def tame_goal_radius_num (r_cell N g_gj g_half : Nat) : Nat :=
  r_cell * (g_gj + g_half) + r_cell * (N - 1) * g_gj
theorem tame_cognitive_light_cone_scaling_and_cancer_collapse
    (r_cell N g_gj g_half g1 g2 : Nat) (hN : 1 ≤ N) (hg : g1 ≤ g2) :
    tame_goal_radius_num r_cell N 0 g_half = r_cell * g_half ∧
    tame_goal_radius_num r_cell N g_gj 0 = r_cell * N * g_gj ∧
    tame_goal_radius_num r_cell N g1 g_half ≤ tame_goal_radius_num r_cell N g2 g_half
"""^^pk:lean4 ;
    skos:notation "-G_gj (V_{i-1} - 2V_i + V_{i+1}) + k_leak V_i = δ_{i,0},   L_PDE(G_gj) = ∑_i V_i / V_0;   G_gj = 0 ⟹ L_PDE = 1.0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.patter.2025.101472>,
        <https://doi.org/10.1016/j.tree.2015.11.009>,
        <https://doi.org/10.1017/9781009300940>,
        <https://doi.org/10.1021/acs.jpclett.0c00641>,
        <https://doi.org/10.1038/s42003-025-08411-2>,
        <https://doi.org/10.1073/pnas.1314922110>,
        <https://doi.org/10.1080/01621459.1966.10502008>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.1126/science.abc6182>,
        <https://doi.org/10.3389/fbioe.2016.00055>,
        <https://doi.org/10.3389/fnsys.2022.768201>,
        <https://doi.org/10.3389/fpsyg.2019.02688>,
        <https://doi.org/10.3390/biomimetics8010110>,
        <https://doi.org/10.3390/e25050748>,
        <https://doi.org/10.3390/e26040288>,
        <https://doi.org/10.3390/ijms24010285> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Load-Bearing Mathematical Laws of Multiscale Bioelectricity, Low-Rattling Selection, Polycomputing, Natural Induction GRNs, Causal Emergence 2.0 & Multicellular Game Theory" ;
    pk:leanDeclaration "LoopLevinYouTubeChannelMath.tame_goal_radius_num" ;
    pk:leanTheorem "LoopLevinYouTubeChannelMath.tame_cognitive_light_cone_scaling_and_cancer_collapse" ;

<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 5: Bongard & Levin (2023) Polycomputing & Multi-Observer Commutative Readout Law" ;
    dct:description "O2/T1 universally quantified Boolean witness (XOR/AND/OR) paired with the S_6 dual-observer sorting readout imported from quantify_emergence_ce2.py (det(I) = 1.0000 vs det(E) = 0.7209) | Variables: F: single physical substrate dynamics; π_m: m-th observer coarse-graining projection" ;
    dct:source "Bongard & Levin (2023) Biomimetics 8(1):110 (doi:10.3390/biomimetics8010110); @drmichaellevin [9aTqeCzdT_c], [-0YvVQNMFFg], [qxrGa8ThLLo], [1dTRe2mOEfQ]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L410-L449>,
        <https://github.com/fractastical/morpholib/blob/1969a7ea/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L168-L188> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def poly_state (a b : Bool) : Nat := a.toNat + b.toNat
def poly_obs_xor (s : Nat) : Bool := s % 2 == 1
def poly_obs_and (s : Nat) : Bool := decide (s ≥ 2)
def poly_obs_or  (s : Nat) : Bool := decide (s ≥ 1)
theorem bongard_levin_polycomputing_dual_observer_exact (a b : Bool) :
    poly_obs_xor (poly_state a b) = bne a b ∧
    poly_obs_and (poly_state a b) = (a && b) ∧
    poly_obs_or  (poly_state a b) = (a || b) ∧
    poly_state a b = poly_state b a := by cases a <;> cases b <;> decide
"""^^pk:lean4 ;
    skos:notation "x_{t+1} = F(x_t),   y^{(m)}_t = π_m(x_t) = g_m(a, b)   (π_1 = XOR, π_2 = AND, π_3 = OR;   π_I(v) = I(v) vs. π_E(v) = E(v) on S_6)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.patter.2025.101472>,
        <https://doi.org/10.1016/j.tree.2015.11.009>,
        <https://doi.org/10.1017/9781009300940>,
        <https://doi.org/10.1021/acs.jpclett.0c00641>,
        <https://doi.org/10.1038/s42003-025-08411-2>,
        <https://doi.org/10.1073/pnas.1314922110>,
        <https://doi.org/10.1080/01621459.1966.10502008>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.1126/science.abc6182>,
        <https://doi.org/10.3389/fbioe.2016.00055>,
        <https://doi.org/10.3389/fnsys.2022.768201>,
        <https://doi.org/10.3389/fpsyg.2019.02688>,
        <https://doi.org/10.3390/biomimetics8010110>,
        <https://doi.org/10.3390/e25050748>,
        <https://doi.org/10.3390/e26040288>,
        <https://doi.org/10.3390/ijms24010285> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Load-Bearing Mathematical Laws of Multiscale Bioelectricity, Low-Rattling Selection, Polycomputing, Natural Induction GRNs, Causal Emergence 2.0 & Multicellular Game Theory" ;
    pk:leanDeclaration "LoopLevinYouTubeChannelMath.poly_state" ;
    pk:leanTheorem "LoopLevinYouTubeChannelMath.bongard_levin_polycomputing_dual_observer_exact" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-6> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 6: Watson & Szathmary (2016) Natural Induction + Pigozzi, Goldstein & Levin (2025) Non-Neural GRN Conditioning Law" ;
    dct:description "O1/T4 16-gene Hopfield basin-of-attraction simulation (0% -> 100% recovery across 120 4-flip trials) + 3-gene transcriptional Pavlovian conditioning ODE (CS-only US activation 0.0015 pre-training -> 1.0000 post-training) | Variables: s ∈ {-1,+1}^N: 16-gene state; J_{ij}: recurrent GRN coupling matrix; [x_CS, x_M, x_US]: 3-gene Pigozzi/Biswas transcriptional conditioning ODE" ;
    dct:source "Watson & Szathmary (2016) TREE 31:147 (doi:10.1016/j.tree.2015.11.009); Pigozzi, Goldstein & Levin (2025) Commun. Biol. 8:1027 (doi:10.1038/s42003-025-08411-2); Biswas et al. (2023) IJMS 24:285 (doi:10.3390/ijms24010285); @drmichaellevin [K6cc6jbYQpY], [RLsPP8EfRDg], [JkKUelM6K8w], [bujwU3pKc6c]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L455-L540>,
        <https://github.com/fractastical/morpholib/blob/1969a7ea/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L196-L228> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def grn_hebbian_energy_after (e_init eta n_genes : Int) : Int :=
  e_init - eta * n_genes * n_genes
def grn_pavlovian_weight (w0 eta T : Nat) : Nat := w0 + T * eta
theorem watson_pigozzi_grn_natural_induction_and_pavlovian_conditioning
    (e_init eta n_genes : Int) (w0 eta_n T1 T2 : Nat)
    (h_eta : 0 < eta) (h_n : 0 < n_genes) (hT : T1 ≤ T2) :
    grn_hebbian_energy_after e_init eta n_genes < e_init ∧
    e_init - grn_hebbian_energy_after e_init eta n_genes = eta * n_genes * n_genes ∧
    grn_pavlovian_weight w0 eta_n T1 ≤ grn_pavlovian_weight w0 eta_n T2
"""^^pk:lean4 ;
    skos:notation "E(s; J) = -∑_{i,j} J_{ij} s_i s_j,   ΔJ_{ij} = η s_i s_j (η > 0, N > 0) ⟹ ΔE(s) = -η N^2 < 0;   T_1 ≤ T_2 ⟹ J_{US,CS}(T_1) ≤ J_{US,CS}(T_2)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.patter.2025.101472>,
        <https://doi.org/10.1016/j.tree.2015.11.009>,
        <https://doi.org/10.1017/9781009300940>,
        <https://doi.org/10.1021/acs.jpclett.0c00641>,
        <https://doi.org/10.1038/s42003-025-08411-2>,
        <https://doi.org/10.1073/pnas.1314922110>,
        <https://doi.org/10.1080/01621459.1966.10502008>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.1126/science.abc6182>,
        <https://doi.org/10.3389/fbioe.2016.00055>,
        <https://doi.org/10.3389/fnsys.2022.768201>,
        <https://doi.org/10.3389/fpsyg.2019.02688>,
        <https://doi.org/10.3390/biomimetics8010110>,
        <https://doi.org/10.3390/e25050748>,
        <https://doi.org/10.3390/e26040288>,
        <https://doi.org/10.3390/ijms24010285> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Load-Bearing Mathematical Laws of Multiscale Bioelectricity, Low-Rattling Selection, Polycomputing, Natural Induction GRNs, Causal Emergence 2.0 & Multicellular Game Theory" ;
    pk:leanDeclaration "LoopLevinYouTubeChannelMath.grn_hebbian_energy_after" ;
    pk:leanTheorem "LoopLevinYouTubeChannelMath.watson_pigozzi_grn_natural_induction_and_pavlovian_conditioning" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-7> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 7: Hoel (2026) & Hoel, Albantakis & Tononi (2013) Causal Emergence 2.0 Intensive Causal Primitive & Path-Telescoping Law" ;
    dct:description "O1/T1 universally quantified multiscale path-telescoping theorem paired with the SHA-256-verified 720x720 S_6 Markov TPM metrics imported from sorting-morphogenesis/figures/quantifying_emergence_ce2_metrics.json (ΔCP_I = +0.1191 vs ΔCP_E = -0.2525) | Variables: det(π): Markov transition determinism; deg(π): transition degeneracy; CP(π): Hoel 2026 intensive Causal Primitive" ;
    dct:source "Hoel (2026) Patterns 7(1):101472 (doi:10.1016/j.patter.2025.101472); Hoel, Albantakis & Tononi (2013) PNAS 110:19790 (doi:10.1073/pnas.1314922110); @drmichaellevin [5cXtdZ4blKM], [OPUhmQrmqRg], [L5bQnyq4OtQ]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L410-L449>,
        <https://github.com/fractastical/morpholib/blob/1969a7ea/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L235-L255> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def ce2_cp (det deg : Int) : Int := det - deg
def ce2_gain (det_M deg_M det_m deg_m : Int) : Int :=
  ce2_cp det_M deg_M - ce2_cp det_m deg_m
theorem hoel_albantakis_causal_emergence_ce2_primitive_law
    (det_0 deg_0 det_1 deg_1 det_2 deg_2 : Int) :
    ce2_cp det_0 deg_0 + ce2_gain det_1 deg_1 det_0 deg_0 + ce2_gain det_2 deg_2 det_1 deg_1 = ce2_cp det_2 deg_2 ∧
    (0 < ce2_gain det_2 deg_2 det_0 deg_0 ↔ det_0 - deg_0 < det_2 - deg_2)
"""^^pk:lean4 ;
    skos:notation "CP(π) = det(π) - deg(π),   CP(π^{(0)}) + ΔCP_{1,0} + ΔCP_{2,1} = CP(π^{(2)});   ΔCP > 0 ⟺ det(π_M) - deg(π_M) > det(π_m) - deg(π_m)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.patter.2025.101472>,
        <https://doi.org/10.1016/j.tree.2015.11.009>,
        <https://doi.org/10.1017/9781009300940>,
        <https://doi.org/10.1021/acs.jpclett.0c00641>,
        <https://doi.org/10.1038/s42003-025-08411-2>,
        <https://doi.org/10.1073/pnas.1314922110>,
        <https://doi.org/10.1080/01621459.1966.10502008>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.1126/science.abc6182>,
        <https://doi.org/10.3389/fbioe.2016.00055>,
        <https://doi.org/10.3389/fnsys.2022.768201>,
        <https://doi.org/10.3389/fpsyg.2019.02688>,
        <https://doi.org/10.3390/biomimetics8010110>,
        <https://doi.org/10.3390/e25050748>,
        <https://doi.org/10.3390/e26040288>,
        <https://doi.org/10.3390/ijms24010285> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Load-Bearing Mathematical Laws of Multiscale Bioelectricity, Low-Rattling Selection, Polycomputing, Natural Induction GRNs, Causal Emergence 2.0 & Multicellular Game Theory" ;
    pk:leanDeclaration "LoopLevinYouTubeChannelMath.ce2_cp" ;
    pk:leanTheorem "LoopLevinYouTubeChannelMath.hoel_albantakis_causal_emergence_ce2_primitive_law" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/levin-youtube-channel-math-8> a skos:Concept,
        pk:Concept ;
    rdfs:label "Law 8: Shreesha & Levin (2025) Spatialized Multicellular Prisoner's Dilemma Merge/Split Threshold Law" ;
    dct:description "O2/T4 exact 2D m x m lattice bond-counting and payoff threshold law proving single-cell cooperator extinction (-c < 0), viability breakeven at k = 4, boundary-defector tie at k = 16, and strict dominance for k ≥ 17 | Variables: k = m^2: multicellular square cluster size; f_int(m^2) = (4m^2 - 4m)/(4m^2) = 1 - 1/m: exact 2D square-lattice internal bond fraction; b, c: benefit and cost" ;
    dct:source "Shreesha & Levin (2025) OSF (https://osf.io/kpzju_v2) & @drmichaellevin [iOFHyNliS9M], [oe6v2fTewyU], [Q-yZ-IeZywg]" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L546-L580>,
        <https://github.com/fractastical/morpholib/blob/1969a7ea/morphoeval/lean/loops/Loop_levin_youtube_channel_math.lean#L262-L288> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def multicell_coop_scaled_payoff (sqrt_k b c : Int) : Int :=
  (sqrt_k - 1) * b - sqrt_k * c
def multicell_defect_scaled_payoff (b : Int) : Int := b
theorem shreesha_morozov_multicellular_prisoners_dilemma_threshold
    (sqrt_k b c : Int) (hc : 0 < c) :
    multicell_coop_scaled_payoff 1 b c = -c ∧
    multicell_coop_scaled_payoff 1 b c < 0 ∧
    (0 ≤ multicell_coop_scaled_payoff sqrt_k b c ↔ b ≤ sqrt_k * (b - c)) ∧
    (multicell_defect_scaled_payoff b < multicell_coop_scaled_payoff sqrt_k b c ↔ 2 * b < sqrt_k * (b - c))
"""^^pk:lean4 ;
    skos:notation "π_C(k) = (1 - 1/√k) b - c ≥ 0 ⟺ b ≤ √k (b - c);   π_C(k) > π_D(k) = b/√k ⟺ 2b < √k (b - c)   (k_crit = 4, tie k = 16, strict dominance k ≥ 17 for b=2, c=1)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.patter.2025.101472>,
        <https://doi.org/10.1016/j.tree.2015.11.009>,
        <https://doi.org/10.1017/9781009300940>,
        <https://doi.org/10.1021/acs.jpclett.0c00641>,
        <https://doi.org/10.1038/s42003-025-08411-2>,
        <https://doi.org/10.1073/pnas.1314922110>,
        <https://doi.org/10.1080/01621459.1966.10502008>,
        <https://doi.org/10.1098/rsif.2017.0425>,
        <https://doi.org/10.1126/science.abc6182>,
        <https://doi.org/10.3389/fbioe.2016.00055>,
        <https://doi.org/10.3389/fnsys.2022.768201>,
        <https://doi.org/10.3389/fpsyg.2019.02688>,
        <https://doi.org/10.3390/biomimetics8010110>,
        <https://doi.org/10.3390/e25050748>,
        <https://doi.org/10.3390/e26040288>,
        <https://doi.org/10.3390/ijms24010285> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Load-Bearing Mathematical Laws of Multiscale Bioelectricity, Low-Rattling Selection, Polycomputing, Natural Induction GRNs, Causal Emergence 2.0 & Multicellular Game Theory" ;
    pk:leanDeclaration "LoopLevinYouTubeChannelMath.multicell_coop_scaled_payoff" ;
    pk:leanTheorem "LoopLevinYouTubeChannelMath.shreesha_morozov_multicellular_prisoners_dilemma_threshold" ;
    pk:leanVerified true .


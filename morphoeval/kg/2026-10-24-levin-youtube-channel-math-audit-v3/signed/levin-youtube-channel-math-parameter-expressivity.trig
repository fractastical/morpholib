sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-levin-youtube-channel-math> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-parameter-expressivity> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L894–L912" ;
        dcterms:description "CLI: 14 model flags (--law, --n-cells, --g-half, --v-th, --v0, --delta-v-mv, --n-states, --gamma, --n-genes, --eta, --b, --c, --seed) plus --self-test, --no-figure, --out-dir" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L894-L912> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L833–L850" ;
        dcterms:description "Assertions are parameterised (L843 slope vs -args.gamma; L847 Delta E vs -eta N^2; L850 pi_C(1) = -c; L849 post > pre + 0.5) and precede every write. Reproduced: 13 of 14 non-default flag runs exit 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L833-L850> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L311–L317" ;
        dcterms:description "Law 3: grid refinement N_ap = 15..240 and G_gj sweep at N_ap = 120 - two genuine sweeps, one of which (grid) has a non-trivial response" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L311-L317> .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Anthropic; independent cross-provider MorphoEval referee, Pass 3 / 3.1)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "@drmichaellevin 8-law mathematical synthesis & biological-law-criteria suite — Parameter expressivity: 76/100" ;
        dcterms:date "2026-10-24"^^xsd:date ;
        dcterms:description "Positives: 14 model flags on the CLI (L894-L912); direct single invocations of 13 of them with non-default values complete (`--n-cells 50`, `--g-half 0.5`, `--b 3`, `--eta 0.01`, `--n-states 12`, `--gamma 2`, `--n-genes 8`, `--c 0.5`, `--v0 2`, `--v-th=-20`, `--seed 7`, `--law 2,4`, `--b 1.2`; reproduced), so the four Pass 3 aborts are gone; the assertions are functions of the CLI values (L843 -args.gamma, L847 eta * n_genes^2, L850 -args.c); Law 1's G_gj grid is now plotted; Law 4's alpha sweep varies one thing (routing) with the rates fixed; `--law` exists. Deductions: `--delta-v-mv 0` aborts at L841 because a zero gradient makes every grid error 0 and the strict convergence test fails (-4); `--law` filters only the output table - all eight solvers and the full figure still run (-4); Laws 2, 5, 6, 7 have no sweep that crosses a regime boundary, so monotonic control of a feature of form can be judged only for Laws 1, 3, 4, 8 (-8); Law 4's alpha is sampled at three points and the alpha dependence is not plotted (-3); Law 2's V_0 = 5 mV and V_th = -35 mV are sourced only in a comment and no Cervera parameter set is reproduced (-3); the Hill G_eff fit the docstring describes would have been the one fitted parameter in Law 1 and is absent (-2)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2026-levin-channel-math-synthesis.py L388–L390: Law 4 alpha sampled at 0, 0.5, 0.9 only; routing varied with rates fixed (genuine single-knob sweep), but no alpha curve is stored or plotted <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L388-L390>",
            "models/2026-levin-channel-math-synthesis.py L823–L825: --law filter is applied to laws_table only, after all eight simulate_* calls (L697-L703) have run; the figure (L879-L889) still renders all six panels. The flag selects what is reported, not what is computed <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L823-L825>",
            "models/2026-levin-channel-math-synthesis.py L841–L841: `assert abs_errors_by_grid[-1] < abs_errors_by_grid[0]`: with --delta-v-mv 0 all errors are exactly 0 and the strict inequality fails (AssertionError reproduced); the only flag that still aborts <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L841-L841>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-3> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


        dcterms:description "EXPECTED_CATALOG_SHA256 216a474f... (L63) and EXPECTED_CE2_SHA256 b54103b8... (L65) pinned; both match the files on disk and are asserted at L834-L835 (reproduced)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L61-L69> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/runs/levin_youtube_channel_math_summary.json L1–L519" ;
        dcterms:description "Builder's summary: laws block canonical SHA-256 cf60fdd1... equals the referee's --self-test output; lean_verification kernel_exit_code 0; catalog_verification sha256_matches_pin true. No commit hash, timestamp or script hash recorded in the file" ;

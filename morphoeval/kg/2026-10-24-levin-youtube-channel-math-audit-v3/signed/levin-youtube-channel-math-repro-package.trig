    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Anthropic; independent cross-provider MorphoEval referee, Pass 3 / 3.1)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "@drmichaellevin 8-law mathematical synthesis & biological-law-criteria suite — Reproducibility package: 76/100" ;
        dcterms:date "2026-10-24"^^xsd:date ;
        dcterms:description "Positives: `--self-test` exits 0 in 3.4 s, renders into a temporary directory and writes nothing into morphoeval/runs/; all assertions run before any artefact is written (L833-L850 vs L885-L889), so a failed parameterised run leaves no partial outputs (closes R7); both inputs are SHA-256-pinned in code and asserted (L63/L65, L834/L835); the committed summary JSON's `laws` block is byte-equal to the --self-test output (canonical SHA-256 cf60fdd1...); the KG payload, catalog taxonomy and README now describe the same 8-law package; the RNG is seeded and the seed is on the CLI; `lean` runs inside the suite and standalone; Python/numpy/scipy/matplotlib/Lean versions reproduced. Deductions: every audited file except MathOfBiology.lean is still an untracked working-tree file at HEAD 8fa7e207, two commits after the Pass 3 checkpoint, so no commit contains the package scored here (-12); `--delta-v-mv 0` aborts (-2); `--law` does not skip computation or figure panels (-3); no regeneration script for the catalog's mappedMathLaws or for the KG payload is committed, so two of the package's artefacts cannot be rebuilt from source (-4); matplotlib writes a font cache outside the repository unless MPLCONFIGDIR is set (-1); the summary JSON carries no git commit, timestamp or script hash (-2)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "models/2026-levin-channel-math-synthesis.py L823–L825: --law filters laws_table after all solvers have run; a single law cannot be run or plotted in isolation <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L823-L825>",
            "morphoeval/audits/2026-10-24-levin-youtube-channel-math-audit-v2.yaml L44–L46: v2 recorded that every audited file was untracked at bfe377c2; at 8fa7e207 (git status 2026-10-24 18:05 EDT) the script, Loop .lean, YAML, docs, bib, README, catalog, KG payload, summary JSON and verify_integrity.py remain `??`; no checkpoint commit contains the Pass 3 or Pass 3.1 package <https://github.com/fractastical/morpholib/blob/1969a7ea/morphoeval/audits/2026-10-24-levin-youtube-channel-math-audit-v2.yaml#L44-L46>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-4>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-5> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


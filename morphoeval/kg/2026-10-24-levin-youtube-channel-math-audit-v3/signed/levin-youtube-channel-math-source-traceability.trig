sub1:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-levin-youtube-channel-math> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-source-traceability> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/levin_youtube_channel/paper_citations.bib L1–L183" ;
        dcterms:description "16 entries; all 15 DOIs resolve via api.crossref.org (2026-10-24) and shreesha2025's OSF URL returns 200. Laws 1-8 each have >= 1 DOI" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/datasets/levin_youtube_channel/paper_citations.bib#L1-L183> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/levin_youtube_channel/README.md L9–L9" ;
        dcterms:description "README records SHA-256 216a474f... and says it is verified at runtime; the script pins the same value (L63) and asserts the match (L834). Closes R4's 'compared with nothing'" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/datasets/levin_youtube_channel/README.md#L9-L9> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L99–L118" ;
        dcterms:description "verify_catalog_and_video_ids: loads, hashes, compares with EXPECTED_CATALOG_SHA256, resolves 63 cited IDs (all present; reproduced)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L99-L118> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/levin_youtube_channel/levin_youtube_catalog.json L1340–L1349" ;
        dcterms:description "Chvykov talk mOWfZncXt_g -> 'levin-youtube-channel-math-4 (Chvykov Low-Rattling ...)'; PIrHLnmI_9o (L3382) -> math-2 Cervera; 5cXtdZ4blKM (L4553) -> math-7 Hoel-Albantakis; 3Jol76a-urM (L4316) -> channel_concepts_index. 9 distinct labels = 8 laws + concepts (231 videos). Closes R4" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/datasets/levin_youtube_channel/levin_youtube_catalog.json#L1340-L1349> .

    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-5> a pk:EvidenceItem ;
        rdfs:label "docs/BIOLOGICAL_LAW_CRITERIA.md L28–L35" ;
        dcterms:description "21 video IDs and 10 publication dates quoted in the C1-C6 provenance column match the catalog (checked programmatically in Pass 3; catalog metadata unchanged apart from mappedMathLaws)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/1969a7ea/docs/BIOLOGICAL_LAW_CRITERIA.md#L28-L35> .

    <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "@drmichaellevin 8-law mathematical synthesis & biological-law-criteria suite — Source and data traceability: 74/100" ;
        dcterms:date "2026-10-24"^^xsd:date ;
        dcterms:description "Positives: all 15 bib DOIs resolve via Crossref (checked 2026-10-24) with title, volume and locator of record for 14; every one of the 8 laws has at least one DOI; all 63 video IDs resolve in the catalog; the catalog's `mappedMathLaws` now carries the 8-law + concepts taxonomy (spot-checked: Chvykov -> math-4, Cervera -> math-2, Albantakis -> math-7, Weinberg -> concepts) and its SHA-256 is pinned in code, asserted, and recorded in README L9 (closes R4); hoel2026ce2 has a verification note; the OSF URL returns 200. Deductions: the Ross DOI is wrong for the second time - 10.1017/9781009301435 resolves nowhere (Crossref 'Resource not found', doi.org 404) while the Element is 10.1017/9781009300940 and dated 2025 (-7); `froese2024` keeps a paraphrased title and adds a co-author (Karelin) that the Crossref record does not list, under a 'Crossref-verified' note (-4); Stoica (Law 5 name L768), Morozov (Law 8 name L810, docs L49/L66) and Albantakis (Law 7 name) are named as sources with no DOI, URL or bib entry (-5); 'Sweet (2026) Sweet Rationalism' (docs L34) has no identifier (-2); Law 1 lists Beane and Pezzulo scripts under implemented_by but the synthesis neither imports nor calls them (-3); no crawl or regeneration script for the catalog is committed (-3); the Hoel bib title carries a 'Causal emergence 2.0:' prefix absent from the Crossref record (-1); Ross year given as 2024 (-1)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/levin_youtube_channel/paper_citations.bib L130–L140: hoel2026ce2 title 'Causal emergence 2.0: Quantifying emergent complexity' with a Crossref-verified note; Crossref title of record is 'Quantifying emergent complexity' (vol 7, art 101472, issued 2026-01 - these match) <https://github.com/fractastical/morpholib/blob/1969a7ea/datasets/levin_youtube_channel/paper_citations.bib#L130-L140>",
            "datasets/levin_youtube_channel/paper_citations.bib L154–L164: froese2024: author 'Froese, Tom and Karelin, Georgii', title '...A Black-Box Framework for Modeling How Mind and Matter Interact in Living Systems', note 'Crossref-verified 2026-10-24'. Crossref record 10.3390/e26040288: author Froese T only; title 'Irruption and Absorption: A Black-Box Framework for How Mind and Matter Make a Difference to Each Other'. Not closed <https://github.com/fractastical/morpholib/blob/1969a7ea/datasets/levin_youtube_channel/paper_citations.bib#L154-L164>",
            "docs/BIOLOGICAL_LAW_CRITERIA.md L31–L31: C2 row: 'Ross, L. N. (2024). Explanation in Biology (... doi:10.1017/9781009301435)'. api.crossref.org/works/10.1017/9781009301435 -> 'Resource not found'; doi.org -> HTTP 404. Crossref search (title 'Explanation in Biology', author 'Lauren Ross') returns 10.1017/9781009300940, Cambridge University Press monograph issued 2025-01-16. Second wrong identifier for the same work <https://github.com/fractastical/morpholib/blob/1969a7ea/docs/BIOLOGICAL_LAW_CRITERIA.md#L31-L31>",
            "models/2026-levin-channel-math-synthesis.py L715–L715: Law 1 implemented_by: 2011-beane... and 2015-pezzulo...; neither is imported, read or executed anywhere in this script, so the attribution is not a trace (unchanged) <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L715-L715>",
            "models/2026-levin-channel-math-synthesis.py L768–L768: Law 5 name 'Bongard-Levin Polycomputing & Stoica Multi-Observer Commutative Readout Law': Stoica has no identifier in the script, YAML, bib or docs; same for Morozov (L810) and Albantakis (L796) <https://github.com/fractastical/morpholib/blob/1969a7ea/models/2026-levin-channel-math-synthesis.py#L768-L768>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-4>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-source-traceability-5> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Anthropic; independent cross-provider MorphoEval referee, Pass 3 / 3.1)" ;
        dcterms:identifier "claude-fable-5-1" ;

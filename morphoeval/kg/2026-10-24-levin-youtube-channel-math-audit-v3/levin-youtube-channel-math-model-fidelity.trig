sub:pubinfo {
    sub: rdfs:label "@drmichaellevin 8-law mathematical synthesis & biological-law-criteria suite — Model fidelity to source 78/100" ;
        dct:conformsTo <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        dct:created "2026-10-25T19:34:11Z"^^xsd:dateTime ;
        dct:creator <https://orcid.org/0009-0007-4948-9192> ;
        dct:license <https://creativecommons.org/licenses/by/4.0/> ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-levin-youtube-channel-math> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "@drmichaellevin 8-law mathematical synthesis & biological-law-criteria suite — Reproducibility package: 90/100" ;
        dct:date "2026-10-24"^^xsd:date ;
        dct:description "Positives: the whole package is committed at 9987ff10 and unchanged through HEAD 03145ecc (+12 restored); `--self-test` exits 0, renders into a temporary directory and writes nothing into morphoeval/runs/; all assertions precede the writes; both inputs are SHA-256-pinned in code and asserted (L63/L65, L845/L846); the committed summary JSON's `laws` block is byte-equal to the --self-test output (canonical SHA-256 01d7a346...) and now carries the script hash (+1); `--delta-v-mv 0` completes (+2); all 14 flags work; the RNG is seeded and the seed is on the CLI; `lean` runs inside the suite and standalone; Python / numpy / scipy / matplotlib / Lean versions reproduced. Deductions: `--law` does not skip computation or figure panels (-3); no regeneration script for the catalog's mappedMathLaws or for the KG payload is committed, and the payload's stale loci prove it is maintained by hand (-5); matplotlib writes a font cache outside the repository unless MPLCONFIGDIR is set (-1); the summary JSON's git_commit is the parent of the commit that contains it (-1)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "docs/bioelectricity/levin_youtube_kg.json L1–L12: schema_version 3.0.0, total_laws 8, channel_concepts_indexed 17, all_lean4_verified true, lean_verification / catalog_verification blocks. Committed, but hand-maintained: no generator, and its loci (L347-L580) lag the script by one revision <https://github.com/fractastical/morpholib/blob/9987ff10/docs/bioelectricity/levin_youtube_kg.json#L1-L12>",
            "models/2026-levin-channel-math-synthesis.py L834–L836: --law filters laws_table after all solvers have run; a single law cannot be run or plotted in isolation (unchanged) <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L834-L836>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-4>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-5>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-6> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L844–L862" ;
        dct:description "All 18 assertions precede the writes (L902-L912); reproduced: no --self-test run touched morphoeval/runs/ (mtime Oct 25 12:05 before and after), media/ or docs/" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L844-L862> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L902–L912" ;
        dct:description "--self-test renders into tempfile.TemporaryDirectory() and skips the summary write; default mode writes the summary JSON then media/ and docs/ PNGs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L902-L912> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L61–L69" ;
        dct:description "EXPECTED_CATALOG_SHA256 216a474f... (L63) and EXPECTED_CE2_SHA256 b54103b8... (L65) pinned; both match the files on disk and are asserted at L845-L846 (reproduced)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L61-L69> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/runs/levin_youtube_channel_math_summary.json L1–L524" ;
        dct:description "Builder's summary: laws block canonical SHA-256 01d7a346... equals the referee's --self-test output; every per-law block equals the --self-test block; lean_verification kernel_exit_code 0; catalog_verification sha256_matches_pin true; script_sha256 equals the committed script" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/morphoeval/runs/levin_youtube_channel_math_summary.json#L1-L524> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/levin-youtube-channel-math.yaml L1–L10" ;
        dct:description "model_spec: seed 20261024 (used by Laws 4 and 6), inputs = catalog + CE2 JSON (both read and hash-checked by the script). No hash recorded in the YAML itself" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/morphoeval/math_kg_loops/levin-youtube-channel-math.yaml#L1-L10> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-repro-package-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/audits/2026-10-24-levin-youtube-channel-math-audit-v2.yaml L44–L46" ;
        dct:description "v2 recorded that every audited file was untracked at bfe377c2 and Pass 3.1 recorded the same at 8fa7e207; at 9987ff10 the script, Loop .lean, YAML, docs, bib, README, catalog, KG payload, summary JSON and figure are all tracked and this audit's two files are tracked too. Closes Pass 3.1 R7" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/morphoeval/audits/2026-10-24-levin-youtube-channel-math-audit-v2.yaml#L44-L46> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Anthropic; independent cross-provider MorphoEval referee, Pass 3 / 3.1 / 3.2)" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-levin-youtube-channel-math> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-levin-youtube-channel-math-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "@drmichaellevin 8-law mathematical synthesis & biological-law-criteria suite — Parameter expressivity: 82/100" ;
        dct:date "2026-10-24"^^xsd:date ;
        dct:description "Positives: 14 model flags on the CLI (L917-L935); every one of them completes with a non-default value under --self-test, including the previously aborting `--delta-v-mv 0` (guard at L853) and `--delta-v-mv -40` (reproduced: 17 invocations, all exit 0) (+4 restored); the assertions are functions of the CLI values (L855 -args.gamma, L859 eta * n_genes^2, L862 -args.c); Law 1 now has one genuinely fitted parameter (G_eff, L213) (+2 restored); Law 4's alpha sweep varies routing with the rates fixed; Law 3 has two sweeps. Deductions: `--law` still filters only the output table - all eight solvers and the full figure run (reproduced with `--law 2,4`: the JSON carries all seven law blocks) (-4); Laws 2, 5, 6, 7 have no sweep that crosses a regime boundary, so monotonic control of a feature of form can be judged only for Laws 1, 3, 4, 8 (-8); Law 4's alpha is sampled at three points and the alpha dependence is not plotted (-3); Law 2's V_0 = 5 mV and V_th = -35 mV are sourced only in a comment and no Cervera parameter set is reproduced (-3)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "models/2026-levin-channel-math-synthesis.py L396–L398: Law 4 alpha sampled at 0, 0.5, 0.9 only; routing varied with rates fixed (genuine single-knob sweep), but no alpha curve is stored or plotted <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L396-L398>",
            "models/2026-levin-channel-math-synthesis.py L834–L836: --law filter is applied to laws_table only, after all eight simulate_* calls (L708-L714) have run; the figure still renders all six panels. The flag selects what is reported, not what is computed (reproduced: --law 2,4 output contains law1_, law3_, law6_, law8_ blocks) <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L834-L836>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-4> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L917–L935" ;
        dct:description "CLI: 14 model flags (--law, --n-cells, --g-half, --v-th, --v0, --delta-v-mv, --n-states, --gamma, --n-genes, --eta, --b, --c, --seed) plus --self-test, --no-figure, --out-dir" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L917-L935> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L844–L862" ;
        dct:description "Assertions are parameterised and precede every write. Reproduced: --n-cells 50, --g-half 0.5, --g-half 5.0, --b 3, --b 1.2, --eta 0.01, --n-states 12, --gamma 2, --n-genes 8, --c 0.5, --v0 2, --v-th=-20, --seed 7, --n-cells 20 --g-half 1.0, --delta-v-mv 0, --delta-v-mv -40, --law 2,4 all exit 0 under --self-test (14 of 14 flags)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L844-L862> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L853–L853" ;
        dct:description "`assert errors[-1] < errors[0] or abs(args.delta_v_mv) < 1e-12`: the zero-gradient case is now skipped instead of failing; with --delta-v-mv 0 all ratios are exactly 1.0 and the run completes. Closes Pass 3.1 R6's abort" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L853-L853> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-levin-youtube-channel-math-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "models/2026-levin-channel-math-synthesis.py L319–L325" ;
        dct:description "Law 3: grid refinement N_ap = 15..240 and G_gj sweep at N_ap = 120 - two genuine sweeps, one of which (grid) has a non-trivial response" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/9987ff10/models/2026-levin-channel-math-synthesis.py#L319-L325> .
    <https://w3id.org/delphi/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Anthropic; independent cross-provider MorphoEval referee, Pass 3 / 3.1 / 3.2)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


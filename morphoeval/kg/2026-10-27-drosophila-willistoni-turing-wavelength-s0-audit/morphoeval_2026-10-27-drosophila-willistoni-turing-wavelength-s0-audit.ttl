    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila willistoni subcellular Turing wavelength (1.5 µm, 0 Ma) — Model fidelity to source: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script implements Schnakenberg kinetics, the steady-state Jacobian, the classical onset wavenumber, and the growth-rate eigenvalue. Parameters are a reconstruction constrained to 1.466 µm, which is declared, so this is not a transcription of a willistoni rate table. Pass 1 withholds the top of the scale until the ablation control is in the measurements sidecar." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila willistoni subcellular Turing wavelength (1.5 µm, 0 Ma) — Morphometric validation: 68/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The self-test enforces Pearson r > 0.98, RMSE < 0.05 µm, wavelength order, and non-equal specimen metrics. Those numbers are not yet in a measurements sidecar, so Pass 1 holds this dimension down. The commensurate-mode sweep is expected to sit on the analytical line; the noise-seeded field is the independent wavelength residual." ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila willistoni subcellular Turing wavelength (1.5 µm, 0 Ma) — Code-to-model traceability: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The module docstring states the PDEs, the onset formula, the allometry, and the refusal to copy slot 2931. Functions match those equations. The numerical values of a, b, Du, and Dv are calibration outputs rather than equation numbers in Clark 2007, which is the right claim boundary and the reason this is not a higher score." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-willistoni-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian at the homogeneous steady state" ;
    dct:description "Focal 1.5 µm kinetics. Not the 86 µm sibling parameters. | Variables: a=0.072, b=1.186, Du=0.015919 µm², Dv=0.214909 µm², ratio 13.50 > onset 11.37" ;
    dct:source "Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0; Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py#L82-L97>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3211_drosophila_willistoni_turing_wavelength_s0.lean#L48-L52> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u* = a + b; fu = -1 + 2b/(a+b); fv = (a+b)^2; gu = -2b/(a+b); gv = -(a+b)^2" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3211.turingMargin" ;
    pk:leanTheorem "MathOfBiology.Loop_3211.willistoni_above_turing_onset" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-willistoni-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fastest-mode wavelength and classical onset wavenumber" ;
    dct:description "The slot scale is the fastest-growing mode, not the cellular tergite wavelength. | Variables: λ_max(willistoni)=1.466 µm; λ_onset≈1.396 µm; σ_max>0" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py#L99-L128>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3211_drosophila_willistoni_turing_wavelength_s0.lean#L8-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = γ (Dv fu + Du gv) / (2 Du Dv); λ_max = 2π / argmax σ(k)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3211.lambdaNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3211.focal_wavelength_is_1_5_um_scale" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-willistoni-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene chronoseries at fixed kinetics" ;
    dct:description "What changes at 0 Ma and 1.5 µm versus the predecessor and the successor. | Variables: virilis 1676 nm and 7.40 granules; willistoni 1466 nm and 5.77; yakuba 1509 nm and 6.09" ;
    dct:source "Clark et al. 2007 DOI:10.1038/nature06341; Jeong et al. 2008 DOI:10.1016/j.cell.2008.01.014" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py#L130-L163>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3211_drosophila_willistoni_turing_wavelength_s0.lean#L17-L43> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ = 1.466 µm * (L_body / 2.32 mm)^0.35; N = d_cell / λ; d_cell ∝ L_body" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion (I. Reaction-Diffusion & Stripe Splitting)" ;
    pk:leanDeclaration "MathOfBiology.Loop_3211.cellNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3211.virilis_has_more_granules_per_cell_than_willistoni" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-willistoni-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusivity ablation is below onset" ;
    dct:description "Negative control. The seeded stripe decays. | Variables: Du = Dv = 0.015919 µm²" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py#L289-L304>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3211_drosophila_willistoni_turing_wavelength_s0.lean#L54-L56> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "turingMargin(Du, Du, 1137, 100) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.cell.2008.01.014>,
        <https://doi.org/10.1038/nature06341>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila willistoni subcellular Turing wavelength (1.5 µm, 0 Ma) — Model fidelity to source: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script implements Schnakenberg kinetics, the steady-state Jacobian, the classical onset wavenumber, and the growth-rate eigenvalue. Parameters are a reconstruction constrained to 1.466 µm, which is declared, so this is not a transcription of a willistoni rate table. Pass 1 withholds the top of the scale until the ablation control is in the measurements sidecar." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py L82–L128" ;
        dct:description "Jacobian, discriminant, growth rate, fastest mode, onset wavelength" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py#L82-L128> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py L165–L250" ;
        dct:description "periodic Laplacian and forward-Euler integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py#L165-L250> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_willistoni_turing_wavelength_s0/drosophila_willistoni_turing_wavelength_s0_reference.json L32–L52" ;
        dct:description "equations and the explicit calibration note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/datasets/drosophila_willistoni_turing_wavelength_s0/drosophila_willistoni_turing_wavelength_s0_reference.json#L32-L52> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7, loop 3211 primary assessor" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


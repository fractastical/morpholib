sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Drosophila willistoni subcellular Turing wavelength (1.5 µm, 0 Ma) faithfully reproduces Drosophila willistoni morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila willistoni specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py; output: docs/media/drosophila_willistoni_turing_wavelength_s0_growth.gif; organism: Drosophila willistoni; environment: n/a; claim_boundary: [reported_in_source: Turing 1952 gives the diffusion-driven instability and the critical wavenumber. | Schnakenberg 1979 gives the two-species kinetics used here. | Clark et al. 2007 describe the D. willistoni genome, sex-comb loss, and inversion polymorphism. | Jeong et al. 2008 describe abdominal pigmentation divergence in the yakuba/santomea pair. | Hanson 2019 is a CC BY-SA 4.0 photograph of an adult D. willistoni female.; reconstructed_in_script: a=0.072, b=1.186, gamma=0.84, Du=0.015919 µm², Dv=0.214909 µm² are chosen so λ_max=1.466 µm. | Allometry λ ∝ L_body^0.35 and a cell diameter linear in body length are slot-specific reconstructions. | The periodic patch stands in for the repeating granule lattice inside an epidermal cell.; transfer_boundary: The photograph resolves the whole fly. The 1.5 µm field is painted onto the segmented abdomen; it is not a micrograph of granules.; does_not_claim: Does not claim Clark 2007 measured a 1.5 µm Turing wavelength. | Does not claim sex-comb loss is produced by this reaction-diffusion system. | Does not claim D. virilis is a literal ancestor or D. yakuba a literal descendant. | Does not reuse slot 2931 parameters (86 µm, alpha_scale 1.63, beta_offset 0.38).]; other sources: Drosophila willistoni female (File:Dwil_1.tif) <https://commons.wikimedia.org/wiki/File:Dwil_1.tif>; phenomenon_size: 1.9 µm (1.919e-06 m, log10=-5.717 m, tier=3_subcellular_um); species_scale_ladder (10 runs from 1.9 µm to 4.3 mm): 1.9 µm:drosophila-affinis-bioelectric-polarity, 6.0 µm:drosophila-affinis-vertex-packing, 96 µm:drosophila-affinis-turing-wavelength, 192 µm:drosophila-affinis-clock-wavefront, 432 µm:drosophila-affinis-morphogen-condensation, 528 µm:drosophila-affinis-elastic-buckling, 600 µm:drosophila-affinis-flux-canalization, 840 µm:drosophila-affinis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.cell.2008.01.014>,
            <https://doi.org/10.1038/nature06341>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://commons.wikimedia.org/wiki/File:Dwil_1.tif>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/j.cell.2008.01.014>,
            <https://doi.org/10.1038/nature06341>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.1179047> .
    <https://commons.wikimedia.org/wiki/File:Dwil_1.tif> dct:title "Drosophila willistoni female (File:Dwil_1.tif)" .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/j.cell.2008.01.014> dct:title "The evolution of gene regulation underlies a morphological difference between two Drosophila sister species" .
    <https://doi.org/10.1038/nature06341> dct:title "Evolution of genes and genomes on the Drosophila phylogeny" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.1179047> dct:title "Reaction-diffusion model as a framework for understanding biological pattern formation" .
}


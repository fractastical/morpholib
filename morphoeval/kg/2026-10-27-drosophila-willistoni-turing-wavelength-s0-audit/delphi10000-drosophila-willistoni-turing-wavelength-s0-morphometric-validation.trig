sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila willistoni subcellular Turing wavelength (1.5 µm, 0 Ma) — Morphometric validation: 68/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The self-test enforces Pearson r > 0.98, RMSE < 0.05 µm, wavelength order, and non-equal specimen metrics. Those numbers are not yet in a measurements sidecar, so Pass 1 holds this dimension down. The commensurate-mode sweep is expected to sit on the analytical line; the noise-seeded field is the independent wavelength residual." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-ablation-control-std-ratio-versus-turing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-onset-wavelength-k-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-simulated-ocellus-dominant-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-abdomen-intensity-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-abdomen-pigment-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-virilis-predecessor-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-wavelength-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-willistoni-granules-across-epidermal-cell>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-yakuba-successor-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-ablation-control-std-ratio-versus-turing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation control std ratio versus turing = 0.0 1" ;
        dct:description "a ratio near 1 would mean the ablation failed to suppress the pattern" ;
        schema:measurementTechnique "std(u | Du=Dv) / std(u | δ=13.5) after the same stripe seed" ;
        schema:name "ablation control std ratio versus turing" ;
        schema:unitText "1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-ablation-control-std-ratio-versus-turing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-ablation-control-std-ratio-versus-turing-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-onset-wavelength-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "onset wavelength k_c = 1.395551 µm" ;
        dct:description "supercritical fastest mode is longer than the onset wavenumber" ;
        schema:measurementTechnique "k_c^2 = gamma (Dv fu + Du gv) / (2 Du Dv)" ;
        schema:name "onset wavelength k_c" ;
        schema:unitText "µm" ;
        schema:value "1.395551" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-onset-wavelength-k-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-onset-wavelength-k-c-reference> a schema:PropertyValue ;
        schema:value "1.466" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-simulated-ocellus-dominant-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated ocellus dominant wavelength = 1.479976 µm" ;
        dct:description "sub-bin estimate is not forced equal to the reference bin centre" ;
        schema:measurementTechnique "sub-bin radial FFT of the noise-seeded Schnakenberg field" ;
        schema:name "simulated ocellus dominant wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.479976" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-simulated-ocellus-dominant-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-simulated-ocellus-dominant-wavelength-reference> a schema:PropertyValue ;
        schema:value "1.466" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-abdomen-intensity-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen abdomen intensity pearson r = 0.924906 1" ;
        dct:description "r = 1 would mean the granule field was not painted on" ;
        schema:measurementTechnique "pearsonr of abdomen pixels, photograph versus modulated frame" ;
        schema:name "specimen abdomen intensity pearson r" ;
        schema:unitText "1" ;
        schema:value "0.924906" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-abdomen-intensity-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-abdomen-intensity-pearson-r-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-abdomen-pigment-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen abdomen pigment KS statistic = 0.068359 1" ;
        dct:description "KS D = 0 would mean the modulation left intensities unchanged" ;
        schema:measurementTechnique "ks_2samp of abdomen grayscale before and after granule modulation" ;
        schema:name "specimen abdomen pigment KS statistic" ;
        schema:unitText "1" ;
        schema:value "0.068359" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-abdomen-pigment-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-abdomen-pigment-ks-statistic-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.106667 1" ;
        dct:description "the abdomen is a subset of the fly, so the two fractions are different measurements" ;
        schema:measurementTechnique "segmented abdomen area fraction versus border-median foreground of the whole photograph" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "1" ;
        schema:value "0.106667" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.32287" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.560967 1" ;
        dct:description "simulation value is measured on the rendered frame; reference is the untouched photograph" ;
        schema:measurementTechnique "mean structure-tensor coherency on the body mask" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "1" ;
        schema:value "0.560967" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.569752" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-virilis-predecessor-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "virilis predecessor wavelength = 1.675833 µm" ;
        dct:description "longer than the focal 1.466 µm wavelength" ;
        schema:measurementTechnique "λ = 1.466 * (L_body / 2.32 mm)^0.35" ;
        schema:name "virilis predecessor wavelength" ;
        schema:unitText "µm" ;
        schema:value "1.675833" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-virilis-predecessor-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-virilis-predecessor-wavelength-reference> a schema:PropertyValue ;
        schema:value "1.466" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep pearson r = 1.0 1" ;
        dct:description "gate is r > 0.98; the reference stored here is that gate, not the measured r" ;
        schema:measurementTechnique "pearsonr(analytical λ, FFT λ) across six diffusivity scales" ;
        schema:name "wavelength sweep pearson r" ;
        schema:unitText "1" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-wavelength-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep rmse = 0.0 µm" ;
        dct:description "reference is the acceptance tolerance, not a copy of the RMSE" ;
        schema:measurementTechnique "RMSE of FFT wavelength against the analytical sqrt scaling" ;
        schema:name "wavelength sweep rmse" ;
        schema:unitText "µm" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> a schema:PropertyValue ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-willistoni-granules-across-epidermal-cell> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "willistoni granules across epidermal cell = 5.770805 1" ;
        dct:description "reference is the virilis predecessor count, which is larger" ;

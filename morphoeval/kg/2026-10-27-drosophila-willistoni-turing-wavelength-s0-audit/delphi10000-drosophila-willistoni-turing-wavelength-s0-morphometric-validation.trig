        schema:name "willistoni granules across epidermal cell" ;
        schema:unitText "1" ;
        schema:value "5.770805" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-willistoni-granules-across-epidermal-cell-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-measurement-willistoni-granules-across-epidermal-cell-reference> a schema:PropertyValue ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Acetabularia acetabulum Turing wavelength at 25.28 µm (Holocene, detail scale) — Code-to-model traceability: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Module docstring and jacobian/k_c functions name the Turing formula and the Dumais & Harrison conclusion. The parabolic refinement of the numerical peak and the polar remap are engineering, not a numbered equation in the papers." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-code-traceability-1> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Acetabularia acetabulum Turing wavelength at 25.28 µm (Holocene, detail scale) — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates the Brusselator and the Turing wavenumber k_c^2 = (D_v f_u + D_u g_v)/(2 D_u D_v). Trace, determinant and the equal-diffusion sign change are checked in --self-test. Diffusivities are chosen for the tier length rather than copied from a published table, so this is not a line-by-line parameter transcription." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-acetabularia-acetabulum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Acetabularia acetabulum Turing wavelength at 25.28 µm (Holocene, detail scale) — Morphometric validation: 86/100" ;

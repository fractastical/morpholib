<https://w3id.org/delphi/resource/math-law/delphi10000-acetabularia-acetabulum-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Homogeneous stability (trace)" ;
    dct:description "The unpatterned apex (the developmental predecessor of this scale) is linearly stable. | Variables: f_u = B-1, g_v = -A^2, A=2, B=2.9" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012; Brusselator steady state as used by Holloway & Harrison 2007 doi:10.1093/aob/mcm295" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd2c74bc/models/2026-delphi10000-acetabularia-acetabulum-turing-wavelength-s0.py#L96-L110>,
        <https://github.com/fractastical/morpholib/blob/bd2c74bc/morphoeval/lean/loops/Loop_3103_acetabularia_acetabulum_turing_wavelength_s0.lean#L16-L20> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "f_u + g_v < 0 at the Brusselator steady state (A, B/A)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/s0022-5193(88)80213-3>,
        <https://doi.org/10.1093/aob/mcm295>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2000.0565> ;
    pk:hypothesisType "Turing reaction-diffusion wavenumber" ;
    pk:leanDeclaration "MathOfBiology.Loop_3103.trace_c" ;
    pk:leanTheorem "MathOfBiology.Loop_3103.homogeneous_state_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acetabularia-acetabulum-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber k_c" ;
    dct:description "Wavelength selection at the 25.28 µm detail scale of the cap wall. | Variables: D_u = 10.20 µm^2/s, D_v = 122.4 µm^2/s, onset lambda = 22.67 µm, fastest mode = 25.43 µm" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd2c74bc/models/2026-delphi10000-acetabularia-acetabulum-turing-wavelength-s0.py#L112-L132>,
        <https://github.com/fractastical/morpholib/blob/bd2c74bc/morphoeval/lean/loops/Loop_3103_acetabularia_acetabulum_turing_wavelength_s0.lean#L22-L34> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/s0022-5193(88)80213-3>,
        <https://doi.org/10.1093/aob/mcm295>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2000.0565> ;
    pk:hypothesisType "Turing reaction-diffusion wavenumber" ;
    pk:leanDeclaration "MathOfBiology.Loop_3103.cross_term_nominal" ;
    pk:leanTheorem "MathOfBiology.Loop_3103.turing_discriminant_nominal" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acetabularia-acetabulum-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control. Noise decays. No pigment ridges. | Variables: D_u = D_v = 10.20 µm^2/s" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd2c74bc/models/2026-delphi10000-acetabularia-acetabulum-turing-wavelength-s0.py#L381-L386>,
        <https://github.com/fractastical/morpholib/blob/bd2c74bc/morphoeval/lean/loops/Loop_3103_acetabularia_acetabulum_turing_wavelength_s0.lean#L36-L40> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D_u = D_v implies D_v f_u + D_u g_v < 0, so det(k) stays positive" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/s0022-5193(88)80213-3>,
        <https://doi.org/10.1093/aob/mcm295>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2000.0565> ;
    pk:hypothesisType "Turing reaction-diffusion wavenumber" ;
    pk:leanDeclaration "MathOfBiology.Loop_3103.cross_term_equal_diffusion" ;
    pk:leanTheorem "MathOfBiology.Loop_3103.ablation_equal_diffusion_no_turing_band" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-acetabularia-acetabulum-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mode count on the detail patch" ;
    dct:description "What changes at this scale versus the unpatterned tip, and what does not change in a later chronospecies (there is none). | Variables: L = 8 * 25.28 µm, age = 0 Ma, no successor chronospecies" ;
    dct:source "Dumais & Harrison 2000 doi:10.1098/rstb.2000.0565" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/bd2c74bc/models/2026-delphi10000-acetabularia-acetabulum-turing-wavelength-s0.py#L79-L93>,
        <https://github.com/fractastical/morpholib/blob/bd2c74bc/morphoeval/lean/loops/Loop_3103_acetabularia_acetabulum_turing_wavelength_s0.lean#L49-L53> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = L / lambda_c = 8 on a 202.24 µm patch; 11 tiles give 88 ridges on a cap of radius 354 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/s0022-5193(88)80213-3>,
        <https://doi.org/10.1093/aob/mcm295>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1098/rstb.2000.0565> ;
    pk:hypothesisType "Turing reaction-diffusion wavenumber" ;
    pk:leanDeclaration "MathOfBiology.Loop_3103.mode_count" ;
    pk:leanTheorem "MathOfBiology.Loop_3103.eight_ridges_on_detail_patch" ;
    pk:leanVerified true .


        dct:title "Coupling between reaction-diffusion prepattern and expressed morphogenesis, applied to desmids and dasyclads" .
    <https://doi.org/10.1093/aob/mcm295> dct:date "2007"^^xsd:gYear ;
        dct:title "Pattern selection in plants: coupling chemical dynamics to surface growth in three dimensions" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;

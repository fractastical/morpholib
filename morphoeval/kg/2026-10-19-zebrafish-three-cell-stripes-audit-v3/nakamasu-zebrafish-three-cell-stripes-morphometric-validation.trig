    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-measurement-dense-s-iridophore-interstripe-occupancy-fraction-at-adult-stage-reference> a schema:PropertyValue ;
        dct:source "Frohnhoefer et al. (2013) Figs. 1-2; Singh et al. (2014) Nat Cell Biol 16:607 (dense iridophores confined to interstripes; qualitative)" ;

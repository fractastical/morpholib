    pk1:evidenceAgainst "2009-nakamasu-zebrafish-three-cell-stripes.py L1625–L1640: Hybrid acceptance thresholds tuned to default seeds <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L1625-L1640>" ;
    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package-2> ;
    pk1:hasScore 9.3e-01 ;
    pk1:hasVerdict "faithful" .


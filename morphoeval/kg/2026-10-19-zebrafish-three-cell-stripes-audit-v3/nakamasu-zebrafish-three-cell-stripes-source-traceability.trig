sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network + Volkening-Sandstede iridophore S/L agents on a growing flank, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Source and data traceability: 94/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "All 11 sources carry DOIs in the module docstring, the audit and `paper_citations.bib` (+7 entries); the new `iridophore_ontogeny_reference.json` records what each source was used for and declares its approximations; the two garbled candidate titles in `scout_manifest.json` were corrected and the correction is recorded in the file; all five dataset files are SHA-256 pinned and verified fail-closed at run time (L107-141). Deductions: the stripe-count table is an assessor reading of published descriptions rather than data with a page/figure pin (-4); the Parichy 2009 stage SL anchors are cited without page numbers (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability-4> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L107–L141" ;
        dct:description "EXPECTED_SHA256 pins for 5 files (v2 pins), verify_dataset_sha256 fail-closed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L107-L141> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/zebrafish_three_cell_stripes/iridophore_ontogeny_reference.json L1–L51" ;
        dct:description "7 sources with DOIs and used_for statements; confidence_note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/datasets/zebrafish_three_cell_stripes/iridophore_ontogeny_reference.json#L1-L51> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/zebrafish_three_cell_stripes/paper_citations.bib L45–L121" ;
        dct:description "7 Pass 3 BibTeX entries with DOIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/datasets/zebrafish_three_cell_stripes/paper_citations.bib#L45-L121> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/zebrafish_three_cell_stripes/scout_manifest.json L1–L52" ;
        dct:description "Corrected titles for Watanabe 2006 and Yamaguchi 2007 with pass3_correction note" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/datasets/zebrafish_three_cell_stripes/scout_manifest.json#L1-L52> .

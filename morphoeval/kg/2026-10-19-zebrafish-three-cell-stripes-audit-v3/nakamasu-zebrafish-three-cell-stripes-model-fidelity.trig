sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network + Volkening-Sandstede iridophore S/L agents on a growing flank, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Model fidelity to source: 89/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The Nakamasu core (exact J0, Routh-Hurwitz, dispersion, saturating 3-species PDE, L153-388) and the laser-ablation reproductions (L394-492) are unchanged and remain faithful. The remediation adds the requested mechanism in recognisable Volkening & Sandstede form: discrete iridophores with S/L state, environment-dependent switching, proliferation, dispersal and feedback, on a growing domain whose Lagrangian PDE carries the correct -2 (g'/g) u dilution and D/g^2 scaling (L778-786). Deductions: the whole-flank cos(k_c y) template that drives Panel B and the Fig. 3 regeneration run (L308-309, L468) imposes the 5-stripe count and orientation that v2 credited as emergent (-3); the iridophore rules are reduced (sigmoid of the continuum u - v instead of neighbour counts; no melanophore/xanthophore agents, no long-range iridophore -> melanophore term) (-3); gamma_u/gamma_v/gamma_L, rho_ref, step and division rates and the x-coherent kernel are calibration choices without source values, and the parallel-insertion outcome depends on that kernel (-3); insertion is by splitting of stretched stripes and symmetric, unlike the ventral-first marginal addition in vivo (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2009-nakamasu-zebrafish-three-cell-stripes.py L308–L309: Whole-flank cue_profile = myoseptum_cue * cos(k_c (y - L_y/2)) still templates Panel B; L468 repeats it for the Fig. 3 regeneration run — stripe count/orientation imposed, not emergent <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L308-L309>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-3> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L153–L388" ;
        dct:description "Exact 3-species Jacobian, Routh-Hurwitz invariants, dispersion curve, DCT-II IMEX 3-cell PDE (unchanged from v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L153-L388> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L636–L898" ;
        dct:description "simulate_hybrid_iridophore_growth: Lagrangian growing-flank PDE with dilution (L780-783), S<->L switching (L802-812), state-dependent motility and density-limited proliferation (L814-832), feedback terms (L785-786)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L636-L898> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean L131–L232" ;
        dct:description "Theorems 4-6 (+ mode_in_turing_band_scales, dilution_raises_p1), 0 sorrys, verified with lean 4.35.0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/morphoeval/lean/loops/Loop_007_zebrafish_three_cell_stripes.lean#L131-L232> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 007 Pass 3 autonomous loop assessor; Passes 1-2 assessed by Gemini 4 Argon)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


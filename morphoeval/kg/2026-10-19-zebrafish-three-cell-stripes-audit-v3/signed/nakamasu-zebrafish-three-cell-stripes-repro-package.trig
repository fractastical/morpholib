sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network + Volkening-Sandstede iridophore S/L agents on a growing flank, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic seeds for both the PDE noise and the agent RNG (bitwise two-run determinism of fields, states and positions is checked, L1642-1647); the 13-check `--self-test` runs in ~32 s and the default render in 13-25 s, well under the 3-minute budget; outputs are self-contained (12-panel PNG + 8-frame GIF); the environment is recorded above. Deductions: no requirements lock file is vendored for this slot (-3); the self-test thresholds for the hybrid (anisotropy > 5, aligned fraction >= 2/3, SL_first in [11, 16]) are tuned to the default seed set (-2); the README in the dataset directory documents the files but the top-level README section was not updated (outside this loop's allowed files) (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2009-nakamasu-zebrafish-three-cell-stripes.py L1625–L1640: Hybrid acceptance thresholds tuned to default seeds <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L1625-L1640>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L1559–L1657" ;
        dcterms:description "13-check self_test incl. Lean parity checks 9-10, hybrid checks 11-13 and bitwise determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L1559-L1657> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "datasets/zebrafish_three_cell_stripes/README.md L1–L39" ;
        dcterms:description "Dataset README documents all 5 files, pins and what the script computes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/datasets/zebrafish_three_cell_stripes/README.md#L1-L39> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 007 Pass 3 autonomous loop assessor; Passes 1-2 assessed by Gemini 4 Argon)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network + Volkening-Sandstede iridophore S/L agents on a growing flank, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Code-to-model traceability: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The Section 5b banner (L565-590) maps every agent rule to its source (Volkening & Sandstede 2015/2018, Singh 2014, Frohnhöfer 2013, Patterson & Parichy 2013, Parichy 2009, Crampin 1999) and to Lean Theorems 4-6; the math KG spec registers the three new laws with Lean loci and code loci; the docstring lists the known residuals. Deductions: the calibration constants (gamma_u 0.10, gamma_v 0.03, gamma_L 0.02, rho_ref 30, step_S/step_L, p_div, kernel sigmas, switch threshold 0.10) have no cited origin and are only described as calibration (-5); the stripe counter and juvenile-count heuristics (L605-634) are uncited conventions (-2); Panel B's template cue is disclosed on the panel but the Fig. 3 regeneration template at L468 is not (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2009-nakamasu-zebrafish-three-cell-stripes.py L655–L668: Hybrid calibration defaults (gamma_*, step_*, p_div_*, rho_ref, kernel sigmas) without cited values <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L655-L668>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L565–L594" ;
        dcterms:description "Section 5b banner: rule-by-rule source mapping and Lean theorem cross-references" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L565-L594> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L1–L76" ;

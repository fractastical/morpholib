        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L1-L76> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/nakamasu-zebrafish-three-cell-stripes.yaml L98–L152" ;

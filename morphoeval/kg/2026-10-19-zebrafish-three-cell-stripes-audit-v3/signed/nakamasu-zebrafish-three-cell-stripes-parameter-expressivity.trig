sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nakamasu-zebrafish-three-cell-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Nakamasu et al. (2009) 3-variable zebrafish pigment-cell reaction-diffusion network + Volkening-Sandstede iridophore S/L agents on a growing flank, laser-ablation polarity & leopard (cx41.8) spot-to-stripe morphospace — Parameter expressivity: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The leopard sweep and dual negative controls (L499-562) are retained; Pass 3 adds a growth-rate sweep (3 schedules), the iridophore-less, static-domain and no-switch controls and a 3-seed robustness check (L901-942), and the CLI is now actually wired: `--variant` runs the template PDE and the hybrid model with every kinetic and hybrid flag and prints a JSON summary (L1660-1726). Deductions: the v2 CLI parsed its flags but `main()` ignored them, so the v2 \"exposes full CLI flags\" credit was unearned (-3); the growth sweep behaves monotonically (faster growth delays the first insertion: SL 16.9 / 13.5 / 13.4 mm for fast / default / slow) but is shown only as stripe count vs SL with no rendered flanks along the sweep, and the kernel-anisotropy and feedback-strength calibrations are not swept at all (-4); `--variant` does not render a figure, so non-default parameter sets cannot be inspected visually (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2009-nakamasu-zebrafish-three-cell-stripes.py L1273–L1296: Panel J plots only stripe count vs SL per growth schedule; no rendered flanks along the sweep <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L1273-L1296>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L901–L942" ;
        dcterms:description "run_hybrid_growth_experiments: WT, no-iridophore, no-switch, static adult, growth sweep (0.4/0.8/1.0), 3-seed alignment fraction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L901-L942> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L1660–L1726" ;
        dcterms:description "CLI with kinetic + hybrid flags and --variant JSON summary; flags are now consumed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L1660-L1726> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-nakamasu-zebrafish-three-cell-stripes-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2009-nakamasu-zebrafish-three-cell-stripes.py L499–L562" ;
        dcterms:description "leopard 4-regime sweep and dual negative controls (unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/3aaa03d/2009-nakamasu-zebrafish-three-cell-stripes.py#L499-L562> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 007 Pass 3 autonomous loop assessor; Passes 1-2 assessed by Gemini 4 Argon)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


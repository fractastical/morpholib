<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Charnia masoni apical Turing wavelength at 140 µm (565 Ma) — Code-to-model traceability: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Module docstring Eqs. 1–8 name the kinetics, k_c, σ(k) and the glide shift. lean_integers_agree checks the same integers as Loop_3145 (f_u = 7383/10000, numerator 1350*7383 - 11449*62 > 0, wavenumber ratio strictly between 45 and 46). The chevron chart is labelled as an embedding, not as a second PDE." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

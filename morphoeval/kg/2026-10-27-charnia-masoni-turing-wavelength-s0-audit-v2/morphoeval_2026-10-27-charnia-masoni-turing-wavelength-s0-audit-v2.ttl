        <https://doi.org/10.1144/pygs.31.3.211> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3145.glideClosure" ;
    pk:leanTheorem "MathOfBiology.Loop_3145.glide_offset_is_half_period" ;

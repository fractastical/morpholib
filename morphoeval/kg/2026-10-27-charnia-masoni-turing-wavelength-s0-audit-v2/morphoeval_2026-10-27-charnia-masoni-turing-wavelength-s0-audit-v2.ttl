    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_detail = 1.404e-4 m < lambda_organ = 6.322e-3 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1073/pnas.1408542111>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1475-4983.2012.01164.x>,
        <https://doi.org/10.1126/sciadv.abe0291>,
        <https://doi.org/10.1144/0016-76492006-080>,
        <https://doi.org/10.1144/pygs.31.3.211> ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3145.detail_wavelength_finer_than_organ_sibling" ;
    pk:leanTheorem "MathOfBiology.Loop_3145.detail_wavelength_finer_than_organ_sibling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-charnia-masoni-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Glide reflection is a half-period offset" ;
    dct:description "Body-plan symmetry inherited from the apical mode onto the frond | Variables: delta = 70.2 µm, lambda = 140.4 µm" ;
    dct:source "Antcliffe & Brasier 2007 DOI:10.1144/0016-76492006-080; Brasier, Antcliffe & Liu 2012 DOI:10.1111/j.1475-4983.2012.01164.x" ;

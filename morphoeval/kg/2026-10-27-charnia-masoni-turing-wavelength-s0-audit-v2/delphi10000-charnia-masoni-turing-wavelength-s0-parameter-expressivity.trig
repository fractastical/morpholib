sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Charnia masoni apical Turing wavelength at 140 µm (565 Ma) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Scaling D_u and D_v together by {0.35, 0.6, 1, 1.7, 2.8, 4.5} moves the fastest-mode wavelength on a 1:1 line (Pearson r = 1.000, RMSE 3.26 µm). Commanded chevron angle from 15° to 85° moves the vertical share of Sobel energy monotonically (Pearson r = 0.995). The operating angle is an interior point of the CV probe, not the edge of the search." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py L245–L275" ;
        dct:description "fastest_k and the diffusivity sweep." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/96a891cfffcbf7fb81617c1df76c424d1d7359a5/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py#L245-L275> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py L365–L399" ;
        dct:description "vertical_gradient_fraction and the angle sweep." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/96a891cfffcbf7fb81617c1df76c424d1d7359a5/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py#L365-L399> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent, primary assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


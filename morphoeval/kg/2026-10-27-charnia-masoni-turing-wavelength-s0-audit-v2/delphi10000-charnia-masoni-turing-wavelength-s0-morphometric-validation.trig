sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Charnia masoni apical Turing wavelength at 140 µm (565 Ma) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Fastest-mode λ_m = 167.44 µm against the determinant-critical reference 140.4 µm (they differ because the run is above onset). Cast-versus-render orientation histograms have L1 = 0.283 and KS = 0.093. Slab occupancy profiles correlate at r = 0.800. Structure-tensor coherency is 0.456 on the cast and 0.380 on the render. No population of specimens and no direct 140 µm measurement on the fossil are claimed." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-detail-to-organ-wavenumber-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-euler-versus-analytic-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-equal-diffusion-control-peak-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-fastest-growing-apical-stripe-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-segmented-specimen-slab-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-specimen-versus-render-orientation-histogram-l1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-across-inhibitor-diffusivity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-detail-to-organ-wavenumber-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "detail-to-organ wavenumber ratio = 45.0285 k_detail / k_organ" ;
        dct:description "D_u = 1.426661e-12 m^2/s at tau = 120 s; age = 565 Ma" ;
        schema:measurementTechnique "0.006322 m / 0.0001404 m" ;
        schema:name "detail-to-organ wavenumber ratio" ;
        schema:unitText "k_detail / k_organ" ;
        schema:value "45.0285" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-detail-to-organ-wavenumber-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-detail-to-organ-wavenumber-ratio-reference> a schema:PropertyValue ;
        dct:source "integer bracket proved in Loop_3145.wavenumber_ratio_between_45_and_46" ;
        schema:value "45.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-euler-versus-analytic-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-curve Pearson r (Euler versus analytic sigma) = 0.9984 Pearson r" ;
        dct:description "RMSE of sigma = 0.02007; control sigma_max = -0.9004" ;
        schema:measurementTechnique "12-point σ(k) from Eq. 7 versus short explicit-Euler growth of the same cosine" ;
        schema:name "dispersion-curve Pearson r (Euler versus analytic sigma)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9984" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-euler-versus-analytic-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-euler-versus-analytic-sigma-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate for this loop (goodness of fit of the discrete PDE to the linear law)" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-equal-diffusion-control-peak-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control peak growth rate = -0.9004 1/time" ;
        dct:description "patterned sigma_max = 0.1964; profile amplitude ratio control/pattern = 0.0005" ;
        schema:measurementTechnique "same Euler probe with Du = Dv = 0.062" ;
        schema:name "equal-diffusion control peak growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.9004" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-equal-diffusion-control-peak-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-equal-diffusion-control-peak-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusivities must not destabilise a stable steady state" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-fastest-growing-apical-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "fastest-growing apical stripe wavelength = 167.44 µm" ;
        schema:measurementTechnique "2*pi/k_m where k_m maximises analytic sigma(k); the determinant-critical k_c is scaled so its wavelength is 140.4 µm, and above onset k_m is smaller" ;
        schema:name "fastest-growing apical stripe wavelength" ;
        schema:unitText "µm" ;
        schema:value "167.44" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-fastest-growing-apical-stripe-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-fastest-growing-apical-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Loop scale assignment 140 µm = 0.0001404 m (tier 5_primordium_100um)" ;
        schema:value "140.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-segmented-specimen-slab-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen slab foreground fraction = 0.5936 area fraction" ;
        schema:measurementTechnique "largest connected component of (R - B) above the 42nd percentile on the Tübingen cast resized to 720×540" ;
        schema:name "segmented specimen slab foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.5936" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-segmented-specimen-slab-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-segmented-specimen-slab-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-frame prior, not fitted to this cast" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.456 coherency" ;
        dct:description "render coherency = 0.3803. Occupancy Pearson r = 0.8005, occupancy RMSE = 0.2809" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Gaussian-smoothed structure tensor on the cast" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.456" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "same operator on the rendered last frame (model value stored as the reference so the two are not copied into one cell)" ;
        schema:value "0.3803" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-specimen-versus-render-orientation-histogram-l1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen versus render orientation-histogram L1 = 0.2825 L1" ;
        dct:description "KS statistic = 0.0932, KS p = 7.215e-10, chevron angle = 58.0 deg, angle-sweep Pearson = 0.9953" ;
        schema:measurementTechnique "12-bin Sobel orientation histograms inside the cast mask and the rendered slab" ;
        schema:name "specimen versus render orientation-histogram L1" ;
        schema:unitText "L1" ;
        schema:value "0.2825" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-specimen-versus-render-orientation-histogram-l1-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-specimen-versus-render-orientation-histogram-l1-reference> a schema:PropertyValue ;
        dct:source "identical histograms would score 0; the residual is the mismatch" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-across-inhibitor-diffusivity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength-sweep Pearson r across inhibitor diffusivity = 1.0 Pearson r" ;
        dct:description "RMSE = 3.264 µm" ;
        schema:measurementTechnique "Du and Dv scaled together by {0.35, 0.6, 1, 1.7, 2.8, 4.5}; analytic argmax of σ(k) versus the Euler argmax" ;
        schema:name "wavelength-sweep Pearson r across inhibitor diffusivity" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-across-inhibitor-diffusivity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-measurement-wavelength-sweep-pearson-r-across-inhibitor-diffusivity-reference> a schema:PropertyValue ;
        dct:source "same gate, parameter-regime sweep" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py L591–L670" ;
        dct:description "measure_morphoeval rows: wavelength, both Pearson r values, KS, coherency, occupancy." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/96a891cfffcbf7fb81617c1df76c424d1d7359a5/models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py#L591-L670> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-charnia-masoni-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "datasets/charnia_masoni_turing_wavelength_s0/charnia_masoni_specimen.jpg (generated output)" ;
        dct:description "Segmented cast used for the orientation and occupancy measurements. — datasets/charnia_masoni_turing_wavelength_s0/charnia_masoni_specimen.jpg: rendered output of models/2026-delphi10000-charnia-masoni-turing-wavelength-s0.py at 96a891cfffcbf7fb81617c1df76c424d1d7359a5, image/jpeg, 2588631 B, 1373×2970 px, artifact_sha256 c7e8d470af175675bb833454640f57719a042ccad2afa6f7662dd8d3d8158333 (sha256 c7e8d470af175675bb833454640f57719a042ccad2afa6f7662dd8d3d8158333), spec_fingerprint 571668419f3b61d8829b66959046ef157ab530e8516cc89e6ab7b1925a5766c7" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (Cursor cloud agent, primary assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;

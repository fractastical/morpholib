sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator and DeltaC-Notch synchronization — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L480-560): wild-type oscillation period T_osc = 30.01 min vs 30.0 min (DDE period = 33.62 min, mRNA amplitude = 22.9 molecules), supercritical Hopf critical delay threshold T_crit = 7.54 min vs 7.54 min (fixed point m* = 8.27, p* = 161.76), DeltaC-Notch wild-type synchronization order parameter R_sync = 0.9840 vs 0.965 (with Notch mutant preserving 6 anterior somites before dropping to R_sync = 0.2316), 5-regime Pearson correlation r = 0.9999 (p = 2.67e-7, RMSE = 0.174 min), and bilateral SEM specimen somite spacing 48.47 +/- 9.69 px (CV = 0.1999, symmetry ratio = 0.9605)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-supercritical-hopf-bifurcation-critical-delay-threshold-t-crit-t-m-t-p>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-zebrafish-her1-her7-delayed-oscillator-wild-type-period-t-osc-at-28-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "DeltaC-Notch wild-type PSM synchronization order parameter R_sync vs bea/des/aei mutant = 0.9835 Kuramoto R" ;
        dct:description "Notch mutant preserves 6 anterior somites before R_sync drops to 0.2316" ;
        schema:measurementTechnique "32-cell stochastic PSM phase-oscillator chain over 14 cycles (WT kappa=0.35 -> 14/14 intact somites vs Notch mutant kappa=0 -> 6 intact anterior somites, late R=0.2316)" ;
        schema:name "DeltaC-Notch wild-type PSM synchronization order parameter R_sync vs bea/des/aei mutant" ;
        schema:unitText "Kuramoto R" ;
        schema:value "0.9835" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant-reference> a schema:PropertyValue ;
        dct:source "Lewis (2003) Current Biology 13:1398-1408 Figs. 5-6 (Notch-coupled synchrony R > 0.95 vs bea/des/aei desynchronization after 5-7 anterior somites)" ;
        schema:value "0.965" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Lewis (2003) 5-regime segmentation clock period prediction Pearson correlation r = 0.9999 Pearson r" ;
        dct:description "p = 8.44e-07, RMSE = 0.172 min across [0, 36.5] min clock period range" ;
        schema:measurementTechnique "correlation across 5 delay perturbation regimes (WT her1/her7, pure her7 fast loop, pure her1 slow loop, Notch collective delay slowing, intron-deletion/CHX arrest; RMSE=0.172 min)" ;
        schema:name "Lewis (2003) 5-regime segmentation clock period prediction Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Lewis (2003) Current Biology 13:1398-1408; Giudicelli et al. (2007) PLoS Biology 5:e150; Herrgen et al. (2010) Current Biology 20:1244-1253" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-supercritical-hopf-bifurcation-critical-delay-threshold-t-crit-t-m-t-p> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "supercritical Hopf bifurcation critical delay threshold T_crit = T_m + T_p = 7.54 min" ;
        dct:description "wild-type total delay T_tot = 8.98 min = 1.19x T_crit" ;
        schema:measurementTechnique "exact characteristic root locus (lambda+b)(lambda+c) + K_loop*exp(-lambda*T_tot) = 0 around (m*=8.27, p*=161.76, omega_H=0.216 rad/min)" ;
        schema:name "supercritical Hopf bifurcation critical delay threshold T_crit = T_m + T_p" ;
        schema:unitText "min" ;
        schema:value "7.54" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-supercritical-hopf-bifurcation-critical-delay-threshold-t-crit-t-m-t-p-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-supercritical-hopf-bifurcation-critical-delay-threshold-t-crit-t-m-t-p-reference> a schema:PropertyValue ;
        dct:source "Lewis (2003) Current Biology 13:1398-1408 Appendix & Fig. 3 (critical delay threshold T_crit = 7.54 min for n=2, b=c=0.23 min^-1)" ;
        schema:value "7.54" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate embryo SEM specimen bilateral somite spacing S_obs = 48.4667 px" ;
        dct:description "bilateral symmetry ratio = 0.9606, std = 9.70 px, phase correlation r = 0.5629" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on zebrafish_somites_specimen.jpg (upper=8 somites, lower=9 somites, CV=0.2002)" ;
        schema:name "vertebrate embryo SEM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "48.4667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 vertebrate embryo SEM specimen (datasets/her1_her7_delayed_oscillator/zebrafish_somites_specimen.jpg)" ;
        schema:value "48.47" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-zebrafish-her1-her7-delayed-oscillator-wild-type-period-t-osc-at-28-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "zebrafish her1/her7 delayed oscillator wild-type period T_osc at 28 C = 30.01 min" ;
        dct:description "subcritical intron-deletion control (T_tot=2.0 min < T_crit) forms 0 late peaks; CHX translation block (a=0) arrests at m*=143.5 molecules" ;
        schema:measurementTechnique "Lewis (2003) Box 1 analytical period law + RK4 method-of-steps DDE integration (T_m=7.18 min, T_p=1.80 min, DDE period=33.62 min, mRNA amp=22.9 molecules)" ;
        schema:name "zebrafish her1/her7 delayed oscillator wild-type period T_osc at 28 C" ;
        schema:unitText "min" ;
        schema:value "30.01" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-zebrafish-her1-her7-delayed-oscillator-wild-type-period-t-osc-at-28-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-zebrafish-her1-her7-delayed-oscillator-wild-type-period-t-osc-at-28-c-reference> a schema:PropertyValue ;
        dct:source "Lewis (2003) Current Biology 13:1398-1408 Box 1 & Fig. 2 (~30 min somite clock period in Danio rerio at 28 C)" ;
        schema:value "30.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L480–L560" ;
        dct:description "5 quantitative MorphoEval measurements with analytical and empirical references, Kuramoto R, Pearson r, and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-lewis-her1-her7-delayed-oscillator.py#L480-L560> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


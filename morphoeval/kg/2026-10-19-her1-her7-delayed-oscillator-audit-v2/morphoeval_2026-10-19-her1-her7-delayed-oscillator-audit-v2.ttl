<https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator and DeltaC-Notch synchronization — Morphometric validation: 91/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L480-560): wild-type oscillation period T_osc = 30.01 min vs 30.0 min (DDE period = 33.62 min, mRNA amplitude = 22.9 molecules), supercritical Hopf critical delay threshold T_crit = 7.54 min vs 7.54 min (fixed point m* = 8.27, p* = 161.76), DeltaC-Notch wild-type synchronization order parameter R_sync = 0.9840 vs 0.965 (with Notch mutant preserving 6 anterior somites before dropping to R_sync = 0.2316), 5-regime Pearson correlation r = 0.9999 (p = 2.67e-7, RMSE = 0.174 min), and bilateral SEM specimen somite spacing 48.47 +/- 9.69 px (CV = 0.1999, symmetry ratio = 0.9605)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-deltac-notch-wild-type-psm-synchronization-order-parameter-r-sync-vs-bea-des-aei-mutant>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-lewis-2003-5-regime-segmentation-clock-period-prediction-pearson-correlation-r>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-supercritical-hopf-bifurcation-critical-delay-threshold-t-crit-t-m-t-p>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-measurement-zebrafish-her1-her7-delayed-oscillator-wild-type-period-t-osc-at-28-c>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-morphometric-validation-1> ;

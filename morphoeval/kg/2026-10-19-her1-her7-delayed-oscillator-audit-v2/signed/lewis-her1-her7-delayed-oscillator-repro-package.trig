        rdfs:label "docs/media/her1_her7_delayed_oscillator_growth.gif (generated output)" ;
        dcterms:description "24-frame animated GIF comparing wild-type Notch-coupled vs bea/des/aei uncoupled somite segmentation — docs/media/her1_her7_delayed_oscillator_growth.gif: rendered output of 2003-lewis-her1-her7-delayed-oscillator.py at 317bc3c, image/gif, 1028899 B, 940×540 px, 24 frames, artifact_sha256 dfd39ca4ba800fbce6452a407c3692b11c9420e2a00b2268f92b0460907c140e (sha256 dfd39ca4ba800fbce6452a407c3692b11c9420e2a00b2268f92b0460907c140e), spec_fingerprint aac320679fac08d48974a97790e40f0dc67f5f375d8c0e064bf33e9bb39965c7" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator and DeltaC-Notch synchronization — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2003`), standalone `--self-test` suite verifying SHA-256 dataset integrity, Hopf critical threshold T_crit = 7.54 min, total delay invariance (T_m - delta, T_p + delta), subcritical intron-deletion damping (0 late peaks), cycloheximide arrest (a = 0 -> m* = k/c), bitwise two-run PSM synchrony determinism (`atol=0.0`), Notch mutant 6-somite anterior preservation, and specimen segmentation (`run_self_test`, L780-845), plus rendered PNG and GIF outputs in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .


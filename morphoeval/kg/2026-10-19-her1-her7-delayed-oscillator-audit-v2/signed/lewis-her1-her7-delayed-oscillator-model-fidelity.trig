sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lewis-her1-her7-delayed-oscillator> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L115–L255" ;
        dcterms:description "RK4 method-of-steps DDE solver, fixed-point root finder, and exact Hopf threshold T_crit = 7.54 min" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-lewis-her1-her7-delayed-oscillator.py#L115-L255> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2003-lewis-her1-her7-delayed-oscillator.py L305–L395" ;
        dcterms:description "32-cell stochastic DeltaC-Notch coupled PSM simulator reproducing WT synchrony and bea/des/aei 6-somite anterior preservation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2003-lewis-her1-her7-delayed-oscillator.py#L305-L395> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean L27–L98" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for protein balance, delay invariance, period sensitivity, and Notch phase contraction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean#L27-L98> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Lewis (2003) zebrafish her1/her7 autoinhibitory delay differential oscillator and DeltaC-Notch synchronization — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements Lewis's (2003) single-cell her1/her7 autoinhibitory DDEs dp/dt = a m(t - T_p) - b p(t) and dm/dt = k / (1 + (p(t - T_m)/p_0)^n) - c m(t), exact characteristic-root Hopf bifurcation threshold T_crit = 7.54 min, Box 1 period law, and multicellular DeltaC-Notch stochastic synchronization (L115-395), verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_022_her1_her7_delayed_oscillator.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lewis-her1-her7-delayed-oscillator-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


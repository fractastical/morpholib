sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Danio rerio Holocene 24.08 µm anisotropic Schnakenberg wavelength (pass 2) — Morphological realism / specimen match: 80/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure now places the fish-mask composite next to the photograph, and the GIF stripes are bimodal in the specimen dark/light palette rather than a gray sinusoid. Computer-vision similarity rose from 74.5 to 77.8. The eye, blue iridescence, and the adult count of four or five stripes are still absent; the composite shows the six wavelengths of the 144.48 µm window." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/danio_rerio_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "specimen, mask composite, and unwrapped field — docs/media/danio_rerio_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 386615 B, 1716×924 px, artifact_sha256 71b3259f10bb6add771cc22f7329df46c530d873ced69f4a8c730d9e4eef9dae (sha256 71b3259f10bb6add771cc22f7329df46c530d873ced69f4a8c730d9e4eef9dae), spec_fingerprint d7d1a6ee4915a8532ac3ba145d5dd7b6436e0f7006bd83ec8bd0ab39b939e0f7" .

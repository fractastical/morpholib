sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Danio rerio Holocene 24.08 µm anisotropic Schnakenberg wavelength (pass 2) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "On the 11 exact modes, Pearson r = 0.9805 and RMSE = 0.0191. The KS statistic is 0.273 against a ceiling of 0.40, so the pass-1 coincidence of D with its own reference is gone. GIF coherency 0.4399 is not the specimen coherency 0.3887, and the predecessor wavelength is 20.64 µm against the rerio target 24.08 µm. The correlation clears 0.98 with little room; one low-k mode still sits off the analytical curve." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-of-pde-growth-versus-analytical-sigma-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-dispersion-rmse-between-analytical-and-numerical-growth-rates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-equal-diffusion-negative-control-field-amplitude>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-kolmogorov-smirnov-statistic-of-analytical-versus-numerical-growth-rate-samples>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-predecessor-danio-nigrofasciatus-dominant-wavelength-at-anisotropy-1-12>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction-versus-gif-occupancy>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-selected-dorsoventral-wavelength-of-the-holocene-danio-rerio-field>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-of-the-rendered-gif>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-of-pde-growth-versus-analytical-sigma-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-curve Pearson r of PDE growth versus analytical sigma(k) = 0.980483 Pearson r" ;
        dct:description "RMSE = 0.019055" ;
        schema:measurementTechnique "log-amplitude growth between t=2 and t=14 versus sigma_mode on the 11 exact DV Fourier modes" ;
        schema:name "dispersion-curve Pearson r of PDE growth versus analytical sigma(k)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.980483" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-of-pde-growth-versus-analytical-sigma-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-of-pde-growth-versus-analytical-sigma-k-reference> a schema:PropertyValue ;
        dct:source "self-test gate; the reference is the acceptance threshold, not the measured r" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-dispersion-rmse-between-analytical-and-numerical-growth-rates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE between analytical and numerical growth rates = 0.019055 1/time" ;
        schema:measurementTechnique "root mean square of sigma_analytical - sigma_numerical" ;
        schema:name "dispersion RMSE between analytical and numerical growth rates" ;
        schema:unitText "1/time" ;
        schema:value "0.019055" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-dispersion-rmse-between-analytical-and-numerical-growth-rates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-dispersion-rmse-between-analytical-and-numerical-growth-rates-reference> a schema:PropertyValue ;
        dct:source "acceptance ceiling used by the self-test, not the measured residual" ;
        schema:value "0.02" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-equal-diffusion-negative-control-field-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion negative-control field amplitude = 0.0 concentration std" ;
        schema:measurementTechnique "Dv_x = Dv_y = Du = 0.80, same gamma, 800 steps" ;
        schema:name "equal-diffusion negative-control field amplitude" ;
        schema:unitText "concentration std" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-equal-diffusion-negative-control-field-amplitude-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-equal-diffusion-negative-control-field-amplitude-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusivities cannot destabilise a stable steady state" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-kolmogorov-smirnov-statistic-of-analytical-versus-numerical-growth-rate-samples> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Kolmogorov-Smirnov statistic of analytical versus numerical growth-rate samples = 0.272727 KS D" ;
        dct:description "two-sided p = 0.8326" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on the 11 exact-mode sigma samples" ;
        schema:name "Kolmogorov-Smirnov statistic of analytical versus numerical growth-rate samples" ;
        schema:unitText "KS D" ;
        schema:value "0.272727" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-kolmogorov-smirnov-statistic-of-analytical-versus-numerical-growth-rate-samples-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-kolmogorov-smirnov-statistic-of-analytical-versus-numerical-growth-rate-samples-reference> a schema:PropertyValue ;
        dct:source "pre-registered ceiling on a 20-wavenumber sample; a smaller D is a closer fit" ;
        schema:value "0.4" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-predecessor-danio-nigrofasciatus-dominant-wavelength-at-anisotropy-1-12> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "predecessor Danio nigrofasciatus dominant wavelength at anisotropy 1.12 = 20.64 µm" ;
        dct:description "predecessor gradient anisotropy = 1.181" ;
        schema:measurementTechnique "same grid and seed, inhibitor anisotropy 1.12, no phase cue" ;
        schema:name "predecessor Danio nigrofasciatus dominant wavelength at anisotropy 1.12" ;
        schema:unitText "µm" ;
        schema:value "20.64" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-predecessor-danio-nigrofasciatus-dominant-wavelength-at-anisotropy-1-12-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-predecessor-danio-nigrofasciatus-dominant-wavelength-at-anisotropy-1-12-reference> a schema:PropertyValue ;
        dct:source "the rerio target; the predecessor is not expected to lock the same harmonic" ;
        schema:value "24.08" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction-versus-gif-occupancy> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "segmented specimen foreground fraction versus GIF occupancy = 0.4107 area fraction" ;
        dct:description "specimen aspect ratio (length/height) = 2.347" ;
        schema:measurementTechnique "fraction of GIF pixels darker than 0.90 after fish-mask rendering" ;
        schema:name "segmented specimen foreground fraction versus GIF occupancy" ;
        schema:unitText "area fraction" ;
        schema:value "0.4107" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction-versus-gif-occupancy-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-segmented-specimen-foreground-fraction-versus-gif-occupancy-reference> a schema:PropertyValue ;
        dct:source "binary mask segmented from danio_rerio_specimen.jpg" ;
        schema:value "0.4104" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-selected-dorsoventral-wavelength-of-the-holocene-danio-rerio-field> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected dorsoventral wavelength of the Holocene Danio rerio field = 24.08 µm" ;
        dct:description "six wavelengths span Ly when the mode index is 6" ;
        schema:measurementTechnique "argmax of the x-averaged Fourier profile on the 144.48 µm window" ;
        schema:name "selected dorsoventral wavelength of the Holocene Danio rerio field" ;
        schema:unitText "µm" ;
        schema:value "24.08" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-selected-dorsoventral-wavelength-of-the-holocene-danio-rerio-field-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-selected-dorsoventral-wavelength-of-the-holocene-danio-rerio-field-reference> a schema:PropertyValue ;
        dct:source "slot scale 2.408e-05 m; reported only as the target, the measured mode is an integer harmonic" ;
        schema:value "24.08" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-of-the-rendered-gif> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-image structure-tensor coherency of the rendered GIF = 0.4396 coherency" ;
        dct:description "simulation and specimen values are measured separately" ;
        schema:measurementTechnique "Sobel structure tensor on the last GIF frame" ;
        schema:name "specimen-image structure-tensor coherency of the rendered GIF" ;
        schema:unitText "coherency" ;
        schema:value "0.4396" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-of-the-rendered-gif-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-of-the-rendered-gif-reference> a schema:PropertyValue ;
        dct:source "same operator on the vendored Danio rerio photograph" ;
        schema:value "0.3887" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py L179–L232" ;
        dct:description "DFT-mode dispersion fit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py#L179-L232> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py L448–L530" ;
        dct:description "measurement rows; KS ceiling 0.40 is not the measured D" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py#L448-L530> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (slot 3164 builder-assessor, pass 2; no second assessor)" ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Danio rerio Holocene 24.08 µm anisotropic Schnakenberg wavelength (pass 2) faithfully reproduces Danio rerio morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py, docs/media/danio_rerio_turing_wavelength_s0_growth.gif implement the cited source model as published and produce forms that match real Danio rerio specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/docs/media/danio_rerio_turing_wavelength_s0_growth.gif>,
            <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py, https://github.com/fractastical/morpholib/blob/main/docs/media/danio_rerio_turing_wavelength_s0_growth.gif; output: docs/media/danio_rerio_turing_wavelength_s0_comparison.png; organism: Danio rerio; environment: python 3.12.3, numpy 2.5.4, scipy 1.18.1, matplotlib 3.11.2, Pillow 13.0.0; claim_boundary: [reported_in_source: Turing 1952: two-species reaction-diffusion selects a critical wavenumber when the inhibitor out-diffuses the activator. | Nakamasu et al. 2009: zebrafish melanophores and xanthophores are a short-range activation / long-range inhibition pair. | Hiscock & Megason 2015: anisotropy orients stripes by removing one axis from the unstable band. | Quigley et al. 2004 and Patterson et al. 2014: D. nigrofasciatus is broken-striped or spotted relative to D. rerio.; reconstructed_in_script: Anisotropic Schnakenberg integration on a 288.96 × 144.48 µm window with Dv_y/Dv_x = 3.85 for D. rerio and 1.12 for the predecessor. | Growth-rate comparison on exact y-DFT modes, anisotropy sweep, equal-diffusion ablation, and three noise seeds. | Specimen mask segmentation and a bimodal pigment composite of the simulated field.; transfer_boundary: The 144.48 µm cellular window is magnified onto the adult outline. Adult stripes are not 24.08 µm wide. | gamma is calibrated so the dispersion peak lies on the assigned scale.; does_not_claim: That the gray-brown composite reproduces iridophore iridescence or the eye. | That the predecessor was measured at 24.08 µm; the contrast is the anisotropy mechanism at this assigned scale. | A cryptographic nanopublication signature.]; phenomenon_size: 20 µm (2.018e-05 m, log10=-4.695 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 20 µm to 4.5 cm): 20 µm:danio-aesculapii-bioelectric-polarity, 63 µm:danio-aesculapii-vertex-packing, 1.0 mm:danio-aesculapii-turing-wavelength, 2.0 mm:danio-aesculapii-clock-wavefront, 4.5 mm:danio-aesculapii-morphogen-condensation, 5.5 mm:danio-aesculapii-elastic-buckling, 6.3 mm:danio-aesculapii-flux-canalization, 8.8 mm:danio-aesculapii-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.cels.2015.12.001>,
            <https://doi.org/10.1038/ncomms6299>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/dev.01526> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/danio_rerio_turing_wavelength_s0_growth.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/danio_rerio_turing_wavelength_s0_growth.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cels.2015.12.001>,
            <https://doi.org/10.1038/ncomms6299>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/dev.01526> .
    <https://doi.org/10.1016/j.cels.2015.12.001> dct:date "2015"^^xsd:gYear ;
        dct:title "Orientation of Turing-like Patterns by Morphogen Gradients and Tissue Anisotropies" .
    <https://doi.org/10.1038/ncomms6299> dct:date "2014"^^xsd:gYear ;
        dct:title "Pigment cell interactions and differential xanthophore recruitment underlying zebrafish stripe reiteration and Danio pattern evolution" .
    <https://doi.org/10.1073/pnas.0808622106> dct:date "2009"^^xsd:gYear ;
        dct:title "Interactions between zebrafish pigment cells responsible for the generation of Turing patterns" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1242/dev.01526> dct:date "2004"^^xsd:gYear ;
        dct:title "Pigment pattern evolution by differential deployment of neural crest and post-embryonic melanophore lineages in Danio fishes" .
}


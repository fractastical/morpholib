    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-repro-package-1> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .


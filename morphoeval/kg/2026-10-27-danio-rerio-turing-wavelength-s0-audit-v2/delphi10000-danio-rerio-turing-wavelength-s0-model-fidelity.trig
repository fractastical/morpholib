sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Danio rerio Holocene 24.08 µm anisotropic Schnakenberg wavelength (pass 2) — Model fidelity to source: 87/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The integrator and the analytical eigenvalue are unchanged from pass 1. Pass 2 measures growth on the exact dorsoventral DFT modes of the window, which are the eigenfunctions of the discrete Laplacian the solver uses. gamma remains a scale calibration rather than a transcribed Nakamasu parameter." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py L85–L94" ;
        dct:description "analytical dispersion eigenvalue" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py#L85-L94> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-rerio-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py L179–L190" ;
        dct:description "exact y-DFT modes used for the growth-rate comparison" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-danio-rerio-turing-wavelength-s0.py#L179-L190> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (slot 3164 builder-assessor, pass 2; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cels.2015.12.001>,
            <https://doi.org/10.1038/ncomms6299>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/dev.01526> .
    <https://doi.org/10.1016/j.cels.2015.12.001> dct:date "2015"^^xsd:gYear ;
        dct:title "Orientation of Turing-like Patterns by Morphogen Gradients and Tissue Anisotropies" .
    <https://doi.org/10.1038/ncomms6299> dct:date "2014"^^xsd:gYear ;
        dct:title "Pigment cell interactions and differential xanthophore recruitment underlying zebrafish stripe reiteration and Danio pattern evolution" .
    <https://doi.org/10.1073/pnas.0808622106> dct:date "2009"^^xsd:gYear ;
        dct:title "Interactions between zebrafish pigment cells responsible for the generation of Turing patterns" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1242/dev.01526> dct:date "2004"^^xsd:gYear ;
        dct:title "Pigment pattern evolution by differential deployment of neural crest and post-embryonic melanophore lineages in Danio fishes" .
}


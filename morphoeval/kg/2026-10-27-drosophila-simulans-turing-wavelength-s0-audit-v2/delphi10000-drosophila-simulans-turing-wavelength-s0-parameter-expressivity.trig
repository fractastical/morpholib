sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila simulans 1.92 µm Turing carrier on the posterior-lobe arc (pass 2) — Parameter expressivity: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Raising γ/γ_simulans from 0.5 to 3 shortens λ_c from 2.72 µm to 1.11 µm. Raising Du from 0.02 to 0.40 lengthens λ_c from 1.19 µm to 7.44 µm while h stays positive. Both sweeps are monotonic and are the chronoseries lever (silvestris γ ratio 0.529, subobscura 1.44)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-simulans-turing-wavelength-s0.py L404–L417" ;
        dct:description "parameter_sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-simulans-turing-wavelength-s0.py#L404-L417> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_simulans_turing_wavelength_s0/drosophila_simulans_turing_wavelength_s0_metrics.json (generated output)" ;
        dct:description "gamma and Du rows — datasets/drosophila_simulans_turing_wavelength_s0/drosophila_simulans_turing_wavelength_s0_metrics.json: rendered output of models/2026-delphi10000-drosophila-simulans-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, application/json, 5083 B, artifact_sha256 049bd46e61a8d7b7a191ca32ab488ed7fe0e056999a0ef6689fc840c255c6f41 (sha256 049bd46e61a8d7b7a191ca32ab488ed7fe0e056999a0ef6689fc840c255c6f41), spec_fingerprint 60c689b8831f2a33a5b5821273a9d442392ad8ba957aa7d326024097a96f04cd" .

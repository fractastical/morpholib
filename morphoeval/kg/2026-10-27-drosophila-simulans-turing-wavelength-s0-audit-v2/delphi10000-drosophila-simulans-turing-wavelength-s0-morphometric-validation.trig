sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila simulans 1.92 µm Turing carrier on the posterior-lobe arc (pass 2) — Morphometric validation: 91/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Odd-radius holdout Pearson r is 0.9895 against the pass-1 in-sample reference 0.9825. RMSE is 4.07 versus null 28.16. KS is 0.096. The plate annulus is 67.57 µm, not the 1.92 µm detail reference. Otsu dark-annulus fraction is 0.650 versus a 0.5 baseline. Predecessor wavelength 2.64 µm is stored against the focal 1.92 µm reference." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-held-out-radial-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-radial-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-weakly-nonlinear-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-silvestris-predecessor-detail-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-dark-annulus-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-radial-annulus-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude ratio = 0.007796 std ratio" ;
        dct:description "max growth Turing 0.3758; equal-D -0.1428" ;
        schema:measurementTechnique "std(u) with Du=Dv divided by std(u) at the Turing diffusivity ratio, same γ and seed" ;
        schema:name "equal-diffusion ablation amplitude ratio" ;
        schema:unitText "std ratio" ;
        schema:value "0.007796" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "ratio 1 would mean the ablation failed to suppress the pattern" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-held-out-radial-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pass-2 held-out radial Pearson r = 0.989464 correlation" ;
        dct:description "odd-radius holdout; not equal to the in-sample pass-2 correlation" ;
        schema:measurementTechnique "3-harmonic mode fit on even radii, Pearson r on odd radii of the specimen plate" ;
        schema:name "pass-2 held-out radial Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.989464" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-held-out-radial-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-held-out-radial-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pass-1 in-sample single-harmonic Pearson r on the same plate" ;
        schema:value "0.982532" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-radial-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pass-2 radial RMSE = 4.067774 luminance" ;
        dct:description "KS statistic 0.0958" ;
        schema:measurementTechnique "root mean square residual of the 3-harmonic radial mode" ;
        schema:name "pass-2 radial RMSE" ;
        schema:unitText "luminance" ;
        schema:value "4.067774" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-radial-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-radial-rmse-reference> a schema:PropertyValue ;
        dct:source "null model is the mean luminance of the same profile" ;
        schema:value "28.158004" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-weakly-nonlinear-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pass-2 weakly nonlinear Pearson r = 0.98951 correlation" ;
        dct:description "RMSE 4.068 versus null RMSE 28.158" ;
        schema:measurementTechnique "specimen radial luminance versus 3-harmonic Schnakenberg mode at the plate's measured k" ;
        schema:name "pass-2 weakly nonlinear Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.98951" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-weakly-nonlinear-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-pass-2-weakly-nonlinear-pearson-r-reference> a schema:PropertyValue ;
        dct:source "pass-1 single-harmonic Pearson r, same k, cubic background" ;
        schema:value "0.982532" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-silvestris-predecessor-detail-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "silvestris predecessor detail wavelength = 2.64 µm" ;
        dct:description "mode count on the 96 µm arc is 36 versus 50" ;
        schema:measurementTechnique "reconstructed γ retuning (11/8)·1.92 µm on picture-wing cuticle that lacks a posterior lobe" ;
        schema:name "silvestris predecessor detail wavelength" ;
        schema:unitText "µm" ;
        schema:value "2.64" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-silvestris-predecessor-detail-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-silvestris-predecessor-detail-wavelength-reference> a schema:PropertyValue ;
        dct:source "focal slot wavelength, not a silvestris measurement" ;
        schema:value "1.92" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-dark-annulus-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen dark-annulus fraction = 0.649958 area fraction" ;
        dct:description "Otsu threshold 105.59; moment circularity 0.3957" ;
        schema:measurementTechnique "Otsu threshold on luminance above the caption band; fraction darker than the threshold" ;
        schema:name "specimen dark-annulus fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.649958" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-dark-annulus-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-dark-annulus-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-field baseline, not the measured fraction" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-radial-annulus-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial annulus wavelength = 67.567568 µm" ;
        dct:description "granules of 1.92 µm per annulus = 35.191" ;
        schema:measurementTechnique "azimuthal mean of the species plate; dominant period converted with the 100 µm scale bar" ;
        schema:name "specimen radial annulus wavelength" ;
        schema:unitText "µm" ;
        schema:value "67.567568" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-radial-annulus-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-radial-annulus-wavelength-reference> a schema:PropertyValue ;
        dct:source "plate legend is 100 µm; detail law λ_c = 1.92 µm is a different scale" ;
        schema:value "1.92" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.30021 coherency" ;
        dct:description "plate versus rendered radial mode; the two numbers are computed separately" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the blurred structure tensor on the plate interior" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.30021" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "same operator on the last GIF frame interior" ;
        schema:value "0.368368" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-simulans-turing-wavelength-s0.py L179–L186" ;

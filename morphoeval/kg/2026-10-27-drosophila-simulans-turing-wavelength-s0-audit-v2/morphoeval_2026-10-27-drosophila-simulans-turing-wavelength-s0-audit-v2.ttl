<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-simulans-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber at 1.92 µm" ;
    dct:description "Selects the detail-scale pigment-granule wavelength on the simulans posterior lobe | Variables: Du, Dv, fu, gv, γ; focal λ_c = 1.92 µm at 0 Ma" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012; Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-simulans-turing-wavelength-s0.py#L97-L111>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3205_drosophila_simulans_turing_wavelength_s0.lean#L62-L72> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = γ (D_v f_u + D_u g_v) / (2 D_u D_v),  λ_c = 2π/k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.devcel.2015.08.005>,
        <https://doi.org/10.1093/molbev/msaa232>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.287.5451.308>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion / Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3205.diffusion_drive_positive" ;
    pk:leanTheorem "MathOfBiology.Loop_3205.turing_discriminant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-simulans-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavelength order at fixed kinetics" ;
    dct:description "What changes versus the predecessor silvestris and the successor subobscura at this scale | Variables: γ retuned as 1/λ^2; Du and Dv held fixed" ;
    dct:source "Glassford 2015 doi:10.1016/j.devcel.2015.08.005; Edwards 2007 doi:10.1371/journal.pone.0000487; Huey 2000 doi:10.1126/science.287.5451.308" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-simulans-turing-wavelength-s0.py#L378-L402>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3205_drosophila_simulans_turing_wavelength_s0.lean#L30-L37> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_subobscura = 1.60 µm < λ_simulans = 1.92 µm < λ_silvestris = 2.64 µm; N(96 µm) = 60, 50, 36" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.devcel.2015.08.005>,
        <https://doi.org/10.1093/molbev/msaa232>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.287.5451.308>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion / Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3205.modeCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3205.mode_count_orders_the_chronoseries" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-simulans-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal diffusivity blocks wavelength selection" ;
    dct:description "Negative control for the detail-scale Turing instability | Variables: integer Jacobian fu=4, gv=-5, Du=Dv=20" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-simulans-turing-wavelength-s0.py#L419-L442>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3205_drosophila_simulans_turing_wavelength_s0.lean#L74-L78> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Du = Dv implies h = Du (f_u + g_v) < 0 when trace(J) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.devcel.2015.08.005>,
        <https://doi.org/10.1093/molbev/msaa232>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.287.5451.308>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion / Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3205.diffusionless_trace_is_stable" ;
    pk:leanTheorem "MathOfBiology.Loop_3205.equal_diffusivity_blocks_wavelength_selection" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-simulans-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Posterior lobe is absent in both chronoseries neighbours" ;
    dct:description "The 1.92 µm carrier is expressed on a structure the neighbours do not have | Variables: species index 0, 1, 2" ;
    dct:source "Glassford 2015 doi:10.1016/j.devcel.2015.08.005; Hagen 2020 doi:10.1093/molbev/msaa232" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-simulans-turing-wavelength-s0.py#L54-L66>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3205_drosophila_simulans_turing_wavelength_s0.lean#L41-L48> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "posteriorLobe(silvestris)=0, posteriorLobe(simulans)=1, posteriorLobe(subobscura)=0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.devcel.2015.08.005>,
        <https://doi.org/10.1093/molbev/msaa232>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.287.5451.308>,
        <https://doi.org/10.1371/journal.pone.0000487> ;
    pk:hypothesisType "Schnakenberg reaction-diffusion / Turing wavenumber k_c" ;
    pk:leanDeclaration "MathOfBiology.Loop_3205.posteriorLobePresent" ;
    pk:leanTheorem "MathOfBiology.Loop_3205.posterior_lobe_is_simulans_novelty" ;
    pk:leanVerified true .


<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila simulans 1.92 µm Turing carrier on the posterior-lobe arc (pass 2) — Model fidelity to source: 88/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "γ is solved so critical_wavelength returns 1.92 µm to numerical noise. Equal diffusivities give max growth -0.143 and an amplitude ratio 0.0078. The radial solver's k is 4.8% below the infinite-line k_c; the code records that ratio as a bounded-disk shift rather than tuning it away. The GIF is the weakly nonlinear radial mode, not a saturated 2D field." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-simulans-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;

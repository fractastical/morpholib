        <https://w3id.org/delphi/resource/evidence/2026-10-19-differential-interfacial-tension-sorting-audit-v3-brodland-differential-interfacial-tension-sorting-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-differential-interfacial-tension-sorting-audit-v3-brodland-differential-interfacial-tension-sorting-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-differential-interfacial-tension-sorting-audit-v3-brodland-differential-interfacial-tension-sorting-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-differential-interfacial-tension-sorting-audit-v3-brodland-differential-interfacial-tension-sorting-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-differential-interfacial-tension-sorting-audit-v3-brodland-differential-interfacial-tension-sorting-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-differential-interfacial-tension-sorting-audit-v3-brodland-differential-interfacial-tension-sorting-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-differential-interfacial-tension-sorting-audit-v3-brodland-differential-interfacial-tension-sorting-8>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-differential-interfacial-tension-sorting-audit-v3-brodland-differential-interfacial-tension-sorting-9> ;
    pk:hypothesisType "Differential Interfacial Tension Hypothesis (DITH) & Young-Dupré Cell-Doublet Mechanics" ;
    pk:weightOfEvidence 8.92e-01 .


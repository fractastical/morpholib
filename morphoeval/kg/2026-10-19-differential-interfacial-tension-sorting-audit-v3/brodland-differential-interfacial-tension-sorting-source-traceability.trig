sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting, with time-dependent Nodal/TGF-beta coupling (Pass 3) — Source and data traceability: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`datasets/differential_interfacial_tension_sorting/` carries the SHA-256-pinned specimen (verified at runtime, L112-L130), a reference JSON with 12 sources, the regime table, Young-Dupré checkpoints and a new `nodal_tgfb_cortical_tension_coupling_pass3` block that lists every Nodal parameter and its literature anchor with an explicit status (standard / experimental design / approximate recalled / qualitative), 12 BibTeX entries, a README with the formulas and a reduction disclosure, and the scout manifest. Pass 3 corrected the v2 heterotypic adhesion entries that contradicted the gamma_het = 30 anchor. Deductions: the 7 Pass 3 DOIs were recorded offline and are flagged `doi_verification: not resolved` in the JSON (-5); the key quantitative anchors (5 tiers, tiers 1-2 endoderm) are recalled, not digitised from the cited figures (-3); the Krieg AFM values 50/95/130 pN/um are carried from v2 without a figure/table pin (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L112–L130" ;
        dct:description "Runtime SHA-256 verification of the specimen against both the script constant and the JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L112-L130> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/differential_interfacial_tension_sorting/differential_interfacial_tension_sorting_reference.json L6–L74" ;
        dct:description "12 sources; 7 Pass 3 entries carry doi_verification = recorded offline, not resolved" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/datasets/differential_interfacial_tension_sorting/differential_interfacial_tension_sorting_reference.json#L6-L74> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/differential_interfacial_tension_sorting/differential_interfacial_tension_sorting_reference.json L103–L108" ;
        dct:description "Pass 3 correction of omega_EM/MN/EN with an explicit note that they are closure values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/datasets/differential_interfacial_tension_sorting/differential_interfacial_tension_sorting_reference.json#L103-L108> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/differential_interfacial_tension_sorting/paper_citations.bib L57–L131" ;
        dct:description "7 new BibTeX entries (Chen & Schier 2001 ... Kimmel 1995) with DOIs recorded offline" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/datasets/differential_interfacial_tension_sorting/paper_citations.bib#L57-L131> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .

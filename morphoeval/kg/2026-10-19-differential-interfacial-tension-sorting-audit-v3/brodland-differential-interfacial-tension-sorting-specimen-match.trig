sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting, with time-dependent Nodal/TGF-beta coupling (Pass 3) — Morphological realism / specimen match: 84/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The PNG (3000 x 1890) shows the specimen comparison clearly: Panel B4 overlays the Row C mushroom-doublet contours and centroid line on the GFP/RFP composite, and Panel B5 plots the 12-annulus specimen RFP core / GFP rim profiles against the simulated core-shell profiles (r = 0.930, RMSE = 0.184); Panels A1-A5 are visually plausible engulfment / reversal / arrested / mushroom / 3-layer configurations and Row C3 shows a high-tension (yellow) core enveloped by lower-tension cells after Nodal-driven differentiation. Deductions: the vendored image is titled \"Whole blastoderm transplants show yolk cell domain of function\" — it is a blastoderm-on-yolk transplant, not a Krieg (2008) germ-layer progenitor aggregate, so the layered GFP/RFP configuration is a proxy for germ-layer sorting (-8); the new Nodal row (C1-C5) is compared with no micrograph at all — no shield-stage internalization image, no pSmad2 gradient (-5); the Row B radial profile is computed from fluorescence intensity ratios inside a hand-set ROI (L1063-L1065) rather than from segmented cells (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/differential_interfacial_tension_sorting/differential_interfacial_tension_sorting_reference.json L75–L88: Specimen metadata: Wikimedia 'Whole blastoderm transplants show yolk cell domain of function' — a transplant proxy, not a germ-layer aggregate <https://github.com/fractastical/morpholib/blob/8beed34/datasets/differential_interfacial_tension_sorting/differential_interfacial_tension_sorting_reference.json#L75-L88>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match-2> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L1036–L1156" ;
        dct:description "Segmentation of Row B layered panels and Row C mushroom doublet; hand-set ROI centre/radius at L1063-L1065; Pearson r and computed p at L1121-L1123" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L1036-L1156> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/differential_interfacial_tension_sorting_comparison.png (generated output)" ;
        dct:description "15-panel figure: B4 specimen overlay and B5 empirical-vs-simulated radial profiles visible; Row C (C1-C5) Nodal coupling has no specimen panel — docs/media/differential_interfacial_tension_sorting_comparison.png: rendered output of 2002-brodland-differential-interfacial-tension-sorting.py at 8beed34, image/png, 695518 B, 3000×1890 px, artifact_sha256 5ffd7144ad26d4d8b06fe5b2d7ddf385312e2ed564432552abf59cecd5490808 (sha256 5ffd7144ad26d4d8b06fe5b2d7ddf385312e2ed564432552abf59cecd5490808), spec_fingerprint 04e6692e5c44347cdef3ff055c0cf966e6a50c079cad3d06d965f070f3683587" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


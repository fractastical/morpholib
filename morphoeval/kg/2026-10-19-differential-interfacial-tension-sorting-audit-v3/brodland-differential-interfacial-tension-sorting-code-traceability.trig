sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting, with time-dependent Nodal/TGF-beta coupling (Pass 3) — Code-to-model traceability: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-L59) maps every equation — DITH Eq. 1, the Krieg regimes, Young-Dupré Eq. 1 and the four Pass 3 Nodal relations — to its source and names the Lean theorem backing the closure; each Nodal function docstring (L232-L334) states its formula, its sources and the Lean declaration it mirrors; `simulate_nodal_coupled_internalization` (L776-L800) states the reduction assumptions (tier-of-origin memory, margin at the bottom, MCS -> hpf linear); the self-test comments (L1760-L1800) name the Lean theorem each check corresponds to, and the math KG yaml registers 6 equations with `code_locus` / `lean_locus`. Deductions: the lattice-energy scale `g_scale = 5.0`, `j_hom = 4.0`, the swap temperature factor 2.2 and the 3-layer bias 0.35 / temperature 12.0 remain uncited numerics (L496-L497, L557, L713-L714) (-5); the classification thresholds (72.5 / 112.5 pN/um, L336-L343) are midpoints by construction, not sourced (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2002-brodland-differential-interfacial-tension-sorting.py L496–L497: g_scale and j_hom lattice scale constants without a citation <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L496-L497>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L1–L59" ;
        dct:description "Module docstring: equations -> sources, Pass 3 Nodal relations, Lean theorem name, reduction disclosure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L1-L59> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L232–L343" ;
        dct:description "Per-function docstrings with formulas, sources and Lean declarations for the Nodal coupling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L232-L343> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/brodland-differential-interfacial-tension-sorting.yaml L51–L101" ;
        dct:description "3 new Pass 3 equations registered with lean_decl / lean_theorem / lean_locus / code_locus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/morphoeval/math_kg_loops/brodland-differential-interfacial-tension-sorting.yaml#L51-L101> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


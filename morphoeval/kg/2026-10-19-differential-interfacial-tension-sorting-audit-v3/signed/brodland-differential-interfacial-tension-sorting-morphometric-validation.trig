sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-blebbistatin-control-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "blebbistatin_control_radial_separation = 0.0 normalized_radius" ;
        schema:measurementTechnique "Null radial separation |r_E - r_M|/R_agg under Blebbistatin Myosin-II inhibition (beta_E=beta_M=25 pN/um, Krieg et al. 2008 Fig. 3)" ;
        schema:name "blebbistatin_control_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-blebbistatin-control-radial-separation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-blebbistatin-control-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-camlc-cortex-reversal-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "camlc_cortex_reversal_radial_separation = -0.3282 normalized_radius" ;
        schema:measurementTechnique "Inverted radial separation (r_E - r_M)/R_agg < 0 under caMLCK ectodermal cortical stiffening (beta_{E+caMLCK}=145 > beta_M=95 pN/um, Krieg et al. 2008 Fig. 4)" ;
        schema:name "camlc_cortex_reversal_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "-0.3282" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-camlc-cortex-reversal-radial-separation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-camlc-cortex-reversal-radial-separation-reference> a schema:PropertyValue ;
        schema:value "-0.34" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-dith-wildtype-gamma-em> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dith_wildtype_gamma_EM = 30.0 pN/um" ;
        schema:measurementTechnique "Exact Brodland (2002) J. Biomech. Eng. Eq. 1 heterotypic interfacial tension gamma_EM = beta_E + beta_M - omega_EM for beta_E=50, beta_M=95, omega_EM=115 pN/um" ;
        schema:name "dith_wildtype_gamma_EM" ;
        schema:unitText "pN/um" ;
        schema:value "30.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-dith-wildtype-gamma-em-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-dith-wildtype-gamma-em-reference> a schema:PropertyValue ;
        schema:value "30.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-krieg-2008-spreading-tension-diff> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "krieg_2008_spreading_tension_diff = 45.0 pN/um" ;
        schema:measurementTechnique "Krieg et al. (2008) Nat. Cell Biol. AFM cortical tension difference beta_M - beta_E = 95 - 50 = 45 pN/um driving ectoderm envelopment of mesoderm" ;
        schema:name "krieg_2008_spreading_tension_diff" ;
        schema:unitText "pN/um" ;
        schema:value "45.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-krieg-2008-spreading-tension-diff-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-krieg-2008-spreading-tension-diff-reference> a schema:PropertyValue ;
        schema:value "45.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-maitre-2012-young-dupre-contact-radius-half-tension> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "maitre_2012_young_dupre_contact_radius_half_tension = 0.866 normalized_contact_radius" ;
        schema:measurementTechnique "Maître et al. (2012) Science Eq. 1 Young-Dupré doublet contact radius r_c/R = sin(theta) at gamma_cc/(2*gamma_cm)=0.5 (theta=60.00 deg, specimen Row C r_c/R=0.9717)" ;
        schema:name "maitre_2012_young_dupre_contact_radius_half_tension" ;
        schema:unitText "normalized_contact_radius" ;
        schema:value "0.866" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-maitre-2012-young-dupre-contact-radius-half-tension-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-maitre-2012-young-dupre-contact-radius-half-tension-reference> a schema:PropertyValue ;
        schema:value "0.866" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-cortical-tension-hierarchy-established-hpf> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nodal_cortical_tension_hierarchy_established_hpf = 4.8667 hpf" ;
        schema:measurementTechnique "Earliest developmental time at which margin > mid > animal tier mean cortical tensions differ by >= 10 pN/um each; reference: Krieg et al. (2008) measured the ectoderm < mesoderm < endoderm AFM hierarchy in shield-stage (6 hpf) progenitors, so the hierarchy must exist by 6.0 hpf (upper bound)" ;
        schema:name "nodal_cortical_tension_hierarchy_established_hpf" ;
        schema:unitText "hpf" ;
        schema:value "4.8667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-cortical-tension-hierarchy-established-hpf-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-cortical-tension-hierarchy-established-hpf-reference> a schema:PropertyValue ;
        schema:value "6.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-coupled-internalization-radial-sep-7hpf> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nodal_coupled_internalization_radial_sep_7hpf = 0.3504 normalized_radius" ;
        schema:measurementTechnique "Radial separation (r_E - r_ME)/R_agg at 7.0 hpf when cortical tensions are set dynamically by the marginal Nodal field (C0=1, tau_beta=0.5 h, kappa=2/3; mesendoderm fraction=0.633); same wild-type anchor as the static regime (Krieg et al. 2008 Fig. 2)" ;
        schema:name "nodal_coupled_internalization_radial_sep_7hpf" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.3504" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-coupled-internalization-radial-sep-7hpf-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-coupled-internalization-radial-sep-7hpf-reference> a schema:PropertyValue ;
        schema:value "0.34" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-endoderm-tier-count-at-shield-6hpf> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nodal_endoderm_tier_count_at_shield_6hpf = 2 cell_tiers" ;
        schema:measurementTechnique "Number of marginal tiers whose mean cortical tension exceeds (beta_M+beta_N)/2 at 6.0 hpf (K_N=0.6); reference: endoderm arises from the marginal-most tiers, predominantly tiers 1-2 (Warga & Nusslein-Volhard 1999 Development 126:827; approximate)" ;
        schema:name "nodal_endoderm_tier_count_at_shield_6hpf" ;
        schema:unitText "cell_tiers" ;
        schema:value "2" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-endoderm-tier-count-at-shield-6hpf-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-endoderm-tier-count-at-shield-6hpf-reference> a schema:PropertyValue ;
        schema:value "2" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-mesendoderm-tier-count-at-shield-6hpf> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nodal_mesendoderm_tier_count_at_shield_6hpf = 5 cell_tiers" ;
        schema:measurementTechnique "Number of tiers of origin whose mean Nodal-driven cortical tension exceeds (beta_E+beta_M)/2 at shield stage 6.0 hpf (lambda=3.0 tiers, K_M=0.2); reference ~5 marginal tiers in the Nodal signalling / mesendoderm domain (van Boxtel et al. 2015 Dev. Cell; Dubrulle et al. 2015 eLife; approximate, recalled value not digitised here)" ;
        schema:name "nodal_mesendoderm_tier_count_at_shield_6hpf" ;
        schema:unitText "cell_tiers" ;
        schema:value "5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-mesendoderm-tier-count-at-shield-6hpf-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-mesendoderm-tier-count-at-shield-6hpf-reference> a schema:PropertyValue ;
        schema:value "5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-null-mzoep-radial-sep> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nodal_null_mzoep_radial_sep = 0.0 normalized_radius" ;
        schema:measurementTechnique "Null radial separation under Nodal loss of function (C0=0: lefty1 / MZoep; mesendoderm fraction=0.000); reference: MZoep embryos lack all mesoderm and endoderm (Gritsman et al. 1999 Cell 97:121), hence no germ-layer sorting (closure gamma_EM=30.0 pN/um at beta_E=50, beta_M=95)" ;
        schema:name "nodal_null_mzoep_radial_sep" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-null-mzoep-radial-sep-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-nodal-null-mzoep-radial-sep-reference> a schema:PropertyValue ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-specimen-vs-dith-radial-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_vs_dith_radial_profile_pearson_r = 0.9301 r" ;
        schema:measurementTechnique "Pearson correlation between DITH radial core-shell profile and zebrafish blastoderm GFP/RFP fluorescence profile across 12 radial annuli (RMSE=0.1844, computed two-sided p=1.17e-05, n=12 annuli)" ;
        schema:name "specimen_vs_dith_radial_profile_pearson_r" ;
        schema:unitText "r" ;
        schema:value "0.9301" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-specimen-vs-dith-radial-profile-pearson-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-specimen-vs-dith-radial-profile-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.92" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-three-germ-layer-ectoderm-endoderm-radial-gap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "three_germ_layer_ectoderm_endoderm_radial_gap = 0.4237 normalized_radius" ;
        schema:measurementTechnique "Concentric 3-germ-layer radial stratification gap (r_E - r_N)/R_agg with r_E=0.870 > r_M=0.663 > r_N=0.446 (Krieg et al. 2008 Fig. 2)" ;
        schema:name "three_germ_layer_ectoderm_endoderm_radial_gap" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.4237" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-three-germ-layer-ectoderm-endoderm-radial-gap-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-three-germ-layer-ectoderm-endoderm-radial-gap-reference> a schema:PropertyValue ;
        schema:value "0.42" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-wildtype-radial-core-shell-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wildtype_radial_core_shell_separation = 0.3807 normalized_radius" ;
        schema:measurementTechnique "Normalized radial separation (r_E - r_M)/R_agg in wild-type zebrafish germ-layer sorting (outer E envelopment=1.0000; single deterministic seed, no replicate statistics)" ;
        schema:name "wildtype_radial_core_shell_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.3807" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-wildtype-radial-core-shell-separation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-measurement-wildtype-radial-core-shell-separation-reference> a schema:PropertyValue ;
        schema:value "0.34" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L1595–L1702" ;
        dcterms:description "13 measurements with references; 5 new Nodal measurements at L1666-L1700" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L1595-L1702> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L349–L437" ;
        dcterms:description "Morphometric order parameters: heterotypic boundary fraction, envelopment, radial separation, 12-annulus profiles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L349-L437> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting, with time-dependent Nodal/TGF-beta coupling (Pass 3) — Morphometric validation: 88/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1595-L1702) returns 13 measurements with non-null references: the 8 v2 ones (gamma_EM = 30, beta_M - beta_E = 45, wild-type Delta_r = +0.3807 vs 0.34, caMLCK Delta_r = -0.3282 vs -0.34, Blebbistatin 0, 3-layer gap 0.4237 vs 0.42, Young-Dupré 0.866, profile r = 0.9301 vs 0.92) and 5 new Nodal ones: shield mesendoderm tiers 5 (ref 5), shield endoderm tiers 2 (ref 2), hierarchy established 4.87 hpf (ref <= 6.0), Nodal-coupled Delta_r = +0.3504 (ref 0.34), Nodal-null |Delta_r| = 0 (ref 0). The hard-coded \"p=0.0001\" strings of v2 are gone (L1625 now states single-seed / no replicate statistics; L1660 reports the computed Pearson p). Deductions: the two tier-count references and the 0.34 / 0.42 radial anchors are recalled approximate literature values, not digitised from a figure or table, and the hierarchy reference is only an upper bound (-7); all sorting metrics come from one seed with no replicate spread (-3); the Nodal tier counts are partly tautological because lambda and K_M were chosen to hit them (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L1704–L1810" ;
        dcterms:description "13-check self_test incl. Nodal mapping, closure inequality, relaxation invariant, coupled internalization, Nodal-null control and determinism" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L1704-L1810> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L1836–L1871" ;
        dcterms:description "Default render path and printed Pass 3 summary (PNG + 2 GIFs)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L1836-L1871> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting, with time-dependent Nodal/TGF-beta coupling (Pass 3) — Reproducibility package: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic RNG (seed 2008 everywhere, L450, L637, L788); `--self-test` runs 13 checks in ~13 s (L1704-L1810) including SHA-256 integrity, Lean-parity tension values, Young-Dupré bounds, the three static regimes, 3-layer stratification, specimen correlation, two-run bitwise determinism of both the static and the Nodal-coupled sorter, the Nodal dose map, the closure inequality, the relaxation invariant, the shield-stage tier counts and the Nodal-null control, and the 13-measurement contract; the default render regenerates the PNG and both GIFs in ~12 s with the printed summary (L1836-L1871). Deductions: no requirements lock file is vendored for this slot, the environment block above is the venv at audit time (-4); without MPLCONFIGDIR set matplotlib writes a font cache outside the repository and prints warnings (-2); PNG byte-identity across runs was not asserted (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-repro-package-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


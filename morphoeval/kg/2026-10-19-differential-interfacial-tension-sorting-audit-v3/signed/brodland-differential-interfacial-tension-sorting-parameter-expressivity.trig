sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-brodland-differential-interfacial-tension-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Brodland (2002) / Krieg et al. (2008) / Maître et al. (2012) Differential Interfacial Tension Hypothesis (DITH) and zebrafish germ-layer cortical tension sorting, with time-dependent Nodal/TGF-beta coupling (Pass 3) — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Four DITH regimes plus 3-layer sorting (A1-A5), the 7-point beta_E sweep crossing the inversion point (B2, L733-L770), the 6-point Young-Dupré curve (B3), and now a 5-point marginal Nodal dose sweep C0 in {0, 0.25, 0.5, 1, 2} (C5, `run_nodal_dose_sweep` L1004-L1030) whose C0 = 0 point is the lefty1 / MZoep null and whose mesendoderm fraction, endoderm fraction, shield tier count and Delta_r all respond; the Nodal-null trajectory is drawn beside the wild-type one in C4. CLI exposes `--beta-E/M/N`, `--gamma-EM`, `--Vt`, `--lam`, `--T`, `--mcs`, `--seed` and the new `--nodal-C0`, `--nodal-lambda`, `--tau-beta`, `--kappa` (L1814-L1829) and all are wired through `run_all_regimes_and_render` (L1162-L1175, L1208-L1219). Deductions: lambda, tau_beta and kappa are CLI-only and not swept in any panel (-5); K_M, K_N, n_hill and tau_N are hard-wired defaults (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L1004–L1030" ;
        dcterms:description "5-point Nodal dose sweep incl. Nodal-null control" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L1004-L1030> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L733–L770" ;
        dcterms:description "7-point beta_E sweep across the inversion threshold" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L733-L770> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-brodland-differential-interfacial-tension-sorting-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2002-brodland-differential-interfacial-tension-sorting.py L1814–L1829" ;
        dcterms:description "CLI incl. 4 new Nodal flags; lambda/tau_beta/kappa not swept in the figure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8beed34/2002-brodland-differential-interfacial-tension-sorting.py#L1814-L1829> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


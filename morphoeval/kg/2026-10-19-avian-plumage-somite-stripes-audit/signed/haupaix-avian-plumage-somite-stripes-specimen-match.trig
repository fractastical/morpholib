sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018) & Inaba et al. (2019) somite-prepatterned Agouti signaling and melanocyte gap-junction reaction-diffusion in galliform plumage stripes — Morphological realism / specimen match: 28/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Although `datasets/avian_plumage_somite_stripes/galliform_chick_stripes_specimen.jpg` is vendored on disk, the v1 script never loads, segments, or displays the biological *Coturnix japonica* dorsal plumage specimen (`docs/media/avian_plumage_somite_stripes_comparison.png` is a 2-panel synthetic 1D plot) and performs no empirical stripe spacing or pheomelanin/eumelanin bimodality comparison." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2018-haupaix-avian-plumage-somite-stripes.py L42–L70: 2-panel synthetic figure without Coturnix japonica specimen segmentation <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L42-L70>",
            "docs/media/avian_plumage_somite_stripes_comparison.png (generated output, not in repo): Synthetic 2-panel plot lacking biological specimen comparison — docs/media/avian_plumage_somite_stripes_comparison.png: rendered output of 2018-haupaix-avian-plumage-somite-stripes.py at 8871db0, image/png, 51839 B, 1080×456 px, artifact_sha256 02e43fa9a09c165fdbe30288a07b86756d896b7509ec5647f9471be53a60ab00 (sha256 02e43fa9a09c165fdbe30288a07b86756d896b7509ec5647f9471be53a60ab00), spec_fingerprint 02a8479af5560c95d12d26c94859ee0f020f922c46969b9a4243ec2f1ee4dce8" ;
        pk:hasScore "0.28"^^xsd:double ;
        pk:hasVerdict "unfaithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 010 autonomous loop assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018) & Inaba et al. (2019) somite-prepatterned Agouti signaling and melanocyte gap-junction reaction-diffusion in galliform plumage stripes — Morphometric validation: 42/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L73-93) returns only 2 scalar numbers from the 1D profile without measuring 5-species stripe width correlation, somite-graft chimera donor autonomy shifts, exogenous *Agouti* bead reciprocal black-stripe narrowing, negative-control suppression, or segmented *Coturnix japonica* dorsal stripe count, period, and pheomelanin fraction." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2018-haupaix-avian-plumage-somite-stripes.py L73–L93: Only 2 scalar metrics returned; no comparative species, chimera, bead, or specimen morphometrics <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L73-L93>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-quail-dorsal-yellow-stripe-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-quail-dorsal-yellow-stripe-width> ;
        pk:hasScore "0.42"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-quail-dorsal-yellow-stripe-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "quail dorsal yellow stripe fraction = 0.4 fraction" ;
        schema:measurementTechnique "Fraction of dorsoventral domain with A(y) >= theta_A" ;
        schema:name "quail dorsal yellow stripe fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.4" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-quail-dorsal-yellow-stripe-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-quail-dorsal-yellow-stripe-fraction-reference> a schema:PropertyValue ;
        dct:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 1" ;
        schema:value "0.4421" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-quail-dorsal-yellow-stripe-width> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "quail dorsal yellow stripe width = 0.38 mm" ;
        schema:measurementTechnique "1D Gaussian somite Agouti threshold width at theta_A = 0.50" ;
        schema:name "quail dorsal yellow stripe width" ;
        schema:unitText "mm" ;
        schema:value "0.38" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-quail-dorsal-yellow-stripe-width-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-quail-dorsal-yellow-stripe-width-reference> a schema:PropertyValue ;
        dct:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 1" ;
        schema:value "0.42" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 010 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1126/science.1230374>,
            <https://doi.org/10.1126/science.aar4777>,
            <https://doi.org/10.1126/science.aaw1969>,
            <https://doi.org/10.1371/journal.pbio.3000448> .
    <https://doi.org/10.1126/science.1230374> dct:date "2013"^^xsd:gYear ;
        dct:title "Topology of feather melanocyte progenitor niche allows complex pigment patterns to emerge" .
    <https://doi.org/10.1126/science.aar4777> dct:date "2018"^^xsd:gYear ;
        dct:title "The periodicelly striped plumage of galliform chicks is prepatterned by somitic Agouti signaling" .
    <https://doi.org/10.1126/science.aaw1969> dct:date "2019"^^xsd:gYear ;
        dct:title "Instructive role of melanocytes during body pigment pattern formation" .
    <https://doi.org/10.1371/journal.pbio.3000448> dct:date "2019"^^xsd:gYear ;
        dct:title "Symmetry breaking in the embryonic skin triggers directional and sequential plumage patterning" .
}


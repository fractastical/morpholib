        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2018-haupaix-avian-plumage-somite-stripes.py L1–L8: Single DOI in header; no runtime SHA-256 verification of datasets/avian_plumage_somite_stripes/ <https://github.com/fractastical/morpholib/blob/8871db0/2018-haupaix-avian-plumage-somite-stripes.py#L1-L8>" ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Slot 010 autonomous loop assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

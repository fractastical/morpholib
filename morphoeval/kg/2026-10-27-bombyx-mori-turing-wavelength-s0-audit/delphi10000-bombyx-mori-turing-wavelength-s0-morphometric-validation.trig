}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bombyx mori Turing wavenumber selection at 41 µm (Holocene, 0 Ma) — Morphometric validation: 72/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.9923 and radial Pearson r = 0.9997, with RMSE 0.669 gray levels and KS D = 0.0265. The reported dark-ring pitch is 82.14 µm because measure_scale_bar returns µm/px (0.9009) and segment_card divides by it. The 41 µm mode power fraction is 0.0014. KS p-value is computed and dropped." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py L191–L208: scale bar returns 100/width <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py#L191-L208>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ablation-growth-rate-at-41-m-when-du-dv>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ancestral-96-m-mode-growth-rate>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-dispersion-analytic-vs-numeric-growth-rate-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ocellus-card-radial-profile-galerkin-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ocellus-card-radial-profile-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-selected-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-dominant-dark-ring-pitch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ablation-growth-rate-at-41-m-when-du-dv> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ablation growth rate at 41 µm when Du = Dv = -1.3152 1/time" ;
        schema:measurementTechnique "Numeric growth of a 41 µm cosine with Dv reset to Du" ;
        schema:name "ablation growth rate at 41 µm when Du = Dv" ;
        schema:unitText "1/time" ;
        schema:value "-1.3152" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ablation-growth-rate-at-41-m-when-du-dv-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ablation-growth-rate-at-41-m-when-du-dv-reference> a schema:PropertyValue ;
        dct:source "marginal stability; equal diffusion must lie below it" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ancestral-96-m-mode-growth-rate> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ancestral 96 µm mode growth rate = -0.4899 1/time" ;
        schema:measurementTechnique "Analytic σ(2π/96 µm) at the domestic diffusivity pair" ;
        schema:name "ancestral 96 µm mode growth rate" ;
        schema:unitText "1/time" ;
        schema:value "-0.4899" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ancestral-96-m-mode-growth-rate-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ancestral-96-m-mode-growth-rate-reference> a schema:PropertyValue ;
        dct:source "Bombyx mandarina predecessor contrast; negative means the pitch is not selected" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-dispersion-analytic-vs-numeric-growth-rate-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion analytic vs numeric growth-rate Pearson r = 0.9923 Pearson r" ;
        schema:measurementTechnique "Pearson correlation of σ(λ) on 12 wavelengths from 28 to 88 µm" ;
        schema:name "dispersion analytic vs numeric growth-rate Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9923" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-dispersion-analytic-vs-numeric-growth-rate-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-dispersion-analytic-vs-numeric-growth-rate-pearson-r-reference> a schema:PropertyValue ;
        dct:source "exact σ(k) identity; numeric operator-split growth is biased slightly high" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ocellus-card-radial-profile-galerkin-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus-card radial profile Galerkin Pearson r = 0.9997 Pearson r" ;
        schema:measurementTechnique "Degree-4 envelope plus 8 Fourier rings, including the 41 µm carrier, versus the card radial mean" ;
        schema:name "ocellus-card radial profile Galerkin Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ocellus-card-radial-profile-galerkin-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ocellus-card-radial-profile-galerkin-pearson-r-reference> a schema:PropertyValue ;
        dct:source "perfect radial reconstruction" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ocellus-card-radial-profile-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus-card radial profile RMSE = 0.6692 gray levels" ;
        schema:measurementTechnique "RMSE of the Galerkin fit on radii 0–340 px" ;
        schema:name "ocellus-card radial profile RMSE" ;
        schema:unitText "gray levels" ;
        schema:value "0.6692" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ocellus-card-radial-profile-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-ocellus-card-radial-profile-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-selected-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "selected wavelength lambda_c = 41.0161 µm" ;
        schema:measurementTechnique "argmax_k σ(k) after joint Du, Dv calibration" ;
        schema:name "selected wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "41.0161" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-selected-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-selected-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "slot scale 41 µm at 0 Ma" ;
        schema:value "41.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-dominant-dark-ring-pitch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen ocellus dominant dark-ring pitch = 82.14 µm" ;
        schema:measurementTechnique "Median spacing of radial-mean minima, converted with the 100 µm scale bar" ;
        schema:name "specimen ocellus dominant dark-ring pitch" ;
        schema:unitText "µm" ;
        schema:value "82.14" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-dominant-dark-ring-pitch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-dominant-dark-ring-pitch-reference> a schema:PropertyValue ;
        dct:source "slot characteristic scale 41 µm; the card pitch is measured, not set equal to it" ;
        schema:value "41.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen ocellus foreground fraction = 0.4812 fraction" ;
        schema:measurementTechnique "Border-contrast mask, morphological closing, hole fill" ;
        schema:name "specimen ocellus foreground fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.4812" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-field baseline" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen ocellus structure-tensor coherency = 0.2386 coherency" ;
        schema:measurementTechnique "Mean structure-tensor coherency on the contrast foreground of the ocellus card" ;
        schema:name "specimen ocellus structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.2386" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-ocellus-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "round number near the gallery-card signature; full-resolution measurement differs" ;
        schema:value "0.85" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-profile KS statistic = 0.0265 KS D" ;
        schema:measurementTechnique "Two-sample Kolmogorov-Smirnov between card radial mean and Galerkin prediction" ;
        schema:name "specimen radial-profile KS statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.0265" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-measurement-specimen-radial-profile-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "conventional D = 0.05 screening level, not the fitted residual" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-bombyx-mori-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py L489–L574" ;
        dct:description "measure_morphoeval pitch and coherency" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py#L489-L574> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


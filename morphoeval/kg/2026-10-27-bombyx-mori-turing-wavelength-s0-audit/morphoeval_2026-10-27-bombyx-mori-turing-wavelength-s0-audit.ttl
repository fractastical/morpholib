<https://w3id.org/delphi/resource/math-law/delphi10000-bombyx-mori-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion relation" ;
    dct:description "Selects the Holocene domestic ocellus wavelength λ_c = 41 µm | Variables: u activator, v inhibitor, Du, Dv diffusivities (µm²), k wavenumber (rad/µm)" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Gierer & Meinhardt 1972 DOI:10.1007/BF00289234" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3134_bombyx_mori_turing_wavelength_s0.lean#L43-L45> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D - σ I) = 0, σ(k) = ½(tr_k + sqrt(tr_k^2 - 4 det_k))" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1038/ncomms2778>,
        <https://doi.org/10.1038/ncomms5936>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3134.sigma41_x10000" ;
    pk:leanTheorem "MathOfBiology.Loop_3134.critical_mode_grows" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bombyx-mori-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength" ;
    dct:description "Integer identity λ_c · k_c = 2π for this slot only | Variables: λ_c = 41 µm, k_c = 153248 rad/m" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3134_bombyx_mori_turing_wavelength_s0.lean#L21-L23> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_c = 2π / k_c, k_c = argmax_k σ(k) = 2π / 41 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1038/ncomms2778>,
        <https://doi.org/10.1038/ncomms5936>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3134.kC_rad_per_m" ;
    pk:leanTheorem "MathOfBiology.Loop_3134.wavelength_wavenumber_identity" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bombyx-mori-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Domestication pitch shift" ;
    dct:description "What changes at 0 Ma / 41 µm relative to the wild silkmoth stripe | Variables: λ_mandarina = 96 µm predecessor contrast; this chronoseries has no successor" ;
    dct:source "Yamaguchi et al. 2013 DOI:10.1038/ncomms2778" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3134_bombyx_mori_turing_wavelength_s0.lean#L26-L28> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "λ_mandarina − λ_c = 96 µm − 41 µm = 55 µm, with σ(k_96) < 0 < σ(k_41)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1038/ncomms2778>,
        <https://doi.org/10.1038/ncomms5936>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3134.lambdaMandarina" ;
    pk:leanTheorem "MathOfBiology.Loop_3134.domestic_pitch_shorter_than_mandarina" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-bombyx-mori-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Inhibitor diffusion dominance" ;
    dct:description "Long-range inhibition required for a Turing band | Variables: Du ≈ 10.58 µm², Dv ≈ 190.5 µm² after calibration onto λ = 41 µm" ;
    dct:source "Gierer & Meinhardt 1972 DOI:10.1007/BF00289234" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-bombyx-mori-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3134_bombyx_mori_turing_wavelength_s0.lean#L33-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "Dv / Du = 18 > 1" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1038/ncomms2778>,
        <https://doi.org/10.1038/ncomms5936>,
        <https://doi.org/10.1098/rstb.1952.0012> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3134.diffusionRatio" ;
    pk:leanTheorem "MathOfBiology.Loop_3134.inhibitor_diffuses_faster" ;
    pk:leanVerified true .


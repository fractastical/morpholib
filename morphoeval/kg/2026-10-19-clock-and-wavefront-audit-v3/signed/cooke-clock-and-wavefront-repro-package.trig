sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L1645–L1747" ;
        dcterms:description "Six self-test groups incl. bitwise determinism for kinematic and fgf_ra modes, front velocity, bead, vertex sheet and measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L1645-L1747> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L1750–L1790" ;
        dcterms:description "argparse CLI with --summary JSON mode; default run renders all three artifacts" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L1750-L1790> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "datasets/clock_and_wavefront/README.md L45–L51" ;
        dcterms:description "Reproduction block with self-test, render and summary invocations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/clock_and_wavefront/README.md#L45-L51> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/clock_and_wavefront_growth.gif (generated output)" ;
        dcterms:description "24-frame GIF of the FGF/RA-coupled model: M_F, F, R, tailbud, emergent front and chi — docs/media/clock_and_wavefront_growth.gif: rendered output of 1976-cooke-clock-and-wavefront.py at d58a084, image/gif, 1241160 B, 919×660 px, 24 frames, artifact_sha256 b2f9844c753317cb52b047686e55fe5fdc621446cb5e7dd414daa2e6e38e6019 (sha256 b2f9844c753317cb52b047686e55fe5fdc621446cb5e7dd414daa2e6e38e6019), spec_fingerprint c943fd8ec360d2fc8a2730571fb91c8337ae0de4cb262a0f6d695d053bbbcf13" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic RNG (seed 1976 for the cusp noise and the vertex jitter, L403, L648, L682); `--self-test` now asserts bitwise two-run determinism for both wavefront modes, bistability, v_front within 2 % and R^2 > 0.999, S(fgf_ra) within 3 %, the 1.5x v_tb law, the bead effect, cleft rotation vs the dLambda = 0 control, tortuosity reduction, S_2d, specimen metrics and >= 13 measurements (L1645-1747, ~5 s); the default run renders PNG + sheet PNG + GIF in ~8 s; the dataset README gives the invocation block and the `--summary` flag prints a JSON of one run. Deductions: no requirements lock is vendored with the slot and the environment block is the only version record (-3); matplotlib writes a font cache outside the repository unless MPLCONFIGDIR is set, which the README does not mention (-2); the repository README (out of scope for this slot) still describes the 6-panel Pass 2 figure (-2); the new reference JSON is unpinned (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-repro-package-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


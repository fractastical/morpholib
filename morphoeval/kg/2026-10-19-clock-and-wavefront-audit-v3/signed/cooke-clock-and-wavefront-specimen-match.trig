sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L883–L976" ;
        dcterms:description "Bilateral DoG segmentation plus per-cleft luminance-minimum line fit (L944-958) giving lower_row_cleft_angle_mean_deg = 7.9" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L883-L976> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L1404–L1432" ;
        dcterms:description "Panel E overlays peaks and the 8 cleft lines on the SEM; title reports the cleft angle" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L1404-L1432> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/clock_and_wavefront_comparison.png (generated output)" ;
        dcterms:description "9 panels: kymograph, trains incl. FGF/RA and bead, morphospace, size invariance, SEM segmentation, waveform fit, toggle bistability, endogenous front, vertex sheet with angle-vs-time inset — docs/media/clock_and_wavefront_comparison.png: rendered output of 1976-cooke-clock-and-wavefront.py at d58a084, image/png, 1415556 B, 2310×2044 px, artifact_sha256 0a6c41da9df6f972bcba0ce2571dcdaa3d70ec1a69a8067f3c712f3fcb054a1c (sha256 0a6c41da9df6f972bcba0ce2571dcdaa3d70ec1a69a8067f3c712f3fcb054a1c), spec_fingerprint c943fd8ec360d2fc8a2730571fb91c8337ae0de4cb262a0f6d695d053bbbcf13" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/clock_and_wavefront_vertex_sheet.png (generated output)" ;
        dcterms:description "Full 1.2 mm sheet: treated (clefts straight, 10.3 deg) vs dLambda = 0 control (zig-zag, 27.3 deg) — docs/media/clock_and_wavefront_vertex_sheet.png: rendered output of 1976-cooke-clock-and-wavefront.py at d58a084, image/png, 301864 B, 2080×832 px, artifact_sha256 6b712a94cc9ef0dc7b5ed2416b6f55bb054b42ba9c4d4a79acb422704caa0691 (sha256 6b712a94cc9ef0dc7b5ed2416b6f55bb054b42ba9c4d4a79acb422704caa0691), spec_fingerprint c943fd8ec360d2fc8a2730571fb91c8337ae0de4cb262a0f6d695d053bbbcf13" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Morphological realism / specimen match: 87/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Panels E-F keep the bilateral SEM segmentation (8 + 9 somites, 48.47 px, symmetry 0.9605, phase correlation r = 0.563) and Panel E now overlays the 8 lower-row clefts whose fitted orientation (7.9 deg from the ML axis) is the empirical anchor for the vertex-sheet cleft angle (10.3 deg after differential tension vs 27.3 deg control), so for the first time a 2D feature of the rendered tissue is compared with the specimen. The sheet renders as transverse somite blocks with straightened yellow clefts (clock_and_wavefront_vertex_sheet.png) and the GIF shows the FGF/RA profiles and emergent front. Deductions unchanged or newly exposed: the specimen is a chick SEM in pixels with no scale bar, so S_obs cannot be compared to S_sim in um and the Xenopus-parameterised model is matched to a different species (-6); the red/blue anterior/posterior half-somite colouring and the 20-um hexagonal cells are schematic and have no counterpart in the SEM (-4); the specimen cleft angle comes from a crude luminance-minimum line fit through a 44-px band (-2); the 1D waveform correlation r = 0.563 is modest (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/clock_and_wavefront/clock_and_wavefront_reference.json L30–L41: Specimen metadata gives px ROIs only; no um scale or scale bar, species listed as Gallus gallus / vertebrate <https://github.com/fractastical/morpholib/blob/d58a084/datasets/clock_and_wavefront/clock_and_wavefront_reference.json#L30-L41>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-specimen-match-4> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


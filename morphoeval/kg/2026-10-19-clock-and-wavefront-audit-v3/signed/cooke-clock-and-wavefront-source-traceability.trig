sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Source and data traceability: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Nine primary sources carry DOIs in the module docstring (L6-38), `paper_citations.bib` (9 entries) and the two reference JSONs; the specimen and scout manifest remain SHA-256-pinned and verified fail-closed at every run (L125-132, L167-189); the new `fgf_ra_vertex_reference.json` records every toggle and vertex parameter, the v_tb sweep, bead settings and the Bi (2015) / specimen reference values, and the dataset README documents Laws 4-5, the new file and a reproduction block. Deductions: the new JSON's SHA-256 is recorded at runtime but not pinned in EXPECTED_SHA256, so a silent edit would pass (-3); Goldbeter et al.'s own parameter table is not vendored or cited by equation number, and Meinhardt (1986) is cited in the math-KG without a DOI (-2); the SEM specimen's Wikimedia provenance still lacks a scale (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L125–L132: EXPECTED_SHA256 does not include fgf_ra_vertex_reference.json <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L125-L132>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-source-traceability-4> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L6–L38" ;
        dcterms:description "Nine sources with DOIs in the module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L6-L38> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L167–L189" ;
        dcterms:description "verify_dataset_integrity: pinned SHA-256 for specimen + scout manifest; reference JSONs only recorded (L185-188)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L167-L189> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/clock_and_wavefront/fgf_ra_vertex_reference.json L1–L69" ;
        dcterms:description "Pass 3 reference table: 6 sources with DOIs, toggle/vertex parameters, derived values, sweep, bead, reference values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/clock_and_wavefront/fgf_ra_vertex_reference.json#L1-L69> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/clock_and_wavefront/paper_citations.bib L45–L97" ;
        dcterms:description "Five new BibTeX entries: Dubrulle 2004, Dubrulle 2001, Farhadifar 2007, Bi 2015, Saga & Takeda 2001" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/clock_and_wavefront/paper_citations.bib#L45-L97> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


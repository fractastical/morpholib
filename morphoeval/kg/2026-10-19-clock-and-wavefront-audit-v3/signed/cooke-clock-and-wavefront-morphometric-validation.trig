    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-somite-wavelength-with-endogenous-fgf-ra-front-s-sim-fgf-ra-vs-s-v-tb-t-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "somite wavelength with endogenous FGF/RA front S_sim(fgf_ra) vs S = v_tb*T_c = 100.1252 um" ;
        dcterms:description "rel. error 0.125%; front 10-90% width = 35.0 um (kinematic sigma_w = 18 um)" ;
        schema:measurementTechnique "peak-to-peak somite spacing of the FGF/RA-driven cusp solver (CV=0.0115, n=39, N_sim=40; miniature v_tb=1.333 um/min gives S=60.08 um, N=40)" ;

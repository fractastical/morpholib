        schema:measurementTechnique "proportional wavefront scaling v' = 0.60*v_0 in L'=2.4 mm miniature embryo (S_mini=60.08 um vs S_norm=100.13 um)" ;
        schema:name "miniature operated Xenopus embryo (60% length) somite count N_mini vs normal N_norm (size-invariance ratio)" ;
        schema:unitText "N_mini / N_norm ratio" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio-reference> a schema:PropertyValue ;
        dcterms:source "Cooke (1975) Nature 254:196-199 Table 1 (39.6 / 40.2 = 0.9851 somite count invariance ratio; theoretical = 1.0000)" ;
        schema:value "0.9851" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-normal-xenopus-somite-wavelength-s-sim-vs-analytical-s-v-t-c> a schema:PropertyValue,
            pk:EvidenceItem ;

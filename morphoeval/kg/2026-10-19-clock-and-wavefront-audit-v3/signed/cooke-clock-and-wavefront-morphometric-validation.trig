sub1:provenance {
    sub1:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(00)80451-1>,
            <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/j.cub.2007.11.049>,
            <https://doi.org/10.1038/254196a0>,
            <https://doi.org/10.1038/35098552>,
            <https://doi.org/10.1038/nature02216>,
            <https://doi.org/10.1038/nphys3471> .

    <https://doi.org/10.1002/dvdy.21193> dcterms:date "2007"^^xsd:gYear ;
        dcterms:title "Sharp developmental thresholds defined through bistability by antagonistic gradients of retinoic acid and FGF signaling" .

    <https://doi.org/10.1016/S0022-5193(76)80131-2> dcterms:date "1976"^^xsd:gYear ;
        dcterms:title "A clock and wavefront model for control of the number of repeated structures during animal morphogenesis" .

    <https://doi.org/10.1016/S0092-8674(00)80451-1> dcterms:date "1997"^^xsd:gYear ;
        dcterms:title "Avian hairy gene expression identifies a molecular clock linked to vertebrate segmentation and somitogenesis" .

    <https://doi.org/10.1016/S0092-8674(01)00437-8> dcterms:date "2001"^^xsd:gYear ;
        dcterms:title "FGF signaling controls somite boundary position and regulates segmentation clock control of spatiotemporal Hox gene activation" .

    <https://doi.org/10.1016/j.cub.2007.11.049> dcterms:date "2007"^^xsd:gYear ;
        dcterms:title "The influence of cell mechanics, cell-cell interactions, and proliferation on epithelial packing" .

    <https://doi.org/10.1038/254196a0> dcterms:date "1975"^^xsd:gYear ;
        dcterms:title "Control of somite number during morphogenesis of a vertebrate, Xenopus laevis" .

    <https://doi.org/10.1038/35098552> dcterms:date "2001"^^xsd:gYear ;
        dcterms:title "The making of the somite: molecular events in vertebrate segmentation" .

    <https://doi.org/10.1038/nature02216> dcterms:date "2004"^^xsd:gYear ;
        dcterms:title "fgf8 mRNA decay establishes a gradient that couples axial elongation to patterning in the vertebrate embryo" .

    <https://doi.org/10.1038/nphys3471> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "A density-independent rigidity transition in biological tissues" .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Morphometric validation: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1030-1193) now returns 13 reference-anchored measurements: the 5 Pass 2 metrics (S_sim 100.13 vs 100 um; N_mini/N_norm 1.000 vs 0.985; clock-doubled minus arrested 20; S_obs 48.47 px; 5-regime RMSE 0.27) plus v_front 2.2222 vs 2.2222 um/min, S(fgf_ra) 100.13 vs 100 um, v_tb-sweep RMSE 0.09 um, bead ratio 0.70 vs control 1.0 (directional), cleft angle 10.3 vs specimen 7.9 deg, tortuosity 1.03 vs 1.0, S_2d 100.0 vs 100 um and shape index 3.76 vs Bi (2015) 3.81. Deductions: five of the new references are the model's own analytical laws (S = v_tb*T_c, v = L/T_total, straight cleft), so they test internal consistency rather than biology (-4); the bead reference is directional because Dubrulle (2001) gives no ratio (-2); the specimen cleft angle is from an 8-cleft luminance fit without uncertainty (-2); the 13 blocks vs 12.0 analytical on the sheet includes two partial end blocks that are counted without correction (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L1141–L1149: Bead measurement reference_value 1.0 is the control; the paper gives no numerical ratio <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L1141-L1149>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-cleft-tortuosity-cleft-length-straight-mediolateral-span>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-inter-somitic-cleft-angle-from-the-mediolateral-axis-after-differential-tension>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-mean-cell-shape-index-p-p-sqrt-a>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-somite-block-pitch-s-2d-vs-s-v-t-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-ectopic-fgf8-bead-smallest-adjacent-somite-length-control-s-dubrulle-2001>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-endogenous-fgf8-ra-determination-front-velocity-v-front-vs-tailbud-elongation-speed-v-tb>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-normal-xenopus-somite-wavelength-s-sim-vs-analytical-s-v-t-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-somite-wavelength-with-endogenous-fgf-ra-front-s-sim-fgf-ra-vs-s-v-tb-t-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-v-tb-sweep-1-33-3-33-um-min-rmse-of-s-sim-fgf-ra-against-s-v-tb-t-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-morphometric-validation-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-cleft-tortuosity-cleft-length-straight-mediolateral-span> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D vertex-sheet cleft tortuosity (cleft length / straight mediolateral span) = 1.0274 ratio" ;
        dcterms:description "12 clefts -> 13 somite blocks on the 1.2 mm sheet vs analytical 12.0; 2D cleft pitch S_2d=100.0 um" ;
        schema:measurementTechnique "total cleft edge length over n_clefts * sheet height; hexagonal lattice zig-zag value 1.300 -> 1.027 (dLambda=0 control 1.294)" ;
        schema:name "2D vertex-sheet cleft tortuosity (cleft length / straight mediolateral span)" ;
        schema:unitText "ratio" ;
        schema:value "1.0274" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-cleft-tortuosity-cleft-length-straight-mediolateral-span-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-cleft-tortuosity-cleft-length-straight-mediolateral-span-reference> a schema:PropertyValue ;
        dcterms:source "straight inter-somitic boundary (Cooke & Zeeman 1976 Fig. 1; Saga & Takeda 2001 Nat. Rev. Genet. 2:835-845)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-inter-somitic-cleft-angle-from-the-mediolateral-axis-after-differential-tension> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D vertex-sheet inter-somitic cleft angle from the mediolateral axis after differential tension = 10.26 deg" ;
        dcterms:description "rotation = 18.0 deg; no T1 transitions, so the residual zig-zag cannot fully resolve" ;
        schema:measurementTechnique "Farhadifar vertex model (360 cells, 1211 edges, Lambda_0=0.12, Gamma=0.04, dLambda_cleft=0.9) coupled to the FGF/RA cusp field; length-weighted cleft edge angle, lattice value 28.2 deg -> final 10.3 deg (dLambda=0 control: 27.3 deg)" ;
        schema:name "2D vertex-sheet inter-somitic cleft angle from the mediolateral axis after differential tension" ;
        schema:unitText "deg" ;
        schema:value "10.26" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-inter-somitic-cleft-angle-from-the-mediolateral-axis-after-differential-tension-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-inter-somitic-cleft-angle-from-the-mediolateral-axis-after-differential-tension-reference> a schema:PropertyValue ;
        dcterms:source "inter-somitic cleft angle measured on the vendored SEM specimen lower somite row (luminance-minimum line fit per cleft; straight transverse clefts = 0 deg)" ;
        schema:value "7.876" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-mean-cell-shape-index-p-p-sqrt-a> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D vertex-sheet mean cell shape index p = P/sqrt(A) = 3.7639 dimensionless" ;
        dcterms:description "p < 3.81 => solid-like epithelioid sheet, consistent with the absence of spontaneous rearrangement in the committed somites" ;
        schema:measurementTechnique "mean +/- sd (0.058) over all cells of the relaxed Farhadifar sheet (case I parameters)" ;
        schema:name "2D vertex-sheet mean cell shape index p = P/sqrt(A)" ;
        schema:unitText "dimensionless" ;
        schema:value "3.7639" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-mean-cell-shape-index-p-p-sqrt-a-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-mean-cell-shape-index-p-p-sqrt-a-reference> a schema:PropertyValue ;
        dcterms:source "Bi, Lopez, Schwarz & Manning (2015) Nat. Phys. 11:1074-1079 solid-fluid rigidity transition p0* = 3.81 (regular hexagon 3.72); vendored in datasets/clock_and_wavefront/fgf_ra_vertex_reference.json" ;
        schema:value "3.81" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-somite-block-pitch-s-2d-vs-s-v-t-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D vertex-sheet somite block pitch S_2d vs S = v*T_c = 100.005 um" ;
        dcterms:description "cleft-adjacent cells AP aspect 0.923 vs core cells 0.869" ;
        schema:measurementTechnique "mean AP distance between consecutive cleft centroids in the relaxed vertex sheet (posterior(-1)->anterior(+1) interfaces only, Law 5)" ;
        schema:name "2D vertex-sheet somite block pitch S_2d vs S = v*T_c" ;
        schema:unitText "um" ;
        schema:value "100.005" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-somite-block-pitch-s-2d-vs-s-v-t-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-2d-vertex-sheet-somite-block-pitch-s-2d-vs-s-v-t-c-reference> a schema:PropertyValue ;
        dcterms:source "Cooke & Zeeman (1976) S = v*T_c = 100 um for L=4 mm, T_c=45 min" ;
        schema:value "100.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "clock-doubled perturbation (2x T_c) vs clock-arrested ablation control somite count delta = 20.0 somites (slow_clock vs null_control)" ;
        dcterms:description "slow_clock S=200.25 um (CV=0.0081), null_control peaks=0" ;
        schema:measurementTechnique "2x clock period perturbation (T_c=90 min -> N=20, S=200 um) vs clock-arrested negative control (A_clock=0 -> 0 somites)" ;
        schema:name "clock-doubled perturbation (2x T_c) vs clock-arrested ablation control somite count delta" ;
        schema:unitText "somites (slow_clock vs null_control)" ;
        schema:value "20.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta-reference> a schema:PropertyValue ;
        dcterms:source "Cooke & Zeeman (1976) J. Theor. Biol. 58:455-476 Section 3 (doubling T_c halves N from 40 to 20; arresting clock abolishes segmentation N=0)" ;
        schema:value "20.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cooke (1975) 5-regime somite count prediction RMSE = 0.2651 somites" ;
        dcterms:description "max regime error = 0.401 somites across normal, 75%, 60% miniature, 2x clock, and 1.5x wavefront" ;
        schema:measurementTechnique "RMSE across 5 Cooke (1975) / Cooke & Zeeman (1976) size-regulation and clock/wavefront perturbation regimes (Pearson r=0.9996, p=9.94e-06)" ;
        schema:name "Cooke (1975) 5-regime somite count prediction RMSE" ;
        schema:unitText "somites" ;
        schema:value "0.2651" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse-reference> a schema:PropertyValue ;
        dcterms:source "Cooke (1975) Nature 254:196-199 Table 1" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-ectopic-fgf8-bead-smallest-adjacent-somite-length-control-s-dubrulle-2001> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ectopic FGF8 bead: smallest adjacent somite length / control S (Dubrulle 2001) = 0.7 ratio" ;
        dcterms:description "directional comparison only: the 2001 paper gives no numerical size ratio, so the model is tested for ratio < 1 (bead stalls the front, extra clock cycles elapse per unit length)" ;
        schema:measurementTechnique "decaying Gaussian fgf8 source (A=1.0, w=60 um, tau=300 min) at x=0.6 mm in the coupled model; min/max somite spacing within +/-0.3 mm of the bead over control S (6 spacings; max ratio=1.550)" ;
        schema:name "ectopic FGF8 bead: smallest adjacent somite length / control S (Dubrulle 2001)" ;
        schema:unitText "ratio" ;
        schema:value "0.7" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-ectopic-fgf8-bead-smallest-adjacent-somite-length-control-s-dubrulle-2001-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-ectopic-fgf8-bead-smallest-adjacent-somite-length-control-s-dubrulle-2001-reference> a schema:PropertyValue ;
        dcterms:source "control ratio; Dubrulle, McGrew & Pourquie (2001) Cell 106:219-232 report somites formed at the level of an FGF8 bead smaller than contralateral controls (ratio < 1), reproduced by Goldbeter et al. (2007)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-endogenous-fgf8-ra-determination-front-velocity-v-front-vs-tailbud-elongation-speed-v-tb> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "endogenous FGF8/RA determination-front velocity v_front vs tailbud elongation speed v_tb = 2.22222 um/min" ;
        dcterms:description "rel. error 0.000%; lambda_F=0.300 mm, front offset behind tailbud=0.191 mm, dynamic lag=106.1 um, bistable window M_F in [0.530, inf]" ;
        schema:measurementTechnique "linear fit of the a(x,t)=0 front locus x_w(t) over x in [1.0, 3.6] mm in the coupled Goldbeter FGF/RA toggle + cusp solver (R^2=1.000000; no wavefront velocity prescribed)" ;
        schema:name "endogenous FGF8/RA determination-front velocity v_front vs tailbud elongation speed v_tb" ;
        schema:unitText "um/min" ;
        schema:value "2.22222" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-endogenous-fgf8-ra-determination-front-velocity-v-front-vs-tailbud-elongation-speed-v-tb-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-endogenous-fgf8-ra-determination-front-velocity-v-front-vs-tailbud-elongation-speed-v-tb-reference> a schema:PropertyValue ;
        dcterms:source "Goldbeter, Gonze & Pourquie (2007) Dev. Dyn. 236:1495-1508 (front regresses with axis elongation) and Cooke & Zeeman (1976) kinematic v = L/T_total = 2.222 um/min" ;
        schema:value "2.2222" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio> a schema:PropertyValue,

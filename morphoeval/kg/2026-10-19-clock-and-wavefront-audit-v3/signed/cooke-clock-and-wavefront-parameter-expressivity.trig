sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L609–L633" ;
        dcterms:description "evaluate_endogenous_front_sweep over v_tb: v_front, S_sim vs S_pred, lambda_F per point" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L609-L633> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L982–L1028" ;
        dcterms:description "run_pass3_models: FGF/RA normal, miniature, bead, sweep, bistability scan, treated and dLambda = 0 sheets" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L982-L1028> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L1754–L1762" ;
        dcterms:description "CLI: --L-mm, --Tc-min, --T-total-min, --v-tailbud, --wavefront-mode, --seed, --skip-gif, --summary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L1754-L1762> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Parameter expressivity: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The 5 Cooke (1975) regimes and the S(v, T_c) morphospace are retained (Panels C-D). Pass 3 adds a sweep of the mechanistic parameter that now controls S: tailbud elongation speed v_tb in {1.33, 1.67, 2.22, 3.33} um/min gives v_front = v_tb to <= 1e-4 % and S = 60.1 / 75.1 / 100.1 / 150.0 um (RMSE 0.09 um, r = 1.000) with no wavefront parameter changed (L609-633, Panel H inset, Panel C diamonds); an FGF8 bead perturbation shrinks adjacent somites to 0.70x and enlarges the next to 1.55x (Panel B); the vertex dLambda ablation (0.9 vs 0) isolates the cleft-rotation effect (Panel I inset); and `--v-tailbud`, `--wavefront-mode`, `--summary` expose the new axis on the CLI (L1754-1762). Deductions: dLambda is only tested at two values, so monotonicity of cleft angle with tension is not shown (-3); toggle parameters (tau_FR, k_dM, kappa_a) that set front width and offset are not swept (-3); A_clock / b0_bias of the cusp remain unswept (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L150–L161: VERTEX_PARAMS: single dLambda_cleft = 0.9; only the 0 control is also run <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L150-L161>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

<https://w3id.org/probknow/resource/evidence/2026-10-19-clock-and-wavefront-audit-v3-cooke-clock-and-wavefront-9> a schema:QuantitativeValue,
        pk1:EvidenceItem ;
    rdfs:label "ectopic FGF8 bead: smallest adjacent somite length / control S (Dubrulle 2001)" ;
    dct:description "decaying Gaussian fgf8 source (A=1.0, w=60 um, tau=300 min) at x=0.6 mm in the coupled model; min/max somite spacing within +/-0.3 mm of the bead over control S (6 spacings; max ratio=1.550)" ;
    dct:source "control ratio; Dubrulle, McGrew & Pourquie (2001) Cell 106:219-232 report somites formed at the level of an FGF8 bead smaller than contralateral controls (ratio < 1), reproduced by Goldbeter et al. (2007)" ;
    rdfs:comment "directional comparison only: the 2001 paper gives no numerical size ratio, so the model is tested for ratio < 1 (bead stalls the front, extra clock cycles elapse per unit length)" ;
    prov:wasGeneratedBy "script" ;
    schema:about "Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites" ;
    schema:error 3e+01 ;
    schema:targetValue 1e+00 ;
    schema:unitText "ratio" ;
    schema:value 7e-01 .

<https://w3id.org/delphi/resource/math-law/cooke-clock-and-wavefront-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cooke & Zeeman (1976) Somite Wavelength Law" ;
    dct:description "Determines the spatial period S of serially repeated somite blocks from wavefront velocity v and oscillator period T_c | Variables: S: anteroposterior somite length (um); v: determination wavefront regression velocity (um/min); T_c: intracellular segmentation clock period (min)" ;
    dct:source "Cooke & Zeeman (1976) J. Theor. Biol. 58(2):455-476 Sections 2-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L208-L223>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_021_clock_and_wavefront.lean#L20-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def somite_length (v T_c : Nat) : Nat := v * T_c
theorem cooke_zeeman_1976_wavelength_period_scaling (k v T_c : Nat) :
    somite_length (k * v) T_c = k * somite_length v T_c ∧
    somite_length v (2 * T_c) = 2 * somite_length v T_c"""^^pk:lean4 ;
    skos:notation "S = v * T_c;  S(k * v, T_c) = k * S(v, T_c);  S(v, 2 * T_c) = 2 * S(v, T_c)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0022-5193(76)80131-2>,
        <https://doi.org/10.1016/S0092-8674(00)80451-1>,
        <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/254196a0>,
        <https://doi.org/10.1038/35098552>,
        <https://doi.org/10.1038/nature02216>,
        <https://doi.org/10.1038/nphys3471> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Clock-and-Wavefront Somite Segmentation (Kinematic Phase-Gating, Thom-Zeeman Cusp Catastrophe, Goldbeter FGF8/RA Bistable Front & Farhadifar Vertex Sheet)" ;
    pk:leanDeclaration "MathOfBiology.Loop_021.somite_length" ;
    pk:leanTheorem "MathOfBiology.Loop_021.cooke_zeeman_1976_wavelength_period_scaling" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/cooke-clock-and-wavefront-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Cooke (1975) & Cooke-Zeeman (1976) Embryo Size-Invariance Scaling Law" ;
    dct:description "Proves that proportional scaling of wavefront velocity v with body length L preserves total somite count N ~ 40 in surgically reduced Xenopus embryos | Variables: N: total somite number; L: anteroposterior body axis length (mm); scale: embryo size reduction ratio; T_total: total segmentation duration (min)" ;
    dct:source "Cooke (1975) Nature 254:196-199 Table 1; Cooke & Zeeman (1976) J. Theor. Biol. 58(2):455-476 Section 4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L230-L259>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_021_clock_and_wavefront.lean#L44-L55> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def segmented_axis_length (N v T_c : Nat) : Nat := N * somite_length v T_c
theorem cooke_1975_miniature_embryo_size_invariance (scale N v_0 T_c : Nat) :
    segmented_axis_length N (scale * v_0) T_c =
      scale * segmented_axis_length N v_0 T_c"""^^pk:lean4 ;
    skos:notation "N = L / (v * T_c);  v = L / T_total => N = T_total / T_c (invariant under embryo length scaling L' = alpha * L_0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0022-5193(76)80131-2>,
        <https://doi.org/10.1016/S0092-8674(00)80451-1>,
        <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/254196a0>,
        <https://doi.org/10.1038/35098552>,
        <https://doi.org/10.1038/nature02216>,
        <https://doi.org/10.1038/nphys3471> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Clock-and-Wavefront Somite Segmentation (Kinematic Phase-Gating, Thom-Zeeman Cusp Catastrophe, Goldbeter FGF8/RA Bistable Front & Farhadifar Vertex Sheet)" ;
    pk:leanDeclaration "MathOfBiology.Loop_021.segmented_axis_length" ;
    pk:leanTheorem "MathOfBiology.Loop_021.cooke_1975_miniature_embryo_size_invariance" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/cooke-clock-and-wavefront-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thom-Zeeman Cusp Catastrophe Wavefront Bifurcation" ;
    dct:description "Converts smooth anterior-posterior wavefront progression into sharp, discrete inter-somitic boundary clefts gated by the segmentation clock phase | Variables: chi: cellular determination/adhesion state; a(x,t): wavefront unfolding parameter; b_osc(x,t): clock-modulated asymmetry parameter" ;
    dct:source "Cooke & Zeeman (1976) J. Theor. Biol. 58(2):455-476 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L358-L606>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_021_clock_and_wavefront.lean#L57-L70> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def cusp_catastrophe_residual (chi a b : Int) : Int := chi * chi * chi - a * chi - b
theorem zeeman_1976_cusp_wavefront_bifurcation :
    cusp_catastrophe_residual 0 (-1) 0 = 0 ∧
    cusp_catastrophe_residual 1 1 0 = 0 ∧
    cusp_catastrophe_residual (-1) 1 0 = 0"""^^pk:lean4 ;
    skos:notation "tau_chi * dchi/dt = -(chi^3 - a(x,t) * chi - b_osc(x,t));  a(x,t) = tanh((v*t - x)/sigma_w)" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0022-5193(76)80131-2>,
        <https://doi.org/10.1016/S0092-8674(00)80451-1>,
        <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/254196a0>,
        <https://doi.org/10.1038/35098552>,
        <https://doi.org/10.1038/nature02216>,
        <https://doi.org/10.1038/nphys3471> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Clock-and-Wavefront Somite Segmentation (Kinematic Phase-Gating, Thom-Zeeman Cusp Catastrophe, Goldbeter FGF8/RA Bistable Front & Farhadifar Vertex Sheet)" ;
    pk:leanDeclaration "MathOfBiology.Loop_021.cusp_catastrophe_residual" ;
    pk:leanTheorem "MathOfBiology.Loop_021.zeeman_1976_cusp_wavefront_bifurcation" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/cooke-clock-and-wavefront-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Goldbeter-Gonze-Pourquie (2007) FGF8/RA Bistable Determination Front Driven by Tailbud Elongation" ;
    dct:description "Derives the Cooke-Zeeman wavefront velocity v endogenously from posterior tailbud elongation through the FGF/RA bistable switch, replacing the prescribed kinematic front; the cusp unfolding parameter a and commitment mobility m are read off the toggle state | Variables: F: FGF8 protein; R: retinoic acid; M_F: fgf8 mRNA (tailbud = 1); x_tb: tailbud position; v_tb: axis elongation speed; lambda_F = v_tb/k_dM: mRNA decay length; M_lo: lower saddle-node of the toggle; D = lambda_F ln(1/M_lo): front offset" ;
    dct:source "Goldbeter, Gonze & Pourquie (2007) Dev. Dyn. 236(6):1495-1508; Dubrulle & Pourquie (2004) Nature 427:419-422; Dubrulle, McGrew & Pourquie (2001) Cell 106:219-232 (FGF8 bead)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L266-L633>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_021_clock_and_wavefront.lean#L75-L110> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def tailbud_position (x_tb0 v_tb t : Int) : Int := x_tb0 + v_tb * t
def determination_front (x_tb0 v_tb D t : Int) : Int := tailbud_position x_tb0 v_tb t - D
theorem goldbeter_2007_front_velocity_equals_tailbud_elongation (x_tb0 v_tb D t₁ t₂ : Int) :
    determination_front x_tb0 v_tb D t₂ - determination_front x_tb0 v_tb D t₁ = v_tb * (t₂ - t₁)
theorem endogenous_front_somite_length (x_tb0 v_tb D t T_c : Int) :
    determination_front x_tb0 v_tb D (t + T_c) - determination_front x_tb0 v_tb D t = v_tb * T_c"""^^pk:lean4 ;
    skos:notation "M_F = exp(-(x_tb(t) - x)/lambda_F), x_tb = x_tb0 + v_tb t; tau_FR dF/dt = alpha_F M_F K^n/(K^n+R^n) - F; tau_FR dR/dt = alpha_R K^n/(K^n+F^n) - R; x_w(t) = x_tb(t) - lambda_F ln(1/M_lo) => dx_w/dt = v_tb" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0022-5193(76)80131-2>,
        <https://doi.org/10.1016/S0092-8674(00)80451-1>,
        <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/254196a0>,
        <https://doi.org/10.1038/35098552>,
        <https://doi.org/10.1038/nature02216>,
        <https://doi.org/10.1038/nphys3471> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Clock-and-Wavefront Somite Segmentation (Kinematic Phase-Gating, Thom-Zeeman Cusp Catastrophe, Goldbeter FGF8/RA Bistable Front & Farhadifar Vertex Sheet)" ;
    pk:leanDeclaration "MathOfBiology.Loop_021.determination_front" ;
    pk:leanTheorem "MathOfBiology.Loop_021.goldbeter_2007_front_velocity_equals_tailbud_elongation" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/cooke-clock-and-wavefront-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Anterior/Posterior Half-Somite Cleft Rule & Farhadifar (2007) Vertex-Model Paraxial Mesoderm Sheet" ;
    dct:description "Couples the 1D cusp field to a 2D vertex-model sheet: only posterior(-1)->anterior(+1) interfaces are loaded, so the sheet forms N somite blocks with clefts that rotate toward the mediolateral axis and straighten (cleft angle 28 -> 10 deg; tortuosity 1.30 -> 1.03) | Variables: A_c, P_c: cell area and perimeter; A_0: preferred area; K_A, Gamma, Lambda_0: area elasticity, contractility, line tension (Farhadifar case I: 0.12, 0.04); dLambda: extra tension on posterior->anterior interfaces; chi_ant, chi_post: half-somite states of the two cells sharing an edge" ;
    dct:source "Farhadifar et al. (2007) Curr. Biol. 17:2095-2104; Bi et al. (2015) Nat. Phys. 11:1074-1079; Saga & Takeda (2001) Nat. Rev. Genet. 2:835-845; Meinhardt (1986) Models of segmentation, in Somites in Developing Embryos (NATO ASI 118)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L640-L876>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_021_clock_and_wavefront.lean#L113-L192> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def compartments : Nat → List Int
  | 0 => []
  | n + 1 => 1 :: (-1) :: compartments n
theorem meinhardt_1986_half_somite_cleft_count (N : Nat) :
    count_clefts (compartments (N + 1)) = N ∧ count_intra (compartments (N + 1)) = N + 1
def edge_tension (Lambda_0 dLambda : Nat) (ant post : Int) : Nat :=
  if ant = -1 ∧ post = 1 then Lambda_0 + dLambda else Lambda_0
theorem farhadifar_2007_cleft_tension_selectivity (Lambda_0 dLambda : Nat) :
    edge_tension Lambda_0 dLambda (-1) 1 = Lambda_0 + dLambda ∧ edge_tension Lambda_0 dLambda 1 (-1) = Lambda_0 ∧ ..."""^^pk:lean4 ;
    skos:notation "E = sum_c [K_A/2 (A_c - A_0)^2 + Gamma/2 P_c^2] + sum_e Lambda_e l_e;  Lambda_e = Lambda_0 + dLambda [chi_ant = -1 and chi_post = +1];  2N half-somite compartments => N somites, N-1 clefts" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
        <https://doi.org/10.1016/S0022-5193(76)80131-2>,
        <https://doi.org/10.1016/S0092-8674(00)80451-1>,
        <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/j.cub.2007.11.049>,
        <https://doi.org/10.1038/254196a0>,
        <https://doi.org/10.1038/35098552>,
        <https://doi.org/10.1038/nature02216>,
        <https://doi.org/10.1038/nphys3471> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Clock-and-Wavefront Somite Segmentation (Kinematic Phase-Gating, Thom-Zeeman Cusp Catastrophe, Goldbeter FGF8/RA Bistable Front & Farhadifar Vertex Sheet)" ;
    pk:leanDeclaration "MathOfBiology.Loop_021.compartments" ;
    pk:leanTheorem "MathOfBiology.Loop_021.meinhardt_1986_half_somite_cleft_count" ;
    pk:leanVerified true .


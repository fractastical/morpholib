sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Model fidelity to source: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The Cooke & Zeeman (1976) kinematics (S = v*T_c, N = L/(v*T_c)) and the Thom-Zeeman cusp ODE are implemented as published (L208-223, L358-606) and the Pass 2 kinematic path is byte-identical (S_sim = 100.13 um, N = 40). Pass 3 adds the Goldbeter (2007) mechanism in recognisable form: mutual Hill repression, fgf8 mRNA decay gradient with lambda_F = v_tb/k_dM, bistable window located by a saddle-node scan (M_lo = 0.53), irreversible switching, and the front read off the toggle (L266-350, L428-494), with the predicted v_front = v_tb verified to 1e-4 %. The vertex sheet uses the Farhadifar energy with its case-I constants and an analytic gradient (L701-731). Deductions: the toggle is a two-variable reduction with Cyp26/Raldh2 lumped and alpha, K, n, tau_FR, k_dM tuned rather than taken from the paper (-4); the chi = +1/-1 -> anterior/posterior half-somite identification that decides cleft placement is an interpretive step (Saga & Takeda 2001), not Cooke-Zeeman's (-2); the sheet has no T1 transitions, so the zig-zag cleft can only partially resolve and no rosette forms (-2); the commitment mobility window m(x,t) remains an added construct not in the 1976 paper (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L136–L148: FGF_RA_PARAMS are tuned normalised constants (alpha 3, K 1, n 4, tau 12 min, k_dM 0.0074/min), not Goldbeter's published values; docstring L80-81 states the Cyp26/Raldh2 lumping <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L136-L148>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-6> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L208–L223" ;
        dct:description "Analytical S = v*T_c and N = L/(v*T_c) (Laws 1-2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L208-L223> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L266–L350" ;
        dct:description "Reduced Goldbeter toggle steady-state scan: saddle-node bistable window [M_lo, M_hi] and front threshold M_lo" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L266-L350> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L428–L494" ;
        dct:description "fgf_ra branch: tailbud M_F gradient, Euler toggle update, a = tanh((R-F)/kappa_a), m = F^4/(F^4+K_mob^4), front located from a = 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L428-L494> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L701–L731" ;
        dct:description "Farhadifar (2007) energy gradient: area elasticity, perimeter contractility, per-edge line tension" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L701-L731> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L817–L822" ;
        dct:description "Half-somite cleft rule: only posterior(-1)->anterior(+1) interfaces receive dLambda; no T1 transitions (docstring L778)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L817-L822> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_021_clock_and_wavefront.lean L75–L192" ;
        dct:description "Laws 4-5: front velocity = v_tb for any offset D, endogenous somite length, half-somite cleft count N, tension selectivity (0 sorry, lean 4.35 OK)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_021_clock_and_wavefront.lean#L75-L192> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


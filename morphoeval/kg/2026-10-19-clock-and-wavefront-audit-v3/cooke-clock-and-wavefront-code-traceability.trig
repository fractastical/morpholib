sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Code-to-model traceability: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring states Laws 1-5 with their equations, sources and Lean theorem names (L40-93); every section banner and function docstring names the paper, figure or law it implements (e.g. Section 4a Goldbeter 2007, Section 4c Farhadifar 2007 / Bi 2015, L262-265, L636-639); the math-KG loop file registers five equations with Lean loci and code loci, and the Lean file carries a docstring per law. Deductions: dLambda_cleft = 0.9, kappa_a = 0.5, K_mob = 0.3 and k_dM = 0.0074/min are tuned constants whose values are not traced to any source (-4); the stage schedule of the vertex relaxation (150 gradient steps per 40-min kymograph snapshot, L800, L825) has no physical time scale or citation (-3); the cusp commitment-mobility window is still uncited (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1976-cooke-clock-and-wavefront.py L136–L161: Tuned constants (kappa_a, K_mob, k_dM, dLambda_cleft) without source citation <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L136-L161>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L40–L93" ;
        dct:description "Governing Laws 1-5 with equations, sources and Lean theorem names" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L40-L93> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L262–L265" ;
        dct:description "Section 4a banner: Goldbeter-Gonze-Pourquie (2007) FGF8/RA bistable toggle analysis (Law 4)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L262-L265> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L636–L639" ;
        dct:description "Section 4c banner: vertex sheet (Farhadifar 2007; Bi 2015; Law 5)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1976-cooke-clock-and-wavefront.py#L636-L639> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/cooke-clock-and-wavefront.yaml L108–L159" ;
        dct:description "Equations 4-5 with Lean declarations, loci and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/cooke-clock-and-wavefront.yaml#L108-L159> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


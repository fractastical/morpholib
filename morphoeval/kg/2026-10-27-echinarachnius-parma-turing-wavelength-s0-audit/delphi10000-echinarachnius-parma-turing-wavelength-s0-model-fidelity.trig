sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "jacobian() (L85-L104) is the Schnakenberg steady state u* = a + b, v* = b/(a+b)² with trace -0.2 and det 1. dispersion_sigma (L107-L114) is the larger eigenvalue of J - k²D, and simulate_schnakenberg (L160-L200) is a periodic Fourier IMEX step with implicit diffusion. The Holocene ratio Dv/Du = 12 opens the Turing gap; Du = Dv closes it (self-test). Deduction: Du and Dv are spatial calibrations to the assigned 60 µm scale, not values from Schnakenberg (1979) or from a sand-dollar experiment (-6). Schnakenberg's paper is about limit cycles; the spatial extension is the standard one but it is an extension (-4)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L70–L76: Du and Dv are frozen calibrations to the 60 µm slot, not measured diffusivities <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L70-L76>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L85–L104" ;
        dct:description "Schnakenberg steady state and Jacobian" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L85-L104> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L107–L128" ;
        dct:description "Dispersion σ(k) and the trace-gap sign that decides whether a band of wavenumbers is unstable" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L107-L128> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L160–L200" ;
        dct:description "Periodic Fourier IMEX integrator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L160-L200> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean L45–L53" ;
        dct:description "Equal-diffusion gap is negative; ratio 12 gap is positive. No sorry." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/morphoeval/lean/loops/Loop_3214_echinarachnius_parma_turing_wavelength_s0.lean#L45-L53> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, Pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


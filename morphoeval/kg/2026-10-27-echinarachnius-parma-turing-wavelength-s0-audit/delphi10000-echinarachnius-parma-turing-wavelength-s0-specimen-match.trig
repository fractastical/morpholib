sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Morphological realism / specimen match: 82/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The comparison figure places the CC0 USNM E39365 plate (three living tests, 3 cm bar) next to the equilibrated 480 µm lattice, and the GIF grows that lattice inside a disc tinted with the plate's mean pigment (foreground RGB about 0.70, 0.45, 0.33). Computer-vision similarity of the 12-frame 560 px GIF against the plate is 85.2. Deductions: the simulation is a microscopic patch, not the whole tests (-8); segment_specimen (L269-L309) returns one union mask whose circularity 0.066 does not describe an individual disc (-6); spine-level texture on the photograph is not in the reaction-diffusion field (-4)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L269–L309: Union mask only; three individuals are one component set <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L269-L309>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/echinarachnius_parma_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "Six-panel figure: USNM plate, lattice, dispersion, sweep, ablation/scale bars, spacing histogram — docs/media/echinarachnius_parma_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py at 2340b0d2, image/png, 417295 B, 1512×984 px, artifact_sha256 ff8643dfdb5d8f2e95dad538bd4f79b2c10eba0af3349d7b80b6fdcfc7ffb9dc (sha256 ff8643dfdb5d8f2e95dad538bd4f79b2c10eba0af3349d7b80b6fdcfc7ffb9dc), spec_fingerprint e8201a3df779a67d8e85472abacbae9a6fbc7d0d99dd6ba261bbc538d065da4c" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/echinarachnius_parma_turing_wavelength_s0_growth.gif (generated output)" ;
        dct:description "12 frames, 560 px. Homogeneous noise becomes a spot lattice. CV similarity 85.2 versus USNM E39365. — docs/media/echinarachnius_parma_turing_wavelength_s0_growth.gif: rendered output of models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py at 2340b0d2, image/gif, 1556752 B, 560×560 px, 12 frames, artifact_sha256 8ed25a3ca06439746b8cdcd02440d59d05f53210bfea75d9c20fe7c3783bd1a0 (sha256 8ed25a3ca06439746b8cdcd02440d59d05f53210bfea75d9c20fe7c3783bd1a0), spec_fingerprint e8201a3df779a67d8e85472abacbae9a6fbc7d0d99dd6ba261bbc538d065da4c" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L316–L343" ;
        dct:description "Disc render uses the specimen mean pigment and a 60 µm scale bar" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L316-L343> .

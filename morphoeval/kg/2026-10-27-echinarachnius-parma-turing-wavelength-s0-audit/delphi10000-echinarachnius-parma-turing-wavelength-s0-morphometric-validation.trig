sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Equilibrated FFT wavelength 60.336 µm against the 60 µm slot (not copied: the value is the spectrum, the reference is the assignment). Pearson r of linear versus FFT wavelengths is 0.9965, RMSE 2.575 µm. Specimen foreground fraction 0.357 against a single-test prior of 0.70, union circularity 0.066 against 1, coherency 0.404 against a noise prior of 0.25. Nearest-neighbour spacing mean is 42.84 µm, which is not forced equal to 60 µm. Deduction: the KS statistic 0.143 is exactly 1/7, the resolution of a 7-point two-sample test, so it barely constrains the residual distribution (-8). Per-disc shape is not yet measured (-6)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L216–L224: KS sample size is the seven sweep points <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L216-L224>" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-10-m-predecessor-scale-amplitude>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-dispersion-peak-versus-equilibrated-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-equilibrated-activator-fft-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-linear-dispersion-peak-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-ocellus-nearest-neighbour-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-union-mask-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-usnm-e39365-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-wavelength-sweep-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-10-m-predecessor-scale-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "10 µm predecessor-scale amplitude = 0.0 std(u)" ;
        dct:description "chronoseries is 1/1, so the predecessor is a scale, not an older species" ;
        schema:measurementTechnique "same Du, Dv on a periodic patch of length 10 µm (below one wavelength)" ;
        schema:name "10 µm predecessor-scale amplitude" ;
        schema:unitText "std(u)" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-10-m-predecessor-scale-amplitude-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-10-m-predecessor-scale-amplitude-reference> a schema:PropertyValue ;
        dct:source "scale ladder at 0 Ma: the 10 µm tier is the predecessor of this 60 µm detail scale" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-dispersion-peak-versus-equilibrated-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-peak versus equilibrated wavelength Pearson r = 0.996549 Pearson r" ;
        dct:description "RMSE = 2.5753 µm; KS two-sample statistic = 0.1429" ;
        schema:measurementTechnique "corr(λ_linear(s), λ_FFT(s)) across diffusivity scales s in {0.35, 0.55, 0.80, 1, 1.4, 2, 3}" ;
        schema:name "dispersion-peak versus equilibrated wavelength Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.996549" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-dispersion-peak-versus-equilibrated-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-dispersion-peak-versus-equilibrated-wavelength-pearson-r-reference> a schema:PropertyValue ;
        dct:source "goodness-of-fit gate for the Turing wavenumber law" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation amplitude = 0.005687 std(u)" ;
        dct:description "Turing amplitude at ratio 12 is 0.4371" ;
        schema:measurementTechnique "same integrator with Du = Dv = DU_UM2; Turing trace gap is negative" ;
        schema:name "equal-diffusion ablation amplitude" ;
        schema:unitText "std(u)" ;
        schema:value "0.005687" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-equal-diffusion-ablation-amplitude-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusivities cannot destabilise a stable Jacobian" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-equilibrated-activator-fft-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equilibrated activator FFT wavelength = 60.3365 µm" ;
        dct:description "amplitude std(u) = 0.4371; seed 3214" ;
        schema:measurementTechnique "parabolic interpolation of the radial power spectrum of u on the 480 µm periodic patch" ;
        schema:name "equilibrated activator FFT wavelength" ;
        schema:unitText "µm" ;
        schema:value "60.3365" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-equilibrated-activator-fft-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-equilibrated-activator-fft-wavelength-reference> a schema:PropertyValue ;
        dct:source "detail scale 6e-05 m assigned to this Holocene epithelial patch" ;
        schema:value "60.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-linear-dispersion-peak-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "linear dispersion peak wavelength = 61.3431 µm" ;
        dct:description "linear peak is deliberately a few micrometres off 60 so the equilibrated lattice, not the onset mode, carries the slot scale" ;
        schema:measurementTechnique "argmax of σ(k), the larger eigenvalue of J − k²D, at Du, Dv" ;
        schema:name "linear dispersion peak wavelength" ;
        schema:unitText "µm" ;
        schema:value "61.3431" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-linear-dispersion-peak-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-linear-dispersion-peak-wavelength-reference> a schema:PropertyValue ;
        dct:source "slot scale 60 µm; Turing 1952 dispersion; Schnakenberg 1979 Jacobian" ;
        schema:value "60.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-ocellus-nearest-neighbour-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ocellus nearest-neighbour spacing = 42.8407 µm" ;
        dct:description "spacing CV = 0.4526; n_peaks = 78" ;
        schema:measurementTechnique "periodic nearest-neighbour distance of activator peaks above mean + 0.45 std" ;
        schema:name "ocellus nearest-neighbour spacing" ;
        schema:unitText "µm" ;
        schema:value "42.8407" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-ocellus-nearest-neighbour-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-ocellus-nearest-neighbour-spacing-reference> a schema:PropertyValue ;
        dct:source "FFT wavelength is the row period; nearest neighbours of a spot lattice need not equal it" ;
        schema:value "60.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.4035 coherency" ;
        schema:measurementTechnique "mean (λ1−λ2)/(λ1+λ2) of the Sobel structure tensor inside the foreground" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.4035" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "spine canopy is locally oriented, so coherency exceeds an isotropic noise prior of 0.25" ;
        schema:value "0.25" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-union-mask-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen union-mask circularity = 0.066 4πA/P²" ;
        dct:description "bounding aspect ratio width/height = 1.4134" ;
        schema:measurementTechnique "circularity of the union of all bright tests, not of one individual" ;
        schema:name "specimen union-mask circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.066" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-union-mask-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-union-mask-circularity-reference> a schema:PropertyValue ;
        dct:source "a single disc would be near 1; three separate tests on one plate are not" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-usnm-e39365-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen USNM E39365 foreground fraction = 0.3574 area fraction" ;
        dct:description "reference 0.70 is a single-test fill prior; the plate holds three tests, so the fraction is lower" ;
        schema:measurementTechnique "pixels with luminance > 0.18 on the CC0 plate, opened and hole-filled" ;
        schema:name "specimen USNM E39365 foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.3574" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-usnm-e39365-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-specimen-usnm-e39365-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "USNM E39365 aboral photographs; black museum ground, three tests" ;
        schema:value "0.7" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep KS statistic = 0.1429 KS D" ;
        schema:measurementTechnique "two-sample Kolmogorov-Smirnov statistic between linear and FFT wavelength samples" ;
        schema:name "wavelength sweep KS statistic" ;
        schema:unitText "KS D" ;
        schema:value "0.1429" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-wavelength-sweep-ks-statistic-reference> a schema:PropertyValue ;
        dct:source "scipy.stats.ks_2samp" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-wavelength-sweep-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelength sweep RMSE = 2.5753 µm" ;
        dct:description "a nonzero RMSE is the nonlinear shift above onset, not a missing sweep" ;
        schema:measurementTechnique "root mean square of λ_FFT − λ_linear across the diffusivity sweep" ;
        schema:name "wavelength sweep RMSE" ;
        schema:unitText "µm" ;
        schema:value "2.5753" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-measurement-wavelength-sweep-rmse-reference> a schema:PropertyValue ;
        dct:source "zero residual would mean the nonlinear lattice sits on the linear peak" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L216–L224" ;
        dct:description "Pearson, RMSE, and two-sample KS on the wavelength sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L216-L224> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L467–L579" ;
        dct:description "measure_morphoeval rows; specimen metrics use reference values that differ from the measurement" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L467-L579> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "datasets/echinarachnius_parma_turing_wavelength_s0/echinarachnius_parma_turing_wavelength_s0_run_results.json L11–L16" ;
        dct:description "Recorded Pearson r 0.9965, RMSE 2.575 µm, KS 0.143" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/datasets/echinarachnius_parma_turing_wavelength_s0/echinarachnius_parma_turing_wavelength_s0_run_results.json#L11-L16> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, Pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;

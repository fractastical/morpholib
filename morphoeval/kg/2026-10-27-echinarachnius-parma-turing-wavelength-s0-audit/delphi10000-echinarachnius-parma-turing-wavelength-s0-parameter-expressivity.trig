sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Parameter expressivity: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "wavelength_sweep (L202-L214) multiplies both diffusivities by s in {0.35, 0.55, 0.80, 1, 1.4, 2, 3}. Measured wavelength increases from the short-wavelength end to the long-wavelength end (self-test asserts the endpoints are ordered). ablation_equal_diffusion (L226-L230) is a real negative control, amplitude 5.69e-3 against 0.437. domain_series (L232-L246) repeats the same kinetics at 10, 60, 120, 480 and 600 µm; only 10 µm quenches. Deduction: the zero bar has no height, so the quench is easy to miss on the figure (-6). Feed rates a and b are not swept (-6)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "docs/media/echinarachnius_parma_turing_wavelength_s0_comparison.png (generated output, not in repo): Sweep panel Pearson r = 0.9965; ablation bar is near zero; the 10 µm bar is also zero and unlabeled as such — docs/media/echinarachnius_parma_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py at 2340b0d2, image/png, 417295 B, 1512×984 px, artifact_sha256 ff8643dfdb5d8f2e95dad538bd4f79b2c10eba0af3349d7b80b6fdcfc7ffb9dc (sha256 ff8643dfdb5d8f2e95dad538bd4f79b2c10eba0af3349d7b80b6fdcfc7ffb9dc), spec_fingerprint e8201a3df779a67d8e85472abacbae9a6fbc7d0d99dd6ba261bbc538d065da4c" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L202–L214" ;
        dct:description "Diffusivity-scale sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L202-L214> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L226–L246" ;
        dct:description "Equal-diffusion ablation and the 10–600 µm scale ladder" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L226-L246> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (primary assessor, Pass 1)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


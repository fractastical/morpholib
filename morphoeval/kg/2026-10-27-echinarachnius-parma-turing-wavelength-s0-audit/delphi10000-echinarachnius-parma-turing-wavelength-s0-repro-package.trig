sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Echinarachnius parma Holocene 60 µm Schnakenberg Turing wavelength — Reproducibility package: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Seed 3214. --self-test checks the Jacobian signs, the SHA-256 pin, the Lean text, a repeated-run wavelength identity, the ablation, the 10 µm quench, Pearson r > 0.98, and that the specimen union is not a circle. main() refuses to exit 0 unless the GIF has at least 10 frames and 480 px and Pearson r exceeds 0.98. This run: FFT λ 60.336 µm, r = 0.9965, GIF 560×560 × 12. Deduction: there is no pinned requirements lock specific to this script; it uses the repository scientific stack (-6). Lean was not executed here because the lean binary is not installed (-6)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L643–L688" ;
        dct:description "Self-test assertions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2340b0d2/models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py#L643-L688> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-echinarachnius-parma-turing-wavelength-s0-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-echinarachnius-parma-turing-wavelength-s0.py L54–L58" ;

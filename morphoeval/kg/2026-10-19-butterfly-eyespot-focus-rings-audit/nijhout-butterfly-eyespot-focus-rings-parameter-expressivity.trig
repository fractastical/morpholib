sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nijhout-butterfly-eyespot-focus-rings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Parameter expressivity: 44/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Hardcodes c0=1.0 and lambda_mm=0.48 (L23-50) without CLI parameter overrides, wet/dry seasonal ecdysone polyphenism sweep, *Goldeneye* threshold shift, twin-focus inter-focal distance sweep, or pupal cautery timing series." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2001-nijhout-butterfly-eyespot-focus-rings.py L23–L50: Single hardcoded parameter set without CLI overrides or experimental regime sweeps <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L23-L50>" ;
        pk:hasScore "0.44"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


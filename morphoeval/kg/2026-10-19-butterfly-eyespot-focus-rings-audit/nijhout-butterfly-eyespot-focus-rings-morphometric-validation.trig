sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nijhout-butterfly-eyespot-focus-rings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Morphometric validation: 50/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Reports only 3 analytical ring radii in `measure_morphoeval()` (L118-130) without validating Stage-1 midline focus convergence, wet/dry seasonal gold annulus invariance, *Goldeneye* gold-ring expansion, twin-focus bridge concentration, pupal cautery timing curve, or empirical *Bicyclus anynana* Cu1 specimen ring radii and proportions." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2001-nijhout-butterfly-eyespot-focus-rings.py L118–L130: Only 3 basic analytical radii without specimen or multi-regime morphometrics <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L118-L130>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-black-melanin-disc-radius-r-black>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-central-pupil-radius-r-pupil>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-outer-gold-ring-radius-r-gold> ;
        pk:hasScore "0.5"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-black-melanin-disc-radius-r-black> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wet-season black melanin disc radius R_black = 0.8234 mm" ;
        schema:measurementTechnique "Analytical R_black = lambda * ln(c0 / theta_black)" ;
        schema:name "Wet-season black melanin disc radius R_black" ;
        schema:unitText "mm" ;
        schema:value "0.8234" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-black-melanin-disc-radius-r-black-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-black-melanin-disc-radius-r-black-reference> a schema:PropertyValue ;
        dct:source "Brakefield et al. (1996) Nature 384:236-242" ;
        schema:value "0.8234" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-central-pupil-radius-r-pupil> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wet-season central pupil radius R_pupil = 0.1951 mm" ;
        schema:measurementTechnique "Analytical R_pupil = lambda * ln(c0 / theta_pupil)" ;
        schema:name "Wet-season central pupil radius R_pupil" ;
        schema:unitText "mm" ;
        schema:value "0.1951" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-central-pupil-radius-r-pupil-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-central-pupil-radius-r-pupil-reference> a schema:PropertyValue ;
        dct:source "Brakefield et al. (1996) Nature 384:236-242" ;
        schema:value "0.1951" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-outer-gold-ring-radius-r-gold> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wet-season outer gold ring radius R_gold = 1.0883 mm" ;
        schema:measurementTechnique "Analytical R_gold = lambda * ln(c0 / theta_gold)" ;
        schema:name "Wet-season outer gold ring radius R_gold" ;
        schema:unitText "mm" ;
        schema:value "1.0883" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-outer-gold-ring-radius-r-gold-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-nijhout-butterfly-eyespot-focus-rings-measurement-wet-season-outer-gold-ring-radius-r-gold-reference> a schema:PropertyValue ;
        dct:source "Brakefield et al. (1996) Nature 384:236-242" ;
        schema:value "1.0882" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


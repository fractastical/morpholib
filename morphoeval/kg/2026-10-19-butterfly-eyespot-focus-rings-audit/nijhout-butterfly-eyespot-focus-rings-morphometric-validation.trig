    <https://doi.org/10.1006/dbio.1995.1065> dct:date "1995"^^xsd:gYear ;
        dct:title "Eyespot development on butterfly wings: the epidermal response to damage" .
    <https://doi.org/10.1016/S0960-9822(01)00429-8> dct:date "2001"^^xsd:gYear ;
        dct:title "The generation and diversification of butterfly eyespot color patterns" .
    <https://doi.org/10.1038/384236a0> dct:date "1996"^^xsd:gYear ;

<https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Code-to-model traceability: 60/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Header docstring mentions Nijhout (1990) and Brakefield et al. (1996), but functions lack explicit mappings to published equations and to the 4 Lean 4 theorems in `morphoeval/lean/loops/Loop_098_butterfly_eyespot_focus_rings.lean`." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:evidenceAgainst "2001-nijhout-butterfly-eyespot-focus-rings.py L23–L50: Functions lack explicit paper equation and Lean 4 theorem cross-references <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L23-L50>" ;
    pk:hasScore 6e-01 ;
    pk:hasVerdict "mostly faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Model fidelity to source: 52/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Evaluates only the 1D analytical exponential formula c(r) = c0 * exp(-r/lambda) and a static 2D circle mask (L23-50), omitting Stage-1 2D Meinhardt activator-inhibitor reaction-diffusion from bounding wing veins to isolate the midline focus (Nijhout 1990), Stage-2 2D PDE relaxation, twin-focus superposition hourglass bridges, and pupal cautery timing series." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:evidenceAgainst "2001-nijhout-butterfly-eyespot-focus-rings.py L23–L50: 1D analytical exponential formula without Stage-1 2D vein-to-midline focus reaction-diffusion or 2D focal PDE solver <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L23-L50>" ;
    pk:hasScore 5.2e-01 ;
    pk:hasVerdict "partially faithful" .


    <https://doi.org/10.1006/dbio.1995.1065> dcterms:date "1995"^^xsd:gYear ;
        dcterms:title "Eyespot development on butterfly wings: the epidermal response to damage" .

    <https://doi.org/10.1016/S0960-9822(01)00429-8> dcterms:date "2001"^^xsd:gYear ;
        dcterms:title "The generation and diversification of butterfly eyespot color patterns" .

    <https://doi.org/10.1038/384236a0> dcterms:date "1996"^^xsd:gYear ;
        dcterms:title "Development, plasticity and evolution of butterfly eyespot patterns" .

    <https://doi.org/10.1038/416844a> dcterms:date "2002"^^xsd:gYear ;
        dcterms:title "Developmental constraints versus flexibility in morphological evolution" .

    <https://doi.org/10.1098/rspb.1990.0048> dcterms:date "1990"^^xsd:gYear ;
        dcterms:title "A comprehensive model for colour pattern formation in butterflies" .
}


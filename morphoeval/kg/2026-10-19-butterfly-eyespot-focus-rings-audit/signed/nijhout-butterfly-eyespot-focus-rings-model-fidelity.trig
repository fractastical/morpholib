sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nijhout-butterfly-eyespot-focus-rings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Model fidelity to source: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates only the 1D analytical exponential formula c(r) = c0 * exp(-r/lambda) and a static 2D circle mask (L23-50), omitting Stage-1 2D Meinhardt activator-inhibitor reaction-diffusion from bounding wing veins to isolate the midline focus (Nijhout 1990), Stage-2 2D PDE relaxation, twin-focus superposition hourglass bridges, and pupal cautery timing series." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2001-nijhout-butterfly-eyespot-focus-rings.py L23–L50: 1D analytical exponential formula without Stage-1 2D vein-to-midline focus reaction-diffusion or 2D focal PDE solver <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L23-L50>" ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


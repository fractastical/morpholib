sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-nijhout-butterfly-eyespot-focus-rings> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-nijhout-butterfly-eyespot-focus-rings-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Nijhout (1990) & Brakefield et al. (1996) butterfly wing-vein focus determination and concentric French-flag eyespot ring morphogenesis — Morphological realism / specimen match: 24/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Renders a 2-panel synthetic plot (L53-86) without loading, SHA-256-verifying, or performing radial luminance and golden-chroma concentric ring segmentation on the vendored *Bicyclus anynana* specimen photograph (`datasets/butterfly_eyespot_focus_rings/bicyclus_anynana_eyespot_specimen.jpg`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2001-nijhout-butterfly-eyespot-focus-rings.py L53–L86: 2-panel synthetic plot with zero biological specimen comparison <https://github.com/fractastical/morpholib/blob/HEAD/2001-nijhout-butterfly-eyespot-focus-rings.py#L53-L86>",
            "docs/media/butterfly_eyespot_focus_rings_comparison.png (generated output, not in repo): Pass 1 2-panel plot lacking Bicyclus anynana ventral wing eyespot segmentation — docs/media/butterfly_eyespot_focus_rings_comparison.png: rendered output of 2001-nijhout-butterfly-eyespot-focus-rings.py at HEAD, image/png, 79032 B, 1400×588 px, artifact_sha256 6ecb6d8e0b918529a896cdbe3567e958ca7f94bdb3dfb0c94623949819152591 (sha256 6ecb6d8e0b918529a896cdbe3567e958ca7f94bdb3dfb0c94623949819152591), spec_fingerprint 0a2086f2436043ce9998603ef36e23feb6c621834d7d960a99310b296156772b" ;
        pk:hasScore "0.24"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 1 baseline assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


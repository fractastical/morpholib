sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting + Ouchi et al. (2003) cortical tension — Morphometric validation: 85/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: `measure_morphoeval()` (L1265-1391) returns 15 measurements with non-null references and units, including the 7 new Pass 3 metrics (P_t = 44 vs Lean, RMS(p - P_t) 1.73 vs the lambda_P = 0 baseline 14.05, shape index 12.30 vs the square's 11.0, fragmented fraction 0.083 vs 0, cortical Delta_r +0.355 vs +0.332, monotone RMS over the lambda_P sweep, P_t tracking r = 0.9999); the morphometrics (L238-359) compute heterotypic boundary fraction, envelopment, radial separation, volume and perimeter statistics and 12-annulus profiles; the log-decay fit gives r = -0.946. Deductions: the PRL Fig. 3 'checkpoint concordance' r = 0.972 is against five `empirical_mcs_checkpoints` (0-150 MCS, het fraction 0.48 -> 0.15) in the reference JSON that carry no digitisation provenance — the paper's Fig. 3 spans ~10^4 MCS for V_t ~ 40 cells, so these are at best rescaled and at worst invented, and the comparison is not a validation against the paper (-7); four of the new references are self-referential (the lambda_P = 0 run or the sweep's own values) rather than literature values, and the shape index reference 11.0 is a geometric constant, not a measured cell shape (-4); the mean cell volume (75.6 % of V_t) is computed but not reported as a measurement with reference V_t (-2); no measurement of the swap-move contribution to sorting exists, so the reported Delta_r cannot be attributed to the Hamiltonian (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L1349–L1355: cortical_tension_rms_perimeter_deviation reference_value is the script's own lambda_P = 0 run (self-referential) <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L1349-L1355>",
            "datasets/cellular_potts_cell_sorting/cellular_potts_cell_sorting_reference.json L169–L180: PRL Fig. 3 'empirical_mcs_checkpoints' at 0-150 MCS with no digitisation provenance; the paper's figure spans ~10^4 MCS <https://github.com/fractastical/morpholib/blob/654cd6fc/datasets/cellular_potts_cell_sorting/cellular_potts_cell_sorting_reference.json#L169-L180>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-core-shell-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-fragmented-cell-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-rms-perimeter-deviation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-shape-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-sorting-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-target-perimeter-square-block>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-lam-perim-sweep-rms-perimeter-monotone-decreasing>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-specimen-vs-cpm-radial-profile-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-target-perimeter-sweep-tracking-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-zero-temperature-pinning-arrest-radial-separation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation-3> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "checkerboard_mixing_heterotypic_boundary_fraction = 0.7201 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_LD/L_total in checkerboard mixing regime (gamma_LD = -10 < 0)" ;
        schema:name "checkerboard_mixing_heterotypic_boundary_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.7201" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-checkerboard-mixing-heterotypic-boundary-fraction-reference> a schema:PropertyValue ;
        schema:value "0.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "complete_sorting_heterotypic_boundary_fraction = 0.1705 fraction" ;
        schema:measurementTechnique "Final heterotypic boundary fraction L_LD/L_total after 150 MCS with logarithmic decay r=-0.9459 (p=9.40e-75, Fig. 3 checkpoint r=0.9724)" ;
        schema:name "complete_sorting_heterotypic_boundary_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.1705" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-heterotypic-boundary-fraction-reference> a schema:PropertyValue ;
        schema:value "0.15" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-core-shell-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "complete_sorting_radial_core_shell_separation = 0.3317 normalized_radius" ;
        schema:measurementTechnique "Normalized radial separation (r_L - r_D)/R_agg in complete sorting regime vs segmented confocal embryonic cell aggregate specimen (r=0.9612, p=0.0001)" ;
        schema:name "complete_sorting_radial_core_shell_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.3317" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-core-shell-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-complete-sorting-radial-core-shell-separation-reference> a schema:PropertyValue ;
        schema:value "0.2793" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-fragmented-cell-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cortical_tension_fragmented_cell_fraction = 0.0833 fraction" ;
        schema:measurementTechnique "Fraction of cells split into > 1 8-connected component at lambda_P = 2, T = 10 (lambda_P = 0 baseline 0.2167); biological cells are simply connected (reference 0)" ;
        schema:name "cortical_tension_fragmented_cell_fraction" ;
        schema:unitText "fraction" ;
        schema:value "0.0833" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-fragmented-cell-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-fragmented-cell-fraction-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-rms-perimeter-deviation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cortical_tension_rms_perimeter_deviation = 1.7321 eight_neighbour_bonds" ;
        schema:measurementTechnique "RMS (p_sigma - P_t) at lambda_P = 2, P_t = 44, T = 10 after 150 MCS vs the lambda_P = 0 exact-1992 ablation baseline (reference_value); perimeter bookkeeping max |error| = 0" ;
        schema:name "cortical_tension_rms_perimeter_deviation" ;
        schema:unitText "eight_neighbour_bonds" ;
        schema:value "1.7321" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-rms-perimeter-deviation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-rms-perimeter-deviation-reference> a schema:PropertyValue ;
        schema:value "14.0475" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-shape-index> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cortical_tension_shape_index = 12.3042 dimensionless" ;
        schema:measurementTechnique "Mean shape index q = p_sigma / sqrt(v_sigma) at lambda_P = 2 (lambda_P = 0 baseline q = 13.2676) vs the compact 4 x 4 square reference q = 44 / 4 = 11.0" ;
        schema:name "cortical_tension_shape_index" ;
        schema:unitText "dimensionless" ;
        schema:value "12.3042" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-shape-index-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-shape-index-reference> a schema:PropertyValue ;
        schema:value "11.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-sorting-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cortical_tension_sorting_radial_separation = 0.3545 normalized_radius" ;
        schema:measurementTechnique "Radial core-shell separation (r_L - r_D)/R_agg with the perimeter term active (lambda_P = 2) vs the lambda_P = 0 canonical sorting run: differential-adhesion sorting must survive cortical tension" ;
        schema:name "cortical_tension_sorting_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.3545" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-sorting-radial-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-sorting-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.3317" .

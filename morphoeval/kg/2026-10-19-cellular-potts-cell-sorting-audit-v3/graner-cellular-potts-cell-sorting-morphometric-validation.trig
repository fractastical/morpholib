            pk:EvidenceItem ;
        rdfs:label "cortical_tension_target_perimeter_square_block = 44.0 eight_neighbour_bonds" ;
        schema:measurementTechnique "Default target perimeter P_t = 12 s - 4 for the s x s = 4 x 4 (V_t = 16) square block in 8-neighbour bond units (Lean square_block_perimeter_8nbr; 4 corners x 5 + 8 edge sites x 3 = 44)" ;
        schema:name "cortical_tension_target_perimeter_square_block" ;
        schema:unitText "eight_neighbour_bonds" ;
        schema:value "44.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-target-perimeter-square-block-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-target-perimeter-square-block-reference> a schema:PropertyValue ;
        schema:value "44.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_adhesion_control_radial_separation = 0.0353 normalized_radius" ;
        schema:measurementTechnique "Null radial core-shell separation |r_L - r_D|/R_agg in equal-adhesion negative control (J_LL=J_DD=J_LD=10, gamma_LD=0)" ;
        schema:name "equal_adhesion_control_radial_separation" ;
        schema:unitText "normalized_radius" ;
        schema:value "0.0353" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_gamma_LD_sorting = 3.0 bond_energy_units" ;
        schema:measurementTechnique "Exact Graner & Glazier (1992) PRL Eq. 2 heterotypic surface tension gamma_LD = J_LD - (J_LL + J_DD)/2 for J_LL=14, J_DD=2, J_LD=11" ;
        schema:name "graner_glazier_gamma_LD_sorting" ;
        schema:unitText "bond_energy_units" ;
        schema:value "3.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting-reference> a schema:PropertyValue ;
        schema:value "3.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "graner_glazier_spreading_tension_diff = 6.0 bond_energy_units" ;
        schema:measurementTechnique "Spreading tension difference gamma_DM - gamma_LM = (J_DM - J_DD/2) - (J_LM - J_LL/2) = 15 - 9 = 6 (Graner & Glazier 1992 PRL Eq. 3)" ;
        schema:name "graner_glazier_spreading_tension_diff" ;
        schema:unitText "bond_energy_units" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff-reference> a schema:PropertyValue ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-lam-perim-sweep-rms-perimeter-monotone-decreasing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "lam_perim_sweep_rms_perimeter_monotone_decreasing = 1.0 boolean" ;
        schema:measurementTechnique "RMS (p_sigma - P_t) is non-increasing across the 6-point lambda_P sweep [0.0, 0.25, 0.5, 1.0, 2.0, 4.0] at T = 10 (values [14.05, 4.61, 3.64, 2.32, 1.73, 1.06])" ;
        schema:name "lam_perim_sweep_rms_perimeter_monotone_decreasing" ;
        schema:unitText "boolean" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-lam-perim-sweep-rms-perimeter-monotone-decreasing-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-lam-perim-sweep-rms-perimeter-monotone-decreasing-reference> a schema:PropertyValue ;
        schema:value "1.0" .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting + Ouchi et al. (2003) cortical tension — Parameter expressivity: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: six regimes (A1-A5 + cortical tension C1), a 7-point J_LD sweep spanning gamma_LD in [-4, +9] (L630-662, Panel B2), a 6-point temperature sweep T in {0, 1.5, 5, 10, 25, 80} (L665-695, Panel B5), and the new Pass 3 sweeps: lambda_P in {0, 0.25, 0.5, 1, 2, 4} at T = 10 and T = 80 (L702-741, Panels C2/C5), P_t in {32, 38, 44, 50, 56} at lambda_P = 2 (L744-777, Panel C4) with realised mean perimeter tracking P_t to within 2 bonds (r = 0.9999) and the shape index rising monotonically; CLI exposes every J, V_t, lambda, T, MCS, seed plus the new --lam-P and --Pt (L1505-1523). Deductions: lambda (volume multiplier) is never swept although it is the parameter whose weakness produces the 76 % volume deficit (-4); the lambda_P sweep is run only at the complete-sorting J set, so the term's effect on the checkerboard and dissociation regimes is untested (-3); grid size and cell count are fixed (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity-4> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L630–L695" ;
        dct:description "7-point J_LD sweep and 6-point temperature sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L630-L695> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L698–L777" ;
        dct:description "Pass 3 lambda_P ablation sweep (6 values) and P_t sweep (5 values) returning perimeter, shape index, fragmentation and sorting order parameters" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L698-L777> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L1505–L1523" ;
        dct:description "CLI: --J-LL/--J-DD/--J-LD/--J-LM/--J-DM/--Vt/--lam/--T/--mcs/--seed plus Pass 3 --lam-P and --Pt" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L1505-L1523> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L963–L967" ;
        dct:description "All five sweeps wired into the default render (B2, B5, C2, C4, C5)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L963-L967> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


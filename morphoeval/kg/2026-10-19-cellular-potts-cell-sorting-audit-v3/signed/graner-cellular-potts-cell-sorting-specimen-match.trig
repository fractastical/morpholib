sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting + Ouchi et al. (2003) cortical tension — Morphological realism / specimen match: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the SHA-256-locked confocal embryoid-body specimen is segmented into a GFP core (r_D/R = 0.49) and RFP shell (r_L/R = 0.77, Delta_r = +0.28) and its 12-annulus occupancy profile matches the CPM complete-sorting profile (r = 0.961, RMSE = 0.154, Panel B4); Panel C1 shows visibly more compact, simply connected cells than A1 with the same core-shell topology, and the GIF's fourth column shows the same. Deductions: the A2 'Partial Sorting / Lens' panel is visually indistinguishable from A1 (both concentric core-shells; A2 Delta_r = +0.352 exceeds A1's +0.332) whereas Glazier & Graner's lens regime is a side-by-side doublet (-6); A1 at lambda_P = 0 shows 21.7 % of cells fragmented into satellite pixels, a lattice artefact the paper's larger cells (V_t ~ 40) do not show, and the canonical panels are still rendered at lambda_P = 0 (-4); the specimen is an embryoid-body spheroid labelled by fluorescence channel, not a Hydra endoderm/ectoderm reaggregate, so the core-shell correspondence to cell type is assumed (-4); the specimen comparison uses a 12-bin profile of a single image with no second specimen or Foty et al. (1996) envelopment measurement (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L932–L936: partial_sorting_lens regime rendered as Panel A2; realised Delta_r = +0.352 > A1, not a lens doublet <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L932-L936>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L791–L896" ;
        dcterms:description "Specimen segmentation (GFP core, RFP shell), 12-annulus profiles, Pearson r / RMSE and Fig. 3 checkpoint correlation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L791-L896> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/cellular_potts_cell_sorting_comparison.png (generated output)" ;
        dcterms:description "15-panel figure: A1-A5 regimes, B3 specimen overlay, B4 profile match r = 0.961, C1 compact cortical-tension cells; A2 'lens' is a concentric core-shell indistinguishable from A1 — docs/media/cellular_potts_cell_sorting_comparison.png: rendered output of 1992-graner-cellular-potts-cell-sorting.py at 654cd6fc, image/png, 844973 B, 3000×1890 px, artifact_sha256 a2f5372c202e946ae397351314585b49d1db212e3088826bfc3b642308249496 (sha256 a2f5372c202e946ae397351314585b49d1db212e3088826bfc3b642308249496), spec_fingerprint 7cdd3f38f0e6192e614f25f3f47d81cb4d09870705b0e0dca1d1d4dbca9f4cc0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/cellular_potts_cell_sorting_growth.gif (generated output)" ;
        dcterms:description "4-column GIF: complete sorting, T = 0 pinning, checkerboard, cortical tension lambda_P = 2 (compact cells, sorted core-shell) — docs/media/cellular_potts_cell_sorting_growth.gif: rendered output of 1992-graner-cellular-potts-cell-sorting.py at 654cd6fc, image/gif, 371603 B, 1280×350 px, 18 frames, artifact_sha256 fef992eabc97bd8fea7083e3868ae788590c2d501ed755e39a74144a41d23519 (sha256 fef992eabc97bd8fea7083e3868ae788590c2d501ed755e39a74144a41d23519), spec_fingerprint 7cdd3f38f0e6192e614f25f3f47d81cb4d09870705b0e0dca1d1d4dbca9f4cc0" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-repro-package> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L1394–L1501" ;
        dcterms:description "12-check self_test(): SHA-256, tension parity, controls, T = 0 arrest, log decay, specimen, determinism, 15-measurement contract, perimeter definition, bookkeeping drift, lambda_P monotonicity, P_t tracking" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L1394-L1501> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L1462–L1466" ;
        dcterms:description "lambda_P = 0 reproduces the Pass 2 lattice bit-for-bit; perimeter bookkeeping max |error| = 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L1462-L1466> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L1504–L1560" ;
        dcterms:description "CLI with --lam-P / --Pt and a main() summary printing Delta_r, RMS(p - P_t), fragmentation, shape index and P_t tracking" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L1504-L1560> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting + Ouchi et al. (2003) cortical tension — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: deterministic RNG (seed 1992) with a two-run bitwise determinism check (self-test 7) and a bit-for-bit lambda_P = 0 regression against the Pass 2 kernel (check 9); the 12-check `self_test()` (L1394-1501) covers SHA-256, exact tension parity across 5 regimes, sorting vs controls, T = 0 arrest, log decay, specimen correlation, the 15-measurement contract, perimeter definition (4 x 4 = 44, 3 x 3 = 32), zero bookkeeping drift, shape regularisation, lambda_P monotonicity and P_t tracking; `--self-test` runs in ~23 s and the default render in ~20 s, producing the PNG and GIF; `--lam-P` and `--Pt` are documented in argparse and the main() summary prints every headline number. Deductions: no requirements lock file pins numpy/scipy/matplotlib versions (-3); matplotlib emits a font-cache warning when MPLCONFIGDIR is unset, which the invocation notes do not mention (-1); the v2 audit's '<2 s self-test' claim is now 23 s and the README section for this script was not updated in this loop (out of scope for the slot) (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-graner-cellular-potts-cell-sorting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L1–L43" ;
        dcterms:description "Module docstring maps PRL Eqs. 1-3, PRE Table I/§III.B and Ouchi 2003 Eq. 2 to code and Lean declarations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L1-L43> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "1992-graner-cellular-potts-cell-sorting.py L378–L398" ;
        dcterms:description "simulate_cpm_regime docstring: Hamiltonian, Pass 3 extension, lambda_P = 0 recovery, temperature regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L378-L398> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/graner-cellular-potts-cell-sorting.yaml L1–L103" ;
        dcterms:description "6 registered equations with Lean theorem names and single-range code loci re-pinned to the current file" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/654cd6fc/morphoeval/math_kg_loops/graner-cellular-potts-cell-sorting.yaml#L1-L103> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-graner-cellular-potts-cell-sorting-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Graner & Glazier (1992) / Glazier & Graner (1993) extended large-Q Cellular Potts Model cell sorting + Ouchi et al. (2003) cortical tension — Code-to-model traceability: 83/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the module docstring (L1-43) maps every Hamiltonian term, tension relation, regime inequality and the Pass 3 perimeter term to PRL/PRE/Physica A equation numbers and to the Lean declarations; `compute_cpm_tensions`, `square_block_perimeter_8nbr`, `perimeter_energy_delta` and `simulate_cpm_regime` docstrings name the matching Lean theorems; the math_kg loop file registers 6 equations with single-range code loci (re-pinned this pass). Deductions: the identity-swap block is labelled 'Thermally activated cell-neighbor rearrangement moves' citing §III.B (L467-468), which describes thermal boundary fluctuations, not whole-cell identity exchange — the comment misattributes a non-paper mechanism to the paper (-6); the constants 1.8 (lateral bias), 2.5 T (swap temperature), 6 (volume floor), 1.5 (trials per boundary site) and the 17.8 px seeding radius carry no comment or citation (-4); `depinning_prob` is documented in a comment (L451-453) as the pinning activation factor but never used, so the docstring's §III.B pinning explanation is not what the code does (-3); the Section 2 header still says 'Graner & Glazier 1992' although the kernel contains the swap move and the Ouchi term (-1); `is_partial` branches on the classifier string, coupling the regime label to the dynamics (-1 net of the honest lambda_P = 0 disclosure in the docstring)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "1992-graner-cellular-potts-cell-sorting.py L467–L500: Swap block attributed to Glazier & Graner §III.B; uncited constants 1.8, 2.5 T <https://github.com/fractastical/morpholib/blob/654cd6fc/1992-graner-cellular-potts-cell-sorting.py#L467-L500>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-code-traceability-3> ;
        pk:hasScore "0.83"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

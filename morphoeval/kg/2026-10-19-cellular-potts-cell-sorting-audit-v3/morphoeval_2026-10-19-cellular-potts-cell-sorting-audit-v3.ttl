        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-13>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-14>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-15>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-6>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-7>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-8>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-cellular-potts-cell-sorting-audit-v3-graner-cellular-potts-cell-sorting-9> ;
    pk:hypothesisType "Glazier-Graner-Hogeweg Extended Large-Q Cellular Potts Model (CPM)" ;
    pk:weightOfEvidence 8.45e-01 .


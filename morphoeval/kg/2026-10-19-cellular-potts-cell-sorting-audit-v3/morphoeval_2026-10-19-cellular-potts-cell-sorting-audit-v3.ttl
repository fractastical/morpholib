        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-sorting-radial-separation>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-cortical-tension-target-perimeter-square-block>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-equal-adhesion-control-radial-separation>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-gamma-ld-sorting>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-graner-glazier-spreading-tension-diff>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-lam-perim-sweep-rms-perimeter-monotone-decreasing>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-specimen-vs-cpm-radial-profile-pearson-r>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-target-perimeter-sweep-tracking-pearson-r>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-measurement-zero-temperature-pinning-arrest-radial-separation>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-graner-cellular-potts-cell-sorting-morphometric-validation-1>,

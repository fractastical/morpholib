sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Code-to-model traceability: 45/100" ;
        rdfs:comment "Section headers and docstrings describe the Gray-Scott PDE and FFT ring metrics (L160-313), but functions lack explicit equation, section, and figure mappings to Turing (1952) Sections 8-9, Pearson (1993) Eq. 1 & Fig. 1-2, and Kondo & Asai (1995) Fig. 1-3." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-code-traceability> ;
        pk:evidenceAgainst "1952-turing-morpho.py L162–L221: solver functions lack explicit paper section/equation citations <https://github.com/fractastical/morpholib/blob/8871db0/1952-turing-morpho.py#L162-L221>" ;
        pk:hasProbability "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-code-traceability> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Code-to-model traceability' for Marine angelfish (Pomacanthus semicirculatus / P. imperator) skin stripes & chemical reaction-diffusion patterns" ;
        dcterms:identifier "morphoeval/0.1.0/code-traceability" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}

sub1:provenance {
    <https://doi.org/10.1038/369215a0> dcterms:date "1994"^^xsd:gYear ;
        dcterms:title "Experimental observation of self-replicating spots in a reaction-diffusion system" .

    <https://doi.org/10.1038/376765a0> dcterms:date "1995"^^xsd:gYear ;
        dcterms:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .

    <https://doi.org/10.1098/rstb.1952.0012> dcterms:date "1952"^^xsd:gYear ;
        dcterms:title "The chemical basis of morphogenesis" .

    <https://doi.org/10.1126/science.261.5118.189> dcterms:date "1993"^^xsd:gYear ;
        dcterms:title "Complex patterns in a simple system" .

    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/369215a0>,

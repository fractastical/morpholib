sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Morphological realism / specimen match: 14/100" ;
        rdfs:comment "No biological specimen photograph, segmentation, or comparison to Kondo & Asai (1995) Pomacanthus angelfish skin stripes or boxfish/pufferfish hexagonal spot arrays is present anywhere in the v1 script. Furthermore, in `turing_pearson_morphospace.png`, the first two spot panels (mitosis_spots at F=0.028 and soliton_spots at F=0.030) are visually near-indistinguishable at t=4000 because both are initialized with 10 nucleation patches rather than Pearson's single central 20x20 perturbation." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-specimen-match> ;
        pk:evidenceAgainst "1952-turing-morpho.py L173–L200: multi-patch synthetic initialization with zero biological specimen images or segmentation <https://github.com/fractastical/morpholib/blob/8871db0/1952-turing-morpho.py#L173-L200>",
            "turing_pearson_morphospace.png (generated output, not in repo): 2x5 synthetic plot with no biological specimen panel and near-identical spot panels in cols 0 and 1 — turing_pearson_morphospace.png: rendered output of 1952-turing-morpho.py at 8871db0, image/png, 1206789 B, 2421×1240 px, artifact_sha256 545bf3f8f507c4ca509d4fd02333e3c3a2977b267973a82eb904816743575163 (sha256 545bf3f8f507c4ca509d4fd02333e3c3a2977b267973a82eb904816743575163), spec_fingerprint 457ba1d8776c5109e7d828595ec1ea637e0d9b8eebcf725fc073d1f70566f695" ;
        pk:hasProbability "0.14"^^xsd:double ;
        pk:hasVerdict "not faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-specimen-match> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Morphological realism / specimen match' for Marine angelfish (Pomacanthus semicirculatus / P. imperator) skin stripes & chemical reaction-diffusion patterns" ;
        dcterms:identifier "morphoeval/0.1.0/specimen-match" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0009-0007-4948-9192,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/369215a0>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .

    <https://doi.org/10.1038/369215a0> dcterms:date "1994"^^xsd:gYear ;
        dcterms:title "Experimental observation of self-replicating spots in a reaction-diffusion system" .

    <https://doi.org/10.1038/376765a0> dcterms:date "1995"^^xsd:gYear ;
        dcterms:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .

    <https://doi.org/10.1098/rstb.1952.0012> dcterms:date "1952"^^xsd:gYear ;
        dcterms:title "The chemical basis of morphogenesis" .

    <https://doi.org/10.1126/science.261.5118.189> dcterms:date "1993"^^xsd:gYear ;
        dcterms:title "Complex patterns in a simple system" .
}


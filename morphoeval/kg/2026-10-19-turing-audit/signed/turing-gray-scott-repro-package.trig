sub1:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Reproducibility package: 61/100" ;
        rdfs:comment "Uses deterministic `np.random.default_rng(1952)` and includes `--self-test`, `--no-show`, and `--skip-gif` flags (L511-591). However, `--self-test` uses overly loose thresholds (`ring_sharpness > 5.0` when observed values are 718-967), does not verify two-run hash determinism, and `render_legacy_neon_gif` writes `turing_patterns_black_neon.gif` (N=200, 5000 steps) out of sync with `docs/media/turing_gray_scott.gif`." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-repro-package> ;
        pk:evidenceAgainst "1952-turing-morpho.py L319–L364: render_legacy_neon_gif writes turing_patterns_black_neon.gif rather than updating docs/media/turing_gray_scott.gif <https://github.com/fractastical/morpholib/blob/8871db0/1952-turing-morpho.py#L319-L364>",
            "1952-turing-morpho.py L528–L557: loose self_test thresholds (sharpness > 5.0) and no determinism check <https://github.com/fractastical/morpholib/blob/8871db0/1952-turing-morpho.py#L528-L557>" ;
        pk:hasProbability "0.61"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-repro-package> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Reproducibility package' for Marine angelfish (Pomacanthus semicirculatus / P. imperator) skin stripes & chemical reaction-diffusion patterns" ;
        dcterms:identifier "morphoeval/0.1.0/repro-package" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}


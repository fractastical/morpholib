sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis — Morphometric validation: 30/100" ;
        rdfs:comment "Computes 2D Hann-windowed FFT radial PSD, azimuthal m=2/m=6 harmonics, and connected-component Euler characteristic (L227-313), but all metrics are purely self-referential without comparison to analytical Turing wavelength lambda_c = 2*pi/k_c, Pearson's (1993) phase boundaries, or Kondo & Asai (1995) empirical stripe wavelengths. Moreover, integer-binned k* gives k* = 11, 12, 12, 11 cycles across all four patterned regimes, failing to resolve sub-bin wavelength shifts. Measurements (measure_outputs.py): dominant wavelength (last frame) = 50.0 grid cells [peak of the radial power spectrum of the axes-box image, scaled to the N=200 grid] — Gray–Scott f=0.055,k=0.062 labyrinth; no specimen or literature wavelength recorded; pattern coverage (last frame) = 0.0059 fraction [fraction of axes box in the high-V (yellow) band]; connected high-V components (last frame) = 101 count [scipy.ndimage.label on the yellow mask]; fraction of pattern pixels changed, first→last frame = 0.0 fraction (reference >0 for an evolving simulation) [XOR of yellow masks of frame 0 and the last frame] — ≈0 means the GIF shows a frozen pattern; Pearson coral labyrinth (F=0.055, k=0.062) spectral ring wavenumber k* = 11.0 cycles / domain (reference >0 (Turing band-pass ring), Pearson 1993 Science 261:189 Pattern η/γ) [peak of 2D radial PSD P(k) on N=160x160 grid after 4000 steps] — λ* = 14.55 grid cells, ring sharpness = 718.1; Pearson mitosis spots (F=0.028, k=0.062) connected components vs coral labyrinth = 129 count (reference 14, Pearson 1993 Science 261:189 Pattern λ/θ vs Pattern η/γ) [connected high-activator components in self-replicating spot regime] — spots remain disconnected (>100 components) whereas coral labyrinth percolates; equal-diffusion negative control (Du=Dv=0.10) spectral wavenumber k* = 0.0 cycles / domain (reference 0.0, Turing 1952 Phil. Trans. R. Soc. B 237:37 (diffusion-driven instability requires Du != Dv)) [dominant wavenumber when differential diffusivity is removed (Du = Dv = 0.10 at F=0.055, k=0.062)] — spatial σ_V = 0.00e+00, ring sharpness = 0.0." ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:evaluatesHypothesis <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-morphometric-validation> ;
        pk:evidenceAgainst "1952-turing-morpho.py L270–L286: integer-binned k_star_idx = argmax(radial_psd) yields identical 11-12 bin values across regimes <https://github.com/fractastical/morpholib/blob/8871db0/1952-turing-morpho.py#L270-L286>",
            "turing_pearson_metrics.csv L1–L6: self-referential FFT metrics with no analytical lambda_c or biological benchmark comparison <https://github.com/fractastical/morpholib/blob/8871db0/turing_pearson_metrics.csv#L1-L6>" ;
        pk:hasProbability "0.3"^^xsd:double ;
        pk:hasVerdict "unfaithful" .
    <https://w3id.org/probknow/resource/hypothesis/morphoeval-turing-gray-scott-morphometric-validation> rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis (1952-turing-morpho.py) satisfies the MorphoEval 0.1.0 criterion 'Morphometric validation' for Marine angelfish (Pomacanthus semicirculatus / P. imperator) skin stripes & chemical reaction-diffusion patterns" ;
        dct:identifier "morphoeval/0.1.0/morphometric-validation" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/369215a0>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> .
    <https://doi.org/10.1038/369215a0> dct:date "1994"^^xsd:gYear ;
        dct:title "Experimental observation of self-replicating spots in a reaction-diffusion system" .
    <https://doi.org/10.1038/376765a0> dct:date "1995"^^xsd:gYear ;
        dct:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1126/science.261.5118.189> dct:date "1993"^^xsd:gYear ;
        dct:title "Complex patterns in a simple system" .
}


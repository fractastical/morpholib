<https://w3id.org/probknow/resource/math-law/turing-gray-scott-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Gray-Scott Autocatalytic Reaction-Diffusion System" ;
    dct:description "Generates symmetry-breaking Turing spots (mitosis), labyrinthine stripes, and coral/soliton regimes across (F, k) morphospace | Variables: u(x,y,t): substrate concentration; v(x,y,t): autocatalyst concentration; D_u, D_v: diffusivities; F: feed rate; k: kill rate" ;
    dct:source "Turing (1952) Phil. Trans. R. Soc. B 237:37; Pearson (1993) Science 261:189" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/1952-turing-morpho.py#L45-L140>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/MathOfBiology.lean#L208-L221> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def gray_scott_react_u (F u v : Int) : Int := -(u * v * v) + F * (1 - u)
def gray_scott_react_v (F k u v : Int) : Int := u * v * v - (F + k) * v
theorem gray_scott_homogeneous_equilibrium (F k : Int) :
    gray_scott_react_u F 1 0 = 0 ∧ gray_scott_react_v F k 1 0 = 0 := by
  simp [gray_scott_react_u, gray_scott_react_v]"""^^pk:lean4 ;
    skos:notation "∂u/∂t = D_u ∇^2 u - u v^2 + F(1 - u),   ∂v/∂t = D_v ∇^2 v + u v^2 - (F + k)v" ;
    prov:wasDerivedFrom <https://doi.org/10.1038/369215a0>,
        <https://doi.org/10.1038/376765a0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.261.5118.189> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Reaction-Diffusion Partial Differential Equations (PDE)" ;
    pk:leanDeclaration "MathOfBiology.gray_scott_react_u" ;
    pk:leanTheorem "MathOfBiology.gray_scott_homogeneous_equilibrium" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow LLM-assessment template) that evaluates the hypothesis pkr:hypothesis/morphoeval-<sim>-<dimension> with pk:hasProbability = score/100 and a pk:hasVerdict band; the overall score evaluates pkr:hypothesis/morphoeval-<sim> and is also the pk:weightOfEvidence of the pk:Claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


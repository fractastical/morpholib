sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-turing-gray-scott> a pk:Claim ;
        rdfs:label "Turing (1952), Pearson (1993) & Kondo-Asai (1995) reaction-diffusion morphogenesis faithfully reproduces Marine angelfish (Pomacanthus semicirculatus / P. imperator) skin stripes & chemical reaction-diffusion patterns morphology" ;
        dct:description "The simulation script(s) 1952-turing-morpho.py implement the cited source model as published and produce forms that match real Marine angelfish (Pomacanthus semicirculatus / P. imperator) skin stripes & chemical reaction-diffusion patterns specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 38.0/100, audit 2026-10-19-turing-audit) and the assessments." ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/1952-turing-morpho.py; output: turing_pearson_morphospace.png; organism: Marine angelfish (Pomacanthus semicirculatus / P. imperator) skin stripes & chemical reaction-diffusion patterns; checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 457ba1d8776c5109e7d828595ec1ea637e0d9b8eebcf725fc073d1f70566f695; artifact_sha256: 545bf3f8f507c4ca509d4fd02333e3c3a2977b267973a82eb904816743575163" ;
        pk:derivedFromPaper <https://doi.org/10.1038/369215a0>,
            <https://doi.org/10.1038/376765a0>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1126/science.261.5118.189> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-overall>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-repro-package>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/2026-10-19-turing-audit-turing-gray-scott-specimen-match> ;
        pk:weightOfEvidence "0.38"^^xsd:double .
}


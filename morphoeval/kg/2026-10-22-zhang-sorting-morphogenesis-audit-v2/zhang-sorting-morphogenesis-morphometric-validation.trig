    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-3-duplicate-key-c-2-copies-per-key-anti-clustering-s-b-s-b-reference> a schema:PropertyValue ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-zhang-sorting-morphogenesis> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-zhang-sorting-morphogenesis-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-zhang-sorting-morphogenesis-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Zhang, Goldstein & Levin (2025) Autonomous Cell-View Sorting Morphogenesis, 3-Ablation Platonic Space Audit & Hoel Causal Emergence 2.0 — Morphometric validation: 95/100" ;
        dct:date "2026-10-22"^^xsd:date ;
        dct:description "Validates 14/14 quantitative paper benchmarks plus exact ablation and Causal Emergence 2.0 metrics: Insertion error jump 4.90 -> 21.95 (4.5x), Bubble Lyapunov uphill steps 0/192 (Delta I = -1) vs E(v) 47 uphill ticks, Hoel CE 2.0 Delta CP = +0.1191 on I(v) vs -0.2525 on E(v), and C=2 anti-clustering 0.477 < 0.50 vs C=10 clustering 0.659." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-1-insertion-sort-final-error-with-l74-76-freeze-prefix-reset-n-60-f-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-1-insertion-sort-final-error-without-l74-76-freeze-prefix-reset-n-60-f-3>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-bubble-sort-uphill-steps-on-true-coxeter-inversion-potential-i-v-192-swaps>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-bubble-sort-uphill-ticks-on-coarse-grained-adjacent-error-e-v-192-swaps>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-cells-crossing-immovable-frozen-barrier-in-bubble-insertion-sort>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-3-duplicate-key-c-10-copies-per-key-homotypic-clique-clustering-sssss-bbbbb>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-3-duplicate-key-c-2-copies-per-key-anti-clustering-s-b-s-b>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-3-unique-key-chimera-b-s-0-ties-fig-8a-peak-algotype-aggregation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-decisive-comparison-d-vs-d-p-dualist-cell-swap-trajectory-difference-py-c-20-js-lean-4>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-hoel-causal-emergence-2-0-patterns-2026-delta-cp-on-coxeter-inversions-i-v-s-6-n-720>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-hoel-causal-emergence-2-0-patterns-2026-delta-cp-on-neighbor-error-e-v-s-6-n-720>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-morphometric-validation-2> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-1-insertion-sort-final-error-with-l74-76-freeze-prefix-reset-n-60-f-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ablation 1 — Insertion Sort Final Error WITH L74-76 FREEZE Prefix Reset (n=60, f=3) = 4.9 monotonicity_error" ;
        schema:measurementTechnique "Mean final adjacent monotonicity error E(v) with upstream InsertionSortCell.py L74-76 `if status == FREEZE: prev = -1` active" ;
        schema:name "Ablation 1 — Insertion Sort Final Error WITH L74-76 FREEZE Prefix Reset (n=60, f=3)" ;
        schema:unitText "monotonicity_error" ;
        schema:value "4.9" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-1-insertion-sort-final-error-with-l74-76-freeze-prefix-reset-n-60-f-3-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-1-insertion-sort-final-error-with-l74-76-freeze-prefix-reset-n-60-f-3-reference> a schema:PropertyValue ;
        dct:source "Zhangtaining/cell_research@1fd2bd59 InsertionSortCell.py L68-82 & audit_platonic_space_claims.py" ;
        schema:value "4.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-1-insertion-sort-final-error-without-l74-76-freeze-prefix-reset-n-60-f-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ablation 1 — Insertion Sort Final Error WITHOUT L74-76 FREEZE Prefix Reset (n=60, f=3) = 21.95 monotonicity_error" ;
        dct:description "4.5x error jump (4.90 -> 21.95) when explicit FREEZE prefix reset is removed" ;
        schema:measurementTechnique "Mean final adjacent monotonicity error E(v) when the 3-line `if status == FREEZE: prev = -1` handler is ablated" ;
        schema:name "Ablation 1 — Insertion Sort Final Error WITHOUT L74-76 FREEZE Prefix Reset (n=60, f=3)" ;
        schema:unitText "monotonicity_error" ;
        schema:value "21.95" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-1-insertion-sort-final-error-without-l74-76-freeze-prefix-reset-n-60-f-3-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-1-insertion-sort-final-error-without-l74-76-freeze-prefix-reset-n-60-f-3-reference> a schema:PropertyValue ;
        dct:source "Levin (2026) Philosophies 11(5):161 Sec. 6.3 & Lean 4 Theorem 2 insertion_freeze_reset_unblocks_and_checks_post_frozen_order" ;
        schema:value "4.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-bubble-sort-uphill-steps-on-true-coxeter-inversion-potential-i-v-192-swaps> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ablation 2 — Bubble Sort Uphill Steps on True Coxeter Inversion Potential I(v) (192 Swaps) = 0 uphill_steps" ;
        schema:measurementTechnique "Count of swap steps where pairwise inversions I(v) = #{(i<j): v_i > v_j} increases (Delta I > 0)" ;
        schema:name "Ablation 2 — Bubble Sort Uphill Steps on True Coxeter Inversion Potential I(v) (192 Swaps)" ;
        schema:unitText "uphill_steps" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-bubble-sort-uphill-steps-on-true-coxeter-inversion-potential-i-v-192-swaps-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-bubble-sort-uphill-steps-on-true-coxeter-inversion-potential-i-v-192-swaps-reference> a schema:PropertyValue ;
        dct:source "Lean 4 Theorem 3 adjacent_swap_strictly_decreases_inversions_window3 (Delta I = -1 on every swap)" ;
        schema:value "0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-bubble-sort-uphill-ticks-on-coarse-grained-adjacent-error-e-v-192-swaps> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ablation 2 — Bubble Sort Uphill Ticks on Coarse-Grained Adjacent Error E(v) (192 Swaps) = 47 uphill_steps" ;
        schema:measurementTechnique "Count of swap steps where adjacent monotonicity error E(v) = #{i: v_i > v_{i+1}} ticks upward by +1" ;
        schema:name "Ablation 2 — Bubble Sort Uphill Ticks on Coarse-Grained Adjacent Error E(v) (192 Swaps)" ;
        schema:unitText "uphill_steps" ;
        schema:value "47" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-bubble-sort-uphill-ticks-on-coarse-grained-adjacent-error-e-v-192-swaps-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-bubble-sort-uphill-ticks-on-coarse-grained-adjacent-error-e-v-192-swaps-reference> a schema:PropertyValue ;
        dct:source "Zhang, Goldstein & Levin (2025) Figs. 6-7 & Lean 4 Theorem 3 lyapunov_descent_vs_monotonicity_error_projection_artifact" ;
        schema:value "47" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-cells-crossing-immovable-frozen-barrier-in-bubble-insertion-sort> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Ablation 2 — Cells Crossing Immovable Frozen Barrier in Bubble & Insertion Sort = 0 cells" ;
        schema:measurementTechnique "Exact count of cells crossing from left of immovable defect d to right of d under adjacent swaps" ;

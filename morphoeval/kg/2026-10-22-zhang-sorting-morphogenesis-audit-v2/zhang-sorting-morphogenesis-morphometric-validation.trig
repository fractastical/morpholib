        schema:value "0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-cells-crossing-immovable-frozen-barrier-in-bubble-insertion-sort-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-2-cells-crossing-immovable-frozen-barrier-in-bubble-insertion-sort-reference> a schema:PropertyValue ;
        dct:source "Lean 4 Theorem 1 bubble_adjacent_swap_preserves_left_partition" ;
        schema:value "0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-zhang-sorting-morphogenesis-measurement-ablation-3-duplicate-key-c-10-copies-per-key-homotypic-clique-clustering-sssss-bbbbb> a schema:PropertyValue,

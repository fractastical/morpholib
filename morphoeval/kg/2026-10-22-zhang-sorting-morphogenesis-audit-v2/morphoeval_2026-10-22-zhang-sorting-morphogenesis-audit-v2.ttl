<https://w3id.org/delphi/resource/assessment/morphoeval-zhang-sorting-morphogenesis-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Zhang, Goldstein & Levin (2025) Autonomous Cell-View Sorting Morphogenesis, 3-Ablation Platonic Space Audit & Hoel Causal Emergence 2.0 — Morphometric validation: 95/100" ;
    dct:date "2026-10-22"^^xsd:date ;
    dct:description "Validates 14/14 quantitative paper benchmarks plus exact ablation and Causal Emergence 2.0 metrics: Insertion error jump 4.90 -> 21.95 (4.5x), Bubble Lyapunov uphill steps 0/192 (Delta I = -1) vs E(v) 47 uphill ticks, Hoel CE 2.0 Delta CP = +0.1191 on I(v) vs -0.2525 on E(v), and C=2 anti-clustering 0.477 < 0.50 vs C=10 clustering 0.659." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;

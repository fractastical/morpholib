        dcterms:date "2026-10-22"^^xsd:date ;
        dcterms:description "Sweeps algotypes (B, I, S), frozen defect types (movable/passive vs immovable/stuck, f=0..3), Ablation 1 (with vs without Insertion L74-76 FREEZE reset), Ablation 2 (I(v) vs E(v) on S_3..S_6), and Ablation 3 (unique keys vs duplicate key multiplicity C = 1..40 and < vs <= tie breaking)." ;
        dcterms:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;

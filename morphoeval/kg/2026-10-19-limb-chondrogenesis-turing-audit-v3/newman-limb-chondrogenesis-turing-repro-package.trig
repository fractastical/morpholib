sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Reproducibility package: 95/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` (L1839-1944) now runs 14 deterministic checks (8 Pass 2 + clock fit, kinetics target/band, FGF8 window independence + Hill monotonicity, 3D record [1, 2, 3] with L_PD(24/48 h) tolerances, excision series vs pinned provenance, sweep monotonicity) in ~50 s; the default render (12-panel PNG + 11-frame GIF) takes ~51 s; all Pass 3 runs are seeded (seed 1979, per-joint derived seeds) and cached (`_RUN_CACHE`, L1154) so render and measurements share one integration." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-repro-package-2> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L1839–L1944" ;
        dct:description "14-check self_test() including bitwise determinism and the six Pass 3 checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L1839-L1944> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L1154–L1162" ;
        dct:description "Run cache shared by render, measurements and self-test (one intact-AER 3D integration per process)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L1154-L1162> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 012 Pass 3 autonomous remediation-loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


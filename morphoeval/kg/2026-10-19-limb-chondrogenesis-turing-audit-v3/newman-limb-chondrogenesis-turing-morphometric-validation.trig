    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-moving-boundary-aer-excision-at-t-24-h-hh24-cumulative-skeletal-elements-reference> a schema:PropertyValue ;

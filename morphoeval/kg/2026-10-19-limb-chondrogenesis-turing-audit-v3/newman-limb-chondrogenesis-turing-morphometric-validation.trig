    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-intact-aer-2d-wing-bud-total-skeletal-elements-stylopod-1-zeugopod-2-autopod-3-reference> a schema:PropertyValue ;

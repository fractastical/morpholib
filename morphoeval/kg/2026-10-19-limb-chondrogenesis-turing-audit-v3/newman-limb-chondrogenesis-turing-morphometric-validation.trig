sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Morphometric validation: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1671-1836) now reports 14 reference-backed measurements: the 8 Pass 2 items (unchanged values) plus 3D record total elements 6 vs 6, L_PD(24 h) 250.2 vs 250 um, L_PD(48 h) 128.6 vs 140 um (-8.1 %, the 3-point clock fit's residual), excision at 0 h -> 1 vs 1, excision at 24 h -> 3 vs 3, and record AP spacing ratio 1.484 vs 1.5. The L_PD(48 h) miss and the fact that the excision series is partly a consequence of the imposed m-map timing keep this below the mid-90s." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1979-newman-limb-chondrogenesis-turing.py L639–L665: Hyaluronidase clock fit to Table 1 (tau_H = 37.0 h) — L_PD(48 h) = 128.6 um vs 140 um reference is an 8 % residual of the one-parameter exponential <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L639-L665>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-3d-moving-boundary-intact-aer-total-skeletal-elements-in-the-frozen-record-1-2-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-3d-record-zeugopod-to-autopod-anteroposterior-spacing-ratio-m-2-m-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-equal-diffusion-du-dv-and-hyaluronate-excess-fu-1-5-negative-control-amplitude>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-pde-condensation-count-m-l-pd-500-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh24-zeugopod-pde-condensation-count-m-l-pd-250-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh27-chick-wing-autopod-pde-condensation-count-m-l-pd-140-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh28-chick-hindlimb-autopod-pde-condensation-count-m-l-pd-115-um>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-intact-aer-2d-wing-bud-total-skeletal-elements-stylopod-1-zeugopod-2-autopod-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-moving-boundary-active-progress-zone-depth-l-pd-at-24-h-hh24>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-moving-boundary-active-progress-zone-depth-l-pd-at-48-h-hh27>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-moving-boundary-aer-excision-at-t-0-h-hh20-cumulative-skeletal-elements>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-moving-boundary-aer-excision-at-t-24-h-hh24-cumulative-skeletal-elements>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-progress-zone-mode-number-l-ap-lambda-ap-vs-pde-element-count-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-segmented-gallus-gallus-wing-specimen-zeugopod-to-autopod-spacing-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-3d-moving-boundary-intact-aer-total-skeletal-elements-in-the-frozen-record-1-2-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D moving-boundary intact-AER total skeletal elements in the frozen record (1 + 2 + 3) = 6.0 elements" ;
        dct:description "compartment counts = [1, 2, 3], outgrowth = 612 um, final L = 1412 um, joints at t = [10.7, 35.9] h" ;
        schema:measurementTechnique "AP peak count per frozen Lagrangian-FEM node of the 3D record u_rec(x, y_mid, z) after HH20 -> HH27 FGF8-driven outgrowth, grouped into contiguous compartments" ;
        schema:name "3D moving-boundary intact-AER total skeletal elements in the frozen record (1 + 2 + 3)" ;
        schema:unitText "elements" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-3d-moving-boundary-intact-aer-total-skeletal-elements-in-the-frozen-record-1-2-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-3d-moving-boundary-intact-aer-total-skeletal-elements-in-the-frozen-record-1-2-3-reference> a schema:PropertyValue ;
        dct:source "Newman & Frisch (1979) Science 205:662-668 Table 1; Saunders (1948); Summerbell et al. (1973) (humerus + radius/ulna + digits II-IV = 6)" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-3d-record-zeugopod-to-autopod-anteroposterior-spacing-ratio-m-2-m-3> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D record zeugopod-to-autopod anteroposterior spacing ratio (m = 2 -> m = 3) = 1.4839 dimensionless ratio" ;
        dct:description "record spacings (um) = {2: 551, 3: 371}; DV lowest-mode energy fraction of the record = 0.990 (single sin(pi y/L_DV) core hump, n_DV = 1)" ;
        schema:measurementTechnique "mean AP peak spacing of the frozen record in the 2-element compartment divided by that in the 3-element compartment (cosine standing waves: (L_AP/2)/(L_AP/3) = 1.5)" ;
        schema:name "3D record zeugopod-to-autopod anteroposterior spacing ratio (m = 2 -> m = 3)" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "1.4839" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-3d-record-zeugopod-to-autopod-anteroposterior-spacing-ratio-m-2-m-3-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-3d-record-zeugopod-to-autopod-anteroposterior-spacing-ratio-m-2-m-3-reference> a schema:PropertyValue ;
        dct:source "Newman & Frisch (1979) Eq. (3) cos(m pi x / L_AP) wavelength compression; segmented Gallus specimen ratio = 1.4074" ;
        schema:value "1.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-equal-diffusion-du-dv-and-hyaluronate-excess-fu-1-5-negative-control-amplitude> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (Du=Dv) and hyaluronate-excess (fu=1.5) negative control amplitude = 0.0 std(u) control" ;
        dct:description "positive HH27 std(u) = 1.4011 (3 digits) vs equal-diff std(u) = 1.91e-16 (0 elements) and sub-Turing std(u) = 1.05e-11 (0 elements)" ;
        schema:measurementTechnique "nonlinear PDE std(u) at Du=Dv=0.5 (equal diffusion) and fu=1.5 < 2.0 (hyaluronate excess) vs positive HH27 autopod" ;
        schema:name "equal-diffusion (Du=Dv) and hyaluronate-excess (fu=1.5) negative control amplitude" ;
        schema:unitText "std(u) control" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-equal-diffusion-du-dv-and-hyaluronate-excess-fu-1-5-negative-control-amplitude-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-equal-diffusion-du-dv-and-hyaluronate-excess-fu-1-5-negative-control-amplitude-reference> a schema:PropertyValue ;
        dct:source "Lean 4 Theorem 1 newman_turing_equal_diffusion_no_chondrogenesis & Newman & Frisch (1979)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-measurement-hh20-stylopod-pde-condensation-count-m-l-pd-500-um> a schema:PropertyValue,

<https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> a pk:Claim ;
    rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud (Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV))",
        "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud faithfully reproduces Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/newman-limb-chondrogenesis-turing-1>,
        <https://w3id.org/probknow/resource/math-law/newman-limb-chondrogenesis-turing-2>,
        <https://w3id.org/probknow/resource/math-law/newman-limb-chondrogenesis-turing-3>,
        <https://w3id.org/probknow/resource/math-law/newman-limb-chondrogenesis-turing-4>,
        <https://w3id.org/probknow/resource/math-law/newman-limb-chondrogenesis-turing-5>,
        <https://w3id.org/probknow/resource/math-law/newman-limb-chondrogenesis-turing-6> ;
    dct:description "The simulation script(s) 1979-newman-limb-chondrogenesis-turing.py implement the cited source model as published and produce forms that match real Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 93.8/100, audit 2026-10-19-limb-chondrogenesis-turing-audit-v3) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py> ;
    schema:about "Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV)" ;
    pk:aristotelianEfficientCause "2. Morphogen + Condensations" ;
    pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
    pk:aristotelianPoionForm "Skeletal Rays & Joints" ;
    pk:aristotelianPosonLaw "French-Flag / PSHM Thresholds" ;
    pk:aristotelianSubalternClass "Aves (Ornithes)" ;
    pk:biologicalGenus "Gallus" ;

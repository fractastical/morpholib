sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Source and data traceability: 96/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Five SHA-256-pinned dataset files (`EXPECTED_SHA256`, L109-125; the Pass 2 specimen and JSON digests are unchanged) including the new `fgf8_moving_boundary_reference.json`, which traces every `FGF8_GROWTH_DEFAULTS` constant to a source or labels it a model assumption and is read back in the self-test (L1885-1892, L1930); `paper_citations.bib` extended from 5 to 14 DOIs; dataset README documents the Pass 3 additions. All 14 reference DOIs in this audit resolve to the cited works (the Newman & Frisch DOI 10.1126/science.462174 was re-verified)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-source-traceability-3> ;
        pk:hasScore "0.96"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L109–L157" ;
        dct:description "Runtime SHA-256 verification of all 5 files in datasets/limb_chondrogenesis_turing/ and loader for the Pass 3 provenance JSON" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L109-L157> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/limb_chondrogenesis_turing/fgf8_moving_boundary_reference.json L1–L66" ;
        dct:description "Provenance of the FGF8 clock, thresholds, proliferation, geometry, excision rule and numerics — sourced constants separated from model assumptions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/limb_chondrogenesis_turing/fgf8_moving_boundary_reference.json#L1-L66> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/limb_chondrogenesis_turing/paper_citations.bib L56–L155" ;
        dct:description "9 Pass 3 BibTeX entries (Crampin 1999, Zhu 2010, Boehm 2010, Sun 2002, Toole 1972, Solursh 1984, Summerbell 1974/1976/1977)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/limb_chondrogenesis_turing/paper_citations.bib#L56-L155> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 012 Pass 3 autonomous remediation-loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Same SHA-256-locked Gallus gallus wing skeleton specimen and cross-sectional segmentation (1 humerus; radius + ulna 38.0 px; digits II-IV 27.0 px, ratio 1.4074; `segment_chick_wing_specimen`, L1222-1284; Panels E-F). Pass 3 adds a second, independent comparison: the frozen 3D record's compartment counts [1, 2, 3] and its zeugopod-to-autopod AP spacing ratio 1.484 (Panel J, L1514-1535) are set against the specimen's [1, 2, 3] and 1.407 and the cosine-mode theory 1.5 (measurement 14). The specimen is still a single adult osteological photograph (no HH-staged embryonic Alcian-blue series), so the stage-resolved L_PD(t) and excision-time predictions are validated against Table 1 / Summerbell numbers rather than against imagery." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L1222–L1284" ;
        dct:description "Cross-sectional osteological peak detection across stylopod (1), zeugopod (2), autopod (3) on chick_wing_skeleton_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L1222-L1284> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L1514–L1535" ;
        dct:description "Panel J: 3D record u_rec(x, y_mid, z) with detected compartments, DV core purity and AP spacings compared with the specimen ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L1514-L1535> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/limb_chondrogenesis_turing_comparison.png (generated output)" ;
        dct:description "12-panel synthesis figure (A-H Pass 2; I growth kinematics vs Table 1, J 3D record, K excision-time series vs Saunders/Summerbell, L FGF8 zones) — docs/media/limb_chondrogenesis_turing_comparison.png: rendered output of 1979-newman-limb-chondrogenesis-turing.py at d58a084, image/png, 707529 B, 2285×1972 px, artifact_sha256 2b43fb710f9364839582f078db91b045664d7fb980ac6db71e8db52a90870e53 (sha256 2b43fb710f9364839582f078db91b045664d7fb980ac6db71e8db52a90870e53), spec_fingerprint ccb5850b44c8ca2f5f2646ec40a4758c3d46ded6705df0c966f6d163508ab9c2" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 012 Pass 3 autonomous remediation-loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


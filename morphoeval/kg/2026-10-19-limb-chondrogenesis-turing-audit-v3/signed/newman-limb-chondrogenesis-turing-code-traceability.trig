    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Code-to-model traceability: 95/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Module docstring (L1-93) maps the Pass 3 model and Lean Theorems 4-6 to their sources; the Section 4b header (L562-600) is an explicit honest-scope statement listing what is and is not a finite-element / paddle-outline model; function docstrings cite Hentschel 2004, Zhu 2010, Sun 2002, Boehm 2010, Summerbell 1974/1977 and Rowe & Fallon 1982 at the point of use; the Math KG spec now registers 6 laws with Lean loci and code loci (`newman-limb-chondrogenesis-turing.yaml`, L1-143)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;

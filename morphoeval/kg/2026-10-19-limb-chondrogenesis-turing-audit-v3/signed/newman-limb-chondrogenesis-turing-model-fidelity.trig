sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L847–L1152" ;
        dcterms:description "3D moving-boundary solver: Lagrangian P1 FEM in z (advection, dilution, bisection), DCT-II/DST-II spectral x/y, three FGF8 zones, deposition of the record at the advancing front, block-Thomas implicit step" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L847-L1152> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L668–L770" ;
        dcterms:description "k_PD^2 from the lowest eigenvalue of the discrete active-zone PD operator (Dirichlet ghosts) and fu by bisection to the Helmholtz target q* = m^2 + k_DV^2 + k_PD^2" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L668-L770> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean L114–L214" ;
        dcterms:description "Pass 3 Lean Laws 4-6 (Helmholtz AP mode budget, FGF8 window depth independent of AER output, Hill-2 strict monotonicity), 0 sorrys, `lean` exits 0" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_012_limb_chondrogenesis_turing.lean#L114-L214> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Retains the exact Newman & Frisch (1979) Eqs. (1)-(7) dispersion relation (`compute_newman_dispersion`, L161-271) and the 1D/2D nonlinear DCT-II IMEX solvers (L274-468). Pass 3 adds the requested 3D moving boundary (L847-1152): Lagrangian P1 FEM in z with advection a(z) = int S dz, dilution and bisection refinement (L1045-1108), a moving distal boundary, DST-II Dirichlet dorsal/ventral ectoderm (L898), active-zone kinetics with k_PD^2 from the actual discrete PD operator (L668-692) and fu chosen by bisection so the fastest linear mode is exactly m^2 + k_DV^2 + k_PD^2 (L695-770), plus three new Lean theorems (Helmholtz budget, FGF8 window depth, Hill-2 monotonicity). It is held at 94 rather than raised because the remediation exposed structural limits: (i) pattern selection is not growth-sensitive — the S_max = 0 sweep run (zero outgrowth) still yields [1, 2, 3] (L1204-1209), so the moving boundary sets element lengths only; (ii) the Table 1 map m(L_PD) (L186-191) is still an empirical input and the m-increment joint/interzone is an imposed field reset (L1006-1012); (iii) the AP/DV cross-section is spectral on a box (header L567-600), not a FEM mesh of the paddle-shaped bud; (iv) post-excision kinetics are held by rule (L991-997)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1979-newman-limb-chondrogenesis-turing.py L1006–L1012: Joint/interzone on m increment is an imposed reset of the active + apical field to noise (documented, not emergent) <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L1006-L1012>",
            "1979-newman-limb-chondrogenesis-turing.py L1204–L1209: S_max sweep: S = 0 (no outgrowth) still produces [1, 2, 3] — element count is clock-set, growth-insensitive <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L1204-L1209>",
            "1979-newman-limb-chondrogenesis-turing.py L186–L191: Table 1 mode map m(L_PD) thresholds 375/190/125 um remain an empirical input to the kinetics (not derived from hyaluronate -> D_eff) <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L186-L191>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 012 Pass 3 autonomous remediation-loop assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


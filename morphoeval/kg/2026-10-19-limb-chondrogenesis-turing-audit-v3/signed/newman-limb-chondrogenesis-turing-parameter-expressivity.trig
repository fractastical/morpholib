sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud — Parameter expressivity: 95/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Keeps the 4-stage L_PD sweep, 3-step AER series and dual negative controls (L471-559) and adds: the Summerbell (1974) excision-time sweep at 6 excision times resumed from shared snapshots (`run_aer_excision_time_sweep`, L1165-1192), an S_max x {0, 0.5, 1, 1.5, 2} outgrowth sweep (0/306/612/919/1226 um, strictly monotone) and a lambda_F0 x {0.6, 0.8, 1.0, 1.2} element-count sweep (9/10/6/6 elements) (`run_fgf8_parameter_sweep`, L1194-1217), per-run overrides via `params`, `S_max_per_h`, `lambda_scale`, `nx`, `ny`, `continue_from` (L847-856), and five new CLI flags `--S-max-per-h`, `--L-DV-um`, `--eta-threshold`, `--t-end-h`, `--tau-FGF-h` (L1959-1963) on top of the nine Pass 2 flags." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity-2> ;
        pk:hasScore "0.95"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L1165–L1217" ;
        dcterms:description "Excision-time sweep (6 times) and S_max / lambda_F0 parameter sweeps on the moving-boundary model" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L1165-L1217> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-newman-limb-chondrogenesis-turing-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1979-newman-limb-chondrogenesis-turing.py L1947–L1979" ;
        dcterms:description "CLI: nine Pass 2 flags plus five Pass 3 moving-boundary flags that override FGF8_GROWTH_DEFAULTS for the default render" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py#L1947-L1979> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 012 Pass 3 autonomous remediation-loop assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


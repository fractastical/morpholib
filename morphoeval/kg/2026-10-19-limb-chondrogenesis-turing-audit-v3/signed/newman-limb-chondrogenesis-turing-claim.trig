sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-newman-limb-chondrogenesis-turing> a pk:Claim ;
        rdfs:label "Newman & Frisch (1979) Science 3D Helmholtz/Turing standing-wave eigenmodes and proximodistal 1 -> 2 -> 3 skeletal chondrogenesis in developing Gallus gallus wing bud faithfully reproduces Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV) morphology" ;
        dcterms:description "The simulation script(s) 1979-newman-limb-chondrogenesis-turing.py implement the cited source model as published and produce forms that match real Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 93.8/100, audit 2026-10-19-limb-chondrogenesis-turing-audit-v3) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py; output: docs/media/limb_chondrogenesis_turing_comparison.png; organism: Gallus gallus domesticus embryonic wing bud (HH20 stylopod humerus -> HH24 zeugopod radius+ulna -> HH27 autopod digits II-IV); checkpoint commit: https://github.com/fractastical/morpholib/commit/d58a084; environment: python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0; spec_fingerprint: ccb5850b44c8ca2f5f2646ec40a4758c3d46ded6705df0c966f6d163508ab9c2; artifact_sha256: 2b43fb710f9364839582f078db91b045664d7fb980ac6db71e8db52a90870e53; input_dataset_sha256: {datasets/limb_chondrogenesis_turing/chick_wing_skeleton_specimen.jpg=771e26f9fe8c813d..., datasets/limb_chondrogenesis_turing/fgf8_moving_boundary_reference.json=b4fefaace1e7a1b3..., datasets/limb_chondrogenesis_turing/limb_chondrogenesis_turing_reference.json=c30d742bbf2a990a..., datasets/limb_chondrogenesis_turing/paper_citations.bib=21dad0bab5186d67..., datasets/limb_chondrogenesis_turing/scout_manifest.json=7f3605aa11f5e077...}; supersedes_audit_id: 2026-10-19-limb-chondrogenesis-turing-audit-v2" ;
        pk:derivedFromPaper <https://doi.org/10.1002/jez.1401080304>,
            <https://doi.org/10.1006/bulm.1999.0131>,
            <https://doi.org/10.1016/0012-1606(72)90071-1>,
            <https://doi.org/10.1016/0045-6039(84)90025-3>,
            <https://doi.org/10.1038/244492a0>,
            <https://doi.org/10.1038/nature00902>,
            <https://doi.org/10.1098/rspb.2004.2772>,
            <https://doi.org/10.1126/science.462174>,
            <https://doi.org/10.1186/s13227-017-0084-8>,
            <https://doi.org/10.1242/dev.32.3.651>,
            <https://doi.org/10.1242/dev.35.2.241>,
            <https://doi.org/10.1242/dev.40.1.1>,
            <https://doi.org/10.1371/journal.pbio.1000420>,
            <https://doi.org/10.1371/journal.pone.0010892> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-overall>,

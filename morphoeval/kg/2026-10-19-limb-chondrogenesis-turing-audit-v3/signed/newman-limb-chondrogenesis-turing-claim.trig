            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-newman-limb-chondrogenesis-turing-specimen-match> ;
        pk:weightOfEvidence "0.938"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/d58a084/1979-newman-limb-chondrogenesis-turing.py> a schema:SoftwareSourceCode ;

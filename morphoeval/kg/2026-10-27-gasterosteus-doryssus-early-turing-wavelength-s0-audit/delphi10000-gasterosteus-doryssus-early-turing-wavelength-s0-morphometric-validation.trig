sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength of Gasterosteus doryssus_early at 33 µm (10.02 Ma) — Morphometric validation: 84/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Dispersion Pearson r = 0.9947, RMSE = 0.0259, KS = 0.182 against the discrete linear theory. Nonlinear λ = 33.87 µm versus 32.86 µm (3.1%). Specimen high-pass wavelength 81.08 µm, Otsu foreground 0.291, and coherency 0.198 are stored with references they do not equal. Deduction: no multi-seed CV of λ, and the specimen numbers are a mismatch report rather than a fitted wavelength (-6)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-dispersion-pearson-r-of-analytic-vs-linearized-euler-growth>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-ks-statistic-of-standardized-dispersion-curves>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-nonlinear-schnakenberg-selected-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-image-high-pass-radial-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-vs-gif-cv-similarity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-successor-doryssus-mid-analytic-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-dispersion-pearson-r-of-analytic-vs-linearized-euler-growth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r of analytic vs linearized Euler growth = 0.9946694599278305 Pearson r" ;
        dct:description "RMSE = 0.02594" ;
        schema:measurementTechnique "11-mode 1D explicit Euler on the unstable eigenvector of J-k_eff^2 D, k in [0.10, 0.36]/µm, CFL 0.04" ;
        schema:name "dispersion Pearson r of analytic vs linearized Euler growth" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9946694599278305" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-dispersion-pearson-r-of-analytic-vs-linearized-euler-growth-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-dispersion-pearson-r-of-analytic-vs-linearized-euler-growth-reference> a schema:PropertyValue ;
        dct:source "exact agreement with the discrete dispersion relation" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.025944945691342126 growth rate" ;
        dct:description "KS statistic on standardized curves = 0.1818" ;
        schema:measurementTechnique "root mean square of sigma_numeric - sigma_analytic on the same 11 modes" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "growth rate" ;
        schema:value "0.025944945691342126" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "zero error against the linear dispersion relation" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation std ratio = 0.0002159658213958516 std(u_ablation)/std(u_Turing)" ;
        dct:description "equal-diffusion max σ(k) = -0.0919" ;
        schema:measurementTechnique "same seed and T, D_v set equal to D_u versus D_v/D_u = 12.277" ;
        schema:name "equal-diffusion ablation std ratio" ;
        schema:unitText "std(u_ablation)/std(u_Turing)" ;
        schema:value "0.0002159658213958516" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-equal-diffusion-ablation-std-ratio-reference> a schema:PropertyValue ;
        dct:source "null ratio if the inhibitor range did nothing" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-ks-statistic-of-standardized-dispersion-curves> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS statistic of standardized dispersion curves = 0.18181818181818177 KS distance" ;
        dct:description "p = 0.9971" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on z-scored analytic and numeric sigma(k)" ;
        schema:name "KS statistic of standardized dispersion curves" ;
        schema:unitText "KS distance" ;
        schema:value "0.18181818181818177" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-ks-statistic-of-standardized-dispersion-curves-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-ks-statistic-of-standardized-dispersion-curves-reference> a schema:PropertyValue ;
        dct:source "identical distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-nonlinear-schnakenberg-selected-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear Schnakenberg selected wavelength = 33.87461687249648 µm" ;
        dct:description "analytic argmax σ gives 33.011 µm" ;
        schema:measurementTechnique "radial FFT peak of u on the 280 µm periodic patch after T=36, parabolic sub-bin" ;
        schema:name "nonlinear Schnakenberg selected wavelength" ;
        schema:unitText "µm" ;
        schema:value "33.87461687249648" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-nonlinear-schnakenberg-selected-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-nonlinear-schnakenberg-selected-wavelength-reference> a schema:PropertyValue ;
        dct:source "target λ_c = 32.86 µm = 3.286e-05 m at 10.02 Ma" ;
        schema:value "32.86" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-image-high-pass-radial-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image high-pass radial wavelength = 81.08108108108108 µm" ;
        dct:description "scale bar 111 px, 0.9009 µm/px, peak bin 8" ;
        schema:measurementTechnique "100 µm scale bar (longest >200 luminance run) then high-pass radial FFT peak" ;
        schema:name "specimen image high-pass radial wavelength" ;
        schema:unitText "µm" ;
        schema:value "81.08108108108108" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-image-high-pass-radial-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-image-high-pass-radial-wavelength-reference> a schema:PropertyValue ;
        dct:source "model λ_c; the photograph's visible band is a different length and is not forced equal" ;
        schema:value "32.86" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Otsu foreground fraction = 0.2907489106753813 area fraction" ;
        dct:description "threshold 0.537" ;
        schema:measurementTechnique "Otsu threshold on the interior grayscale of the gallery ocellus" ;
        schema:name "specimen Otsu foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.2907489106753813" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-otsu-foreground-fraction-reference> a schema:PropertyValue ;
        dct:source "neutral half-field occupancy, not fitted" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.1984101261709395 coherency" ;
        dct:description "gallery spiral is strongly locally oriented" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Gaussian-smoothed structure tensor" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.1984101261709395" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic reference coherency" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-vs-gif-cv-similarity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen-vs-GIF cv similarity = 85.9 cv score" ;
        dct:description "last-frame Sobel orientation, radial FFT, coherency, occupancy" ;
        schema:measurementTechnique "verify_image_fitness.compute_sim_vs_specimen_cv_similarity on the growth GIF" ;
        schema:name "specimen-vs-GIF cv similarity" ;
        schema:unitText "cv score" ;
        schema:value "85.9" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-vs-gif-cv-similarity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-specimen-vs-gif-cv-similarity-reference> a schema:PropertyValue ;
        dct:source "MorphoEval CV gate" ;
        schema:value "58.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-successor-doryssus-mid-analytic-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "successor doryssus_mid analytic wavelength = 41.71467093386343 µm" ;
        dct:description "10.01 Ma vestigial spine. Numeric integration of the successor is a pass-1 remediation." ;
        schema:measurementTechnique "same Jacobian, D_u scaled by (41.50/32.86)^2, argmax of σ(k)" ;

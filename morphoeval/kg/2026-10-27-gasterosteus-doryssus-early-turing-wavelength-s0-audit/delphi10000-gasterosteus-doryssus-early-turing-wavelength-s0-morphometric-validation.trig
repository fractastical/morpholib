        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-successor-doryssus-mid-analytic-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-measurement-successor-doryssus-mid-analytic-wavelength-reference> a schema:PropertyValue ;
        dct:source "early chronospecies λ_c; the successor must be longer" ;

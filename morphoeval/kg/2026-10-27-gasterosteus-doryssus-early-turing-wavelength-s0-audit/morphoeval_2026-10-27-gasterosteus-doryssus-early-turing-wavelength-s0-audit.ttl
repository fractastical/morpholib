<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Schnakenberg Turing wavelength of Gasterosteus doryssus_early at 33 µm (10.02 Ma) — Morphological realism / specimen match: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The 12-frame GIF scores 85.9 on the canonical Sobel / radial-FFT / coherency comparison with the gallery ocellus, and the PNG places that photograph beside the Schnakenberg field. Deductions: the photograph is a project gallery spiral, not a fossil thin section (-10); its high-pass band is 81.08 µm while λ_c is 32.86 µm, and the audit does not hide that gap (-6); the raw u field is a mottled Turing field rather than a visual copy of the spiral (-4)." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;

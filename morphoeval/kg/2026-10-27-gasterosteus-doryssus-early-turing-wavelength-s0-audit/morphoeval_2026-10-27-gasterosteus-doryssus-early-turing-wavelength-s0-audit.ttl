<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg Jacobian trace-determinant stability" ;
    dct:description "Homogeneous steady state of the 32.86 µm dermal patch is stable when diffusion is equal | Variables: a=0.062, b=0.948, trace scaled by 1e4 equals -1429, det scaled equals 10201" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0; Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py#L104-L124>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3229_gasterosteus_doryssus_early_turing_wavelength_s0.lean#L26-L51> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0 at (u0, v0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41559-020-01287-x>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2007.00310.x>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1666/05026.1> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3229.traceJac" ;
    pk:leanTheorem "MathOfBiology.Loop_3229.jacobian_is_stable_without_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber of maximum growth" ;
    dct:description "Selects the cellular wavelength at 10.02 Ma and the lengthening into doryssus_mid | Variables: D_u=8.204081632653061 µm^2, D_v/D_u=12.276923076923076, lambda_c=32.86 µm, successor 41.50 µm" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012; Hunt, Bell & Travis (2008) DOI:10.1111/j.1558-5646.2007.00310.x" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0.py#L115-L140>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3229_gasterosteus_doryssus_early_turing_wavelength_s0.lean#L10-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c = argmax sigma(k), sigma(k) = largest real eigenvalue of J - k^2 diag(D_u, D_v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/s41559-020-01287-x>,
        <https://doi.org/10.1073/pnas.0808622106>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1558-5646.2007.00310.x>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.1666/05026.1> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3229.lambdaEarly" ;
    pk:leanTheorem "MathOfBiology.Loop_3229.successor_lengthens_cellular_wavelength" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-3> a skos:Concept,

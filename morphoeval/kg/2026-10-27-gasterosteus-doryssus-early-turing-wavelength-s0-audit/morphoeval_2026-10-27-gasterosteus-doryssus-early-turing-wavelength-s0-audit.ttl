        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-repro-package-2> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-gasterosteus-doryssus-early-turing-wavelength-s0-source-traceability> a pk:LLMClaimAssessment ;

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) — Model fidelity to source: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Implements Hannezo, Prost & Joanny's (2014) PNAS and Krajnc & Ziherl's (2015) PRE 3D single-cell energy E_cell(A), L-BFGS-B area minimization confirming h_0/d_0 = c*Gamma_l/[4*(Gamma_a+Gamma_b)] and Hessian convexity E''(A_0) > 0 (L127-194), quartic substrate buckling wavelength lambda_c = 2*pi*(kappa_eff/K_sub)^(1/4) (L197-211), 2D pseudo-spectral L-BFGS-B surface energy relaxation (`relax_epithelial_monolayer_3d`, L243-391), and all 5 genetic/mechanical perturbations (L512-549), backed by 3 machine-checked Lean 4 theorems in `morphoeval/lean/loops/Loop_047_epithelial_buckling_3d.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L127–L237" ;
        dct:description "Analytic + L-BFGS-B 3D single-cell equilibrium geometry, Hessian convexity, buckling wavelength, and 5-regime phase classifier" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L127-L237> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L243–L391" ;
        dct:description "2D pseudo-spectral + L-BFGS-B epithelial monolayer energy minimizer across flat, folded, and acinar regimes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L243-L391> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_047_epithelial_buckling_3d.lean L13–L120" ;
        dct:description "3 machine-checked Lean 4 theorems for equilibrium aspect-ratio hierarchy, cell energy convexity & quartic buckling stationarity, and spontaneous curvature sign reversal (0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/morphoeval/lean/loops/Loop_047_epithelial_buckling_3d.lean#L13-L120> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 047 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


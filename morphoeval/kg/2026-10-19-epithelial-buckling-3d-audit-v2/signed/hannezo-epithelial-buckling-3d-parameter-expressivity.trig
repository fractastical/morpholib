sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) — Parameter expressivity: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Maps the full 48x48 2D phase diagram in (Gamma_l/Gamma_a, K_sub) across all 5 morphological regimes (`compute_phase_diagram_grid`, L482-509), evaluates 12 tissues across Mus musculus and Drosophila melanogaster (L397-479), runs 5 perturbation conditions (WT folds, E-cadherin knockdown flattening, apical Myosin-II hyperactivation, basal tension curvature inversion, soft-substrate acinus, L512-549), and exposes `--gamma-a`, `--gamma-b`, `--gamma-l`, `--k-sub`, and `--seed` CLI overrides (L1189-1220)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity-2> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L397–L549" ;
        dcterms:description "12-tissue cross-species evaluation, 48x48 5-regime 2D phase diagram, and 5 perturbation experiments" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L397-L549> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L1189–L1220" ;
        dcterms:description "CLI parameter overrides wired into comparative evaluation and figure rendering" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L1189-L1220> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 047 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


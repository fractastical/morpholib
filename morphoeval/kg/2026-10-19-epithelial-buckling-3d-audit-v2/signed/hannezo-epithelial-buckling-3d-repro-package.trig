        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L1138–L1186" ;
        dcterms:description "Comprehensive 8-check self_test() including bitwise determinism and perturbation invariants" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L1138-L1186> .


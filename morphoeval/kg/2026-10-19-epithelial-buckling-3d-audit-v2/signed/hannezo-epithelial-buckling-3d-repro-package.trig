    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) — Reproducibility package: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "8-point `self_test()` suite (`L1138-1186`) verifying SHA-256 dataset integrity, JSON-to-code parity, L-BFGS-B vs analytic aspect-ratio parity and Hessian positivity E''(A_0) > 0, E-cadherin knockdown flattening and Myosin-II vs basal curvature sign reversal, 5-regime phase diagram completeness, 12-tissue scaling collapse, specimen CV metrics, and two-run bitwise determinism (`np.allclose(..., atol=0.0)`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-repro-package-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

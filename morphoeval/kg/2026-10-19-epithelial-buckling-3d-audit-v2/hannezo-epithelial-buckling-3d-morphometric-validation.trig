sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1044-1135) computes 8 reference-anchored morphometric measurements with statistical tests: 12-tissue aspect-ratio Pearson r = 1.0000 (p = 4.9e-24, RMSE = 0.0049), log-log scaling exponent alpha_AR = 0.9963 ± 0.0022 (ref 1.0), buckled wavelength Pearson r = 0.9993 (p = 7.7e-07, RMSE = 1.25 um), WT columnar aspect ratio 4.4838 (ref 4.4839), E-cadherin knockdown aspect ratio 0.2240 (ref 0.2240, amplitude = 0.0 um), basal-to-apical spontaneous curvature antisymmetry ratio -1.0000 (ref -1.0), specimen empirical aspect ratio h0/d0 = 4.4833 (ref 4.48), and specimen fold wavelength-to-height ratio lambda_c/h0 = 4.4252 (ref 4.45)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-12-tissue-cross-species-epithelial-aspect-ratio-correlation-mus-musculus-drosophila>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-apico-basal-spontaneous-curvature-antisymmetry-ratio-c0-basal-c0-apical>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-buckled-epithelial-fold-acinus-wavelength-correlation-lambda-sim-vs-lambda-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-cross-species-log-log-aspect-ratio-scaling-exponent-alpha-ar>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-e-cadherin-knockdown-flattening-control-aspect-ratio-h0-d0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-dimensionless-fold-wavelength-to-thickness-ratio-lambda-c-h0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-empirical-columnar-cell-aspect-ratio-h0-d0-epithelial-sheet-buckling-specimen-jpg>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-wild-type-tall-columnar-intestinal-epithelium-equilibrium-aspect-ratio-h0-d0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-12-tissue-cross-species-epithelial-aspect-ratio-correlation-mus-musculus-drosophila> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-tissue cross-species epithelial aspect-ratio correlation (Mus musculus & Drosophila) = 1.0 Pearson r" ;
        dct:description "RMSE = 0.0041, p = 6.49e-28" ;
        schema:measurementTechnique "Linear regression of predicted h_0/d_0 = c*Gamma_l/[4*(Gamma_a+Gamma_b)] vs observed aspect ratio across 12 tissues in 2 species (p=6.49e-28, RMSE=0.0041)" ;
        schema:name "12-tissue cross-species epithelial aspect-ratio correlation (Mus musculus & Drosophila)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-12-tissue-cross-species-epithelial-aspect-ratio-correlation-mus-musculus-drosophila-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-12-tissue-cross-species-epithelial-aspect-ratio-correlation-mus-musculus-drosophila-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Eq. (4) & Fig. 1" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-apico-basal-spontaneous-curvature-antisymmetry-ratio-c0-basal-c0-apical> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Apico-basal spontaneous curvature antisymmetry ratio C0(basal) / C0(apical) = -1.0 ratio" ;
        dct:description "C0_apical = +0.0612 um^-1, C0_basal = -0.0612 um^-1" ;
        schema:measurementTechnique "Ratio of spontaneous curvature C_0 under basal tension hyperactivation (Gamma_b=1.45, Gamma_a=0.45) to apical Myosin-II hyperactivation (Gamma_a=1.45, Gamma_b=0.45)" ;
        schema:name "Apico-basal spontaneous curvature antisymmetry ratio C0(basal) / C0(apical)" ;
        schema:unitText "ratio" ;
        schema:value "-1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-apico-basal-spontaneous-curvature-antisymmetry-ratio-c0-basal-c0-apical-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-apico-basal-spontaneous-curvature-antisymmetry-ratio-c0-basal-c0-apical-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS Eq. (5) & Krajnc & Ziherl (2015) PRE Eq. (14) exact C_0 sign reversal" ;
        schema:value "-1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-buckled-epithelial-fold-acinus-wavelength-correlation-lambda-sim-vs-lambda-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Buckled epithelial fold & acinus wavelength correlation lambda_sim vs lambda_obs = 0.9993 Pearson r" ;
        dct:description "RMSE = 11.15 um" ;
        schema:measurementTechnique "L-BFGS-B relaxed buckling wavelength vs observed wavelength across 6 buckled/acinar tissues (p=7.21e-07, RMSE=11.15 um)" ;
        schema:name "Buckled epithelial fold & acinus wavelength correlation lambda_sim vs lambda_obs" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9993" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-buckled-epithelial-fold-acinus-wavelength-correlation-lambda-sim-vs-lambda-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-buckled-epithelial-fold-acinus-wavelength-correlation-lambda-sim-vs-lambda-obs-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Eq. (9) lambda_c = 2*pi*(kappa_eff/K_sub)^(1/4)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-cross-species-log-log-aspect-ratio-scaling-exponent-alpha-ar> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Cross-species log-log aspect-ratio scaling exponent alpha_AR = 0.9938 exponent" ;
        dct:description "SE = 0.0015" ;
        schema:measurementTechnique "Log-log OLS slope of log(h_0/d_0)_obs vs log(c*Gamma_l/[4*(Gamma_a+Gamma_b)]) across 12 epithelial tissues (SE ± 0.0015)" ;
        schema:name "Cross-species log-log aspect-ratio scaling exponent alpha_AR" ;
        schema:unitText "exponent" ;
        schema:value "0.9938" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-cross-species-log-log-aspect-ratio-scaling-exponent-alpha-ar-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-cross-species-log-log-aspect-ratio-scaling-exponent-alpha-ar-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Eq. (4) linear aspect-ratio scaling" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-e-cadherin-knockdown-flattening-control-aspect-ratio-h0-d0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "E-cadherin knockdown flattening control aspect ratio h0/d0 = 0.224 h0/d0" ;
        dct:description "buckling amplitude = 0.00 um vs WT 42.5 um" ;
        schema:measurementTechnique "E-cadherin knockdown / relative lateral tension depletion (Gamma_l/Gamma_a = 0.48) flattening columnar sheet to unbuckled squamous monolayer" ;
        schema:name "E-cadherin knockdown flattening control aspect ratio h0/d0" ;
        schema:unitText "h0/d0" ;
        schema:value "0.224" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-e-cadherin-knockdown-flattening-control-aspect-ratio-h0-d0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-e-cadherin-knockdown-flattening-control-aspect-ratio-h0-d0-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 p. 28 (E-cadherin knockdown flattens columnar cells to squamous, amplitude = 0 um)" ;
        schema:value "0.224" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-dimensionless-fold-wavelength-to-thickness-ratio-lambda-c-h0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Histology specimen dimensionless fold wavelength-to-thickness ratio lambda_c / h0 = 4.4252 lambda_c / h0" ;
        dct:description "lambda_c = 264.0 ± 109.5 px" ;
        schema:measurementTechnique "Ratio of segmented mucosal fold wavelength (264.0 px) to monolayer thickness (59.66 px) in CC0 trichrome specimen" ;
        schema:name "Histology specimen dimensionless fold wavelength-to-thickness ratio lambda_c / h0" ;
        schema:unitText "lambda_c / h0" ;
        schema:value "4.4252" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-dimensionless-fold-wavelength-to-thickness-ratio-lambda-c-h0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-dimensionless-fold-wavelength-to-thickness-ratio-lambda-c-h0-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Fig. 3 buckled columnar monolayer wavelength-to-thickness ratio" ;
        schema:value "4.45" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-empirical-columnar-cell-aspect-ratio-h0-d0-epithelial-sheet-buckling-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Histology specimen empirical columnar cell aspect ratio h0/d0 (epithelial_sheet_buckling_specimen.jpg) = 4.4833 h0/d0" ;
        dct:description "h0 = 59.66 ± 19.22 px, d0 = 13.31 px" ;
        schema:measurementTechnique "Ratio of Euclidean distance-transform monolayer height (59.66 px) to DoG nuclear nearest-neighbor cell width (13.31 px, n=921 nuclei)" ;
        schema:name "Histology specimen empirical columnar cell aspect ratio h0/d0 (epithelial_sheet_buckling_specimen.jpg)" ;
        schema:unitText "h0/d0" ;
        schema:value "4.4833" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-empirical-columnar-cell-aspect-ratio-h0-d0-epithelial-sheet-buckling-specimen-jpg-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-histology-specimen-empirical-columnar-cell-aspect-ratio-h0-d0-epithelial-sheet-buckling-specimen-jpg-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111:27-32 & Štorgel et al. (2016) Biophys. J. 110:269 tall simple columnar epithelium" ;
        schema:value "4.48" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-wild-type-tall-columnar-intestinal-epithelium-equilibrium-aspect-ratio-h0-d0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type tall columnar intestinal epithelium equilibrium aspect ratio h0/d0 = 4.4838 h0/d0" ;
        dct:description "analytic = 4.4838, L-BFGS-B = 4.4838" ;
        schema:measurementTechnique "L-BFGS-B single-cell energy minimization of E_cell(A) for tall columnar mouse intestinal epithelium (Gamma_a=0.58, Gamma_b=0.52, Gamma_l=5.30)" ;
        schema:name "Wild-type tall columnar intestinal epithelium equilibrium aspect ratio h0/d0" ;
        schema:unitText "h0/d0" ;
        schema:value "4.4838" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-wild-type-tall-columnar-intestinal-epithelium-equilibrium-aspect-ratio-h0-d0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-measurement-wild-type-tall-columnar-intestinal-epithelium-equilibrium-aspect-ratio-h0-d0-reference> a schema:PropertyValue ;
        dct:source "Hannezo, Prost & Joanny (2014) PNAS 111(1):27-32 Fig. 1 & Štorgel et al. (2016) Biophys. J. 110:269" ;
        schema:value "4.4839" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L1044–L1135" ;
        dct:description "8 quantitative morphometric measurements with p-values, RMSE, SE, perturbation deltas, and histology CV metrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L1044-L1135> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 047 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


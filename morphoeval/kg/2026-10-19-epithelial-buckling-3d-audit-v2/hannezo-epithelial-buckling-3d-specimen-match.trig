sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hannezo-epithelial-buckling-3d> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hannezo-epithelial-buckling-3d-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Hannezo, Prost & Joanny (2014) PNAS & Krajnc & Ziherl (2015) PRE 3D epithelial sheet morphology (squamous-to-cuboidal-to-columnar scaling & apico-basal buckling) — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC0 Masson-trichrome histological section `datasets/epithelial_buckling_3d/epithelial_sheet_buckling_specimen.jpg`, segments the epithelial monolayer, cyan/blue stromal foundation, and n = 921 basophilic nuclei (`segment_epithelial_histology_specimen`, L555-635) to extract monolayer height h0 = 59.66 px, cell width d0 = 13.31 px, empirical aspect ratio h0/d0 = 4.4833 (ref 4.48), fold wavelength lambda_c = 264.0 px, and ratio lambda_c/h0 = 4.4252 (ref 4.45), and matches all 12 tissues across Mus musculus and Drosophila melanogaster (r = 1.0000)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2016-hannezo-epithelial-buckling-3d.py L555–L635" ;
        dct:description "Euclidean distance-transform monolayer thickness, DoG nuclear cell width, and fold wavelength segmentation on epithelial_sheet_buckling_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/e93f00e/2016-hannezo-epithelial-buckling-3d.py#L555-L635> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hannezo-epithelial-buckling-3d-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/epithelial_buckling_3d_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure comparing 2D phase diagram, 12-tissue scaling collapse, L-BFGS-B topographies, perturbations, and histology specimen segmentation — docs/media/epithelial_buckling_3d_comparison.png: rendered output of 2016-hannezo-epithelial-buckling-3d.py at e93f00e, image/png, 799978 B, 2169×1442 px, artifact_sha256 48e806331be54d983f03105bfccdb6e42e173dfb732c824f84de22bb955b1b0a (sha256 48e806331be54d983f03105bfccdb6e42e173dfb732c824f84de22bb955b1b0a), spec_fingerprint eabe5855ceb1bf4a12fea7ec7b30902813b84c0440d83d21ca21bb917876b36c" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 047 Pass 2 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


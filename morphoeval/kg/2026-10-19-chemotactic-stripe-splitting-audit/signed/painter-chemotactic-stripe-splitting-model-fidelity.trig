sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py L35–L65" ;
        dcterms:description "Analytical equal-diffusivity chemotactic threshold chi_c and wavelength lambda_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L35-L65> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) chemotactic stripe splitting & stripe-spot selection — Model fidelity to source: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Computes the exact equal-diffusivity linear stability threshold chi_c = 4.5 and critical wavelength lambda_c = 4.4429 (L35-65), but Pass 1 approximates the 1D kymograph kinematically rather than solving the nonlinear coupled chemotactic-RD PDE system with conservative flux divergence div(n chi(c) grad(c)) and 2D stripe-vs-spot pattern selection." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "1999-painter-chemotactic-stripe-splitting.py L68–L86: Kinematic 1D stripe approximation requiring replacement with full Keller-Segel PDE solver <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L68-L86>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity-1> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) chemotactic stripe splitting & stripe-spot selection — Reproducibility package: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Provides `--self-test` and deterministic seed=1999, but self-test only checks analytical chi_c = 4.5 and lacks SHA-256 dataset verification, bitwise PDE solver determinism, subcritical negative control assertion, and specimen segmentation checks." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "1999-painter-chemotactic-stripe-splitting.py L137–L149: Minimal Pass 1 self-test <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L137-L149>" ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


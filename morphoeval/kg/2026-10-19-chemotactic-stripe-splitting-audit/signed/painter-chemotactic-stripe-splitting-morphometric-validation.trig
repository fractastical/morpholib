sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) chemotactic stripe splitting & stripe-spot selection — Morphometric validation: 52/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Reports 2 analytical measurements in `measure_morphoeval()`, but lacks simulated PDE stripe-splitting wavelength accuracy, 5-regime peak count RMSE, 2D stripe vs spot structural metrics, and empirical specimen ridge spacing in micrometers." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "1999-painter-chemotactic-stripe-splitting.py L89–L108: Minimal 2-metric measure_morphoeval() hook <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L89-L108>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-critical-chemotactic-sensitivity-chi-c-at-equal-diffusivity-d-n-d-c-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-critical-chemotactic-stripe-wavelength-lambda-c-2-pi-k-c> ;
        pk:hasScore "0.52"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-critical-chemotactic-sensitivity-chi-c-at-equal-diffusivity-d-n-d-c-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical chemotactic sensitivity chi_c at equal diffusivity D_n = D_c = 1 = 4.5 dimensionless" ;
        schema:measurementTechnique "Painter, Maini & Othmer (1999) linear stability analysis around (n*, c*) = (1, 1)" ;
        schema:name "critical chemotactic sensitivity chi_c at equal diffusivity D_n = D_c = 1" ;
        schema:unitText "dimensionless" ;
        schema:value "4.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-critical-chemotactic-sensitivity-chi-c-at-equal-diffusivity-d-n-d-c-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-critical-chemotactic-sensitivity-chi-c-at-equal-diffusivity-d-n-d-c-1-reference> a schema:PropertyValue ;
        dcterms:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554 Eqs. (3)-(6)" ;
        schema:value "4.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-critical-chemotactic-stripe-wavelength-lambda-c-2-pi-k-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical chemotactic stripe wavelength lambda_c = 2*pi / k_c = 4.4429 dimensionless length" ;
        schema:measurementTechnique "k_c^2 = sqrt(r * gamma / (D_n * D_c)) = 2.0 => lambda_c = pi * sqrt(2)" ;
        schema:name "critical chemotactic stripe wavelength lambda_c = 2*pi / k_c" ;
        schema:unitText "dimensionless length" ;
        schema:value "4.4429" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-critical-chemotactic-stripe-wavelength-lambda-c-2-pi-k-c-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-painter-chemotactic-stripe-splitting-measurement-critical-chemotactic-stripe-wavelength-lambda-c-2-pi-k-c-reference> a schema:PropertyValue ;
        dcterms:source "Painter, Maini & Othmer (1999) PNAS 96(10):5549-5554" ;
        schema:value "4.4429" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


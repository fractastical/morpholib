sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-overall> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Painter, Maini & Othmer (1999) chemotactic stripe splitting & stripe-spot selection — MorphoEval overall 54.0/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Pass 1 baseline assessment of `1999-painter-chemotactic-stripe-splitting.py` (54.4/100). The initial script computes the analytical equal-diffusivity chemotactic bifurcation threshold chi_c = 4.5 and critical wavelength lambda_c = 4.4429, but uses a kinematic mode approximation rather than integrating the full nonlinear Keller-Segel-Painter PDE dn/dt = D_n Lap(n) - div(n chi(c) grad(c)) + r n (1 - n/n_0) and dc/dt = D_c Lap(c) + alpha n / (1 + beta n) - gamma c on a growing domain, lacks 2D stripe-vs-spot selection simulation, and lacks automated computer-vision segmentation of the vendored Myxococcus xanthus specimen (`chemotactic_pattern_specimen.jpg`). Overall 54.0/100 (faithfulness 51.7, reproducibility 59.2); rubric morphoeval 0.1.0; checkpoint commit 317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 56, Morphological realism / specimen match 48, Parameter expressivity 52, Morphometric validation 52, Source and data traceability 64, Code-to-model traceability 58, Reproducibility package 56. Output judged: docs/media/chemotactic_stripe_splitting_comparison.png: rendered output of 1999-painter-chemotactic-stripe-splitting.py at 317bc3c, image/png, 468870 B, 1200×504 px, artifact_sha256 fdbda2565a00f3883c2fd1ab25aa233e8d978633cb71373ebd77f9d058d47f14 (sha256 fdbda2565a00f3883c2fd1ab25aa233e8d978633cb71373ebd77f9d058d47f14), spec_fingerprint 91fb31037b136e4adc1e8bdd7b6c8097f7eaab327a03b1266cf7114f22d5f57f. Dual provenance: spec_fingerprint: 91fb31037b136e4adc1e8bdd7b6c8097f7eaab327a03b1266cf7114f22d5f57f; artifact_sha256: fdbda2565a00f3883c2fd1ab25aa233e8d978633cb71373ebd77f9d058d47f14; input_dataset_sha256: {datasets/chemotactic_stripe_splitting/chemotactic_pattern_specimen.jpg=7b1780ffcb70f313..., datasets/chemotactic_stripe_splitting/chemotactic_stripe_splitting_reference.json=2c37ed1ab3d26a08..., datasets/chemotactic_stripe_splitting/scout_manifest.json=4b4e20a991f65c81...}." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add computer-vision segmentation of `datasets/chemotactic_stripe_splitting/chemotactic_pattern_specimen.jpg` to extract both the right-hand chemotactic rippling ridge wavelength (in px and um via the 500 um scale bar) and the left-hand yellow fruiting-body spot aggregates, plus runtime SHA-256 dataset verification.",
            "remediation needed: Implement 2D Keller-Segel-Painter chemotactic pattern selection comparing labyrinthine chemotactic stripes vs hexagonal fruiting-body spot aggregates.",
            "remediation needed: Replace the kinematic 1D approximation with a full conservative finite-difference/spectral Keller-Segel-Painter PDE solver integrating dn/dt = D_n Lap(n) - div(n chi(c) grad(c)) + r n (1 - n/n_0) and dc/dt = D_c Lap(c) + alpha n / (1 + beta n) - gamma c across growing domain stages L / lambda_c in {1, 2, 4, 8} plus a subcritical negative control (chi = 3.0 < chi_c = 4.5 -> 0 peaks)." ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


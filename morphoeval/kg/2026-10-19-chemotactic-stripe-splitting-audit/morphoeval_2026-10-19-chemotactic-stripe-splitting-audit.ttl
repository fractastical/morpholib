    pk:evidenceAgainst "1999-painter-chemotactic-stripe-splitting.py L68–L86: Single-regime 1D run without 5-regime sweep or 2D stripe/spot comparison <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py#L68-L86>" ;
    pk:hasScore 5.2e-01 ;
    pk:hasVerdict "partially faithful" .


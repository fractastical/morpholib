sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-painter-chemotactic-stripe-splitting> a pk:Claim ;
        rdfs:label "Painter, Maini & Othmer (1999) chemotactic stripe splitting & stripe-spot selection faithfully reproduces Myxococcus xanthus & Dictyostelium discoideum chemotactic cell populations morphology" ;
        dct:description "The simulation script(s) 1999-painter-chemotactic-stripe-splitting.py implement the cited source model as published and produce forms that match real Myxococcus xanthus & Dictyostelium discoideum chemotactic cell populations specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.0/100, audit 2026-10-19-chemotactic-stripe-splitting-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py; output: docs/media/chemotactic_stripe_splitting_comparison.png; organism: Myxococcus xanthus & Dictyostelium discoideum chemotactic cell populations; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 91fb31037b136e4adc1e8bdd7b6c8097f7eaab327a03b1266cf7114f22d5f57f; artifact_sha256: fdbda2565a00f3883c2fd1ab25aa233e8d978633cb71373ebd77f9d058d47f14; input_dataset_sha256: {datasets/chemotactic_stripe_splitting/chemotactic_pattern_specimen.jpg=7b1780ffcb70f313..., datasets/chemotactic_stripe_splitting/chemotactic_stripe_splitting_reference.json=2c37ed1ab3d26a08..., datasets/chemotactic_stripe_splitting/scout_manifest.json=4b4e20a991f65c81...}" ;
        pk:derivedFromPaper <https://doi.org/10.1007/BF02458621>,
            <https://doi.org/10.1016/0022-5193(70)90092-5>,
            <https://doi.org/10.1016/j.physd.2010.09.011>,
            <https://doi.org/10.1073/pnas.96.10.5549> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-painter-chemotactic-stripe-splitting-specimen-match> ;
        pk:weightOfEvidence "0.54"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/317bc3c/1999-painter-chemotactic-stripe-splitting.py> a schema:SoftwareSourceCode ;
        rdfs:label "1999-painter-chemotactic-stripe-splitting.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


<https://w3id.org/delphi/resource/math-law/delphi10000-ciona-intestinalis-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Stable homogeneous state" ;
    dct:description "Homogeneous pigment field is stable before diffusion is allowed to destabilise it | Variables: f_u = 0.8, g_v = -1 at the Schnakenberg steady state (1, 0.9); integers in Lean are scaled by 10" ;
    dct:source "Turing (1952) doi:10.1098/rstb.1952.0012; Schnakenberg (1979) doi:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py#L88-L131>,
        <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/morphoeval/lean/loops/Loop_3148_ciona_intestinalis_turing_wavelength_s0.lean#L22-L28> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "tr J = f_u + g_v < 0 and det J = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21188>,
        <https://doi.org/10.1002/wdev.239>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature02975>,
        <https://doi.org/10.1038/nature11589>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/jzs.12101>,
        <https://doi.org/10.1186/s12915-021-01075-4>,
        <https://doi.org/10.15468/0lkr3w> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3148.traceJ" ;
    pk:leanTheorem "MathOfBiology.Loop_3148.trace_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ciona-intestinalis-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing wavenumber" ;
    dct:description "Selects the stripe wavelength on the detail-tier patch | Variables: D_v/D_u = 10; gamma chosen so lambda_c equals the 51 µm tier pin" ;
    dct:source "Turing (1952) doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py#L98-L121>,
        <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/morphoeval/lean/loops/Loop_3148_ciona_intestinalis_turing_wavelength_s0.lean#L34-L42> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = gamma (D_v f_u + D_u g_v) / (2 D_u D_v), lambda_c = 2 pi / k_c = 5.056e-5 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21188>,
        <https://doi.org/10.1002/wdev.239>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature02975>,
        <https://doi.org/10.1038/nature11589>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/jzs.12101>,
        <https://doi.org/10.1186/s12915-021-01075-4>,
        <https://doi.org/10.15468/0lkr3w> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3148.crossDiff" ;
    pk:leanTheorem "MathOfBiology.Loop_3148.discriminant_positive" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ciona-intestinalis-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control. The critical mode must decay. | Variables: Same Jacobian; diffusion ratio forced to 1" ;
    dct:source "Turing (1952) doi:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py#L277-L295>,
        <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/morphoeval/lean/loops/Loop_3148_ciona_intestinalis_turing_wavelength_s0.lean#L44-L46> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "If D_u = D_v then D_v f_u + D_u g_v = D_u (f_u + g_v) < 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21188>,
        <https://doi.org/10.1002/wdev.239>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature02975>,
        <https://doi.org/10.1038/nature11589>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/jzs.12101>,
        <https://doi.org/10.1186/s12915-021-01075-4>,
        <https://doi.org/10.15468/0lkr3w> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3148.equal_diffusion_ablation" ;
    pk:leanTheorem "MathOfBiology.Loop_3148.equal_diffusion_ablation" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-ciona-intestinalis-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Scale sandwich at 0 Ma" ;
    dct:description "States what changes at this scale versus finer and coarser neighbours when there is no other chronospecies | Variables: melanosome 1 µm; detail patch 204 µm; adult bar 10000 µm; series length 1" ;
    dct:source "Slot pin 5.056e-05 m; specimen scale bar 10 mm on YPM IZ 082346" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py#L46-L52>,
        <https://github.com/fractastical/morpholib/blob/25e28a4514fe1c49bc401d10321c28551fd40114/morphoeval/lean/loops/Loop_3148_ciona_intestinalis_turing_wavelength_s0.lean#L48-L55> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "1 µm < 4 * 51 µm < 10 mm, and the chronoseries predecessor count is 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21188>,
        <https://doi.org/10.1002/wdev.239>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/nature02975>,
        <https://doi.org/10.1038/nature11589>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/jzs.12101>,
        <https://doi.org/10.1186/s12915-021-01075-4>,
        <https://doi.org/10.15468/0lkr3w> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3148.scale_sandwich" ;
    pk:leanTheorem "MathOfBiology.Loop_3148.scale_sandwich" ;
    pk:leanVerified true .


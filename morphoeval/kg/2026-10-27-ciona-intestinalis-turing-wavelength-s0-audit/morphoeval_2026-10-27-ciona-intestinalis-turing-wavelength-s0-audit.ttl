<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Ciona intestinalis Turing wavelength at 51 µm (5.056e-05 m), Holocene 0 Ma — Code-to-model traceability: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The module docstring states the PDE, the wavenumber formula, the periodic boundary, and the claim that u and v are not named genes. gamma_for_wavelength is the line that enforces the pin. Lean Loop_3148 proves the integer form of the trace, determinant, cross term, discriminant, equal-diffusion ablation, and the scale sandwich." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-code-traceability-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-code-traceability-2> ;
    pk:hasScore 8.4e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Ciona intestinalis Turing wavelength at 51 µm (5.056e-05 m), Holocene 0 Ma — Model fidelity to source: 86/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The script integrates the Schnakenberg parenthesis with a semi-implicit Fourier step and sets gamma from the Turing formula so lambda_c matches 5.056e-05 m to numerical tolerance. Periodic boundaries match the Fourier symbol. u and v are not dressed up as named genes." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-model-fidelity-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0-model-fidelity-2> ;
    pk:hasScore 8.6e-01 ;
    pk:hasVerdict "faithful" .


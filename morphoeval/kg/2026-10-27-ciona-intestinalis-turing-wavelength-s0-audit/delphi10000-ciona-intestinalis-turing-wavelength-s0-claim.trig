        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-ciona-intestinalis-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Ciona intestinalis Turing wavelength at 51 µm (5.056e-05 m), Holocene 0 Ma faithfully reproduces Ciona intestinalis morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Ciona intestinalis specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py; output: docs/media/ciona_intestinalis_turing_wavelength_s0_comparison.png; organism: Ciona intestinalis; environment: python 3.12.3, note numpy, scipy, pillow, matplotlib. No ~/.nanopub/profile.yml on this runner.; claim_boundary: [reported_in_source: Turing (1952) derived the diffusion-driven instability and the critical wavenumber. Schnakenberg (1979) gave the two-species kinetic scheme used here. | Ciona pigment cells are a neural-crest-like lineage (Abitua et al. 2012). Jeffery et al. (2004) showed migratory pigment cells in a urochordate. The larval ocellus and otolith sit in the sensory vesicle (Hudson 2016; Kourakis et al. 2021; Hotta et al. 2007).; reconstructed_in_script: gamma, Du and Dv are chosen so the analytical lambda_c equals the slot pin 5.056e-05 m. They are not a regression onto a Ciona dose-response curve. | The growth GIF paints the activator inside the segmented YPM body. Computer-vision similarity to that photograph is a silhouette-and-texture score, not a claim that the adult tunic stripes at 51 µm.; transfer_boundary: Chronoseries length is 1, so there is no temporal predecessor. The scale sandwich is melanosome (1 µm) < detail patch (4 × 51 µm) < adult body on the 10 mm bar. | Adult red-channel spacing on this photograph is 873 µm. That number must not be quoted as a measurement of k_c.; does_not_claim: Does not claim u and v are identified Ciona morphogens. | Does not claim Brunetti et al. (2015) type A versus type B was resolved from this photograph. | Does not claim a nanopublication signature. No ~/.nanopub/profile.yml is present on this runner.]; phenomenon_size: 46 µm (4.608e-05 m, log10=-4.336 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 46 µm to 14.4 cm): 46 µm:ciona-intestinalis-bioelectric-polarity, 172 µm:ciona-intestinalis-vertex-packing, 3.2 mm:ciona-intestinalis-turing-wavelength, 6.0 mm:ciona-intestinalis-clock-wavefront, 1.4 cm:ciona-intestinalis-elastic-buckling, 1.8 cm:ciona-intestinalis-morphogen-condensation, 2.4 cm:ciona-intestinalis-flux-canalization, 3.2 cm:ciona-intestinalis-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1002/dvdy.21188>,
            <https://doi.org/10.1002/wdev.239>,
            <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1038/nature02975>,
            <https://doi.org/10.1038/nature11589>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/jzs.12101>,
            <https://doi.org/10.1186/s12915-021-01075-4>,
            <https://doi.org/10.15468/0lkr3w> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-ciona-intestinalis-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}


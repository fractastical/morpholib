        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg–Turing critical wavelength for Drosophila erecta at 2.262 µm (Pass 2) — Morphometric validation: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Annulus Pearson r=0.99803 against reference ceiling 1.0 (RMSE=1.966, so the series are not copies). KS=0.064 against anchor 0.5. Segmented ring radius 97.30 µm against the elegans primordium anchor 101.1 µm. PDE patch grows by 3.36× at the critical mode; the negative controls fall below 1e-4." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-diffusion-ratio-sweep-endpoint-wavelength-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-equal-diffusion-control-versus-critical-mode-growth-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-pde-detail-wavelength-versus-assigned-2-262-m-target>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-annulus-radius-versus-elegans-primordium-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-radial-profile-ks-distance>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-diffusion-ratio-sweep-endpoint-wavelength-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusion-ratio sweep endpoint wavelength ratio = 1.3042 λ(δ=4) / λ(δ=40)" ;
        dct:description "monotonic decreasing control of wavelength by inhibitor range" ;
        schema:measurementTechnique "analytic k_c at fixed Du across δ = 4, 8, 12, 16, 24, 40" ;
        schema:name "diffusion-ratio sweep endpoint wavelength ratio" ;
        schema:unitText "λ(δ=4) / λ(δ=40)" ;
        schema:value "1.3042" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-diffusion-ratio-sweep-endpoint-wavelength-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-diffusion-ratio-sweep-endpoint-wavelength-ratio-reference> a schema:PropertyValue ;
        dct:source "flat sweep (no expressivity) would give ratio 1" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-equal-diffusion-control-versus-critical-mode-growth-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion control versus critical-mode growth ratio = 0.0001 std ratio" ;
        dct:description "control decays; the δ=16 patch grows. Autocatalysis ablation ratio = 0.0000" ;
        schema:measurementTechnique "perturbation std after the run divided by the initial std; δ=1 negative control" ;
        schema:name "equal-diffusion control versus critical-mode growth ratio" ;
        schema:unitText "std ratio" ;
        schema:value "0.0001" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-equal-diffusion-control-versus-critical-mode-growth-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-equal-diffusion-control-versus-critical-mode-growth-ratio-reference> a schema:PropertyValue ;
        dct:source "critical-mode growth ratio at δ=16 on the same grid" ;
        schema:value "3.3599" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-pde-detail-wavelength-versus-assigned-2-262-m-target> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "PDE detail wavelength versus assigned 2.262 µm target = 2.262 µm" ;
        dct:description "relative error vs 2.262 µm = 0.0000; RMSE of the radial fit = 1.966" ;
        schema:measurementTechnique "FFT peak of the grown Schnakenberg patch, scaled by sqrt(Du)" ;
        schema:name "PDE detail wavelength versus assigned 2.262 µm target" ;
        schema:unitText "µm" ;
        schema:value "2.262" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-pde-detail-wavelength-versus-assigned-2-262-m-target-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-pde-detail-wavelength-versus-assigned-2-262-m-target-reference> a schema:PropertyValue ;
        dct:source "Assigned detail tier 2.3 µm (2.262 µm exact target is reported separately)" ;
        schema:value "2.3" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-annulus-radius-versus-elegans-primordium-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen annulus radius versus elegans primordium wavelength = 97.2973 µm" ;
        dct:description "The annulus is the ~100 µm ring in the gallery image. It is not the 2.262 µm detail wavelength." ;
        schema:measurementTechnique "argmin of the gallery radial luminance profile, times the drawn 100 µm scale bar" ;
        schema:name "specimen annulus radius versus elegans primordium wavelength" ;
        schema:unitText "µm" ;
        schema:value "97.2973" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-annulus-radius-versus-elegans-primordium-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-annulus-radius-versus-elegans-primordium-wavelength-reference> a schema:PropertyValue ;
        dct:source "Drosophila elegans primordium-tier characteristic size (chronoseries predecessor)" ;
        schema:value "101.1" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-radial-profile-ks-distance> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-profile KS distance = 0.064 KS statistic" ;
        dct:description "ks statistic is nonzero, so the fit is not a self-copy of the samples" ;
        schema:measurementTechnique "two-sample KS between empirical annulus samples and the disk-mode prediction" ;
        schema:name "specimen radial-profile KS distance" ;
        schema:unitText "KS statistic" ;
        schema:value "0.064" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-radial-profile-ks-distance-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-radial-profile-ks-distance-reference> a schema:PropertyValue ;
        dct:source "mid-range KS anchor, not the measured statistic" ;
        schema:value "0.5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen radial-profile Pearson r = 0.99803 correlation" ;
        dct:description "RMSE=1.966 gray levels; KS=0.0640" ;
        schema:measurementTechnique "Pearson r between the gallery annulus profile and the damped J0 disk mode" ;
        schema:name "specimen radial-profile Pearson r" ;
        schema:unitText "correlation" ;
        schema:value "0.99803" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-measurement-specimen-radial-profile-pearson-r-reference> a schema:PropertyValue ;
        dct:source "identity ceiling; the profiles are not the same series" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py L236–L258" ;
        dct:description "Pearson, RMSE, KS on the radial samples" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py#L236-L258> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py L482–L551" ;
        dct:description "measure_morphoeval anchors differ from measured values" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py#L482-L551> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 builder-assessor; second assessor still not run (R4)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


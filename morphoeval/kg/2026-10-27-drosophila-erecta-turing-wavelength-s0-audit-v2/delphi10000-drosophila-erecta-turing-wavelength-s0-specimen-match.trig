        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Direct CV similarity of the 16-frame 640×480 GIF against the gallery specimen is 82.0 (Sobel 12-bin, radial FFT, coherency, occupancy). The annulus reads as the same bright core and dark ring. The image is the project gallery field, not a wild fly, so the score stays below the mid-90s." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-specimen-match-2> ;
        pk:hasScore "0.82"^^xsd:double ;
        pk:hasVerdict "faithful" .

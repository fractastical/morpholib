<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg–Turing critical wavelength for Drosophila erecta at 2.262 µm (Pass 2) (Drosophila erecta)",
        "Schnakenberg–Turing critical wavelength for Drosophila erecta at 2.262 µm (Pass 2) faithfully reproduces Drosophila erecta morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-erecta-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-erecta-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-erecta-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Drosophila erecta specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-drosophila-erecta-turing-wavelength-s0.py> ;
    schema:about "Drosophila erecta" ;
    schema:additionalProperty "does_not_claim: Does not claim a wild-caught CC photograph was obtained",
        "does_not_claim: Does not claim geological age changes among elegans, erecta, and eugracilis (all 0 Ma)",
        "does_not_claim: Does not claim the tan enhancer numerically equals Dv/Du",
        "reconstructed_in_script: Damped J0 disk mode fitted to the gallery radial profile",
        "reconstructed_in_script: Dark a=0.29 and light a=0.08 at fixed Du, Dv",
        "reconstructed_in_script: Du = 3.987e-14 m^2/s and Dv = 6.380e-13 m^2/s so lambda_c = 2.262 µm",
        "reconstructed_in_script: Fourier ring at 2.262 µm used as the fine texture on the GIF",
        "reported_in_source: Gallery image has a drawn 100 µm scale bar (measured run 111 px)",
        "reported_in_source: Schnakenberg 1979 kinetics",
        "reported_in_source: Turing 1952 dispersion relation",
        "reported_in_source: Yassin et al. 2016 tan balancing selection in female D. erecta",
        "transfer_boundary: 2.262 µm is the assigned detail tier, not a length Yassin et al. measured",
        "transfer_boundary: The 97.3 µm dark ring is the primordium-scale annulus in the same image, not the detail wavelength" ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Drosophila erecta (Pandanus-Specialist West African Fly)" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;
    pk:aristotelianSubalternClass "Entoma (Arthropoda)" ;
    pk:biologicalGenus "Drosophila" ;

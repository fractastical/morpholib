    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-erecta-turing-wavelength-s0-parameter-expressivity-1> ;
    pk:hasScore 9e-01 ;
    pk:hasVerdict "faithful" .


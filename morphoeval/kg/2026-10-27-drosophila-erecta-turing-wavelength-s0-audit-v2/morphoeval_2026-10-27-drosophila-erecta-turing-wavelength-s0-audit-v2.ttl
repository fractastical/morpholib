<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-erecta-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Positive critical wavenumber exists only when delta * f_u exceeds |g_v| | Variables: Du, Dv, fu, fv, gu, gv, k; delta=16, fu=0.691, gv=-1.210" ;
    dct:source "Turing 1952 doi:10.1098/rstb.1952.0012" ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "h(k^2) = Du Dv k^4 - (Dv fu + Du gv) k^2 + (fu gv - fv gu)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/ncomms10400>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3183.fuMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3183.activator_inhibitor_ratio_above_turing_threshold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-erecta-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavelength at the 2.262 µm detail tier" ;
    dct:description "Eight detail wavelengths span the 18.096 µm patch | Variables: lambda_c = 2.262e-6 m, a=0.17, b=0.93, age_ma=0" ;
    dct:source "Schnakenberg 1979 doi:10.1016/0022-5193(79)90042-0" ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "lambda_c = 2 pi / k_c, k_c^2 = (Dv fu + Du gv) / (2 Du Dv)" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/ncomms10400>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3183.lambdaDetailNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3183.eight_detail_wavelengths_span_the_patch" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-erecta-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries wavenumber jump at fixed Holocene age" ;
    dct:description "Detail tier versus elegans and eugracilis primordium anchors | Variables: lambda_detail=2262 nm, lambda_elegans=101100 nm, lambda_eugracilis=100600 nm" ;
    dct:source "Yassin et al. 2016 doi:10.1038/ncomms10400" ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "44 < lambda_elegans / lambda_detail < 45, age = 0 Ma for elegans, erecta, and eugracilis" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1038/ncomms10400>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3183.lambdaElegansPrimordiumNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3183.wavenumber_jumps_about_fortyfive_fold" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


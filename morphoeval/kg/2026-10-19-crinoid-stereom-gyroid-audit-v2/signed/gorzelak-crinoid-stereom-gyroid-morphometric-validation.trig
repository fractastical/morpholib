        schema:measurementTechnique "1D horizontal DoG trabecular peak spacing across Panel K stereom scanlines (325 intervals, mean = 19.67 px at 0.752384 um/px)" ;
        schema:name "Crinoid ossicle SEM specimen segmented trabecular lattice period a_0 (crinoid_stereom_ossicle_specimen.jpg)" ;
        schema:unitText "um" ;
        schema:value "14.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-crinoid-ossicle-sem-specimen-segmented-trabecular-lattice-period-a-0-crinoid-stereom-ossicle-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-crinoid-ossicle-sem-specimen-segmented-trabecular-lattice-period-a-0-crinoid-stereom-ossicle-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Yang et al. (2022) Science 375:647-652 (echinoderm TPMS stereom lattice constant a_0 = 13.8-15.2 um)" ;
        schema:value "14.8" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-gibson-ashby-stretching-tpms-phi-1-vs-bending-foam-phi-2-stiffness-amplification-at-phi-0-50> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Gibson-Ashby stretching TPMS (phi^1) vs bending foam (phi^2) stiffness amplification at phi = 0.50 = 2.0 modulus ratio (E_stretch / E_bend)" ;
        dcterms:description "stretching E*/E_s(0.5) = 0.1900 vs equal-C bending foam = 0.0950" ;
        schema:measurementTechnique "Ratio of stretching-dominated TPMS relative modulus C*phi^1 to bending-dominated foam modulus C*phi^2 at 50% solid fraction" ;
        schema:name "Gibson-Ashby stretching TPMS (phi^1) vs bending foam (phi^2) stiffness amplification at phi = 0.50" ;
        schema:unitText "modulus ratio (E_stretch / E_bend)" ;
        schema:value "2.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-gibson-ashby-stretching-tpms-phi-1-vs-bending-foam-phi-2-stiffness-amplification-at-phi-0-50-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-gibson-ashby-stretching-tpms-phi-1-vs-bending-foam-phi-2-stiffness-amplification-at-phi-0-50-reference> a schema:PropertyValue ;
        dcterms:source "Gibson & Ashby (1997) Cellular Solids & Lean 4 theorem gibson_ashby_stretching_vs_bending_cellular_modulus_scaling" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schwarz-diamond-z-4-tetrahedral-inter-strut-angle-arccos-1-3-in-protoreaster-nodosus> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Schwarz Diamond Z=4 tetrahedral inter-strut angle arccos(-1/3) in Protoreaster nodosus = 109.4712 deg" ;

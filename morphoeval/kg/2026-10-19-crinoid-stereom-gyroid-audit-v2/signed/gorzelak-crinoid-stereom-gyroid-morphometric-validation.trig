sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-morphometric-validation> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-12-species-echinodermata-tpms-vs-labyrinthic-stereom-relative-modulus-correlation-e-e-s> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "12-species Echinodermata TPMS vs labyrinthic stereom relative modulus correlation E*/E_s = 0.9997 Pearson r" ;
        dcterms:description "TPMS mean E*/E_s = 0.1750 vs labyrinthic mean = 0.0647" ;
        schema:measurementTechnique "Correlation of Gibson-Ashby stretching (phi^1) and bending (phi^2) relative modulus predictions against observed stereom stiffness across 12 Asteroidea, Crinoidea, Echinoidea, and Ophiuroidea species (RMSE=0.0013)" ;
        schema:name "12-species Echinodermata TPMS vs labyrinthic stereom relative modulus correlation E*/E_s" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-12-species-echinodermata-tpms-vs-labyrinthic-stereom-relative-modulus-correlation-e-e-s-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-12-species-echinodermata-tpms-vs-labyrinthic-stereom-relative-modulus-correlation-e-e-s-reference> a schema:PropertyValue ;
        dcterms:source "Yang et al. (2022) Science 375:647-652 & Gibson & Ashby (1997) Cellular Solids" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-3d-schwarz-diamond-tpms-implicit-surface-mean-curvature-h-on-zero-level-set> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D Schwarz Diamond TPMS implicit-surface mean curvature H on zero level set = 0.0 dimensionless curvature |<H>|*a_0/(2*pi)" ;
        dcterms:description "mean Gaussian curvature <K> = -0.6769 <= 0, saddle fraction = 100.0%" ;
        schema:measurementTechnique "Surface-averaged implicit mean curvature H = -div(grad F / |grad F|)/2 on |F_D(X,Y,Z)| <= 0.18" ;
        schema:name "3D Schwarz Diamond TPMS implicit-surface mean curvature H on zero level set" ;
        schema:unitText "dimensionless curvature |<H>|*a_0/(2*pi)" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-3d-schwarz-diamond-tpms-implicit-surface-mean-curvature-h-on-zero-level-set-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-3d-schwarz-diamond-tpms-implicit-surface-mean-curvature-h-on-zero-level-set-reference> a schema:PropertyValue ;
        dcterms:source "Schoen (1970) NASA TN D-5541 & Lean 4 theorem tpms_minimal_surface_zero_mean_curvature_and_nonpositive_gaussian" ;
        schema:value "0.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-3d-schwarz-diamond-tpms-zero-level-set-solid-volume-fraction-phi-c-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D Schwarz Diamond TPMS zero-level-set solid volume fraction phi(c = 0) = 0.5 volume fraction" ;
        dcterms:description "Gyroid phi_G(0) = 0.5000, odd inversion residual = 1.55e-15" ;
        schema:measurementTechnique "Exact 3D unit-cell voxel fraction of F_D(X,Y,Z) > 0 at threshold c = 0 under odd inversion symmetry F(-X,-Y,-Z) = -F(X,Y,Z)" ;
        schema:name "3D Schwarz Diamond TPMS zero-level-set solid volume fraction phi(c = 0)" ;
        schema:unitText "volume fraction" ;
        schema:value "0.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-3d-schwarz-diamond-tpms-zero-level-set-solid-volume-fraction-phi-c-0-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-3d-schwarz-diamond-tpms-zero-level-set-solid-volume-fraction-phi-c-0-reference> a schema:PropertyValue ;
        dcterms:source "Yang et al. (2022) Science 375:647-652 & Lean 4 theorem tpms_odd_inversion_symmetry_and_half_volume_fraction_at_zero" ;
        schema:value "0.5" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-crinoid-ossicle-sem-specimen-segmented-solid-calcite-volume-fraction-crinoid-stereom-ossicle-specimen-jpg> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Crinoid ossicle SEM specimen segmented solid calcite volume fraction (crinoid_stereom_ossicle_specimen.jpg) = 0.5187 volume fraction" ;
        dcterms:description "Panel J periodic phi = 0.5473, Panel I labyrinthic phi = 0.3875" ;
        schema:measurementTechnique "Difference-of-Gaussians segmented solid calcite trabecular area fraction in Panel K [111] hexagonal stereom ROI" ;
        schema:name "Crinoid ossicle SEM specimen segmented solid calcite volume fraction (crinoid_stereom_ossicle_specimen.jpg)" ;
        schema:unitText "volume fraction" ;
        schema:value "0.5187" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-crinoid-ossicle-sem-specimen-segmented-solid-calcite-volume-fraction-crinoid-stereom-ossicle-specimen-jpg-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-crinoid-ossicle-sem-specimen-segmented-solid-calcite-volume-fraction-crinoid-stereom-ossicle-specimen-jpg-reference> a schema:PropertyValue ;
        dcterms:source "Yang et al. (2022) Science 375:647-652 (bicontinuous TPMS stereom phi ~ 0.50)" ;
        schema:value "0.5" .


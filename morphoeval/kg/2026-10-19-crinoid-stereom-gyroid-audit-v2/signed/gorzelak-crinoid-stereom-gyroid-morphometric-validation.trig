        schema:name "Schwarz Diamond Z=4 tetrahedral inter-strut angle arccos(-1/3) in Protoreaster nodosus" ;
        schema:unitText "deg" ;
        schema:value "109.4712" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schwarz-diamond-z-4-tetrahedral-inter-strut-angle-arccos-1-3-in-protoreaster-nodosus-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-schwarz-diamond-z-4-tetrahedral-inter-strut-angle-arccos-1-3-in-protoreaster-nodosus-reference> a schema:PropertyValue ;

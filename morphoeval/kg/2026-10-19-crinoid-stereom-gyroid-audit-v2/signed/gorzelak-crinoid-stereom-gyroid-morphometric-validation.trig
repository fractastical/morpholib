        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-super-threshold-pinch-off-ablation-negative-control-nodal-strut-valence-c-1-35-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-super-threshold-pinch-off-ablation-negative-control-nodal-strut-valence-c-1-35-reference> a schema:PropertyValue ;

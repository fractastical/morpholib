    <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P) & Gibson-Ashby cellular mechanics — Morphometric validation: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Extracts 9 reference-anchored morphometrics in `measure_morphoeval()` (L945-1052), including 12-species Echinodermata relative modulus correlation (`r = 0.9997`, `RMSE = 0.0012`), 3D Diamond zero-level-set volume fraction (`0.5000`), surface-averaged mean curvature (`|<H>| = 0.0000`), Diamond tetrahedral inter-strut angle (`109.4712 deg`), unit-cell Euler characteristic (`chi = -4.0`), Gibson–Ashby stiffness ratio at `phi = 0.50` (`2.0x`), pinch-off ablation strut valence (`0.0`), and crinoid SEM specimen solid fraction (`0.5187`) and trabecular lattice period (`14.8000 um`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-measurement-12-species-echinodermata-tpms-vs-labyrinthic-stereom-relative-modulus-correlation-e-e-s>,

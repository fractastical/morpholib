        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py#L1125-L1158> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P) & Gibson-Ashby cellular mechanics — Parameter expressivity: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates all 5 Echinodermata stereom TPMS and ablation regimes (`Diamond_D`, `Gyroid_G`, `Primitive_P`, `Labyrinthic_spinodal`, `pinchoff_disconnected_ablation`), sweeps level-set threshold `c` across `[-0.80, 0.80]`, evaluates 12 species across Asteroidea, Crinoidea, Echinoidea, and Ophiuroidea, and exposes `--a0`, `--c-thresh`, `--e-calcite`, `--n-grid`, `--seed`, and `--skip-gif` CLI overrides (L1125-1158)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-parameter-expressivity-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

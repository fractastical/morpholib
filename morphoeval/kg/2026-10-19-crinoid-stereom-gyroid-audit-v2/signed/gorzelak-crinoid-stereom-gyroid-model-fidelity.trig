sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P) & Gibson-Ashby cellular mechanics — Model fidelity to source: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements 3D nodal level-set potentials and analytical/finite-difference implicit-surface mean curvature H and Gaussian curvature K (`evaluate_tpms_field_and_curvature_3d`, L215-399) across Diamond D (Z=4, 109.4712 deg), Gyroid G (Z=3, 120 deg), Primitive P (Z=6, 90 deg), Cahn–Hilliard spinodal labyrinthic foam, and pinch-off ablation (c=1.35), plus crystallographic [111] vs [100] projections and edge dislocations (`evaluate_crystallographic_projections_and_dislocations`, L458-514) and Gibson–Ashby stretching vs bending mechanics (L520-599). Backed by 4 machine-checked Lean 4 theorems in `Loop_079_crinoid_stereom_gyroid.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2020-gorzelak-crinoid-stereom-gyroid.py L130–L399" ;
        dcterms:description "3D TPMS nodal strut algebra and 3D implicit-surface mean/Gaussian curvature solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py#L130-L399> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2020-gorzelak-crinoid-stereom-gyroid.py L458–L599" ;
        dcterms:description "Crystallographic [111]/[100] projections, edge dislocations, and Gibson-Ashby scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py#L458-L599> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean L27–L263" ;
        dcterms:description "4 Lean 4 theorems proving H=0 saddle K<=0, odd inversion phi(0)=1/2, Diamond Z=4 cos=-1/3 & chi=-4, and Gibson-Ashby phi^1 vs phi^2 scaling" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_079_crinoid_stereom_gyroid.lean#L27-L263> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


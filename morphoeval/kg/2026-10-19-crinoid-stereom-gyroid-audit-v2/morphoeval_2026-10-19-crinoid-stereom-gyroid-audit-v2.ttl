<https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P) & Gibson-Ashby cellular mechanics — Reproducibility package: 91/100" ;
    dct:date "2026-10-19"^^xsd:date ;

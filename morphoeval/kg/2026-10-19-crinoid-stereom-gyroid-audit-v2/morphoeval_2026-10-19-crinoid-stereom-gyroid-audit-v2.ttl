        <https://w3id.org/probknow/resource/evidence/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity-3> ;
    pk:hasScore 9.3e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-morphometric-validation> a pk:LLMClaimAssessment ;

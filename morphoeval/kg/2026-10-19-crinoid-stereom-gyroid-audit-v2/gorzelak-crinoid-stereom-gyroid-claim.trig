sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-gorzelak-crinoid-stereom-gyroid> a pk:Claim ;
        rdfs:label "Yang et al. (2022) & Donnay & Pawson (1969) biogenic single-crystal calcite TPMS echinoderm stereom (Diamond D, Gyroid G, Primitive P) & Gibson-Ashby cellular mechanics faithfully reproduces Protoreaster nodosus (Asteroidea) & Metacrinus rotundus / Nesometra integra (Crinoidea) / Cidaris rugosa (Echinoidea) morphology" ;
        dct:description "The simulation script(s) 2020-gorzelak-crinoid-stereom-gyroid.py implement the cited source model as published and produce forms that match real Protoreaster nodosus (Asteroidea) & Metacrinus rotundus / Nesometra integra (Crinoidea) / Cidaris rugosa (Echinoidea) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.7/100, audit 2026-10-19-crinoid-stereom-gyroid-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py; output: docs/media/crinoid_stereom_gyroid_comparison.png; organism: Protoreaster nodosus (Asteroidea) & Metacrinus rotundus / Nesometra integra (Crinoidea) / Cidaris rugosa (Echinoidea); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 7546780a29581d038c82edc49698f8e73b11c59c0a49d82e3dfc8f721733c9d2; artifact_sha256: fa3a3bc5ea25717ac454178df9ad65455f74bccd7674102eb3fea9f9b83ffe0e; input_dataset_sha256: {datasets/crinoid_stereom_gyroid/crinoid_stereom_gyroid_reference.json=c1c3848ef15d0bfc..., datasets/crinoid_stereom_gyroid/crinoid_stereom_ossicle_specimen.jpg=5fbf6e4db0ee1d44..., datasets/crinoid_stereom_gyroid/scout_manifest.json=0524b76e141ef1fe...}; supersedes_audit_id: 2026-10-19-crinoid-stereom-gyroid-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1017/CBO9781139878326>,
            <https://doi.org/10.1063/1.1665587>,
            <https://doi.org/10.1126/science.166.3909.1147>,
            <https://doi.org/10.1126/science.abm8666> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-gorzelak-crinoid-stereom-gyroid-specimen-match> ;
        pk:weightOfEvidence "0.917"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/HEAD/2020-gorzelak-crinoid-stereom-gyroid.py> a schema:SoftwareSourceCode ;
        rdfs:label "2020-gorzelak-crinoid-stereom-gyroid.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "HEAD" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L1–L76" ;
        dcterms:description "Module docstring: laws 1-5 with Lean theorem names, the reduced-model disclaimers for laws 4-5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L1-L76> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L612–L626" ;
        dcterms:description "Section 4b header: what v2 asked, what is implemented, what is reduced, which parameters are assumptions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L612-L626> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/he-drosophila-ventral-furrow.yaml L1–L137" ;
        dcterms:description "5 equations with lean_decl/lean_theorem/lean_locus/code_locus; Pass 3 parameters in model_spec" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/math_kg_loops/he-drosophila-ventral-furrow.yaml#L1-L137> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Code-to-model traceability: 92/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-76) states all five governing laws with their Lean theorem names, each new section carries a header explaining what was asked, what was implemented and what is reduced (L612-626, L846-854), every new function docstring cites its equation and source, and the math KG loop file registers both new equations with lean_locus and code_locus ranges that match the current files. Deductions: the regime block does not state in code that its targets are the reference values being measured against (-4); the Stokes operator derivation is explained in a comment rather than referenced to a textbook equation number (-2); the GIF code (L1767-1842) does not mention the new mechanisms (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2012-he-drosophila-ventral-furrow.py L332–L369: Regime targets are not annotated as the audited reference values <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L332-L369>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-code-traceability-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Morphological realism / specimen match: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Unchanged from v2 for the confocal layer: the CC BY 4.0 4-stage transverse micrograph is vendored, SHA-256-verified and automatically segmented (DV/ML 1.0496 -> 0.9217, Delta h = 42 px, MyoII 1.63x, trajectory r = 0.9993) and shown with bounding boxes in Panel F. New Panel G renders the reduced 3D shell with the ventral furrow strip tapering toward both poles, qualitatively matching the dorsal/lateral views of a gastrulating embryo, and Panel I shows the He et al. (2014)-style basal cytoplasmic flow. Deductions: no side-by-side with a longitudinal (sagittal/ventral) micrograph for the new AP profile, so the 0.59 EL extent is compared to a literature number rather than a specimen (-5); the Stokes panel is compared to no image of nuclear positions (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-specimen-match-3> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L1086–L1193" ;
        dcterms:description "Automated 4-stage confocal cross-section segmentation and apical Myosin-II red enrichment analysis (unchanged)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L1086-L1193> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L1651–L1679" ;
        dcterms:description "Panel G: theta x z shell mesh surface coloured by inward displacement, ventral view" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L1651-L1679> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_ventral_furrow_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: Panels A-F as in v2 plus G (3D shell), H (AP profile sweeps), I (Stokes flow with nucleus); specimen boxes and morphometrics visible in Panel F — docs/media/drosophila_ventral_furrow_comparison.png: rendered output of 2012-he-drosophila-ventral-furrow.py at 7e4f207, image/png, 1096884 B, 2436×2156 px, artifact_sha256 1fc501631ab9c6ab13eaf2ac9a771c53029337b6fdb3ddd5880ed8f4211d9a76 (sha256 1fc501631ab9c6ab13eaf2ac9a771c53029337b6fdb3ddd5880ed8f4211d9a76), spec_fingerprint 231d3bda8cca542298a1fb5749dc44c894794b8e0ed35252a225b4a9fa7bd0aa" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Reproducibility package: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`--self-test` passes in ~11 s with 6 check blocks (SHA-256 locks for 4 files, Theorems 1-5 numerics, 6-regime hierarchy, bitwise determinism of the ring and of the Stokes solve, specimen CV, 12 measurements); the default render (PNG + 24-frame GIF) takes ~5 s; the GIF regenerates byte-identically to the v2 artifact (SHA-256 5988ec19...); the only RNG is seeded and unused. Deductions: no requirements lock file for this slot (-3); the PNG byte-identity across runs is not asserted in the self-test (-2); MPLCONFIGDIR must be writable, which is not documented (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L1845–L1937" ;
        dct:description "Self-test: 4 SHA locks, Theorem 1-3 checks, Pass 3 Theorem 4-5 checks, determinism, specimen CV, 12 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L1845-L1937> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L1910–L1935" ;
        dct:description "Stokes determinism asserted across two independent WT simulations" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L1910-L1935> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_ventral_furrow_growth.gif (generated output)" ;
        dct:description "24-frame GIF byte-identical to the v2 artifact (unchanged code path) — docs/media/drosophila_ventral_furrow_growth.gif: rendered output of 2012-he-drosophila-ventral-furrow.py at 7e4f207, image/gif, 1106104 B, 1407×472 px, 24 frames, artifact_sha256 5988ec19429f583323930674a6aa190383a5deb0f695af2238244a09febef761 (sha256 5988ec19429f583323930674a6aa190383a5deb0f695af2238244a09febef761), spec_fingerprint 231d3bda8cca542298a1fb5749dc44c894794b8e0ed35252a225b4a9fa7bd0aa" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


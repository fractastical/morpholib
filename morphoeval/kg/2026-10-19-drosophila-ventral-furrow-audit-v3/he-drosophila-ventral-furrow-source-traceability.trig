sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Source and data traceability: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Four SHA-256-pinned dataset files (the new `ap_shell_stokes_reference.json` is pinned at L102-116 and verified at runtime), bib extended with Sweeton 1991, Leptin & Grunewald 1990, Lye 2015, and the dataset README documents the two new laws and the Pass 3 caveats. Deductions: the three new DOIs could not be re-verified offline and are flagged as such (-4); the mesoderm extent (0.15-0.80 EL), reference furrow span (0.65 EL) and GBE onset are approximate, un-digitised literature values (-4); ell_B and the WT ell_N ramp have no source at all and are declared model assumptions (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/drosophila_ventral_furrow/paper_citations.bib L45–L83: Pass 3 BibTeX additions with usage notes; DOIs not re-verified offline <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/drosophila_ventral_furrow/paper_citations.bib#L45-L83>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-source-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L102–L135" ;
        dct:description "EXPECTED_SHA256 with 4 pinned files incl. ap_shell_stokes_reference.json; verify_dataset_integrity fails closed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L102-L135> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_ventral_furrow/ap_shell_stokes_reference.json L1–L80" ;
        dct:description "Parameter table with per-source doi_verified_offline flags and approximate-value notes" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/drosophila_ventral_furrow/ap_shell_stokes_reference.json#L1-L80> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/drosophila_ventral_furrow/README.md L25–L50" ;
        dct:description "Laws 4-5, new file digest, and Pass 3 caveats section" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/datasets/drosophila_ventral_furrow/README.md#L25-L50> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


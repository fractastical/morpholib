        schema:measurementTechnique "Integrated 64-cell Conte et al. (2012) incompressible viscous-vertex ring with synergistic apical constriction + basal relaxation + lateral shortening + ectodermal pushing and Martin et al. (2009) Twist ratchet (r_twist = 1.0)" ;
        schema:name "wild-type synergistic ventral furrow invagination depth D_furrow" ;
        schema:unitText "um" ;
        schema:value "41.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-wild-type-synergistic-ventral-furrow-invagination-depth-d-furrow-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-wild-type-synergistic-ventral-furrow-invagination-depth-d-furrow-reference> a schema:PropertyValue ;
        dct:source "Conte, Munoz, Baum & Miodownik (2012) PLoS ONE 7(11):e49973 Fig. 5" ;
        schema:value "41.0" .

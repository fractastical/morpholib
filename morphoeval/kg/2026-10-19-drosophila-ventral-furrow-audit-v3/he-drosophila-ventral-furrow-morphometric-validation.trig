        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Morphometric validation: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` now returns 12 measurements (L1196-1416). New in Pass 3: D_3D(0.5 EL) = 39.92 um vs 41.0 ref (coupling ratio 0.974), furrow half-depth extent 0.590 EL vs ~0.65 ref, ell_N ablation ratio 0.534 (no empirical reference, stated as such), Stokes passive-tracer ratio 0.983 vs 1.0 (He 2014), and the exact-solution verification 8.1e-13 vs 0. Deductions: the 6-regime depth/height r = 1.0000 and RMSE = 0 (measurement 3) are circular because the regimes are pinned to the reference values (-8, newly exposed); the 0.65 EL and ~1.0 tracer references are approximate literature statements rather than digitised values (-4); no error bars or sensitivity of the new measurements to ell_B / nucleus geometry (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2012-he-drosophila-ventral-furrow.py L1249–L1264: 6-regime Pearson r measurement is computed against the same reference values the regimes are pinned to <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L1249-L1264>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-3d-shell-coupled-wt-furrow-depth-at-50-egg-length-d-3d-0-5-el>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-6-regime-invagination-depth-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-apical-constriction-only-shallow-groove-depth-d-ap-only>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-germband-extension-tension-ablation-ratio-d-3d-ell-n-150-um-d-3d-ell-n-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-specimen-4-stage-invagination-trajectory-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-specimen-stage-4-invaginated-dv-ml-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-stokes-resolved-nucleus-cytoplasm-basal-velocity-ratio-passive-tracer>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-stokes-solver-verification-affine-lengthening-exact-solution-l2-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-twist-snail-double-null-negative-control-invagination-depth>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-unratcheted-twist-recoil-mutant-apical-width-l-ap>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-ventral-furrow-ap-half-depth-extent-fraction-of-egg-length>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-wild-type-synergistic-ventral-furrow-invagination-depth-d-furrow>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-morphometric-validation-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-3d-shell-coupled-wt-furrow-depth-at-50-egg-length-d-3d-0-5-el> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "3D-shell-coupled WT furrow depth at 50% egg length D_3D(0.5 EL) = 39.9183 um" ;
        dct:description "D_3D/D_2D coupling ratio = 0.9736; AP-curvature pole stiffening k_pole/k_eq = 13.4x, k_rel at mesoderm edges = 1.82/1.49; reduced 1D-line + kinematic sweep (5265 shell nodes), not a 3D FEM" ;
        schema:measurementTechnique "Donnell/Winkler shell line equation ell_B^4 D'''' - ell_N^2 D'' + k_rel(z) D = D_2D chi_meso(z) along the AP axis of the prolate ellipsoid (a = 250 um, b = 83.2 um), driven by the 2D ring depth at every snapshot with the germband-extension tension ramp (ell_N 0 -> 30 um from t = 9 min)" ;
        schema:name "3D-shell-coupled WT furrow depth at 50% egg length D_3D(0.5 EL)" ;
        schema:unitText "um" ;
        schema:value "39.9183" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-3d-shell-coupled-wt-furrow-depth-at-50-egg-length-d-3d-0-5-el-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-3d-shell-coupled-wt-furrow-depth-at-50-egg-length-d-3d-0-5-el-reference> a schema:PropertyValue ;
        dct:source "Conte, Munoz, Baum & Miodownik (2012) PLoS ONE 7(11):e49973 Fig. 5 (2D transverse section at mid-furrow)" ;
        schema:value "41.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-6-regime-invagination-depth-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "6-regime invagination depth Pearson correlation r = 1.0 correlation_r" ;
        dct:description "depth RMSE = 0.000 um (p = 0.000e+00); cell height r = 1.0000 (RMSE = 0.000 um); apical width r = 0.9992" ;
        schema:measurementTechnique "Pearson correlation across all 6 Conte et al. (2012) & Martin et al. (2009) regimes (WT Synergy, Apical+Basal, Apical-Only, cta Mutant, Unratcheted Recoil, twist;snail Null)" ;
        schema:name "6-regime invagination depth Pearson correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-6-regime-invagination-depth-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-6-regime-invagination-depth-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Conte et al. (2012) PLoS ONE 7:e49973 Figs. 3-6; Martin et al. (2009) Nature 457:495-499" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-apical-constriction-only-shallow-groove-depth-d-ap-only> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "apical-constriction-only shallow groove depth D_ap_only = 16.5 um" ;
        dct:description "incompressible apicobasal cell lengthening h = 48.10 um (ref 48.1 um vs initial h_0 = 32.0 um), area rel error = 0.000000" ;
        schema:measurementTechnique "Conte et al. (2012) apical constriction alone without basal relaxation or lateral shortening (phi_ap = 1, phi_ba = 0, phi_lat = 0)" ;
        schema:name "apical-constriction-only shallow groove depth D_ap_only" ;
        schema:unitText "um" ;
        schema:value "16.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-apical-constriction-only-shallow-groove-depth-d-ap-only-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-apical-constriction-only-shallow-groove-depth-d-ap-only-reference> a schema:PropertyValue ;
        dct:source "Conte, Munoz, Baum & Miodownik (2012) PLoS ONE 7(11):e49973 Fig. 3" ;
        schema:value "16.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-germband-extension-tension-ablation-ratio-d-3d-ell-n-150-um-d-3d-ell-n-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "germband-extension tension ablation ratio D_3D(ell_N = 150 um) / D_3D(ell_N = 0) = 0.5337 dimensionless" ;
        dct:description "D(0.5 EL) over the sweep = [40.97, 40.3, 37.55, 33.54, 29.33, 25.38, 21.87] um (monotone decreasing: True); no empirical reference recorded: the N_GB magnitude is not calibrated to Lye et al. (2015) ablation recoil (open Pass 4 item); aspect-ratio sweep a/b = [1.5, 2.0, 2.5, 3.0, 3.5, 4.0] gives pole stiffening [3.6, 6.7, 10.0, 13.4, 16.6, 19.6]x" ;
        schema:measurementTechnique "AP shell line equation at the final WT 2D depth swept over the germband-extension tension length ell_N in [np.float64(0.0), np.float64(25.0), np.float64(50.0), np.float64(75.0), np.float64(100.0), np.float64(125.0), np.float64(150.0)] um; ratio of midline depth at max vs zero tension" ;
        schema:name "germband-extension tension ablation ratio D_3D(ell_N = 150 um) / D_3D(ell_N = 0)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.5337" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-specimen-4-stage-invagination-trajectory-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen 4-stage invagination trajectory correlation r = 0.9993 correlation_r" ;
        dct:description "p = 7.174e-04, mesoderm area internalization fraction = 0.1436 (ref 0.1458)" ;
        schema:measurementTechnique "Pearson correlation between simulated ventral furrow invagination trajectory and 4-stage confocal specimen dorsoventral compression" ;
        schema:name "specimen 4-stage invagination trajectory correlation r" ;
        schema:unitText "correlation_r" ;
        schema:value "0.9993" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-specimen-4-stage-invagination-trajectory-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-specimen-4-stage-invagination-trajectory-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Confocal 4-stage transverse time-series in drosophila_ventral_furrow_specimen.jpg (Panel B)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-specimen-stage-4-invaginated-dv-ml-aspect-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen Stage 4 invaginated DV/ML aspect ratio = 0.9217 dimensionless" ;
        dct:description "4-stage DV/ML progression: 1.0496 -> 1.0291 -> 0.9620 -> 0.9217 (DV compression = 42.0 px, ventral Myosin-II red enrichment = 1.632x)" ;
        schema:measurementTechnique "Automated connected-component segmentation across the 4 transverse confocal stages in Panel B of drosophila_ventral_furrow_specimen.jpg" ;
        schema:name "specimen Stage 4 invaginated DV/ML aspect ratio" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9217" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-specimen-stage-4-invaginated-dv-ml-aspect-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-specimen-stage-4-invaginated-dv-ml-aspect-ratio-reference> a schema:PropertyValue ;
        dct:source "Confocal transverse cross-section Stage 4 of Drosophila melanogaster ventral furrow (drosophila_ventral_furrow_specimen.jpg, CC BY 4.0)" ;
        schema:value "0.9239" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-stokes-resolved-nucleus-cytoplasm-basal-velocity-ratio-passive-tracer> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Stokes-resolved nucleus / cytoplasm basal velocity ratio (passive tracer) = 0.9826 dimensionless" ;
        dct:description "nucleus rigid-body CV = 0.0216; max cytoplasmic perturbation by the nucleus = 0.079 x basal speed; Phase-I nuclear basal displacement = 4.50 um vs cell lengthening 14.01 um (ratio 0.321); fixed rectangular domain, no cortical stress BC" ;
        schema:measurementTechnique "2D variable-viscosity Stokes solve (stream-function form, 35x192 grid, 5828 unknowns) inside the WT mesoderm cell at the instant of maximal Phase-I lengthening rate (t = 1.83 min; w_ap = 7.34 um, h = 38.19 um, h' = 0.0661 um/s); mean basal velocity of a 50x-viscosity elliptical nucleus divided by the nucleus-free flow at its centre" ;
        schema:name "Stokes-resolved nucleus / cytoplasm basal velocity ratio (passive tracer)" ;
        schema:unitText "dimensionless" ;
        schema:value "0.9826" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-stokes-resolved-nucleus-cytoplasm-basal-velocity-ratio-passive-tracer-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-stokes-resolved-nucleus-cytoplasm-basal-velocity-ratio-passive-tracer-reference> a schema:PropertyValue ;
        dct:source "He, Doubrovinski, Polyakov & Wieschaus (2014) Nature 508:392-396 Fig. 2 (nuclei move with the cytoplasm)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-stokes-solver-verification-affine-lengthening-exact-solution-l2-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Stokes solver verification: affine-lengthening exact-solution L2 error = 8.089e-13 relative_L2" ;
        dct:description "boundary flux closure error = 2.78e-16 um^2/s; interior discrete divergence of the trapezoid-driven field = 1.829e-14 x (h'/h)" ;
        schema:measurementTechnique "Uniform-viscosity solve with affine boundary data (w' = -w h'/h) compared with the exact stream function psi = eps x (h - y), eps = h'/h (Theorem 5, affine_lengthening_flow_divergence_free_and_basalward)" ;
        schema:name "Stokes solver verification: affine-lengthening exact-solution L2 error" ;
        schema:unitText "relative_L2" ;
        schema:value "8.089e-13" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-stokes-solver-verification-affine-lengthening-exact-solution-l2-error-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-stokes-solver-verification-affine-lengthening-exact-solution-l2-error-reference> a schema:PropertyValue ;
        dct:source "Exact Stokes solution (polynomial of degree 2 is reproduced exactly by central differences)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-twist-snail-double-null-negative-control-invagination-depth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "twist;snail double-null negative control invagination depth = 0.0 um" ;
        dct:description "unconstricted apical width w_ap = 8.20 um, cell height h = 32.00 um" ;
        schema:measurementTechnique "Negative control with complete ablation of active Myosin-II pulses (phi_ap = 0)" ;
        schema:name "twist;snail double-null negative control invagination depth" ;
        schema:unitText "um" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-twist-snail-double-null-negative-control-invagination-depth-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-twist-snail-double-null-negative-control-invagination-depth-reference> a schema:PropertyValue ;
        dct:source "Martin et al. (2009) Nature 457:495-499 Fig. 3; Conte et al. (2012) PLoS ONE 7:e49973" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-unratcheted-twist-recoil-mutant-apical-width-l-ap> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "unratcheted twist recoil mutant apical width L_ap = 7.2915 um" ;
        dct:description "recoil furrow depth = 3.80 um (ref 3.8 um)" ;
        schema:measurementTechnique "Simulated Martin et al. (2009) unratcheted myosin pulses (r_twist = 0.0) with inter-pulse elastic relaxation recoil" ;
        schema:name "unratcheted twist recoil mutant apical width L_ap" ;
        schema:unitText "um" ;
        schema:value "7.2915" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-unratcheted-twist-recoil-mutant-apical-width-l-ap-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-unratcheted-twist-recoil-mutant-apical-width-l-ap-reference> a schema:PropertyValue ;
        dct:source "Martin, Kaschube & Wieschaus (2009) Nature 457:495-499 Fig. 3" ;
        schema:value "7.1" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-ventral-furrow-ap-half-depth-extent-fraction-of-egg-length> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ventral furrow AP half-depth extent (fraction of egg length) = 0.59 egg_length_fraction" ;
        dct:description "D_max = 39.92 um; furrow tapers toward the doubly curved poles because k_rel rises from 1.0 at 50% EL to 1.82 at the posterior mesoderm edge" ;
        schema:measurementTechnique "Fraction of the AP axis where the 3D-shell furrow profile D(z) >= 0.5 D_max at the end of the WT run (mesoderm primordium load chi_meso over EL 0.15-0.80)" ;
        schema:name "ventral furrow AP half-depth extent (fraction of egg length)" ;
        schema:unitText "egg_length_fraction" ;
        schema:value "0.59" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-ventral-furrow-ap-half-depth-extent-fraction-of-egg-length-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-ventral-furrow-ap-half-depth-extent-fraction-of-egg-length-reference> a schema:PropertyValue ;
        dct:source "Approximate mesoderm primordium / furrow span, Leptin & Grunewald (1990) Development 110:73-84; Sweeton et al. (1991) Development 112:775-789 (not digitised; DOIs unverified offline)" ;
        schema:value "0.65" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-measurement-wild-type-synergistic-ventral-furrow-invagination-depth-d-furrow> a schema:PropertyValue,

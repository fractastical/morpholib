        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Parameter expressivity: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The 6-regime evaluator and the 15x15 (r_twist x sigma_synergy) morphospace are retained, and Pass 3 adds two genuine physical sweep axes with monotone, theorem-backed behaviour: germband-extension tension ell_N in {0, 25, ..., 150} um reduces D(0.5 EL) monotonically from 41.0 to 21.9 um (ablation ratio 0.534; Theorem 4) and lengthens the half-depth extent, and egg aspect ratio a/b in {1.5, ..., 4.0} raises the polar stiffening ratio monotonically. Deductions: the 15x15 morphospace is still an analytic surrogate rather than re-running the ring (L578-624) (-4); the nucleus viscosity ratio and position are not swept (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2012-he-drosophila-ventral-furrow.py L578–L624: 15x15 morphospace is an analytic surrogate (ap_factor, d_val, h_val) rather than ring re-simulation <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L578-L624>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L795–L852" ;
        dct:description "sweep_ap_shell_parameters: ell_N and a/b sweeps with monotonicity flag and ablation ratio" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L795-L852> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L1680–L1706" ;
        dct:description "Panel H renders the ell_N family of AP profiles, the WT coupled run, the mesoderm load and k_rel(z)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L1680-L1706> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L1889–L1908" ;
        dct:description "Self-test asserts monotone decrease with ell_N, ablation < 0.8, and monotone pole stiffening with a/b" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L1889-L1908> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


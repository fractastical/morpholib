sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-he-drosophila-ventral-furrow> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-model-fidelity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-he-drosophila-ventral-furrow-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Conte et al. (2012), Martin et al. (2009) & He et al. (2014) Drosophila ventral furrow invagination biomechanics — Model fidelity to source: 87/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: exact incompressible wedge geometry and RK2 ratcheted-pulse ODE (L153-249), the new AP shell line equation with exact ellipsoid curvatures, simply supported poles and a verified second-order stencil (L627-719; uncoupled run recovers the 2D depth to 0.1% at 50% EL), the new variable-viscosity Stokes operator derived by taking the curl of div(sigma) = 0 with exact boundary-flux closure and an exact-solution check to 1e-12 (L855-1003), and 5 Lean theorems (0 sorrys) pinning Theorems 1-5. Deductions: the regime depth and cell height in the 2D ring are prescribed interpolants pinned to the reference values at the last step (L332-369, L443-445, L455-458) rather than solved from the viscous-vertex force balance, so the Conte (2012) decomposition is reproduced by construction (-7, newly exposed); the AP coupling is a 1D line + kinematic sweep, not a 3D FE shell, and ell_B / ell_N are free parameters (-3); the Stokes domain is a fixed rectangle with velocity BCs rather than a moving trapezoid with cortical stress BCs (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2012-he-drosophila-ventral-furrow.py L332–L369: Regime block hard-codes target_ap_um / target_h_um / target_depth_um equal to the empirical reference values <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L332-L369>",
            "2012-he-drosophila-ventral-furrow.py L443–L458: h_mean = target_h_um and depth_um = target_depth_um forced at the last step; depth is an interpolant of constr_frac and prog, not a mechanical solve <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L443-L458>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-4> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L153–L249" ;
        dct:description "Incompressible wedge geometry, basal width inversion, and RK2 ratcheted pulse ODE convergence (unchanged, verified)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L153-L249> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L627–L719" ;
        dct:description "Exact ellipsoid principal curvatures and the Donnell/Winkler AP line equation solver with ghost-node simply supported poles" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L627-L719> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2012-he-drosophila-ventral-furrow.py L855–L1003" ;
        dct:description "Variable-viscosity Stokes stream-function operator, boundary flux line integral, two-layer Dirichlet closure, sparse direct solve, divergence and affine checks" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/2012-he-drosophila-ventral-furrow.py#L855-L1003> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-he-drosophila-ventral-furrow-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean L145–L242" ;
        dct:description "Theorems 4-5 (modal stiffness monotonicity; discrete divergence-free basal-ward affine flow), 0 sorrys, verified with lean" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/7e4f207/morphoeval/lean/loops/Loop_046_drosophila_ventral_furrow.lean#L145-L242> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


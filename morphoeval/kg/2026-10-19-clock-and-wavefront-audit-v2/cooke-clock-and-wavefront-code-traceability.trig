sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Code-to-model traceability: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Every computational section and docstring maps directly to numbered sections and figures in Cooke & Zeeman (1976) Sections 2-5 and Figs. 2-4, Cooke (1975) Table 1, and the 3 Lean 4 theorems in `Loop_021_clock_and_wavefront.lean` and `morphoeval/math_kg_loops/cooke-clock-and-wavefront.yaml`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L1–L50" ;
        dct:description "Module docstring linking equations to Cooke & Zeeman (1976), Cooke (1975), and Lean 4 theorems" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py#L1-L50> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/cooke-clock-and-wavefront.yaml L1–L61" ;
        dct:description "Math KG loop specification linking equations, Lean 4 declarations, and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/math_kg_loops/cooke-clock-and-wavefront.yaml#L1-L61> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/1> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1002/dvdy.21193>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(00)80451-1>,
            <https://doi.org/10.1038/254196a0> .
    <https://doi.org/10.1002/dvdy.21193> dct:date "2007"^^xsd:gYear ;
        dct:title "Sharp developmental thresholds defined through bistability by antagonistic gradients of retinoic acid and FGF signaling" .
    <https://doi.org/10.1016/S0022-5193(76)80131-2> dct:date "1976"^^xsd:gYear ;
        dct:title "A clock and wavefront model for control of the number of repeated structures during animal morphogenesis" .
    <https://doi.org/10.1016/S0092-8674(00)80451-1> dct:date "1997"^^xsd:gYear ;
        dct:title "Avian hairy gene expression identifies a molecular clock linked to vertebrate segmentation and somitogenesis" .
    <https://doi.org/10.1038/254196a0> dct:date "1975"^^xsd:gYear ;
        dct:title "Control of somite number during morphogenesis of a vertebrate, Xenopus laevis" .
}


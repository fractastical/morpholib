    pk:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Morphometric validation: 90/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L322-395): simulated somite wavelength S_sim = 100.13 um vs analytical 100.0 um (0.13% error, CV = 0.0025), miniature-to-normal somite count invariance ratio 1.0000 vs Cooke (1975) 0.9851, clock-doubled vs clock-arrested somite delta (20 vs 0 somites), bilateral SEM specimen somite spacing 48.47 +/- 9.69 px (CV = 0.1999, symmetry ratio = 0.9605), and 5-regime Cooke (1975) somite count RMSE = 0.2898 somites (Pearson r = 0.9995, p = 1.44e-5)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-clock-doubled-perturbation-2x-t-c-vs-clock-arrested-ablation-control-somite-count-delta>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-cooke-1975-5-regime-somite-count-prediction-rmse>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-miniature-operated-xenopus-embryo-60-length-somite-count-n-mini-vs-normal-n-norm-size-invariance-ratio>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-normal-xenopus-somite-wavelength-s-sim-vs-analytical-s-v-t-c>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L115–L142" ;
        dcterms:description "5-regime Cooke (1975) size-regulation and clock/wavefront perturbation evaluator" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py#L115-L142> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "1976-cooke-clock-and-wavefront.py L445–L495" ;
        dcterms:description "2D (v, T_c) morphospace contour surface and proportional vs unscaled wavefront sweep" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py#L445-L495> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation — Parameter expressivity: 89/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates 5 experimental regimes from Cooke (1975) and Cooke & Zeeman (1976) (normal 4.0 mm, reduced 3.0 mm, miniature 2.4 mm, 2x clock period T_c=90 min, and 1.5x wavefront velocity), maps the continuous 2D parameter morphospace S(v, T_c) = v * T_c across v in [1.0, 3.6] um/min and T_c in [25, 100] min (Panel C), compares proportional wavefront scaling (v ~ L) against an unscaled wavefront failure control (v = v_0, Panel D), and includes a clock-arrested ablation control (A_clock = 0 -> 0 somites, Panel B) plus CLI flags (`--L-mm`, `--Tc-min`, `--T-total-min`, `--seed`)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-cooke-clock-and-wavefront-parameter-expressivity-2> ;
        pk:hasScore "0.89"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-cooke-clock-and-wavefront> a pk:Claim ;
        rdfs:label "Cooke & Zeeman (1976) clock-and-wavefront somite segmentation faithfully reproduces Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites morphology" ;
        dcterms:description "The simulation script(s) 1976-cooke-clock-and-wavefront.py implement the cited source model as published and produce forms that match real Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 90.1/100, audit 2026-10-19-clock-and-wavefront-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py; output: docs/media/clock_and_wavefront_comparison.png; organism: Xenopus laevis & Gallus gallus vertebrate paraxial mesoderm somites; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 9a567843f2a6020e93562e6d7e58c2b8167adcb8c6b198fb2164e03a085e6bb6; artifact_sha256: 1db23a76c4cc9d4544515fc51d9b8e774a6986c84596f4234ab2cf361bf10101; input_dataset_sha256: {datasets/clock_and_wavefront/clock_and_wavefront_reference.json=4851550f4179ae63..., datasets/clock_and_wavefront/scout_manifest.json=0beabd3277c705e6..., datasets/clock_and_wavefront/somite_embryo_specimen.jpg=8b80971796cb29e2...}; supersedes_audit_id: 2026-10-19-clock-and-wavefront-audit; claim_boundary: [reported_in_source: Cooke & Zeeman (1976) J. Theor. Biol. 58:455-476 kinematic somite wavelength law S = v * T_c and Thom-Zeeman cusp catastrophe wavefront manifold | Cooke (1975) Nature 254:196-199 Xenopus laevis blastula size-reduction invariance (N ~ 40 somites across normal and miniature embryos); reconstructed_in_script: 1D anteroposterior Thom-Zeeman cusp catastrophe ODE tau_chi*dchi/dt = -(chi^3 - a(x,t)*chi - b_osc(x,t)) with proportional wavefront width scaling | Bilateral dorsal somite row DoG peak and inter-somitic cleft segmentation on somite_embryo_specimen.jpg (48.47 px mean spacing, symmetry ratio 0.9605); transfer_boundary: 1D anteroposterior paraxial mesoderm axis mapped to dorsal vertebrate SEM somite rows; does_not_claim: Full 3D viscoelastic epithelialization mechanics of somite rosette boundary rotation or explicit Delta-Notch intercellular delay coupling (covered in Slots 022-023)]" ;
        pk:derivedFromPaper <https://doi.org/10.1002/dvdy.21193>,
            <https://doi.org/10.1016/S0022-5193(76)80131-2>,
            <https://doi.org/10.1016/S0092-8674(00)80451-1>,
            <https://doi.org/10.1038/254196a0> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-cooke-clock-and-wavefront-specimen-match> ;
        pk:weightOfEvidence "0.901"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/317bc3c/1976-cooke-clock-and-wavefront.py> a schema:SoftwareSourceCode ;
        rdfs:label "1976-cooke-clock-and-wavefront.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


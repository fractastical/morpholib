sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hamant-microtubule-stress-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bozorg et al. (2014), Sampathkumar et al. (2014), Hamant et al. (2008) & Uyttewaal et al. (2012) shoot apical meristem pressurized shell stress tensor, stress-vs-strain CMT alignment, and katanin organ boundary morphogenesis — Morphometric validation: 94/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L519-620) returns 9 reference-anchored morphometric measurements with uncertainty bounds, Pearson correlations, p-values, and negative controls (Bozorg strain-cue control r = -0.4150 vs stress cue r = 0.9910; ablation ring <cos^2> = 0.8997 vs strain control 0.3512; 5-condition crease depth r = 0.9992, p = 2.41e-5, RMSE = 0.3125 um; and specimen saddle-to-dome structure-tensor coherency ratio)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-5-condition-perturbation-morphospace-boundary-depth-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-arabidopsis-sam-specimen-saddle-boundary-vs-central-dome-structure-tensor-coherency>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-arabidopsis-sam-specimen-segmented-tissue-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-bozorg-et-al-2014-principal-stress-cue-vs-strain-cue-control-alignment-correlation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-law-1-saddle-boundary-stress-amplification-algebraic-residual>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-law-2-law-3-cylinder-laplace-switch-and-katanin-oryzalin-stiffness-residual>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-organ-meristem-saddle-boundary-k-0-vs-central-dome-k-0-cmt-nematic-order-s>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-single-cell-laser-ablation-ring-circumferential-cmt-alignment-cos-2-delta-theta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-wild-type-vs-bot1-ktn1-katanin-mutant-and-oryzalin-ablation-boundary-crease-depth>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-morphometric-validation-1> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-5-condition-perturbation-morphospace-boundary-depth-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-condition perturbation morphospace boundary depth Pearson r = 0.9992 Pearson_r" ;
        dct:description "5-condition p=2.60e-05, RMSE = 0.3213 um (lateral compression clamp depth = 15.69 um)" ;
        schema:measurementTechnique "Pearson correlation across WT, Strain-cue control, bot1/ktn1, Oryzalin, and Lateral Compression clamp" ;
        schema:name "5-condition perturbation morphospace boundary depth Pearson r" ;
        schema:unitText "Pearson_r" ;
        schema:value "0.9992" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-5-condition-perturbation-morphospace-boundary-depth-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-5-condition-perturbation-morphospace-boundary-depth-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.998" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-arabidopsis-sam-specimen-saddle-boundary-vs-central-dome-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Arabidopsis SAM specimen saddle boundary vs central dome structure-tensor coherency = 0.3659 coherency_index" ;
        dct:description "Saddle boundary coherency = 0.3659 ± 0.0078 SE vs isotropic dome baseline = 0.2825 ± 0.0052 SE (ratio = 1.296)" ;
        schema:measurementTechnique "2D Sobel/Gaussian structure-tensor eigenvalue anisotropy (lambda_1 - lambda_2)/(lambda_1 + lambda_2) on arabidopsis_meristem_boundary_specimen.jpg" ;
        schema:name "Arabidopsis SAM specimen saddle boundary vs central dome structure-tensor coherency" ;
        schema:unitText "coherency_index" ;
        schema:value "0.3659" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-arabidopsis-sam-specimen-saddle-boundary-vs-central-dome-structure-tensor-coherency-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-arabidopsis-sam-specimen-saddle-boundary-vs-central-dome-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.3659" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-arabidopsis-sam-specimen-segmented-tissue-area-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Arabidopsis SAM specimen segmented tissue area fraction = 0.4934 area_fraction" ;
        dct:description "Stem ROI structure-tensor coherency = 0.3674 ± 0.0042 SE across segmented meristem section" ;
        schema:measurementTechnique "Optical-density thresholding and morphological closing of 1200x800 px longitudinal SAM section" ;
        schema:name "Arabidopsis SAM specimen segmented tissue area fraction" ;
        schema:unitText "area_fraction" ;
        schema:value "0.4934" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-arabidopsis-sam-specimen-segmented-tissue-area-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-arabidopsis-sam-specimen-segmented-tissue-area-fraction-reference> a schema:PropertyValue ;
        schema:value "0.4934" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-bozorg-et-al-2014-principal-stress-cue-vs-strain-cue-control-alignment-correlation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Bozorg et al. (2014) principal stress cue vs strain-cue control alignment correlation = 0.991 Pearson_r" ;
        dct:description "Principal stress cue r = 0.9910 (> 0.98) vs alternative principal strain cue negative control r = -0.4150" ;
        schema:measurementTechnique "Directional cue comparison between maximal principal stress (sigma_1) and maximal principal strain (epsilon_1) across boundary and ablation zones" ;
        schema:name "Bozorg et al. (2014) principal stress cue vs strain-cue control alignment correlation" ;
        schema:unitText "Pearson_r" ;
        schema:value "0.991" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-bozorg-et-al-2014-principal-stress-cue-vs-strain-cue-control-alignment-correlation-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-bozorg-et-al-2014-principal-stress-cue-vs-strain-cue-control-alignment-correlation-reference> a schema:PropertyValue ;
        schema:value "0.991" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-law-1-saddle-boundary-stress-amplification-algebraic-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 1 saddle-boundary stress amplification algebraic residual = 0.0 MPa_scaled" ;
        dct:description "Exact zero residual confirming Gaussian curvature inversion K = kappa_1*kappa_2 < 0 amplifies boundary tensile stress along the crease vs isotropic dome control (Delta_sigma = 0)" ;
        schema:measurementTechnique "Exact verification of MathOfBiology.Loop_036.hamant_bozorg_saddle_boundary_stress_anisotropy_amplification (Delta_sigma(K<0) - P_s*(kappa_0 + kappa_s))" ;
        schema:name "Law 1 saddle-boundary stress amplification algebraic residual" ;
        schema:unitText "MPa_scaled" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-law-1-saddle-boundary-stress-amplification-algebraic-residual-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-law-1-saddle-boundary-stress-amplification-algebraic-residual-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-law-2-law-3-cylinder-laplace-switch-and-katanin-oryzalin-stiffness-residual> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Law 2 & Law 3 cylinder Laplace switch and katanin/oryzalin stiffness residual = 0.0 MPa" ;
        dct:description "Cylindrical stem hoop/axial stress ratio = 2.000 [ref 2.000]; longitudinal vs hoop Lockhart strain rate ratio = 1.989" ;
        schema:measurementTechnique "Exact verification of bozorg_cylinder_to_saddle_stress_switch (sigma_theta/sigma_z = 2.0) and uyttewaal_katanin_oryzalin_feedback_gain_reduction" ;
        schema:name "Law 2 & Law 3 cylinder Laplace switch and katanin/oryzalin stiffness residual" ;
        schema:unitText "MPa" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-law-2-law-3-cylinder-laplace-switch-and-katanin-oryzalin-stiffness-residual-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-law-2-law-3-cylinder-laplace-switch-and-katanin-oryzalin-stiffness-residual-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-organ-meristem-saddle-boundary-k-0-vs-central-dome-k-0-cmt-nematic-order-s> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Organ-meristem saddle boundary (K < 0) vs central dome (K > 0) CMT nematic order S = 0.8451 nematic_order_S" ;
        dct:description "Saddle boundary S = 0.8451 vs isotropic central dome baseline S = 0.0820 (4-zone Pearson r = 0.9697, p=3.03e-02, RMSE = 0.1131)" ;
        schema:measurementTechnique "Finite-element shell stress anisotropy feedback across 4 canonical SAM zones (Hamant et al. 2008 Fig. 2; Bozorg et al. 2014 Fig. 3)" ;
        schema:name "Organ-meristem saddle boundary (K < 0) vs central dome (K > 0) CMT nematic order S" ;
        schema:unitText "nematic_order_S" ;
        schema:value "0.8451" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-organ-meristem-saddle-boundary-k-0-vs-central-dome-k-0-cmt-nematic-order-s-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-organ-meristem-saddle-boundary-k-0-vs-central-dome-k-0-cmt-nematic-order-s-reference> a schema:PropertyValue ;
        schema:value "0.812" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-single-cell-laser-ablation-ring-circumferential-cmt-alignment-cos-2-delta-theta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Single-cell laser ablation ring circumferential CMT alignment <cos^2(Delta_theta)> = 0.8997 cos2_alignment" ;
        dct:description "WT stress cue <cos^2> = 0.8997 ± 0.018 SE vs strain-cue control <cos^2> = 0.2922 and bot1/ktn1 mutant <cos^2> = 0.7417" ;
        schema:measurementTechnique "24-cell epidermal Kirsch stress ring around laser-ablated SAM cell (Hamant et al. 2008 Fig. 3; Sampathkumar et al. 2014 eLife)" ;
        schema:name "Single-cell laser ablation ring circumferential CMT alignment <cos^2(Delta_theta)>" ;
        schema:unitText "cos2_alignment" ;
        schema:value "0.8997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-single-cell-laser-ablation-ring-circumferential-cmt-alignment-cos-2-delta-theta-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-single-cell-laser-ablation-ring-circumferential-cmt-alignment-cos-2-delta-theta-reference> a schema:PropertyValue ;
        schema:value "0.918" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-measurement-wild-type-vs-bot1-ktn1-katanin-mutant-and-oryzalin-ablation-boundary-crease-depth> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Wild-type vs bot1/ktn1 katanin mutant and Oryzalin ablation boundary crease depth = 14.829 um" ;
        dct:description "WT crease depth = 14.83 um vs bot1/ktn1 mutant = 5.59 um and Oryzalin null control = 1.85 um" ;
        schema:measurementTechnique "Anisotropic viscoplastic Lockhart boundary folding depth under WT (gamma_MT=2.40), bot1/ktn1 (gamma_MT=0.45), and Oryzalin (gamma_MT=0.00)" ;

sub:provenance {
    sub:assertion rdfs:seeAlso <https://github.com/fractastical/morpholib/issues/36> ;
        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/j.cell.2012.02.048>,
            <https://doi.org/10.1126/science.1165594>,
            <https://doi.org/10.1371/journal.pcbi.1003410>,
            <https://doi.org/10.7554/eLife.01967> .
    <https://doi.org/10.1016/j.cell.2012.02.048> dct:date "2012"^^xsd:gYear ;
        dct:title "Mechanical Stress Acts via Katanin to Amplify Differences in Growth Rate between Adjacent Cells in Arabidopsis" .
    <https://doi.org/10.1126/science.1165594> dct:date "2008"^^xsd:gYear ;
        dct:title "Developmental Patterning by Mechanical Signals in Arabidopsis" .
    <https://doi.org/10.1371/journal.pcbi.1003410> dct:date "2014"^^xsd:gYear ;
        dct:title "Stress and Strain Provide Positional and Directional Cues in Development" .
    <https://doi.org/10.7554/eLife.01967> dct:date "2014"^^xsd:gYear ;
        dct:title "Subcellular and supracellular mechanical stress prescribes cytoskeleton behavior in Arabidopsis cotyledon pavement cells" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hamant-microtubule-stress-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Bozorg et al. (2014), Sampathkumar et al. (2014), Hamant et al. (2008) & Uyttewaal et al. (2012) shoot apical meristem pressurized shell stress tensor, stress-vs-strain CMT alignment, and katanin organ boundary morphogenesis — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "8-point deterministic `run_self_test()` suite (L875-924) verifying SHA-256 dataset integrity, Law 1 saddle stress amplification, Law 2 cylindrical 2:1 Laplace ratio and longitudinal Lockhart elongation, Law 3 katanin/oryzalin feedback reduction, Bozorg stress-vs-strain cue discrimination, laser ablation ring reorientation, 5-condition Pearson r >= 0.995, and specimen CV segmentation." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-repro-package-1> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L875–L924" ;
        dcterms:description "8-check deterministic self-test suite passing in < 1.5s" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-microtubule-stress-meristem.py#L875-L924> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 036 Pass 2 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


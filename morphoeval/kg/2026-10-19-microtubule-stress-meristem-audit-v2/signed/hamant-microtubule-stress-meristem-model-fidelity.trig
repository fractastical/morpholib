        rdfs:label "morphoeval/lean/loops/Loop_036_microtubule_stress_meristem.lean L13–L169" ;
        dcterms:description "3 machine-checked Lean 4 theorems for saddle stress amplification, cylinder 2:1 Laplace switch, and katanin/oryzalin feedback reduction (0 sorrys)" ;

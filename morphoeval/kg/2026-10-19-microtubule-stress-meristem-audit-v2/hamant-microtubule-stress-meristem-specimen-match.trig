sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-hamant-microtubule-stress-meristem> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-hamant-microtubule-stress-meristem-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bozorg et al. (2014), Sampathkumar et al. (2014), Hamant et al. (2008) & Uyttewaal et al. (2012) shoot apical meristem pressurized shell stress tensor, stress-vs-strain CMT alignment, and katanin organ boundary morphogenesis — Morphological realism / specimen match: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 *Arabidopsis thaliana* shoot apical meristem longitudinal section (`arabidopsis_meristem_boundary_specimen.jpg`, 1200x800 px), extracts the L1 epidermal contour (`segment_arabidopsis_meristem_specimen`, L447-513, tissue area fraction 0.4200), and computes 2D Sobel/Gaussian structure-tensor coherency across the Central Dome, Saddle Boundary, and Stem ROIs." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-specimen-match-2> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2008-hamant-microtubule-stress-meristem.py L447–L513" ;
        dct:description "Optical-density L1 contour segmentation and 2D structure-tensor coherency analysis across Dome, Saddle, and Stem ROIs" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2008-hamant-microtubule-stress-meristem.py#L447-L513> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-hamant-microtubule-stress-meristem-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/microtubule_stress_meristem_comparison.png (generated output)" ;
        dct:description "6-panel publication figure comparing 2D FEM shell stress, 4-zone Laplace switch, laser ablation ring, 5-condition sweep, and specimen segmentation — docs/media/microtubule_stress_meristem_comparison.png: rendered output of 2008-hamant-microtubule-stress-meristem.py at 8871db0, image/png, 808357 B, 2310×1428 px, artifact_sha256 daf51bf0d63a2152304a1685871e8db5e6a1aae1f66e1fd1e2823e3c9efbacbc (sha256 daf51bf0d63a2152304a1685871e8db5e6a1aae1f66e1fd1e2823e3c9efbacbc), spec_fingerprint 58c04b2b1d6826f3891b148876d3e11ab4e8c9ee2c8ea4cca35459f9bbf26dca" .

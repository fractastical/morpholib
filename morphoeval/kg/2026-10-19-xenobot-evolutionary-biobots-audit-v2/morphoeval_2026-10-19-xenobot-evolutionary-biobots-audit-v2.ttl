<https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity> a pk1:LLMClaimAssessment ;
    rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication — Model fidelity to source: 93/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Faithfully implements the Kriegman et al. (2020) voxel rest-length actuation law, passive ectoderm volume invariance, ventral-concavity bipedal substrate friction ratchet, cardiomyocyte phase-randomization transferability filter, autonomous mechanical laceration wound-closure kinetics, and Kriegman et al. (2021) C-shaped kinematic self-replication compaction law (L125-510), verified by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_083_xenobot_evolutionary_biobots.lean`." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk1:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk1:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity-2>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity-3> ;
    pk1:hasScore 9.3e-01 ;
    pk1:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-morphometric-validation> a pk1:LLMClaimAssessment ;
    rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication — Morphometric validation: 91/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Extracts 6 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L810-915): evolved bipedal forward displacement (1.9478 BL vs 1.95 reference), phase-randomized cardiomyocyte retention ratio (0.7433 vs 0.72 reference), mechanical laceration velocity recovery ratio (0.8522 vs 0.90 reference), Pac-Man vs spherical stem-cell compaction ratio (2.9459 vs 2.65 reference, 3 vs 1 daughter generations), specimen concavity fraction (0.1588 vs 0.15 reference), and specimen red-fluorescent cardiac tissue fraction (0.3647 vs 0.3714 reference, RMSE = 0.0343)." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
    pk1:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk1:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-afpo-evolved-ventral-concavity-bipedal-xenobot-forward-displacement-10-s-15-cardiac-cycles>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-c-shaped-pac-man-theta-65-deg-vs-spherical-kinematic-self-replication-stem-cell-compaction-ratio>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-mechanical-laceration-50-mid-body-hinge-incision-autonomous-wound-closure-velocity-recovery-ratio>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-phase-randomized-cardiomyocyte-noise-transferability-retention-ratio>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-red-fluorescent-contractile-cardiac-tissue-fraction-model-parity-rmse>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-ventral-mouth-concavity-fraction-1-solidity>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-morphometric-validation-1> ;
    pk1:hasScore 9.1e-01 ;
    pk1:hasVerdict "faithful" .


<https://w3id.org/delphi/resource/claim/morphoeval-kriegman-xenobot-evolutionary-biobots> a pk:Claim ;
    rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication (Xenopus laevis (African clawed frog blastula ectoderm & cardiac progenitor biobots))" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-1>,
        <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-2>,
        <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-3>,
        <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-4>,
        <https://w3id.org/delphi/resource/math-law/kriegman-xenobot-evolutionary-biobots-5> ;
    schema:about "Xenopus laevis (African clawed frog blastula ectoderm & cardiac progenitor biobots)" ;
    schema:additionalProperty "does_not_claim: Full 3D fluid-structure Stokes ciliary boundary-element hydrodynamics or single-cell transcriptomic reprogramming after laceration",
        "reconstructed_in_script: 2D sagittal 8x5 voxel spring-lattice locomotion simulator across 5 experimental regimes, 60-generation AFPO pareto evolution, and 2D arena kinematic stem-cell compaction across mouth angles theta_mouth in [0, 120] deg",
        "reconstructed_in_script: Automated chromatic R-B/R-G segmentation and 2D convex-hull solidity/concavity analysis on xenopus_biobot_specimen.jpg (concavity = 0.1588, cardiac fraction = 0.3647, ectoderm fraction = 0.6353)",
        "reported_in_source: Kriegman, Blackiston, Levin & Bongard (2020) PNAS 117:1853-1859 voxel-based passive ectoderm + contractile cardiac progenitor spring-lattice design pipeline, AFPO phase-randomization transferability filter, dorsal inversion locomotion collapse, and mechanical laceration regeneration",
        "reported_in_source: Kriegman, Blackiston, Levin & Bongard (2021) PNAS 118:e2112672118 C-shaped ('Pac-Man') kinematic self-replication sweeping dissociated Xenopus stem cells into multi-generational daughter spheroids",
        "transfer_boundary: Reduced 2D sagittal voxel spring-lattice and orbital stem-cell sweeping kinematics calibrated to 3D VoxCAD and wet-lab Xenopus laevis biobot trajectories" ;
    pk:derivedFromPaper <https://doi.org/10.1073/pnas.1910837117>,
        <https://doi.org/10.1073/pnas.2112672118>,
        <https://doi.org/10.1126/scirobotics.abf1571>,
        <https://doi.org/10.1145/2463372.2463404> ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/2026-10-19-xenobot-evolutionary-biobots-audit-v2-kriegman-xenobot-evolutionary-biobots-1>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-xenobot-evolutionary-biobots-audit-v2-kriegman-xenobot-evolutionary-biobots-2>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-xenobot-evolutionary-biobots-audit-v2-kriegman-xenobot-evolutionary-biobots-3>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-xenobot-evolutionary-biobots-audit-v2-kriegman-xenobot-evolutionary-biobots-4>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-xenobot-evolutionary-biobots-audit-v2-kriegman-xenobot-evolutionary-biobots-5>,
        <https://w3id.org/delphi/resource/evidence/2026-10-19-xenobot-evolutionary-biobots-audit-v2-kriegman-xenobot-evolutionary-biobots-6> ;
    pk:hypothesisType "Voxel Spring-Lattice Actuated Continuum Mechanics, Age-Fitness Pareto Optimization (AFPO), & Kinematic Self-Replication" ;
    pk:weightOfEvidence 9.13e-01 .


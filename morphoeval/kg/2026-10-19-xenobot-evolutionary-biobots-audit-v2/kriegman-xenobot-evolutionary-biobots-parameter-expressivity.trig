sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kriegman-xenobot-evolutionary-biobots> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication — Parameter expressivity: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Simulates all 5 experimental regimes (`evolved_ventral_biped`, `phase_randomized_biped`, `scattered_checkerboard_noise`, `inverted_dorsal_up_control`, and `mechanical_laceration_regeneration`), evaluates a 25-point mouth concavity angle sweep $\\theta_{\\mathrm{mouth}} \\in [0^\\circ, 120^\\circ]$ for kinematic self-replication (Panel B3), and maps the 2D $(\\varepsilon_0, \\Delta\\mu)$ biomechanical morphospace (Panel B2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-parameter-expressivity-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2020-kriegman-xenobot-evolutionary-biobots.py L375–L510" ;
        dct:description "AFPO evolution, 25-angle Pac-Man replication curve, and 2D (epsilon_0, Delta_mu) morphospace" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L375-L510> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kriegman-xenobot-evolutionary-biobots> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication — Morphometric validation: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 6 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L810-915): evolved bipedal forward displacement (1.9478 BL vs 1.95 reference), phase-randomized cardiomyocyte retention ratio (0.7433 vs 0.72 reference), mechanical laceration velocity recovery ratio (0.8522 vs 0.90 reference), Pac-Man vs spherical stem-cell compaction ratio (2.9459 vs 2.65 reference, 3 vs 1 daughter generations), specimen concavity fraction (0.1588 vs 0.15 reference), and specimen red-fluorescent cardiac tissue fraction (0.3647 vs 0.3714 reference, RMSE = 0.0343)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-afpo-evolved-ventral-concavity-bipedal-xenobot-forward-displacement-10-s-15-cardiac-cycles>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-c-shaped-pac-man-theta-65-deg-vs-spherical-kinematic-self-replication-stem-cell-compaction-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-mechanical-laceration-50-mid-body-hinge-incision-autonomous-wound-closure-velocity-recovery-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-phase-randomized-cardiomyocyte-noise-transferability-retention-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-red-fluorescent-contractile-cardiac-tissue-fraction-model-parity-rmse>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-ventral-mouth-concavity-fraction-1-solidity>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-morphometric-validation-1> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-afpo-evolved-ventral-concavity-bipedal-xenobot-forward-displacement-10-s-15-cardiac-cycles> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "AFPO-evolved ventral-concavity bipedal Xenobot forward displacement (10 s / 15 cardiac cycles) = 1.9488 body lengths (L_body)" ;
        dct:description "evolved_ventral_biped = 1.9488 BL (mean speed = 0.1949 BL/s) vs inverted_dorsal_up_control = 0.1244 BL (15.4x ratchet ratio)" ;
        schema:measurementTechnique "2D voxel spring-lattice COM trajectory x_COM(T)/L_body for evolved_ventral_biped vs inverted_dorsal_up_control" ;
        schema:name "AFPO-evolved ventral-concavity bipedal Xenobot forward displacement (10 s / 15 cardiac cycles)" ;
        schema:unitText "body lengths (L_body)" ;
        schema:value "1.9488" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-afpo-evolved-ventral-concavity-bipedal-xenobot-forward-displacement-10-s-15-cardiac-cycles-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-afpo-evolved-ventral-concavity-bipedal-xenobot-forward-displacement-10-s-15-cardiac-cycles-reference> a schema:PropertyValue ;
        dct:source "Kriegman, Blackiston, Levin & Bongard (2020) PNAS 117(4):1853-1859 Figs. 1-3 (~1.5-2.2 body lengths per 10 s; dorsal inversion < 0.20 BL)" ;
        schema:value "1.95" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-c-shaped-pac-man-theta-65-deg-vs-spherical-kinematic-self-replication-stem-cell-compaction-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "C-shaped ('Pac-Man', theta=65 deg) vs spherical kinematic self-replication stem-cell compaction ratio = 3.0044 N_compacted(Pac-Man) / N_compacted(Sphere)" ;
        dct:description "Pac-Man daughters = 3 generations (212.8 cells compacted) vs sphere = 1 generation (70.9 cells), ratio = 3.0044" ;
        schema:measurementTechnique "Kinematic stem-cell sweeping and pile compaction yield for AI-evolved C-shaped parent (65 deg mouth) vs un-sculpted spherical control (0 deg)" ;
        schema:name "C-shaped ('Pac-Man', theta=65 deg) vs spherical kinematic self-replication stem-cell compaction ratio" ;
        schema:unitText "N_compacted(Pac-Man) / N_compacted(Sphere)" ;
        schema:value "3.0044" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-c-shaped-pac-man-theta-65-deg-vs-spherical-kinematic-self-replication-stem-cell-compaction-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-c-shaped-pac-man-theta-65-deg-vs-spherical-kinematic-self-replication-stem-cell-compaction-ratio-reference> a schema:PropertyValue ;
        dct:source "Kriegman, Blackiston, Levin & Bongard (2021) PNAS 118(49):e2112672118 Figs. 1-3 (3-4 daughter generations for C-shaped Pac-Man vs 1 for sphere)" ;
        schema:value "2.65" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-mechanical-laceration-50-mid-body-hinge-incision-autonomous-wound-closure-velocity-recovery-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mechanical laceration (~50% mid-body hinge incision) autonomous wound-closure velocity recovery ratio = 0.8519 v_post_heal / v_pre_cut" ;
        dct:description "residual wound gap at t=10 s = 0.0111, spring integrity = 0.9920, net displacement = 1.7662 BL" ;
        schema:measurementTechnique "Post-healing forward velocity (t in [8, 10] s) divided by pre-incision velocity (t in [0.5, 1.4] s) after 50% hinge laceration at t = 1.5 s" ;
        schema:name "Mechanical laceration (~50% mid-body hinge incision) autonomous wound-closure velocity recovery ratio" ;
        schema:unitText "v_post_heal / v_pre_cut" ;
        schema:value "0.8519" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-mechanical-laceration-50-mid-body-hinge-incision-autonomous-wound-closure-velocity-recovery-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-mechanical-laceration-50-mid-body-hinge-incision-autonomous-wound-closure-velocity-recovery-ratio-reference> a schema:PropertyValue ;
        dct:source "Kriegman et al. (2020) PNAS 117(4):1853-1859 Fig. 5 (autonomous mechanical laceration closure recovers >85% forward locomotion)" ;
        schema:value "0.9" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-phase-randomized-cardiomyocyte-noise-transferability-retention-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Phase-randomized cardiomyocyte noise transferability retention ratio = 0.7431 F_robust / F_sync" ;
        dct:description "contiguous biped retention = 0.7431 (1.4481 BL) vs scattered checkerboard retention = 0.0457 (0.0891 BL)" ;
        schema:measurementTechnique "Ratio of forward displacement under desynchronized cardiomyocyte phase noise (phase_randomized_biped) to synchronous pacing" ;
        schema:name "Phase-randomized cardiomyocyte noise transferability retention ratio" ;
        schema:unitText "F_robust / F_sync" ;
        schema:value "0.7431" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-phase-randomized-cardiomyocyte-noise-transferability-retention-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-phase-randomized-cardiomyocyte-noise-transferability-retention-ratio-reference> a schema:PropertyValue ;
        dct:source "Kriegman et al. (2020) PNAS 117(4):1853-1859 Fig. 2C-E (contiguous ventral cardiac layer retains >65% speed under phase noise; checkerboard collapses)" ;
        schema:value "0.72" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-red-fluorescent-contractile-cardiac-tissue-fraction-model-parity-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Segmented Xenopus biobot specimen red-fluorescent contractile cardiac tissue fraction & model parity RMSE = 0.3647 A_cardiac / A_body" ;
        dct:description "specimen cardiac = 0.3647, ectoderm = 0.6353 vs voxel model cardiac = 0.4062, ectoderm = 0.5938 (3-feature tissue/concavity RMSE = 0.0343)" ;
        schema:measurementTechnique "Chromatic R-G and R-B fluorescence segmentation of contractile cardiac core vs passive ectoderm on xenopus_biobot_specimen.jpg compared to evolved 8x5 voxel design" ;
        schema:name "Segmented Xenopus biobot specimen red-fluorescent contractile cardiac tissue fraction & model parity RMSE" ;
        schema:unitText "A_cardiac / A_body" ;
        schema:value "0.3647" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-red-fluorescent-contractile-cardiac-tissue-fraction-model-parity-rmse-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-red-fluorescent-contractile-cardiac-tissue-fraction-model-parity-rmse-reference> a schema:PropertyValue ;
        dct:source "Evolved 8x5 Xenobot voxel design (13 cardiac / 35 total voxels = 0.3714) & Kriegman et al. (2020) PNAS Fig. 1D-F" ;
        schema:value "0.3714" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-ventral-mouth-concavity-fraction-1-solidity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Segmented Xenopus biobot specimen ventral/mouth concavity fraction (1 - solidity) = 0.1588 1 - A_body / A_hull" ;
        dct:description "specimen solidity = 0.8412, concavity_fraction = 0.1588, body_area = 213500 px (bbox 623x521 px)" ;
        schema:measurementTechnique "2D convex-hull solidity deficit 1 - A_body/A_hull on datasets/xenobot_evolutionary_biobots/xenopus_biobot_specimen.jpg" ;
        schema:name "Segmented Xenopus biobot specimen ventral/mouth concavity fraction (1 - solidity)" ;
        schema:unitText "1 - A_body / A_hull" ;
        schema:value "0.1588" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-ventral-mouth-concavity-fraction-1-solidity-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-measurement-segmented-xenopus-biobot-specimen-ventral-mouth-concavity-fraction-1-solidity-reference> a schema:PropertyValue ;
        dct:source "Vendored Xenopus laevis Xenobot micrograph (Wikimedia Commons File:Xenobot.jpg, CC BY 4.0) & evolved 8x5 voxel concavity fraction (6/40 = 0.1500)" ;
        schema:value "0.15" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2020-kriegman-xenobot-evolutionary-biobots.py L810–L915" ;
        dct:description "6 quantitative MorphoEval measurements with empirical references and tissue/concavity RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L810-L915> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


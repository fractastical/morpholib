sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kriegman-xenobot-evolutionary-biobots> a pk:Claim ;
        rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication faithfully reproduces Xenopus laevis (African clawed frog blastula ectoderm & cardiac progenitor biobots) morphology" ;
        dcterms:description "The simulation script(s) 2020-kriegman-xenobot-evolutionary-biobots.py implement the cited source model as published and produce forms that match real Xenopus laevis (African clawed frog blastula ectoderm & cardiac progenitor biobots) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 91.3/100, audit 2026-10-19-xenobot-evolutionary-biobots-audit-v2) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py; output: docs/media/xenobot_evolutionary_biobots_comparison.png; organism: Xenopus laevis (African clawed frog blastula ectoderm & cardiac progenitor biobots); checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 9611ac5308e60d5b8cd28bafdf0fb556acb91a73e85f822739154d38d1283ee9; artifact_sha256: 3ada48180881707f50f622d45cf504c320a18eb4da0b54cbdabe1e669d3b119a; input_dataset_sha256: {datasets/xenobot_evolutionary_biobots/paper_citations.bib=4f92785fb031ce11..., datasets/xenobot_evolutionary_biobots/scout_manifest.json=abbd461fb51acbc9..., datasets/xenobot_evolutionary_biobots/xenobot_evolutionary_biobots_reference.json=256b3387af983583..., datasets/xenobot_evolutionary_biobots/xenopus_biobot_specimen.jpg=13e063704f07254f...}; supersedes_audit_id: 2026-10-19-xenobot-evolutionary-biobots-audit; claim_boundary: [reported_in_source: Kriegman, Blackiston, Levin & Bongard (2020) PNAS 117:1853-1859 voxel-based passive ectoderm + contractile cardiac progenitor spring-lattice design pipeline, AFPO phase-randomization transferability filter, dorsal inversion locomotion collapse, and mechanical laceration regeneration | Kriegman, Blackiston, Levin & Bongard (2021) PNAS 118:e2112672118 C-shaped ('Pac-Man') kinematic self-replication sweeping dissociated Xenopus stem cells into multi-generational daughter spheroids; reconstructed_in_script: 2D sagittal 8x5 voxel spring-lattice locomotion simulator across 5 experimental regimes, 60-generation AFPO pareto evolution, and 2D arena kinematic stem-cell compaction across mouth angles theta_mouth in [0, 120] deg | Automated chromatic R-B/R-G segmentation and 2D convex-hull solidity/concavity analysis on xenopus_biobot_specimen.jpg (concavity = 0.1588, cardiac fraction = 0.3647, ectoderm fraction = 0.6353); transfer_boundary: Reduced 2D sagittal voxel spring-lattice and orbital stem-cell sweeping kinematics calibrated to 3D VoxCAD and wet-lab Xenopus laevis biobot trajectories; does_not_claim: Full 3D fluid-structure Stokes ciliary boundary-element hydrodynamics or single-cell transcriptomic reprogramming after laceration]" ;
        pk:derivedFromPaper <https://doi.org/10.1073/pnas.1910837117>,
            <https://doi.org/10.1073/pnas.2112672118>,
            <https://doi.org/10.1126/scirobotics.abf1571>,
            <https://doi.org/10.1145/2463372.2463404> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-specimen-match> ;
        pk:weightOfEvidence "0.913"^^xsd:double .

    <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py> a schema:SoftwareSourceCode ;
        rdfs:label "2020-kriegman-xenobot-evolutionary-biobots.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "317bc3c" .
}


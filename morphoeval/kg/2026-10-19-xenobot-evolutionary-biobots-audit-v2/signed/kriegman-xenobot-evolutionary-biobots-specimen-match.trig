sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kriegman-xenobot-evolutionary-biobots> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication — Morphological realism / specimen match: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Vendors and SHA-256-verifies the CC BY 4.0 fluorescence + brightfield micrograph of an evolved Xenopus laevis Xenobot (`datasets/xenobot_evolutionary_biobots/xenopus_biobot_specimen.jpg`), automatically segments the multicellular body contour, 2D convex hull (`solidity = 0.8412`, `concavity_fraction = 0.1588` matching the evolved 8x5 voxel concavity `6/40 = 0.1500`), and internal red-fluorescent contractile cardiac progenitor core (`cardiac_fraction = 0.3647` vs voxel model `0.4062`, 3-feature RMSE = `0.0343`, Panels C1, C3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-specimen-match-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2020-kriegman-xenobot-evolutionary-biobots.py L515–L595" ;
        dcterms:description "Automated chromatic R-B/R-G and convex-hull segmentation on xenopus_biobot_specimen.jpg" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L515-L595> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/xenobot_evolutionary_biobots_comparison.png (generated output)" ;
        dcterms:description "9-panel synthesis figure including specimen convex-hull concavity and red cardiac core segmentation — docs/media/xenobot_evolutionary_biobots_comparison.png: rendered output of 2020-kriegman-xenobot-evolutionary-biobots.py at 317bc3c, image/png, 795896 B, 2268×1863 px, artifact_sha256 3ada48180881707f50f622d45cf504c320a18eb4da0b54cbdabe1e669d3b119a (sha256 3ada48180881707f50f622d45cf504c320a18eb4da0b54cbdabe1e669d3b119a), spec_fingerprint 9611ac5308e60d5b8cd28bafdf0fb556acb91a73e85f822739154d38d1283ee9" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kriegman-xenobot-evolutionary-biobots> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kriegman-xenobot-evolutionary-biobots-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Kriegman et al. (2020, 2021) Xenobot evolutionary biomechanics & kinematic self-replication — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2020`), standalone 8-check `--self-test` suite verifying SHA-256 dataset locks, passive ectoderm volume invariance, cardiac cycle symmetry, evolved bipedal locomotion, phase-noise transferability filter, dorsal inversion collapse, mechanical laceration recovery, Pac-Man kinematic self-replication, specimen CV segmentation, and bitwise two-run determinism (`atol=0.0`), plus rendered 9-panel PNG and 24-frame GIF in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2020-kriegman-xenobot-evolutionary-biobots.py L920–L1005" ;
        dcterms:description "8-check deterministic --self-test suite verifying SHA-256 locks, 5 regimes, Pac-Man replication, and specimen segmentation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2020-kriegman-xenobot-evolutionary-biobots.py#L920-L1005> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kriegman-xenobot-evolutionary-biobots-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/xenobot_evolutionary_biobots_growth.gif (generated output)" ;
        dcterms:description "24-frame animated GIF comparing 4 locomotion regimes and C-shaped Pac-Man kinematic stem-cell sweeping — docs/media/xenobot_evolutionary_biobots_growth.gif: rendered output of 2020-kriegman-xenobot-evolutionary-biobots.py at 317bc3c, image/gif, 275555 B, 827×351 px, 24 frames, artifact_sha256 158baa2005fa64f5fe29e327e1ed988b2643c7ccb67686fab9bd0dc2451400eb (sha256 158baa2005fa64f5fe29e327e1ed988b2643c7ccb67686fab9bd0dc2451400eb), spec_fingerprint 9611ac5308e60d5b8cd28bafdf0fb556acb91a73e85f822739154d38d1283ee9" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


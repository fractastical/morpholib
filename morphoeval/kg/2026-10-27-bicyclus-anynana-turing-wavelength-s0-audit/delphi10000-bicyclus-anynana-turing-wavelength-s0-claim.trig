    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1242/dev.169367>,
            <https://doi.org/10.1371/journal.pone.0141434> .
    <https://doi.org/10.1007/BF00289234> dct:title "A theory of biological pattern formation" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1242/dev.169367> dct:title "Activation of butterfly eyespots by Distal-less is consistent with a reaction-diffusion process" .
    <https://doi.org/10.1371/journal.pone.0141434> dct:title "A model for selection of eyespots on butterfly wings" .
}


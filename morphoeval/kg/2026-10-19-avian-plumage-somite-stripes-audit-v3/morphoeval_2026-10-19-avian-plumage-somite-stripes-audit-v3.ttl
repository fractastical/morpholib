<https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Somite-Specified Dorsoventral Stripe Period Partition & Exogenous Agouti Bead Reciprocity" ;
    dct:description "Proves conservation of the somite-specified dorsoventral stripe period and exact reciprocal narrowing of adjacent black eumelanin bands upon exogenous Agouti bead implantation | Variables: Lambda: somite-specified dorsoventral stripe period (μm); w_y: Agouti-positive yellow pheomelanin stripe width; delta_bead: exogenous Agouti protein bead expansion" ;
    dct:source "Haupaix et al. (2018) Science 361(6408):eaar4777 Figs. 1 & 4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L158-L336,L452-L488>,
        <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L19-L46> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def black_stripe_width (Lambda w_y : Int) : Int := Lambda - w_y
theorem somite_stripe_period_conservation_and_agouti_bead_expansion
    (Lambda w_y delta_bead : Int)
    (hw : 0 ≤ w_y) (hbead : delta_bead > 0) (hcap : w_y + delta_bead ≤ Lambda) :
    w_y + black_stripe_width Lambda w_y = Lambda ∧
    (w_y + delta_bead) + black_stripe_width Lambda (w_y + delta_bead) = Lambda ∧
    w_y + delta_bead > 0 ∧
    black_stripe_width Lambda (w_y + delta_bead) ≥ 0 ∧
    black_stripe_width Lambda (w_y + delta_bead) < black_stripe_width Lambda w_y ∧
    black_stripe_width Lambda (w_y + delta_bead) = black_stripe_width Lambda w_y - delta_bead := by
  unfold black_stripe_width; omega
"""^^pk:lean4 ;
    skos:notation "w_{\\text{yellow}} + w_{\\text{black}} = \\Lambda_{\\text{somite}}; \\quad w_{\\text{black}}(\\Lambda, w_y + \\Delta_{\\text{bead}}) = w_{\\text{black}}(\\Lambda, w_y) - \\Delta_{\\text{bead}}" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
        <https://doi.org/10.1126/science.1230374>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.1371/journal.pbio.3000448> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_010.black_stripe_width" ;
    pk:leanTheorem "MathOfBiology.Loop_010.somite_stripe_period_conservation_and_agouti_bead_expansion" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Heterospecific Somite-to-Dermis Chimera Donor Autonomy Law" ;
    dct:description "Proves that heterospecific somite grafting between quail, pheasant, and guineafowl autonomously shifts host dermal Agouti stripe width toward the somite donor species | Variables: alpha_pct: percentage donor somite autonomy in chimeric dermis (≈94% in galliform chimeras); w_donor, w_host: donor and host species Agouti stripe widths" ;
    dct:source "Haupaix et al. (2018) Science 361(6408):eaar4777 Fig. 3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L395-L449>,
        <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L53-L76> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def chimera_agouti_width_scaled (alpha_pct w_donor w_host : Int) : Int :=
  alpha_pct * w_donor + (100 - alpha_pct) * w_host
theorem interspecific_somite_graft_donor_autonomy
    (w_donor w_host : Int) (h_diff : w_donor > w_host) :
    chimera_agouti_width_scaled 100 w_donor w_host = 100 * w_donor ∧
    chimera_agouti_width_scaled 94 w_donor w_host > 100 * w_host ∧
    chimera_agouti_width_scaled 94 w_host w_donor < 100 * w_donor := by
  unfold chimera_agouti_width_scaled; omega
"""^^pk:lean4 ;
    skos:notation "W_{\\text{chimera}} = \\alpha_{\\text{donor}} w_{\\text{donor}} + (1 - \\alpha_{\\text{donor}}) w_{\\text{host}}; \\quad w_{\\text{donor}} > w_{\\text{host}} \\implies W_{\\text{chimera}} > w_{\\text{host}}" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
        <https://doi.org/10.1126/science.1230374>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.1371/journal.pbio.3000448> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_010.chimera_agouti_width_scaled" ;
    pk:leanTheorem "MathOfBiology.Loop_010.interspecific_somite_graft_donor_autonomy" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Agouti-MC1R Threshold Fate Switch & Connexin40 Melanocyte Reaction-Diffusion Instability" ;
    dct:description "Proves that Agouti threshold antagonism switches melanocytes from black eumelanin (0) to yellow pheomelanin (1) while differential diffusivity (d=20 vs d=1) amplifies periodic stripes aligned to the somite prepattern | Variables: A: dermal Agouti concentration; theta_A: MC1R antagonism threshold; u, v: melanocyte gap-junction activator and long-range inhibitor; d_ratio = D_v/D_u" ;
    dct:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 3; Inaba et al. (2019) PNAS 116:6884-6890 Figs. 2-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L158-L336>,
        <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L83-L116> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def mc1r_pigment_fate (A theta_A : Nat) : Nat := if A ≥ theta_A then 1 else 0
theorem agouti_mc1r_switch_and_cx40_turing_instability :
    mc1r_pigment_fate 75 50 = 1 ∧ mc1r_pigment_fate 0 50 = 0 ∧
    turing_trace 5 (-7) < 0 ∧ turing_det 5 (-7) (-8) 6 > 0 ∧
    turing_cross_term 5 (-7) 1 < 0 ∧ turing_cross_term 5 (-7) 20 > 0 := by decide
"""^^pk:lean4 ;
    skos:notation "F_{\\text{pigment}}(A) = \\mathbb{I}(A \\ge \\theta_A); \\quad \\partial_t u = D_u \\nabla^2 u + f(u,v) + \\beta_A S_{\\text{somite}}(y), \\; \\partial_t v = D_v \\nabla^2 v + g(u,v)" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
        <https://doi.org/10.1126/science.1230374>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.1371/journal.pbio.3000448> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_010.mc1r_pigment_fate" ;
    pk:leanTheorem "MathOfBiology.Loop_010.agouti_mc1r_switch_and_cx40_turing_instability" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Lin (2013) Ring-Niche Chevron Geometry on the Opened Feather-Follicle Cylinder" ;
    dct:description "Proves that a pigment switch propagating around the Lin (2013) ring niche yields a mirror-symmetric chevron band on the opened follicle whose apex sits on the rachis and whose opening grows monotonically with the helical pitch, degenerating to a transverse bar for a synchronous ring (k = 0) | Variables: s: proximodistal position from the feather tip (growth-time axis); ell: signed lateral/azimuthal distance from the anterior rachis on the cylinder opened at the posterior new-barb locus; k = v_z/(r_f omega): helical pitch of a pigment switch propagating around the ring niche at angular rate omega while melanocytes rise at v_z" ;
    dct:source "Lin et al. (2013) Science 340(6139):1442-1445 Fig. 1B, Fig. 2B, fig. S9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L659-L742>,
        <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L126-L157> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def chevron_s (s0 k ell : Int) : Int := s0 + k * (Int.natAbs ell : Int)
theorem ring_niche_chevron_geometry (s0 k ell : Int) (hk : 0 ≤ k) :
    chevron_s s0 k ell = chevron_s s0 k (-ell) ∧
    chevron_s s0 0 ell = s0 ∧
    s0 ≤ chevron_s s0 k ell ∧
    (∀ k', k < k' → ell ≠ 0 → chevron_s s0 k ell < chevron_s s0 k' ell) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp [chevron_s, Int.natAbs_neg]
  · simp [chevron_s]
  · unfold chevron_s; have h := Int.mul_nonneg hk (Int.natCast_nonneg (Int.natAbs ell)); omega
  · intro k' hk' hell; unfold chevron_s
    have hpos : (0 : Int) < (Int.natAbs ell : Int) := by omega
    have h := Int.mul_lt_mul_of_pos_right hk' hpos; omega
"""^^pk:lean4 ;
    skos:notation "s_{\\text{edge}}(\\ell) = s_0 + k\\,|\\ell|, \\quad k = \\frac{v_z}{r_f\\,\\omega}; \\quad s(\\ell) = s(-\\ell), \\; s(\\ell)|_{k=0} = s_0, \\; s_0 \\le s(\\ell), \\; k < k' \\wedge \\ell \\ne 0 \\implies s_k(\\ell) < s_{k'}(\\ell)" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
        <https://doi.org/10.1126/science.1230374>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.1371/journal.pbio.3000448> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_010.chevron_s" ;
    pk:leanTheorem "MathOfBiology.Loop_010.ring_niche_chevron_geometry" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/haupaix-avian-plumage-somite-stripes-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Haupaix (2018) Agouti-Dose Yellow-Pulse Duration & Feather-Type Law on the Follicle Niche" ;
    dct:description "Proves the Haupaix et al. (2018) feather-type trichotomy (b / y with black base and tip / fully pheomelanic) and that feather type is monotone non-decreasing in agouti dose, the law behind the recessive-black (2 rows) < wild-type (4 rows) < Fawn (5-6 rows, no eumelanin) stripe-width series | Variables: A_i: dermal agouti dose read by the follicle ring niche from the body-wide field u(x_i, y_i) (Lean A = A_i - a); a: amplitude of the transient yellow-pulse modulation (peak A_i at mid-growth, trough A_i - 2a at tip and base); theta_A: MC1R antagonism threshold; duty: relative yellow band length" ;
    dct:source "Haupaix et al. (2018) Science 361(6408):eaar4777 Fig. 3A-C, fig. S1, fig. S6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L545-L656,L745-L773>,
        <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L160-L192> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def mc1r_pigment_fate_int (A theta_A : Int) : Nat := if A ≥ theta_A then 1 else 0
def feather_type (A a theta_A : Int) : Nat :=
  mc1r_pigment_fate_int (A + a) theta_A + mc1r_pigment_fate_int (A - a) theta_A
theorem agouti_pulse_duration_feather_type (A a theta_A : Int) (ha : 0 < a) :
    (A - a ≥ theta_A → feather_type A a theta_A = 2) ∧
    (A + a < theta_A → feather_type A a theta_A = 0) ∧
    (theta_A - a ≤ A ∧ A < theta_A + a → feather_type A a theta_A = 1) ∧
    (∀ A', A ≤ A' → feather_type A a theta_A ≤ feather_type A' a theta_A) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro h; simp only [feather_type, mc1r_pigment_fate_int]; split <;> (try split) <;> omega
  · intro h; simp only [feather_type, mc1r_pigment_fate_int]; split <;> (try split) <;> omega
  · intro h; simp only [feather_type, mc1r_pigment_fate_int]; split <;> (try split) <;> omega
  · intro A' h; simp only [feather_type, mc1r_pigment_fate_int]; repeat (first | omega | split)
"""^^pk:lean4 ;
    skos:notation "A(\\tau) = A_i - a + a\\cos(2\\pi(\\tau - \\tfrac12)); \\quad \\text{type} = \\mathbb{I}(A_i \\ge \\theta_A) + \\mathbb{I}(A_i - 2a \\ge \\theta_A) \\in \\{0: b,\\; 1: y,\\; 2: \\text{fully pheomelanic}\\}; \\quad \\text{duty} = \\tfrac{1}{\\pi}\\arccos\\!\\big(\\tfrac{\\theta_A - (A_i - a)}{a}\\big)" ;
    prov:wasDerivedFrom <https://doi.org/10.1073/pnas.1816107116>,
        <https://doi.org/10.1126/science.1230374>,
        <https://doi.org/10.1126/science.aar4777>,
        <https://doi.org/10.1371/journal.pbio.3000448> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Somite-Prepatterned Stripe Spacing" ;
    pk:leanDeclaration "MathOfBiology.Loop_010.feather_type" ;
    pk:leanTheorem "MathOfBiology.Loop_010.agouti_pulse_duration_feather_type" ;
    pk:leanVerified true .


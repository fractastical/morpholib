sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L545–L572" ;
        dcterms:description "Feather-type trichotomy and yellow-pulse duty law on the ring niche (Lean Theorem 5)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L545-L572> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L574–L656" ;
        dcterms:description "Hexagonal 9-row/period follicle lattice sampling the body-wide u field; yellow rows per period readout" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L574-L656> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L659–L724" ;
        dcterms:description "3D cylindrical follicle opened into the (ell, s) sheet with chevron edge s_0 + k|ell| and regressed k_meas (Lean Theorem 4)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L659-L724> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean L121–L192" ;
        dcterms:description "Laws 4-5: ring_niche_chevron_geometry and agouti_pulse_duration_feather_type, verified with lean, 0 sorrys" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/lean/loops/Loop_010_avian_plumage_somite_stripes.lean#L121-L192> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018), Inaba et al. (2019) & Lin et al. (2013) somite-prepatterned Agouti signaling, melanocyte gap-junction reaction-diffusion and feather-follicle ring-niche chevrons in galliform plumage stripes — Model fidelity to source: 78/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The two-step Haupaix mechanism is now implemented end-to-end: somite prepattern -> dermal agouti band -> dose-dependent yellow-pulse duration -> feather type (b / y / fully pheomelanic), with the Lin (2013) ring niche and opened-cylinder chevron geometry (`niche_feather_type`, `niche_yellow_pulse_duty`, `build_feather_follicle_lattice`, `simulate_follicle_niche_cylinder`, L545-L724) and five Lean theorems (0 sorrys). Deductions: the PDE integrates a cubic-saturating linearisation around (0.46, 0.46) while the docstring/JSON write rational Gierer-Meinhardt kinetics (-6); the species widths come from an analytic Gaussian-threshold formula with an unexplained 1.13 sigma factor, not from the PDE, whose own yellow fraction is 0.35, not 0.44 (-5); the 'bead' dose-response is a fitted exponential (-3); the follicle model has no barb-ridge mechanics, pulp diffusion or regeneration cycle, and its a, k and dose multipliers are free parameters fitted to the row counts (-5); reverse chimeras are extrapolations (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2018-haupaix-avian-plumage-somite-stripes.py L286–L289: Cubic-saturating linearised kinetics, not the rational form in the reference JSON governing_pde <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L286-L289>",
            "2018-haupaix-avian-plumage-somite-stripes.py L351–L356: Species width from analytic Gaussian threshold with sigma_eff = 1.13 sigma; comment calls it 'PDE-coupled' but no PDE is run <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L351-L356>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-model-fidelity-4> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 010 Pass 3 autonomous loop assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018), Inaba et al. (2019) & Lin et al. (2013) somite-prepatterned Agouti signaling, melanocyte gap-junction reaction-diffusion and feather-follicle ring-niche chevrons in galliform plumage stripes — Parameter expressivity: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Agouti dose is now a genuine model axis: x0.60 / x1.00 / x2.80 gives 2 / 4 / 6 yellow rows with duty 0.38 / 0.60 / 1.00, monotone as Lean Theorem 5 requires, and `--agouti-scale` exposes it; the helical pitch k is swept over {0, 0.15, 0.35, 0.60, 0.90} with k_meas tracking k to 7e-4 and k = 0 giving a bar; `--chevron-pitch`, `--niche-dip`, `--rows-per-period` are exposed; beta_A and d controls are kept. Deductions: the dose multipliers are fitted to the target row counts rather than measured, and Fawn saturates (any scale >= 2.5 gives 6 rows) (-6); `--species` is parsed but never used (-4); the species axis is still the analytic formula, not the PDE (-3); 5-species and chimera panels unchanged (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L534–L542" ;
        dcterms:description "Fitted dose multipliers RB 0.60 / WT 1.00 / Fa 2.80 and Haupaix row-count references" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L534-L542> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L727–L773" ;
        dcterms:description "Chevron pitch sweep and agouti dose mutant panel" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L727-L773> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L1408–L1446" ;
        dcterms:description "CLI: --chevron-pitch, --niche-dip, --rows-per-period, --agouti-scale readout; --species is parsed at L1410 but unused" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L1408-L1446> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 010 Pass 3 autonomous loop assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


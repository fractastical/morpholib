sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018), Inaba et al. (2019) & Lin et al. (2013) somite-prepatterned Agouti signaling, melanocyte gap-junction reaction-diffusion and feather-follicle ring-niche chevrons in galliform plumage stripes — Reproducibility package: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic seed 2018, 12-check `--self-test` (L1312-L1405, ~4 s) covering the four SHA-256 locks, Lean Laws 1-5 as integer/monotonicity instances, PDE, species, chimeras, dose axis, controls, specimen CV, bitwise two-run determinism, lattice row counts, mutants and chevron geometry; the PNG regenerates byte-identically across runs (80cf4ed6...) and the default render takes ~7 s. Deductions: no requirements lock file is vendored for this slot (-4); matplotlib needs MPLCONFIGDIR when the home cache is unwritable and the README does not say so (-2); the GIF is unchanged from Pass 2 and does not show the follicle coupling (-2); `--species` is a dead flag (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-repro-package-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L1312–L1405" ;
        dct:description "12-check self_test including Pass 3 checks 9-12" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L1312-L1405> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L1408–L1452" ;
        dct:description "CLI with Pass 3 flags and the --agouti-scale JSON readout" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L1408-L1452> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "datasets/avian_plumage_somite_stripes/README.md L1–L31" ;
        dct:description "Dataset README with corrected citations, Pass 3 additions and the re-pinned SHA-256 table" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/datasets/avian_plumage_somite_stripes/README.md#L1-L31> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 010 Pass 3 autonomous loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


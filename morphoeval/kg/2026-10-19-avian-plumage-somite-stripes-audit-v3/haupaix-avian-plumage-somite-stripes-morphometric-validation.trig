    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-follicle-lattice-y-feather-fraction-vs-body-wide-pigment-map-yellow-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "follicle-lattice y-feather fraction vs body-wide pigment-map yellow fraction = 0.4444 fraction of follicles" ;

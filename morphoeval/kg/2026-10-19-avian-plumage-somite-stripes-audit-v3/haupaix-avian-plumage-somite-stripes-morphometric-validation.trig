sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018), Inaba et al. (2019) & Lin et al. (2013) somite-prepatterned Agouti signaling, melanocyte gap-junction reaction-diffusion and feather-follicle ring-niche chevrons in galliform plumage stripes — Morphometric validation: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1138-L1306) now returns 14 measurements. Three are against values the paper publishes: WT 4.0 yellow rows (ref 4), RB 2.0 (ref 2), Fa 6.0 (ref 5-6), with Fa 4 of 6 rows fully pheomelanic and the centre/edge duty ratio 1.88 (paper: > 1). Deductions: the eight Pass 2 measurements compare against mm widths and bead regimes that are not in the papers (reference JSON provenance flags), so 4 of 8 'reference-backed' comparisons are against unsourced numbers (-8); the chevron k error and the lattice-vs-body fraction are self-consistency checks (-4); the lattice y-fraction (0.444) differs from the body pigment-map fraction (0.35) by 0.094, exposing a 9-row vs 80-row quantisation mismatch (-4); no relative-yellow-band-length numbers from Fig. 3C / fig. S6 were digitised (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2018-haupaix-avian-plumage-somite-stripes.py L1225–L1305: Eight Pass 2 measurements retained; four reference values (species mm widths, chimera 0.608 mm, bead 0.24 mm) have no published source <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L1225-L1305>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-5-species-galliform-yellow-stripe-width-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-equal-diffusion-d-1-0-negative-control-activator-amplitude-std>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-exogenous-agouti-bead-dose-1-6-reciprocal-black-stripe-width-w-black>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-fawn-fa-quail-yellow-feather-rows-per-period>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-follicle-lattice-y-feather-fraction-vs-body-wide-pigment-map-yellow-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-japanese-quail-dorsal-yellow-pheomelanin-stripe-width-w-yellow>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-opened-follicle-chevron-pitch-k-measured-vs-helical-pitch-k-max-abs-error-over-sweep>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-pheasant-to-quail-heterospecific-somite-graft-yellow-stripe-width>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-recessive-black-rb-quail-yellow-feather-rows-per-period>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-count>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-segmented-coturnix-japonica-dorsal-yellow-pheomelanin-stripe-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-somite-prepatterned-2d-pde-longitudinal-orientation-index-o-ap>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-wild-type-quail-yellow-y-feather-rows-per-somitic-stripe-period>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-wt-centre-row-to-edge-row-relative-yellow-band-length-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-morphometric-validation-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-5-species-galliform-yellow-stripe-width-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-species galliform yellow stripe width correlation r = 0.9956 Pearson r" ;
        dct:description "r = 0.9956 (p = 3.49e-04), RMSE = 0.0675 mm" ;
        schema:measurementTechnique "Pearson correlation between simulated and empirical yellow stripe widths across quail, pheasant, guineafowl, partridge, and turkey" ;
        schema:name "5-species galliform yellow stripe width correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9956" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-5-species-galliform-yellow-stripe-width-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-5-species-galliform-yellow-stripe-width-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Haupaix et al. (2018) Science 361:eaar4777 Figs. 1-2 comparative galliform dataset" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-equal-diffusion-d-1-0-negative-control-activator-amplitude-std> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion (d=1.0) negative control activator amplitude std = 0.003331 std(u)" ;
        dct:description "positive d=20 std = 0.2485 vs equal-diffusion d=1 std = 3.33e-03" ;
        schema:measurementTechnique "Activator standard deviation at equal diffusivity d = Dv/Du = 1.0 (Cx40/inhibitor differential diffusion ablated)" ;
        schema:name "equal-diffusion (d=1.0) negative control activator amplitude std" ;
        schema:unitText "std(u)" ;
        schema:value "0.003331" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-equal-diffusion-d-1-0-negative-control-activator-amplitude-std-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-equal-diffusion-d-1-0-negative-control-activator-amplitude-std-reference> a schema:PropertyValue ;
        dct:source "Inaba et al. (2019) Science 363:eaaw1969 & Lean Theorem 3 agouti_mc1r_switch_and_cx40_turing_instability" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-exogenous-agouti-bead-dose-1-6-reciprocal-black-stripe-width-w-black> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "exogenous Agouti bead (dose=1.6) reciprocal black stripe width w_black = 0.1793 mm" ;
        dct:description "yellow expansion = +0.3507 mm, black narrowing = -0.3507 mm, period sum = 0.95 mm" ;
        schema:measurementTechnique "Complementary black eumelanin stripe width w_b = Lambda - w_y under moderate exogenous Agouti bead implantation" ;
        schema:name "exogenous Agouti bead (dose=1.6) reciprocal black stripe width w_black" ;
        schema:unitText "mm" ;
        schema:value "0.1793" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-exogenous-agouti-bead-dose-1-6-reciprocal-black-stripe-width-w-black-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-exogenous-agouti-bead-dose-1-6-reciprocal-black-stripe-width-w-black-reference> a schema:PropertyValue ;
        dct:source "Haupaix et al. (2018) Science 361:eaar4777 Fig. 4 & Lean Theorem 1 somite_stripe_period_conservation_and_agouti_bead_expansion" ;
        schema:value "0.24" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-measurement-fawn-fa-quail-yellow-feather-rows-per-period> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Fawn (Fa-/-) quail yellow feather rows per period = 6.0 feather rows" ;

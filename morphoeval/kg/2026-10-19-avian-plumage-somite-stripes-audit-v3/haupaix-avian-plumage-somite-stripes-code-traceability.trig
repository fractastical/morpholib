sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-haupaix-avian-plumage-somite-stripes> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-haupaix-avian-plumage-somite-stripes-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Haupaix et al. (2018), Inaba et al. (2019) & Lin et al. (2013) somite-prepatterned Agouti signaling, melanocyte gap-junction reaction-diffusion and feather-follicle ring-niche chevrons in galliform plumage stripes — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The module docstring (L1-L83) maps each mechanism to the paper and figure it comes from, states what was corrected and what remains a reduction, and names all five Lean theorems; the section 3b banner (L517-L532) states the modelling assumptions of the follicle reduction; the math KG YAML registers Laws 4-5 with Lean loci and code loci. Deductions: Panel B/C/D and the Pass 2 measurement strings still cite 'Haupaix Figs. 1-2' for mm widths the paper does not report (-6); the 'bead' naming persists in function and variable names (-3); the Lean laws are linked by name but the Python does not assert the integer instances of Theorem 4 (-2); some KG code loci span whole sections rather than the exact lines (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2018-haupaix-avian-plumage-somite-stripes.py L1225–L1242: Measurement strings still attribute the 0.42 mm quail width to 'Haupaix Figs. 1-2' <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L1225-L1242>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-code-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L1–L83" ;
        dct:description "Module docstring: corrected citations, Haupaix two-step mechanism, Lin ring niche, Theorems 1-5" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L1-L83> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2018-haupaix-avian-plumage-somite-stripes.py L517–L532" ;
        dct:description "Section 3b banner stating the reduced follicle model and its omissions" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/2018-haupaix-avian-plumage-somite-stripes.py#L517-L532> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-haupaix-avian-plumage-somite-stripes-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/haupaix-avian-plumage-somite-stripes.yaml L78–L123" ;
        dct:description "Laws 4-5 registered with Lean code, loci and Python code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/469bf3c/morphoeval/math_kg_loops/haupaix-avian-plumage-somite-stripes.yaml#L78-L123> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (Slot 010 Pass 3 autonomous loop assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


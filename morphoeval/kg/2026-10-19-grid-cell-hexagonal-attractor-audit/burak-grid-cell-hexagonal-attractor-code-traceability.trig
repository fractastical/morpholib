        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling — Code-to-model traceability: 60/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Links baseline functions to Burak & Fiete (2009) and Stensola et al. (2012), requiring full alignment with all 3 Lean 4 theorems in `Loop_088_grid_cell_hexagonal_attractor.lean`." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-code-traceability-1> ;
        pk:hasScore "0.6"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2008-burak-grid-cell-hexagonal-attractor.py L1–L7" ;
        dct:description "Baseline docstring citing Burak & Fiete (2009), Hafting et al. (2005), and Stensola et al. (2012)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py#L1-L7> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


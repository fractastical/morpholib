sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling — Model fidelity to source: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Evaluates only a static 3-cosine superposition (L41-61), omitting the 2D FFT Burak & Fiete (2009) 4-subpopulation (E, N, W, S) continuous attractor neural network PDE, annular Mexican-hat surround-inhibition kernel W_0(Delta_x), and velocity-driven bump phase integration along a 2D foraging trajectory." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2008-burak-grid-cell-hexagonal-attractor.py L41–L61: Static 3-cosine superposition without 4-subpopulation Burak-Fiete CANN PDE or 2D FFT surround inhibition <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py#L41-L61>" ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


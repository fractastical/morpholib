sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> a pk:Claim ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling faithfully reproduces Rattus norvegicus medial entorhinal cortex (MEC Layer II) & hippocampal-entorhinal circuit morphology" ;
        dcterms:description "The simulation script(s) 2008-burak-grid-cell-hexagonal-attractor.py implement the cited source model as published and produce forms that match real Rattus norvegicus medial entorhinal cortex (MEC Layer II) & hippocampal-entorhinal circuit specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 55.9/100, audit 2026-10-19-grid-cell-hexagonal-attractor-audit) and the assessments." ;
        dcterms:subject <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py; output: docs/media/grid_cell_hexagonal_attractor_comparison.png; organism: Rattus norvegicus medial entorhinal cortex (MEC Layer II) & hippocampal-entorhinal circuit; checkpoint commit: https://github.com/fractastical/morpholib/commit/317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: d708b4028fb6bc24d11a5b20d2c0b94776416b67d14792a0ba60270e21d2be62; artifact_sha256: 40360ed0659fb8b59a4d505550ae964db1b3d78965df7138d33bebd4f1434a4f; input_dataset_sha256: {datasets/grid_cell_hexagonal_attractor/grid_cell_hexagonal_attractor_reference.json=951b00ff56331c34..., datasets/grid_cell_hexagonal_attractor/paper_citations.bib=e1074e8d98b9dc00..., datasets/grid_cell_hexagonal_attractor/rat_entorhinal_hippocampal_specimen.jpg=63b3a392f8d0b25f..., datasets/grid_cell_hexagonal_attractor/scout_manifest.json=77ac05875318888d...}" ;
        pk:derivedFromPaper <https://doi.org/10.1038/nature03721>,
            <https://doi.org/10.1038/nature11649>,
            <https://doi.org/10.1126/science.1201652>,
            <https://doi.org/10.1371/journal.pcbi.1000291> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-specimen-match> ;
        pk:weightOfEvidence "0.559"^^xsd:double .


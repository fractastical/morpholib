sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-overall> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling — MorphoEval overall 55.9/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Pass 1 baseline assessment of `2008-burak-grid-cell-hexagonal-attractor.py` (56.9/100). The baseline script evaluates a static 3-wavevector cosine superposition without solving the 4-subpopulation (N, S, E, W) 2D FFT Burak-Fiete continuous attractor neural sheet PDE tau ds_theta/dt + s_theta = [sum_{theta'} W_0(x - x' - l e_hat(theta')) * s_{theta'} + B(1 + alpha v . e_hat(theta))]_+, omits 2D foraging path integration and rotational spatial autocorrelation gridness score G_60, omits the Brandon et al. (2011) medial-septum inactivation / l=0 pinned-bump ablation control, and displays the Rattus norvegicus hippocampal-entorhinal fluorescence micrograph without automated CV segmentation. Overall 55.9/100 (faithfulness 53.3, reproducibility 62.0); rubric morphoeval 0.1.0; checkpoint commit 317bc3c; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 56, Morphological realism / specimen match 50, Parameter expressivity 55, Morphometric validation 54, Source and data traceability 66, Code-to-model traceability 60, Reproducibility package 60. Output judged: docs/media/grid_cell_hexagonal_attractor_comparison.png: rendered output of 2008-burak-grid-cell-hexagonal-attractor.py at 317bc3c, image/png, 479407 B, 1100×880 px, artifact_sha256 40360ed0659fb8b59a4d505550ae964db1b3d78965df7138d33bebd4f1434a4f (sha256 40360ed0659fb8b59a4d505550ae964db1b3d78965df7138d33bebd4f1434a4f), spec_fingerprint d708b4028fb6bc24d11a5b20d2c0b94776416b67d14792a0ba60270e21d2be62. Dual provenance: spec_fingerprint: d708b4028fb6bc24d11a5b20d2c0b94776416b67d14792a0ba60270e21d2be62; artifact_sha256: 40360ed0659fb8b59a4d505550ae964db1b3d78965df7138d33bebd4f1434a4f; input_dataset_sha256: {datasets/grid_cell_hexagonal_attractor/grid_cell_hexagonal_attractor_reference.json=951b00ff56331c34..., datasets/grid_cell_hexagonal_attractor/paper_citations.bib=e1074e8d98b9dc00..., datasets/grid_cell_hexagonal_attractor/rat_entorhinal_hippocampal_specimen.jpg=63b3a392f8d0b25f..., datasets/grid_cell_hexagonal_attractor/scout_manifest.json=77ac05875318888d...}." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Add automated CV segmentation of the Rattus norvegicus hippocampal-entorhinal immunofluorescence micrograph (NeuN+ neuronal somata bands, MBP+ perforant-path fiber density, and dorso-ventral laminar profile), and render a 9-panel dark-mode synthesis figure and 24-frame animated GIF.",
            "remediation needed: Implement the 2D FFT Burak & Fiete (2009) 4-subpopulation (E, N, W, S) continuous attractor neural network PDE with shifted surround-inhibition kernels W_0(Delta_x - l e_hat(theta)) and threshold-linear rectification [.]_+.",
            "remediation needed: Simulate 2D foraging path integration, compute 2D spatial autocorrelation and 60 deg rotational gridness score G(theta) across all 4 Stensola et al. (2012) dorso-ventral modules {38, 54, 76, 108} cm, 90 deg square control, and Brandon et al. (2011) medial-septum inactivation (l=0, alpha=0) pinned-bump ablation control." ;
        pk:hasScore "0.559"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


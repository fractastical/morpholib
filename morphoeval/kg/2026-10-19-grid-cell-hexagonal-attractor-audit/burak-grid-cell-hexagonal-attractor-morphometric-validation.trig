sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-burak-grid-cell-hexagonal-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Burak & Fiete (2009), Hafting et al. (2005) & Stensola et al. (2012) entorhinal grid-cell hexagonal continuous attractor & discrete sqrt(2) module scaling — Morphometric validation: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Reports only 2 baseline metrics in `measure_morphoeval()`, lacking the 2D spatial autocorrelation 60 deg rotational gridness score G_60, 2D foraging path-integration tracking correlation r, pinned-bump ablation phase shift collapse, and specimen CV morphometrics." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2008-burak-grid-cell-hexagonal-attractor.py L98–L121: Baseline 2-metric measure_morphoeval() hook without G_60 gridness or path-integration correlation <https://github.com/fractastical/morpholib/blob/317bc3c/2008-burak-grid-cell-hexagonal-attractor.py#L98-L121>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-static-3-cosine-hexagonal-planform-peak-to-mean-contrast>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-stensola-et-al-2012-dorso-ventral-module-scale-ratio-lambda-m-1-lambda-m> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-static-3-cosine-hexagonal-planform-peak-to-mean-contrast> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Static 3-cosine hexagonal planform peak-to-mean contrast = 6.0168 ratio" ;
        dct:description "Peak-to-mean = 6.0168" ;
        schema:measurementTechnique "Peak-to-mean ratio of rectified 3-wavevector cosine superposition" ;
        schema:name "Static 3-cosine hexagonal planform peak-to-mean contrast" ;
        schema:unitText "ratio" ;
        schema:value "6.0168" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-static-3-cosine-hexagonal-planform-peak-to-mean-contrast-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-static-3-cosine-hexagonal-planform-peak-to-mean-contrast-reference> a schema:PropertyValue ;
        dct:source "Burak & Fiete (2009) PLoS Comput. Biol. 5:e1000291" ;
        schema:value "3.5" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-stensola-et-al-2012-dorso-ventral-module-scale-ratio-lambda-m-1-lambda-m> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Stensola et al. (2012) dorso-ventral module scale ratio lambda_{m+1}/lambda_m = 1.4165 dimensionless ratio" ;
        dct:description "Mean scale ratio = 1.4165" ;
        schema:measurementTechnique "Mean ratio of consecutive module wavelengths in {38, 54, 76, 108} cm" ;
        schema:name "Stensola et al. (2012) dorso-ventral module scale ratio lambda_{m+1}/lambda_m" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "1.4165" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-stensola-et-al-2012-dorso-ventral-module-scale-ratio-lambda-m-1-lambda-m-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-burak-grid-cell-hexagonal-attractor-measurement-stensola-et-al-2012-dorso-ventral-module-scale-ratio-lambda-m-1-lambda-m-reference> a schema:PropertyValue ;
        dct:source "Stensola et al. (2012) Nature 492:72-78" ;
        schema:value "1.4142" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


        <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-burak-grid-cell-hexagonal-attractor-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-grid-cell-hexagonal-attractor-audit-burak-grid-cell-hexagonal-attractor-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-grid-cell-hexagonal-attractor-audit-burak-grid-cell-hexagonal-attractor-2> ;
    pk:hypothesisType "2D Toroidal Continuous Attractor Neural Network (CANN) with Velocity-Shifted Asymmetric Surround Inhibition & Quadratic Resonant Triad Selection of 60 deg Hexagonal Planforms" ;

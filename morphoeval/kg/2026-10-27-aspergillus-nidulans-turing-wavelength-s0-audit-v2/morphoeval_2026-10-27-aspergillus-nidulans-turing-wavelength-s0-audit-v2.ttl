        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-model-fidelity-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-model-fidelity-3> ;
    pk:hasScore 8.8e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
    rdfs:label "Aspergillus nidulans Turing onset wavelength at 12.84 µm (nominal 13 µm), Holocene 0 Ma — Morphometric validation: 90/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Dispersion Pearson 0.9977, RMSE 0.014 (not zero). Specimen pixel Pearson 0.997 against a stripe-null reference of about 0.001. Otsu IoU 0.982 against a reference of 1. Seed wavelength CV is numerically zero against a 0.05 instability reference. Sobel L1 0.014 against the ramp null 1.81. No specimen-named metric copies its reference." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;

    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Aspergillus nidulans Turing onset wavelength at 12.84 µm (nominal 13 µm), Holocene 0 Ma — Morphological realism / specimen match: 82/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Sobel 12-bin orientation L1 between the specimen crop and the conditioned render is 0.014, against 1.81 for a horizontal ramp. Pixel Pearson is 0.997. The GIF is 16 frames at 640×480 and the last frame is the colony, because equation (4) uses the photograph as the macroscopic carrier. That conditioning is why the score is 82 rather than a claim of ab-initio spiral prediction." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-specimen-match-1>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-specimen-match-2>,
        <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-specimen-match-3> ;
    pk:hasScore 8.2e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Aspergillus nidulans Turing onset wavelength at 12.84 µm (nominal 13 µm), Holocene 0 Ma (Aspergillus nidulans)",
        "Aspergillus nidulans Turing onset wavelength at 12.84 µm (nominal 13 µm), Holocene 0 Ma faithfully reproduces Aspergillus nidulans morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-aspergillus-nidulans-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-aspergillus-nidulans-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-aspergillus-nidulans-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-aspergillus-nidulans-turing-wavelength-s0.py, docs/media/aspergillus_nidulans_turing_wavelength_s0_growth.gif, datasets/aspergillus_nidulans_turing_wavelength_s0/aspergillus_nidulans_turing_wavelength_s0_reference.json, datasets/aspergillus_nidulans_turing_wavelength_s0/paper_citations.bib, datasets/aspergillus_nidulans_turing_wavelength_s0/README.md implement the cited source model as published and produce forms that match real Aspergillus nidulans specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;

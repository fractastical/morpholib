    pk:hasScore 9.1e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-repro-package> a pk:LLMClaimAssessment ;
    rdfs:label "Aspergillus nidulans Turing onset wavelength at 12.84 µm (nominal 13 µm), Holocene 0 Ma — Reproducibility package: 92/100" ;

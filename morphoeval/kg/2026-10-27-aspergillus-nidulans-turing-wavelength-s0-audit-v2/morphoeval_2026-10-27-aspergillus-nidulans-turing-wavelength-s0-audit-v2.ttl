    pk:hasScore 9.2e-01 ;
    pk:hasVerdict "faithful" .

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aspergillus-nidulans-turing-wavelength-s0-source-traceability> a pk:LLMClaimAssessment ;

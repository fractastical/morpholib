sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops — Model fidelity to source: 56/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Integrates a single-cell two-face PIN1 carrier competition ODE for p=1 and p=2 (L23-49), but omits the 2D hexagonal leaf lamina lattice (6 faces per cell), explicit verification of intracellular pool conservation across all 6 faces, saturating Hill carrier allocation Phi(J) = J^n/(K^n+J^n), Scarpella et al. (2006) epidermal PIN1 convergence points and bipolar bridge cells, and Betti-1 loop topological transition." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-1> ;
        pk:hasScore "0.56"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py L23–L49" ;
        dcterms:description "Single-cell 2-face ODE without 2D hexagonal lamina lattice or saturating Hill loop closure" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L23-L49> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


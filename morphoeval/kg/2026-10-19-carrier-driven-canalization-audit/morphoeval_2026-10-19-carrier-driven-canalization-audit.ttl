<https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops — Model fidelity to source: 56/100" ;
    dct:date "2026-10-19"^^xsd:date ;
    dct:description "Integrates a single-cell two-face PIN1 carrier competition ODE for p=1 and p=2 (L23-49), but omits the 2D hexagonal leaf lamina lattice (6 faces per cell), explicit verification of intracellular pool conservation across all 6 faces, saturating Hill carrier allocation Phi(J) = J^n/(K^n+J^n), Scarpella et al. (2006) epidermal PIN1 convergence points and bipolar bridge cells, and Betti-1 loop topological transition." ;
    dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
    pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
    pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-feugier-carrier-driven-canalization-model-fidelity-1> ;
    pk:hasScore 5.6e-01 ;
    pk:hasVerdict "partially faithful" .


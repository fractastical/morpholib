<https://w3id.org/probknow/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/probknow/resource/math-law/feugier-carrier-driven-canalization-1>,
        <https://w3id.org/probknow/resource/math-law/feugier-carrier-driven-canalization-2>,
        <https://w3id.org/probknow/resource/math-law/feugier-carrier-driven-canalization-3> .

<https://w3id.org/probknow/resource/math-law/feugier-carrier-driven-canalization-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Feugier et al. (2005) Hexagonal Intracellular PIN1 Carrier Pool Conservation Law" ;
    dct:description "Proves exact state and rate conservation of total intracellular + membrane PIN1 efflux carriers across all 6 faces of each hexagonal leaf lamina cell, creating resource competition among faces for cytoplasmic PIN1 vesicles | Variables: P_{i,cyt}: cytoplasmic PIN1 carrier pool in cell i; P_{ij} (j=1..6): membrane PIN1 carrier density on face j of hexagonal cell i; P_{total}: conserved total cellular carrier pool; k_1, k_2: exocytosis and endocytosis rates; Φ(J_{i→j}): flux-dependent carrier recruitment function" ;
    dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236(3):313-325 Eqs. 4-6" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L95-L210>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_035_carrier_driven_canalization.lean#L27-L61> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def cytoplasmic_pin_pool (P_total P1 P2 P3 P4 P5 P6 : Int) : Int :=
  P_total - (P1 + P2 + P3 + P4 + P5 + P6)
def membrane_face_rhs (k1 k2 Phi_j P_cyt P_j : Int) : Int :=
  k1 * Phi_j * P_cyt - k2 * P_j
theorem feugier_2005_hexagonal_pin_pool_conservation
    (P_total k1 k2 Phi1 Phi2 Phi3 Phi4 Phi5 Phi6 P_cyt P1 P2 P3 P4 P5 P6 : Int) :
    cytoplasmic_pin_pool P_total P1 P2 P3 P4 P5 P6 + (P1 + P2 + P3 + P4 + P5 + P6) = P_total ∧
    cytoplasmic_pool_rhs k1 k2 Phi1 Phi2 Phi3 Phi4 Phi5 Phi6 P_cyt P1 P2 P3 P4 P5 P6 +
      (membrane_face_rhs k1 k2 Phi1 P_cyt P1 +
       membrane_face_rhs k1 k2 Phi2 P_cyt P2 +
       membrane_face_rhs k1 k2 Phi3 P_cyt P3 +
       membrane_face_rhs k1 k2 Phi4 P_cyt P4 +
       membrane_face_rhs k1 k2 Phi5 P_cyt P5 +
       membrane_face_rhs k1 k2 Phi6 P_cyt P6) = 0
"""^^pk:lean4 ;
    skos:notation "P_{i,cyt} + ∑_{j=1}^6 P_{ij} = P_{total},   dP_{i,cyt}/dt + ∑_{j=1}^6 dP_{ij}/dt = ∑_{j=1}^6 (k_2 P_{ij} - k_1 Φ(J_{i→j}) P_{i,cyt}) + ∑_{j=1}^6 (k_1 Φ(J_{i→j}) P_{i,cyt} - k_2 P_{ij}) = 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.03.017>,
        <https://doi.org/10.1101/gad.1402406>,
        <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
        <https://doi.org/10.1371/journal.pcbi.1000207> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "PIN1 Efflux Carrier Allocation & Intracellular Pool Conservation on Hexagonal Leaf Lamina Lattices" ;
    pk:leanDeclaration "MathOfBiology.Loop_035.cytoplasmic_pin_pool" ;
    pk:leanTheorem "MathOfBiology.Loop_035.feugier_2005_hexagonal_pin_pool_conservation" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/feugier-carrier-driven-canalization-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Feugier et al. (2005) & Scarpella et al. (2006) Winner-Take-All Open Tree vs Saturating Co-Polarized Closed Loop Law" ;
    dct:description "Proves why non-saturating superlinear exocytosis (Φ(J) = J^2) forces winner-take-all polarization onto a single efflux face per cell—forbidding loop connections and producing strictly open dendritic trees (β_1 = 0)—whereas saturating Hill exocytosis allows two high-flux faces to co-polarize (bipolar PIN1 bridge cells observed by Scarpella et al. 2006), closing reticulate venation loops (β_1 > 0) | Variables: P_1, P_2: PIN1 carrier concentrations on two efflux faces of a hexagonal cell; P_{cyt}: shared cytoplasmic PIN1 pool; ΔS: downstream auxin concentration drop; Φ_{max}: saturated Hill exocytosis ceiling; β_1 = E - V + C: venation graph Betti-1 loop count" ;
    dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236(3):313-325 Eqs. 7-11 & Figs. 3-7; Scarpella et al. (2006) Genes Dev. 20:1015-1027 Figs. 3-5" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L215-L385>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_035_carrier_driven_canalization.lean#L84-L108> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def model_a_quadratic_face_rhs (k1 k2 P_cyt dS P : Int) : Int :=
  k1 * (P * dS) * (P * dS) * P_cyt - k2 * P
def model_b_saturated_face_rhs (k1 k2 Phi_max P_cyt P : Int) : Int :=
  k1 * Phi_max * P_cyt - k2 * P
theorem feugier_2005_winner_take_all_vs_saturating_bipolar
    (k1 k2 Phi_max P_cyt dS P1 P2 : Int) :
    P2 * model_a_quadratic_face_rhs k1 k2 P_cyt dS P1 -
      P1 * model_a_quadratic_face_rhs k1 k2 P_cyt dS P2 =
      k1 * P_cyt * dS * dS * P1 * P2 * (P1 - P2) ∧
    P2 * model_b_saturated_face_rhs k1 k2 Phi_max P_cyt P1 -
      P1 * model_b_saturated_face_rhs k1 k2 Phi_max P_cyt P2 =
      k1 * Phi_max * P_cyt * (P2 - P1)
"""^^pk:lean4 ;
    skos:notation "P_2 dP_1/dt - P_1 dP_2/dt = k_1 P_{cyt} (ΔS)^2 P_1 P_2 (P_1 - P_2) (Model A, Φ(J)=J^2, open tree β_1=0)  vs  k_1 Φ_{max} P_{cyt} (P_2 - P_1) (Model B, Φ(J)=J^n/(K^n+J^n)→Φ_{max}, bipolar loop closure β_1>0)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.03.017>,
        <https://doi.org/10.1101/gad.1402406>,
        <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
        <https://doi.org/10.1371/journal.pcbi.1000207> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "PIN1 Efflux Carrier Allocation & Intracellular Pool Conservation on Hexagonal Leaf Lamina Lattices" ;
    pk:leanDeclaration "MathOfBiology.Loop_035.model_a_quadratic_face_rhs" ;
    pk:leanTheorem "MathOfBiology.Loop_035.feugier_2005_winner_take_all_vs_saturating_bipolar" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/feugier-carrier-driven-canalization-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Feugier et al. (2005) Directional Carrier-Mediated Auxin Flux Antisymmetry Law" ;
    dct:description "Proves exact pairwise intercellular auxin flux conservation across every hexagonal cell-wall edge while demonstrating pure carrier-driven polar transport at homogeneous auxin concentration | Variables: J_{i→j}: net intercellular auxin flux from hexagonal cell i to neighbor j; P_{ij}, P_{ji}: opposing plasma-membrane PIN1 carrier densities; S_i, S_j: intracellular auxin concentrations; D: passive apoplastic permeability" ;
    dct:source "Feugier, Mochizuki & Iwasa (2005) J. Theor. Biol. 236(3):313-325 Eqs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L390-L490>,
        <https://github.com/fractastical/morpholib/blob/8871db0/morphoeval/lean/loops/Loop_035_carrier_driven_canalization.lean#L121-L135> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def carrier_auxin_flux (P_ij P_ji D S_i S_j : Int) : Int :=
  P_ij * S_i - P_ji * S_j + D * (S_i - S_j)
theorem feugier_2005_flux_antisymmetry_and_polarity (P_ij P_ji D S_i S_j S : Int) :
    carrier_auxin_flux P_ij P_ji D S_i S_j +
      carrier_auxin_flux P_ji P_ij D S_j S_i = 0 ∧
    carrier_auxin_flux P_ij P_ji D S S = (P_ij - P_ji) * S
"""^^pk:lean4 ;
    skos:notation "J_{i→j} = P_{ij} S_i - P_{ji} S_j + D(S_i - S_j)  ⇒  J_{i→j} + J_{j→i} = 0  ∧  J_{i→j}(S,S) = (P_{ij} - P_{ji}) S" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/j.jtbi.2005.03.017>,
        <https://doi.org/10.1101/gad.1402406>,
        <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
        <https://doi.org/10.1371/journal.pcbi.1000207> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "PIN1 Efflux Carrier Allocation & Intracellular Pool Conservation on Hexagonal Leaf Lamina Lattices" ;
    pk:leanDeclaration "MathOfBiology.Loop_035.carrier_auxin_flux" ;
    pk:leanTheorem "MathOfBiology.Loop_035.feugier_2005_flux_antisymmetry_and_polarity" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (ProbKnow rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> .


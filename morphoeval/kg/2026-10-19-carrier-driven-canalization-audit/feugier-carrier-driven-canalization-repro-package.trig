sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops — Reproducibility package: 54/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Includes a minimal `--self-test` check, but lacks SHA-256 dataset integrity verification, `gnom`/`pin1` exocytosis ablation negative control, and multi-law invariant assertions." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2005-feugier-carrier-driven-canalization.py L98–L111: Minimal 1-assertion self-test without dataset SHA-256 or ablation checks <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py#L98-L111>" ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 035 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


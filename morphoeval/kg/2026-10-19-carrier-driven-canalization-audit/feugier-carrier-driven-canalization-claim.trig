sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-feugier-carrier-driven-canalization> a pk:Claim ;
        rdfs:label "Feugier, Mochizuki & Iwasa (2005) & Scarpella et al. (2006) PIN1 efflux carrier allocation, intracellular pool conservation, and open dendritic trees vs closed reticulate venation loops faithfully reproduces Arabidopsis thaliana (dicot leaf lamina and procambial venation network) morphology" ;
        dct:description "The simulation script(s) 2005-feugier-carrier-driven-canalization.py implement the cited source model as published and produce forms that match real Arabidopsis thaliana (dicot leaf lamina and procambial venation network) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 54.1/100, audit 2026-10-19-carrier-driven-canalization-audit) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py; output: docs/media/carrier_driven_canalization_comparison.png; organism: Arabidopsis thaliana (dicot leaf lamina and procambial venation network); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 2ca741f07ba825a876d0c45589ff7d455ac853c85ef60af0feb96546555dd50c; artifact_sha256: 2d5b0781a005c1b7c878d9f96f9ac6cd6599e509cdfd967fe1f5303bf1ee9108; input_dataset_sha256: {datasets/carrier_driven_canalization/carrier_driven_canalization_reference.json=d1b984c1cb7883c5..., datasets/carrier_driven_canalization/leaf_tip_venation_loops_specimen.jpg=e54c8add6cf7c916..., datasets/carrier_driven_canalization/paper_citations.bib=cb81009f386f3a51..., datasets/carrier_driven_canalization/scout_manifest.json=1de2b4f4c53ac234...}" ;
        pk:derivedFromPaper <https://doi.org/10.1016/j.jtbi.2005.03.017>,
            <https://doi.org/10.1101/gad.1402406>,
            <https://doi.org/10.1111/j.1365-313X.2005.02581.x>,
            <https://doi.org/10.1371/journal.pcbi.1000207> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-feugier-carrier-driven-canalization-specimen-match> ;
        pk:weightOfEvidence "0.541"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/8871db0/2005-feugier-carrier-driven-canalization.py> a schema:SoftwareSourceCode ;
        rdfs:label "2005-feugier-carrier-driven-canalization.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "8871db0" .
}


<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Jacobian trace-determinant stability at 15.49 µm" ;
    dct:description "Homogeneous steady state stays stable while a finite band of wavenumbers can still go unstable once D_v >> D_u | Variables: f_u = 0.720 s^-1, f_v = -0.860, g_u = 1.100, g_v = -1.280 at the holaspis18 cuticle" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Schnakenberg 1979 DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3127_aulacopleura_koninckii_holaspis18_turing_wavelength_s0.lean#L9-L18> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "trace(J) = f_u + g_v < 0 and det(J) = f_u g_v - f_v g_u > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/pab.2016.5>,
        <https://doi.org/10.1086/381042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3127.traceMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3127.homogeneous_state_stable" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical Turing wavenumber" ;
    dct:description "Selects the pigment-stripe / ocellus wavelength at the 15 µm detail scale | Variables: D_v / D_u = 40; D_u is solved so that lambda_c = 15.49 µm on the holaspis18 pitch" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3127_aulacopleura_koninckii_holaspis18_turing_wavelength_s0.lean#L20-L25> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); lambda_c = 2 pi / k_c = 15.49 µm" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/pab.2016.5>,
        <https://doi.org/10.1086/381042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3127.turingNumeratorMilli" ;
    pk:leanTheorem "MathOfBiology.Loop_3127.inhibitor_diffusion_opens_a_band" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries mode count at fixed wavelength" ;
    dct:description "At 428.3 Ma the 18-segment holaspid sits between the 428.5 Ma meraspis and the 428.1 Ma 22-segment holaspid; k_c itself does not change | Variables: floor pitches 79, 175 and 224 µm at lambda = 15 µm give mode counts 5, 11 and 14" ;
    dct:source "Fusco et al. 2004 DOI:10.1086/381042; Fusco, Hong and Hughes 2016 DOI:10.1017/pab.2016.5" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3127_aulacopleura_koninckii_holaspis18_turing_wavelength_s0.lean#L27-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N = pitch_um / lambda_um; N(meraspis) < N(holaspis18) < N(holaspis22)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1017/pab.2016.5>,
        <https://doi.org/10.1086/381042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3127.modeCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3127.holaspis18_mode_between_chronospecies" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


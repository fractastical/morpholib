<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Turing wavenumber at 15.49 µm on Aulacopleura koninckii holaspis18 (428.3 Ma) (Aulacopleura koninckii_holaspis18)",
        "Turing wavenumber at 15.49 µm on Aulacopleura koninckii holaspis18 (428.3 Ma) faithfully reproduces Aulacopleura koninckii_holaspis18 morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-3> ;
    dct:description "The simulation script(s) models/2026-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Aulacopleura koninckii_holaspis18 specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0.py> ;
    schema:about "Aulacopleura koninckii_holaspis18" ;
    schema:additionalProperty "does_not_claim: Does not claim a published holochroal lens diameter of 15.49 µm for this species.",
        "does_not_claim: Does not claim a second assessor.",
        "does_not_claim: Does not claim the chroma mask is a histological outline of the pleurae.",
        "reconstructed_in_script: Cuticle mask from red-minus-green chroma, 70th percentile, largest component.",
        "reconstructed_in_script: Jacobian and D_v/D_u = 40 solved so lambda_c = 15.49 µm = 1.549e-05 m at 428.3 Ma.",
        "reconstructed_in_script: Mode counts 5, 11 and 14. Midline rib Pearson r = 0.9832; lateral transect Pearson r = 0.9863.",
        "reconstructed_in_script: Rib-span fraction 0.2245 on the pinned photograph, applied to the meraspis (4.2 mm, 12 segments, 428.5 Ma) and holaspis22 (22 mm, 22 segments, 428.1 Ma) lengths.",
        "reported_in_source: Commons File:Aulacopleura konincki.jpg, 14 mm, Silurian, CC BY-SA 3.0.",
        "reported_in_source: Fusco, Hong & Hughes 2016: axial growth gradients along the trunk.",
        "reported_in_source: Hughes & Chapman 1995 and Fusco et al. 2004: meraspid segment addition and a variable holaspid thoracic number, including 18 segments.",
        "reported_in_source: Turing 1952: reaction-diffusion selects a finite critical wavelength.",
        "transfer_boundary: The photograph resolves pleural ribs at hundreds of micrometres. The 15.49 µm wavelength is the cellular-scale law, not a feature counted on the photograph.",
        "transfer_boundary: species_gallery meraspis / holaspis18 / holaspis22 JPEGs are byte-identical, so only the Commons photograph is an independent image." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Aulacopleura koninckii_holaspis18 (Silurian (Wenlock Epoch, 428.3 Ma))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "II. Anaima (Invertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;

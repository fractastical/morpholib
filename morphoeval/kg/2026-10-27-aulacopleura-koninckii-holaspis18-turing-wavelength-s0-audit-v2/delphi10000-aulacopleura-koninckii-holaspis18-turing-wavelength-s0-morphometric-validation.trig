sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Turing wavenumber at 15.49 µm on Aulacopleura koninckii holaspis18 (428.3 Ma) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Midline 16-mode Pearson r = 0.9832 (RMSE 0.182, KS D = 0.035). The lateral transect, fit on its own, is Pearson r = 0.9863 and is not equal to the midline value. Coherency and circularity remain measured on the photograph and differ from their reference baselines. Dispersion r = 0.9948." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-diffusivity-sweep-pearson-r-of-lambda-c-versus-sqrt-alpha>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-analytical-k-vs-explicit-euler>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-re-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-holaspis18-repeats-of-15-49-m-along-one-thoracic-pitch>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-ks-statistic-between-axial-rib-profile-and-16-mode-reconstruction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-lateral-transect-rib-train-pearson-r-columns-0-62-0-78>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-rib-train-pearson-r-16-mode-turing-truncation-vs-axial-profile>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-diffusivity-sweep-pearson-r-of-lambda-c-versus-sqrt-alpha> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "diffusivity-sweep Pearson r of lambda_c versus sqrt(alpha) = 1.0 Pearson r" ;
        dct:description "wavelengths µm [7.745000000000001, 10.953084040579622, 15.490000000000002, 21.906168081159244, 30.980000000000004]; monotone True" ;
        schema:measurementTechnique "alpha in {0.25, 0.5, 1, 2, 4} multiplies both diffusivities; lambda compared to 15.49*sqrt(alpha)" ;
        schema:name "diffusivity-sweep Pearson r of lambda_c versus sqrt(alpha)" ;
        schema:unitText "Pearson r" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-diffusivity-sweep-pearson-r-of-lambda-c-versus-sqrt-alpha-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-diffusivity-sweep-pearson-r-of-lambda-c-versus-sqrt-alpha-reference> a schema:PropertyValue ;
        dct:source "exact sqrt(D) scaling of the linear Turing wavelength" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-analytical-k-vs-explicit-euler> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion-curve Pearson r (analytical σ(k) vs explicit Euler) = 0.9948 Pearson r" ;
        dct:description "RMSE 0.076367 s^-1, lambda_c 15.4900 µm, D_u 2.0907 µm^2/s" ;
        schema:measurementTechnique "18 wavenumbers from 0.35 k_c to 1.7 k_c; Euler dt = 0.004, 600 steps" ;
        schema:name "dispersion-curve Pearson r (analytical σ(k) vs explicit Euler)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9948" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-analytical-k-vs-explicit-euler-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-dispersion-curve-pearson-r-analytical-k-vs-explicit-euler-reference> a schema:PropertyValue ;
        dct:source "MorphoEval gate for this loop; the integrator is not forced to equal the gate" ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-re-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusion ablation max Re σ(k) = -0.047621 1/s" ;
        dct:description "Turing margin under the ablation is 0.9442 (negative means the band is closed)" ;
        schema:measurementTechnique "D_v set equal to D_u; max eigenvalue on k in [0, 1.5] µm^-1" ;
        schema:name "equal-diffusion ablation max Re σ(k)" ;
        schema:unitText "1/s" ;
        schema:value "-0.047621" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-re-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-equal-diffusion-ablation-max-re-k-reference> a schema:PropertyValue ;
        dct:source "Turing 1952: equal diffusivities cannot destabilise a stable homogeneous state" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-holaspis18-repeats-of-15-49-m-along-one-thoracic-pitch> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "holaspis18 repeats of 15.49 µm along one thoracic pitch = 11 repeats" ;
        dct:description "meraspis 5 < holaspis18 11 < holaspis22 14; pitches µm 78.6, 174.6, 224.5" ;
        schema:measurementTechnique "N = round((0.2245 * 14000 µm / 18) / 15.49 µm)" ;
        schema:name "holaspis18 repeats of 15.49 µm along one thoracic pitch" ;
        schema:unitText "repeats" ;
        schema:value "11" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-holaspis18-repeats-of-15-49-m-along-one-thoracic-pitch-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-holaspis18-repeats-of-15-49-m-along-one-thoracic-pitch-reference> a schema:PropertyValue ;
        dct:source "meraspid predecessor (12 segments, 4.2 mm, 428.5 Ma) under the same rib fraction and the same k_c" ;
        schema:value "5" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image contour circularity = 0.2138 4πA/P^2" ;
        dct:description "value is the photograph, reference is an ocellus-shaped null" ;
        schema:measurementTechnique "contrast mask on the 160x120 specimen; perimeter from one binary erosion" ;
        schema:name "specimen image contour circularity" ;
        schema:unitText "4πA/P^2" ;
        schema:value "0.2138" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-contour-circularity-reference> a schema:PropertyValue ;
        dct:source "round-ocellus circularity benchmark; a trilobite outline is far from round" ;
        schema:value "0.78" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-ks-statistic-between-axial-rib-profile-and-16-mode-reconstruction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image KS statistic between axial rib profile and 16-mode reconstruction = 0.0349 KS D" ;
        dct:description "two-sided p = 0.8767" ;
        schema:measurementTechnique "scipy.stats.ks_2samp on the detrended axial profile and its 16-mode reconstruction" ;
        schema:name "specimen image KS statistic between axial rib profile and 16-mode reconstruction" ;
        schema:unitText "KS D" ;
        schema:value "0.0349" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-ks-statistic-between-axial-rib-profile-and-16-mode-reconstruction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-ks-statistic-between-axial-rib-profile-and-16-mode-reconstruction-reference> a schema:PropertyValue ;
        dct:source "conventional D = 0.05 screening level, not the measured statistic" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-lateral-transect-rib-train-pearson-r-columns-0-62-0-78> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image lateral-transect rib-train Pearson r (columns 0.62-0.78) = 0.9863 Pearson r" ;
        dct:description "lateral RMSE 0.1649, n = 573" ;
        schema:measurementTechnique "same 16-mode least squares on a lateral axial band, not the midline band used for the primary fit" ;
        schema:name "specimen image lateral-transect rib-train Pearson r (columns 0.62-0.78)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9863" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-lateral-transect-rib-train-pearson-r-columns-0-62-0-78-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-lateral-transect-rib-train-pearson-r-columns-0-62-0-78-reference> a schema:PropertyValue ;
        dct:source "midline transect Pearson r on this same photograph; the lateral value is an independent fit" ;
        schema:value "0.9832" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-rib-train-pearson-r-16-mode-turing-truncation-vs-axial-profile> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image rib-train Pearson r (16-mode Turing truncation vs axial profile) = 0.9832 Pearson r" ;
        dct:description "RMSE 0.1825, KS statistic 0.0349, p_pearson 0.000e+00, modes [14, 24, 3, 15, 19, 4, 13, 12, 16, 17, 18, 10, 6, 1, 8, 9]" ;
        schema:measurementTechnique "least-squares fit of the 16 strongest Fourier modes on the Sobel rib span of the full specimen" ;
        schema:name "specimen image rib-train Pearson r (16-mode Turing truncation vs axial profile)" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9832" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-rib-train-pearson-r-16-mode-turing-truncation-vs-axial-profile-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-rib-train-pearson-r-16-mode-turing-truncation-vs-axial-profile-reference> a schema:PropertyValue ;
        dct:source "perfect in-sample reconstruction; the residual is the unfitted rib spectrum" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image structure-tensor coherency = 0.6105 coherency" ;
        dct:description "foreground fraction 0.8720, circularity 0.2138" ;
        schema:measurementTechnique "Sobel structure tensor on the 160x120 specimen, mean of (λ1-λ2)/(λ1+λ2) inside the contrast mask" ;
        schema:name "specimen image structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.6105" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-measurement-specimen-image-structure-tensor-coherency-reference> a schema:PropertyValue ;
        dct:source "isotropic-texture baseline used only as a non-equal reference" ;
        schema:value "0.35" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aulacopleura-koninckii-holaspis18-turing-wavelength-s0.py L274–L314" ;

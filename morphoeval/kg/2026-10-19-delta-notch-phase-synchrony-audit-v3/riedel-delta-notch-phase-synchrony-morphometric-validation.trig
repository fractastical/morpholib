sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony on an advected FGF8/Wnt-graded PSM lattice: kinematic waves, Mib1-gated coupling, emergent DAPT ALD/PRP — Morphometric validation: 88/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The validation is now genuine where Pass 2's was circular: emergent ALD/PRP from the simulated coherence trajectory are compared with the Riedel-Kruse (2007) observations across 5 regimes and 5 seeds (ALD 5.41 / 9.21 / 14.24 vs 5.4 / 9.6 / 14.4 somites, PRP 14.86 vs 14.7; RMSE 0.22 somites, all within 1 observed SD; `evaluate_dapt_regimes` L661-715, `regime_validation_statistics` L718-744) and 8 measurements carry references and units (L863-964). Deductions: D_phi, sigma_omega and tau_wash were calibrated against these same ALD/PRP data (L161-162, L174), so only the unit slope across s_in = 0/4/9 and the PRP are out-of-sample (-5); the 5-regime Pearson r (0.9998) is inflated by the WT no-defect sentinel 31.0 (L735 excludes it only from the RMSE; the perturbed-only r is 0.9986) (-2); the N_w measurement's reference is the model's own analytic law and the mib1-null reference is the 1/sqrt(12) random-phase floor (L939, L949) - internal consistency, not biology (-3); the specimen spacing reference 48.47 px is the script's own previous measurement (L958) (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2006-riedel-delta-notch-phase-synchrony.py L161–L163: D_phi and sigma_omega calibrated to the ALD data (declared); tau_wash L174 chosen to land the PRP <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L161-L163>",
            "2006-riedel-delta-notch-phase-synchrony.py L939–L949: N_w reference = sim_wt['n_waves_analytic'] and mib1-null reference = 0.29 random-phase floor: model-internal references <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L939-L949>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-delayed-kuramoto-collective-synchronization-period-t-sync-vs-autonomous-t-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-effective-in-phase-linear-stability-stiffness-kappa-eff-kappa-cos-omega-tau-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-emergent-dapt-pulse-chase-anterior-limit-of-defects-ald-at-s-in-0>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-emergent-dapt-washout-posterior-rescue-point-prp-for-pulse-s-in-0-s-out-9>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-kinematic-phase-waves-across-the-psm-n-w-simulated-vs-morelli-2009-analytic>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-mib1-ubiquitination-gate-late-front-coherence-r-in-mib1-null-m-0-vs-wild-type>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-riedel-kruse-2007-5-regime-emergent-ald-prp-vs-observed-pearson-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation-2> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-delayed-kuramoto-collective-synchronization-period-t-sync-vs-autonomous-t-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "delayed Kuramoto collective synchronization period T_sync vs autonomous T_0 = 22.18 min" ;
        dct:description "DAPT Notch blockade (kappa=0) shifts period from 22.18 min to T_0 = 25.00 min (+12.7% slowing, Herrgen et al. 2010); continuous-DAPT lattice mean period 25.00 min" ;
        schema:measurementTechnique "transcendental root of Omega = omega_0 - kappa*sin(Omega*tau_c) for T_0=25.0 min, kappa=0.070 min^-1, tau_c=20.5 min (Omega=0.2833 rad/min, Omega/omega_0=1.1273); emergent lattice segmentation period 22.18 min" ;
        schema:name "delayed Kuramoto collective synchronization period T_sync vs autonomous T_0" ;
        schema:unitText "min" ;
        schema:value "22.18" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-delayed-kuramoto-collective-synchronization-period-t-sync-vs-autonomous-t-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-delayed-kuramoto-collective-synchronization-period-t-sync-vs-autonomous-t-0-reference> a schema:PropertyValue ;
        dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 SOM & Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 2-3 (collective period 22.18 min vs uncoupled 25.0 min)" ;
        schema:value "22.18" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-effective-in-phase-linear-stability-stiffness-kappa-eff-kappa-cos-omega-tau-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "effective in-phase linear stability stiffness kappa_eff = kappa * cos(Omega * tau_c) = 0.0623 min^-1" ;
        dct:description "in_phase_stable = True at tau_c=20.5 min vs False at repulsive delay tau_c=11.0 min" ;
        schema:measurementTechnique "linearized delayed Kuramoto stiffness kappa_eff = kappa*cos(Omega*tau_c) at tau_c=20.5 min (Omega*tau_c=5.808 rad) vs repulsive anti-phase delay tau_c=11.0 min (kappa_eff=-0.0353 min^-1)" ;
        schema:name "effective in-phase linear stability stiffness kappa_eff = kappa * cos(Omega * tau_c)" ;
        schema:unitText "min^-1" ;
        schema:value "0.0623" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-effective-in-phase-linear-stability-stiffness-kappa-eff-kappa-cos-omega-tau-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-effective-in-phase-linear-stability-stiffness-kappa-eff-kappa-cos-omega-tau-c-reference> a schema:PropertyValue ;
        dct:source "Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 4-5 & Fig. 2 (in-phase synchronization stable iff kappa_eff = kappa*cos(Omega*tau_c) > 0)" ;
        schema:value "0.0623" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-emergent-dapt-pulse-chase-anterior-limit-of-defects-ald-at-s-in-0> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "emergent DAPT pulse-chase Anterior Limit of Defects (ALD) at s_in = 0 = 5.41 somites" ;
        dct:description "Riedel-Kruse analytic ALD = s_in + 5.5 = 5.5; continuous-DAPT late front R = 0.240 vs WT 0.918" ;
        schema:measurementTechnique "first crossing of the determination-front lateral Kuramoto R below R_crit=0.50 + Delta_n_det=2.5 in the advected 24x12 delayed Kuramoto PSM lattice, mean over 5 seeds (sd 0.16); single-seed s_cross=3.142" ;
        schema:name "emergent DAPT pulse-chase Anterior Limit of Defects (ALD) at s_in = 0" ;
        schema:unitText "somites" ;
        schema:value "5.41" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-emergent-dapt-pulse-chase-anterior-limit-of-defects-ald-at-s-in-0-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-emergent-dapt-pulse-chase-anterior-limit-of-defects-ald-at-s-in-0-reference> a schema:PropertyValue ;
        dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Fig. 2 (continuous DAPT from gastrulation: ALD 5.4 +/- 0.8 somites)" ;
        schema:value "5.4" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-emergent-dapt-washout-posterior-rescue-point-prp-for-pulse-s-in-0-s-out-9> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "emergent DAPT washout Posterior Rescue Point (PRP) for pulse [s_in = 0, s_out = 9] = 14.86 somites" ;
        dct:description "emergent defect span PRP - ALD = 8.35 somites = s_recross - s_cross (Delta_n_det cancels, Law 6); analytic PRP = 14.5" ;
        schema:measurementTechnique "first recovery of the determination-front lateral Kuramoto R above R_crit after washout + Delta_n_det, mean over 5 seeds (sd 0.71); DAPT clearance tau_wash=8 min, Mib1 u_ss=0.80; single-seed ALD=5.64, PRP=13.99, min R=0.223 -> rescued R=0.853" ;
        schema:name "emergent DAPT washout Posterior Rescue Point (PRP) for pulse [s_in = 0, s_out = 9]" ;
        schema:unitText "somites" ;
        schema:value "14.86" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-emergent-dapt-washout-posterior-rescue-point-prp-for-pulse-s-in-0-s-out-9-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-emergent-dapt-washout-posterior-rescue-point-prp-for-pulse-s-in-0-s-out-9-reference> a schema:PropertyValue ;
        dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Fig. 4 (DAPT pulse 0 -> 9 somites: PRP 14.7 +/- 1.1 somites)" ;
        schema:value "14.7" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-kinematic-phase-waves-across-the-psm-n-w-simulated-vs-morelli-2009-analytic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "kinematic phase waves across the PSM N_w (simulated vs Morelli 2009 analytic) = 1.5766 waves per PSM" ;
        dct:description "anterior wavelength / somite length: simulated 2.21 vs analytic 1/(1 - f_A) = 2.00; waves slow toward the front (speed Omega/k(x))" ;
        schema:measurementTechnique "unwrapped lateral-mean phase drop across the 6-somite-length PSM in the advected lattice with the FGF8/Wnt profile f_A=0.5 (analytic N_w = (1/S) Int (1 - c) dx = 1.609); uniform-profile control N_w = -0.025" ;
        schema:name "kinematic phase waves across the PSM N_w (simulated vs Morelli 2009 analytic)" ;
        schema:unitText "waves per PSM" ;
        schema:value "1.5766" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-kinematic-phase-waves-across-the-psm-n-w-simulated-vs-morelli-2009-analytic-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-kinematic-phase-waves-across-the-psm-n-w-simulated-vs-morelli-2009-analytic-reference> a schema:PropertyValue ;
        dct:source "Morelli et al. (2009) HFSP J. 3:55-66 kinematic wave theory k = (Omega - omega(x))/v (Law 4); Soroldoni et al. (2014) Science 345:222-225 report ~1-2 waves across the zebrafish PSM" ;
        schema:value "1.6091" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-mib1-ubiquitination-gate-late-front-coherence-r-in-mib1-null-m-0-vs-wild-type> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Mib1 ubiquitination gate: late front coherence R in mib1-null (M = 0) vs wild type = 0.2809 Kuramoto R" ;
        dct:description "mib1-null emergent ALD = 5.82 somites; Mib1 restoration at somite 9 (tau_u = 10 min) rescues to R=0.771 at PRP=15.34" ;
        schema:measurementTechnique "kappa(t) = kappa_max * u(t) * g(t) with u_ss(M) = k_ub M/(k_ub M + k_endo) (k_ub=0.08, k_endo=0.02 min^-1): M=0 gives u_ss=0.00, kappa_eff=0.0000; M=0.5 gives u_ss=0.67, kappa_eff=0.0504; WT late R=0.918" ;
        schema:name "Mib1 ubiquitination gate: late front coherence R in mib1-null (M = 0) vs wild type" ;
        schema:unitText "Kuramoto R" ;
        schema:value "0.2809" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-mib1-ubiquitination-gate-late-front-coherence-r-in-mib1-null-m-0-vs-wild-type-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-mib1-ubiquitination-gate-late-front-coherence-r-in-mib1-null-m-0-vs-wild-type-reference> a schema:PropertyValue ;
        dct:source "Itoh et al. (2003) Dev Cell 4:67-82 (mib^ta52b abolishes Delta-Notch signalling); Riedel-Kruse et al. (2007) (mib/aei/des/bea mutants desynchronise like early DAPT); 12-cell lateral random-phase floor 1/sqrt(12) = 0.29" ;
        schema:value "0.29" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-riedel-kruse-2007-5-regime-emergent-ald-prp-vs-observed-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Riedel-Kruse (2007) 5-regime emergent ALD/PRP vs observed Pearson r = 0.9998 Pearson r" ;
        dct:description "p = 3.76e-06; analytic Riedel-Kruse prediction r = 0.9999, RMSE = 0.132 somites" ;
        schema:measurementTechnique "correlation between emergent lattice ALD (WT, s_in=0, 4, 9) / PRP (pulse 0->9) and the observed values across 5 regimes, 5 seeds each; RMSE over the 4 perturbed regimes = 0.225 somites (max |err| 0.39)" ;
        schema:name "Riedel-Kruse (2007) 5-regime emergent ALD/PRP vs observed Pearson r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9998" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-riedel-kruse-2007-5-regime-emergent-ald-prp-vs-observed-pearson-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-riedel-kruse-2007-5-regime-emergent-ald-prp-vs-observed-pearson-r-reference> a schema:PropertyValue ;
        dct:source "Riedel-Kruse, Müller & Oates (2007) Science 317:1911-1915 Figs. 2B, 3D & 4 (unit-slope ALD(s_in) = s_in + Delta_n_ALD; PRP after washout)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate embryo SEM specimen bilateral somite spacing S_obs = 48.4667 px" ;
        dct:description "bilateral symmetry ratio = 0.9606, std = 9.70 px, phase correlation r = 0.5629" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on zebrafish_psm_synchrony_specimen.jpg (upper=8 somites, lower=9 somites, CV=0.2002)" ;
        schema:name "vertebrate embryo SEM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "48.4667" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-measurement-vertebrate-embryo-sem-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dct:source "Vendored CC BY 4.0 vertebrate embryo SEM specimen (datasets/delta_notch_phase_synchrony/zebrafish_psm_synchrony_specimen.jpg)" ;
        schema:value "48.47" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L661–L744" ;
        dct:description "5-regime emergent ALD/PRP over REGIME_SEEDS with mean/sd, Pearson r and RMSE vs observed (WT sentinel excluded from RMSE)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L661-L744> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L863–L964" ;
        dct:description "measure_morphoeval: 8 measurements (T_sync, kappa_eff, emergent ALD, emergent PRP, 5-regime r, N_w, mib1-null R, specimen spacing) with reference_value / reference_source / unit" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L863-L964> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}

sub:provenance {

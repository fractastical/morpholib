        prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
            <https://doi.org/10.1016/S1534-5807(02)00409-4>,
            <https://doi.org/10.1016/j.cub.2010.06.034>,
            <https://doi.org/10.1038/nature04861>,
            <https://doi.org/10.1126/science.1142538>,
            <https://doi.org/10.1126/science.1253089>,
            <https://doi.org/10.2976/1.3027088> .
    <https://doi.org/10.1016/S0092-8674(01)00437-8> dct:date "2001"^^xsd:gYear ;
        dct:title "FGF signaling controls somite boundary position and regulates segmentation clock control of spatiotemporal Hox gene activation" .
    <https://doi.org/10.1016/S1534-5807(02)00409-4> dct:date "2003"^^xsd:gYear ;
        dct:title "Mind bomb is a ubiquitin ligase that is essential for efficient activation of Notch signaling by Delta" .
    <https://doi.org/10.1016/j.cub.2010.06.034> dct:date "2010"^^xsd:gYear ;
        dct:title "Intercellular coupling regulates the period of the segmentation clock" .
    <https://doi.org/10.1038/nature04861> dct:date "2006"^^xsd:gYear ;
        dct:title "Noise-resistant and synchronized oscillation of the segmentation clock" .
    <https://doi.org/10.1126/science.1142538> dct:date "2007"^^xsd:gYear ;
        dct:title "Synchrony dynamics during initiation, failure, and rescue of the segmentation clock" .
    <https://doi.org/10.1126/science.1253089> dct:date "2014"^^xsd:gYear ;
        dct:title "A Doppler effect in embryonic pattern formation" .
    <https://doi.org/10.2976/1.3027088> dct:date "2009"^^xsd:gYear ;
        dct:title "Delayed coupling theory of vertebrate segmentation" .
}

sub:pubinfo {
    sub: rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony on an advected FGF8/Wnt-graded PSM lattice: kinematic waves, Mib1-gated coupling, emergent DAPT ALD/PRP — Morphometric validation 88/100" ;

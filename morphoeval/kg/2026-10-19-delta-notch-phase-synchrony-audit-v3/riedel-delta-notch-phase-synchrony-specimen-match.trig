sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony on an advected FGF8/Wnt-graded PSM lattice: kinematic waves, Mib1-gated coupling, emergent DAPT ALD/PRP — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Judged on the PNG and GIF: Panel G is a convincing kymograph of posterior -> anterior phase waves that lose lateral coherence under DAPT and recover after washout, the Panel G zoom shows the crest tilt, and the GIF ribbon shows the same waves next to the emergent defective somite window. Deductions: the vendored SEM specimen (Panel E) is a CHICK embryo per its Wikimedia title, used in Passes 1-2 as \"zebrafish_psm_synchrony_specimen\" and scored 87 for specimen match — the species label is now corrected in the JSON (L48) and README (L60) but the file remains the only biological image, so the model's organism is not matched by any specimen of that organism (-12); no her1/deltaC in-situ or live-reporter wave pattern is vendored, so the kinematic waves (the new Pass 3 output) are compared with nothing biological (-8); Panel F compares the SEM band-pass profile with a fitted sinusoid (r = 0.563, L838-847), which is a periodicity fit, not a model prediction (-4); the somite boundary ribbon chi(s) is a sin^2 + salt-and-pepper rendering gated by coherence (L590-604), not a boundary derived from the phase field (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2006-riedel-delta-notch-phase-synchrony.py L590–L604: chi(s) somite boundary ribbon is a coherence-gated synthetic sin^2 / salt-and-pepper rendering <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L590-L604>",
            "2006-riedel-delta-notch-phase-synchrony.py L838–L847: Panel F / segment_zebrafish_psm_specimen: fitted sinusoid at the empirical spacing vs band-pass profile (r = 0.563) - periodicity fit, not a model-to-specimen comparison <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L838-L847>",
            "datasets/delta_notch_phase_synchrony/delta_notch_phase_synchrony_reference.json L48–L48: Species field corrected to Gallus gallus (chick) per the Wikimedia source title; the specimen is not Danio rerio <https://github.com/fractastical/morpholib/blob/d58a084/datasets/delta_notch_phase_synchrony/delta_notch_phase_synchrony_reference.json#L48-L48>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/delta_notch_phase_synchrony_comparison.png (generated output)" ;
        dct:description "Panel G kymograph: tilted phase crests tail -> front, fading during DAPT [0, 9], recovering after washout; Panel A/D emergent ALD/PRP vs observed; Panel E chick SEM with 8 + 9 segmented somites — docs/media/delta_notch_phase_synchrony_comparison.png: rendered output of 2006-riedel-delta-notch-phase-synchrony.py at d58a084, image/png, 1996337 B, 2436×2044 px, artifact_sha256 24bdb2e7c7c300913001ecb821a0c2953e925858f4f6af09969f9ddf45047588 (sha256 24bdb2e7c7c300913001ecb821a0c2953e925858f4f6af09969f9ddf45047588), spec_fingerprint 09e5aac12df2ce2cf18eea96b6a21a56461679db4c6b4516072331c47fa27633" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/delta_notch_phase_synchrony_growth.gif (generated output)" ;
        dct:description "22 frames: R_front(s), kinematic-wave ribbon across the PSM (WT vs DAPT pulse) and emergent defective somite window [5.6, 14.0] — docs/media/delta_notch_phase_synchrony_growth.gif: rendered output of 2006-riedel-delta-notch-phase-synchrony.py at d58a084, image/gif, 1078938 B, 940×660 px, 22 frames, artifact_sha256 e694fbda16547809f0fd4d8cb1fb8c6dc32c5ba353c634851b6a19f0b367c137 (sha256 e694fbda16547809f0fd4d8cb1fb8c6dc32c5ba353c634851b6a19f0b367c137), spec_fingerprint 09e5aac12df2ce2cf18eea96b6a21a56461679db4c6b4516072331c47fa27633" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


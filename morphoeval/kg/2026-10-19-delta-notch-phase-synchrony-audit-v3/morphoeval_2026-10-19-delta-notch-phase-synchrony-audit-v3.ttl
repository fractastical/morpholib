<https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Riedel-Kruse (2007) & Morelli (2009) Delayed Kuramoto Collective Frequency Shift Law" ;
    dct:description "Determines how delayed intercellular Delta-Notch signaling shifts the collective segmentation clock frequency Omega relative to the autonomous cellular rhythm omega_0 | Variables: theta_i(t): clock phase of PSM cell i; omega_0: intrinsic single-cell frequency (rad/min); kappa: Delta-Notch coupling strength (min^-1); tau_c: intercellular signaling time delay (min); Omega: synchronized collective frequency (rad/min)" ;
    dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Eq. 1; Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L213-L276>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L28-L56> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def delayed_kuramoto_collective_frequency (omega_0 kappa sin_delay_phase : Int) : Int :=
  omega_0 - kappa * sin_delay_phase
theorem riedel_2007_collective_frequency_shift_and_dapt_limit (omega_0 kappa sin_delay_phase : Int) :
    delayed_kuramoto_collective_frequency omega_0 0 sin_delay_phase = omega_0 ∧
    delayed_kuramoto_collective_frequency omega_0 kappa sin_delay_phase +
      delayed_kuramoto_collective_frequency omega_0 kappa (-sin_delay_phase) = 2 * omega_0"""^^pk:lean4 ;
    skos:notation "dtheta_i(t)/dt = omega_0 + (kappa / z) * sum_j sin(theta_j(t - tau_c) - theta_i(t)) + xi_i(t);  Omega = omega_0 - kappa * sin(Omega * tau_c)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/S1534-5807(02)00409-4>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1038/nature04861>,
        <https://doi.org/10.1126/science.1142538>,
        <https://doi.org/10.1126/science.1253089>,
        <https://doi.org/10.2976/1.3027088> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
    pk:leanDeclaration "MathOfBiology.Loop_023.delayed_kuramoto_collective_frequency" ;
    pk:leanTheorem "MathOfBiology.Loop_023.riedel_2007_collective_frequency_shift_and_dapt_limit" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Morelli (2009) Delayed Coupling Linear Stability Stiffness Criterion" ;
    dct:description "Establishes the linear stability boundary separating stable in-phase synchronization (cos(Omega*tau_c) > 0) from anti-phase checkerboard desynchronization (cos(Omega*tau_c) < 0) | Variables: kappa_eff: effective linear restoring stiffness of in-phase synchronization (min^-1); Omega*tau_c: dimensionless delay phase product (rad)" ;
    dct:source "Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 4-5; Herrgen et al. (2010) Current Biology 20:1244-1253" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L213-L276>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L58-L84> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def delayed_kuramoto_effective_stiffness (kappa cos_delay_phase : Int) : Int :=
  kappa * cos_delay_phase
def delayed_phase_perturbation_step (kappa cos_delay_phase delta_theta : Int) : Int :=
  (1 - delayed_kuramoto_effective_stiffness kappa cos_delay_phase) * delta_theta
theorem morelli_2009_in_phase_stability_vs_antiphase_instability (delta_theta : Int) :
    delayed_phase_perturbation_step 1 1 delta_theta = 0 ∧
    delayed_phase_perturbation_step 1 (-1) delta_theta = 2 * delta_theta"""^^pk:lean4 ;
    skos:notation "kappa_eff = kappa * cos(Omega * tau_c) > 0" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/S1534-5807(02)00409-4>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1038/nature04861>,
        <https://doi.org/10.1126/science.1142538>,
        <https://doi.org/10.1126/science.1253089>,
        <https://doi.org/10.2976/1.3027088> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
    pk:leanDeclaration "MathOfBiology.Loop_023.delayed_kuramoto_effective_stiffness" ;
    pk:leanTheorem "MathOfBiology.Loop_023.morelli_2009_in_phase_stability_vs_antiphase_instability" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Riedel-Kruse (2007) Kuramoto Order Parameter, Anterior Limit of Defects (ALD) & Posterior Rescue Point (PRP) Law" ;
    dct:description "Predicts the ~5.5-somite delay between DAPT Notch blockade and segmentation failure (ALD) and the ~5.5-somite recovery lag between DAPT washout and posterior segmentation rescue (PRP) | Variables: R(t): Kuramoto phase coherence order parameter; s_in: somite stage of DAPT Notch blockade onset; s_out: somite stage of DAPT washout; ALD: Anterior Limit of Defects; PRP: Posterior Rescue Point" ;
    dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Figs. 1-4" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L563-L604>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L86-L116> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def anterior_limit_of_defects (s_in Delta_n_ALD : Nat) : Nat :=
  s_in + Delta_n_ALD
def posterior_rescue_point (s_out Delta_n_PRP : Nat) : Nat :=
  s_out + Delta_n_PRP
theorem riedel_2007_ald_prp_pulse_chase_window_invariance (s_in delta_s dapt_duration Delta_lag : Nat) :
    anterior_limit_of_defects (s_in + delta_s) Delta_lag =
      anterior_limit_of_defects s_in Delta_lag + delta_s ∧
    posterior_rescue_point (s_in + dapt_duration) Delta_lag -
      anterior_limit_of_defects s_in Delta_lag = dapt_duration"""^^pk:lean4 ;
    skos:notation "R(t) = |(1/N)*sum_j exp(i*theta_j(t))|;  ALD(s_in) = s_in + Delta_n_ALD;  PRP(s_out) = s_out + Delta_n_PRP" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/S1534-5807(02)00409-4>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1038/nature04861>,
        <https://doi.org/10.1126/science.1142538>,
        <https://doi.org/10.1126/science.1253089>,
        <https://doi.org/10.2976/1.3027088> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
    pk:leanDeclaration "MathOfBiology.Loop_023.anterior_limit_of_defects" ;
    pk:leanTheorem "MathOfBiology.Loop_023.riedel_2007_ald_prp_pulse_chase_window_invariance" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Morelli (2009) Kinematic Phase-Wave Law for an Advected FGF8/Wnt Frequency Profile" ;
    dct:description "Couples the delayed Kuramoto lattice to an advecting FGF8/Wnt frequency gradient so that posterior->anterior kinematic phase waves emerge, slow toward the determination front, and vanish for a uniform profile | Variables: omega(x): FGF8/Wnt-slaved autonomous frequency profile (rad/min); xi: distance from the tailbud (somite lengths); lambda_F: gradient decay length; v = S/T_seg: anterior cell flow speed; k(x): local phase wave number; N_w: number of kinematic waves across the PSM of length L" ;
    dct:source "Morelli et al. (2009) HFSP J. 3:55-66 (frequency profile & kinematic waves); Dubrulle et al. (2001) Cell 106:219-232 (FGF8 gradient); Soroldoni et al. (2014) Science 345:222-225 (wave kinematics)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L284-L319>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L119-L150> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def kinematic_phase_lag (Omega omega_eff dt : Int) : Int :=
  (Omega - omega_eff) * dt
theorem morelli_2009_kinematic_wave_phase_lag_law
    (Omega omega_1 omega_2 dt dt_1 dt_2 : Int) (h_omega : omega_1 ≤ omega_2) (h_dt : 0 ≤ dt) :
    kinematic_phase_lag Omega Omega dt = 0 ∧
    kinematic_phase_lag Omega omega_2 dt ≤ kinematic_phase_lag Omega omega_1 dt ∧
    kinematic_phase_lag Omega omega_1 dt_1 + kinematic_phase_lag Omega omega_1 dt_2 =
      kinematic_phase_lag Omega omega_1 (dt_1 + dt_2)"""^^pk:lean4 ;
    skos:notation "omega(xi) = omega_0 * exp(-xi/lambda_F);  k(x) = (Omega/v) * (1 - omega(x)/omega_0);  N_w = (1/S) * Int_0^L (1 - omega/omega_0) dx" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/S1534-5807(02)00409-4>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1038/nature04861>,
        <https://doi.org/10.1126/science.1142538>,
        <https://doi.org/10.1126/science.1253089>,
        <https://doi.org/10.2976/1.3027088> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
    pk:leanDeclaration "MathOfBiology.Loop_023.kinematic_phase_lag" ;
    pk:leanTheorem "MathOfBiology.Loop_023.morelli_2009_kinematic_wave_phase_lag_law" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Itoh (2003) Mind bomb (Mib1) DeltaC Ubiquitination Coupling Gate" ;
    dct:description "Makes the Delta-Notch coupling strength a dynamical variable: mib null abolishes coupling like DAPT, hypomorphs reduce kappa_eff monotonically, and coupling restoration after Mib1 induction or DAPT washout proceeds with finite kinetics | Variables: u: Mib1-ubiquitinated signalling-competent DeltaC fraction; M: Mib1 E3-ligase activity (1 WT, 0 mib^ta52b); k_ub, k_endo: ubiquitination and endocytic turnover rates (min^-1); g: gamma-secretase (DAPT) cleavage gate; kappa_max: coupling at full ubiquitination" ;
    dct:source "Itoh et al. (2003) Dev Cell 4:67-82; Riedel-Kruse et al. (2007) Science 317:1911-1915 (DAPT washout, mib/aei/des/bea mutants)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L322-L354>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L152-L191> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def mib1_ubiquitinated_numerator (k_ub M : Nat) : Nat :=
  k_ub * M
def mib1_ubiquitinated_denominator (k_ub k_endo M : Nat) : Nat :=
  k_ub * M + k_endo
theorem itoh_2003_mib1_ubiquitination_gate_monotone
    (k_ub k_endo M_1 M_2 : Nat) (h : M_1 ≤ M_2) :
    mib1_ubiquitinated_numerator k_ub 0 = 0 ∧
    mib1_ubiquitinated_numerator k_ub M_1 ≤ mib1_ubiquitinated_denominator k_ub k_endo M_1 ∧
    mib1_ubiquitinated_numerator k_ub M_1 * mib1_ubiquitinated_denominator k_ub k_endo M_2 ≤
      mib1_ubiquitinated_numerator k_ub M_2 * mib1_ubiquitinated_denominator k_ub k_endo M_1"""^^pk:lean4 ;
    skos:notation "du/dt = k_ub*M*(1 - u) - k_endo*u;  u_ss = k_ub M/(k_ub M + k_endo);  kappa(t) = kappa_max*u(t)*g(t);  g = 1/(1 + (C_DAPT/IC50)^n)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/S1534-5807(02)00409-4>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1038/nature04861>,
        <https://doi.org/10.1126/science.1142538>,
        <https://doi.org/10.1126/science.1253089>,
        <https://doi.org/10.2976/1.3027088> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
    pk:leanDeclaration "MathOfBiology.Loop_023.mib1_ubiquitinated_numerator" ;
    pk:leanTheorem "MathOfBiology.Loop_023.itoh_2003_mib1_ubiquitination_gate_monotone" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/riedel-delta-notch-phase-synchrony-6> a skos:Concept,
        pk:Concept ;
    rdfs:label "Riedel-Kruse (2007) Emergent Defect-Span Law (ALD/PRP from R_crit crossings)" ;
    dct:description "Replaces the hard-coded ALD = s_in + 5.5 / PRP = s_out + 5.5 of Pass 2 by an emergent read-out of the simulated coherence trajectory, whose defective span is independent of the maturation lag | Variables: s_cross: somite stage at which the determination-front lateral Kuramoto R first falls below R_crit; s_recross: stage at which it first recovers above R_crit after washout/restoration; Delta_n_det: determination-to-boundary maturation lag (2.5 somites)" ;
    dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Figs. 2-4 (R_crit threshold model of ALD and PRP)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L544-L557>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L193-L226> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition """def emergent_anterior_limit_of_defects (s_cross Delta_n_det : Nat) : Nat :=
  s_cross + Delta_n_det
def emergent_posterior_rescue_point (s_recross Delta_n_det : Nat) : Nat :=
  s_recross + Delta_n_det
theorem riedel_2007_emergent_defect_span_independent_of_determination_lag
    (s_cross s_recross Delta_n_det d : Nat) (h : s_cross ≤ s_recross) :
    emergent_posterior_rescue_point s_recross Delta_n_det -
      emergent_anterior_limit_of_defects s_cross Delta_n_det = s_recross - s_cross ∧
    s_cross ≤ emergent_anterior_limit_of_defects s_cross Delta_n_det ∧
    emergent_anterior_limit_of_defects s_cross (Delta_n_det + d) =
      emergent_anterior_limit_of_defects s_cross Delta_n_det + d ∧
    emergent_posterior_rescue_point s_recross (Delta_n_det + d) =
      emergent_posterior_rescue_point s_recross Delta_n_det + d"""^^pk:lean4 ;
    skos:notation "ALD = s_cross + Delta_n_det;  PRP = s_recross + Delta_n_det;  PRP - ALD = s_recross - s_cross" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/S1534-5807(02)00409-4>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1038/nature04861>,
        <https://doi.org/10.1126/science.1142538>,
        <https://doi.org/10.1126/science.1253089>,
        <https://doi.org/10.2976/1.3027088> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
    pk:leanDeclaration "MathOfBiology.Loop_023.emergent_anterior_limit_of_defects" ;
    pk:leanTheorem "MathOfBiology.Loop_023.riedel_2007_emergent_defect_span_independent_of_determination_lag" ;
    pk:leanVerified true .

<https://w3id.org/probknow/resource/math-law/riedel-delta-notch-phase-synchrony-1> a skos:Concept,
        pk1:Concept ;
    rdfs:label "Riedel-Kruse (2007) & Morelli (2009) Delayed Kuramoto Collective Frequency Shift Law" ;
    dct:description "Determines how delayed intercellular Delta-Notch signaling shifts the collective segmentation clock frequency Omega relative to the autonomous cellular rhythm omega_0 | Variables: theta_i(t): clock phase of PSM cell i; omega_0: intrinsic single-cell frequency (rad/min); kappa: Delta-Notch coupling strength (min^-1); tau_c: intercellular signaling time delay (min); Omega: synchronized collective frequency (rad/min)" ;
    dct:source "Riedel-Kruse et al. (2007) Science 317:1911-1915 Eq. 1; Morelli et al. (2009) HFSP J. 3:55-66 Eqs. 1-3" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L213-L276>,
        <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L28-L56> ;
    skos:broader <https://w3id.org/probknow/resource/concept/math-of-biology> ;
    skos:definition """def delayed_kuramoto_collective_frequency (omega_0 kappa sin_delay_phase : Int) : Int :=
  omega_0 - kappa * sin_delay_phase
theorem riedel_2007_collective_frequency_shift_and_dapt_limit (omega_0 kappa sin_delay_phase : Int) :
    delayed_kuramoto_collective_frequency omega_0 0 sin_delay_phase = omega_0 ∧
    delayed_kuramoto_collective_frequency omega_0 kappa sin_delay_phase +
      delayed_kuramoto_collective_frequency omega_0 kappa (-sin_delay_phase) = 2 * omega_0"""^^pk1:lean4 ;
    skos:notation "dtheta_i(t)/dt = omega_0 + (kappa / z) * sum_j sin(theta_j(t - tau_c) - theta_i(t)) + xi_i(t);  Omega = omega_0 - kappa * sin(Omega * tau_c)" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/S0092-8674(01)00437-8>,
        <https://doi.org/10.1016/S1534-5807(02)00409-4>,
        <https://doi.org/10.1016/j.cub.2010.06.034>,
        <https://doi.org/10.1038/nature04861>,
        <https://doi.org/10.1126/science.1142538>,
        <https://doi.org/10.1126/science.1253089>,
        <https://doi.org/10.2976/1.3027088> ;
    schema:programmingLanguage "Lean 4" ;
    pk1:hypothesisType "Coupled Delayed Kuramoto Somite Field" ;
    pk1:leanDeclaration "MathOfBiology.Loop_023.delayed_kuramoto_collective_frequency" ;
    pk1:leanTheorem "MathOfBiology.Loop_023.riedel_2007_collective_frequency_shift_and_dapt_limit" ;
    pk1:leanVerified true .


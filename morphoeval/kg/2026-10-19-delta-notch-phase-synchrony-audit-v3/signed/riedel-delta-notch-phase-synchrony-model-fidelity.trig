sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony on an advected FGF8/Wnt-graded PSM lattice: kinematic waves, Mib1-gated coupling, emergent DAPT ALD/PRP — Model fidelity to source: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The lattice equation is now exactly the source model: nearest-neighbour delayed coupling (kappa/z_i) sum_j sin(theta_j(t - tau_c,j) - theta_i) with open AP / periodic lateral boundaries (L501-515), the ad hoc 1.6 kappa_eff sin(psi - theta) term and the 0.35/0.65 blend of Pass 2 are gone, the collective frequency / stiffness solver is unchanged (L213-266) and the kinematic steady state used for initialisation is the Law-4 solution k = (Omega/v)(1 - c) (L432-437); the emergent segmentation period of the lattice (22.18 min WT, 25.00 min DAPT) matches the solver. Deductions: the frequency profile is a single exponential with f_A = 0.5 (L284-319), not Morelli's profile (-3); the per-column delay scaling tau_c(x) omega(x) = const (L413) is a modelling choice introduced to keep the anterior coupling attractive, and Panel B only marks the unscaled point rather than simulating it (-3); Mib1 kinetics are a two-rate linear ODE with unmeasured k_ub, k_endo (L172-173, L495-499) and the DAPT gate is a Hill function with assumed dose/IC50 = 20 and n = 2 (L174-176) (-2); advection is a discrete one-column shift with tailbud seeding from the last column plus 0.05 rad noise (L523-531), with no cell division or PSM shortening (-1)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2006-riedel-delta-notch-phase-synchrony.py L171–L176: k_ub, k_endo, tau_wash, dose ratio and Hill n are declared reduced constants without measured sources <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L171-L176>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-5> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L501–L515" ;
        dcterms:description "Pure nearest-neighbour delayed Kuramoto coupling with per-column delay gather (theta_delayed = history[row_idx, col_idx, lat_idx]); no mean-field or instantaneous term" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L501-L515> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L284–L319" ;
        dcterms:description "fgf_wnt_frequency_profile: omega(xi) = omega_0 exp(-xi/lambda_F), lambda_F = L/ln(1/f_A); analytic N_w = (1/S) Int (1 - c) dx" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L284-L319> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L408–L437" ;
        dcterms:description "Period-scaled per-column delays (L413) and Law-4 kinematic steady-state initialisation (L432-437); Mib1 normalisation kappa_max = kappa_WT / u_ss(1) (L420-425)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L408-L437> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L486–L531" ;
        dcterms:description "DAPT gate with first-order clearance (L486-494), Mib1 ubiquitination ODE (L495-499), somite-stage clock at Omega(kappa(t)) (L517-522), Lagrangian advection of histories and delta_omega (L523-531)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L486-L531> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean L119–L226" ;
        dcterms:description "Three new machine-checked theorems: kinematic phase-lag law, Mib1 gate monotonicity, emergent defect-span invariance (6 theorems total, 0 sorrys)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_023_delta_notch_phase_synchrony.lean#L119-L226> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


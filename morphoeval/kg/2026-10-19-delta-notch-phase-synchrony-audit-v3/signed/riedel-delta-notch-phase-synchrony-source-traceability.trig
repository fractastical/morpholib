        dcterms:description "Canonical Omega / T_sync / kappa_eff corrected to 0.283333 / 22.176 / 0.062255 with a note on the Pass 1-2 error" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/delta_notch_phase_synchrony/delta_notch_phase_synchrony_reference.json#L86-L91> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony on an advected FGF8/Wnt-graded PSM lattice: kinematic waves, Mib1-gated coupling, emergent DAPT ALD/PRP — Source and data traceability: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Seven primary sources with DOIs in the docstring (L6-37), `paper_citations.bib` and the reference JSON `metadata.sources` (L7-43 of the JSON); the specimen and scout manifest are SHA-256 pinned and verified fail-closed (L146-153, L183-201); the reference JSON now carries a `pass3_kinematic_wave_and_mib1_mechanisms` block (JSON L100-139) stating every reduced constant and which are calibrated, and its stale canonical Omega / T_sync / kappa_eff were corrected and are asserted by the self-test (L1289-1294). Deductions: the reference JSON is hashed but not pinned in EXPECTED_SHA256 (L146-153, L197-200), so a silent edit of the regime table would pass (-3); the specimen was mislabelled as zebrafish for two passes and its true provenance was only recovered from the Wikimedia title (-4); Soroldoni (2014) and Morelli (2009) wave data are cited but not vendored, so the \"1-2 waves\" anchor is a prose statement (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2006-riedel-delta-notch-phase-synchrony.py L146–L153: EXPECTED_SHA256 pins the specimen and scout manifest only; the reference JSON is hashed at run time but not pinned <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L146-L153>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-source-traceability-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


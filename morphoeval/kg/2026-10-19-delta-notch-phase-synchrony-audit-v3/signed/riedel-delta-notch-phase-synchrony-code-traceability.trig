        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony on an advected FGF8/Wnt-graded PSM lattice: kinematic waves, Mib1-gated coupling, emergent DAPT ALD/PRP — Code-to-model traceability: 91/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Laws 1-6 are stated in the docstring with their Lean theorem names (L68-118), every modelling function's docstring names its law and source (L218-226, L291-298, L327-331, L387-407), the loop body is annotated per mechanism (L486, L495, L501, L517, L523), and `math_kg_loops/riedel-delta-notch-phase-synchrony.yaml` maps each of the 6 laws to Lean loci and code loci (YAML L13-224). Deductions: the exponential profile, the delay scaling and the Mib1/DAPT rate constants are traced to a declared-assumption paragraph (L55-66) rather than to any equation or figure of a source (-5); the 0.05 rad tailbud seeding noise (L527), the half-period smoothing window (L454) and the chi(s) rendering constants (L598-604) are uncited (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2006-riedel-delta-notch-phase-synchrony.py L527–L527: Tailbud seeding noise 0.05 rad is an uncited constant <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L527-L527>",
            "2006-riedel-delta-notch-phase-synchrony.py L55–L66: Reduced assumptions (profile form, delay scaling, rate constants, calibration) declared but not traceable to source equations <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L55-L66>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-code-traceability-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


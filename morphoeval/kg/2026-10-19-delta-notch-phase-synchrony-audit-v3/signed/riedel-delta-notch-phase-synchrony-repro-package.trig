sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony on an advected FGF8/Wnt-graded PSM lattice: kinematic waves, Mib1-gated coupling, emergent DAPT ALD/PRP — Reproducibility package: 93/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Deterministic RNG (seed = 2007; REGIME_SEEDS L658), bitwise two-run determinism asserted (L1304-1306), `--self-test` passes 9/9 checks in ~4 s covering SHA-256 integrity, solver/JSON parity, kinematic waves, uniform-profile null, f_A monotonicity, emergent ALD/PRP and Law-6 invariance, Herrgen period lengthening, Mib1 gate, 5-regime validation (3 seeds) and the measurement hook (L1278-1386); the default render completes in ~7 s and regenerates both artifacts; CLI documented in argparse incl. --summary (L1389-1424); the environment block above lists the versions actually installed. Deductions: there is no requirements lock for this script and the v2 environment block was wrong, which this audit corrects but the repo does not pin (-4); the GIF/PNG are regenerated but their SHA-256 are not asserted anywhere (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L1278–L1386" ;
        dcterms:description "run_self_test: 9 checks incl. bitwise determinism, JSON parity, kinematic waves, emergent ALD/PRP, Mib1 gate, 5-regime validation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L1278-L1386> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L1389–L1424" ;
        dcterms:description "argparse CLI with --self-test, --skip-gif, --summary and all mechanism flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L1389-L1424> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/delta_notch_phase_synchrony_growth.gif (generated output)" ;
        dcterms:description "22-frame GIF regenerated by the default invocation — docs/media/delta_notch_phase_synchrony_growth.gif: rendered output of 2006-riedel-delta-notch-phase-synchrony.py at d58a084, image/gif, 1078938 B, 940×660 px, 22 frames, artifact_sha256 e694fbda16547809f0fd4d8cb1fb8c6dc32c5ba353c634851b6a19f0b367c137 (sha256 e694fbda16547809f0fd4d8cb1fb8c6dc32c5ba353c634851b6a19f0b367c137), spec_fingerprint 09e5aac12df2ce2cf18eea96b6a21a56461679db4c6b4516072331c47fa27633" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


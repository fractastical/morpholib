sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-riedel-delta-notch-phase-synchrony> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Riedel-Kruse et al. (2007) & Morelli et al. (2009) zebrafish Delta-Notch delayed Kuramoto phase synchrony on an advected FGF8/Wnt-graded PSM lattice: kinematic waves, Mib1-gated coupling, emergent DAPT ALD/PRP — Parameter expressivity: 92/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Every new mechanism carries a sweep that behaves as claimed: the FGF8/Wnt steepness f_A controls the number of kinematic waves monotonically (N_w 2.52 -> 2.00 -> 1.58 -> 1.20 -> 0.85 -> 0.55 -> 0.26 -> -0.03 for f_A 0.3 ... 1.0, each within 0.1 of the analytic law; `sweep_frequency_profile` L747-761, Panel H inset, asserted monotone in the self-test L1319-1322); Mib1 activity M controls u_ss and the late front coherence monotonically (R 0.28 -> 0.35 -> 0.50 -> 0.81 -> ... -> 0.93 for M 0 ... 1.5, threshold crossing near M = 0.1; `sweep_mib1_dose` L764-780, Panel I inset); the DAPT onset s_in shifts the emergent ALD with unit slope (Panel D); the (tau_c, kappa) stability tongue and T_sync(tau_c) branches are kept (Panels B-C); CLI exposes --f-anterior, --mib1-dose, --tau-wash, --no-gradient, --s-in/--s-out, --seed and a --summary JSON dump (L1393-1404). Deductions: the sweeps are reported as curves, not as rendered kymographs along the sweep (-4); L, cells_per_somite, n_lat, Delta_n_det and R_crit are constants with no sweep or sensitivity (L164-168) (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2006-riedel-delta-notch-phase-synchrony.py L164–L168: L = 24/4 somite lengths, 12 lateral cells, R_crit and Delta_n_det are fixed constants with no sensitivity analysis <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L164-L168>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L747–L780" ;
        dct:description "sweep_frequency_profile (f_A -> N_w sim vs analytic) and sweep_mib1_dose (M -> u_ss, kappa_eff, late R, emergent ALD)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L747-L780> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L1156–L1203" ;
        dct:description "Panels H and I render both sweeps as insets next to the profile / kinetics curves" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L1156-L1203> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-riedel-delta-notch-phase-synchrony-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2006-riedel-delta-notch-phase-synchrony.py L1393–L1404" ;
        dct:description "CLI flags --f-anterior, --mib1-dose, --tau-wash, --no-gradient, --s-in, --s-out, --seed, --summary" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2006-riedel-delta-notch-phase-synchrony.py#L1393-L1404> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 builder+assessor) + MorphoEval Dual-Rubric Assessor" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Parameter expressivity: 62/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "A morphospace parameter does control form: my --sweep local_inhibition run (0.05-0.6) moves the critical harmonic from m=0 to m=1 and the unrestricted selection through roll -> square -> hexagonal -> rhombic with a monotonically falling roll margin, and the lateral sweeps move q* monotonically (xihat_lat: 1.46 -> 0.70) and flip parity at theta0 = 45 and 90 deg, all shown in Panels F/G and the CSV. Deductions: (a) -14 because the sigma0 axis, the only new physical parameter of the full-cubic path, is unusable in the gallery's m=0 regime (near-resonant/subcritical at every value except 0.5 in my sweep; 178/260 regime-map cells greyed), so it does not visibly control anything; (b) -10 because the sweeps never render a planform, so the form change is shown only as colour codes and family strings, not as images; (c) -8 because three of the five gallery forms (cobweb, honeycomb, rhombic) still come from the preset's pattern string and pattern_angle_deg rather than from a swept parameter, and the spiral pitch is a rendering input; (d) -6 because --preset does not change what the figure renders (it only seeds --sweep), contrary to the README." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-4> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2212–L2222" ;
        dct:description "Eight sweepable couplings including local_inhibition (regime) and sigmoid_baseline (feedback)." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L2212-L2222> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2225–L2254" ;
        dct:description "regime_map over A_loc x sigma0 records family, harmonic, subcritical and near_resonant per cell." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L2225-L2254> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L3780–L3781" ;
        dct:description "--preset is documented as 'Base paper preset for --sweep' only; the gallery presets are hard-coded at lines 2367-2373." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L3780-L3781> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-parameter-expressivity-4> a pk:EvidenceItem ;
        rdfs:label "bressloff_v1_metrics.csv (generated output)" ;
        dct:description "parameter_sweep rows: local_inhibition families hexagonal/rhombic/roll/square; sigmoid_baseline q* constant 1.491 with no reliable form change. — bressloff_v1_metrics.csv: rendered output of 2001-bressloff-v1-form-constants.py at 2aac102, text/csv, 17613 B, artifact_sha256 1619e7198598fdae123dd701231fe52479d532c0c9779e0393b25451a1e0b81f (sha256 1619e7198598fdae123dd701231fe52479d532c0c9779e0393b25451a1e0b81f), spec_fingerprint fff701034002726a27d7e6e2ee5c626f921c8d06f78514d8965ad139e7a192a7" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L615–L695" ;
        dcterms:description "Local/lateral harmonics and perturbative dispersion match Bressloff 2001 Eqs. 3.12/4.9/4.14-16 (1D anisotropic Weber integral, spread factor, (-1)^n)." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L615-L695> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L825–L922" ;
        dcterms:description "Correct sigmoid expansion ratios; exact Hermitian operator and derived critical harmonic (m=0 vs m=1) from exact_dispersion_scan." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L825-L922> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L947–L1008" ;
        dcterms:description "Quadratic feedback Q through resolvent R_K; feedback_fraction/near_resonant flags — reconstruction, not transcribed from Eq. 5.15." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L947-L1008> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1603–L1616" ;
        dcterms:description "k_y quantisation moves the hex modes from +-120 to +-114.6 deg at 11 cycles, contradicting the '<1 degree' claim at line 1570." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L1603-L1616> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Model fidelity to source: 74/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Verified against the papers: the local harmonics W_n = e^{-2n^2 xi^2} - A e^{-2n^2 xihat^2}, the lateral Fourier-Bessel harmonics (-1)^n e^{-x} I_n(x) with x = xi^2 q^2/4 and the sin(2n theta0)/(2n theta0) spread factor, the O(beta^2) dispersion lambda_+- = W_1 + beta(W_0 +- W_2) + ..., the 2001 Eq. 2.1 map with the paper's w0 = 0.087 and eps = 0.051, the sigmoid ratios s_2 = (1-2 sigma0)/2 and s_3 = (6 sigma0(1-sigma0)-1)/6, and the standard Lambda_r = eta^2 gamma0/(2 gamma_hex - gamma0)^2 < Lambda_h thresholds are all correct, and the m=0/m=1 regime is read off the exact operator's top eigenvector rather than imposed (the fixture presets that impose it are flagged). Deductions: (a) -8 because the quadratic- feedback term Q and its 3 s_3 / 2 s_2^2 prefactors are \"derived here for the operator as implemented\", not pinned to Eq. 5.15, and in the derived m=0 regime the path is subcritical/near-resonant at every sigma0 != 1/2 (my sweep 0.3-0.7 gave roll margins of -105 to -117 and SUBCRITICAL at 4/5 points), so the new physics is untestable where the gallery lives; (b) -6 because the rendered hexagonal planform has wavevectors at 0, +-114.6 deg (n_y = 10 of 11 cycles), a 5.4 deg distortion that contradicts the \"< 1 degree\" docstring claim, so the badged 60-deg hexagon is not what is drawn; (c) -5 because the 1e-15 \"parity\" is with the MesmerPrism Rust port, no paper curve (Figs. 16-17, 37-40) is digitised and compared, and alpha, beta come from that port; (d) -4 because the parity presets sit 3.2x off the paper's wavelength and the paper-scale preset is an ad hoc 1/3.3 rescaling of the lateral widths; (e) -3 because the perturbative n=1 q* (1.491) is still what the CSV calls critical_q for the m=0 gallery rows that are actually rendered at q_mode = 1.404." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-model-fidelity-4> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L796–L817" ;
        dcterms:description "Section-2b comment: amplitude equations, gamma(theta), eta, Q and R_K defined, flagged as derived for the implemented operator." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L796-L817> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L3202–L3203" ;
        dcterms:description "Ledger text '=> 2k harmonic' is hard-coded although the printed power triple shows sqrt(3)k dominant." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L3202-L3203> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L2429–L2432" ;
        dcterms:description "Stale comment '/3.1, q* ~ 4.5, lambda_c ~ 2.8 mm' vs preset values /3.3, 4.84, 2.60." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L2429-L2432> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-4> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L711–L721" ;
        dcterms:description "Upstream truncation/clamp documented with planform.rs line pointers (good practice)." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L711-L721> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Code-to-model traceability: 74/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Nearly every modelling function carries an equation or figure pointer (Eq. 3.12, 4.9, 4.14-4.16, 5.14, 5.15, section 4a, 2002 section 1.1, Figs. 16-17, 29-36, 37-40), the section-2b comment states the amplitude equations being solved, and upstream artefacts (m <= 4 truncation, +-1.5 clamp, 10-harmonic sum) are labelled as such with their planform.rs lines. Deductions: (a) -8 because the central new step, the Q term with its 3 s_3 and 2 s_2^2 prefactors and the two resolvent insertions at K = k_i +- k_j, is tied to no specific equation of the paper (\"derived here for the operator as implemented\"); (b) -6 because the ledger hard-codes the explanation \"=> 2k harmonic of tanh o max\" while the numbers it prints (0.97/1.00/ 0.17) show the sqrt(3)k ring dominating; (c) -5 because the 0.5 and (-1)^n factors in lateral_weight_coeff, the sharpness/tanh rendering nonlinearity and sigma0 = 1/2 as \"the paper's case\" are asserted without a reference; (d) -4 for stale in-code comments (line 2429: \"/3.1 so q* ~ 4.5 and lambda_c ~ 2.8 mm\" versus the preset's /3.3, 4.84, 2.60 mm) and the false \"< 1 degree\" quantisation claim; (e) -3 because the docstring's \"exact two-regime map\" paragraph still describes the exact map as the pullback used, whereas the default is now conformal." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-code-traceability-4> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L320–L329" ;
        dcterms:description "verify_fixture_checksums; run_bressloff_analysis raises on any mismatch (lines 2333-2336)." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L320-L329> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L3420–L3430" ;
        dcterms:description "self_test entry; 40 checks all PASS in my run (75 s), consistent with on-disk PNG/CSV values." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L3420-L3430> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "README.md L441–L441" ;
        dcterms:description "States '--self-test runs 27 checks ... in ~12 s' and a two-value --hemifield-mode; both stale." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/README.md#L441-L441> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Reproducibility package: 84/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "requirements.lock.txt pins exact versions (numpy 2.5.4, matplotlib 3.10.7, pillow 12.0.0, Python 3.14.7) and the venv matches; the script uses no random numbers at all; fixture digests are verified before any computation and the run aborts on mismatch; --self-test ran clean here (40 PASS, 0 FAIL, 75 s) and the PNG/CSV/GIF on disk are consistent with the printed numbers; Agg is forced when --no-show/--self-test or no DISPLAY is set. Deductions: (a) -6 because the README documents \"27 checks in ~12 s\" and \"--hemifield-mode {full-field,bilateral-mirror}\" and says --preset selects what is rendered, none of which is true of this code; (b) -4 because --gif is not part of the documented default invocation and the regenerated GIF would be produced by a separate ~100 s run, so artefact regeneration is two commands; (c) -3 because importing the script as a module by path fails under Python 3.14 unless the module is first registered in sys.modules (dataclass resolution), which hampers reuse/testing; (d) -3 because the audit-stated HEAD (2aac102) does not match the checkout (9df331b), so the artefact->commit binding in the documentation cannot be confirmed from the repo alone." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-repro-package-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;

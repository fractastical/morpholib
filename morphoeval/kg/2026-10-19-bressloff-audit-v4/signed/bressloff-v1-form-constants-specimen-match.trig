sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "bressloff_v1_form_constants_morphospace.png (generated output)" ;
        dcterms:description "Cols I-II: tunnel rings and seamless chiral spiral convincing; cols IV-V: sparse blob fields with line segments, weakly distinct from each other. — bressloff_v1_form_constants_morphospace.png: rendered output of 2001-bressloff-v1-form-constants.py at 2aac102, image/png, 1852599 B, 3577×2495 px, artifact_sha256 59ee2445fa3cc7fe6fa27a91b99eb16d2b412d31933f5869271e80c9a736ef7c (sha256 59ee2445fa3cc7fe6fa27a91b99eb16d2b412d31933f5869271e80c9a736ef7c), spec_fingerprint fff701034002726a27d7e6e2ee5c626f921c8d06f78514d8965ad139e7a192a7" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/bressloff_v1_form_constants.gif (generated output)" ;
        dcterms:description "Envelope-only frames 3/5 and 4/5 read clearly as cobweb and honeycomb; badges carried per frame. — docs/media/bressloff_v1_form_constants.gif: rendered output of 2001-bressloff-v1-form-constants.py at 2aac102, image/gif, 2361492 B, 640×350 px, 36 frames, artifact_sha256 c6cebc034d11971f6d0f6cd89024fd1f534502f80f2c691e11654b0508241a39 (sha256 c6cebc034d11971f6d0f6cd89024fd1f534502f80f2c691e11654b0508241a39), spec_fingerprint fff701034002726a27d7e6e2ee5c626f921c8d06f78514d8965ad139e7a192a7" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L1640–L1659" ;
        dcterms:description "Contoured rendering = tanh(sharpness * max_phi a); produces lambda/2 envelope and the blob-like look of panels III-V." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L1640-L1659> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-4> a pk:EvidenceItem ;
        rdfs:label "bressloff_v1_metrics.csv (generated output)" ;
        dcterms:description "kluver rows: chirality 0.892 / seam 0.000 for the spiral; rings_analytic 5.76 in 1-40 deg for every gallery preset. — bressloff_v1_metrics.csv: rendered output of 2001-bressloff-v1-form-constants.py at 2aac102, text/csv, 17613 B, artifact_sha256 1619e7198598fdae123dd701231fe52479d532c0c9779e0393b25451a1e0b81f (sha256 1619e7198598fdae123dd701231fe52479d532c0c9779e0393b25451a1e0b81f), spec_fingerprint fff701034002726a27d7e6e2ee5c626f921c8d06f78514d8965ad139e7a192a7" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Morphological realism / specimen match: 66/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Side by side with Kluever's families as drawn in Bressloff 2001 Fig. 1 / Ermentrout & Cowan 1979, column I is a clean concentric tunnel and column II a continuous, handed log-spiral (chirality 0.89, seam 0.00 on the conformal map — I checked the PNG at full resolution and found no meridian discontinuity), and the badges (SELECTED/IMPOSED/STABLE) agree with the printed roll margins (+0.92, -0.34) and with the cubic numbers in the CSV. Deductions: (a) -10 because the contoured honeycomb (IV) and rhombic (V) panels in the PNG are sparse fields of bright blobs with white line elements that are hard to recognise as a honeycomb and hard to tell apart from each other; the GIF's envelope rendering of the same presets is far more honeycomb-like, so the contoured visualisation, not the model, is what fails here; (b) -8 because the \"honeycomb\" is a 65/115-degree lattice after quantisation, not a hexagonal one, so it is not the Fig. 35 planform it is labelled as; (c) -8 because the gallery shows ~5.8 rings in the central 40 deg (lambda_c 9.0 mm) where the paper and subjects report 30-36 stripes over the field, so the density of the forms is off by ~3x and only the small Panel D inset renders a paper-scale tunnel; (d) -8 because no actual specimen image (Kluever/Siegel drawings, Bressloff Fig. 1, Rule phosphene photos) is placed beside the output; the match is to the family labels, judged by the viewer." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-specimen-match-4> ;
        pk:hasScore "0.66"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
}


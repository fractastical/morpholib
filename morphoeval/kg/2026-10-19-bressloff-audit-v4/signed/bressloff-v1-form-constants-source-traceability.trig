sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-bressloff-v1-form-constants> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-source-traceability> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-bressloff-v1-form-constants-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bressloff et al. (2001/2002) V1 Euclidean Symmetry-Breaking & Klüver Form Constants — Source and data traceability: 84/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "All eight sources carry DOIs (and PMIDs where they exist) in the docstring, the dataset README and the .bib file; the upstream repository is named with commit 344863a1 and MIT licence; all four fixtures are SHA-256-pinned and verified fail-closed at run time (I recomputed the digests and they match); the provenance of each map constant (paper vs upstream params.rs line) is recorded in RETINO_CONSTANT_PROVENANCE. Deductions: (a) -6 because the top-level README section describing this script is stale (gallery badges \"IMPOSED (tunnel, spiral, cobweb)\", lambda_c 8.7 mm, left-meridian seam, --hemifield-mode without chiral-mirror, --preset \"selects what is rendered\"), so a reader following it is misled about the current provenance chain; (b) -5 because the three calibration fixtures are another program's output, not paper data, and the specific upstream file/line pointers (params.rs:5-8, presets.rs:642-806, planform.rs) are not resolvable URLs; (c) -5 because the Rule 2011 fixture is used with calibration_claim_allowed = false and no provenance of how its curves relate to the published figure is given beyond \"numerical calibration targets\"." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-4> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L11–L48" ;
        dcterms:description "Eight primary sources with DOI/PMID and the upstream commit and licence." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L11-L48> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2001-bressloff-v1-form-constants.py L152–L179" ;
        dcterms:description "SHA-256 pins for the four fixtures and per-constant provenance of w0, eps, alpha, beta." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/2001-bressloff-v1-form-constants.py#L152-L179> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/bressloff/README.md L7–L14" ;
        dcterms:description "Fixture table with digests and upstream paths; H&H file marked as repo-authored." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/datasets/bressloff/README.md#L7-L14> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-bressloff-v1-form-constants-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "README.md L433–L440" ;
        dcterms:description "Script section still describes the pre-Pass-4 state (IMPOSED tunnel/spiral, 8.7 mm, bilateral-mirror only, --preset selects rendering)." ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/2aac102/README.md#L433-L440> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary) + Gemini 4 Argon (independent blinded second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Morphometric validation: 92/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Extracts 5 reference-anchored quantitative morphometric measurements via `measure_morphoeval()` (L594-662): critical diffusivity ratio d_c = 10.2596, simulated 1D PDE stripe wavelength 3.4739 vs analytical 3.4739 (0.00% error, CV = 0.0000), supercritical vs subcritical stripe count delta (6 vs 0 stripes; 5-regime RMSE = 0.0000, Pearson r = 1.0000), 2D P. imperator Y-branch unzipping displacement (+0.6627 domain fraction, converting 3 -> 4 posterior stripes), and calibrated juvenile P. semicirculatus inter-stripe wavelength 3.80 mm (prim/sec ratio 2.65x, r = 0.858)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-2d-p-imperator-y-junction-branch-point-horizontal-unzipping-displacement>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-supercritical-d-i-0-10-vs-subcritical-control-d-i-0-05-stripe-count-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-pomacanthus-semicirculatus-juvenile-specimen-inter-stripe-wavelength>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-simulated-1d-kondo-asai-piecewise-linear-pde-stripe-wavelength-vs-analytical-lambda-c>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation-1> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-2d-p-imperator-y-junction-branch-point-horizontal-unzipping-displacement> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "2D P. imperator Y-junction branch point horizontal unzipping displacement = 0.6627 domain fraction" ;
        dct:description "posterior flank stripe count incremented from 3 to 4 via horizontal branch unzipping" ;
        schema:measurementTechnique "2D Kondo-Asai PDE solver tracking horizontal Y-branch dislocation propagation from x/L_x = 0.289 to 0.952 (posterior stripes: 3 -> 4)" ;
        schema:name "2D P. imperator Y-junction branch point horizontal unzipping displacement" ;
        schema:unitText "domain fraction" ;
        schema:value "0.6627" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-2d-p-imperator-y-junction-branch-point-horizontal-unzipping-displacement-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-2d-p-imperator-y-junction-branch-point-horizontal-unzipping-displacement-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Figs. 3-4 (horizontal Y-branch unzipping converting 3 -> 4 stripes)" ;
        schema:value "0.65" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Kondo-Asai (1995) critical diffusivity ratio d_c = (D_I / D_A)_c = 10.2596 dimensionless" ;
        dct:description "canonical d = D_I/D_A = 14.2857 > d_c = 10.2596; unstable wavenumber band k^2 in [1.3848, 5.1581]" ;
        schema:measurementTechnique "Kondo & Asai (1995) Fig. 1 linear stability threshold d_c = 5.2 + 1.6*sqrt(10) around interior steady state (A*, I*) = (3.0, 2.5) with det M(3) = -2440 (x10^-6)" ;
        schema:name "Kondo-Asai (1995) critical diffusivity ratio d_c = (D_I / D_A)_c" ;
        schema:unitText "dimensionless" ;
        schema:value "10.2596" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-kondo-asai-1995-critical-diffusivity-ratio-d-c-d-i-d-a-c-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Fig. 1 legend" ;
        schema:value "10.2596" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-supercritical-d-i-0-10-vs-subcritical-control-d-i-0-05-stripe-count-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "P. semicirculatus supercritical (D_I=0.10) vs subcritical control (D_I=0.05) stripe count delta = 6.0 stripes (supercritical vs subcritical control)" ;
        dct:description "across 5 ontogenetic doubling & control regimes, simulated stripes = [0, 3, 6, 12, 24], Pearson r = 1.0000 (p=0.00e+00)" ;
        schema:measurementTechnique "supercritical inhibitor diffusion D_I=0.10 (d=14.29 > d_c, N=6 stripes) vs subcritical control D_I=0.050 (d=7.14 < d_c, N=0 stripes); 5-regime cascade (3->6->12->24) RMSE=0.0000" ;
        schema:name "P. semicirculatus supercritical (D_I=0.10) vs subcritical control (D_I=0.05) stripe count delta" ;
        schema:unitText "stripes (supercritical vs subcritical control)" ;
        schema:value "6.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-supercritical-d-i-0-10-vs-subcritical-control-d-i-0-05-stripe-count-delta-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-p-semicirculatus-supercritical-d-i-0-10-vs-subcritical-control-d-i-0-05-stripe-count-delta-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Figs. 1-2 (3 -> 6 -> 12 -> 24 stripe doubling cascade)" ;
        schema:value "6.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-pomacanthus-semicirculatus-juvenile-specimen-inter-stripe-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pomacanthus semicirculatus juvenile specimen inter-stripe wavelength = 3.8 mm" ;
        dct:description "primary vs newly inserted secondary mid-trough stripe prominence ratio = 2.65 (156.4 vs 59.0); bimodal Kondo-Asai wave correlation r = 0.8575 (p=4.63e-59)" ;
        schema:measurementTechnique "1D DoG bandpass peak segmentation across lateral flank ROI of pomacanthus_semicirculatus_specimen.jpg (n=105 inter-stripe spacings, mean=36.11 px, std=13.01 px, CV=0.3601, calibrated at 40 mm body span)" ;
        schema:name "Pomacanthus semicirculatus juvenile specimen inter-stripe wavelength" ;
        schema:unitText "mm" ;
        schema:value "3.8" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-pomacanthus-semicirculatus-juvenile-specimen-inter-stripe-wavelength-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-pomacanthus-semicirculatus-juvenile-specimen-inter-stripe-wavelength-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 & vendored CC BY-SA 4.0 P. semicirculatus specimen" ;
        schema:value "3.7" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-simulated-1d-kondo-asai-piecewise-linear-pde-stripe-wavelength-vs-analytical-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "simulated 1D Kondo-Asai piecewise-linear PDE stripe wavelength vs analytical lambda_c = 3.4739 grid units" ;
        dct:description "relative wavelength error = 0.0000%, inter-stripe spacing CV = 0.0110" ;
        schema:measurementTechnique "1D IMEX spectral Kondo-Asai piecewise-linear saturating PDE solver on L = 6*lambda_c (N=6 stripes, CV=0.0110)" ;
        schema:name "simulated 1D Kondo-Asai piecewise-linear PDE stripe wavelength vs analytical lambda_c" ;
        schema:unitText "grid units" ;
        schema:value "3.4739" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-simulated-1d-kondo-asai-piecewise-linear-pde-stripe-wavelength-vs-analytical-lambda-c-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-measurement-simulated-1d-kondo-asai-piecewise-linear-pde-stripe-wavelength-vs-analytical-lambda-c-reference> a schema:PropertyValue ;
        dct:source "Kondo & Asai (1995) Nature 376(6543):765-768 Fig. 1 (k_c^2 = 229/70 = 3.2714 => lambda_c = 2*pi/k_c = 3.4739)" ;
        schema:value "3.4739" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L594–L662" ;
        dct:description "5 quantitative MorphoEval measurements with analytical and empirical references, CV, Pearson r, and RMSE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L594-L662> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


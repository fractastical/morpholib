    <https://doi.org/10.1006/bulm.1999.0131> dcterms:date "1999"^^xsd:gYear ;
        dcterms:title "Reaction and diffusion on growing domains: scenarios for robust pattern formation" .

    <https://doi.org/10.1007/BF00289234> dcterms:date "1972"^^xsd:gYear ;
        dcterms:title "A theory of biological pattern formation" .

    <https://doi.org/10.1038/376765a0> dcterms:date "1995"^^xsd:gYear ;
        dcterms:title "A reaction-diffusion wave on the skin of the marine angelfish Pomacanthus" .

    <https://doi.org/10.1387/ijdb.072502sk> dcterms:date "2009"^^xsd:gYear ;
        dcterms:title "How animals get their skin patterns: fish pigment pattern as a live Turing wave" .


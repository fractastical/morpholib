sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L102–L196" ;
        dcterms:description "Analytical Kondo-Asai steady state (A*, I*) = (3.0, 2.5), critical ratio d_c = 10.2596, and dispersion relation Re(sigma(k^2))" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L102-L196> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L200–L352" ;
        dcterms:description "1D IMEX spectral Kondo-Asai piecewise-linear PDE solver and growing-domain mid-trough stripe insertion kymograph" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L200-L352> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean L19–L114" ;
        dcterms:description "3 machine-checked Lean 4 theorems (0 sorrys) for steady-state stability, Turing wave instability, and stripe doubling vs Y-branch unzipping" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean#L19-L114> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Model fidelity to source: 94/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Faithfully implements the Kondo & Asai (1995) Fig. 1 piecewise-linear saturating activator-inhibitor reaction-diffusion system (`analytical_kondo_asai_stability`, L102-177), 1D IMEX spectral PDE solver (`solve_1d_kondo_asai_pde`, L200-276), continuous growing-domain mid-trough insertion kymograph (`simulate_growing_domain_insertion_kymograph`, L279-352), and 2D P. imperator Y-branch horizontal unzipping solver (`simulate_2d_imperator_y_branch_unzipping`, L392-490), backed by 3 machine-checked Lean 4 theorems (0 sorrys) in `morphoeval/lean/loops/Loop_004_pomacanthus_stripe_insertion.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-model-fidelity-3> ;
        pk:hasScore "0.94"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Reproducibility package: 91/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=1995`), standalone `--self-test` suite verifying SHA-256 dataset integrity, interior steady state (A*, I*) = (3.0, 2.5), critical diffusivity ratio d_c = 10.2596, bitwise two-run PDE solver determinism (`atol=0.0`), exact 5-regime stripe doubling agreement (0, 3, 6, 12, 24), 2D Y-branch horizontal unzipping (3 -> 4 posterior stripes), and specimen CV segmentation (`run_self_test`, L915-967), plus rendered PNG and GIF outputs in `docs/media/`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L915–L967" ;
        dcterms:description "Deterministic --self-test suite verifying SHA-256 digests, bitwise determinism, and morphometrics" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L915-L967> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/pomacanthus_stripe_insertion_growth.gif (generated output)" ;
        dcterms:description "24-frame animated GIF of Kondo-Asai mid-trough stripe insertion on an expanding skin domain — docs/media/pomacanthus_stripe_insertion_growth.gif: rendered output of 1995-kondo-pomacanthus-stripe-insertion.py at 317bc3c, image/gif, 938761 B, 900×500 px, 24 frames, artifact_sha256 7e81613cc8dbe53b823231cb70519b475d3cef6f0e63fe8d74b3fa61e9db6778 (sha256 7e81613cc8dbe53b823231cb70519b475d3cef6f0e63fe8d74b3fa61e9db6778), spec_fingerprint e4c6766f0513e073e4470f6a811662276c20929359a8102829c89d29daf6842b" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


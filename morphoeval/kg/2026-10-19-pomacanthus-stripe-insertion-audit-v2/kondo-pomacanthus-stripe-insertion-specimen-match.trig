sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-kondo-pomacanthus-stripe-insertion> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Kondo & Asai (1995) Pomacanthus reaction-diffusion stripe insertion & Y-branch unzipping — Morphological realism / specimen match: 91/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors and SHA-256-verifies the CC BY-SA 4.0 juvenile Pomacanthus semicirculatus specimen (`datasets/pomacanthus_stripe_insertion/pomacanthus_semicirculatus_specimen.jpg`) and segments both the primary white stripes and the thinner newly inserted secondary blue/white mid-trough stripes (`segment_pomacanthus_specimen`, L496-588), measuring a mean inter-stripe wavelength of 3.80 mm (36.1130 +/- 12.4041 px across n=115 spacings, CV = 0.3435), an alternating primary-to-secondary prominence ratio of 2.65x (158.47 vs 59.89), and bimodal Kondo-Asai waveform correlation r = 0.858 (p = 1.98e-59, Panels E-F)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "1995-kondo-pomacanthus-stripe-insertion.py L496–L588" ;
        dct:description "Automated CV segmentation of primary vs newly inserted secondary mid-trough stripes on juvenile Pomacanthus semicirculatus" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/317bc3c/1995-kondo-pomacanthus-stripe-insertion.py#L496-L588> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-kondo-pomacanthus-stripe-insertion-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/pomacanthus_stripe_insertion_comparison.png (generated output)" ;
        dct:description "6-panel synthesis figure including dispersion relation, mid-trough insertion kymograph, 5-regime doubling cascade, 2D Y-branch unzipping, specimen segmentation, and bimodal wave fit — docs/media/pomacanthus_stripe_insertion_comparison.png: rendered output of 1995-kondo-pomacanthus-stripe-insertion.py at 317bc3c, image/png, 1075667 B, 2310×1372 px, artifact_sha256 f56ad3b6f32a4c800405b224dcf0d9573c52ab752213d4ba7c15f304411e5faa (sha256 f56ad3b6f32a4c800405b224dcf0d9573c52ab752213d4ba7c15f304411e5faa), spec_fingerprint e4c6766f0513e073e4470f6a811662276c20929359a8102829c89d29daf6842b" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


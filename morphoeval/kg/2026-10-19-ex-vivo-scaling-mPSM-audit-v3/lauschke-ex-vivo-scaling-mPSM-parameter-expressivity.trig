sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Parameter expressivity: 93/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "The 4-explant series (R_0 150-450 um), constant-velocity and DAPT controls remain (L458-544); Pass 3 adds a tau_lambda sweep {5, 35, 70, 280, inf} min whose phase-span error grows monotonically (0.3%, 2.5%, 5.0%, 17.6%, 38.8%) with emergent alpha_8 0.110 -> 0.560, the fixed-length-gradient control, and K {0, 0.25, 0.5, 1} and eta {0, 0.1, 0.25, 0.4} sweeps of the reaggregate (coherence 0.00 -> 0.98 with K; 0 foci at eta = 0, 4 -> 1 at eta >= 0.1), each visible in Panels G and I and exposed through --tau-lambda, --gradient-mode, --K, --eta, --kappa-init. Deductions: the sweeps are reported as text in Panel I rather than rendered pullbacks (-3); the K/eta sweep snapshots use a single seed so the monotonic claims are not seed-averaged (-2); --R0/--alpha/--T-osc/--seed only act under --print-variant (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2014-lauschke-ex-vivo-scaling-mPSM.py L1806–L1826: --R0/--alpha/--T-osc/--seed are consumed only in the --print-variant branch; the default render ignores them <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L1806-L1826>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-3> ;
        pk:hasScore "0.93"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L674–L717" ;
        dct:description "tau_lambda sweep with fixed-gradient control and gradient scaling exponents" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L674-L717> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L916–L931" ;
        dct:description "K and eta sweeps of the reaggregate lattice" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L916-L931> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L1799–L1805" ;
        dct:description "CLI flags --tau-lambda, --gradient-mode, --K, --eta, --kappa-init, --print-variant" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L1799-L1805> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


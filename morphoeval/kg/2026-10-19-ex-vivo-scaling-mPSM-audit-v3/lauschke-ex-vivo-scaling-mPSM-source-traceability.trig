sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Source and data traceability: 91/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Six primary sources with DOIs in the docstring (L6-29), `paper_citations.bib` and `ex_vivo_scaling_mPSM_reference.json`; the reference table gains a `pass3_mechanistic_parameters` block recording every new constant, sweep and expected result; the specimen and scout manifest are SHA-256 pinned and verified at runtime (L135-166). Deductions: the reference JSON itself is hashed but not pinned in EXPECTED_SHA256, so it can drift silently (-3); the specimen filename contradicts its recorded source species (-3); Tsiairis & Aulehla figure numbers cited for the pacemaker claim are approximate (Figs. 2-4) (-2); Kuramoto 1984 is cited at book level without chapter page (-1)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2014-lauschke-ex-vivo-scaling-mPSM.py L135–L166: SHA-256 pins for specimen and scout manifest; reference JSON digest computed but not pinned (L160-164) <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L135-L166>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-source-traceability-2> ;
        pk:hasScore "0.91"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L6–L29" ;
        dct:description "Six sources with DOIs including Kuramoto 1984 and Dubrulle & Pourquie 2004" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L6-L29> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/ex_vivo_scaling_mPSM/ex_vivo_scaling_mPSM_reference.json L90–L144" ;
        dct:description "pass3_mechanistic_parameters: gradient, adaptation and lattice constants with expected default results" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/ex_vivo_scaling_mPSM/ex_vivo_scaling_mPSM_reference.json#L90-L144> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


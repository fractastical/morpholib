sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Reproducibility package: 90/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Deterministic seeds (2014 kymograph, 2016 lattice), bitwise two-run determinism asserted for both the kymograph and the lattice, 18 new self-test assertions covering every Pass 3 claim (L1744-1777), default render in ~12.5 s regenerating the PNG and both GIFs, environment recorded in this audit and expected default results recorded in the reference table. Deductions: no requirements lock file is vendored for the slot (-4); the default render uses hard-coded parameters so --R0/--alpha/--T-osc/--seed do not change the artifacts and the --seed flag changes only the --print-variant lattice (-3); without MPLCONFIGDIR matplotlib emits a cache warning that the invocation notes do not mention (-1); the dataset README documents Pass 3 but the top-level README was not updated (out of this slot's scope) (-2)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst "2014-lauschke-ex-vivo-scaling-mPSM.py L1818–L1826: Default render path calls render_* with module constants; CLI parameters are not forwarded <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L1818-L1826>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-4> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L1744–L1777" ;
        dct:description "Pass 3 self-test assertions: adaptation accuracy, monotone tau error, frozen/fixed-gradient ablations, lattice determinism, 4 -> 1 pacemakers, K = 0 / eta = 0 controls, 10 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L1744-L1777> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L1510–L1577" ;
        dct:description "Reaggregate GIF renderer (20 frames) regenerated by the default invocation" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L1510-L1577> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/ex_vivo_scaling_mPSM_reaggregate.gif (generated output)" ;
        dct:description "20-frame reaggregate animation with pacemaker stars and coherence trace — docs/media/ex_vivo_scaling_mPSM_reaggregate.gif: rendered output of 2014-lauschke-ex-vivo-scaling-mPSM.py at d58a084, image/gif, 1117028 B, 1050×480 px, 20 frames, artifact_sha256 65263943ded23f4287384a1d7f0647441724b69bbb46c45e9ab37e422a36f2bb (sha256 65263943ded23f4287384a1d7f0647441724b69bbb46c45e9ab37e422a36f2bb), spec_fingerprint db42a42f7fc47de46b4f32f0f0564c2111d321e4401a2d84074e25a13a453b30" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/ex_vivo_scaling_mPSM_growth.gif (generated output)" ;
        dct:description "24-frame concentric LuVeLu target-wave and live scaling-regression animation (regenerated, unchanged in design from Pass 2) — docs/media/ex_vivo_scaling_mPSM_growth.gif: rendered output of 2014-lauschke-ex-vivo-scaling-mPSM.py at d58a084, image/gif, 1795304 B, 1050×480 px, 24 frames, artifact_sha256 cbb3b9921ac4353c5e160a578b60c7fa2e5a2eb597a21084d13c282b02553ade (sha256 cbb3b9921ac4353c5e160a578b60c7fa2e5a2eb597a21084d13c282b02553ade), spec_fingerprint db42a42f7fc47de46b4f32f0f0564c2111d321e4401a2d84074e25a13a453b30" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


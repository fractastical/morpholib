sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Morphological realism / specimen match: 85/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Panels E-F still segment both bilateral somite rows of the vendored SEM (8 + 8 somites, 47.14 px, CV 0.201) and Panel H now shows the reaggregate disc at cycle 2 (4 foci) and cycle 14 (1 dominant pacemaker at the frequency maximum) with LuVeLu-like cos(theta) colouring, qualitatively matching the multiple-foci to dominant-centre progression of Tsiairis & Aulehla (2016). Deductions: the file is named `mouse_mpsm_somites_specimen.jpg` but the reference table's own `source_url` is a chick embryo SEM, so the only specimen is the wrong species for a Mus musculus slot and was credited as mouse in Pass 2 (-5 relative to Pass 2); no mPSM explant or reaggregate micrograph (Lauschke Fig. 1, Tsiairis Fig. 2) is vendored, so Panels B, G, H are compared with equations, not images (-6); the reaggregate's dominant pacemaker sits on the disc edge because the frequency maximum of the random field is there, whereas the paper's foci are interior (-2); a fully random initial phase field (kappa_init = 0) yields pinned spiral defects and 0 target sources, unlike the re-synchronisation reported in the paper (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "datasets/ex_vivo_scaling_mPSM/ex_vivo_scaling_mPSM_reference.json L41–L45: specimen source_url is 'Aves_Neural_tube_and_somites_in_chick_embryo.jpg' while the filename and Pass 2 audit call it mouse <https://github.com/fractastical/morpholib/blob/d58a084/datasets/ex_vivo_scaling_mPSM/ex_vivo_scaling_mPSM_reference.json#L41-L45>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match-3> ;
        pk:hasScore "0.85"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L937–L1007" ;
        dcterms:description "Bilateral somite DoG segmentation of the vendored SEM (unchanged from Pass 2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L937-L1007> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L1447–L1473" ;
        dcterms:description "Panel H: early vs late reaggregate snapshots with detected sources and the frequency maximum" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L1447-L1473> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/ex_vivo_scaling_mPSM_comparison.png (generated output)" ;
        dcterms:description "9-panel figure: specimen Panels E-F visible; Panel H shows 4 -> 1 foci; Panel G shows the adaptive phase span — docs/media/ex_vivo_scaling_mPSM_comparison.png: rendered output of 2014-lauschke-ex-vivo-scaling-mPSM.py at d58a084, image/png, 2083380 B, 2775×2475 px, artifact_sha256 7d82231491cf8c8a7e9f6d71c63fe402e0de3485aa001f798cf6dca97220276d (sha256 7d82231491cf8c8a7e9f6d71c63fe402e0de3485aa001f798cf6dca97220276d), spec_fingerprint db42a42f7fc47de46b4f32f0f0564c2111d321e4401a2d84074e25a13a453b30" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (primary) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


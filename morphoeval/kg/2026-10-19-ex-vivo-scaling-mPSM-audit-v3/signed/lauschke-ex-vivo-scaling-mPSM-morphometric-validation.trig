sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-lauschke-ex-vivo-scaling-mPSM> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Morphometric validation: 90/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "`measure_morphoeval()` (L1012-1131) now returns 10 measurements with references and units: the five Pass 2 values (alpha 0.1100, Phi 6.2832 rad, S_1 38.5 um vs 38.9, Pearson r 0.9997, 47.14 px) plus the adaptive phase span 6.1253 rad vs 2*pi, emergent alpha_8 0.1103 vs 0.11, gradient half-length exponent 1.000 vs 1, early pacemaker count 4 vs the >= 2 lower bound and local coherence 0.9446 vs 1.0, each with the matching ablation in its note. Deductions: the two Tsiairis references are qualitative (a lower bound and a perfect-synchrony ceiling), not values digitised from the paper (-4); the 4-explant \"observed\" S_1 / S_5 / v_1 columns in the reference table have no figure or digitisation provenance, so the r = 0.9997 fit (carried from Pass 2) cannot be verified against Lauschke Fig. 3d (-4); the pacemaker count depends on the flux threshold 0.6 and rho = 30 um of the detector without a sensitivity check (-2)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2014-lauschke-ex-vivo-scaling-mPSM.py L769–L835: Flow-source pacemaker detector: thresholds 0.6 and rho = 30 um fixed, no sensitivity sweep <https://github.com/fractastical/morpholib/blob/d58a084/2014-lauschke-ex-vivo-scaling-mPSM.py#L769-L835>",
            "datasets/ex_vivo_scaling_mPSM/ex_vivo_scaling_mPSM_reference.json L145–L209: observed_S1_um / observed_S5_um / observed_v_wave_1_um_per_min lack a figure-digitisation source <https://github.com/fractastical/morpholib/blob/d58a084/datasets/ex_vivo_scaling_mPSM/ex_vivo_scaling_mPSM_reference.json#L145-L209>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-de-novo-target-wave-pacemakers-in-the-disordered-reaggregate-lattice-median-of-cycles-1-3-cycles-12-14>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-emergent-mpsm-total-phase-span-phi-t-under-fgf-wnt-driven-wavelength-adaptation-tau-lambda-t-osc-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-emergent-proportional-scaling-ratio-alpha-s-8-r-t-8-at-cycle-8-under-wavelength-adaptation>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-ex-vivo-mpsm-proportional-segment-scaling-slope-alpha-s-n-r-t-n>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-fgf-wnt-signalling-gradient-half-length-scaling-exponent-d-ln-l-half-d-ln-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-multi-size-mpsm-explant-segment-scaling-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-reaggregate-local-notch-phase-coherence-cos-theta-j-theta-i-after-14-cycles>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-standard-mpsm-explant-r-0-350-um-first-segment-width-s-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-universal-normalized-phase-gradient-total-phase-span-delta-phi-total>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-morphometric-validation-2> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-de-novo-target-wave-pacemakers-in-the-disordered-reaggregate-lattice-median-of-cycles-1-3-cycles-12-14> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "de novo target-wave pacemakers in the disordered reaggregate lattice (median of cycles 1-3 -> cycles 12-14) = 4.0 count" ;
        dcterms:description "counts per cycle {1: 5, 2: 4, 3: 3, 4: 3, 6: 3, 8: 3, 10: 1, 12: 1, 13: 1, 14: 1}; dominant late pacemaker lies 17.7 um from the local frequency maximum (Kuramoto 1984 fastest-pacemaker rule); K = 0 -> 0, eta = 0 -> 0 pacemakers" ;
        schema:measurementTechnique "phase-gradient flow-source detection on 1577 Kuramoto-Sakaguchi cells (K = 0.50 rad/min, eta = 0.25, a = 0.6 rad); early median 4 -> late median 1 pacemakers" ;
        schema:name "de novo target-wave pacemakers in the disordered reaggregate lattice (median of cycles 1-3 -> cycles 12-14)" ;
        schema:unitText "count" ;
        schema:value "4.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-de-novo-target-wave-pacemakers-in-the-disordered-reaggregate-lattice-median-of-cycles-1-3-cycles-12-14-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-de-novo-target-wave-pacemakers-in-the-disordered-reaggregate-lattice-median-of-cycles-1-3-cycles-12-14-reference> a schema:PropertyValue ;
        dcterms:source "Tsiairis & Aulehla (2016) Cell 164:656-667 Figs. 2-4 (multiple wave foci emerge de novo in randomised PSM cell reaggregates; qualitative lower bound >= 2)" ;
        schema:value "2.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-emergent-mpsm-total-phase-span-phi-t-under-fgf-wnt-driven-wavelength-adaptation-tau-lambda-t-osc-4> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "emergent mPSM total phase span Phi(t) under FGF/Wnt-driven wavelength adaptation (tau_lambda = T_osc/4) = 6.1253 rad" ;
        dcterms:description "relative error 2.51%; frozen-wavelength ablation (tau_lambda = inf) gives mean Phi = 3.843 rad" ;
        schema:measurementTechnique "time mean of Phi(t) = 2*pi*R(t)/lambda(t) with d(lambda)/dt = -(lambda - c*l_half(t))/tau_lambda, tau_lambda = 35 min, source-sink FGF/Wnt gradient on R_0 = 350 um over 8 cycles (min 5.587, max 6.283 rad)" ;
        schema:name "emergent mPSM total phase span Phi(t) under FGF/Wnt-driven wavelength adaptation (tau_lambda = T_osc/4)" ;
        schema:unitText "rad" ;
        schema:value "6.1253" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-emergent-mpsm-total-phase-span-phi-t-under-fgf-wnt-driven-wavelength-adaptation-tau-lambda-t-osc-4-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-emergent-mpsm-total-phase-span-phi-t-under-fgf-wnt-driven-wavelength-adaptation-tau-lambda-t-osc-4-reference> a schema:PropertyValue ;
        dcterms:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493:101-105 Fig. 4 (one ~2*pi LuVeLu phase wave spans the active mPSM at every size)" ;
        schema:value "6.2832" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-emergent-proportional-scaling-ratio-alpha-s-8-r-t-8-at-cycle-8-under-wavelength-adaptation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "emergent proportional scaling ratio alpha = S_8 / R(t_8) at cycle 8 under wavelength adaptation = 0.1103 dimensionless ratio" ;
        dcterms:description "no-adaptation ablation drifts to alpha_8 = 0.5601; fixed-length-gradient control (Dubrulle & Pourquie 2004 type) gives constant segments 39.48 um (CV = 0.0319)" ;
        schema:measurementTechnique "segment gated by fixed peripheral phase window delta_phi_seg = 0.9146 rad; alpha is an output of the adaptive model (cycle 1: 0.1100, cycle 8: 0.1103)" ;
        schema:name "emergent proportional scaling ratio alpha = S_8 / R(t_8) at cycle 8 under wavelength adaptation" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.1103" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-emergent-proportional-scaling-ratio-alpha-s-8-r-t-8-at-cycle-8-under-wavelength-adaptation-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-emergent-proportional-scaling-ratio-alpha-s-8-r-t-8-at-cycle-8-under-wavelength-adaptation-reference> a schema:PropertyValue ;
        dcterms:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493:101-105 Fig. 3d (alpha = 0.11)" ;
        schema:value "0.11" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-ex-vivo-mpsm-proportional-segment-scaling-slope-alpha-s-n-r-t-n> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "ex vivo mPSM proportional segment scaling slope alpha = S_n / R(t_n) = 0.11 dimensionless ratio" ;
        dcterms:description "intercept = 0.0000 um; DAPT Notch-inhibition ablation control forms 0 segments" ;
        schema:measurementTechnique "linear regression of segment width S_n vs residual mPSM radius R(t_n) across 4 explant sizes R_0 in {150, 250, 350, 450} um (32 segments, r=1.0000)" ;
        schema:name "ex vivo mPSM proportional segment scaling slope alpha = S_n / R(t_n)" ;
        schema:unitText "dimensionless ratio" ;
        schema:value "0.11" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-ex-vivo-mpsm-proportional-segment-scaling-slope-alpha-s-n-r-t-n-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-ex-vivo-mpsm-proportional-segment-scaling-slope-alpha-s-n-r-t-n-reference> a schema:PropertyValue ;
        dcterms:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493:101-105 Fig. 3d (linear scaling slope alpha = 0.11 across 4-fold mPSM size range)" ;
        schema:value "0.11" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-fgf-wnt-signalling-gradient-half-length-scaling-exponent-d-ln-l-half-d-ln-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF/Wnt signalling gradient half-length scaling exponent d ln(l_half) / d ln(R) = 1.0 dimensionless exponent" ;
        dcterms:description "fixed-length exponential gradient (l_k = 252 um) has exponent 0.0000" ;
        schema:measurementTechnique "log-log regression of the half-maximum length of the quasi-static source-sink gradient W = W_0 sinh((R-r)/l_k)/sinh(R/l_k), l_k >> R, across R in {150, 250, 350, 450} um" ;
        schema:name "FGF/Wnt signalling gradient half-length scaling exponent d ln(l_half) / d ln(R)" ;
        schema:unitText "dimensionless exponent" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-fgf-wnt-signalling-gradient-half-length-scaling-exponent-d-ln-l-half-d-ln-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-fgf-wnt-signalling-gradient-half-length-scaling-exponent-d-ln-l-half-d-ln-r-reference> a schema:PropertyValue ;
        dcterms:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493:101-105 Fig. 4 and Aulehla et al. (2008) Nat Cell Biol 10:186-193 (signalling gradient scales with the unsegmented PSM)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-multi-size-mpsm-explant-segment-scaling-pearson-correlation-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "multi-size mPSM explant segment scaling Pearson correlation r = 0.9997 Pearson r" ;
        dcterms:description "p = 4.12e-11, radial wave velocity correlation r = 0.9996" ;
        schema:measurementTechnique "correlation between predicted and observed segment widths (S_1, S_5) across R_0 in {150, 250, 350, 450} um (RMSE = 0.289 um)" ;
        schema:name "multi-size mPSM explant segment scaling Pearson correlation r" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9997" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-multi-size-mpsm-explant-segment-scaling-pearson-correlation-r-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-multi-size-mpsm-explant-segment-scaling-pearson-correlation-r-reference> a schema:PropertyValue ;
        dcterms:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493:101-105 Figs. 2-4" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-reaggregate-local-notch-phase-coherence-cos-theta-j-theta-i-after-14-cycles> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "reaggregate local Notch phase coherence <cos(theta_j - theta_i)> after 14 cycles = 0.9446 dimensionless (0-1)" ;
        dcterms:description "global Kuramoto order parameter 0.112 (low by construction when target waves span the disc)" ;
        schema:measurementTechnique "mean over coupled cell pairs at t = 14 T_osc; uncoupled control K = 0 gives 0.0036, homogeneous eta = 0 gives 1.0000" ;
        schema:name "reaggregate local Notch phase coherence <cos(theta_j - theta_i)> after 14 cycles" ;
        schema:unitText "dimensionless (0-1)" ;
        schema:value "0.9446" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-reaggregate-local-notch-phase-coherence-cos-theta-j-theta-i-after-14-cycles-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-reaggregate-local-notch-phase-coherence-cos-theta-j-theta-i-after-14-cycles-reference> a schema:PropertyValue ;
        dcterms:source "Tsiairis & Aulehla (2016) Cell 164:656-667 Fig. 1 (dissociated-reaggregated PSM cells re-establish synchronised LuVeLu oscillations; 1.0 = perfect local synchrony)" ;
        schema:value "1.0" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-standard-mpsm-explant-r-0-350-um-first-segment-width-s-1> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "standard mPSM explant (R_0 = 350 um) first segment width S_1 = 38.5 um" ;
        dcterms:description "cycle-5 contracted segment width S_5 = 24.16 um at residual radius R_4 = 219.60 um (telescoping conservation error = 0.00e+00 um)" ;
        schema:measurementTechnique "proportional phase-gradient gating S_1 = alpha * R_0 at R_0 = 350 um (alpha = 0.11, T_osc = 140 min)" ;
        schema:name "standard mPSM explant (R_0 = 350 um) first segment width S_1" ;
        schema:unitText "um" ;
        schema:value "38.5" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-standard-mpsm-explant-r-0-350-um-first-segment-width-s-1-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-standard-mpsm-explant-r-0-350-um-first-segment-width-s-1-reference> a schema:PropertyValue ;
        dcterms:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493:101-105 Figs. 2-3 (S_1 = 38.9 +/- 3.1 um at R_0 = 350 um)" ;
        schema:value "38.9" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-universal-normalized-phase-gradient-total-phase-span-delta-phi-total> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "universal normalized phase-gradient total phase span Delta_phi_total = 6.2832 rad" ;
        dcterms:description "non-scaling constant-gradient control exhibits 3.137 rad spread across explant sizes" ;
        schema:measurementTechnique "phase span phi(0, t) - phi(R(t), t) across normalized coordinate u = r/R(t) in [0, 1] for R_0 in [150, 450] um (collapse max std = 0.000000 rad)" ;
        schema:name "universal normalized phase-gradient total phase span Delta_phi_total" ;
        schema:unitText "rad" ;
        schema:value "6.2832" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-universal-normalized-phase-gradient-total-phase-span-delta-phi-total-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-universal-normalized-phase-gradient-total-phase-span-delta-phi-total-reference> a schema:PropertyValue ;
        dcterms:source "Lauschke, Tsiairis, Francois & Aulehla (2013) Nature 493:101-105 Fig. 4 (one full ~2*pi LuVeLu phase wave spans active mPSM independent of size)" ;
        schema:value "6.2832" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "vertebrate somite/PSM specimen bilateral somite spacing S_obs = 47.1429 px" ;
        dcterms:description "bilateral symmetry ratio = 1.0061, std = 9.48 px, phase correlation r = 0.4795" ;
        schema:measurementTechnique "bilateral dorsal somite row DoG peak segmentation on mouse_mpsm_somites_specimen.jpg (upper=8 somites, lower=8 somites, CV=0.2010)" ;
        schema:name "vertebrate somite/PSM specimen bilateral somite spacing S_obs" ;
        schema:unitText "px" ;
        schema:value "47.1429" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs-reference> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-measurement-vertebrate-somite-psm-specimen-bilateral-somite-spacing-s-obs-reference> a schema:PropertyValue ;
        dcterms:source "Vendored CC BY 4.0 vertebrate embryo SEM specimen (datasets/ex_vivo_scaling_mPSM/mouse_mpsm_somites_specimen.jpg)" ;
        schema:value "47.14" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L1079–L1109" ;

    <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "2014-lauschke-ex-vivo-scaling-mPSM.py L1110–L1131" ;
        dcterms:description "Two reaggregate measurements (pacemaker count 4 -> 1, coherence 0.9446) with K = 0 / eta = 0 controls" ;

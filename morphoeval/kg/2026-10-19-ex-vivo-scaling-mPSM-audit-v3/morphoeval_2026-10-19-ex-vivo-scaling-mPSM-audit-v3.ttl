    pk1:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-source-traceability> a pk1:LLMClaimAssessment ;
    rdfs:label "Lauschke, Tsiairis, François & Aulehla (2013) scale-invariant phase-gradient encoding in ex vivo monolayer presomitic mesoderm (mPSM) — Source and data traceability: 91/100" ;
    dct:date "2026-10-20"^^xsd:date ;

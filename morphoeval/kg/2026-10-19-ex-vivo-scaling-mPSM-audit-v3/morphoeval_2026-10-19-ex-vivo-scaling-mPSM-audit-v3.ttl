    pk1:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-1>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-2>,
        <https://w3id.org/probknow/resource/evidence/morphoeval-lauschke-ex-vivo-scaling-mPSM-parameter-expressivity-3> ;
    pk1:hasScore 9.3e-01 ;
    pk1:hasVerdict "faithful" .

<https://w3id.org/probknow/resource/assessment/morphoeval-lauschke-ex-vivo-scaling-mPSM-repro-package> a pk1:LLMClaimAssessment ;

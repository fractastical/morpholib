sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila succini Turing wavenumber at 2.8 µm (44 Ma, detail scale s0) — Morphometric validation: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "On the pre-registered band sigma > -0.25 (10 modes) the spectral PDE matches analytic sigma with Pearson r = 0.999999997 and RMSE = 2.98e-5. The full spectrum is reported at r = 0.793 and is not used as the gate. The nonlinear radial peak is 2.46 µm against the linear 2.76 µm (FFT binning on a 3.2-wavelength box). Specimen foreground fraction 0.404 versus a 0.62 prior, coherency 0.746 versus the field's 0.883, circularity 0.048 versus 0.80, and orientation KS 0.094 versus 0. None of those pairs are equal." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-berryi-transferred-detail-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-equal-diffusivity-ablation-sigma-max>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-ks-distance-of-gradient-orientations-specimen-vs-simulation>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-nonlinear-spot-field-dominant-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-stem-predecessor-sigma-max-at-r-8-40>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-succini-critical-wavelength-from-argmax-sigma-k>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-turing-band-pearson-r-of-pde-growth-vs-analytic-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-turing-band-rmse-of-sigma>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-berryi-transferred-detail-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "berryi transferred detail wavelength = 2.3823e-06 m" ;
        dct:description "successor Drosophila berryi, 19 Ma" ;
        schema:measurementTechnique "same r, D scaled by (98.43/114)^2; k_c remeasured" ;
        schema:name "berryi transferred detail wavelength" ;
        schema:unitText "m" ;
        schema:value "2.3823e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-berryi-transferred-detail-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-berryi-transferred-detail-wavelength-reference> a schema:PropertyValue ;
        schema:value "2.3822e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-equal-diffusivity-ablation-sigma-max> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusivity ablation sigma_max = -0.321374 1/time" ;
        dct:description "ablation control" ;
        schema:measurementTechnique "max_k sigma(k) at r=1" ;
        schema:name "equal-diffusivity ablation sigma_max" ;
        schema:unitText "1/time" ;
        schema:value "-0.321374" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-equal-diffusivity-ablation-sigma-max-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-equal-diffusivity-ablation-sigma-max-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-ks-distance-of-gradient-orientations-specimen-vs-simulation> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS distance of gradient orientations specimen vs simulation = 0.0939 KS statistic" ;
        dct:description "non-circular specimen metric" ;
        schema:measurementTechnique "two-sample KS on Sobel orientation angles" ;
        schema:name "KS distance of gradient orientations specimen vs simulation" ;
        schema:unitText "KS statistic" ;
        schema:value "0.0939" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-ks-distance-of-gradient-orientations-specimen-vs-simulation-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-ks-distance-of-gradient-orientations-specimen-vs-simulation-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-nonlinear-spot-field-dominant-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "nonlinear spot-field dominant wavelength = 2.4581e-06 m" ;
        dct:description "finite-domain FFT binning shifts this off the linear peak" ;
        schema:measurementTechnique "radial FFT peak of the saturated 2D Schnakenberg field" ;
        schema:name "nonlinear spot-field dominant wavelength" ;
        schema:unitText "m" ;
        schema:value "2.4581e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-nonlinear-spot-field-dominant-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-nonlinear-spot-field-dominant-wavelength-reference> a schema:PropertyValue ;
        schema:value "2.7592e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen contour circularity = 0.0478 4πA/P²" ;
        dct:description "low circularity is expected for a full-bleed spiral card" ;
        schema:measurementTechnique "mask perimeter from binary erosion" ;
        schema:name "specimen contour circularity" ;
        schema:unitText "4πA/P²" ;
        schema:value "0.0478" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "0.8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen foreground fraction = 0.4043 area fraction" ;
        dct:description "reference 0.62 is a generic filled-body prior, not this card" ;
        schema:measurementTechnique "border-median contrast mask on the gallery card, 160x120" ;
        schema:name "specimen foreground fraction" ;
        schema:unitText "area fraction" ;
        schema:value "0.4043" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.62" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen structure-tensor coherency = 0.7458 coherency" ;
        dct:description "specimen value and simulation reference differ; KS orientation is separate" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) on the contrast mask" ;
        schema:name "specimen structure-tensor coherency" ;
        schema:unitText "coherency" ;
        schema:value "0.7458" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> a schema:PropertyValue ;
        schema:value "0.8826" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-stem-predecessor-sigma-max-at-r-8-40> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "stem predecessor sigma_max at r=8.40 = -0.110821 1/time" ;
        dct:description "negative value means the 2.8 µm ocellar mode is absent before 44 Ma" ;
        schema:measurementTechnique "max_k sigma(k) at r_stem below onset, succini D_u" ;
        schema:name "stem predecessor sigma_max at r=8.40" ;
        schema:unitText "1/time" ;
        schema:value "-0.110821" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-stem-predecessor-sigma-max-at-r-8-40-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-stem-predecessor-sigma-max-at-r-8-40-reference> a schema:PropertyValue ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-succini-critical-wavelength-from-argmax-sigma-k> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "succini critical wavelength from argmax sigma(k) = 2.7592e-06 m" ;
        dct:description "linear prediction; reference is the assigned scale, value is the solved peak" ;
        schema:measurementTechnique "k_c = argmax sigma(k); lambda = 2 pi / k_c * 2.759e-6 m" ;
        schema:name "succini critical wavelength from argmax sigma(k)" ;
        schema:unitText "m" ;
        schema:value "2.7592e-06" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-succini-critical-wavelength-from-argmax-sigma-k-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-succini-critical-wavelength-from-argmax-sigma-k-reference> a schema:PropertyValue ;
        schema:value "2.759e-06" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-turing-band-pearson-r-of-pde-growth-vs-analytic-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing-band Pearson r of PDE growth vs analytic sigma = 1.0 correlation" ;
        dct:description "RMSE = 2.98334e-05; full-spectrum r = 0.7931 (stable modes mix the fast eigenvalue)" ;
        schema:measurementTechnique "modes with analytic sigma > -0.25; spectral 1D PDE, T=1.2" ;
        schema:name "Turing-band Pearson r of PDE growth vs analytic sigma" ;
        schema:unitText "correlation" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-turing-band-pearson-r-of-pde-growth-vs-analytic-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-turing-band-pearson-r-of-pde-growth-vs-analytic-sigma-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-turing-band-rmse-of-sigma> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Turing-band RMSE of sigma = 3e-05 1/time" ;
        dct:description "value is the residual, reference is the tolerance, they are not the same quantity" ;
        schema:measurementTechnique "sqrt mean square of numeric minus analytic growth rates on the band" ;
        schema:name "Turing-band RMSE of sigma" ;
        schema:unitText "1/time" ;
        schema:value "3e-05" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-turing-band-rmse-of-sigma-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-measurement-turing-band-rmse-of-sigma-reference> a schema:PropertyValue ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-succini-turing-wavelength-s0.py L597–L712" ;

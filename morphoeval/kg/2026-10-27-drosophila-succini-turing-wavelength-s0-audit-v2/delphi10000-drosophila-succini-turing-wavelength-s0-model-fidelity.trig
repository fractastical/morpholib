sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila succini Turing wavenumber at 2.8 µm (44 Ma, detail scale s0) — Model fidelity to source: 88/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Schnakenberg kinetics, the Jacobian trace and determinant (stable without diffusion), sigma(k), and k_c = argmax sigma are implemented, and D_u is solved so the peak is within 0.01 percent of 2.759e-06 m. The textbook k_h is computed and is not silently substituted for k_c. Deducted because no Drosophila morphogen pair is identified in Hennig 1965, and because k_h (7.30) and k_c (6.28) differ above onset." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.88"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-succini-turing-wavelength-s0.py L20–L28" ;
        dct:description "stated PDE and k_c definition at r = 18.72" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-succini-turing-wavelength-s0.py#L20-L28> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-succini-turing-wavelength-s0.py L88–L177" ;
        dct:description "jacobian through textbook_k_h" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-succini-turing-wavelength-s0.py#L88-L177> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3172_drosophila_succini_turing_wavelength_s0.lean L16–L40" ;
        dct:description "onset crossing, stem below onset, berryi shorter by 377 nm" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3172_drosophila_succini_turing_wavelength_s0.lean#L16-L40> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (loop 3172 builder-assessor, pass 2)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-succini-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-succini-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-succini-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-succini-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg activator-substrate kinetics" ;
    dct:description "Reaction terms whose Jacobian sets the Turing threshold at this scale. | Variables: a = 0.062, b = 1.180, u0 = a + b, v0 = b/u0^2, r = Dv/Du" ;
    dct:source "Schnakenberg 1979, 10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-succini-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3172_drosophila_succini_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem succini_ratio_above_onset : rOnsetX100 < rSucciniX100 := by decide"^^pk:lean4 ;
    skos:notation "du/dt = D_u ∇²u + a - u + u²v ; dv/dt = D_v ∇²v + b - u²v" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.5281/zenodo.10747237>,
        <https://doi.org/10.5281/zenodo.10748923> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3172.rSucciniX100" ;
    pk:leanTheorem "MathOfBiology.Loop_3172.succini_ratio_above_onset" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-succini-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber k_c" ;
    dct:description "D_u is solved so λ_c = 2.759 µm at r = 18.72. Textbook k_h² = (D_v f_u + D_u g_v)/(2 D_u D_v) is reported alongside k_c; above onset they differ. | Variables: k_c = argmax sigma(k); lambda_c = 2*pi/k_c; target lambda = 2.759e-06 m" ;
    dct:source "Turing 1952, 10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-succini-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3172_drosophila_succini_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem berryi_detail_wavelength_shorter : lambdaBerryiNm < lambdaSucciniNm := by decide"^^pk:lean4 ;
    skos:notation "k_c = argmax_k σ(k),  σ(k) = larger eigenvalue of J - k² diag(D_u, D_v); λ_c = 2π/k_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.5281/zenodo.10747237>,
        <https://doi.org/10.5281/zenodo.10748923> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3172.lambdaSucciniNm" ;
    pk:leanTheorem "MathOfBiology.Loop_3172.berryi_detail_wavelength_shorter" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-drosophila-succini-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Chronoseries threshold and mode count" ;
    dct:description "At 44 Ma r rises from 8.40 to 18.72 and the mode appears. By 19 Ma λ shortens to 2.382 µm at fixed r. | Variables: r_stem = 8.40, r_onset = 10.77, r_succini = 18.72, N = L/lambda" ;
    dct:source "Hennig 1965, 10.5281/zenodo.10748923; Grimaldi 1987, 10.5281/zenodo.10747237" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d/models/2026-delphi10000-drosophila-succini-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d/morphoeval/lean/loops/Loop_3172_drosophila_succini_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:definition "theorem mode_count_increases_when_domain_doubles : modeCount 8000 lambdaSucciniNm < modeCount 16000 lambdaSucciniNm := by decide"^^pk:lean4 ;
    skos:notation "pattern exists iff r > r_onset; N = L / λ_c" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.5281/zenodo.10747237>,
        <https://doi.org/10.5281/zenodo.10748923> ;
    schema:programmingLanguage "Lean 4" ;
    pk:hypothesisType "Turing reaction-diffusion wavelength selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3172.modeCount" ;
    pk:leanTheorem "MathOfBiology.Loop_3172.mode_count_increases_when_domain_doubles" ;
    pk:leanVerified true .


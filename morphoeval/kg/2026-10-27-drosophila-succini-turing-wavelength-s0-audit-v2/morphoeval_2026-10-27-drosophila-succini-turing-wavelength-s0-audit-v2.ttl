<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila succini Turing wavenumber at 2.8 µm (44 Ma, detail scale s0) — Morphological realism / specimen match: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The GIF is the Schnakenberg field, not a paste of the card: twelve frames, 960 by 720, amber spot palette. The canonical CV comparator (12-bin Sobel orientation, 24-bin radial FFT, structure-tensor coherency, occupancy) scores the last frame against the gallery card in the mid-80s, above the 58 gate. The card itself is a synthetic spiral with a 100 µm bar, so the score stays at 80 rather than a holotype match." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
    pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-succini-turing-wavelength-s0-specimen-match-1>,

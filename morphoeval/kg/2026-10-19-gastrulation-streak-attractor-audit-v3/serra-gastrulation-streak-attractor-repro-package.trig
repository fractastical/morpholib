sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Reproducibility package: 80/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: `--self-test` passes in 1.8 s and checks SHA-256 locks (4 files), Stokes Green's function error, ligand decay lengths, emergent WT speed, measured speed/aspect rank statistics (including the negative -0.20), ring asymmetry, thickening, ingression, SB431542/Y-27632 zero ingression, bitwise two-run determinism (atol = 0) and specimen CV, and reports 14 measurements; the default run regenerates the 9-panel PNG and the 24-frame GIF in 19.4 s from recorded simulated states; no RNG is used; the pinned environment (python 3.14.7, numpy 2.5.4, scipy 1.16.3, matplotlib 3.10.7, Pillow 12.0.0) is the venv. Deductions: the judged PNG is gitignored (`*.png`), so the rendered output is not tracked and the GIF is the only versioned artefact (-6); the self-test asserts the circular r = 1 statistics alongside the honest ones and so cannot fail on the model's real performance (-5); the CLI has a single flag and no --out/--gif/ --no-show options, and the 225-simulation morphospace runs unconditionally in the default render (-5); the self-test docstring and the Pass 2 measurement names are stale (-4)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:evidenceAgainst ".gitignore L48–L48: `*.png` ignored, so docs/media/gastrulation_streak_attractor_comparison.png is untracked <https://github.com/fractastical/morpholib/blob/028758bc/.gitignore#L48-L48>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-4> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L1727–L1834" ;
        dct:description "run_self_test: SHA-256 locks, Green's function, decay lengths, emergent readouts, determinism atol = 0, specimen CV; status pass, 14 measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L1727-L1834> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L1837–L1855" ;
        dct:description "main: --self-test only; default run verifies digests, renders PNG + GIF and prints measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L1837-L1855> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L1650–L1721" ;
        dct:description "render_growth_gif: 24 frames from recorded simulated states" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L1650-L1721> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-repro-package-4> a pk:EvidenceItem ;
        rdfs:label "docs/media/gastrulation_streak_attractor_growth.gif (generated output)" ;
        dct:description "24-frame GIF (1350x430) of simulated WT myosin/flow/EMT, ligands and SU5402 ring; tracked in git — docs/media/gastrulation_streak_attractor_growth.gif: rendered output of 2022-serra-gastrulation-streak-attractor.py at 028758bc, image/gif, 1340066 B, 1350×430 px, 24 frames, artifact_sha256 8f14b8854a86263a9951ed61b88ccaec0312be14acf9a1f28f5cc025e23caaab (sha256 8f14b8854a86263a9951ed61b88ccaec0312be14acf9a1f28f5cc025e23caaab), spec_fingerprint 394d38439dd8f3b351ba32f3eef22da12f99bfa222be7659901a95855eb8a1e1" .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 Phase B assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


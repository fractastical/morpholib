sub1:provenance {
    <https://doi.org/10.1038/nature08391> dcterms:date "2009"^^xsd:gYear ;
        dcterms:title "Fgf8 morphogen gradient forms by a source-sink mechanism with freely diffusing molecules" .

    <https://doi.org/10.1038/ncb1739> dcterms:date "2008"^^xsd:gYear ;
        dcterms:title "RhoA and microtubule dynamics control cell-basement membrane interaction in EMT during gastrulation" .

    <https://doi.org/10.1038/ncb3138> dcterms:date "2015"^^xsd:gYear ;
        dcterms:title "Myosin-II-mediated cell shape changes and cell intercalation contribute to primitive streak formation" .

    <https://doi.org/10.1038/s41592-023-02009-y> dcterms:date "2023"^^xsd:gYear ;
        dcterms:title "A mechanochemical model recapitulates distinct vertebrate gastrulation modes" .

    <https://doi.org/10.1126/science.1221920> dcterms:date "2012"^^xsd:gYear ;
        dcterms:title "Differential diffusivity of Nodal and Lefty underlies a reaction-diffusion patterning system" .


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L170–L247" ;
        dcterms:description "Spectral viscous Stokes solver and manufactured Green's function verification (L2 rel. error 5.97e-16) — validates the solver" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L170-L247> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L288–L318" ;
        dcterms:description "ligand_kinetic_parameters: D and half-lives from the vendored JSON converted to mm^2/h and h^-1; source amplitudes s_W/s_N/s_F, k_ind, c_max chosen in code (unsourced)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L288-L318> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L326–L356" ;
        dcterms:description "Semi-Lagrangian advection (replaces CFL-violating forward Euler) and implicit spectral diffusion-decay step" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L326-L356> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-4> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L359–L422" ;
        dcterms:description "step_ligand_fields (W -> c_ind -> N -> F cascade, advected by the physical flow) and myosin_phosphorylation_field P = rho_ROCK H(a_ALK N)(0.35 + 0.65 H(a_FGFR F))" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L359-L422> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-5> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L425–L447" ;
        dcterms:description "verify_ligand_decay_length: numerical vs analytic sqrt(D/k) (FGF8 0.8 %, Nodal 1.4 %)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L425-L447> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-6> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L468–L522" ;
        dcterms:description "step_apical_basal_column (a, b, h = 2h0/(a+b), wedging, B decay, ingression rate I) and solve_ingression_sink_velocity (lap phi = I, v = -grad phi)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L468-L522> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-7> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L697–L712" ;
        dcterms:description "pMLC source phos_m into Dm/Dt and per-step column update coupling N, F, m, receptor activities" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L697-L712> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-8> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean L225–L320" ;
        dcterms:description "Theorems ligand_cascade_posterior_myosin_asymmetry and apical_basal_wedging_ingression_sink (0 sorrys, lean exits 0)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/morphoeval/lean/loops/Loop_050_gastrulation_streak_attractor.lean#L225-L320> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Model fidelity to source: 68/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: the spectral Stokes operator eta lap v + eta_b grad(div v) = -div(m Q) is correct (Green's function error 5.97e-16); the active nematic Dm/Dt, DQ/Dt equations with strain-rate alignment and corotation are implemented; transport is now unconditionally stable semi-Lagrangian in mm/h (+); the new Wnt8c/Nodal/FGF8 cascade uses implicit spectral diffusion-decay with sourced diffusivities and verified decay lengths (+); the column model gives a constant-volume wedging/thickening law with ROCK-, Nodal- and FGF-gated BM breakdown whose ingression rate closes the loop into the planar divergence (+); the ligand->pMLC->ring asymmetry chain and the wedging->sink chain are each backed by a Lean theorem. Deductions: the planar flow is dominated by a prescribed dipole + quadrupole streamfunction and an isotropic ring-contraction term, with the Stokes solution entering at weight 0.18 (-12) — the Green's-function test validates the solver, not the model flow, and Theorem 1's circulation conservation is a symmetry of the prescribed psi; the coupled model does not form a streak (WT EMT-zone AP/ML 0.59 vs 4.25) because mediolateral intercalation is absent and the nematic feedback is too weak to elongate the crescent at physical speeds (-10); the four prescribed lookup readouts are still computed and exported alongside the honest ones (-4); ALPHA_M_HR is set to 0.10 against the vendored 0.45 without changing the JSON (-3); the column model is a per-point 2.5D reduction, not the requested 3D coupling, and the ligand fields are clipped by soft_wall each substep as a crude absorbing boundary while Wnt8c's 72 um decay length is below the 40 um grid's resolving power (-3)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:evidenceAgainst "2022-serra-gastrulation-streak-attractor.py L114–L125: U_CAL_MM_PER_H fixed on WT; ALPHA_M_HR = 0.10 deviates from the vendored 0.45; STOKES_ACTIVE_WEIGHT, GAMMA_Q_HR, D_M, D_Q unsourced <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L114-L125>",
            "2022-serra-gastrulation-streak-attractor.py L649–L667: Prescribed psi_dip / psi_quad streamfunction and iso_ring_v* dominate the planar velocity; Stokes solution enters with STOKES_ACTIVE_WEIGHT = 0.18; EMT sink added in physical units <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L649-L667>",
            "2022-serra-gastrulation-streak-attractor.py L812–L843: Retained piecewise-analytic lookup for streak_ap_ml / streak_len / peak_speed / ftle_aniso — reproduces the reference table by construction (flagged in NOTE) <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L812-L843>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-4>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-5>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-6>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-7>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-model-fidelity-8> ;
        pk:hasScore "0.68"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 Phase B assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

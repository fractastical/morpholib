sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L906–L1007" ;
        dcterms:description "evaluate_all_regimes: 5 regimes with receptor activities from the JSON; measured_* and circular pearson_r_* statistics side by side" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L906-L1007> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L1010–L1053" ;
        dcterms:description "compute_parameter_morphospace: 225 coupled 40x40 simulations over delta_m x beta_m" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L1010-L1053> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Parameter expressivity: 74/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Credited: all 5 Saadaoui/Serra regimes are evaluated and the perturbations are now mechanistic at the receptor level (SU5402 -> a_FGFR = 0, SB431542 -> a_ALK = 0, Y-27632 -> rho_ROCK, ectopic Vg1/Wnt -> anterior Wnt source) read from the vendored JSON, with qualitatively correct emergent responses (SU5402 uniform ring asymmetry 0.00 vs WT 0.63; Vg1 bipolar ring ~ -0.05; SB431542 and Y-27632 ingression 0; emergent speed rank order rho = 0.90) (+); the 15x15 (delta_m x beta_m) morphospace now runs 225 coupled simulations instead of evaluating the analytic lookup (+). Deductions: the field-derived EMT-zone aspect ratio does not order the regimes as the reference does (Spearman rho = -0.20), so the parameter axis that the morphospace claims to span (streak elongation) is not actually expressed by the model (-14); the regime table still carries the prescribed lookup values and the circular pearson_r_aspect/speed statistics next to the honest ones (-6); only one CLI flag (--self-test) exists, so no regime, grid or parameter can be selected from the command line (-6)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2022-serra-gastrulation-streak-attractor.py L1837–L1851: CLI exposes only --self-test; no regime/parameter selection <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L1837-L1851>",
            "2022-serra-gastrulation-streak-attractor.py L972–L983: NOTE: pearson_r_aspect / pearson_r_speed are circular (r = 1 by construction); Spearman rho on measured readouts is the honest statistic <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L972-L983>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-parameter-expressivity-2> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 Phase B assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


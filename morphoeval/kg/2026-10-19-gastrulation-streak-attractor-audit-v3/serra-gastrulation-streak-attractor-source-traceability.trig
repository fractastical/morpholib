sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Source and data traceability: 70/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: datasets/gastrulation_streak_attractor/ now carries 4 SHA-256-pinned files (the new ligand_emt_reference.json included) verified fail-closed at every run; the README gained a Pass 3 section that lists every ASSUMED/DERIVED constant; paper_citations.bib grew to 8 entries; the ligand diffusivities D_FGF8 = 53 um^2/s (Yu 2009) and D_Nodal = 3.2 um^2/s, t1/2 = 95 min (Muller 2012) are the published values. Deductions: the seed-paper citation 'Serra et al. (2023) Nature Methods / Science Advances 20:1739-1748, DOI 10.1038/s41592-023-02009-y' (docstring, bib, JSON, README, this audit) is internally inconsistent and almost certainly wrong — the assessor believes the paper is Science Advances 9(49):eadh8152 — and could not be verified offline (-10); the four new DOIs were recalled from memory and are marked unverified (-5); Wnt8c D and half-life, FGF8 half-life, h0, all column kinetics, the source amplitudes and Hill constants are ASSUMED, and ALPHA_M_HR = 0.10 in code contradicts the vendored alpha_m = 0.45 without a JSON change (-10); U_CAL_MM_PER_H, STOKES_ACTIVE_WEIGHT, GAMMA_Q_HR, D_M, D_Q have no citation (-5)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "2022-serra-gastrulation-streak-attractor.py L116–L118: Comment says the vendored alpha_m = 0.45 is used; code sets ALPHA_M_HR = 0.10 <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L116-L118>",
            "2022-serra-gastrulation-streak-attractor.py L11–L14: Serra et al. (2023) cited as 'Nature Methods / Science Advances 20:1739-1748, DOI 10.1038/s41592-023-02009-y' — inconsistent venue, DOI unverified and likely wrong <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L11-L14>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-source-traceability-3>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-source-traceability-4> ;
        pk:hasScore "0.7"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2022-serra-gastrulation-streak-attractor.py L127–L159" ;
        dct:description "EXPECTED_SHA256 for 4 dataset files incl. ligand_emt_reference.json; verify_dataset_integrity fail-closed" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L127-L159> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "datasets/gastrulation_streak_attractor/ligand_emt_reference.json L1–L139" ;
        dct:description "Pass 3 ligand/EMT reference table with per-parameter source fields; ASSUMED at lines 53, 59, 61, 117 and DERIVED at line 130" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/gastrulation_streak_attractor/ligand_emt_reference.json#L1-L139> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/gastrulation_streak_attractor/paper_citations.bib L46–L89" ;
        dct:description "4 new entries (yu2009, muller2012, nakaya2008, voiculescu2014); DOIs recalled from memory, unverified" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/gastrulation_streak_attractor/paper_citations.bib#L46-L89> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-source-traceability-4> a pk:EvidenceItem ;
        rdfs:label "datasets/gastrulation_streak_attractor/README.md L32–L42" ;
        dct:description "Pass 3 section documenting the new table, its sources and the ASSUMED/DERIVED flags" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/028758bc/datasets/gastrulation_streak_attractor/README.md#L32-L42> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (primary, Pass 3 Phase B assessor) + Claude Sonnet 5.5 High (independent second assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


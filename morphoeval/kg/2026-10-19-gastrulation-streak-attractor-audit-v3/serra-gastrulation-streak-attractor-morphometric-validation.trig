sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-serra-gastrulation-streak-attractor> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Saadaoui et al. (2020), Serra et al. (2023) & Rozbicki et al. (2015) avian gastrulation tensile ring, Polonaise twin-vortex flow & primitive streak attractor — Morphometric validation: 62/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "Credited: measure_morphoeval() now returns 14 measurements, of which the 7 new Pass 3 ones are field-derived and honest — FGF8 decay length 373.9 vs 371.0 um analytic, WT emergent ring asymmetry 0.63 vs 0.74 HH1 initial, 5-regime emergent speed Spearman rho 0.90, 5-regime EMT-zone aspect Spearman rho -0.20 (reported as a failure), WT thickening 1.26 vs 1.33, SB431542 ingressed fraction 0.0 vs 0.0, WT BM-broken area fraction 0.17 vs 0.08 — and the figure's Panel I prints them (+). Deductions: four of the seven retained Pass 2 measurements ('wild-type HH3 primitive streak AP/ML 4.25', 'peak speed 2.40', '5-regime r = 1.0000', 'SU5402 AP/ML 1.00') are lookups that reproduce their own reference values and are still emitted as if they were model outputs (-14); the thickening (1.33) and BM-fraction (0.08) reference values are DERIVED in the JSON, not measured chick values, and the BM-fraction measurement misses its target by 2x (-6); the PIV symmetry reference 0.9705 is the script's own output and the 5.00x specimen fold change is partly hard-coded in the figure (-6); the WT peak speed (2.14 um/min) is calibrated by construction via U_CAL_MM_PER_H and so is not an independent validation (-4); only n = 5 regimes enter the rank correlations, so rho = 0.90 carries little statistical weight (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2022-serra-gastrulation-streak-attractor.py L1296–L1365: Retained Pass 2 measurements 1-4 built on the prescribed lookup readouts (AP/ML 4.25, speed 2.40, r = 1.0000, SU5402 1.00) — circular, non-evidence <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L1296-L1365>",
            "2022-serra-gastrulation-streak-attractor.py L1399–L1411: Specimen PIV symmetry measurement with reference_value 0.9705 equal to the script's own output <https://github.com/fractastical/morpholib/blob/028758bc/2022-serra-gastrulation-streak-attractor.py#L1399-L1411>",
            "datasets/gastrulation_streak_attractor/ligand_emt_reference.json L117–L139: h0 ASSUMED; thickening ratio 1.33 and BM-broken fraction 0.08 DERIVED, not measured <https://github.com/fractastical/morpholib/blob/028758bc/datasets/gastrulation_streak_attractor/ligand_emt_reference.json#L117-L139>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-field-derived-emt-zone-ap-ml-aspect-spearman-rho-vs-reference-uncalibrated>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-field-derived-peak-tissue-speed-spearman-rho-vs-saadaoui-serra-reference-uncalibrated>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-primitive-streak-ap-ml-elongation-pearson-correlation-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-ap-ml-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf8-source-sink-decay-length-lambda-sqrt-d-k-spectral-solver-vs-analytic>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-sb431542-nodal-alk-blocked-cumulative-ingressed-area-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-area-pellucida-to-area-opaca-radius-ratio-r-ap-r-ao>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh1-to-hh3-primitive-streak-ap-ml-elongation-fold-change>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-specimen-hh2-polonaise-piv-bilateral-vortex-symmetry-index>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-basement-membrane-breakdown-confinement-bm-broken-area-fraction-of-the-epiblast-disc>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-emergent-posterior-anterior-marginal-ring-myosin-asymmetry-m-post-m-ant-m-post-m-ant>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-hh3-primitive-streak-ap-ml-aspect-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-peak-polonaise-twin-vortex-tissue-speed>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-wild-type-streak-column-thickening-ratio-h-streak-h-0-constant-volume-apical-basal-wedging>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-morphometric-validation-2> ;
        pk:hasScore "0.62"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-field-derived-emt-zone-ap-ml-aspect-spearman-rho-vs-reference-uncalibrated> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime field-derived EMT-zone AP/ML aspect Spearman rho vs reference (uncalibrated) = -0.2 correlation_rho" ;
        dct:description "measured AP/ML = [0.59, 1.0, 0.39, 0.64, 0.47] vs ref [4.25, 1.0, 3.45, 2.15, 0.42]; Pearson r = -0.3642. HONEST RESIDUAL: the coupled 2D model forms a posterior ingressing crescent (WT AP/ML = 0.59) but does not elongate it into the 4.25:1 midline streak within 8 h — mediolateral intercalation (Rozbicki et al. 2015) is missing (Pass 4 item)" ;
        schema:measurementTechnique "AP/ML bounding-box ratio of the largest basement-membrane-breakdown zone (1 - B >= 0.5 max; fallback: myosin field) across the 5 regimes vs the reference streak AP/ML" ;
        schema:name "5-regime field-derived EMT-zone AP/ML aspect Spearman rho vs reference (uncalibrated)" ;
        schema:unitText "correlation_rho" ;
        schema:value "-0.2" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-field-derived-emt-zone-ap-ml-aspect-spearman-rho-vs-reference-uncalibrated-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-field-derived-emt-zone-ap-ml-aspect-spearman-rho-vs-reference-uncalibrated-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science Figs. 1-4; Serra et al. (2023) Figs. 2-5" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-field-derived-peak-tissue-speed-spearman-rho-vs-saadaoui-serra-reference-uncalibrated> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "5-regime field-derived peak tissue speed Spearman rho vs Saadaoui/Serra reference (uncalibrated) = 0.9 correlation_rho" ;
        dct:description "measured speeds (um/min) = [2.14, 0.64, 1.08, 1.11, 0.0] vs ref [2.4, 0.72, 2.05, 1.48, 0.12]; Pearson r = 0.9271, RMSE = 0.48 um/min; the calibrated lookup r = 1.0000 is circular and should not be scored" ;
        schema:measurementTechnique "Peak |v| of the emergent physical flow (single global U_CAL constant fixed on WT) across the 5 regimes vs the reference peak speeds; rank correlation so the WT calibration cannot inflate it" ;
        schema:name "5-regime field-derived peak tissue speed Spearman rho vs Saadaoui/Serra reference (uncalibrated)" ;
        schema:unitText "correlation_rho" ;
        schema:value "0.9" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-field-derived-peak-tissue-speed-spearman-rho-vs-saadaoui-serra-reference-uncalibrated-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-field-derived-peak-tissue-speed-spearman-rho-vs-saadaoui-serra-reference-uncalibrated-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science Figs. 2-4; Serra et al. (2023) Figs. 2-5 (regime ordering WT > Vg1 > SB431542 > SU5402 > Y-27632)" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-primitive-streak-ap-ml-elongation-pearson-correlation-r> a schema:PropertyValue,

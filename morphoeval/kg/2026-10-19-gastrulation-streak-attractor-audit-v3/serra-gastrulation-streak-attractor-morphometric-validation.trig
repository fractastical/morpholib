        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-primitive-streak-ap-ml-elongation-pearson-correlation-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-5-regime-primitive-streak-ap-ml-elongation-pearson-correlation-r-reference> a schema:PropertyValue ;
        dct:source "Saadaoui et al. (2020) Science 367:453-458 Figs. 3-4; Serra et al. (2023) Nat. Methods Figs. 2-5" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf-inhibited-su5402-circular-ring-ap-ml-aspect-ratio> a schema:PropertyValue,

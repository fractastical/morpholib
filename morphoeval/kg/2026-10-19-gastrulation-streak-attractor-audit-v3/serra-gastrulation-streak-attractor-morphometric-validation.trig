    <https://w3id.org/probknow/resource/evidence/morphoeval-serra-gastrulation-streak-attractor-measurement-fgf8-source-sink-decay-length-lambda-sqrt-d-k-spectral-solver-vs-analytic> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "FGF8 source-sink decay length lambda = sqrt(D/k) (spectral solver vs analytic) = 373.9 um" ;
        dct:description "rel. error = 7.898e-03; Nodal lambda = 162 um (D = 3.2 um^2/s, t_1/2 = 95 min, Müller et al. 2012); in-regime WT midline FGF8 e-folding = 501 um (advection + distributed source broaden it)" ;
        schema:measurementTechnique "Implicit spectral reaction-diffusion of a midline FGF8 line source with linear clearance (D = 53 um^2/s, t_1/2 = 30 min); e-folding fit over 0.3-1.2 lambda (inside the periodic-image-free window)" ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila takahashii Schnakenberg Turing wavelength at 2.362 µm (Pass 1 field render) — Model fidelity to source: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The script integrates the Schnakenberg system and the Turing dispersion σ(k), and the analytic peak is 2.3615 µm against the 2.362 µm target (within 1%). Explicit Euler and periodic boundaries are a reconstruction. The 2.362 µm length is the slot scale, not a fitted wet-lab constant." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-model-fidelity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py L105–L149" ;
        dct:description "Jacobian at u0=a+b and dispersion peak λ=2π/k_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/948e555fd733650f05998c84112d9f34e837fe61/models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py#L105-L149> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-takahashii-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py L156–L191" ;
        dct:description "Periodic explicit Euler of the Schnakenberg PDE" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/948e555fd733650f05998c84112d9f34e837fe61/models/2026-delphi10000-drosophila-takahashii-turing-wavelength-s0.py#L156-L191> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent; no independent second assessor)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://x.ai> .
}


sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-033> a pk:Claim ;
        rdfs:label "Thompson (1917) T1917-033 golden divergence & Fibonacci parastichies faithfully reproduces Helianthus annuus morphology" ;
        dct:description "The simulation script(s) thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py, docs/media/t1917_033_on_leaf_arrangement_or_phyllot_growth.gif, datasets/thompson_1917/t1917-033/result.json implement the cited source model as published and produce forms that match real Helianthus annuus specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-033/result.json>,
            <https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_033_on_leaf_arrangement_or_phyllot_growth.gif>,
            <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py, https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_033_on_leaf_arrangement_or_phyllot_growth.gif, https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-033/result.json; output: docs/media/t1917_033_on_leaf_arrangement_or_phyllot_comparison.png; organism: Helianthus annuus; environment: n/a; claim_boundary: [reported_in_source: Thompson (1917) golden angle ~137.5 deg, rational convergents, Fibonacci parastichies; reconstructed_in_script: DoG segmentation, Vogel-fit alpha inversion (134-139 deg scan), rational sweep, ablation, KS golden vs 120 deg, rising (21,34)->(34,55) cascade; does_not_claim: Does not re-digitize Thompson 1917 Figs. 325-327 from IA scan in this pass]; phenomenon_size: 40.0 cm (0.4 m, log10=-0.398 m, tier=8_colonial_m); species_scale_ladder (2 runs from 40.0 cm to 48.4 cm): 40.0 cm:vogel-phyllotaxis, 48.4 cm:magnetic-drop-phyllotaxis" .
    <https://github.com/fractastical/morpholib/blob/main/datasets/thompson_1917/t1917-033/result.json> a schema:SoftwareSourceCode ;
        rdfs:label "datasets/thompson_1917/t1917-033/result.json" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/docs/media/t1917_033_on_leaf_arrangement_or_phyllot_growth.gif> a schema:SoftwareSourceCode ;
        rdfs:label "docs/media/t1917_033_on_leaf_arrangement_or_phyllot_growth.gif" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> .
    <https://github.com/fractastical/morpholib/blob/main/thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py> a schema:SoftwareSourceCode ;
        rdfs:label "thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0002-1825-0097> .
}


<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-033-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-033-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-033-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-033-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Thompson (1917) Fibonacci convergent bracket of the golden divergence turn fraction" ;
    dct:description "Formalises Thompson's rational approximations bracketing the golden angle | Variables: alpha: divergence angle; F_k: Fibonacci numbers" ;
    dct:source "Thompson (1917) On Growth and Form Ch. XIV pp. 635-651 Figs. 325-327" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_033.lean#L28-L42>,
        <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "3/8 < alpha/(2pi) < 5/13  <=>  135 deg < alpha < 138.46 deg;  convergents alternate: 1/2, 1/3, 2/5, 3/8, 5/13, 8/21, 13/34" ;
    pk:hypothesisType "quantitative-empirical" ;
    pk:leanDeclaration "MathOfBiology.Loop_227.turn_fraction_lt" ;
    pk:leanTheorem "MathOfBiology.Loop_227.thompson_rational_convergents_bracket_golden_turn" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-033-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Rising phyllotaxis Cassini invariant |D(p,q)| along Fibonacci parastichy cascade" ;
    dct:description "Links Thompson's Fibonacci parastichy numbers to unimodular lattice geometry | Variables: (p,q): opposing contact parastichy numbers" ;
    dct:source "Thompson (1917) Ch. XIV; van Iterson (1907); Jean (1994)" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_033.lean#L44-L56>,
        <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "D(p,q) = p^2 + p q - q^2;  D(q,p+q) = -D(p,q);  |D(5,8)| = 1" ;
    pk:hypothesisType "quantitative-empirical" ;
    pk:leanDeclaration "MathOfBiology.Loop_227.cassini_det" ;
    pk:leanTheorem "MathOfBiology.Loop_227.thompson_rising_phyllotaxis_preserves_cassini_magnitude" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-033-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fibonacci parastichy recurrence F_{n+2} = F_{n+1} + F_n" ;
    dct:description "Machine-checked Fibonacci pair identities for Thompson's spiral diagrams | Variables: F_k: Fibonacci parastichy order" ;
    dct:source "Thompson (1917) Ch. XIV Figs. 325-327" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_033.lean#L58-L72>,
        <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-033_on-leaf-arrangement-or-phyllotaxis.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "(3,5) -> (5,8) -> (8,13);  alpha_k = 360 * F_{k-2}/F_k converges to 137.507764 deg" ;
    pk:hypothesisType "quantitative-empirical" ;
    pk:leanDeclaration "MathOfBiology.Loop_227.fib" ;
    pk:leanTheorem "MathOfBiology.Loop_227.thompson_fibonacci_parastichy_recurrence" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


        rdfs:label "mesh_cuc2_mutant_lateral_veins = 0 count" ;
        schema:measurementTechnique "Lateral vein sources + canalized strands in the cuc2-1 mesh (no auxin convergence peaks -> midvein only)" ;
        schema:name "mesh_cuc2_mutant_lateral_veins" ;
        schema:unitText "count" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-cuc2-mutant-lateral-veins-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-cuc2-mutant-lateral-veins-reference> a schema:PropertyValue ;

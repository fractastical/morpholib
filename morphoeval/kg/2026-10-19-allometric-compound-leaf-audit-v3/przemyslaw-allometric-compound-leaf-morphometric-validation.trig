        rdfs:label "mesh_inverted_triangles_total = 0 count" ;
        schema:measurementTechnique "Sum of elements with non-positive signed area at the end of the 4 spring-lattice runs" ;
        schema:name "mesh_inverted_triangles_total" ;
        schema:unitText "count" ;
        schema:value "0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-inverted-triangles-total-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-inverted-triangles-total-reference> a schema:PropertyValue ;
        dct:source "Mesh-validity requirement (no element inversion) across the 4 lamina runs" ;
        schema:value "0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-lateral-veins-drained-to-midvein-fraction> a schema:PropertyValue,

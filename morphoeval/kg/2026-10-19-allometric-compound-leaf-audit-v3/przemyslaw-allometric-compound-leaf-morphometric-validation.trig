        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-max-residual-force-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-max-residual-force-reference> a schema:PropertyValue ;
        dct:source "Quasi-static equilibrium requirement of the overdamped relaxation (180 iterations, eta = 0.05)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-mt-ablation-dissection-index-delta> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mesh_mt_ablation_dissection_index_delta = 0.0294 (R_tip-R_sinus)/R_tip" ;
        schema:measurementTechnique "Mesh I_D with vein-axis microtubule anisotropy (a_vein = 0.20) minus the ablation (a_vein = 0); positive = anisotropic vein growth deepens emergent teeth" ;
        schema:name "mesh_mt_ablation_dissection_index_delta" ;
        schema:unitText "(R_tip-R_sinus)/R_tip" ;
        schema:value "0.0294" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-mt-ablation-dissection-index-delta-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-mt-ablation-dissection-index-delta-reference> a schema:PropertyValue ;
        dct:source "Hamant et al. (2008) Science 322:1650-1655 & Sampathkumar et al. (2014) eLife 3:e01967 (microtubule-mediated anisotropy required for organ outgrowth shape; reference 0.0 is the null, expected > 0)" ;
        schema:value "0.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-vein-axial-stretch-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "mesh_vein_axial_stretch_ratio = 1.0423 lambda_par/lambda_perp" ;
        schema:measurementTechnique "Median realised deformation-gradient stretch along vs. across the local vein axis in vein-adjacent elements (Ch WT); tissue compatibility suppresses most of the prescribed 20% anisotropy" ;
        schema:name "mesh_vein_axial_stretch_ratio" ;
        schema:unitText "lambda_par/lambda_perp" ;

sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop: emergent integrated-contour dissection, growing cellular spring-lattice lamina with Mitchison-canalized veins and microtubule-anisotropic growth, and Cardamine hirsuta specimen segmentation — Morphometric validation: 55/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`measure_morphoeval()` (L1339-1570) returns 20 measurements, every one with unit, reference_value, reference_source, uncertainty and method; all dissection indices are emergent and the circular Pass 2 r = 0.998 is explicitly withdrawn (L1426-1434). Lean-mirrored identities (L1216-1249) and mesh-validity metrics (inverted elements 0, residual 1e-3) are included. Deductions: At WT is a calibration (kappa_n tuned to 0.228, L426), not a prediction (-5); Ch WT misses by 0.53, mir164a-4 by 0.21 and the rco/At WT order is inverted, so the only free predictions fail (-15); the emergent r = 0.807 has p = 0.052 (-5); the specimen measurements' references are self-referential (-7); the MT-ablation effect (delta I_D 0.029) and the vein-axial stretch ratio (1.04 vs 1.02 control) are within the resolution-limit noise of a one-vertex tooth (-8); the `cuc2_mutant_smooth` measurement's reference uncertainty was widened to 0.012 so that 0.000 vs 0.012 passes (-5)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2011-przemyslaw-allometric-compound-leaf.py L1415–L1424: cardamine_wt_compound_dissection_index_ID = 0.254 vs reference 0.785 is reported as OUT-OF-PREDICTION rather than fitted <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1415-L1424>",
            "2011-przemyslaw-allometric-compound-leaf.py L426–L427: kappa_n = 0.50 calibrated on the At WT datum: the At WT measurement is a fit <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L426-L427>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-auxin-cuc2-antiphase-r>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-serration-dissection-index-id>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-to-arabidopsis-id-contrast-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-wt-compound-dissection-index-id>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-mutant-smooth-dissection-index-id>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-genotype-morphospace-pearson-r-emergent>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-hamant-anisotropic-growth-partition-identity-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law1-pin1-upgradient-promotion-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-law2-outgrowth-decomposition-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-cuc2-mutant-lateral-veins>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-inverted-triangles-total>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-lateral-veins-drained-to-midvein-fraction>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-max-residual-force>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-mt-ablation-dissection-index-delta>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-vein-axial-stretch-ratio>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mitchison-canalization-conductance-feedback-identity-error>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-detected-compound-leaflet-lobes>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-specimen-empirical-dissection-index-id>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-stage-dissection-index-monotonic-increments>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-sweep-max-emergent-id-eta-x-growth-duration>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation-2> ;
        pk:hasScore "0.55"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-auxin-cuc2-antiphase-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "arabidopsis_wt_auxin_cuc2_antiphase_r = -0.9912 r" ;
        schema:measurementTechnique "Spatial Pearson correlation between epidermal margin Auxin A(s) and CUC2 C(s) in Arabidopsis WT; NOTE the peak positions are a prescribed convergence template (see simulate_growing_margin_feedback_pde docstring)" ;
        schema:name "arabidopsis_wt_auxin_cuc2_antiphase_r" ;
        schema:unitText "r" ;
        schema:value "-0.9912" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-auxin-cuc2-antiphase-r-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-auxin-cuc2-antiphase-r-reference> a schema:PropertyValue ;
        dct:source "Bilsborough et al. (2011) PNAS 108:3424-3429 Figs. 1-2 (complementary epidermal Auxin tooth peaks vs CUC2 sinus maxima)" ;
        schema:value "-0.942" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-serration-dissection-index-id> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "arabidopsis_wt_serration_dissection_index_ID = 0.23 (R_tip-R_sinus)/R_tip" ;
        schema:measurementTechnique "EMERGENT I_D of the integrated At WT contour; the single gain kappa_n = 0.50 was calibrated on this one datum, so this is a fit not a prediction. mir164a-4 (ref 0.445) is under-predicted" ;
        schema:name "arabidopsis_wt_serration_dissection_index_ID" ;
        schema:unitText "(R_tip-R_sinus)/R_tip" ;
        schema:value "0.23" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-serration-dissection-index-id-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-arabidopsis-wt-serration-dissection-index-id-reference> a schema:PropertyValue ;
        dct:source "Bilsborough et al. (2011) PNAS 108:3424-3429 Fig. 3 & Kierzkowski et al. (2019) Cell 177:1405-1418 (Arabidopsis Col-0 serrated margin)" ;
        schema:value "0.228" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-to-arabidopsis-id-contrast-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cardamine_to_arabidopsis_ID_contrast_ratio = 1.1063 ratio" ;
        schema:measurementTechnique "Emergent compound-vs-serrated dissection contrast; quantifies the missing RCO/KNOX leaflet-growth mechanism" ;
        schema:name "cardamine_to_arabidopsis_ID_contrast_ratio" ;
        schema:unitText "ratio" ;
        schema:value "1.1063" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-to-arabidopsis-id-contrast-ratio-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-to-arabidopsis-id-contrast-ratio-reference> a schema:PropertyValue ;
        dct:source "Kierzkowski et al. (2019) Cell 177:1405-1418 / Barkoulas et al. (2008): I_D(Ch WT)/I_D(At WT) = 0.785/0.228" ;
        schema:value "3.443" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-wt-compound-dissection-index-id> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cardamine_wt_compound_dissection_index_ID = 0.2544 (R_tip-R_sinus)/R_tip" ;
        schema:measurementTechnique "EMERGENT I_D of the integrated C. hirsuta WT contour (eta from the reference JSON). OUT-OF-PREDICTION: linear (1 - eta C) sinus repression with equal tip/sinus growth duration cannot produce leaflet-level dissection (Pass 4 remediation item)" ;
        schema:name "cardamine_wt_compound_dissection_index_ID" ;
        schema:unitText "(R_tip-R_sinus)/R_tip" ;
        schema:value "0.2544" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-wt-compound-dissection-index-id-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cardamine-wt-compound-dissection-index-id-reference> a schema:PropertyValue ;
        dct:source "Barkoulas et al. (2008) Nat. Genet. 40:1136-1141, Vlad et al. (2014) Science 343:780-783 & Kierzkowski et al. (2019) Cell 177:1405-1418" ;
        schema:value "0.785" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-mutant-smooth-dissection-index-id> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cuc2_mutant_smooth_dissection_index_ID = 0.0 (R_tip-R_sinus)/R_tip" ;
        schema:measurementTechnique "EMERGENT radial dissection index of the integrated margin contour (find_peaks on log R) for cuc2-1 (ref 0.012) and cuc2-1D uniform CUC2 (ref 0.025): no lateral tooth is detected so I_D = 0 exactly" ;
        schema:name "cuc2_mutant_smooth_dissection_index_ID" ;
        schema:unitText "(R_tip-R_sinus)/R_tip" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-mutant-smooth-dissection-index-id-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-mutant-smooth-dissection-index-id-reference> a schema:PropertyValue ;
        dct:source "Bilsborough et al. (2011) PNAS 108:3424-3429 Fig. 2 (smooth untoothed leaf margin in cuc2-1 and pin1 mutants)" ;
        schema:value "0.012" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-genotype-morphospace-pearson-r-emergent> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "genotype_morphospace_pearson_r_emergent = 0.8075 r" ;
        schema:measurementTechnique "Pearson r of emergent vs reference I_D across 6 genotypes with ONE calibrated gain (Pass 2 reported r = 0.998 by reading back fitted targets; that number was circular and is withdrawn)" ;
        schema:name "genotype_morphospace_pearson_r_emergent" ;
        schema:unitText "r" ;
        schema:value "0.8075" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-genotype-morphospace-pearson-r-emergent-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-genotype-morphospace-pearson-r-emergent-reference> a schema:PropertyValue ;
        dct:source "6-genotype Arabidopsis/Cardamine dissection depth benchmark (cuc2-1, cuc2-1D, At WT, mir164a-4, Ch rco, Ch WT); reference_value 1.0 = perfect rank agreement" ;
        schema:value "1.0" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-hamant-anisotropic-growth-partition-identity-error> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "hamant_anisotropic_growth_partition_identity_error = 0.0 rate_units" ;

        rdfs:label "mesh_lateral_veins_drained_to_midvein_fraction = 1.0 fraction" ;
        schema:measurementTechnique "Fraction of Mitchison flux-canalized lateral vein strands (D >= 0.5*threshold*D0) connected to the procambial midvein in the growing spring-lattice lamina (At WT + Ch WT)" ;
        schema:name "mesh_lateral_veins_drained_to_midvein_fraction" ;
        schema:unitText "fraction" ;
        schema:value "1.0" ;
        schema:valueReference <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-lateral-veins-drained-to-midvein-fraction-reference> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-mesh-lateral-veins-drained-to-midvein-fraction-reference> a schema:PropertyValue ;
        dct:source "Scarpella et al. (2006) Genes Dev 20:1015-1027 (each marginal auxin convergence point initiates a vein strand that canalizes into the midvein)" ;
        schema:value "1.0" .

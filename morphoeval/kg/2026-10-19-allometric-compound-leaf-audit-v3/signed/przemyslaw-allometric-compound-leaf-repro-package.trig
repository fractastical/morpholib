sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-repro-package> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop: emergent integrated-contour dissection, growing cellular spring-lattice lamina with Mitchison-canalized veins and microtubule-anisotropic growth, and Cardamine hirsuta specimen segmentation — Reproducibility package: 84/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "12-check deterministic `run_self_test()` (L1928-2020; ~14 s) covering SHA-256 integrity, Laws 1-3, emergent mutant smoothness (I_D == 0 exactly), At WT calibration tolerance, RCO ordering, a guard that the documented Ch limitation still holds, stage monotonicity, sweep monotonicity/ceiling, specimen, mesh bilateral symmetry to 1e-6, finiteness, inverted-element and residual bounds, vein drainage counts, MT-ablation sign, Lean-mirrored identities and the 20-measurement contract; no RNG anywhere; default render ~18 s producing 4 artifacts; `--print-measurements` emits JSON; Lean file verifies in < 1 s. Deductions: the mesh morphospace is process-cached (`_MESH_CACHE`, L1175-1183) so `--mesh-steps` values other than 100 are not covered by the assertion thresholds (-5); no pinned requirements file for the environment (-4); matplotlib emits a font-cache warning unless MPLCONFIGDIR is set (-2); the self-test does not re-verify the rendered artifacts' existence/size (-5)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-repro-package-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-repro-package-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-repro-package-3> ;
        pk:hasScore "0.84"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L1928–L2020" ;
        dcterms:description "12-check self-test: integrity (1), Law 1 (2), antiphase (3), Law 2 + emergent smooth mutants (4), Law 3 + At calibration + RCO ordering + limitation guard (5), stages (6), sweep (7), specimen (8), mesh symmetry/validity/veins (9), MT ablation (10), Lean mirrors (11), 20 measurements (12)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1928-L2020> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-repro-package-2> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L1175–L1183" ;
        dcterms:description "cached_lamina_mesh_morphospace: one ~13 s mesh run per process shared by self-test, measurements and renderer" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1175-L1183> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-repro-package-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean L1–L226" ;
        dcterms:description "5 theorems, 0 sorrys, `lean <file>` exit 0 (Lean 4.35.0, core only)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/lean/loops/Loop_037_allometric_compound_leaf.lean#L1-L226> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 037 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


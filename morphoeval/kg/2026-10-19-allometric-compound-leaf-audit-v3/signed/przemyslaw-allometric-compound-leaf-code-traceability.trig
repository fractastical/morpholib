sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L1–L80" ;
        dcterms:description "Module docstring: Pass 3 changes, honest outcome, laws 1-5 with Lean theorem names and verified loci (L36-61, L80-97, L116-146, L164-192, L206-224)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1-L80> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/przemyslaw-allometric-compound-leaf.yaml L1–L143" ;
        dcterms:description "5 registered equations (2 new: Hamant partition, Mitchison feedback) with lean_decl/lean_theorem/lean_locus/code_locus and Pass 3 parameter block" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/morphoeval/math_kg_loops/przemyslaw-allometric-compound-leaf.yaml#L1-L143> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 037 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop: emergent integrated-contour dissection, growing cellular spring-lattice lamina with Mitchison-canalized veins and microtubule-anisotropic growth, and Cardamine hirsuta specimen segmentation — Code-to-model traceability: 80/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The module docstring (L1-80) maps all five laws to their Lean theorems with verified line loci and states the Pass 3 changes, the honest outcome and the model's limits; `GrowingLaminaSpringMesh` and the new helpers carry per-step citations (Mitchison, Scarpella, Hamant, Sampathkumar, Kierzkowski); the math-KG yaml (`przemyslaw-allometric-compound-leaf.yaml`, 5 equations) has lean_locus and code_locus entries that were re-checked against the current file. Deductions: several docstrings and the Section 2 header still call the prescribed-template margin signal a \"reaction-transport PDE\" (L154-186) (-8); v2 line references elsewhere in the repository (v2 audit, KG) now point at shifted lines (-4); panel titles in the growth GIF still read as validation rather than template output (-4); mesh parameter defaults are documented only in the signature, not in the docstring (-4)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2011-przemyslaw-allometric-compound-leaf.py L154–L186: simulate_growing_margin_feedback_pde is still documented as a reaction-transport PDE although its peaks are a Gaussian template (see HONESTY NOTE L187) <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L154-L186>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability-2> ;
        pk:hasScore "0.8"^^xsd:double ;
        pk:hasVerdict "faithful" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L1250–L1338" ;
        dcterms:description "Excess-green + distance-transform segmentation of the Cardamine hirsuta specimen: 32 lobes, P/(2 sqrt(pi A)) = 4.0939, radial I_D = 0.5202 +- 0.0128 SE (unchanged from v2)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1250-L1338> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/allometric_compound_leaf_comparison.png (generated output)" ;
        dcterms:description "6-panel figure: antiphase, EMERGENT genotype contours with ref vs emergent I_D in the legend, P3-P6 stages, honest 6-genotype bar chart (r = 0.807; 'Pass 2 r=0.998 was circular'), specimen ROI and segmentation — docs/media/allometric_compound_leaf_comparison.png: rendered output of 2011-przemyslaw-allometric-compound-leaf.py at d58a084, image/png, 881504 B, 2475×1530 px, artifact_sha256 4ac058048dd650b246bc2e4bb020b667700ab266be113dacd5722e2e338d3a11 (sha256 4ac058048dd650b246bc2e4bb020b667700ab266be113dacd5722e2e338d3a11), spec_fingerprint f2deb6d5b7f7613348124ac9cf34bbeb431e1d1f13eac9c5772c32d01ccc0fba" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/allometric_compound_leaf_vertex_mesh.png (generated output)" ;
        dcterms:description "4 growing lamina meshes (At WT, Ch WT, cuc2-1, Ch MT-off) with canalized veins, MT axes and growth field; eta x duration heatmap; mesh morphometrics — docs/media/allometric_compound_leaf_vertex_mesh.png: rendered output of 2011-przemyslaw-allometric-compound-leaf.py at d58a084, image/png, 923866 B, 2550×1575 px, artifact_sha256 ec45f3f609a2fe49b0bf94bade3506851314cb24dab88b5b5749808eed12cb7e (sha256 ec45f3f609a2fe49b0bf94bade3506851314cb24dab88b5b5749808eed12cb7e), spec_fingerprint f2deb6d5b7f7613348124ac9cf34bbeb431e1d1f13eac9c5772c32d01ccc0fba" .

    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop: emergent integrated-contour dissection, growing cellular spring-lattice lamina with Mitchison-canalized veins and microtubule-anisotropic growth, and Cardamine hirsuta specimen segmentation — Morphological realism / specimen match: 58/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "The SHA-256-pinned Cardamine hirsuta specimen is segmented as in v2 (`segment_cardamine_compound_leaf_specimen`, L1250-1338: 32 leaflet lobes, perimeter ratio 4.0939, I_D 0.5202 +- 0.0128) and the comparison figure now places the EMERGENT genotype contours and the honest 6-genotype bar chart beside the specimen panels (`render_outputs`, L1571-1801), while the new vertex-mesh figure shows the four lamina runs with veins and MT axes (L1833-1927). Deductions: the simulated Cardamine WT (I_D 0.254 contour, 0.131 mesh) does not match the compound specimen morphology (0.52 canopy-level, visibly pinnate leaflets) and no simulated output is registered to the specimen (-20); the specimen \"reference\" values are the script's own outputs written into the JSON (L149-154), so the two specimen measurements cannot fail (-10); the specimen is a whole rosette canopy rather than a single leaf, so its I_D is not commensurable with the single-blade model (-7); mesh teeth are one vertex deep (resolution limit) (-5)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:evidenceAgainst "2011-przemyslaw-allometric-compound-leaf.py L1076–L1080: Mesh I_D uses prominence 0.03 with a 2-sample moving average; detected teeth are single-vertex features (At 0.117, Ch 0.131, Ch MT-off 0.102) <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1076-L1080>",
            "datasets/allometric_compound_leaf/allometric_compound_leaf_reference.json L149–L154: empirical_*_ref values (0.3668, 32, 4.0939, 329.20, 157.95, 0.5202) are the script's own segmentation outputs stored as 'references' — self-referential specimen match <https://github.com/fractastical/morpholib/blob/d58a084/datasets/allometric_compound_leaf/allometric_compound_leaf_reference.json#L149-L154>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match-3> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 037 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop: emergent integrated-contour dissection, growing cellular spring-lattice lamina with Mitchison-canalized veins and microtubule-anisotropic growth, and Cardamine hirsuta specimen segmentation — Parameter expressivity: 74/100" ;
        dcterms:date "2026-10-20"^^xsd:date ;
        dcterms:description "Sweeps 6 genotypes x 4 developmental stages (`simulate_genotype_morphospace`, L524-647), a 5 x 6 eta x growth-duration grid (`sweep_eta_growth_duration`, L1186-1215; monotone in eta, ceiling 0.427) and four lamina runs including a microtubule-anisotropy ablation (`simulate_lamina_mesh_morphospace`, L1138-1177); `GrowingLaminaSpringMesh.__init__` exposes 22 physical parameters (L693-724). The CLI (L2021-2046) now actually forwards --beta/--gamma-cuc2/--k-a to `render_outputs` (in v2 they were parsed and ignored) and adds --mesh-steps, --no-mesh, --print-measurements. Deductions: `measure_morphoeval` and the self-test ignore the CLI PDE parameters (-8); none of the mesh parameters (a_vein, canal_k, canal_mu, h) is reachable from the CLI (-8); the number of lateral pairs per genotype is hard-wired (L546, L1153-1156) rather than emerging from lambda_c (-10)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:evidenceAgainst "2011-przemyslaw-allometric-compound-leaf.py L1153–L1156: Lateral pair counts (2 for At, 3 for Ch, 0 for cuc2-1) are hard-wired per genotype, not derived from the critical wavelength <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1153-L1156>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity-3> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L1186–L1215" ;
        dcterms:description "sweep_eta_growth_duration: 30 emergent contour runs over eta in {0, 0.21, 0.42, 0.62, 0.88} x growth_scale in {0.5 .. 3.0}; reports max_ID and eta-monotonicity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1186-L1215> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L1138–L1177" ;
        dcterms:description "simulate_lamina_mesh_morphospace: At WT, Ch WT, cuc2-1 and Ch WT with anisotropy_on=False (MT ablation)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L1138-L1177> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity-3> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L2021–L2046" ;
        dcterms:description "CLI: --beta/--gamma-cuc2/--k-a forwarded to render_outputs; --mesh-steps, --no-mesh, --print-measurements" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L2021-L2046> .

    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 037 Pass 3 Assessor)" ;
        dcterms:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://www.anthropic.com> .
}


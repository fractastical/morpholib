sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop: emergent integrated-contour dissection, growing cellular spring-lattice lamina with Mitchison-canalized veins and microtubule-anisotropic growth, and Cardamine hirsuta specimen segmentation — Source and data traceability: 72/100" ;
        dct:date "2026-10-20"^^xsd:date ;
        dct:description "`datasets/allometric_compound_leaf/` now carries 8 BibTeX entries whose DOIs were all resolved against Crossref during this pass (`paper_citations.bib` L1-86; the initially drafted Mitchison DOI was wrong and corrected), the README documents the Pass 3 additions and the Pass 2 circularity, and all 4 files are SHA-256 pinned and verified fail-closed at runtime (EXPECTED_SHA256 L118-123, `verify_dataset_integrity` L129-144; bib hash re-pinned). The math-KG yaml registers 5 equations with Lean and code loci. Deductions: the six `dissection_index_ID_ref` benchmark values (JSON L54-104) cite papers but no figure, table or page, and at least 0.228 / 0.785 / 0.445 / 0.312 do not appear as dissection indices in the cited works as far as this assessor can establish (-18); the specimen 'references' are self-generated (-7); the 'tooth_or_leaflet_peaks_ref' and 'auxin_cuc2_pearson_r_ref' values are likewise unsourced (-3)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-source-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/claude-fable-5-1> ;
        pk:assessmentType "morphoeval/0.1.0/source-traceability" ;
        pk:evidenceAgainst "datasets/allometric_compound_leaf/allometric_compound_leaf_reference.json L48–L104: genotype_morphospace_benchmarks: dissection_index_ID_ref values with no figure/table/page provenance <https://github.com/fractastical/morpholib/blob/d58a084/datasets/allometric_compound_leaf/allometric_compound_leaf_reference.json#L48-L104>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability-3> ;
        pk:hasScore "0.72"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability-1> a pk:EvidenceItem ;
        rdfs:label "datasets/allometric_compound_leaf/paper_citations.bib L1–L86" ;
        dct:description "8 entries: Bilsborough 2011, Barkoulas 2008, Kierzkowski 2019, Vlad 2014, Mitchison 1980 (10.1098/rspb.1980.0015), Scarpella 2006, Hamant 2008, Sampathkumar 2014 — all DOIs resolved via Crossref 2026-10-20" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/allometric_compound_leaf/paper_citations.bib#L1-L86> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability-2> a pk:EvidenceItem ;
        rdfs:label "2011-przemyslaw-allometric-compound-leaf.py L118–L144" ;
        dct:description "EXPECTED_SHA256 for 4 files (bib re-pinned to 8323f1f3...) and fail-closed verify_dataset_integrity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/2011-przemyslaw-allometric-compound-leaf.py#L118-L144> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability-3> a pk:EvidenceItem ;
        rdfs:label "datasets/allometric_compound_leaf/README.md L1–L30" ;
        dct:description "Pass 3 reference additions with DOIs and roles; explicit note that the Pass 2 benchmark agreement was by construction" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/d58a084/datasets/allometric_compound_leaf/README.md#L1-L30> .
    <https://w3id.org/probknow/resource/model/claude-fable-5-1> a pk:Model ;
        rdfs:label "Claude Fable 5.1 (MorphoEval Autonomous Loop Slot 037 Pass 3 Assessor)" ;
        dct:identifier "claude-fable-5-1" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://www.anthropic.com> .
}


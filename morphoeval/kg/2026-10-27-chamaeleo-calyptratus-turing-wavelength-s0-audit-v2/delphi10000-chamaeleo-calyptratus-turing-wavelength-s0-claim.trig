sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Holocene Chamaeleo calyptratus Turing wavelength at 260.4 µm (Pass 2) faithfully reproduces Chamaeleo calyptratus (veiled chameleon) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Chamaeleo calyptratus (veiled chameleon) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py; output: docs/media/chamaeleo_calyptratus_turing_wavelength_s0_comparison.png; organism: Chamaeleo calyptratus (veiled chameleon); environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and Murray 1981 wavenumber for a two-species reaction-diffusion system. | Schnakenberg 1979 kinetics du/dt = Du lap u + A - u + u^2 v, dv/dt = Dv lap v + B - u^2 v. | Ligon & McGraw 2013: male Chamaeleo calyptratus change lateral stripe brightness during contests. | Teyssier et al. 2015: chameleon skin has a tunable guanine-nanocrystal iridophore lattice, measured on Furcifer pardalis at a spacing of order 100 nm.; reconstructed_in_script: A = 0.062, B = 1.150, supercritical factor 1.45, Dv_y/Dv_x = 0.42, so the most-unstable wavelength is the 260.4 µm slot scale and the pattern is a vertical bar. | Flank ROI: saturation mask, then the central band of the animal bounding box. The 80 µm and 2.604 mm cutoffs are scale-separation definitions at 0 Ma, not caliper readings.; transfer_boundary: Dermal chromatophore anatomy is transferred from the panther chameleon to C. calyptratus. The 260.4 µm carrier is the slot scale.; does_not_claim: Does not claim a calibrated micrometre period read off the Wikimedia photograph. | Does not claim the guanine lattice spacing is 260.4 µm. | Does not claim a second independent assessor.]; phenomenon_size: 241 µm (0.0002408 m, log10=-3.618 m, tier=5_primordium_100um); species_scale_ladder (10 runs from 241 µm to 71.8 cm): 241 µm:chamaeleo-calyptratus-bioelectric-polarity, 875 µm:chamaeleo-calyptratus-vertex-packing, 1.6 cm:chamaeleo-calyptratus-turing-wavelength, 3.0 cm:chamaeleo-calyptratus-clock-wavefront, 5.0 cm:chamaeleo-calyptratus-morphogen-condensation, 6.3 cm:chamaeleo-calyptratus-flux-canalization, 7.2 cm:chamaeleo-calyptratus-elastic-buckling, 15.7 cm:chamaeleo-calyptratus-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/ncomms7368>,
            <https://doi.org/10.1098/rsbl.2013.0892>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-chamaeleo-calyptratus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0000-0000-0000> ;
        prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(79)90042-0>,
            <https://doi.org/10.1016/0022-5193(81)90334-9>,
            <https://doi.org/10.1038/ncomms7368>,
            <https://doi.org/10.1098/rsbl.2013.0892>,
            <https://doi.org/10.1098/rstb.1952.0012> .
    <https://doi.org/10.1016/0022-5193(79)90042-0> dct:title "Simple chemical reaction systems with limit cycle behaviour" .
    <https://doi.org/10.1016/0022-5193(81)90334-9> dct:title "A pre-pattern formation mechanism for animal coat markings" .
    <https://doi.org/10.1038/ncomms7368> dct:title "Photonic crystals cause active colour change in chameleons" .
    <https://doi.org/10.1098/rsbl.2013.0892> dct:title "Chameleons communicate with complex colour changes during contests" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:title "The chemical basis of morphogenesis" .
}


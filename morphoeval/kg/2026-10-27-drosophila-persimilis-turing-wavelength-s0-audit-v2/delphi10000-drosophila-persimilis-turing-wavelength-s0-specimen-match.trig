sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg critical wavelength for Drosophila persimilis at 2.1 µm — Morphological realism / specimen match: 78/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Stripe spacing increases from the predecessor to the successor on a shared 16.784 µm patch, and the plate is shown beside them with an honest caption. The score stays below the computer-vision number because the plate is a spiral rendering. R1 is mitigated by reporting KS = 0.505 rather than by pretending the spiral is the pattern." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.78"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-persimilis-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/drosophila_persimilis_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "chronoseries stripes beside the plate — docs/media/drosophila_persimilis_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-drosophila-persimilis-turing-wavelength-s0.py at 6c49ecbdcc1e6d2fcf72d168ee46196263be7d3b, image/png, 306753 B, 1440×960 px, artifact_sha256 dedf562e5c821cfda99a468d5b61d22be7bdf2ffbf87a1a4b3f9ad686681793a (sha256 dedf562e5c821cfda99a468d5b61d22be7bdf2ffbf87a1a4b3f9ad686681793a), spec_fingerprint 6cfd22b3b1eb8b085833af27f643b5e89f6fcf635888d87c45635473a8295900" .

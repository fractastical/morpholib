sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Drosophila willistoni subcellular Turing wavelength (1.5 µm, 0 Ma) — Code-to-model traceability: 86/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Each modelling step is a named function whose docstring states the equation it implements. The Lean module proves the integer form of the wavelength order, the granule-count order, the onset margin, and the ablation margin, with no sorry. The math-kg file points at those declarations and at the Python lines. Calibration constants remain reconstructions, which the reference JSON says in writing." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability-3> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py L1–L28" ;
        dct:description "equation block in the module docstring" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-drosophila-willistoni-turing-wavelength-s0.py#L1-L28> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability-2> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3211_drosophila_willistoni_turing_wavelength_s0.lean L25–L60" ;
        dct:description "six theorems, decide, no sorry" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3211_drosophila_willistoni_turing_wavelength_s0.lean#L25-L60> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-code-traceability-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/math_kg_loops/delphi10000-drosophila-willistoni-turing-wavelength-s0.yaml L28–L72" ;
        dct:description "law entries with Lean and code loci" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/math_kg_loops/delphi10000-drosophila-willistoni-turing-wavelength-s0.yaml#L28-L72> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7, loop 3211 primary assessor, pass 2" ;
        dct:identifier "grok-4.7" ;

<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-drosophila-willistoni-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
    rdfs:label "Drosophila willistoni subcellular Turing wavelength (1.5 µm, 0 Ma) — Morphological realism / specimen match: 84/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "The GIF's last frame is the Hanson female with the granule field painted only on the segmented abdomen (eye and wing veins held fixed), at 720×540 and 12 frames. The comparison PNG shows the photograph, the composite, the activator labyrinth, and the flat ablation on one page. Computer-vision similarity against the photograph is high because the body, wing veins, and background are the specimen, which is what the 1.5 µm claim can honestly show at photographic resolution. The score is not higher because no electron micrograph of willistoni pigment granules is in the dataset." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
    pk:assessmentType "morphoeval/0.1.0/specimen-match" ;

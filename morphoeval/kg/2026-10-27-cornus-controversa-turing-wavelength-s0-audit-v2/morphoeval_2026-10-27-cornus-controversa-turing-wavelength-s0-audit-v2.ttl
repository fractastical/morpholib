<https://w3id.org/delphi/resource/math-law/delphi10000-cornus-controversa-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Schnakenberg steady state on the Cornus lamina patch" ;
    dct:description "Homogeneous kinetics are stable before diffusion is added | Variables: fu = 0.880, gv = -1, trace = -0.120" ;
    dct:source "Schnakenberg (1979) DOI:10.1016/0022-5193(79)90042-0" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3155_cornus_controversa_turing_wavelength_s0.lean#L10-L14> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "u0 = a + b, v0 = b / u0^2, with a = 0.06 and b = 0.94" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.lfs.2005.05.094>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1469-8137.2011.03716.x>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.2307/25065525> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3155.traceJacobian" ;
    pk:leanTheorem "MathOfBiology.Loop_3155.trace_stable_without_diffusion" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cornus-controversa-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing critical wavelength" ;
    dct:description "Selects the organ-detail pigment wavelength assigned to this slot | Variables: lambda_mm = 1.939, k_c ≈ 3.240 mm^-1" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3155_cornus_controversa_turing_wavelength_s0.lean#L22-L26> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (Dv fu + Du gv) / (2 Du Dv), lambda_c = 2 pi / k_c = 1.939 mm" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.lfs.2005.05.094>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1469-8137.2011.03716.x>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.2307/25065525> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3155.wavelength_closes_on_two_pi" ;
    pk:leanTheorem "MathOfBiology.Loop_3155.wavelength_closes_on_two_pi" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cornus-controversa-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Equal-diffusion ablation" ;
    dct:description "Negative control. Pattern amplitude must decay. | Variables: Du_scaled = 378, trace_scaled = -120" ;
    dct:source "Turing (1952) DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3155_cornus_controversa_turing_wavelength_s0.lean#L34-L36> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "When Du = Dv, h = Du (fu + gv) = Du * tr J < 0, so the Turing band is closed" ;
    prov:wasDerivedFrom <https://doi.org/10.1007/BF00289234>,
        <https://doi.org/10.1016/0022-5193(79)90042-0>,
        <https://doi.org/10.1016/j.lfs.2005.05.094>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1469-8137.2011.03716.x>,
        <https://doi.org/10.1126/science.1179047>,
        <https://doi.org/10.2307/25065525> ;
    pk:hypothesisType "Turing Reaction-Diffusion Wavelength Selection" ;
    pk:leanDeclaration "MathOfBiology.Loop_3155.equal_diffusion_contrast_is_negative" ;
    pk:leanTheorem "MathOfBiology.Loop_3155.equal_diffusion_contrast_is_negative" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-cornus-controversa-turing-wavelength-s0-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holocene singleton chronoseries" ;
    dct:description "Records that this slot has no predecessor chronospecies to difference against | Variables: index = 1, length = 1, age_Ma = 0" ;

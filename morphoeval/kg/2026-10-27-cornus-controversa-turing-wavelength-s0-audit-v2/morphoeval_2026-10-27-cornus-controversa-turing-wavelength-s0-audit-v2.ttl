<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
    rdfs:label "Cornus controversa Turing wavenumber at 1.939 mm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;

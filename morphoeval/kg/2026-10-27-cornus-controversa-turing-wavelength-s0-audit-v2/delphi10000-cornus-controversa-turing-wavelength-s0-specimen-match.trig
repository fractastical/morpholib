sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Cornus controversa Turing wavenumber at 1.939 mm (Holocene, 0 Ma) — Morphological realism / specimen match: 74/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The GIF is still 12 frames at 480x640 and the last frame is the Meise crown (CV similarity 96.0). Pass 2 keeps that anchor and states, in the metrics, that the frame cannot support a millimetre reading. The generative picture remains a spot field, now with the honest nonlinear wavelength 2.216 mm rather than a template-forced stripe field presented as the organism. Horizontal-edge fraction is 0.286 on that field and 0.433 on the crown. The +2 from Pass 1 is the resolution statement and the refusal to paint the template over the selected pattern." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match-3> ;
        pk:hasScore "0.74"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "docs/media/cornus_controversa_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "crown beside the unbiased field, dispersion, sweep, ablation — docs/media/cornus_controversa_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py at 0c76d15d14afcec6c366e1b9274a6586a0de48fc, image/png, 482774 B, 1260×840 px, artifact_sha256 03cd6470ad1f2e0c96035a526cc11c007ca6c7d277e0ce3b10f118dbd7798fe8 (sha256 03cd6470ad1f2e0c96035a526cc11c007ca6c7d277e0ce3b10f118dbd7798fe8), spec_fingerprint 889436d47b7f6a20b524144198f645dcccbc348d99fd9ce666f715dfafc2a48a" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-specimen-match-2> a pk:EvidenceItem ;

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Cornus controversa Turing wavenumber at 1.939 mm (Holocene, 0 Ma) — Model fidelity to source: 90/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "The linear law is unchanged from Pass 1 and still matches equations (1)–(6): lambda_c = 1.939000 mm, trace -0.120, det 1, and eleven real modes with r = 0.9999998. Pass 2 does not retune the kinetics to hide the nonlinear shift. The template is reported as a separate forcing, not as a replacement for k_c." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-3> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py L90–L172" ;
        dct:description "Jacobian, diffusivity solve, and sigma(k)" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py#L90-L172> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py L434–L505" ;
        dct:description "unbiased 16-wavelength field plus a separate entrainment run" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-cornus-controversa-turing-wavelength-s0.py#L434-L505> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-cornus-controversa-turing-wavelength-s0-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_3155_cornus_controversa_turing_wavelength_s0.lean L10–L44" ;
        dct:description "integer witnesses for trace, determinant, wavelength, ablation, chronoseries" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3155_cornus_controversa_turing_wavelength_s0.lean#L10-L44> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single-agent round; second assessor not run)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}


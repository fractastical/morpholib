sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-thompson1917-t1917-008> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-overall> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-thompson1917-t1917-008-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Thompson (1917) differential relative growth / Huxley allometry — MorphoEval overall 76.2/100" ;
        dct:date "2026-10-28"^^xsd:date ;
        dct:description "Pass 2 remediated assessment (78.4/100). Log-log fits to Thompson Figs 18–22, parameter sweep over k, isometry ablation RMSE deltas, KS tests on log residuals, Pheidole head CV segmentation, SHA-256 dataset locks, Lean 4 theorems, and result.json verdict (supported for differential allometry; Pheidole labelled analogue). Overall 76.2/100 (faithfulness 73.3, reproducibility 82.9); rubric morphoeval 0.1.0; checkpoint commit f1d96f32ba3f00517c53e9cd007634306cc8d4f4; environment: . Dimension assessments: Model fidelity to source 82, Morphological realism / specimen match 62, Parameter expressivity 80, Morphometric validation 76, Source and data traceability 88, Code-to-model traceability 84, Reproducibility package 78. Output judged: docs/media/t1917_008_the_rate_of_growth_comparison.png: rendered output of thompson/claims/t1917-008_the-rate-of-growth.py at f1d96f32ba3f00517c53e9cd007634306cc8d4f4, image/png, 210314 B, 1960×1120 px, artifact_sha256 c0711f11b3b1842157463e9261a8c571d96600fcdda2513a6ec0ffd01d0854af (sha256 c0711f11b3b1842157463e9261a8c571d96600fcdda2513a6ec0ffd01d0854af), spec_fingerprint b37a2dcc1ba621b31fed52cf52f6c5474ec5d50ddbbdb22578110acce07480e1. Dual provenance: spec_fingerprint: b37a2dcc1ba621b31fed52cf52f6c5474ec5d50ddbbdb22578110acce07480e1; artifact_sha256: c0711f11b3b1842157463e9261a8c571d96600fcdda2513a6ec0ffd01d0854af; input_dataset_sha256: {datasets/thompson_1917/t1917-008/pheidole_caste_head_body.csv=ea73fc99f66c404b..., datasets/thompson_1917/t1917-008/t1917_008_the_rate_of_growth_reference.json=f126962ad37aed1b..., datasets/thompson_1917/t1917-008/thompson_fig18_brain_body.csv=89125925b63af4a4..., datasets/thompson_1917/t1917-008/thompson_fig19_heart_body.csv=499c9d07a4584a3d..., datasets/thompson_1917/t1917-008/thompson_fig22_plaice_length_weight.csv=748df1a60b251b7c..., morphoeval/lean/loops/Thompson1917_T1917_008.lean=4c7e5dc8c58cdc20...}. Supersedes audit: 2026-10-28-t1917-008-the-rate-of-growth-audit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:hasScore "0.762"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (loop 206 Pass 2)" ;
        dct:identifier "gemini-4-argon" ;

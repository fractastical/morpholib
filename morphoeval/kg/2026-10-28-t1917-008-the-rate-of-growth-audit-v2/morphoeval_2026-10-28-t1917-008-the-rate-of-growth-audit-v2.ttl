<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-1>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-2>,
        <https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-3> .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Huxley allometric power law" ;
    dct:description "Relates organ mass to body mass under constant relative growth rates | Variables: x body size, y organ size, k allometric exponent, b scale" ;
    dct:source "Thompson (1917) Ch. III; Huxley (1932) Problems of Relative Growth" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_008.lean>,
        <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/thompson/claims/t1917-008_the-rate-of-growth.py> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "y = b * x^k" ;
    pk:hypothesisType "quantitative-empirical relative growth / Huxley-Thompson allometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_206.huxley" ;
    pk:leanTheorem "MathOfBiology.Loop_206.huxley_brain_body_sample" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Specific growth rate ratio equals exponent k" ;
    dct:description "Links Thompson differential growth to Huxley exponent | Variables: alpha organ specific rate, beta body specific rate" ;
    dct:source "Thompson (1917) Ch. III pp. 50-155" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_008.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k = alpha / beta" ;
    pk:hypothesisType "quantitative-empirical relative growth / Huxley-Thompson allometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_206.specific_rate_ratio" ;
    pk:leanTheorem "MathOfBiology.Loop_206.growth_rate_ratio_is_exponent" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-008-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Isometry preserves organ:body ratio" ;
    dct:description "Null model for ablation when proportions do not change with size | Variables: b constant ratio, x size" ;
    dct:source "Thompson (1917) Fig. 18-22; Needham et al. (1950) Proc. R. Soc. B discussion" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/f1d96f32ba3f00517c53e9cd007634306cc8d4f4/morphoeval/lean/loops/Thompson1917_T1917_008.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k = 1 => y/x = b" ;
    pk:hypothesisType "quantitative-empirical relative growth / Huxley-Thompson allometry" ;
    pk:leanDeclaration "MathOfBiology.Loop_206.organ_body_ratio" ;
    pk:leanTheorem "MathOfBiology.Loop_206.isometry_preserves_ratio" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/concept/morphoeval-rubric-0.1.0> a skos:Concept,
        pk:Concept ;
    rdfs:label "MorphoEval simulation-faithfulness rubric v0.1.0" ;
    dct:description "Weighted 0-100 rubric for the faithfulness of a morphology simulation to its organism and source model; Overall = weighted mean. Each score is a pk:LLMClaimAssessment (Project Delphi rubric-assessment template) of the pk:Claim pkr:claim/morphoeval-<sim> against one dimension (dct:subject the dimension concept, pk:assessmentType morphoeval/<version>/<dimension>) with pk:hasScore = score/100 — an uncalibrated rubric score, not a probability — and a pk:hasVerdict band; the overall score has the rubric itself as dct:subject and is also the pk:weightOfEvidence of the claim." ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/main/morphoeval/rubric.yaml> ;
    skos:narrower <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-model-fidelity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-parameter-expressivity>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-repro-package>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-source-traceability>,
        <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-specimen-match> .


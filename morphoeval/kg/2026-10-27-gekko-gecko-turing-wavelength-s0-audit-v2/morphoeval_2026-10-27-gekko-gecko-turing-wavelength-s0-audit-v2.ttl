<https://w3id.org/delphi/resource/math-law/delphi10000-gekko-gecko-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing growth-rate maximizer" ;
    dct:description "Selects the 242 um ocellus wavelength on the Holocene Tokay primordium | Variables: u, v activator and inhibitor; D_u, D_v diffusivities; k wavenumber" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012; Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py#L119-L185>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3235_gekko_gecko_turing_wavelength_s0.lean#L12-L35> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c = argmax_k sigma(k), sigma from det(sigma I - (J - k^2 D)) = 0, lambda_c = 2 pi / k_c = 242 um" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/1741-7007-11-105> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3235.lambdaUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3235.detail_wavelength_exceeds_tier_center" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gekko-gecko-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Onset wavenumber shortcut" ;
    dct:description "Records that the operating ratio is supercritical (1350 > 1000 parts per thousand) | Variables: f_u, g_v Jacobian entries; diffusion ratio r = D_v/D_u" ;
    dct:source "Murray 1981 DOI:10.1016/0022-5193(81)90334-9" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py#L150-L195>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3235_gekko_gecko_turing_wavelength_s0.lean#L21-L54> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_onset^2 = (D_v f_u + D_u g_v) / (2 D_u D_v); equals k_c only on the Turing threshold" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/1741-7007-11-105> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3235.ratioMarginPpt" ;
    pk:leanTheorem "MathOfBiology.Loop_3235.supercritical_margin" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-gekko-gecko-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Mode-count drop versus the 100 um tier center" ;
    dct:description "States what changes at this scale versus the tier center, on a chronoseries with no other node | Variables: lambda_um = 242, tier_center_um = 100, age_ma = 0" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/models/2026-delphi10000-gekko-gecko-turing-wavelength-s0.py#L70-L84>,
        <https://github.com/fractastical/morpholib/blob/0c76d15d14afcec6c366e1b9274a6586a0de48fc/morphoeval/lean/loops/Loop_3235_gekko_gecko_turing_wavelength_s0.lean#L42-L50> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "N(lambda) proportional to 1/lambda^2; (100/242)^2 < 1/5" ;
    prov:wasDerivedFrom <https://doi.org/10.1016/0022-5193(81)90334-9>,
        <https://doi.org/10.1038/nature22031>,
        <https://doi.org/10.1038/s41467-021-22525-1>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1186/1741-7007-11-105> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3235.tierCenterUm" ;
    pk:leanTheorem "MathOfBiology.Loop_3235.mode_count_falls_versus_tier_center" ;
    pk:leanVerified true .


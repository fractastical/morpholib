}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-repro-package> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation — Reproducibility package: 90/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Deterministic RNG (`seed=2002`), 8-check `self_test()` suite (L834-893) verifying SHA-256 provenance, JSON parity, outside-spinodal decay, two-stage hierarchical pore nesting, wavelength sweep correlation, SEM segmentation parity, and bitwise two-run determinism (`np.allclose(..., atol=0.0)`), plus synchronized static PNG and animated hierarchical growth GIF outputs." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/repro-package" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-repro-package-1> ;
        pk:hasScore "0.9"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-repro-package-1> a pk:EvidenceItem ;
        rdfs:label "2002-sumper-diatom-frustule-phase-sep.py L834–L893" ;
        dct:description "8-check self_test() suite including bitwise determinism and JSON parity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L834-L893> .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


            <https://doi.org/10.1063/1.1744102>,
            <https://doi.org/10.1126/science.1070026>,
            <https://doi.org/10.1166/jnn.2006.174> .
    <https://doi.org/10.1021/la7022784> dct:date "2008"^^xsd:gYear ;
        dct:title "Self-assembly of hierarchical nanostructures in diatom biosilica" .
    <https://doi.org/10.1063/1.1744102> dct:date "1958"^^xsd:gYear ;
        dct:title "Free energy of a nonuniform system. I. Interfacial free energy" .
    <https://doi.org/10.1126/science.1070026> dct:date "2002"^^xsd:gYear ;
        dct:title "A phase separation model for the nanopatterning of diatom biosilica" .
    <https://doi.org/10.1166/jnn.2006.174> dct:date "2006"^^xsd:gYear ;
        dct:title "Pore architecture of diatom frustules: potential nanostructured membranes for molecular and particle separations" .
}


        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> a pk:Claim ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation faithfully reproduces Coscinodiscus wailesii (Centric marine diatom frustule valve pores: foramen, cribrum, cribrella) morphology" ;
        dct:description "The simulation script(s) 2002-sumper-diatom-frustule-phase-sep.py implement the cited source model as published and produce forms that match real Coscinodiscus wailesii (Centric marine diatom frustule valve pores: foramen, cribrum, cribrella) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 89.3/100, audit 2026-10-19-diatom-frustule-phase-sep-audit-v2) and the assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py; output: docs/media/diatom_frustule_phase_sep_comparison.png; organism: Coscinodiscus wailesii (Centric marine diatom frustule valve pores: foramen, cribrum, cribrella); checkpoint commit: https://github.com/fractastical/morpholib/commit/HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: 42daf8406b78c3205a6436f49e13b3d0bd7cf77c46e21bab32d26f1699bd22a7; artifact_sha256: c762c88f7077832bcaba47fc14a16f3307dd4761d93167ff546b6be3fba5cb54; input_dataset_sha256: {datasets/diatom_frustule_phase_sep/coscinodiscus_diatom_specimen.jpg=47aca39b720b67b1..., datasets/diatom_frustule_phase_sep/diatom_frustule_phase_sep_reference.json=b6ffc32e8bdecb23..., datasets/diatom_frustule_phase_sep/scout_manifest.json=0eea5a04552420e8...}; supersedes_audit_id: 2026-10-19-diatom-frustule-phase-sep-audit" ;
        pk:derivedFromPaper <https://doi.org/10.1021/la7022784>,
            <https://doi.org/10.1063/1.1744102>,
            <https://doi.org/10.1126/science.1070026>,
            <https://doi.org/10.1166/jnn.2006.174> ;
        pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-code-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-morphometric-validation>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-overall>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-repro-package>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-source-traceability>,
            <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match> ;
        pk:weightOfEvidence "0.893"^^xsd:double .
    <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py> a schema:SoftwareSourceCode ;
        rdfs:label "2002-sumper-diatom-frustule-phase-sep.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" ;
        schema:version "HEAD" .
}


sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation — Parameter expressivity: 86/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Simulates 4 distinct phase-separation regimes (off-critical droplet array, two-stage hierarchical foramen+cribrum quench, critical symmetric bicontinuous honeycomb, and outside-spinodal negative control), executes a 5-point sweep across interfacial stiffness epsilon in {0.75, 1.00, 1.25, 1.50, 1.75} (`run_epsilon_wavelength_sweep`, L394-435), and exposes `--N`, `--phi0`, `--epsilon`, `--steps`, `--seed`, and `--skip-gif` CLI flags (L896-924)." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-parameter-expressivity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/parameter-expressivity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-2> ;
        pk:hasScore "0.86"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-1> a pk:EvidenceItem ;
        rdfs:label "2002-sumper-diatom-frustule-phase-sep.py L394–L435" ;
        dcterms:description "5-point interfacial thickness sweep across epsilon in {0.75..1.75}" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L394-L435> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-parameter-expressivity-2> a pk:EvidenceItem ;
        rdfs:label "2002-sumper-diatom-frustule-phase-sep.py L896–L924" ;
        dcterms:description "Full CLI parameter overrides wired into render_all_outputs()" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L896-L924> .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-repro-package> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation — Reproducibility package: 90/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Deterministic RNG (`seed=2002`), 8-check `self_test()` suite (L834-893) verifying SHA-256 provenance, JSON parity, outside-spinodal decay, two-stage hierarchical pore nesting, wavelength sweep correlation, SEM segmentation parity, and bitwise two-run determinism (`np.allclose(..., atol=0.0)`), plus synchronized static PNG and animated hierarchical growth GIF outputs." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-repro-package> ;

sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-1> a pk:EvidenceItem ;
        rdfs:label "2002-sumper-diatom-frustule-phase-sep.py L103–L150" ;
        dcterms:description "Analytical Cahn-Hilliard spinodal dispersion sigma(k), k_c, k_0, and lambda_c" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L103-L150> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-2> a pk:EvidenceItem ;
        rdfs:label "2002-sumper-diatom-frustule-phase-sep.py L157–L283" ;
        dcterms:description "2D semi-implicit spectral Cahn-Hilliard solver and two-stage hierarchical foramen->cribrum quench" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L157-L283> .

    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-3> a pk:EvidenceItem ;
        rdfs:label "morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean L18–L97" ;
        dcterms:description "4 Lean 4 theorems proving binodal equilibria, zero-mode mass conservation, spinodal band selection, and hexagonal packing" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/morphoeval/lean/loops/Loop_071_diatom_frustule_phase_sep.lean#L18-L97> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation — Model fidelity to source: 92/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Implements the fourth-order Cahn-Hilliard PDE with exact Fourier zero-mode mass conservation (drift < 1e-15), Lenoci & Camp's (2008) Section 3.3 two-stage quenched hierarchical solidification (`simulate_two_stage_hierarchical_diatom`, L164-242), the analytical spinodal dispersion relation sigma(k) = M*k^2*(1 - 3*phi0^2 - eps^2*k^2) (`compute_spinodal_dispersion`, L76-123), and an outside-spinodal negative control (phi0=-0.65, alpha=-0.2675 < 0) verified to decay to 0 pores. Backed by 4 machine-checked Lean 4 theorems in `Loop_071_diatom_frustule_phase_sep.lean`." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-model-fidelity> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/model-fidelity" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-2>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-model-fidelity-3> ;
        pk:hasScore "0.92"^^xsd:double ;
        pk:hasVerdict "faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


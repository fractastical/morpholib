sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-overall> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-overall> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation — MorphoEval overall 89.3/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Pass 2 (v2) remediated evaluation of `2002-sumper-diatom-frustule-phase-sep.py` (consensus score 89.0/100, up from 51.6/100 in Pass 1). The remediated script implements Lenoci & Camp's (2008) two-stage quenched hierarchical Cahn-Hilliard phase separation (53 Stage-1 foramina at eps_1=1.50 containing 102 nested Stage-2 cribrum sub-pores at eps_2=0.65), analytical spinodal dispersion sigma(k) with an outside-spinodal negative control (phi0=-0.65 -> 0 pores, std_phi=1.93e-3), a 5-point interfacial wavelength sweep (r=0.9865, RMSE=0.95 px), and automated CV segmentation of n=139 primary foramina (d/a=0.690 vs ref 0.6757, |psi_6|=0.764) and n=74 secondary cribrum sub-pores on the SHA-256-locked *Coscinodiscus wailesii* SEM micrograph, backed by 4 machine-checked Lean 4 theorems. Overall 89.3/100 (faithfulness 88.5, reproducibility 91.3); rubric morphoeval 0.1.0; checkpoint commit HEAD; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1. Dimension assessments: Model fidelity to source 92, Morphological realism / specimen match 87, Parameter expressivity 86, Morphometric validation 88, Source and data traceability 93, Code-to-model traceability 91, Reproducibility package 90. Output judged: docs/media/diatom_frustule_phase_sep_comparison.png: rendered output of 2002-sumper-diatom-frustule-phase-sep.py at HEAD, image/png, 876795 B, 2775×1380 px, artifact_sha256 c762c88f7077832bcaba47fc14a16f3307dd4761d93167ff546b6be3fba5cb54 (sha256 c762c88f7077832bcaba47fc14a16f3307dd4761d93167ff546b6be3fba5cb54), spec_fingerprint 42daf8406b78c3205a6436f49e13b3d0bd7cf77c46e21bab32d26f1699bd22a7. Dual provenance: spec_fingerprint: 42daf8406b78c3205a6436f49e13b3d0bd7cf77c46e21bab32d26f1699bd22a7; artifact_sha256: c762c88f7077832bcaba47fc14a16f3307dd4761d93167ff546b6be3fba5cb54; input_dataset_sha256: {datasets/diatom_frustule_phase_sep/coscinodiscus_diatom_specimen.jpg=47aca39b720b67b1..., datasets/diatom_frustule_phase_sep/diatom_frustule_phase_sep_reference.json=b6ffc32e8bdecb23..., datasets/diatom_frustule_phase_sep/scout_manifest.json=0eea5a04552420e8...}. Supersedes audit: 2026-10-19-diatom-frustule-phase-sep-audit." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-rubric-0.1.0> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/overall" ;
        pk:evidenceAgainst "remediation needed: Couple the 2D Cahn-Hilliard equation to a radially advancing centrifuge-driven silica precipitation front to model radial rib (costae) striation near the Coscinodiscus valve margin.",
            "remediation needed: Extend the two-stage hierarchical quench to an explicit 3-stage 512x512 grid simulation resolving tertiary cribrella pores simultaneously within a single domain." ;
        pk:hasScore "0.893"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


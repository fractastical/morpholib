    <https://doi.org/10.1021/la7022784> dct:date "2008"^^xsd:gYear ;
        dct:title "Self-assembly of hierarchical nanostructures in diatom biosilica" .
    <https://doi.org/10.1063/1.1744102> dct:date "1958"^^xsd:gYear ;

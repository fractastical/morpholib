sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-sumper-diatom-frustule-phase-sep> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match> a pk:LLMClaimAssessment ;
        rdfs:label "Sumper (2002) & Lenoci-Camp (2008) hierarchical Cahn-Hilliard diatom biosilica phase separation — Morphological realism / specimen match: 87/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Vendors, SHA-256-verifies, and segments the *Coscinodiscus wailesii* valve SEM micrograph (`datasets/diatom_frustule_phase_sep/coscinodiscus_diatom_specimen.jpg`), extracting n=139 primary foramen pores (mean diameter 24.01 px, CV=0.133; nearest-neighbor pitch 34.80 px, CV=0.075; diameter-to-pitch ratio d_1/a_1 = 0.690 matching Sumper 2002 reference 0.6757 within 2.1%; 6-fold hexatic order |psi_6| = 0.764) and n=74 nested cribrum sub-pores (`segment_coscinodiscus_specimen`, L442-526)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/specimen-match" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match-1>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match-2> ;
        pk:hasScore "0.87"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match-1> a pk:EvidenceItem ;
        rdfs:label "2002-sumper-diatom-frustule-phase-sep.py L442–L526" ;
        dct:description "Automated segmentation of 139 primary foramina and 74 secondary cribrum sub-pores on Coscinodiscus wailesii SEM" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/HEAD/2002-sumper-diatom-frustule-phase-sep.py#L442-L526> .
    <https://w3id.org/probknow/resource/evidence/morphoeval-sumper-diatom-frustule-phase-sep-specimen-match-2> a pk:EvidenceItem ;
        rdfs:label "docs/media/diatom_frustule_phase_sep_comparison.png (generated output)" ;
        dct:description "8-panel synthesis figure comparing Stage 1/Stage 2 simulations, bicontinuous mesh, negative control, and Coscinodiscus SEM segmentations — docs/media/diatom_frustule_phase_sep_comparison.png: rendered output of 2002-sumper-diatom-frustule-phase-sep.py at HEAD, image/png, 876795 B, 2775×1380 px, artifact_sha256 c762c88f7077832bcaba47fc14a16f3307dd4761d93167ff546b6be3fba5cb54 (sha256 c762c88f7077832bcaba47fc14a16f3307dd4761d93167ff546b6be3fba5cb54), spec_fingerprint 42daf8406b78c3205a6436f49e13b3d0bd7cf77c46e21bab32d26f1699bd22a7" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (Pass 2 remediated assessment)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


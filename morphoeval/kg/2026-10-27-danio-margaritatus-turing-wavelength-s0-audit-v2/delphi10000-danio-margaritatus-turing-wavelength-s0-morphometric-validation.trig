sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 13.39 µm in Danio margaritatus (Holocene, 0 Ma) — Morphometric validation: 81/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Specimen NN median is 510.1 µm against the elementary reference 13.39 µm (they are not equal). Bootstrap 95% CI is 471–536 µm and a ±10% body-length sweep is stored. Polygon circularity is 0.708, not 1. KS D on median-scaled NN distances is 0.207. Dispersion RMSE is 5.53e-4 /s. The PCA-chord CDF Pearson is 0.977 and the odd-bin holdout is 0.770; the holdout is not rounded up to the dispersion correlation." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-adult-pearl-nearest-neighbour-spacing>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-critical-wavelength-lambda-c>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-1d-pde>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-dispersion-rmse>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-ks-statistic-of-median-scaled-nn-distances>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-pearl-field-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-reaction-knockout-ablation-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-specimen-cdf-pearson-versus-ellipse-marginal>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-morphometric-validation-2>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-morphometric-validation-3> ;
        pk:hasScore "0.81"^^xsd:double ;
        pk:hasVerdict "faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-adult-pearl-nearest-neighbour-spacing> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "adult pearl nearest-neighbour spacing = 510.1005699664499 µm" ;
        dct:description "CV = 0.399; bootstrap 95% CI in metrics JSON; elementary cells per gap = 38.10" ;
        schema:measurementTechnique "median centroid spacing of segmented orange pearls, scaled by 0.018 m / hull major axis" ;
        schema:name "adult pearl nearest-neighbour spacing" ;
        schema:unitText "µm" ;
        schema:value "510.1005699664499" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-adult-pearl-nearest-neighbour-spacing-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-adult-pearl-nearest-neighbour-spacing-reference> a schema:PropertyValue ;
        dct:source "photograph plus catalog body length 0.018 m; reference is the unresolved elementary wavelength" ;
        schema:value "13.39" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-critical-wavelength-lambda-c> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "critical wavelength lambda_c = 13.39 µm" ;
        dct:description "predecessor albolineatus has no real k_c at delta=1.35" ;
        schema:measurementTechnique "k_c^2 = gamma (D_v f_u + D_u g_v) / (2 D_u D_v); D_u solved so lambda_c = 13.39 µm" ;
        schema:name "critical wavelength lambda_c" ;
        schema:unitText "µm" ;
        schema:value "13.39" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-critical-wavelength-lambda-c-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-critical-wavelength-lambda-c-reference> a schema:PropertyValue ;
        dct:source "slot scale 1.339e-05 m; reference is the nigrofasciatus successor wavelength, not a copy of the value" ;
        schema:value "17.8" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-1d-pde> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion Pearson r analytic vs 1D PDE = 0.9999999531548494 Pearson r" ;
        dct:description "RMSE = 0.00055 1/s" ;
        schema:measurementTechnique "cosine-mode growth on a periodic line versus the closed-form eigenvalue" ;
        schema:name "dispersion Pearson r analytic vs 1D PDE" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9999999531548494" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-1d-pde-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-dispersion-pearson-r-analytic-vs-1d-pde-reference> a schema:PropertyValue ;
        dct:source "Turing 1952 dispersion relation" ;
        schema:value "0.95" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-dispersion-rmse> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "dispersion RMSE = 0.0005526070525730378 1/s" ;
        dct:description "not zero: the explicit Euler step and the weak nonlinearity at eps=1e-4 leave a residual" ;
        schema:measurementTechnique "RMSE between analytic sigma(k) and the linearized 1D PDE growth rate" ;
        schema:name "dispersion RMSE" ;
        schema:unitText "1/s" ;
        schema:value "0.0005526070525730378" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-dispersion-rmse-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-dispersion-rmse-reference> a schema:PropertyValue ;
        dct:source "same 18-wavenumber series as the Pearson comparison" ;
        schema:value "0.05" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-ks-statistic-of-median-scaled-nn-distances> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "KS statistic of median-scaled NN distances = 0.20730593607305936 KS D" ;
        dct:description "p = 0.0984" ;
        schema:measurementTechnique "two-sample KS between specimen NN/median(NN) and Schnakenberg spot NN/median(NN)" ;
        schema:name "KS statistic of median-scaled NN distances" ;
        schema:unitText "KS D" ;
        schema:value "0.20730593607305936" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-ks-statistic-of-median-scaled-nn-distances-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-ks-statistic-of-median-scaled-nn-distances-reference> a schema:PropertyValue ;
        dct:source "scale-free shape comparison; D = 0 would mean identical distributions" ;
        schema:value "0.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-pearl-field-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pearl-field circularity = 0.7079191663342005 4*pi*A/P^2" ;
        dct:description "aspect = 1.776; foreground fraction = 0.341" ;
        schema:measurementTechnique "convex hull of inlier pearl centroids on the CC BY-SA photograph" ;
        schema:name "pearl-field circularity" ;
        schema:unitText "4*pi*A/P^2" ;
        schema:value "0.7079191663342005" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-pearl-field-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-pearl-field-circularity-reference> a schema:PropertyValue ;
        dct:source "a circle would score 1; the flank hull is elongated" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-reaction-knockout-ablation-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "reaction-knockout ablation amplitude ratio = 1.0243603329022087e-11 std(u_ablated)/std(u)" ;
        dct:description "equal-diffusion std = 0.0003; pattern std = 1.1409" ;
        schema:measurementTechnique "same seed and diffusion, u^2 v exchange removed" ;
        schema:name "reaction-knockout ablation amplitude ratio" ;
        schema:unitText "std(u_ablated)/std(u)" ;
        schema:value "1.0243603329022087e-11" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-reaction-knockout-ablation-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-reaction-knockout-ablation-amplitude-ratio-reference> a schema:PropertyValue ;
        dct:source "negative control; a ratio near 1 would mean the quadratic term is unnecessary" ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-specimen-cdf-pearson-versus-ellipse-marginal> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen CDF Pearson versus ellipse marginal = 0.9770954977375305 Pearson r" ;
        dct:description "odd-bin Pearson = 0.770; CDF RMSE = 0.1198" ;
        schema:measurementTechnique "cumulative distribution of pearls along the flank principal axis versus local chord length" ;
        schema:name "specimen CDF Pearson versus ellipse marginal" ;
        schema:unitText "Pearson r" ;
        schema:value "0.9770954977375305" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-specimen-cdf-pearson-versus-ellipse-marginal-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-measurement-specimen-cdf-pearson-versus-ellipse-marginal-reference> a schema:PropertyValue ;
        dct:source "homogeneous Turing spot gas; odd-bin Pearson is the stricter holdout and is not claimed above 0.98" ;
        schema:value "0.9" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py L406–L463" ;
        dct:description "PCA-chord holdout, bootstrap CI, body-length sensitivity" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/23fb4b106f961ebb8b80abe7209257c902f834ad/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py#L406-L463> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py L688–L782" ;
        dct:description "Eight measurements, each value distinct from its reference" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/23fb4b106f961ebb8b80abe7209257c902f834ad/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py#L688-L782> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0-morphometric-validation-3> a pk:EvidenceItem ;
        rdfs:label "docs/media/danio_margaritatus_turing_wavelength_s0_comparison.png (generated output)" ;
        dct:description "CI and nonlinear peak are on the figure — docs/media/danio_margaritatus_turing_wavelength_s0_comparison.png: rendered output of models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py at 23fb4b106f961ebb8b80abe7209257c902f834ad, image/png, 630986 B, 1512×984 px, artifact_sha256 8eac595b6d5b6eb28291aff92e3ce8801578927e4be889341429924640adbc4e (sha256 8eac595b6d5b6eb28291aff92e3ce8801578927e4be889341429924640adbc4e), spec_fingerprint b77145afbb1daaa36679993eab12015d9069adc4fe8d9a9b382f23a8172ce984" .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;

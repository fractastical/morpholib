sub:Head {
    sub: a np:Nanopublication ;
        np:hasAssertion sub:assertion ;
        np:hasProvenance sub:provenance ;
        np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0> a pk:Claim ;
        rdfs:label "Schnakenberg Turing wavelength at 13.39 µm in Danio margaritatus (Holocene, 0 Ma) faithfully reproduces Danio margaritatus (Celestial Pearl Danio) morphology" ;
        dct:description "The simulation script(s) models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Danio margaritatus (Celestial Pearl Danio) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
        dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py> ;
        pk:context "script(s): https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py; output: docs/media/danio_margaritatus_turing_wavelength_s0_comparison.png; organism: Danio margaritatus (Celestial Pearl Danio); environment: n/a; claim_boundary: [reported_in_source: Turing 1952 dispersion relation and finite-k instability. | Nakamasu et al. 2009 pigment-cell short-range activation and long-range inhibition. | Quigley 2004, Patterson 2014, Spiewak 2018: Danio species differ in stripe and spot deployment. | Huang et al. 2021: Danio albolineatus adult coloration is not a zebrafish stripe pattern. | Conway, Chen & Mayden 2008 place the celestial pearl danio in Danio.; reconstructed_in_script: Schnakenberg (a, b, delta) for three chronospecies at this rung. | Catalog length 0.018 m on the pearl-field principal axis. | Low-pass photographic background behind the simulated hull.; transfer_boundary: 13.39 µm is sub-resolution on the adult plate (~21 µm/px). | Albolineatus and nigrofasciatus parameters are not fits to their own photographs in this slot. | gamma = 1/s sets the time unit.; does_not_claim: Adult pearl spacing is 13.39 µm. The measured median is 510.1 µm. | Odd-bin spatial Pearson exceeds 0.98. It is 0.770. | The GIF polygon is the anatomical outline. | A second assessor from another provider scored this audit.]; phenomenon_size: 20 µm (2.018e-05 m, log10=-4.695 m, tier=4_cellular_10um); species_scale_ladder (10 runs from 20 µm to 4.5 cm): 20 µm:danio-aesculapii-bioelectric-polarity, 63 µm:danio-aesculapii-vertex-packing, 1.0 mm:danio-aesculapii-turing-wavelength, 2.0 mm:danio-aesculapii-clock-wavefront, 4.5 mm:danio-aesculapii-morphogen-condensation, 5.5 mm:danio-aesculapii-elastic-buckling, 6.3 mm:danio-aesculapii-flux-canalization, 8.8 mm:danio-aesculapii-branching-tree" ;
        pk:derivedFromPaper <https://doi.org/10.1038/ncomms6299>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1073/pnas.0808622106>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.11646/zootaxa.1686.1.1>,
            <https://doi.org/10.1242/dev.01526>,
            <https://doi.org/10.1371/journal.pgen.1007538>,
            <https://doi.org/10.7554/eLife.70253> .
    <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py> a schema:SoftwareSourceCode ;
        rdfs:label "models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py" ;
        schema:codeRepository <https://github.com/fractastical/morpholib> ;
        schema:programmingLanguage "Python" .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192> ;
        prov:wasDerivedFrom <https://doi.org/10.1038/ncomms6299>,
            <https://doi.org/10.1038/s41467-018-05629-z>,
            <https://doi.org/10.1073/pnas.0808622106>,

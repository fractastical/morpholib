<https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-danio-margaritatus-turing-wavelength-s0> a pk:Claim ;
    rdfs:label "Schnakenberg Turing wavelength at 13.39 µm in Danio margaritatus (Holocene, 0 Ma) (Danio margaritatus (Celestial Pearl Danio))",
        "Schnakenberg Turing wavelength at 13.39 µm in Danio margaritatus (Holocene, 0 Ma) faithfully reproduces Danio margaritatus (Celestial Pearl Danio) morphology" ;
    dct:conformsTo <https://w3id.org/delphi/resource/math-law/delphi10000-danio-margaritatus-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-margaritatus-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-margaritatus-turing-wavelength-s0-3>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-danio-margaritatus-turing-wavelength-s0-4> ;
    dct:description "The simulation script(s) models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py implement the cited source model as published and produce forms that match real Danio margaritatus (Celestial Pearl Danio) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is carried by the MorphoEval rubric assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/main/models/2026-delphi10000-danio-margaritatus-turing-wavelength-s0.py> ;
    schema:about "Danio margaritatus (Celestial Pearl Danio)" ;
    schema:additionalProperty "does_not_claim: A second assessor from another provider scored this audit.",
        "does_not_claim: Adult pearl spacing is 13.39 µm. The measured median is 510.1 µm.",
        "does_not_claim: Odd-bin spatial Pearson exceeds 0.98. It is 0.770.",
        "does_not_claim: The GIF polygon is the anatomical outline.",
        "reconstructed_in_script: Catalog length 0.018 m on the pearl-field principal axis.",
        "reconstructed_in_script: Low-pass photographic background behind the simulated hull.",
        "reconstructed_in_script: Schnakenberg (a, b, delta) for three chronospecies at this rung.",
        "reported_in_source: Conway, Chen & Mayden 2008 place the celestial pearl danio in Danio.",
        "reported_in_source: Huang et al. 2021: Danio albolineatus adult coloration is not a zebrafish stripe pattern.",
        "reported_in_source: Nakamasu et al. 2009 pigment-cell short-range activation and long-range inhibition.",
        "reported_in_source: Quigley 2004, Patterson 2014, Spiewak 2018: Danio species differ in stripe and spot deployment.",
        "reported_in_source: Turing 1952 dispersion relation and finite-k instability.",
        "transfer_boundary: 13.39 µm is sub-resolution on the adult plate (~21 µm/px).",
        "transfer_boundary: Albolineatus and nigrofasciatus parameters are not fits to their own photographs in this slot.",
        "transfer_boundary: gamma = 1/s sets the time unit." ;
    pk:anatomicalStructure "Turing pigment stripe / ocellus wavelength in Danio margaritatus (Holocene (Extant))" ;
    pk:aristotelianEfficientCause "1. Chemical Turing / RD" ;
    pk:aristotelianMegistonGenos "I. Enaima (Vertebrata)" ;
    pk:aristotelianPoionForm "Stripes, Spots & Ocelli" ;
    pk:aristotelianPosonLaw "Turing Wavenumber k_c" ;

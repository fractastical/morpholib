sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Holaspis22 cuticle Turing wavelength at 15 µm (Wenlock, 428.1 Ma) — Morphometric validation: 76/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Pearson r and RMSE are computed on the dispersion relation, the numerical wavelength is reported against 15.14 µm rather than copied onto it, the equal-diffusion control decays, and the photograph's rib count (23.89) is not set equal to the literature value 22. A KS test on orientation histograms is not yet in the metrics (R3)." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-equal-diffusivity-negative-control-amplitude-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-numerical-cuticle-patch-dominant-wavelength>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-pearson-r-of-numerical-vs-analytical-discrete-dispersion-growth-rates>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-specimen-image-postcephalic-pleural-ring-count>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-t22-t18-holaspid-entry-sagittal-size-ratio-from-meraspid-dyar-steps>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-wavelengths-per-tergite-t22-relative-to-t18-at-the-15-m-selector>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-morphometric-validation-1>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-morphometric-validation-2> ;
        pk:hasScore "0.76"^^xsd:double ;
        pk:hasVerdict "mostly faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-equal-diffusivity-negative-control-amplitude-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal-diffusivity negative-control amplitude ratio = 0.03609 std_final / std_initial" ;
        dct:description "initial std 0.0488, final std 0.0018" ;
        schema:measurementTechnique "Schnakenberg with D_v set equal to D_u; pattern noise must decay" ;
        schema:name "equal-diffusivity negative-control amplitude ratio" ;
        schema:unitText "std_final / std_initial" ;
        schema:value "0.03609" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-equal-diffusivity-negative-control-amplitude-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-equal-diffusivity-negative-control-amplitude-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-numerical-cuticle-patch-dominant-wavelength> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "numerical cuticle-patch dominant wavelength = 17.3029 µm" ;
        dct:description "analytical lambda_c = 15.1400 µm at age 428.1 Ma" ;
        schema:measurementTechnique "radial FFT peak of the saturated Schnakenberg field, times dx pinned so analytical lambda_c = 15.14 µm" ;
        schema:name "numerical cuticle-patch dominant wavelength" ;
        schema:unitText "µm" ;
        schema:value "17.3029" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-numerical-cuticle-patch-dominant-wavelength-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-numerical-cuticle-patch-dominant-wavelength-reference> a schema:PropertyValue ;
        schema:value "15.14" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-pearson-r-of-numerical-vs-analytical-discrete-dispersion-growth-rates> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "Pearson r of numerical vs analytical discrete dispersion growth rates = 0.999627 correlation" ;
        dct:description "RMSE = 0.03185 on 6 modes" ;
        schema:measurementTechnique "polyfit of log amplitude on exact Fourier eigenmodes versus sigma(k) of J - k^2 D" ;
        schema:name "Pearson r of numerical vs analytical discrete dispersion growth rates" ;
        schema:unitText "correlation" ;
        schema:value "0.999627" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-pearson-r-of-numerical-vs-analytical-discrete-dispersion-growth-rates-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-pearson-r-of-numerical-vs-analytical-discrete-dispersion-growth-rates-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-specimen-image-postcephalic-pleural-ring-count> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen image postcephalic pleural ring count = 23.8889 rings" ;
        dct:description "period 18 px over 430 px; peak count 26" ;
        schema:measurementTechnique "autocorrelation lag of the dorsal gray profile on y=240..670, x=200..420 of the pinned photograph" ;
        schema:name "specimen image postcephalic pleural ring count" ;
        schema:unitText "rings" ;
        schema:value "23.8889" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-specimen-image-postcephalic-pleural-ring-count-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-specimen-image-postcephalic-pleural-ring-count-reference> a schema:PropertyValue ;
        schema:value "22" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-t22-t18-holaspid-entry-sagittal-size-ratio-from-meraspid-dyar-steps> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "t22/t18 holaspid-entry sagittal size ratio from meraspid Dyar steps = 1.545608 L_t22 / L_t18" ;
        dct:description "reference column is the segment-count ratio 22/18, which the Dyar product exceeds" ;
        schema:measurementTechnique "1.115^(22-18), meraspid per-stage ratio from Hughes et al. 2017" ;
        schema:name "t22/t18 holaspid-entry sagittal size ratio from meraspid Dyar steps" ;
        schema:unitText "L_t22 / L_t18" ;
        schema:value "1.545608" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-t22-t18-holaspid-entry-sagittal-size-ratio-from-meraspid-dyar-steps-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-t22-t18-holaspid-entry-sagittal-size-ratio-from-meraspid-dyar-steps-reference> a schema:PropertyValue ;
        schema:value "1.222222" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-wavelengths-per-tergite-t22-relative-to-t18-at-the-15-m-selector> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wavelengths per tergite, t22 relative to t18, at the 15 µm selector = 1.264589 ratio" ;
        dct:description "holaspid increment is 0.8957 of the meraspid increment (1.103 vs 1.115)" ;
        schema:measurementTechnique "(L_t22/22) / (L_t18/18) with L ratio = 1.115^4 and lambda_c held at 15.14 µm" ;
        schema:name "wavelengths per tergite, t22 relative to t18, at the 15 µm selector" ;
        schema:unitText "ratio" ;
        schema:value "1.264589" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-wavelengths-per-tergite-t22-relative-to-t18-at-the-15-m-selector-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-measurement-wavelengths-per-tergite-t22-relative-to-t18-at-the-15-m-selector-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-morphometric-validation-1> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0.py L502–L570" ;
        dct:description "measure_morphoeval rows" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b3e13105b55d8ac28c3f835f3a5a27bb4faff45/models/2026-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0.py#L502-L570> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-morphometric-validation-2> a pk:EvidenceItem ;
        rdfs:label "models/2026-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0.py L256–L280" ;
        dct:description "postcephalic autocorrelation ring count" ;
        prov:wasDerivedFrom <https://github.com/fractastical/morpholib/blob/8b3e13105b55d8ac28c3f835f3a5a27bb4faff45/models/2026-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0.py#L256-L280> .
    <https://w3id.org/delphi/resource/model/grok-4.7> a pk:Model ;
        rdfs:label "Grok 4.7 (builder-assessor, single agent)" ;
        dct:identifier "grok-4.7" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> .
}

sub:provenance {
    sub:assertion prov:wasAttributedTo <https://orcid.org/0009-0007-4948-9192>,
            <https://w3id.org/delphi/resource/model/grok-4.7> ;
        prov:wasDerivedFrom <https://doi.org/10.1017/pab.2016.5>,
            <https://doi.org/10.1086/381042>,
            <https://doi.org/10.1098/rstb.1952.0012>,
            <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
            <https://doi.org/10.1666/06017.1>,
            <https://doi.org/10.3389/fevo.2017.00037> .
    <https://doi.org/10.1017/pab.2016.5> dct:date "2016"^^xsd:gYear ;
        dct:title "Axial growth gradients across the postprotaspid ontogeny of the Silurian trilobite Aulacopleura koninckii" .
    <https://doi.org/10.1086/381042> dct:date "2004"^^xsd:gYear ;
        dct:title "Exploring Developmental Modes in a Fossil Arthropod: Growth and Trunk Segmentation of the Trilobite Aulacopleura koninckii" .
    <https://doi.org/10.1098/rstb.1952.0012> dct:date "1952"^^xsd:gYear ;
        dct:title "The chemical basis of morphogenesis" .
    <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x> dct:date "1995"^^xsd:gYear ;
        dct:title "Growth and variation in the Silurian proetide trilobite Aulacopleura koninckii and its implications for trilobite palaeobiology" .
    <https://doi.org/10.1666/06017.1> dct:date "2006"^^xsd:gYear ;
        dct:title "The ontogeny of trilobite segmentation: a comparative approach" .
    <https://doi.org/10.3389/fevo.2017.00037> dct:date "2017"^^xsd:gYear ;
        dct:title "The Development of the Silurian Trilobite Aulacopleura koninckii Reconstructed by Applying Inferred Growth and Segmentation Dynamics" .
}


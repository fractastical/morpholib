<https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-code-traceability> a pk:LLMClaimAssessment ;
    rdfs:label "Holaspis22 cuticle Turing wavelength at 15 µm (Wenlock, 428.1 Ma) — Code-to-model traceability: 80/100" ;
    dct:date "2026-10-27"^^xsd:date ;
    dct:description "Module docstring states the PDEs, k_c, the 15 µm scale, the 428.1 Ma age, and the Dyar delta. Lean theorems encode the integer form of the t22-versus-t18 inequalities. Section-level pins into Turing 1952 are still coarse." ;
    dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-code-traceability> ;
    pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;

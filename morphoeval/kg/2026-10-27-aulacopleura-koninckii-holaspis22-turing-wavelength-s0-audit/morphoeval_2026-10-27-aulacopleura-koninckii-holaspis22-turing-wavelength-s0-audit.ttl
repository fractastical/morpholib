<https://w3id.org/delphi/resource/concept/math-of-biology> a skos:Concept,
        pk:Concept ;
    rdfs:label "Validated Mathematics of Biological Form" ;
    skos:narrower <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-1>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-2>,
        <https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-3> .

<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Turing dispersion determinant" ;
    dct:description "Local stability of a Fourier mode at the 15 µm cuticle scale of holaspis22 | Variables: f_u, f_v, g_u, g_v: Schnakenberg Jacobian at (u0, v0); D_u, D_v diffusivities" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8b3e13105b55d8ac28c3f835f3a5a27bb4faff45/morphoeval/lean/loops/Loop_3128_aulacopleura_koninckii_holaspis22_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "det(J - k^2 D) = (f_u - D_u k^2)(g_v - D_v k^2) - f_v g_u" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/pab.2016.5>,
        <https://doi.org/10.1086/381042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
        <https://doi.org/10.1666/06017.1>,
        <https://doi.org/10.3389/fevo.2017.00037> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3128.t22_entry_four_molts_after_t18" ;
    pk:leanTheorem "MathOfBiology.Loop_3128.t22_entry_four_molts_after_t18" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Critical wavenumber and wavelength" ;
    dct:description "Selects the pigment/ocellus spacing tiled across each t22 tergite | Variables: lambda_c fixed at 15.14 µm for this detail variant; r = D_v/D_u = 20 at the nominal point" ;
    dct:source "Turing 1952 DOI:10.1098/rstb.1952.0012" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8b3e13105b55d8ac28c3f835f3a5a27bb4faff45/morphoeval/lean/loops/Loop_3128_aulacopleura_koninckii_holaspis22_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "k_c^2 = (D_v f_u + D_u g_v) / (2 D_u D_v),  lambda_c = 2 pi / k_c = 1.514e-5 m" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/pab.2016.5>,
        <https://doi.org/10.1086/381042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
        <https://doi.org/10.1666/06017.1>,
        <https://doi.org/10.3389/fevo.2017.00037> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3128.dyar_enlargement_exceeds_segment_ratio" ;
    pk:leanTheorem "MathOfBiology.Loop_3128.dyar_enlargement_exceeds_segment_ratio" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/delphi10000-aulacopleura-koninckii-holaspis22-turing-wavelength-s0-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Holaspid-entry size ratio versus the 18-segment predecessor" ;
    dct:description "What changes at 15 µm between holaspis22 (428.1 Ma) and holaspis18 (428.3 Ma): tile count, not the local selector | Variables: 1.115 meraspid Dyar ratio (Hughes et al. 2017); segment counts 22 and 18" ;
    dct:source "Hughes, Hong, Hou & Fusco 2017 DOI:10.3389/fevo.2017.00037; Fusco et al. 2004 DOI:10.1086/381042" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/8b3e13105b55d8ac28c3f835f3a5a27bb4faff45/morphoeval/lean/loops/Loop_3128_aulacopleura_koninckii_holaspis22_turing_wavelength_s0.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "L_t22 / L_t18 = 1.115^(22-18); per-tergite tile ratio = (L_t22/22) / (L_t18/18)" ;
    prov:wasDerivedFrom <https://doi.org/10.1017/pab.2016.5>,
        <https://doi.org/10.1086/381042>,
        <https://doi.org/10.1098/rstb.1952.0012>,
        <https://doi.org/10.1111/j.1502-3931.1995.tb01824.x>,
        <https://doi.org/10.1666/06017.1>,
        <https://doi.org/10.3389/fevo.2017.00037> ;
    pk:hypothesisType "Reaction-Diffusion & Turing Dispersion" ;
    pk:leanDeclaration "MathOfBiology.Loop_3128.per_tergite_wavelength_count_increases" ;
    pk:leanTheorem "MathOfBiology.Loop_3128.per_tergite_wavelength_count_increases" ;
    pk:leanVerified true .


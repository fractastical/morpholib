<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-022-1> a skos:Concept,
        pk:Concept ;
    rdfs:label "Isoperimetric rectangle (fixed perimeter)" ;
    dct:description "2-D isoperimetric lemma for tissue grain outlines (Fig. 180 pollen) | Variables: a,b: side lengths; s: semi-perimeter" ;
    dct:source "Thompson (1917) Ch. VIII Fig. 180; classical isoperimetric inequality" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a8bae15d56cf26f6d31eb8cd1b41b5301fdde110/morphoeval/lean/loops/Thompson1917_T1917_022.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "a + b = 2s => a*b <= s^2" ;
    pk:hypothesisType "geometric — isoperimetric / minimal-area hollow and aggregate partitions (Thompson 1917 Ch. VIII claim T1917-022)" ;
    pk:leanTheorem "MathOfBiology.Loop_217.isoperimetric_rectangle" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-022-2> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hollow sphere A/V halves when radius doubles" ;
    dct:description "Hollow radiolarian-like shells (analogue specimens) | Variables: A ~ r^2, V ~ r^3 scaling exponents" ;
    dct:source "Thompson (1917) pp. 264-265 radiolarian hollow shells" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a8bae15d56cf26f6d31eb8cd1b41b5301fdde110/morphoeval/lean/loops/Thompson1917_T1917_022.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "A(2r)*V(r) = V(2r)*A(r)" ;
    pk:hypothesisType "geometric — isoperimetric / minimal-area hollow and aggregate partitions (Thompson 1917 Ch. VIII claim T1917-022)" ;
    pk:leanTheorem "MathOfBiology.Loop_217.av_ratio_halves_when_radius_doubles" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-022-3> a skos:Concept,
        pk:Concept ;
    rdfs:label "Plateau triple junction" ;
    dct:description "Tissue partitions Figs. 178-190 | Variables: junction angle between three partitions (degrees)" ;
    dct:source "Plateau (1873); Thompson (1917) Ch. VII-VIII tissue partitions" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a8bae15d56cf26f6d31eb8cd1b41b5301fdde110/morphoeval/lean/loops/Thompson1917_T1917_022.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "120 + 120 + 120 = 360" ;
    pk:hypothesisType "geometric — isoperimetric / minimal-area hollow and aggregate partitions (Thompson 1917 Ch. VIII claim T1917-022)" ;
    pk:leanTheorem "MathOfBiology.Loop_217.three_plateau_angles_full_turn" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-022-4> a skos:Concept,
        pk:Concept ;
    rdfs:label "Fig. 176 eight-sector partition" ;
    dct:description "Larval echinoderm skeletal rod template vs Fig. 177 pluteus | Variables: sector count N=8, sector angle 360/N" ;
    dct:source "Thompson (1917) Ch. VIII pp. 392-393 Figs. 176-177" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a8bae15d56cf26f6d31eb8cd1b41b5301fdde110/morphoeval/lean/loops/Thompson1917_T1917_022.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "4 quadrants x 2 bisections = 8 sectors of 45 deg" ;
    pk:hypothesisType "geometric — isoperimetric / minimal-area hollow and aggregate partitions (Thompson 1917 Ch. VIII claim T1917-022)" ;
    pk:leanTheorem "MathOfBiology.Loop_217.fig176_sector_is_45" ;
    pk:leanVerified true .

<https://w3id.org/delphi/resource/math-law/thompson1917-t1917-022-5> a skos:Concept,
        pk:Concept ;
    rdfs:label "Hexagon beats triangle isoperimetric scale" ;
    dct:description "Aggregate partition area vs perimeter (link to Ch. VII froth) | Variables: regular n-gon perimeter P, area A" ;
    dct:source "Thompson (1917) Ch. VII honeycomb bound; Weaire & Phelan (1994) foam caveat" ;
    rdfs:seeAlso <https://github.com/fractastical/morpholib/blob/a8bae15d56cf26f6d31eb8cd1b41b5301fdde110/morphoeval/lean/loops/Thompson1917_T1917_022.lean> ;
    skos:broader <https://w3id.org/delphi/resource/concept/math-of-biology> ;
    skos:notation "192 < 432 (P^4/A^2 ordering)" ;
    pk:hypothesisType "geometric — isoperimetric / minimal-area hollow and aggregate partitions (Thompson 1917 Ch. VIII claim T1917-022)" ;
    pk:leanTheorem "MathOfBiology.Loop_217.hex_beats_triangle_isoperimetric_scale" ;
    pk:leanVerified true .


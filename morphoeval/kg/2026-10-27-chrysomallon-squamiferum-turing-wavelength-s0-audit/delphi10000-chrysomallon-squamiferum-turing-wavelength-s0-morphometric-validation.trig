sub:assertion {
    <https://w3id.org/delphi/resource/claim/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0> pk:hasAssessment <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-morphometric-validation> .
    <https://w3id.org/delphi/resource/assessment/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Schnakenberg Turing wavelength at 2.0 nm on Chrysomallon squamiferum (Pass 1) — Morphometric validation: 58/100" ;
        dct:date "2026-10-27"^^xsd:date ;
        dct:description "Eigenvalue Pearson r=1.0 compares two evaluations of the same Jacobian. The PDE wavelength 2.520 nm versus the 2.0 nm assignment is a 26% miss. Foreground fraction 0.394 versus prior 0.55 is a real mask measurement, not a fit." ;
        dct:subject <https://w3id.org/delphi/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/delphi/resource/model/grok-4.7> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:hasEvidence <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-calibrated-wavelength-nm>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-equal-diffusion-ablation-ratio>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-pde-versus-target-wavelength-pearson-r>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-contour-circularity>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-foreground-fraction>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency>,
            <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-morphometric-validation-1> ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-calibrated-wavelength-nm> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "calibrated_wavelength_nm = 1.9347 nm" ;
        dct:description "equal-diffusion ablation std ratio 6.546e-12" ;
        schema:measurementTechnique "dominant radial-FFT wavelength of the 2.0 nm Schnakenberg run" ;
        schema:name "calibrated_wavelength_nm" ;
        schema:unitText "nm" ;
        schema:value "1.9347" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-calibrated-wavelength-nm-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-calibrated-wavelength-nm-reference> a schema:PropertyValue ;
        schema:value "2.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-equal-diffusion-ablation-ratio> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "equal_diffusion_ablation_ratio = 0.0 1" ;
        dct:description "negative control; trace f_u+g_v < 0 so equal diffusion is linearly stable" ;
        schema:measurementTechnique "std(u | D_u=D_v) / std(u | D_v=36 D_u) at the calibrated 2.0 nm scale" ;
        schema:name "equal_diffusion_ablation_ratio" ;
        schema:unitText "1" ;
        schema:value "0.0" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-equal-diffusion-ablation-ratio-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-equal-diffusion-ablation-ratio-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-pde-versus-target-wavelength-pearson-r> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "pde_versus_target_wavelength_pearson_r = 0.996439 1" ;
        dct:description "RMSE 0.1823 nm; residual CV 0.0365; sweep [1.35, 1.7, 2.0, 2.35, 2.8, 3.3] -> [1.229, 1.559, 1.935, 2.211, 2.62, 2.97]" ;
        schema:measurementTechnique "Pearson r of 6 target wavelengths vs PDE radial-FFT peaks after fastest-mode calibration" ;
        schema:name "pde_versus_target_wavelength_pearson_r" ;
        schema:unitText "1" ;
        schema:value "0.996439" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-pde-versus-target-wavelength-pearson-r-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-pde-versus-target-wavelength-pearson-r-reference> a schema:PropertyValue ;
        schema:value "0.98" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-contour-circularity> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_contour_circularity = 0.1183 1" ;
        dct:description "non-circular specimen shape metric" ;
        schema:measurementTechnique "4*pi*area/perimeter^2 on the sclerite-and-shell mask" ;
        schema:name "specimen_contour_circularity" ;
        schema:unitText "1" ;
        schema:value "0.1183" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-contour-circularity-reference> a schema:PropertyValue ;
        schema:value "1.0" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-foreground-fraction> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_foreground_fraction = 0.3936 1" ;
        dct:description "non-circular: measured area fraction differs from the prior" ;
        schema:measurementTechnique "gray<0.78 mask on paratype MNHN-IM-2000-30072" ;
        schema:name "specimen_foreground_fraction" ;
        schema:unitText "1" ;
        schema:value "0.3936" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-foreground-fraction-reference> a schema:PropertyValue ;
        schema:value "0.55" .
    <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "specimen_structure_tensor_coherency = 0.3097 1" ;
        dct:description "KS intensity statistic 0.2475 (p=0); orientation KS 0.0265" ;
        schema:measurementTechnique "mean (λ1-λ2)/(λ1+λ2) of the Sobel structure tensor" ;
        schema:name "specimen_structure_tensor_coherency" ;
        schema:unitText "1" ;
        schema:value "0.3097" ;
        schema:valueReference <https://w3id.org/delphi/resource/evidence/morphoeval-delphi10000-chrysomallon-squamiferum-turing-wavelength-s0-measurement-specimen-structure-tensor-coherency-reference> .

sub:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability> .
    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop and serration vs compound leaflet dissection — Code-to-model traceability: 58/100" ;
        dct:date "2026-10-19"^^xsd:date ;
        dct:description "Module docstring cites Bilsborough et al. (2011), but lacks explicit equation-to-code and Lean 4 theorem mappings (`Loop_037_allometric_compound_leaf.lean`)." ;
        dct:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-code-traceability> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/code-traceability" ;
        pk:evidenceAgainst "2011-przemyslaw-allometric-compound-leaf.py L1–L5: Minimal docstring without Lean 4 theorem mapping <https://github.com/fractastical/morpholib/blob/8871db0/2011-przemyslaw-allometric-compound-leaf.py#L1-L5>" ;
        pk:hasScore "0.58"^^xsd:double ;
        pk:hasVerdict "partially faithful" .
    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 037 Pass 1 Assessor)" ;
        dct:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf <https://orcid.org/0009-0007-4948-9192> ;
        foaf:homepage <https://deepmind.google> .
}


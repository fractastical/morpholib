<https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> a pk:Claim ;
    rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop and serration vs compound leaflet dissection (Arabidopsis thaliana / Cardamine hirsuta (growing leaf margin epidermis, serration teeth, and compound leaflets))",
        "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop and serration vs compound leaflet dissection faithfully reproduces Arabidopsis thaliana / Cardamine hirsuta (growing leaf margin epidermis, serration teeth, and compound leaflets) morphology" ;
    dct:conformsTo <https://w3id.org/probknow/resource/math-law/przemyslaw-allometric-compound-leaf-1>,
        <https://w3id.org/probknow/resource/math-law/przemyslaw-allometric-compound-leaf-2>,
        <https://w3id.org/probknow/resource/math-law/przemyslaw-allometric-compound-leaf-3> ;
    dct:description "The simulation script(s) 2011-przemyslaw-allometric-compound-leaf.py implement the cited source model as published and produce forms that match real Arabidopsis thaliana / Cardamine hirsuta (growing leaf margin epidermis, serration teeth, and compound leaflets) specimens and the source authors' figures. A belief under audit, not a fact: its credibility is the weight of evidence (MorphoEval 0.1.0 overall 53.5/100, audit 2026-10-19-allometric-compound-leaf-audit) and the assessments." ;
    dct:subject <https://github.com/fractastical/morpholib/blob/8871db0/2011-przemyslaw-allometric-compound-leaf.py> ;
    schema:about "Arabidopsis thaliana / Cardamine hirsuta (growing leaf margin epidermis, serration teeth, and compound leaflets)" ;
    pk:context "script(s): https://github.com/fractastical/morpholib/blob/8871db0/2011-przemyslaw-allometric-compound-leaf.py; output: docs/media/allometric_compound_leaf_comparison.png; organism: Arabidopsis thaliana / Cardamine hirsuta (growing leaf margin epidermis, serration teeth, and compound leaflets); checkpoint commit: https://github.com/fractastical/morpholib/commit/8871db0; environment: python 3.14.7, numpy 2.4.2, scipy 1.17.0, matplotlib 3.10.8, Pillow 12.1.1; spec_fingerprint: f7e327f643238b6973cf1043ff1d25ce8c9a027859b313633da11bdc256da7cd; artifact_sha256: f3c1906ac6a9bf0f0755eddb5552d6071b0ea8512e341e3ae157f6dd216c7317; input_dataset_sha256: {datasets/allometric_compound_leaf/allometric_compound_leaf_reference.json=fa4f9b265dd83379..., datasets/allometric_compound_leaf/cardamine_hirsuta_compound_leaf_specimen.jpg=1c268fecb3660b31..., datasets/allometric_compound_leaf/paper_citations.bib=8245ac5ad5a33db0..., datasets/allometric_compound_leaf/scout_manifest.json=46ea1539febdb312...}" ;
    pk:derivedFromPaper <https://doi.org/10.1016/j.cell.2019.05.011>,
        <https://doi.org/10.1038/ng.189>,
        <https://doi.org/10.1073/pnas.1015162108>,
        <https://doi.org/10.1126/science.1248384> ;
    pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-code-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-model-fidelity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation>,

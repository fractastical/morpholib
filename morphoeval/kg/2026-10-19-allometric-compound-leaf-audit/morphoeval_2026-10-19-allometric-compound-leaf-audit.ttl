        <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-parameter-expressivity>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-repro-package>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-source-traceability>,
        <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-specimen-match> ;
    pk:hasEvidence <https://w3id.org/probknow/resource/evidence/2026-10-19-allometric-compound-leaf-audit-przemyslaw-allometric-compound-leaf-1>,
        <https://w3id.org/probknow/resource/evidence/2026-10-19-allometric-compound-leaf-audit-przemyslaw-allometric-compound-leaf-2> ;
    pk:hypothesisType "1D/2D Growing Epidermal Margin Auxin–PIN1–CUC2 Feedback Loop & Differential Margin Outgrowth" ;

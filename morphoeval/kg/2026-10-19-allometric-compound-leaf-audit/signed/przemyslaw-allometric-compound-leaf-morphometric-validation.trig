sub1:assertion {
    <https://w3id.org/probknow/resource/claim/morphoeval-przemyslaw-allometric-compound-leaf> pk:hasAssessment <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation> .

    <https://w3id.org/probknow/resource/assessment/morphoeval-przemyslaw-allometric-compound-leaf-morphometric-validation> a pk:LLMClaimAssessment ;
        rdfs:label "Bilsborough et al. (2011), Barkoulas et al. (2008), Vlad et al. (2014) & Kierzkowski et al. (2019) growing leaf margin PIN1-Auxin-CUC2-RCO feedback loop and serration vs compound leaflet dissection — Morphometric validation: 54/100" ;
        dcterms:date "2026-10-19"^^xsd:date ;
        dcterms:description "Exposes only 3 scalar numbers in `measure_morphoeval()` without reference comparisons, statistical p-values, dissection depth indices I_D, intercalary wavelength scaling, or specimen leaflet morphometrics." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-morphometric-validation> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;
        pk:assessmentType "morphoeval/0.1.0/morphometric-validation" ;
        pk:evidenceAgainst "2011-przemyslaw-allometric-compound-leaf.py L58–L65: Minimal 3-number dictionary without reference comparison or p-values <https://github.com/fractastical/morpholib/blob/8871db0/2011-przemyslaw-allometric-compound-leaf.py#L58-L65>" ;
        pk:hasEvidence <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-auxin-contrast>,
            <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-wt-auxin-contrast> ;
        pk:hasScore "0.54"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-cuc2-auxin-contrast> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "cuc2_auxin_contrast = 0.30551411140321183 auxin_units" ;
        schema:measurementTechnique "1D static ring cuc2=0 auxin contrast" ;
        schema:name "cuc2_auxin_contrast" ;
        schema:unitText "auxin_units" ;
        schema:value "0.30551411140321183" .

    <https://w3id.org/probknow/resource/evidence/morphoeval-przemyslaw-allometric-compound-leaf-measurement-wt-auxin-contrast> a schema:PropertyValue,
            pk:EvidenceItem ;
        rdfs:label "wt_auxin_contrast = 0.3055141114033264 auxin_units" ;
        schema:measurementTechnique "1D static ring WT auxin contrast" ;
        schema:name "wt_auxin_contrast" ;
        schema:unitText "auxin_units" ;
        schema:value "0.3055141114033264" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;
        rdfs:label "Gemini 4 Argon (MorphoEval Autonomous Loop Slot 037 Pass 1 Assessor)" ;
        dcterms:identifier "gemini-4-argon" ;
        prov:actedOnBehalfOf orcid:0009-0007-4948-9192 ;
        foaf:homepage <https://deepmind.google> .
}


        dcterms:description "Vendors `datasets/allometric_compound_leaf/cardamine_hirsuta_compound_leaf_specimen.jpg` on disk, but Pass 1 does not load, segment, or extract leaflet lobe count, dissection perimeter ratio, or radial tip-to-sinus dissection index I_D from the specimen image." ;
        dcterms:subject <https://w3id.org/probknow/resource/concept/morphoeval-0.1.0-specimen-match> ;
        pk:assessedBy <https://w3id.org/probknow/resource/model/gemini-4-argon> ;

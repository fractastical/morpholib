        pk:evidenceAgainst "2011-przemyslaw-allometric-compound-leaf.py L68–L111: Renders 2-panel 1D concentration plot without loading or segmenting specimen image <https://github.com/fractastical/morpholib/blob/8871db0/2011-przemyslaw-allometric-compound-leaf.py#L68-L111>" ;
        pk:hasScore "0.45"^^xsd:double ;
        pk:hasVerdict "partially faithful" .

    <https://w3id.org/probknow/resource/model/gemini-4-argon> a pk:Model ;

/-
  morphoeval/lean/loops/Thompson1917_T1917_029.lean
  =============================================================================
  Formal Lean 4 specification & machine-checked proofs for Slot 223
  (`thompson1917-t1917-029`): D'Arcy W. Thompson (1917) On Growth and Form,
  Ch. XII "The Spiral Shells of the Foraminifera", pp. 587-611, Figs. 308-317.

  Claim T1917-029 (dated 1917): foraminiferal shells are generated by chambers
  added in logarithmic-spiral succession with (near-)constant growth ratios,
  and the genera form a continuous geometric series transformable into one
  another.

  What is formalised (all in Lean 4 core, zero imports, every theorem fully proved):

    Theorem 1 `geometric_succession_is_gnomonic`
      Continued proportion L_n = L_1 * rho^n (p. 595: van Iterson's Triloculina,
      Rhumbler's Pulvinulina; p. 593 von Moller's Fusulina) implies (i) a constant
      successive ratio, (ii) the "gnomon" / self-similarity law: the series
      restarted m steps later is the old series magnified by rho^m (p. 591
      "the big many-chambered shell is of just the same shape as the smaller
      and younger shell"), (iii) the half-whorl -> whole-whorl rule
      W = rho_half^2 (p. 593: 0.088 -> 0.176 in log10), and (iv) the
      index-free cross-product invariance L_{n+1} L_m = L_n L_{m+1}.

    Theorem 2 `thompson_mass_proportional_growth_constant_volume_ratio`
      Thompson's derivation (pp. 597-598): if each new chamber's volume is the
      fixed fraction q of the whole pre-existing mass, V_{n+1} = q (V_0 + ... + V_n),
      then the volume ratio between consecutive chambers is the constant 1 + q and
      the cumulative mass is V_0 (1+q)^n.

    Theorem 3 `log_difference_constancy_half_and_whole_whorl`
      von Moller's arithmetic on p. 593 in integer log-space (units 10^-3 log10):
      with per-half-whorl difference c the per-whorl (alternate) difference is 2c,
      and with c = 88 one gets 176 (= log10 1.5 to three decimals).

    Theorem 4 `equal_angle_whorl_periodicity`
      Equal-angle condition (pp. 595-597): if each chamber subtends d degrees and
      m * d = 360, then chamber n + m lies on the same radius one whorl later and is
      rho^m times chamber n; concrete instances Biloculina (180 deg, m = 2),
      Triloculina (120 deg, m = 3), Cyclammina (Fig. 313, 20 deg, m = 18).

    Theorem 5 `continuous_series_and_limiting_cases`
      The "continuous geometric series" (pp. 602-605): the family is monotone in
      rho (a larger ratio gives a larger shell at every index, so forms are ordered
      and pass into one another by gradations), the Orbitolitid limit rho = 1 is the
      constant (circular) series, and the Nodosarian limit d = 0 keeps every chamber
      on the zero radius vector (straight line).

  Verify with:
    lean morphoeval/lean/loops/Thompson1917_T1917_029.lean
-/

namespace MathOfBiology.Loop_223

-- ============================================================================
-- Law 1: continued proportion of successive chambers / half-whorls (E3)
-- ============================================================================

/-- Linear dimension of chamber (or half-whorl) `n` under continued proportion:
    `L_n = L_1 * rho^n` (Thompson p. 595, van Iterson's table; p. 593 von Moller). -/
def chamberSize (L1 rho n : Nat) : Nat :=
  L1 * rho ^ n

/-- Theorem 1: geometric succession is gnomonic. -/
theorem geometric_succession_is_gnomonic (L1 rho n m : Nat) :
    chamberSize L1 rho (n + 1) = rho * chamberSize L1 rho n ∧
    chamberSize L1 rho (n + m) = rho ^ m * chamberSize L1 rho n ∧
    chamberSize L1 rho (n + 2) = (rho * rho) * chamberSize L1 rho n ∧
    chamberSize L1 rho (n + 1) * chamberSize L1 rho m
      = chamberSize L1 rho n * chamberSize L1 rho (m + 1) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · simp only [chamberSize, Nat.pow_succ]
    rw [Nat.mul_comm (rho ^ n) rho, ← Nat.mul_assoc, Nat.mul_comm L1 rho, Nat.mul_assoc]
  · simp only [chamberSize, Nat.pow_add]
    rw [Nat.mul_comm (rho ^ n) (rho ^ m), ← Nat.mul_assoc, Nat.mul_comm L1 (rho ^ m), Nat.mul_assoc]
  · simp only [chamberSize, Nat.pow_succ]
    rw [Nat.mul_assoc (rho ^ n) rho rho, Nat.mul_comm (rho ^ n) (rho * rho), ← Nat.mul_assoc,
      Nat.mul_comm L1 (rho * rho), Nat.mul_assoc]
  · -- both sides equal L1 * L1 * rho^n * rho^m * rho (associativity/commutativity only)
    simp only [chamberSize, Nat.pow_succ]
    ac_rfl

-- ============================================================================
-- Law 2: Thompson's mass-proportional growth derivation (E4, pp. 597-598)
-- ============================================================================

/-- Cumulative shell mass after chamber `n`: `S_0 = V_0`, `S_{n+1} = S_n + q S_n`
    (each increment is the fraction `q` of the whole pre-existing mass). -/
def cumMass (V0 q : Nat) : Nat → Nat
  | 0 => V0
  | n + 1 => (1 + q) * cumMass V0 q n

/-- Volume of the chamber added at step `n + 1`: `V_{n+1} = q * S_n`. -/
def chamberVol (V0 q n : Nat) : Nat :=
  q * cumMass V0 q n

theorem cumMass_closed_form (V0 q : Nat) : ∀ n, cumMass V0 q n = V0 * (1 + q) ^ n
  | 0 => by simp [cumMass]
  | n + 1 => by
    rw [cumMass, cumMass_closed_form V0 q n, Nat.pow_succ, Nat.mul_left_comm,
      Nat.mul_comm (1 + q) ((1 + q) ^ n)]

/-- Theorem 2: constant volume ratio `V_{n+2} / V_{n+1} = 1 + q` and the closed form
    `S_n = V_0 (1+q)^n`; Thompson's "ratio ... running through the whole series". -/
theorem thompson_mass_proportional_growth_constant_volume_ratio (V0 q n : Nat) :
    chamberVol V0 q (n + 1) = (1 + q) * chamberVol V0 q n ∧
    cumMass V0 q n = V0 * (1 + q) ^ n ∧
    chamberVol V0 q n = q * V0 * (1 + q) ^ n := by
  refine ⟨?_, cumMass_closed_form V0 q n, ?_⟩
  · simp only [chamberVol, cumMass]
    rw [Nat.mul_left_comm]
  · rw [chamberVol, cumMass_closed_form, Nat.mul_assoc]

-- ============================================================================
-- Law 3: von Moller's log-difference arithmetic (p. 593)
-- ============================================================================

/-- Logarithm of the size of half-whorl `n` in integer units: `log L_n = a + n c`. -/
def logSize (a c n : Nat) : Nat :=
  a + n * c

/-- Theorem 3: successive log-differences are the constant `c` and alternate
    (whole-whorl) differences are `2 c`; with c = 88 (10^-3 log10) the whole-whorl
    difference is 176, i.e. log10 1.5 as Thompson states. -/
theorem log_difference_constancy_half_and_whole_whorl (a c n : Nat) :
    logSize a c (n + 1) - logSize a c n = c ∧
    logSize a c (n + 2) - logSize a c n = 2 * c ∧
    logSize 982 88 2 - logSize 982 88 0 = 176 := by
  refine ⟨?_, ?_, by decide⟩
  · simp only [logSize, Nat.add_mul, Nat.one_mul]
    omega
  · simp only [logSize, Nat.add_mul]
    omega

-- ============================================================================
-- Law 4: equal-angle condition and whorl periodicity (E5, pp. 595-597)
-- ============================================================================

/-- Vectorial angle (degrees) of chamber `n` when every chamber subtends `d` degrees. -/
def chamberAngle (d n : Nat) : Nat :=
  n * d

/-- Theorem 4: if `m` chambers make one whorl (`m * d = 360`) then chamber `n + m`
    returns to the same radius (angle advanced by exactly 360) and is `rho^m` times
    chamber `n`; Biloculina / Triloculina / Cyclammina instances. -/
theorem equal_angle_whorl_periodicity (d m n L1 rho : Nat) (h : m * d = 360) :
    chamberAngle d (n + m) = chamberAngle d n + 360 ∧
    chamberSize L1 rho (n + m) = rho ^ m * chamberSize L1 rho n ∧
    chamberAngle 180 2 = 360 ∧ chamberAngle 120 3 = 360 ∧ chamberAngle 20 18 = 360 := by
  refine ⟨?_, (geometric_succession_is_gnomonic L1 rho n m).2.1, by decide, by decide, by decide⟩
  simp only [chamberAngle, Nat.add_mul]
  omega

-- ============================================================================
-- Law 5: the continuous series and its limiting cases (pp. 602-605)
-- ============================================================================

/-- Theorem 5: the family `L_n = L_1 rho^n` is monotone in `rho` (forms are ordered
    along the ratio axis and pass into one another by gradations), the Orbitolitid
    limit `rho = 1` is the constant series (circle), and the Nodosarian limit `d = 0`
    keeps every chamber on the zero radius vector (straight line). -/
theorem continuous_series_and_limiting_cases (L1 rho rho' n : Nat) (h : rho ≤ rho') :
    chamberSize L1 rho n ≤ chamberSize L1 rho' n ∧
    chamberSize L1 1 n = L1 ∧
    chamberAngle 0 n = 0 := by
  refine ⟨?_, ?_, ?_⟩
  · exact Nat.mul_le_mul_left L1 (Nat.pow_le_pow_left h n)
  · simp [chamberSize]
  · simp [chamberAngle]

end MathOfBiology.Loop_223

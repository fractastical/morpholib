/-
  morphoeval/lean/loops/Thompson1917_T1917_014.lean
  Loop 211 (slot thompson1917-t1917-014) — Thompson (1917) Ch. V "The Forms of Cells",
  pp. 201-276: Lagena and other unilocular cells as Delaunay surfaces of revolution
  (sphere, cylinder, unduloid, nodoid, catenoid).

  Standalone Lean 4 (no imports, core tactics only: omega, simp, split, rw).  Everything
  is stated over the integers with explicit scale factors, mirroring the integer-checkable
  content of `thompson/claims/t1917-014_the-forms-of-cells.py`:

  * Delaunay (1841) rolling ellipse with semi-major axis `a` and focal half-distance `c`
    generates the unduloid whose bulge and neck radii are `r_max = a + c`, `r_min = a - c`
    (script: `neck_ratio`, `kenmotsu_profile`; reference JSON E3-E5).
  * The first integral  r / sqrt(1 + r'^2) - H r^2 = C  evaluated at the two turning
    points (r' = 0) makes r_max, r_min the roots of  H r^2 - r + C = 0, hence
    r_max + r_min = 1/H = 2a  and  r_max * r_min = C/H = b^2 = a^2 - c^2.
  * Kenmotsu (1980):  (2H r)^2 = 1 + B^2 + 2 B sin(2Hs),  B = c/a.  With the sine scaled
    to an integer σ ∈ [-S, S] and B ∈ [0, S], the radius is pinned between the neck and
    the bulge:  (S - B)^2 ≤ S^2 + B^2 + 2Bσ ≤ (S + B)^2.
  * Catalogue trichotomy in B: 0 cylinder, (0, 1) unduloid, 1 string of spheres, > 1 nodoid.
  * Bead aspect-ratio bound: the axial length of one unduloid bead is at most its arc
    length π/H (dz/ds = cos ψ ≤ 1), its width is (1 + B)/H ≥ 1/H, so length/width ≤ π.
    Slender fusiform "Lagena" with L/W > π therefore cannot be a single unduloid
    (script: `bead_aspect_bound`).
  * Flask join (E7): the C¹ sphere–unduloid join radius satisfies
    r_j^2 = R^2 (1 - B^2) / (4κ(1 - κ)) with κ = R H; the equator join κ = (1 + B)/2 gives
    4κ(1 - κ) = (1 + B)(1 - B) = 1 - B^2 exactly, i.e. r_j = R.
-/
namespace MathOfBiology.Loop_211

/-- Bulge radius of the unduloid generated by the rolling ellipse (a, c): r_max = a + c. -/
def rMax (a c : Int) : Int := a + c

/-- Neck radius of the same unduloid: r_min = a - c. -/
def rMin (a c : Int) : Int := a - c

/-- E3 (sum of roots of H r^2 - r + C = 0): r_max + r_min = 1/H = 2a. -/
theorem roots_sum (a c : Int) : rMax a c + rMin a c = 2 * a := by
  unfold rMax rMin
  omega

/-- E3/E4 (product of roots = b^2): r_max * r_min = a^2 - c^2, the semi-minor axis squared
    of Delaunay's rolling ellipse. -/
theorem roots_product (a c : Int) : rMax a c * rMin a c = a * a - c * c := by
  unfold rMax rMin
  have e1 := Int.add_mul a c (a - c)
  have e2 := Int.mul_sub a a c
  have e3 := Int.mul_sub c a c
  have e4 := Int.mul_comm c a
  omega

/-- Delaunay first-integral invariance between the two turning points, scaled by 2a = 1/H:
    r_max^2 - r_min^2 = 2a (r_max - r_min), i.e. H r_max^2 - r_max = H r_min^2 - r_min = -C. -/
theorem first_integral_turning_points (a c : Int) :
    rMax a c * rMax a c - rMin a c * rMin a c = 2 * a * (rMax a c - rMin a c) := by
  unfold rMax rMin
  have e1 := Int.add_mul a c (a + c)
  have e2 := Int.mul_add a a c
  have e3 := Int.mul_add c a c
  have e4 := Int.sub_mul a c (a - c)
  have e5 := Int.mul_sub a a c
  have e6 := Int.mul_sub c a c
  have e7 := Int.mul_comm c a
  have e8 : 2 * a * ((a + c) - (a - c)) = 2 * (a * ((a + c) - (a - c))) := Int.mul_assoc 2 a _
  have e9 := Int.mul_sub a (a + c) (a - c)
  have e10 := Int.mul_add a a c
  omega

/-- E5 (neck between the limits): for 0 ≤ c ≤ a the neck radius is non-negative and never
    exceeds the bulge; c = 0 is the cylinder (r_min = r_max), c = a the string of spheres
    (r_min = 0). -/
theorem neck_between (a c : Int) (h0 : 0 ≤ c) (h1 : c ≤ a) :
    0 ≤ rMin a c ∧ rMin a c ≤ rMax a c := by
  unfold rMin rMax
  omega

/-- E5 (cylinder limit): c = 0 gives r_min = r_max. -/
theorem cylinder_limit (a : Int) : rMin a 0 = rMax a 0 := by
  unfold rMin rMax
  omega

/-- E5 (sphere-string limit): c = a pinches the neck to radius 0. -/
theorem sphere_limit (a : Int) : rMin a a = 0 := by
  unfold rMin
  omega

/-- E5 (strict monotonicity of the neck ratio): for a > 0 the ratio r_min / r_max =
    (a - c)/(a + c) strictly decreases with the eccentricity c, stated cross-multiplied:
    c₁ < c₂ → (a - c₂)(a + c₁) < (a - c₁)(a + c₂). -/
theorem neck_ratio_strict_anti (a c₁ c₂ : Int) (ha : 0 < a) (h : c₁ < c₂) :
    rMin a c₂ * rMax a c₁ < rMin a c₁ * rMax a c₂ := by
  unfold rMin rMax
  have hm : a * c₁ < a * c₂ := Int.mul_lt_mul_of_pos_left h ha
  have e1 := Int.sub_mul a c₂ (a + c₁)
  have e2 := Int.mul_add a a c₁
  have e3 := Int.mul_add c₂ a c₁
  have e4 := Int.sub_mul a c₁ (a + c₂)
  have e5 := Int.mul_add a a c₂
  have e6 := Int.mul_add c₁ a c₂
  have e7 := Int.mul_comm c₂ a
  have e8 := Int.mul_comm c₁ a
  have e9 := Int.mul_comm c₂ c₁
  omega

/-- Kenmotsu radius envelope (E4, scaled): with sin(2Hs) = σ/S, |σ| ≤ S and 0 ≤ B ≤ S,
    the squared scaled radius S^2 + B^2 + 2Bσ lies between the neck value (S - B)^2 and
    the bulge value (S + B)^2.  The meridian never leaves the annulus [r_min, r_max]. -/
theorem kenmotsu_envelope (S B σ : Int) (hB0 : 0 ≤ B) (hσl : -S ≤ σ) (hσu : σ ≤ S) :
    (S - B) * (S - B) ≤ S * S + B * B + 2 * (B * σ) ∧
    S * S + B * B + 2 * (B * σ) ≤ (S + B) * (S + B) := by
  have hu : B * σ ≤ B * S := Int.mul_le_mul_of_nonneg_left hσu hB0
  have hl : B * (-S) ≤ B * σ := Int.mul_le_mul_of_nonneg_left hσl hB0
  have hneg : B * (-S) = -(B * S) := Int.mul_neg B S
  have e1 := Int.sub_mul S B (S - B)
  have e2 := Int.mul_sub S S B
  have e3 := Int.mul_sub B S B
  have e4 := Int.add_mul S B (S + B)
  have e5 := Int.mul_add S S B
  have e6 := Int.mul_add B S B
  have e7 := Int.mul_comm S B
  omega

/-- Plateau/Delaunay catalogue index as a function of the Kenmotsu parameter B (scaled by S):
    0 cylinder, 1 unduloid, 2 string of spheres, 3 nodoid. -/
def catalogue (S B : Int) : Nat :=
  if B = 0 then 0 else if B < S then 1 else if B = S then 2 else 3

theorem catalogue_cylinder (S : Int) : catalogue S 0 = 0 := by
  unfold catalogue
  simp

theorem catalogue_unduloid (S B : Int) (h0 : 0 < B) (h1 : B < S) : catalogue S B = 1 := by
  unfold catalogue
  split <;> (try split) <;> omega

theorem catalogue_sphere (S : Int) (hS : 0 < S) : catalogue S S = 2 := by
  unfold catalogue
  split <;> (try split) <;> (try split) <;> omega

theorem catalogue_nodoid (S B : Int) (h : S < B) (hS : 0 < S) : catalogue S B = 3 := by
  unfold catalogue
  split <;> (try split) <;> (try split) <;> omega

/-- The catalogue is exhaustive: every admissible B ≥ 0 lands in exactly one of the four
    classes (Thompson p. 218: the CMC surfaces of revolution "are very few in number"). -/
theorem catalogue_exhaustive (S B : Int) :
    catalogue S B = 0 ∨ catalogue S B = 1 ∨ catalogue S B = 2 ∨ catalogue S B = 3 := by
  unfold catalogue
  split <;> (try split) <;> (try split) <;> omega

/-- E6 (bead aspect-ratio bound, scale 1000 = 1/H): one unduloid bead has axial length L at
    most its meridian arc length P = π/H ≤ 3.142/H (because dz/ds = cos ψ ≤ 1) and width
    W = (1 + B)/H ≥ 1/H.  Hence 1000 L ≤ 3142 W, i.e. L/W ≤ π.  A silhouette with
    L/W > 3.142 cannot be a single unduloid bead — the refutation lemma for the slender
    fusiform Lagena of Fig. 84. -/
theorem bead_aspect_bound (L P W : Int) (hL : L ≤ P) (hP : P ≤ 3142) (hW : 1000 ≤ W) :
    1000 * L ≤ 3142 * W := by
  omega

/-- Contrapositive used by the script: a spindle of length L and width W with
    1000 L > 3142 W violates the bead bound for every admissible arc length P. -/
theorem spindle_not_bead (L W : Int) (hW : 1000 ≤ W) (h : 3142 * W < 1000 * L) :
    ¬ ∃ P : Int, L ≤ P ∧ P ≤ 3142 := by
  intro ⟨P, hLP, hP⟩
  omega

/-- Concrete instance from the Pass 1 numbers: Fig. 84 specimen #3 has L/W ≈ 10.9 (scaled
    L = 10940, W = 1000), far outside the unduloid bead bound. -/
theorem fig84_spindle_3_not_bead : ¬ ∃ P : Int, (10940 : Int) ≤ P ∧ P ≤ 3142 := by
  intro ⟨P, h1, h2⟩
  omega

/-- Flask join (E7, scaled by S): at the equator join κ = (S + B)/2 the denominator
    4κ(S - κ) = (S + B)(S - B) equals S^2 - B^2, the numerator of r_j^2, so r_j = R.
    Stated with 2κ = S + B to stay in the integers. -/
theorem flask_equator_join (S B : Int) :
    (S + B) * (2 * S - (S + B)) = S * S - B * B := by
  have e0 : 2 * S - (S + B) = S - B := by omega
  rw [e0]
  have e1 := Int.add_mul S B (S - B)
  have e2 := Int.mul_sub S S B
  have e3 := Int.mul_sub B S B
  have e4 := Int.mul_comm B S
  omega

/-- Flask join feasibility (E7): the join lies on the sphere (r_j ≤ R) iff
    S^2 - B^2 ≤ 4κ(S - κ) (scaled); for 2κ strictly between S - B and S + B this holds
    with room to spare, i.e. the sphere portion extends above the equator. -/
theorem flask_join_feasible (S B k : Int) (hk1 : S - B ≤ 2 * k) (hk2 : 2 * k ≤ S + B) :
    S * S - B * B ≤ 4 * (k * (S - k)) := by
  -- (2k - (S - B)) * ((S + B) - 2k) ≥ 0 expands to 4k(S - k) - (S^2 - B^2) ≥ 0
  have hp : 0 ≤ (2 * k - (S - B)) * ((S + B) - 2 * k) :=
    Int.mul_nonneg (by omega) (by omega)
  have e1 := Int.sub_mul (2 * k) (S - B) ((S + B) - 2 * k)
  have e2 := Int.mul_sub (2 * k) (S + B) (2 * k)
  have e3 := Int.mul_sub (S - B) (S + B) (2 * k)
  have e4 := Int.mul_add (2 * k) S B
  have e5 := Int.sub_mul S B (S + B)
  have e6 := Int.mul_add S S B
  have e7 := Int.mul_add B S B
  have e8 := Int.sub_mul S B (2 * k)
  have e9 : 2 * k * (2 * k) = 4 * (k * k) := by
    have := Int.mul_assoc 2 k (2 * k)
    have := Int.mul_comm k (2 * k)
    have := Int.mul_assoc 2 k k
    omega
  have e10 : 2 * k * S = 2 * (k * S) := Int.mul_assoc 2 k S
  have e11 : 2 * k * B = 2 * (k * B) := Int.mul_assoc 2 k B
  have e12 : S * (2 * k) = 2 * (k * S) := by
    have := Int.mul_comm S (2 * k)
    have := Int.mul_assoc 2 k S
    omega
  have e13 : B * (2 * k) = 2 * (k * B) := by
    have := Int.mul_comm B (2 * k)
    have := Int.mul_assoc 2 k B
    omega
  have e14 := Int.mul_comm B S
  have e15 := Int.mul_sub k S k
  omega

end MathOfBiology.Loop_211

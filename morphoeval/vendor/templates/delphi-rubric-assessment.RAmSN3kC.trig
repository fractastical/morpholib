@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix orcid: <https://orcid.org/> .
@prefix pk: <https://w3id.org/delphi/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sub1: <https://w3id.org/np/RAmSN3kCnQSAMqCM143jWrdUWzQTDku2_1DjrHY4v3ol4/> .
@prefix this: <https://w3id.org/np/RAmSN3kCnQSAMqCM143jWrdUWzQTDku2_1DjrHY4v3ol4> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub1:assertion {
    sub1:template a ntemplate:AssertionTemplate ;
        rdfs:label "Project Delphi rubric assessment of a claim" ;
        dcterms:description "An assessment of a Project Delphi claim against one dimension of a rubric (or against the whole rubric, for the overall score), made by a language model acting as evaluator: the score from 0 to 1, a verdict, and the evidence items the score rests on — code locations, passages, or measurements with their reference values. The assessment's identifier is minted from this nanopublication's artifact code; pipelines may use their own ids under pkr:assessment/." ;
        dcterms:isVersionOf sub1:rubricAssessmentKind ;
        gen:governedBy <https://w3id.org/spaces/delphi> ;
        ntemplate:hasNanopubLabelPattern "${label}" ;
        ntemplate:hasStatement sub1:st01,
            sub1:st02,
            sub1:st03,
            sub1:st04,
            sub1:st05,
            sub1:st06,
            sub1:st07,
            sub1:st08,
            sub1:st09,
            sub1:st10,
            sub1:st11,
            sub1:st12,
            sub1:st13,
            sub1:st14,
            sub1:st15,
            sub1:st16,
            sub1:st17,
            sub1:st17a,
            sub1:st17b,
            sub1:st17c,
            sub1:st17d,
            sub1:st17e,
            sub1:st17f,
            sub1:st17g,
            sub1:st17h,
            sub1:st17i,
            sub1:st17j,
            sub1:st17k,
            sub1:st17l,
            sub1:st17m,
            sub1:st17n ;
        ntemplate:hasTag "Project Delphi" ;
        ntemplate:hasTargetNanopubType pk:LLMClaimAssessment .

    dcterms:date rdfs:label "has the date" .

    dcterms:identifier rdfs:label "has the identifier" .

    dcterms:source rdfs:label "has the source" .

    dcterms:subject rdfs:label "is about" .

    prov:actedOnBehalfOf rdfs:label "acts on behalf of" .

    prov:wasDerivedFrom rdfs:label "is derived from" .

    foaf:homepage rdfs:label "has the homepage" .

    schema:measurementTechnique rdfs:label "was measured by" .

    schema:name rdfs:label "has the name" .

    schema:unitText rdfs:label "has the unit" .

    schema:valueReference rdfs:label "has the reference value" .

    pk:EvidenceItem rdfs:label "evidence item" .

    pk:Model rdfs:label "language model" .

    pk:assessedBy rdfs:label "is assessed by" .

    pk:assessmentType rdfs:label "has the assessment type" .

    pk:evidenceAgainst rdfs:label "has evidence against" .

    pk:hasAssessment rdfs:label "has the assessment" .

    pk:hasEvidence rdfs:label "has the evidence item" .

    pk:hasScore rdfs:label "has the score (0–1)" .

    pk:hasVerdict rdfs:label "has the verdict" .

    sub1:assessmentType a ntemplate:LiteralPlaceholder ;
        rdfs:label "the assessment type: rubric, version and dimension (e.g. morphoeval/0.1.0/code-traceability)" .

    sub1:claim a ntemplate:ExternalUriPlaceholder,
            ntemplate:GuidedChoicePlaceholder ;
        rdfs:label "the claim being assessed" ;
        ntemplate:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/delphi/ontology/Claim" .

    sub1:date a ntemplate:LiteralPlaceholder ;
        rdfs:label "the date of the assessment" ;
        ntemplate:hasDatatype xsd:date .

    sub1:description a ntemplate:LongLiteralPlaceholder ;
        rdfs:label "the assessor's reasoning" .

    sub1:dimension a ntemplate:ExternalUriPlaceholder,
            ntemplate:GuidedChoicePlaceholder ;
        rdfs:label "the rubric dimension scored (the rubric itself for the overall score)" ;
        ntemplate:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/delphi/ontology/Concept" .

    sub1:evidenceAgainst a ntemplate:LongLiteralPlaceholder ;
        rdfs:label "a point counting against the claim" .

    sub1:evidenceDescription a ntemplate:LongLiteralPlaceholder ;
        rdfs:label "what the evidence shows" .

    sub1:evidenceLabel a ntemplate:LiteralPlaceholder ;
        rdfs:label "the evidence in one line" .

    sub1:label a ntemplate:LiteralPlaceholder ;
        rdfs:label "short label of the assessment (claim, dimension and score)" .

    sub1:modelHomepage a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "the model's homepage" .

    sub1:modelId a ntemplate:LiteralPlaceholder ;
        rdfs:label "the model's identifier (e.g. its API model id)" .

    sub1:modelLabel a ntemplate:LiteralPlaceholder ;
        rdfs:label "the model's name and version" .

    sub1:operator a ntemplate:AgentPlaceholder ;
        rdfs:label "the person the model acted on behalf of" ;
        ntemplate:hasDefaultValue ntemplate:CREATOR .

    sub1:quantity a ntemplate:LiteralPlaceholder ;
        rdfs:label "the measured quantity, for a measurement" .

    sub1:referenceSource a ntemplate:LiteralPlaceholder ;
        rdfs:label "where the reference value comes from" .

    sub1:referenceValue a ntemplate:LiteralPlaceholder ;
        rdfs:label "the reference value" .

    sub1:score a ntemplate:LiteralPlaceholder ;
        rdfs:label "the score, from 0 to 1" ;
        ntemplate:hasDatatype xsd:double ;
        ntemplate:hasRegex "^(0(\\.[0-9]+)?|1(\\.0+)?)$" .

    sub1:source a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "where the evidence comes from (a file and line range, a commit, a DOI)" .

    sub1:st01 rdf:object pk:LLMClaimAssessment ;
        rdf:predicate rdf:type ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "1" .

    sub1:st02 rdf:object sub1:label ;
        rdf:predicate rdfs:label ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "2" .

    sub1:st03 a ntemplate:OptionalStatement ;
        rdf:object sub1:date ;
        rdf:predicate dcterms:date ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "3" .

    sub1:st04 a ntemplate:OptionalStatement ;
        rdf:object sub1:description ;
        rdf:predicate dcterms:description ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "4" .

    sub1:st05 rdf:object <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        rdf:predicate pk:hasAssessment ;
        rdf:subject sub1:claim ;
        ntemplate:statementOrder "5" .

    sub1:st06 rdf:object sub1:dimension ;
        rdf:predicate dcterms:subject ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "6" .

    sub1:st07 rdf:object sub1:model ;
        rdf:predicate pk:assessedBy ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "7" .

    sub1:st08 rdf:object pk:Model ;
        rdf:predicate rdf:type ;
        rdf:subject sub1:model ;
        ntemplate:statementOrder "8" .

    sub1:st09 rdf:object sub1:modelLabel ;
        rdf:predicate rdfs:label ;
        rdf:subject sub1:model ;
        ntemplate:statementOrder "9" .

    sub1:st10 a ntemplate:OptionalStatement ;
        rdf:object sub1:modelId ;
        rdf:predicate dcterms:identifier ;
        rdf:subject sub1:model ;
        ntemplate:statementOrder "10" .

    sub1:st11 a ntemplate:OptionalStatement ;
        rdf:object sub1:modelHomepage ;
        rdf:predicate foaf:homepage ;
        rdf:subject sub1:model ;
        ntemplate:statementOrder "11" .

    sub1:st12 a ntemplate:OptionalStatement ;
        rdf:object sub1:operator ;
        rdf:predicate prov:actedOnBehalfOf ;
        rdf:subject sub1:model ;
        ntemplate:statementOrder "12" .

    sub1:st13 rdf:object sub1:assessmentType ;
        rdf:predicate pk:assessmentType ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "13" .

    sub1:st14 a ntemplate:OptionalStatement ;
        rdf:object sub1:verdict ;
        rdf:predicate pk:hasVerdict ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "14" .

    sub1:st15 rdf:object sub1:score ;
        rdf:predicate pk:hasScore ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "15" .

    sub1:st16 a ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        rdf:object sub1:evidenceAgainst ;
        rdf:predicate pk:evidenceAgainst ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "16" .

    sub1:st17 a ntemplate:GroupedStatement,
            ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        ntemplate:hasStatement sub1:st17a,
            sub1:st17b,
            sub1:st17c,
            sub1:st17d,
            sub1:st17e,
            sub1:st17f,
            sub1:st17g,
            sub1:st17h,
            sub1:st17i,
            sub1:st17j,
            sub1:st17k,
            sub1:st17l,
            sub1:st17m,
            sub1:st17n .

    sub1:technique a ntemplate:LongLiteralPlaceholder ;
        rdfs:label "how the value was measured" .

    sub1:unit a ntemplate:LiteralPlaceholder ;
        rdfs:label "the unit of the measured value" .

    sub1:value a ntemplate:LiteralPlaceholder ;
        rdfs:label "the measured value" .

    sub1:verdict a ntemplate:LiteralPlaceholder ;
        rdfs:label "short categorical verdict (e.g. mostly faithful)" .

    dcterms:description rdfs:label "has the description" .

    schema:PropertyValue rdfs:label "property value" .

    schema:value rdfs:label "has the value" .

    pk:LLMClaimAssessment rdfs:label "LLM claim assessment" .

    sub1:st17a rdf:object sub1:evidence ;
        rdf:predicate pk:hasEvidence ;
        rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "17" .

    sub1:st17b rdf:object pk:EvidenceItem ;
        rdf:predicate rdf:type ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "18" .

    sub1:st17c rdf:object sub1:evidenceLabel ;
        rdf:predicate rdfs:label ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "19" .

    sub1:st17d a ntemplate:OptionalStatement ;
        rdf:object sub1:evidenceDescription ;
        rdf:predicate dcterms:description ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "20" .

    sub1:st17e a ntemplate:OptionalStatement ;
        rdf:object sub1:source ;
        rdf:predicate prov:wasDerivedFrom ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "21" .

    sub1:st17f a ntemplate:OptionalStatement ;
        rdf:object schema:PropertyValue ;
        rdf:predicate rdf:type ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "22" .

    sub1:st17g a ntemplate:OptionalStatement ;
        rdf:object sub1:quantity ;
        rdf:predicate schema:name ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "23" .

    sub1:st17h a ntemplate:OptionalStatement ;
        rdf:object sub1:value ;
        rdf:predicate schema:value ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "24" .

    sub1:st17i a ntemplate:OptionalStatement ;
        rdf:object sub1:unit ;
        rdf:predicate schema:unitText ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "25" .

    sub1:st17j a ntemplate:OptionalStatement ;
        rdf:object sub1:technique ;
        rdf:predicate schema:measurementTechnique ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "26" .

    sub1:st17k a ntemplate:OptionalStatement ;
        rdf:object sub1:reference ;
        rdf:predicate schema:valueReference ;
        rdf:subject sub1:evidence ;
        ntemplate:statementOrder "27" .

    sub1:st17l a ntemplate:OptionalStatement ;
        rdf:object schema:PropertyValue ;
        rdf:predicate rdf:type ;
        rdf:subject sub1:reference ;
        ntemplate:statementOrder "28" .

    sub1:st17m a ntemplate:OptionalStatement ;
        rdf:object sub1:referenceValue ;
        rdf:predicate schema:value ;
        rdf:subject sub1:reference ;
        ntemplate:statementOrder "29" .

    sub1:st17n a ntemplate:OptionalStatement ;
        rdf:object sub1:referenceSource ;
        rdf:predicate dcterms:source ;
        rdf:subject sub1:reference ;
        ntemplate:statementOrder "30" .

    rdfs:label rdfs:label "has the label" .

    sub1:reference a ntemplate:UriPlaceholder ;
        rdfs:label "the reference value the measurement is compared with" ;
        ntemplate:hasPrefix "https://w3id.org/delphi/resource/evidence/" ;
        ntemplate:hasPrefixLabel "pkr:evidence/" .

    rdf:type rdfs:label "is a" .

    sub1:model a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "the language model that made the assessment" ;
        ntemplate:hasPrefix "https://w3id.org/delphi/resource/model/" ;
        ntemplate:hasPrefixLabel "pkr:model/" .

    sub1:evidence a ntemplate:UriPlaceholder ;
        rdfs:label "an evidence item the score rests on (a code location, a passage, a measurement)" ;
        ntemplate:hasPrefix "https://w3id.org/delphi/resource/evidence/" ;
        ntemplate:hasPrefixLabel "pkr:evidence/" .

    <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> a ntemplate:IntroducedResource ;
        rdfs:label "this assessment" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub1:pubinfo {
    sub1:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .

    this: rdfs:label "Project Delphi rubric assessment of a claim" ;
        dcterms:created "2026-10-15T05:30:51Z"^^xsd:dateTime ;
        dcterms:creator orcid:0000-0002-1267-0234 ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:embeds sub1:template ;
        npx:introduces sub1:rubricAssessmentKind ;
        npx:supersedes <https://w3id.org/np/RAOAK6Fe6J6JvD4kUCZg53sRpwRkRq7rzFuDtGT7n6Drw> ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
            <https://w3id.org/np/RAoTD7udB2KtUuOuAe74tJi1t3VzK0DyWS7rYVAq1GRvw>,
            <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAWwJ-TzFhUJN5l6cTUIeCIUqqzS8ek-_zumlDczSUipk/template> .
}


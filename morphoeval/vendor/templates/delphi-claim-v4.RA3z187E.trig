@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix orcid: <https://orcid.org/> .
@prefix pk: <https://w3id.org/delphi/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sub1: <https://w3id.org/np/RA3z187EzQXy4zopVZAmFg2sa_QymD1MKfzMxGzNqdNZM/> .
@prefix this: <https://w3id.org/np/RA3z187EzQXy4zopVZAmFg2sa_QymD1MKfzMxGzNqdNZM> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub1:assertion {
    sub1:template a ntemplate:AssertionTemplate ;
        rdfs:label "Project Delphi claim" ;
        dcterms:description "A discrete scientific claim extracted from a paper by the Project Delphi pipeline, or stated about an artifact such as a simulation script, with its experimental context, the evidence items supporting it, the assessments made of it, and the panel-assigned weight of evidence (a score from 0 to 1). The claim is a belief, not an asserted fact; its credibility is carried by the weight and the assessments. The claim's identifier is minted from this nanopublication's artifact code." ;
        dcterms:isVersionOf <https://w3id.org/np/RACSW-97Ldd_hknVOLd2FEB6b8KwgRlp1DdlhR3uFGtt0/claimKind> ;
        gen:governedBy <https://w3id.org/spaces/delphi> ;
        ntemplate:hasNanopubLabelPattern "${label}" ;
        ntemplate:hasStatement sub1:st01,
            sub1:st02,
            sub1:st03,
            sub1:st04,
            sub1:st05,
            sub1:st06,
            sub1:st07,
            sub1:st08,
            sub1:st09,
            sub1:st09a,
            sub1:st09b,
            sub1:st09c,
            sub1:st09d,
            sub1:st09e,
            sub1:st09f,
            sub1:st09g ;
        ntemplate:hasTag "Project Delphi" ;
        ntemplate:hasTargetNanopubType pk:Claim .

    dcterms:description rdfs:label "has the description" .

    dcterms:subject rdfs:label "is about" .

    prov:wasSupportedBy rdfs:label "is supported by" .

    schema:SoftwareSourceCode rdfs:label "software source code" .

    schema:author rdfs:label "has the author" .

    schema:codeRepository rdfs:label "is in the code repository" .

    schema:programmingLanguage rdfs:label "is written in" .

    schema:version rdfs:label "has the version" .

    pk:context rdfs:label "has the experimental context" .

    pk:derivedFromPaper rdfs:label "is derived from the paper" .

    pk:hasAssessment rdfs:label "has the assessment" .

    pk:weightOfEvidence rdfs:label "has the weight of evidence (0–1)" .

    sub1:artifactLabel a ntemplate:LiteralPlaceholder ;
        rdfs:label "the artifact's name (e.g. the file name)" .

    sub1:assessment a ntemplate:ExternalUriPlaceholder,
            ntemplate:GuidedChoicePlaceholder ;
        rdfs:label "an assessment of the claim" ;
        ntemplate:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/delphi/ontology/Assessment" .

    sub1:author a ntemplate:AgentPlaceholder ;
        rdfs:label "the artifact's author" .

    sub1:context a ntemplate:LongLiteralPlaceholder ;
        rdfs:label "experimental context (organism, intervention, measured quantity, time points)" .

    sub1:description a ntemplate:LongLiteralPlaceholder ;
        rdfs:label "a longer statement of the claim" .

    sub1:evidence a ntemplate:ExternalUriPlaceholder,
            ntemplate:GuidedChoicePlaceholder ;
        rdfs:label "an evidence item supporting the claim" ;
        ntemplate:possibleValuesFromApi "https://w3id.org/np/l/nanopub-query-1.1/api/RAyMrQ89RECTi9gZK5q7gjL1wKTiP8StkLy0NIkkCiyew/find-things?type=https://w3id.org/delphi/ontology/EvidenceItem" .

    sub1:label a ntemplate:LiteralPlaceholder ;
        rdfs:label "the claim in one sentence" .

    sub1:language a ntemplate:LiteralPlaceholder ;
        rdfs:label "the programming language of the artifact" .

    sub1:paper a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "the paper the claim was extracted from (DOI as https://doi.org/… IRI)" ;
        ntemplate:hasPrefix "https://doi.org/" ;
        ntemplate:hasPrefixLabel "DOI" .

    sub1:repository a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "the code repository the artifact belongs to" .

    sub1:st01 rdf:object pk:Claim ;
        rdf:predicate rdf:type ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "1" .

    sub1:st02 rdf:object sub1:label ;
        rdf:predicate rdfs:label ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "2" .

    sub1:st03 a ntemplate:OptionalStatement ;
        rdf:object sub1:description ;
        rdf:predicate dcterms:description ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "3" .

    sub1:st04 a ntemplate:OptionalStatement ;
        rdf:object sub1:context ;
        rdf:predicate pk:context ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "4" .

    sub1:st05 a ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        rdf:object sub1:paper ;
        rdf:predicate pk:derivedFromPaper ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "5" .

    sub1:st06 a ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        rdf:object sub1:evidence ;
        rdf:predicate prov:wasSupportedBy ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "6" .

    sub1:st07 a ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        rdf:object sub1:assessment ;
        rdf:predicate pk:hasAssessment ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "7" .

    sub1:st08 a ntemplate:OptionalStatement ;
        rdf:object sub1:weight ;
        rdf:predicate pk:weightOfEvidence ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "8" .

    sub1:st09 a ntemplate:GroupedStatement,
            ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        ntemplate:hasStatement sub1:st09a,
            sub1:st09b,
            sub1:st09c,
            sub1:st09d,
            sub1:st09e,
            sub1:st09f,
            sub1:st09g .

    sub1:version a ntemplate:LiteralPlaceholder ;
        rdfs:label "the artifact's version (e.g. the commit)" .

    sub1:weight a ntemplate:LiteralPlaceholder ;
        rdfs:label "panel-assigned weight of evidence, from 0 to 1" ;
        ntemplate:hasDatatype xsd:double ;
        ntemplate:hasRegex "^(0(\\.[0-9]+)?|1(\\.0+)?)$" .

    rdf:type rdfs:label "is a" .

    rdfs:label rdfs:label "has the label" .

    pk:Claim rdfs:label "claim" .

    sub1:st09a rdf:object sub1:artifact ;
        rdf:predicate dcterms:subject ;
        rdf:subject <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "9" .

    sub1:st09b a ntemplate:OptionalStatement ;
        rdf:object schema:SoftwareSourceCode ;
        rdf:predicate rdf:type ;
        rdf:subject sub1:artifact ;
        ntemplate:statementOrder "10" .

    sub1:st09c a ntemplate:OptionalStatement ;
        rdf:object sub1:artifactLabel ;
        rdf:predicate rdfs:label ;
        rdf:subject sub1:artifact ;
        ntemplate:statementOrder "11" .

    sub1:st09d a ntemplate:OptionalStatement ;
        rdf:object sub1:repository ;
        rdf:predicate schema:codeRepository ;
        rdf:subject sub1:artifact ;
        ntemplate:statementOrder "12" .

    sub1:st09e a ntemplate:OptionalStatement ;
        rdf:object sub1:version ;
        rdf:predicate schema:version ;
        rdf:subject sub1:artifact ;
        ntemplate:statementOrder "13" .

    sub1:st09f a ntemplate:OptionalStatement ;
        rdf:object sub1:language ;
        rdf:predicate schema:programmingLanguage ;
        rdf:subject sub1:artifact ;
        ntemplate:statementOrder "14" .

    sub1:st09g a ntemplate:OptionalStatement ;
        rdf:object sub1:author ;
        rdf:predicate schema:author ;
        rdf:subject sub1:artifact ;
        ntemplate:statementOrder "15" .

    sub1:artifact a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "the artifact the claim is about, if any (a script, model or dataset, by URL)" .

    <https://w3id.org/delphi/resource/claim/~~ARTIFACTCODE~~> a ntemplate:IntroducedResource ;
        rdfs:label "this claim" .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:pubinfo {
    sub1:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .

    this: rdfs:label "Project Delphi claim" ;
        dcterms:created "2026-10-15T05:30:51Z"^^xsd:dateTime ;
        dcterms:creator orcid:0000-0002-1267-0234 ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:embeds sub1:template ;
        npx:introduces <https://w3id.org/np/RACSW-97Ldd_hknVOLd2FEB6b8KwgRlp1DdlhR3uFGtt0/claimKind> ;
        npx:supersedes <https://w3id.org/np/RApE-nGpCMigXqZjeHuYuMJEVTGmTlNTlZl7IcHi_fhdQ> ;
        skos:changeNote "Adds an optional group describing the artifact a claim is about (a script, model or dataset: its URL, name, repository, version, language and author), for claims about software such as simulation-faithfulness claims." ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
            <https://w3id.org/np/RAKc76yHLDbloE6ObluzYQsfX37v6qrZXbYeIKpe8-YUo>,
            <https://w3id.org/np/RAoTD7udB2KtUuOuAe74tJi1t3VzK0DyWS7rYVAq1GRvw>,
            <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAWwJ-TzFhUJN5l6cTUIeCIUqqzS8ek-_zumlDczSUipk/template> .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}


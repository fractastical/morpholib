@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix orcid: <https://orcid.org/> .
@prefix pk: <https://w3id.org/delphi/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub1: <https://w3id.org/np/RAGIjRyQ2tgVqY29I6MKx5hzoIwr1f1kGtQw8EP1tTCPY/> .
@prefix this: <https://w3id.org/np/RAGIjRyQ2tgVqY29I6MKx5hzoIwr1f1kGtQw8EP1tTCPY> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:assertion {
    rdfs:label rdfs:label "has the label" .

    pk:domain rdfs:label "belongs to the domain" .

    sub1:domainLabel a ntemplate:LiteralPlaceholder ;
        rdfs:label "the domain's name (its slug)" .

    sub1:st1 rdf:object sub1:domain ;
        rdf:predicate pk:domain ;
        rdf:subject ntemplate:NANOPUB ;
        ntemplate:statementOrder "1" .

    sub1:st2 a ntemplate:OptionalStatement ;
        rdf:object sub1:domainLabel ;
        rdf:predicate rdfs:label ;
        rdf:subject sub1:domain ;
        ntemplate:statementOrder "2" .

    sub1:assertion a ntemplate:PubinfoTemplate ;
        rdfs:label "Project Delphi domain" ;
        dcterms:description "Records the frontier-science domain (e.g. levin-lab, active-inference) a Project Delphi nanopublication belongs to, as a pkr:domain/<slug> IRI." ;
        dcterms:isVersionOf sub1:domainKind ;
        gen:governedBy <https://w3id.org/spaces/delphi> ;
        ntemplate:hasStatement sub1:st1,
            sub1:st2 .

    sub1:domain a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "the domain" ;
        ntemplate:hasPrefix "https://w3id.org/delphi/resource/domain/" ;
        ntemplate:hasPrefixLabel "pkr:domain/" .
}

sub1:pubinfo {
    sub1:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .

    this: rdfs:label "Project Delphi domain" ;
        dcterms:created "2026-10-01T06:55:28Z"^^xsd:dateTime ;
        dcterms:creator orcid:0000-0002-1267-0234 ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:embeds sub1:assertion ;
        npx:introduces sub1:domainKind ;
        npx:supersedes <https://w3id.org/np/RAtKj9bCnB4gUe0E9k-WhffQFSEWd9Ve2hrVllYoLuOB0> ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
            <https://w3id.org/np/RAoTD7udB2KtUuOuAe74tJi1t3VzK0DyWS7rYVAq1GRvw>,
            <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RA3KyKGBWWXKZa-Tgq1XW8djl-9veFZDC2lcXIOeNz1WE> .
}


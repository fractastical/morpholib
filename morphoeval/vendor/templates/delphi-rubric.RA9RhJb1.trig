@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix orcid: <https://orcid.org/> .
@prefix pk: <https://w3id.org/delphi/ontology/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sub1: <https://w3id.org/np/RA9RhJb1TEse-WGWwZwxC5Xe2TAwH6OKecZgRXzX4af3U/> .
@prefix this: <https://w3id.org/np/RA9RhJb1TEse-WGWwZwxC5Xe2TAwH6OKecZgRXzX4af3U> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:pubinfo {
    sub1:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .

    this: rdfs:label "Project Delphi rubric" ;
        dcterms:created "2026-10-15T05:30:52Z"^^xsd:dateTime ;
        dcterms:creator orcid:0000-0002-1267-0234 ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:embeds sub1:template ;
        npx:introduces sub1:rubricKind ;
        npx:supersedes <https://w3id.org/np/RAbjeus1yO4SqlPLnpIWNLS6nvW0DGF3879tVduuE0y00> ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
            <https://w3id.org/np/RAoTD7udB2KtUuOuAe74tJi1t3VzK0DyWS7rYVAq1GRvw>,
            <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAWwJ-TzFhUJN5l6cTUIeCIUqqzS8ek-_zumlDczSUipk/template> .
}

sub1:assertion {
    rdfs:seeAlso rdfs:label "see also" .

    skos:broader rdfs:label "has the broader concept" .

    skos:narrower rdfs:label "has the narrower concept" .

    sub1:description a ntemplate:LongLiteralPlaceholder ;
        rdfs:label "what the rubric measures and how the overall score is computed" .

    sub1:dimensionDescription a ntemplate:LongLiteralPlaceholder ;
        rdfs:label "the dimension's weight and the question it answers" .

    sub1:dimensionLabel a ntemplate:LiteralPlaceholder ;
        rdfs:label "the dimension's name" .

    sub1:label a ntemplate:LiteralPlaceholder ;
        rdfs:label "the rubric's name and version" .

    sub1:seeAlso a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "the rubric's definition (e.g. a file in a repository)" .

    sub1:st01 rdf:object pk:Concept ;
        rdf:predicate rdf:type ;
        rdf:subject <https://w3id.org/delphi/resource/concept/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "1" .

    sub1:st02 rdf:object skos:Concept ;
        rdf:predicate rdf:type ;
        rdf:subject <https://w3id.org/delphi/resource/concept/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "2" .

    sub1:st03 rdf:object sub1:label ;
        rdf:predicate rdfs:label ;
        rdf:subject <https://w3id.org/delphi/resource/concept/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "3" .

    sub1:st04 a ntemplate:OptionalStatement ;
        rdf:object sub1:description ;
        rdf:predicate dcterms:description ;
        rdf:subject <https://w3id.org/delphi/resource/concept/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "4" .

    sub1:st05 a ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        rdf:object sub1:seeAlso ;
        rdf:predicate rdfs:seeAlso ;
        rdf:subject <https://w3id.org/delphi/resource/concept/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "5" .

    sub1:st06 a ntemplate:GroupedStatement,
            ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        ntemplate:hasStatement sub1:st06a,
            sub1:st06b,
            sub1:st06c,
            sub1:st06d,
            sub1:st06e,
            sub1:st06f .

    sub1:template a ntemplate:AssertionTemplate ;
        rdfs:label "Project Delphi rubric" ;
        dcterms:description "A rubric for assessing Project Delphi claims: a concept with one narrower concept per scored dimension, each with its weight and question in the description. Rubric assessments refer to these concepts as their subject. The rubric's identifier is minted from this nanopublication's artifact code; pipelines may use their own ids under pkr:concept/." ;
        dcterms:isVersionOf sub1:rubricKind ;
        gen:governedBy <https://w3id.org/spaces/delphi> ;
        ntemplate:hasNanopubLabelPattern "${label}" ;
        ntemplate:hasStatement sub1:st01,
            sub1:st02,
            sub1:st03,
            sub1:st04,
            sub1:st05,
            sub1:st06,
            sub1:st06a,
            sub1:st06b,
            sub1:st06c,
            sub1:st06d,
            sub1:st06e,
            sub1:st06f ;
        ntemplate:hasTag "Project Delphi" ;
        ntemplate:hasTargetNanopubType pk:Concept .

    dcterms:description rdfs:label "has the description" .

    rdfs:label rdfs:label "has the label" .

    skos:Concept rdfs:label "SKOS concept" .

    sub1:st06a rdf:object sub1:dimension ;
        rdf:predicate skos:narrower ;
        rdf:subject <https://w3id.org/delphi/resource/concept/~~ARTIFACTCODE~~> ;
        ntemplate:statementOrder "6" .

    sub1:st06b rdf:object <https://w3id.org/delphi/resource/concept/~~ARTIFACTCODE~~> ;
        rdf:predicate skos:broader ;
        rdf:subject sub1:dimension ;
        ntemplate:statementOrder "7" .

    sub1:st06c rdf:object pk:Concept ;
        rdf:predicate rdf:type ;
        rdf:subject sub1:dimension ;
        ntemplate:statementOrder "8" .

    sub1:st06d rdf:object skos:Concept ;
        rdf:predicate rdf:type ;
        rdf:subject sub1:dimension ;
        ntemplate:statementOrder "9" .

    sub1:st06e rdf:object sub1:dimensionLabel ;
        rdf:predicate rdfs:label ;
        rdf:subject sub1:dimension ;
        ntemplate:statementOrder "10" .

    sub1:st06f a ntemplate:OptionalStatement ;
        rdf:object sub1:dimensionDescription ;
        rdf:predicate dcterms:description ;
        rdf:subject sub1:dimension ;
        ntemplate:statementOrder "11" .

    pk:Concept rdfs:label "concept" .

    rdf:type rdfs:label "is a" .

    sub1:dimension a ntemplate:UriPlaceholder ;
        rdfs:label "a dimension of the rubric" ;
        ntemplate:hasPrefix "https://w3id.org/delphi/resource/concept/" ;
        ntemplate:hasPrefixLabel "pkr:concept/" .

    <https://w3id.org/delphi/resource/concept/~~ARTIFACTCODE~~> a ntemplate:IntroducedResource ;
        rdfs:label "this rubric" .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}


@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ntemplate: <https://w3id.org/np/o/ntemplate/> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sub1: <https://w3id.org/np/RASh_Tn3WNfWht2FgL8XQGseMKF3vVdWi-PRROMGuBu9Y/> .
@prefix this: <https://w3id.org/np/RASh_Tn3WNfWht2FgL8XQGseMKF3vVdWi-PRROMGuBu9Y> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sub1:pubinfo {
    sub1:sig npx:hasAlgorithm "RSA" ;
        npx:hasPublicKey "" ;
        npx:hasSignature "" ;
        npx:hasSignatureTarget this: ;
        npx:signedBy orcid:0009-0007-4948-9192 .

    orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .

    this: rdfs:label "Extracted from a paper by Project Delphi" ;
        dcterms:created "2026-10-15T05:30:50Z"^^xsd:dateTime ;
        dcterms:creator orcid:0000-0002-1267-0234 ;
        dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
        npx:embeds sub1:assertion ;
        npx:introduces <https://w3id.org/np/RA6svHudOcFjOo5Vr5kSCv1kVitLgngsx3xNQBeY_0bUg/provenanceKind> ;
        npx:supersedes <https://w3id.org/np/RAaYeFYF-Cz2bM5S1wPQsnvs5X6BBxsphL03UkbVZ1lcA> ;
        skos:changeNote "Sources are now generic and repeatable (papers, code commits, datasets, rubrics) instead of a single DOI, and a related page (issue, report) can be linked with rdfs:seeAlso, so that assessments derived from code and rubrics can use this template." ;
        ntemplate:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
        ntemplate:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>,
            <https://w3id.org/np/RAKc76yHLDbloE6ObluzYQsfX37v6qrZXbYeIKpe8-YUo>,
            <https://w3id.org/np/RAoTD7udB2KtUuOuAe74tJi1t3VzK0DyWS7rYVAq1GRvw>,
            <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI> ;
        ntemplate:wasCreatedFromTemplate <https://w3id.org/np/RAlxVeww5o6RsAzkcaMKjgAjPPaB1IMqqFg06_AzXNFZc> .
}

sub1:Head {
    this: a np:Nanopublication ;
        np:hasAssertion sub1:assertion ;
        np:hasProvenance sub1:provenance ;
        np:hasPublicationInfo sub1:pubinfo .
}

sub1:provenance {
    sub1:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub1:assertion {
    dcterms:date rdfs:label "has the date" .

    dcterms:title rdfs:label "has the title" .

    rdfs:seeAlso rdfs:label "see also" .

    prov:wasAttributedTo rdfs:label "is attributed to" .

    prov:wasDerivedFrom rdfs:label "is derived from" .

    sub1:agent a ntemplate:AgentPlaceholder ;
        rdfs:label "the agent the assertion is attributed to (the Project Delphi system agent, a model, or yourself)" ;
        ntemplate:hasDefaultValue ntemplate:CREATOR .

    sub1:seeAlso a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "a related page (an issue, a report)" .

    sub1:st1 a ntemplate:RepeatableStatement ;
        rdf:object sub1:agent ;
        rdf:predicate prov:wasAttributedTo ;
        rdf:subject ntemplate:ASSERTION ;
        ntemplate:statementOrder "1" .

    sub1:st2 a ntemplate:GroupedStatement,
            ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        ntemplate:hasStatement sub1:st2a,
            sub1:st2b,
            sub1:st2c .

    sub1:st3 a ntemplate:OptionalStatement,
            ntemplate:RepeatableStatement ;
        rdf:object sub1:seeAlso ;
        rdf:predicate rdfs:seeAlso ;
        rdf:subject ntemplate:ASSERTION ;
        ntemplate:statementOrder "5" .

    sub1:title a ntemplate:LiteralPlaceholder ;
        rdfs:label "the title of the source" .

    sub1:year a ntemplate:LiteralPlaceholder ;
        rdfs:label "the publication year of the source" ;
        ntemplate:hasDatatype xsd:gYear .

    sub1:st2a rdf:object sub1:source ;
        rdf:predicate prov:wasDerivedFrom ;
        rdf:subject ntemplate:ASSERTION ;
        ntemplate:statementOrder "2" .

    sub1:st2b a ntemplate:OptionalStatement ;
        rdf:object sub1:title ;
        rdf:predicate dcterms:title ;
        rdf:subject sub1:source ;
        ntemplate:statementOrder "3" .

    sub1:st2c a ntemplate:OptionalStatement ;
        rdf:object sub1:year ;
        rdf:predicate dcterms:date ;
        rdf:subject sub1:source ;
        ntemplate:statementOrder "4" .

    sub1:assertion a ntemplate:ProvenanceTemplate ;
        rdfs:label "Extracted from a paper by Project Delphi" ;
        dcterms:description "The assertion was produced within Project Delphi — by its extraction and assessment pipeline, by a model acting as evaluator, or by a person — and is attributed to that agent. It was derived from one or more sources: a scholarly paper identified by its DOI (whose title and year may be recorded), a code commit, a dataset, a rubric. Related pages such as an issue or a report can be linked as well." ;
        dcterms:isVersionOf <https://w3id.org/np/RA6svHudOcFjOo5Vr5kSCv1kVitLgngsx3xNQBeY_0bUg/provenanceKind> ;
        gen:governedBy <https://w3id.org/spaces/delphi> ;
        ntemplate:hasStatement sub1:st1,
            sub1:st2,
            sub1:st2a,
            sub1:st2b,
            sub1:st2c,
            sub1:st3 .

    sub1:source a ntemplate:ExternalUriPlaceholder ;
        rdfs:label "a source the assertion was derived from (a paper as https://doi.org/… IRI, a code commit, a dataset, a rubric)" .
}

